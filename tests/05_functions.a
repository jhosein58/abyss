print_cstr :: fn(s &u8)
print_i32 :: fn(v i32)

println_i32 :: fn(v i32) {
    print_i32(v)
    print_cstr(c"\n")
}

add :: fn(a, b i32) i32 {
    a + b
}

abs_val :: fn(x i32) i32 {
    if x < 0 { ret -x }
    x
}

factorial :: fn(n i32) i32 {
    if n <= 1 { 1 } else { n * factorial(n - 1) }
}

fib :: fn(n i32) i32 {
    if n <= 0 { ret 0 }
    if n == 1 { ret 1 }
    fib(n - 1) + fib(n - 2)
}

calc :: fn(base, mult i32, is_pos bool) i32 {
    val := base * mult
    if is_pos { val } else { -val }
}

main :: fn() {
    println_i32(add(15, 27))
    println_i32(abs_val(-42))
    println_i32(abs_val(42))
    println_i32(factorial(5))
    println_i32(fib(8))
    println_i32(calc(10, 3, true))
    println_i32(calc(10, 3, false))
}

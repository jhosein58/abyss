print :: fn(s &u8) unit
print_u32 :: fn(v u32) unit
print_i32 :: fn(v i32) unit

Box :: fn(T type) type {
    struct {
        value T

        new :: fn(x T) Self { .{ value: x } }
        convert :: fn(self &Self, U type, x U) U { x }
    }
}

invoke :: fn(T type, U type, b Box(T), x U) U { b.convert(U, x) }
identity :: fn(T type, x T) T { x }
forward :: fn(T type, x T) T { identity(T, x) }

nested :: fn(T type, x T) T {
    local := fn(U type, value U) U { value }
    local(T, x)
}

sum :: fn(T type, x T) T {
    if x == 0 { x } else { x + sum(T, x - 1) }
}

main :: fn() {
    b := Box(u32).new(7 as u32)
    print_u32(invoke(u32, u32, b, 13 as u32))
    print(c"\n")
    print_i32(invoke(u32, i32, b, -13 as i32))
    print(c"\n")
    print_u32(forward(42 as u32))
    print(c"\n")
    print_i32(forward(-42 as i32))
    print(c"\n")
    print_u32(nested(99 as u32))
    print(c"\n")
    print_i32(nested(-99 as i32))
    print(c"\n")
    print_u32(sum(10 as u32))
    print(c"\n")
    print_i32(sum(5 as i32))
    print(c"\n")
}

main :: fn() {
    for value in .[ 1, 2, 3 ] { print(value) }

    values := .[ -3, 0, 4 ]
    print(values[0] < 0)
    for value in values { print(value < 0) }
    for value in &values { print(*value < 0) }
    for value in .[ -7 as i8, 3 ] { print(value < 0) }

    for value in .[ 1.25, 2.5 ] { print(value) }

    iterator := .[ 5, 6 ].iter()
    print(iterator.next().unwrap())
    print(iterator.next().unwrap())
}

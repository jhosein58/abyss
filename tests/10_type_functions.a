print :: fn(s &u8) unit
print_u32 :: fn(v u32) unit
print_bool :: fn(b bool) unit

println_u32 :: fn(v u32) {
    print_u32(v)
    print(c"\n")
}

println_bool :: fn(b bool) {
    print_bool(b)
    print(c"\n")
}

Option :: fn(T type) type {
    struct {
        is_some bool
        val T
    }
}

Vec :: fn(T type) type {
    struct {
        ptr &T
        len u64
        cap u64
    }
}

some :: fn(T type, val T) Option(T) {
    .{ is_some: true, val: val }
}

unwrap :: fn(T type, opt Option(T)) T {
    opt.val
}

main :: fn() {
    o1 := some(i32, 42)
    println_bool(o1.is_some)
    println_u32(unwrap(i32, o1) as u32)

    o2 := some(100 as u32)
    println_bool(o2.is_some)
    println_u32(unwrap(o2))

    v_u32: Vec(u32) = .{ ptr: 0 as &u32, len: 10 as u64, cap: 20 as u64 }
    println_u32(v_u32.len as u32)
    println_u32(v_u32.cap as u32)

    sz_i32 := @sizeof(i32)
    println_u32(sz_i32 as u32)

    sz_u64 := @sizeof(u64)
    println_u32(sz_u64 as u32)

    sz_opt := @sizeof(Option(i32))
    println_u32(sz_opt as u32)

    sz_vec := @sizeof(Vec(u64))
    println_u32(sz_vec as u32)

    dummy: u32 = 999 as u32
    sz_typeof := @sizeof(@typeof(dummy))
    println_u32(sz_typeof as u32)

    sz_typeof_opt := @sizeof(@typeof(o1))
    println_u32(sz_typeof_opt as u32)
}

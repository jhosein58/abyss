print_cstr :: fn(s &u8)
print_i32 :: fn(v i32)

println_i32 :: fn(v i32) {
    print_i32(v)
    print_cstr(c"\n")
}

double_it :: fn(x i32) i32 {
    x * 2
}

apply :: fn(f fn(i32) i32, x i32) i32 {
    f(x)
}

make_multiplier :: fn() fn(i32, i32) i32 {
    fn(a, b i32) i32 { a * b }
}

main :: fn() {
    add: fn(i32, i32) i32 = fn(a, b i32) i32 { a + b }
    println_i32(add(15, 27))

    sub := fn(a, b i32) i32 { a - b }
    println_i32(sub(100, 35))

    println_i32(apply(double_it, 25))

    fp: fn(i32) i32 = double_it
    println_i32(fp(50))

    mult := make_multiplier()
    println_i32(mult(6, 7))

    v := (fn(x i32) i32 { x * 3 })(7)
    println_i32(v)
}

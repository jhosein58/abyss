print_cstr :: fn(s &u8)
print_char :: fn(c u8)
print_i32 :: fn(v i32)
print_u32 :: fn(v u32)
print_bool :: fn(b bool)

println_i32 :: fn(v i32) {
    print_i32(v)
    print_cstr(c"\n")
}

println_u32 :: fn(v u32) {
    print_u32(v)
    print_cstr(c"\n")
}

println_bool :: fn(b bool) {
    print_bool(b)
    print_cstr(c"\n")
}

main :: fn() {
    println_i32(0)
    println_i32(42)
    println_i32(-100)
    println_i32(1_000_000)

    println_u32(0x0)
    println_u32(0xFF)
    println_u32(0x10_20)

    println_bool(true)
    println_bool(false)

    print_cstr(c"hello abyss\n")
    print_char(65 as u8)
    print_char(10 as u8)
}

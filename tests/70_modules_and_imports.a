exp :: @import("./modules/exporter")
pkg :: @import("./modules/pkg")
circ_a :: @import("./modules/circ_a")
circ_b :: @import("./modules/circ_b")
is_digit :: @import("std/ascii").is_digit
is_alpha :: @import("std/ascii").is_alpha
asc :: @import("std/ascii")
PI :: @import("./modules/exporter").PI
calc :: @import("./modules/exporter").calc

test_scoped :: fn() {
    PKG_VAL :: @import("./modules/pkg").PKG_VAL
    print(PKG_VAL)
    print("\n")
    val := 10
    {
        val :: @import("./modules/circ_a").A_CONST
        print(val)
        print("\n")
        {
            val :: @import("./modules/circ_b").B_CONST
            print(val)
            print("\n")
        }
        print(val)
        print("\n")
    }
    print(val)
    print("\n")
}

main :: fn() {
    print(exp.PI)
    print("\n")
    print(exp.MSG)
    print("\n")
    print(exp.calc(3, 4))
    print("\n")
    p: exp.Pair = .{ x: 10, y: 20 }
    print(p.x + p.y)
    print("\n")

    print(pkg.PKG_VAL)
    print("\n")
    print(pkg.pkg_fn())
    print("\n")

    print(circ_a.get_from_b())
    print("\n")
    print(circ_b.get_from_a())
    print("\n")

    print(is_digit('7'))
    print("\n")
    print(is_alpha('z'))
    print("\n")
    print(asc.is_digit('x'))
    print("\n")

    print(PI)
    print("\n")
    print(calc(5, 6))
    print("\n")

    test_scoped()
}

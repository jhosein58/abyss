print_cstr :: fn(s &u8)
print_u32 :: fn(v u32)
print_bool :: fn(b bool)

println_u32 :: fn(v u32) {
    print_u32(v)
    print_cstr(c"\n")
}

println_bool :: fn(b bool) {
    print_bool(b)
    print_cstr(c"\n")
}

main :: fn() {
    x: i32 = 123
    sz := @sizeof(i32)
    println_u32(sz as u32)

    sz_u8 := @sizeof(u8)
    println_u32(sz_u8 as u32)

    sz_ptr := @sizeof(&i32)
    println_u32(sz_ptr as u32)

    is_same := @is(x, i32)
    println_bool(is_same)

    is_diff := @is(x, bool)
    println_bool(is_diff)

    sz_of_ty := @sizeof(@typeof(x))
    println_u32(sz_of_ty as u32)
}

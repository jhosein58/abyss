import std.collections.vec: Vec

import std.io: write as print_cstr, write as print_i32, write as print_bool

main :: fn() {
    values := Vec(i32).new()
    values.push(10)
    values.push(20)
    values.push(30)

    direct := values.iter()
    first := direct.next()
    print_bool(first.is_some())
    print_cstr(c"\n")
    print_i32(first.unwrap())
    print_cstr(c"\n")

    total := 0 as i32
    for value in values.iter() {
        total = total + value
    }
    print_i32(total)
    print_cstr(c"\n")

    copied := Vec(i32).collect(values.iter())
    for a, b in values.iter(), copied.iter() {
        print_i32(a + b)
        print_cstr(c"\n")
    }

    copied.destroy()
    values.destroy()
}

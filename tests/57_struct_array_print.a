import write as print from "std/io"

Test :: struct {
    abc [3]i32
}

main :: fn() {
    t: Test = .{
        abc: .[1, 2, 3]
    }
    #print(t)
    print("\n")
    print(t)
    print("\n")
    t.abc[1] = 9
    #print(t)
    print("\n")
    numbers: [2]i32 = .[4, 5]
    numbers[0] print(numbers[1])
    print("\n")
}

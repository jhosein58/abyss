import Vec from "std/collections/vec.a"

print :: fn(s &u8) unit
print_u32 :: fn(v u32) unit
print_i32 :: fn(v i32) unit
print_u64 :: fn(v u64) unit
print_bool :: fn(v bool) unit

Box :: fn(T type) type {
    struct {
        value T

        new :: fn(value T) Self { .{ value: value } }
        get :: fn() T { .value }
    }
}

Pair :: fn(T type, U type) type {
    struct {
        first T
        second U

        new :: fn(first T, second U) Self { .{ first: first, second: second } }
    }
}

zero :: fn(T type) T { 0 as T }
identity :: fn(T type, value T) T { value }
consume :: fn(value Vec(u32)) u32 { value.get(0) }

main :: fn() {
    a := Vec().new()
    b := Vec().new()
    a.push(10 as u32)
    b.push(true)
    print_u32(a.get(0))
    print(c"\n")
    print_bool(b.get(0))
    print(c"\n")
    alias := a
    alias.push(20 as u32)
    print_u32(alias.last())
    print(c"\n")
    alias.destroy()
    b.destroy()
    numbers := Vec().with_cap(1)
    numbers.push(7)
    numbers.push(9 as u64)
    print_u64(numbers.get(0) + numbers.get(1))
    print(c"\n")
    numbers.destroy()
    context: Vec(i32) = Vec().new()
    context.push(-5)
    print_i32(context.get(0))
    print(c"\n")
    context.destroy()
    later := Vec().new()
    size := @sizeof(@typeof(later))
    later.push(33 as u32)
    print_u32(size as u32)
    print(c"\n")
    print_u32(consume(later))
    print(c"\n")
    later.destroy()
    inferred := Box().new(42 as u32)
    print_u32(inferred.get())
    print(c"\n")
    literal: Box() = .{ value: 17 as u32 }
    print_u32(literal.get())
    print(c"\n")
    pair := Pair().new(123 as u32, false)
    print_u32(pair.first)
    print(c"\n")
    print_bool(pair.second)
    print(c"\n")
    inner := Vec().new()
    outer := Vec().new()
    outer.push(inner)
    inner.push(88 as u32)
    print_u32(outer.get(0).get(0))
    print(c"\n")
    inner.destroy()
    outer.destroy()
    pointers := Vec().new()
    value: u32 = 91
    pointers.push(&value)
    print_u32(*pointers.get(0))
    print(c"\n")
    pointers.destroy()
    raw := Vec().new()
    p := raw.ptr
    *p = 45 as u32
    print_u32(*p)
    print(c"\n")
    raw.destroy()
    result := zero()
    typed: u64 = result
    print_u64(typed)
    print(c"\n")
    forwarded := identity(Vec().new())
    forwarded.push(99 as u32)
    print_u32(forwarded.last())
    print(c"\n")
    forwarded.destroy()
}

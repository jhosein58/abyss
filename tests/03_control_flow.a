print :: (s &u8) unit
print_i32 :: (v i32) unit

println_i32 :: (v i32) {
    print_i32(v)
    print("\n")
}

main :: () {
    val := 10
    if val > 5 {
        println_i32(1)
    }
    if val < 5 {
        println_i32(2)
    }

    res1 := if val > 5 { 42 } else { 99 }
    println_i32(res1)

    res2 := if val < 5 { 42 } else { 99 }
    println_i32(res2)

    score := 85
    grade := if score >= 90 {
        1
    } else {
        if score >= 80 {
            2
        } else {
            3
        }
    }
    println_i32(grade)

    sum := 0
    i := 1
    while i <= 5 {
        sum = sum + i
        i = i + 1
    }
    println_i32(sum)

    b_val := 0
    j := 0
    while j < 10 {
        if j == 4 {
            b_val = j
            break
        }
        j = j + 1
    }
    println_i32(b_val)

    odd_sum := 0
    k := 0
    while k < 10 {
        k = k + 1
        if (k % 2) == 0 {
            cont
        }
        odd_sum = odd_sum + k
    }
    println_i32(odd_sum)
}

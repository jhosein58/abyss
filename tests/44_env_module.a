import Env from "std/env.a"

main :: fn() {
    val := Env.get_or(c"NONEXISTENT_ENV_KEY_12345", c"default_value")
    print(val)
    print(c"\n")

    has_non := Env.has(c"NONEXISTENT_ENV_KEY_12345")
    print_bool(has_non)
    print_char(10 as u8)

    argc := Env.args_len()
    has_args := argc >= 1
    print_bool(has_args)
    print_char(10 as u8)
}

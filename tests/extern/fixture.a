import std.sys: fall

Point :: extern struct {
    fraction f32
    distance f64
}

Packet :: extern struct {
    tag u8
    pos Point
    delta i16
    active bool
    serial u64
}

Tiny :: extern struct {
    value i8
}

PacketCallback :: fn(Packet, f64) Packet
Unary :: fn(i32) i32
Select :: fn()

Handler :: extern struct {
    id u16
    update PacketCallback
}

state: i8

c_reset :: extern fn() { state = 0 }
c_store :: extern fn(value i8) { state = value }
c_read :: extern fn() i8 { state }
c_bool :: extern fn(value bool) bool { not value }
c_identity_pointer :: extern fn(value &&i16) &i16 { *value }

c_tiny :: extern fn(value Tiny) Tiny {
    value.value = value.value + 1
    value
}

c_packet :: extern fn(value Packet) Packet {
    value.tag = value.tag + 1
    value.pos.distance = value.pos.distance * 2.0
    value.delta = value.delta + 2
    value.active = not value.active
    value.serial = value.serial + 1
    value
}

c_layout :: extern fn(p &Packet, size u64, distance &f64, delta &i16, active &bool, serial &u64) bool {
    @sizeof(Packet) == size and &p.pos.distance == distance and &p.delta == delta and
        &p.active == active and &p.serial == serial and p.tag == 19 and
        p.pos.fraction == 1.25 and *distance == 6.0 and *delta == -100 and *active and *serial == 99
}

c_invoke :: extern fn(value i32, apply Unary) i32 { apply(value) }

handler: Handler

c_register :: extern fn(value Handler) { handler = value }

c_dispatch :: extern fn(value &Packet) Packet {
    if handler.id != 6 { #fall }
    update := handler.update
    update(*value, 3.0)
}

c_double :: extern fn(value i32) i32 { value * 2 }
c_get_mapper :: extern fn() Unary { c_double }
c_call_select :: extern fn(select Select) { select() }

mixed :: extern "C_ABI_Mixed_widths_0123456789" fn(a i8, b, c u16, d i32, e u8, f i64, g u32, h u64, i f32, j f64, k bool) f64 {
    if a != -5 or b != 65000 or c != 30000 or d != -90000 or e != 250 or
        f != -((1 as i64) << 32) or g != 4000000000 or h != ((1 as u64) << 63) or
        i != 1.25 or j != -2.5 or not k { #fall }
    j - (i as f64)
}

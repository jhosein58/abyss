import write as print from "std/io.a"
import fmt from "std/fmt"
import String from "std/string"
import Arena from "std/allocator"

gen_expr :: fn(base i64, mul i64) Str {
    arena := Arena.new(4096)
    fmt(&arena, "x + {} * {}", .{base, mul}).as_str()
}

gen_nested :: fn() Str {
    `#("500 + 500")`
}

gen_multiline_fn :: fn(factor i64) Str {
    arena := Arena.new(4096)
    fmt(&arena, "step1 := x * {}\nstep2 := step1 + 10\nstep2", .{factor}).as_str()
}

gen_power :: fn(var_name Str, exp i32) Str {
    if exp <= 0 { ret "1" }
    arena := Arena.new(4096)
    out := String.new(&arena)
    out.push_str(var_name)
    i := 1
    while i < exp {
        out.push_str(" * ")
        out.push_str(var_name)
        i = i + 1
    }
    out.as_str()
}

gen_if_dispatcher :: fn(num_cases i32) Str {
    arena := Arena.new(4096)
    out := String.new(&arena)
    out.push_str("if op == 0 { val + 0 }")
    i := 1
    while i < num_cases {
        part := fmt(&arena, " else if op == {} {{ val + {} }}", .{i, i * 10})
        out.push_str(part.as_str())
        i = i + 1
    }
    out.push_str(" else { 0 }")
    out.as_str()
}

gen_even_accumulator :: fn(limit i32) Str {
    arena := Arena.new(4096)
    out := String.new(&arena)
    out.push_str("{\nacc := 0\n")
    i := 1
    while i <= limit {
        if (i % 2) == 0 {
            part := fmt(&arena, "acc = acc + {}\n", .{i})
            out.push_str(part.as_str())
        }
        i = i + 1
    }
    out.push_str("acc\n}")
    out.as_str()
}

stage_inner :: fn(multiplier i64) Str {
    arena := Arena.new(4096)
    fmt(&arena, "val * {}", .{multiplier}).as_str()
}

stage_outer :: fn(n i32) Str {
    arena := Arena.new(4096)
    fmt(&arena, "#stage_inner({})", .{n * 2}).as_str()
}

gen_while_loop :: fn(target i32) Str {
    arena := Arena.new(4096)
    fmt(&arena, "{{\nsum := 0\ncurr := 1\nwhile true {{\nif curr > {} {{ break }}\nsum = sum + curr\ncurr = curr + 1\n}}\nsum\n}}", .{target}).as_str()
}

add_val :: fn(T type, val T) T {
    val + #("7")
}

choose_type :: fn(big bool) Str {
    if big { "i64" } else { "i32" }
}

main :: fn() {
    raw_str := `first line
second line`
    print(raw_str)
    print("\n")

    v1 := #`
        a := 10
        b := 20
        a * b
    `
    print(v1)
    print("\n")

    v2 := #`{
        temp := 50
        temp * 2
    }`
    print(v2)
    print("\n")

    x := 5
    v3 := #gen_expr(10, 3)
    print(v3)
    print("\n")

    v4 := #gen_nested()
    print(v4)
    print("\n")

    v5 := #gen_multiline_fn(4)
    print(v5)
    print("\n")

    g1 := add_val(i32, 100)
    print(g1)
    print("\n")

    g2 := add_val(i64, 200)
    print(g2)
    print("\n")

    t1: #choose_type(true) = 111111
    print(t1)
    print("\n")

    t2: #choose_type(false) = 222222
    print(t2)
    print("\n")

    y := 3
    pow_res := #gen_power("y", 4)
    print(pow_res)
    print("\n")

    val := 100
    op := 2
    dispatch_res := #gen_if_dispatcher(4)
    print(dispatch_res)
    print("\n")

    even_sum := #gen_even_accumulator(10)
    print(even_sum)
    print("\n")

    stage_res := #stage_outer(5)
    print(stage_res)
    print("\n")

    loop_res := #gen_while_loop(10)
    print(loop_res)
    print("\n")
}

print :: fn(s &u8)
print_i32 :: fn(v i32)

println_i32 :: fn(v i32) {
    print_i32(v)
    print(c"\n")
}

greet :: fn() {
    print(c"hello\n")
}

print_sum :: fn(a, b i32) {
    println_i32(a + b)
}

to_int :: fn(x f32) i32 {
    x as i32
}

run_task :: fn(task fn()) {
    task()
}

main :: fn() {
    f1: fn() = greet
    f1()

    f2: fn(i32, i32) = print_sum
    f2(12, 34)

    f3: fn(f32) i32 = to_int
    println_i32(f3(99.0 as f32))

    run_task(greet)

    mult := fn(a, b i32) i32 { a * b }
    println_i32(mult(5, 6))
}

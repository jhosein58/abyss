import printf from "std/io"

Op :: enum {
    halt
    push
    add
    sub
    mul
    print
}

main :: fn() {
    program := .[
        Op.push
        Op.push
        Op.add
        Op.push
        Op.mul
        Op.print
        Op.halt
    ]

    s := Vec(i32).new()

    for inst in program {
        match inst {
            halt  { break }

            push  { s.push(42) }
            add   { s.push(s.pop() + s.pop()) }
            sub   { s.push(s.pop() - s.pop()) }
            mul   { s.push(s.pop() * s.pop()) }

            print { 
                printf("result = {}\n", .{s.pop()}) 
            }
        }
    }
}

import printf from "std/io"

Op :: enum {
    push,
    add,
    sub,
    mul,
    print,
    halt,
}

Inst :: struct { Op, i32 }

main :: fn() {
    program: [7]Inst = .[
        .{ Op.push,  15 },
        .{ Op.push,  25 },
        .{ Op.add,   0 },
        .{ Op.push,  2 },
        .{ Op.mul,   0 },
        .{ Op.print, 0 },
        .{ Op.halt,  0 },
    ]

    stack := Vec(i32).new()

    for inst in program {
        match inst.0 {
            push  { stack.push(inst.1) }
            add   { stack.push(stack.pop() + stack.pop()) }
            sub   { stack.push(stack.pop() - stack.pop()) }
            mul   { stack.push(stack.pop() * stack.pop()) }
            print { printf("result = {}\n", .{stack.pop()}) }
            halt  { break }
        }
    }
}

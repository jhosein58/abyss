print_cstr :: fn(s &u8)
print_u32 :: fn(v u32)
print_i32 :: fn(v i32)

Node :: fn(T type) type {
    struct {
        value T
        next &Node(T)

        get :: fn(self &Self) T { self.value }
        extra u32
    }
}

identity :: fn(T type, value T) T { value }

main :: fn() {
    tail: Node(u32) = .{ value: 42, next: 0 as &Node(u32), extra: 1 }
    head: Node() = .{ value: 11, next: &tail, extra: 2 }
    other: Node() = .{ value: -7, next: 0 as &Node(i32), extra: 3 }
    print_u32(head.next.get())
    print_cstr(c"\n")
    print_i32(other.get())
    print_cstr(c"\n")
    copy := identity(head)
    print_u32(copy.next.value)
    print_cstr(c"\n")
    print_u32(copy.extra)
    print_cstr(c"\n")
    print_u32(@sizeof(Node(u32)) as u32)
    print_cstr(c"\n")
}

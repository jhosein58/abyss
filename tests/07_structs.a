print_cstr :: fn(s &u8)
print_i32 :: fn(v i32)

println_i32 :: fn(v i32) {
    print_i32(v)
    print_cstr(c"\n")
}

Point :: struct {
    x, y i32
}

Rect :: struct {
    w, h i32

    area :: fn(self &Self) i32 {
        self.w * self.h
    }

    scale :: fn(self &Self, factor i32) i32 {
        self.w * factor
    }
}

Ops :: struct {
    op fn(i32, i32) i32
}

Item :: struct {
    a i32
    b i32
    c, d i32
}

Inline :: struct {
    x i32, y i32
}

main :: fn() {
    p: Point = .{ x: 10, y: 20 }
    println_i32(p.x)
    println_i32(p.y)

    r: Rect = .{ w: 5, h: 8 }
    println_i32(r.area())
    println_i32(r.scale(3))

    add := fn(a, b i32) i32 { a + b }
    o: Ops = .{ op: add }
    println_i32(o.op(10, 5))

    item: Item = .{ a: 1, b: 2, c: 3, d: 4 }
    println_i32(item.a + item.b + item.c + item.d)

    inl: Inline = .{ x: 100, y: 200 }
    println_i32(inl.x + inl.y)
}

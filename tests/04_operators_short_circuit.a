print :: fn(s &u8)
print_i32 :: fn(v i32)
print_bool :: fn(b bool)

println_i32 :: fn(v i32) {
    print_i32(v)
    print(c"\n")
}

println_bool :: fn(b bool) {
    print_bool(b)
    print(c"\n")
}

trigger :: fn() bool {
    print(c"SIDE_EFFECT\n")
    true
}

main :: fn() {
    a := 20
    b := 6

    println_i32(a + b)
    println_i32(a - b)
    println_i32(a * b)
    println_i32(a / b)
    println_i32(a % b)

    println_i32(a & b)
    println_i32(a | b)
    println_i32(a ^ b)
    println_i32(a << 2)
    println_i32(a >> 1)

    println_bool(a == 20)
    println_bool(a != 20)
    println_bool(a > b)
    println_bool(a < b)
    println_bool(a >= 20)
    println_bool(b <= 6)
    println_bool(not false)
    println_bool(not true)

    if false and { trigger() } {
        print(c"unreachable\n")
    }

    if true or { trigger() } {
        print(c"or_ok\n")
    }

    if true and { trigger() } {
        print(c"and_ok\n")
    }

    if false or { trigger() } {
        print(c"or_fallback_ok\n")
    }
}

print :: fn(s &u8) unit
print_u32 :: fn(v u32) unit
print_bool :: fn(b bool) unit

println_u32 :: fn(v u32) {
    print_u32(v)
    print(c"\n")
}

println_bool :: fn(b bool) {
    print_bool(b)
    print(c"\n")
}

Color :: enum {
    red,
    green,
    blue,

    is_red :: fn(self Self) bool {
        (self as u32) == 0
    },

    val :: fn(self Self) u32 {
        self as u32
    }
}

Status :: enum u8 {
    ok = 200,
    bad = 400
}

main :: fn() {
    r := Color.red
    g := Color.green
    b := Color.blue

    println_u32(r as u32)
    println_u32(g as u32)
    println_u32(b as u32)

    println_bool(r.is_red())
    println_bool(g.is_red())
    println_u32(b.val())

    s_ok := Status.ok
    s_bad := Status.bad
    println_u32(s_ok as u32)
    println_u32(s_bad as u32)

    c2 := 1 as Color
    println_u32(c2 as u32)
    println_bool(c2.is_red())
}

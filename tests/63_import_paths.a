import std.io: print
import std.io: write_str as emit
import core.range: Range as Counter
import std.collections.vec: Vec as Buffer
import std.string: Str as Text

main :: fn() {
    print("extensionless")
    values := Buffer(i32).new()
    values.push(10), values.push(20)
    print(values.get(0) + values.get(1))
    total := 0
    for value in Counter.new(1, 4) {
        total = total + value
    }
    print(total)
    text: Text = "normalized"
    emit(text), emit("\n")
    values.destroy()
}

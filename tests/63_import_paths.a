print :: @import("std/io").print
emit :: @import("std/io").write_str
Counter :: @import("core/range").Range
Buffer :: @import("std/collections/vec").Vec
Text :: @import("std/string").Str

main :: fn() {
    print("extensionless")
    values := Buffer(i32).new()
    values.push(10), values.push(20)
    print(values.get(0) + values.get(1))
    total := 0
    for value in Counter.new(1, 4) {
        total = total + value
    }
    print(total)
    text: Text = "normalized"
    emit(text), emit("\n")
    values.destroy()
}

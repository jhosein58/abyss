Arena :: @import("std/allocator").Arena
fmt :: @import("std/fmt").fmt
String :: @import("std/string").String

Node :: struct {
    next   &Node
    weight i32
}

Status :: enum u8 {
    ready
    waiting
}

make :: fn(weight i32, flag bool) Node {
    .{ next: 0 as &Node, weight: weight }
}

main :: fn() {
    print(@type_info(i32))
    print(@type_info(i32).name)
    print(*@type_info([3]u16))
    node := @type_info(Node)
    print(node.fields[0].type_info.element.name)
    printf("node: {}\n", .{ node })
    print(@type_info(Status))
    print(@type_info(make))
    print(@type_info(i32 | bool))
    print(0 as &TypeInfo())

    arena := Arena.new(64)
    print(fmt(&arena, "<{}>", .{ @type_info(Node) }))
    print(String.of(&arena, @type_info(Node)))
    arena.destroy()
}

import Vec from "std/collections/vec.a"

print :: fn(s &u8) unit
print_u32 :: fn(v u32) unit
print_i32 :: fn(v i32) unit
print_bool :: fn(v bool) unit

Box :: fn(T type) type {
    struct {
        value T

        new :: fn(value T) Self { .{ value: value } }
        get :: fn(self &Self) T { self.value }
        convert :: fn(self &Self, U type, value U) U { value }
        address :: fn(self &Self) &Self { ret self }
    }
}

Callback :: fn(T type) type {
    struct {
        value T
        apply fn(x T) T

        run :: fn(self &Self) T { self.apply(self.value) }
    }
}

identity :: fn(T type, value T) T { value }
read :: fn(T type, value &&T) T { **value }
inc :: fn(x u32) u32 { x + 1 }
negate :: fn(x i32) i32 { -x }

Color :: enum { red, green, blue }

main :: fn() {
    a := Box(u32).new(42 as u32)
    b := Box(i32).new(-7 as i32)
    print_u32(a.convert(u32, 11 as u32))
    print(c"\n")
    print_i32(a.convert(i32, -11 as i32))
    print(c"\n")
    print_i32(b.convert(-13 as i32))
    print(c"\n")
    print_u32(b.convert(13 as u32))
    print(c"\n")
    print_u32(a.get())
    print(c"\n")
    print_i32(b.get())
    print(c"\n")
    p := a.address()
    p.value = 99
    print_u32(a.get())
    print(c"\n")
    pp := &p
    print_u32(read(@typeof(p), &pp).value)
    print(c"\n")
    f: Callback(u32) = .{ value: 41, apply: inc }
    g: Callback(i32) = .{ value: -12, apply: negate }
    print_u32(f.run())
    print(c"\n")
    print_i32(g.run())
    print(c"\n")
    inner := Vec(u32).new()
    inner.push(123 as u32)
    outer := Vec(Vec(u32)).new()
    outer.push(inner)
    copied := identity(outer.get(0))
    print_u32(copied.get(0))
    print(c"\n")
    copied.destroy()
    outer.destroy()
    colors := Vec(Color).new()
    colors.push(Color.green)
    print_u32(identity(colors.get(0)) as u32)
    print(c"\n")
    colors.destroy()
    nested := Box(Box(bool)).new(Box(bool).new(true))
    print_bool(nested.get().get())
    print(c"\n")
}

import Vec from "std/collections/vec.a"

print :: (s &u8) unit
print_u32 :: (v u32) unit
print_i32 :: (v i32) unit
print_bool :: (v bool) unit

Box :: (T type) type {
    struct {
        value: T

        new :: (value T) Self { .{ value: value } }
        get :: () T { .value }
        convert :: (U type, value U) U { .value value }
        address :: () &Self { .value ret }
    }
}

Callback :: (T type) type {
    struct {
        value: T,
        apply: &(x T) T

        run :: () T { .apply(.value) }
    }
}

identity :: (T type, value T) T { value }
read :: (T type, value &&T) T { **value }
inc :: (x u32) u32 { x + 1 }
negate :: (x i32) i32 { -x }

Color :: enum { red, green, blue }

main :: () {
    a := Box(u32).new(42 as u32)
    b := Box(i32).new(-7 as i32)
    print_u32(a.convert(u32, 11 as u32))
    print(c"\n")
    print_i32(a.convert(i32, -11 as i32))
    print(c"\n")
    print_i32(b.convert(-13 as i32))
    print(c"\n")
    print_u32(b.convert(13 as u32))
    print(c"\n")
    print_u32(a.get())
    print(c"\n")
    print_i32(b.get())
    print(c"\n")
    p := a.address()
    p.value = 99
    print_u32(a.get())
    print(c"\n")
    pp := &p
    print_u32(read(@typeof(p), &pp).value)
    print(c"\n")
    f: Callback(u32) = .{ value: 41, apply: inc }
    g: Callback(i32) = .{ value: -12, apply: negate }
    print_u32(f.run())
    print(c"\n")
    print_i32(g.run())
    print(c"\n")
    inner := Vec(u32).new()
    inner.push(123 as u32)
    outer := Vec(Vec(u32)).new()
    outer.push(inner)
    copied := identity(outer.get(0))
    print_u32(copied.get(0))
    print(c"\n")
    copied.destroy()
    outer.destroy()
    colors := Vec(Color).new()
    colors.push(Color.green)
    print_u32(identity(colors.get(0)) as u32)
    print(c"\n")
    colors.destroy()
    nested := Box(Box(bool)).new(Box(bool).new(true))
    print_bool(nested.get().get())
    print(c"\n")
}

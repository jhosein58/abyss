write_str :: @import("std/io").write_str
Str :: @import("core/string").Str

print_cstr :: @import("std/io").write
print_char :: @import("std/io").write_byte
print_u32 :: @import("std/io").write
print_u64 :: @import("std/io").write
print_bool :: @import("std/io").write

main :: fn() {
    s := "hello world"
    print_u64(s.len)
    print_cstr(c"\n")
    write_str(s)
    print_cstr(c"\n")

    sub := s.sub(6, 5)
    write_str(sub)
    print_cstr(c"\n")

    print_bool(s.eq("hello world"))
    print_cstr(c"\n")
    print_bool(s.eq("hello"))
    print_cstr(c"\n")

    c: u8 = 'A'
    print_u32(c as u32)
    print_cstr(c"\n")
    print_char('Z')
    print_cstr(c"\n")
    print_char('\n')

    cs := c"c-string content"
    print_cstr(cs)
    print_cstr(c"\n")

    ch := 'x'
    print_char(ch)
    print_cstr(c"\n")
}

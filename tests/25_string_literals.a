import std.io: write_str
import core.string: Str

import std.io: write as print_cstr, write_byte as print_char, write as print_u32, write as print_u64, write as print_bool

main :: fn() {
    s := "hello world"
    print_u64(s.len)
    print_cstr(c"\n")
    write_str(s)
    print_cstr(c"\n")

    sub := s.sub(6, 5)
    write_str(sub)
    print_cstr(c"\n")

    print_bool(s.eq("hello world"))
    print_cstr(c"\n")
    print_bool(s.eq("hello"))
    print_cstr(c"\n")

    c: u8 = 'A'
    print_u32(c as u32)
    print_cstr(c"\n")
    print_char('Z')
    print_cstr(c"\n")
    print_char('\n')

    cs := c"c-string content"
    print_cstr(cs)
    print_cstr(c"\n")

    ch := 'x'
    print_char(ch)
    print_cstr(c"\n")
}

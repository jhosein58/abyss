import std.io: write as print
import std.allocator: Arena
import std.fs: read_file, write_file

puts :: fn(s &u8) i32
remove :: fn(path &u8) i32

main :: fn() {
    puts(c"dynamic libc puts")
    arena := Arena.new(1024 * 1024)
    write_file(c"vm_dyn_io.txt", Str.of("dynamic fs file content\n"))
    c := read_file(&arena, c"vm_dyn_io.txt")
    print(c)
    remove(c"vm_dyn_io.txt")
}

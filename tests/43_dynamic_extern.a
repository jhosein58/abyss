import print from "std/io.a"
import Arena from "std/allocator"
import read_file, write_file from "std/fs"

puts :: fn(s &u8) i32

main :: fn() {
    puts(c"dynamic libc puts")
    arena := Arena.new(1024 * 1024)
    write_file(c"tmp/vm_dyn_io.txt", Str.of("dynamic fs file content\n"))
    c := read_file(&arena, c"tmp/vm_dyn_io.txt")
    print(c)
}

Arena :: @import("std/allocator").Arena
read_file :: @import("std/fs").read_file
write_file :: @import("std/fs").write_file

puts :: extern fn(s &u8) i32
remove :: extern fn(path &u8) i32

main :: fn() {
    puts(c"dynamic libc puts")
    arena := Arena.new(1024 * 1024)
    write_file(c"vm_dyn_io.txt", "dynamic fs file content")
    c := read_file(&arena, c"vm_dyn_io.txt")
    puts(c.ptr)
    remove(c"vm_dyn_io.txt")
}

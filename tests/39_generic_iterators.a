import Vec from "std/collections/vec"
import Worklist from "std/collections/worklist"
import write as print from "std/io"

sum :: fn(values Vec(i32)) i32 {
    total := 0 as i32
    for value in values { total = total + value }
    for value in &values { total = total + *value }
    for value in Worklist(i32).new(&values) { total = total + value }
    total
}

main :: fn() {
    values := Vec(i32).new()
    values.push(3 as i32)
    values.push(4 as i32)
    values.push(5 as i32)
    print(sum(values))
    print("\n")
}

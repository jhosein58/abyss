
import Str from "std/string.a"
import Arena from "std/allocator.a"
import read_file, write_file from "std/fs.a"
import dump_hir from "compiler/dump.a"
import Engine from "compiler/engine.a"
import CCodeGen_finish from "compiler/codegen.a"
import fall from "std/sys.a"
import Fmt from "std/fmt.a"

print_u32 :: (s u32) unit
print_u64 :: (s u64) unit
print_u8 :: (s u8) unit
print_char :: (s u8) unit
print :: (s &u8) unit

compile_and_run :: (path &u8) i32


main :: () {

    arena := Arena.new(1024 * 1024 * 16)
    
    main_path := "main.a"

    source := read_file(&arena, main_path)

    eng := Engine.new()

    fid := eng.add_file(&arena, Str.of(main_path), source)

    sym_id := eng.get_symbol_id(fid, Str.of("main"))

    eng.parse(sym_id)
    eng.type_check(sym_id)

    eng.abyss_main(sym_id)
    eng.compile(&arena, sym_id)

    c_code := CCodeGen_finish(&eng.ccg, read_file(&arena, "prelude.c"))
    write_file("tmp/out.c", c_code)
}

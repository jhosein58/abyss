def Pos [
    x: f32,
    y: f32
]

def test1(pos: [x: f32, y: f32]) {
    print(pos.x)
}

def test2(pos: Pos) {
    print(pos.x)
}

pos := [x: 10., y: 12.] as Pos
fake_pos := [x: 10., y: 12.] 

test1(pos)       -- works
test1(fake_pos)  -- works

test2(pos)       -- works
test2(fake_pos)  -- Error!

def Meter i32

def number(any: i32) {
    print(any)
}

def meter(meter: Meter) {
    print(meter)
}

m := 100 as Meter
n := 100

number(m)  -- works
number(n)  -- works

meter(m)  -- works
meter(n)  -- Error!


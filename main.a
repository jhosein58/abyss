import Str from "std/string"
import Arena from "std/allocator"
import read_file, write_file from "std/fs"
import dump_hir from "compiler/dump"
import Engine from "compiler/engine"
import CCodeGen, CCodeBuilder, CCodeGen_new, CCodeGen_destroy, CCodeGen_finish from "compiler/codegen"
import embedded_runtime from "compiler/embedded"
import fall from "std/sys"
import Fmt from "std/fmt"
import Path from "std/path"
import VmCodeGen, VmCodeBuilder from "compiler/vm/codegen"
import Vm from "compiler/vm/vm"

compile_and_run :: fn(path &u8) i32
get_arg_count   :: fn() i32
get_arg         :: fn(idx i32) &u8
get_env         :: fn(name &u8) &u8
file_open       :: fn(path, mode &u8) &u8
file_close      :: fn(handle &u8) i32
abyss_vm_shift_args :: fn() unit

main :: fn() {

    arena := Arena.new(1024 * 1024 * 16)

    main_path := c"main.a"
    out_path := c"out.c"
    is_vm_run := false

    if get_arg_count() > 1 {
        arg1 := Str.of(get_arg(1))
        if arg1.eq(Str.of("r")) or arg1.eq(Str.of("run")) {
            is_vm_run = true
            if get_arg_count() > 2 {
                main_path = get_arg(2)
            } else {
                env_src := get_env(c"ABYSS_SRC")
                if env_src != (0 as &u8) {
                    main_path = env_src
                }
            }
        } else if arg1.eq(Str.of("b")) or arg1.eq(Str.of("build")) {
            if get_arg_count() > 2 {
                main_path = get_arg(2)
            } else {
                env_src := get_env(c"ABYSS_SRC")
                if env_src != (0 as &u8) {
                    main_path = env_src
                }
            }
            if get_arg_count() > 3 {
                out_path = get_arg(3)
            } else {
                env_out := get_env(c"ABYSS_OUT")
                if env_out != (0 as &u8) {
                    out_path = env_out
                }
            }
        } else {
            main_path = get_arg(1)
            if get_arg_count() > 2 {
                out_path = get_arg(2)
            } else {
                env_out := get_env(c"ABYSS_OUT")
                if env_out != (0 as &u8) {
                    out_path = env_out
                }
            }
            env_vm := get_env(c"ABYSS_VM")
            if env_vm != (0 as &u8) {
                is_vm_run = true
            }
        }
    } else {
        env_src := get_env(c"ABYSS_SRC")
        if env_src != (0 as &u8) {
            main_path = env_src
        }
        env_out := get_env(c"ABYSS_OUT")
        if env_out != (0 as &u8) {
            out_path = env_out
        }
        env_vm := get_env(c"ABYSS_VM")
        if env_vm != (0 as &u8) {
            is_vm_run = true
        }
    }

    source := read_file(&arena, main_path)

    eng := Engine.new(&arena)

    fid := eng.add_file(&arena, Str.of(main_path), source)

    sym_id := eng.get_symbol_id(fid, Str.of("main"))

    eng.parse(sym_id)
    eng.type_check(sym_id)

    eng.validate_main(sym_id)

    if is_vm_run {
        abyss_vm_shift_args()
        vcg := VmCodeGen.new(&arena)
        vcg.init_types(&eng.nexus.types, &arena)
        vbuilder := VmCodeBuilder.new(&vcg)
        vcg.abyss_main(sym_id)
        eng.compile(&vcg, &vbuilder, &arena, sym_id)
        vcg.finish_linking()
        vm := Vm.new()
        vm.run(&vcg.chunk, vcg.main_entry)
        vm.destroy()
        vcg.destroy()
        ret
    }

    ccg := CCodeGen_new(&arena)
    builder := CCodeBuilder.new()
    ccg.abyss_main(sym_id)
    eng.compile(&ccg, &builder, &arena, sym_id)

    prelude_source := embedded_runtime()
    env_prelude := get_env(c"ABYSS_PRELUDE")
    if env_prelude != (0 as &u8) {
        fh := file_open(env_prelude, c"rb")
        if fh != (0 as &u8) {
            file_close(fh)
            prelude_source = read_file(&arena, env_prelude)
        }
    } else {
        env_dev := get_env(c"ABYSS_DEV")
        if env_dev != (0 as &u8) {
            prelude_path := c"runtime/prelude.c"
            dev_str := Str.of(env_dev)
            if (not dev_str.eq(Str.of("1"))) and (not dev_str.eq(Str.of("true"))) {
                p_str := Path.join(&arena, dev_str, Str.of("runtime/prelude.c"))
                buf := arena.alloc(p_str.len + 1)
                i: u64 = 0
                while i < p_str.len {
                    *(buf + i) = *(p_str.ptr + i)
                    i = i + 1
                }
                *(buf + p_str.len) = 0 as u8
                prelude_path = buf
            }
            fh := file_open(prelude_path, c"rb")
            if fh != (0 as &u8) {
                file_close(fh)
                prelude_source = read_file(&arena, prelude_path)
            }
        }
    }

    c_code := CCodeGen_finish(&ccg, prelude_source)
    write_file(out_path, c_code)
    CCodeGen_destroy(&ccg)
}

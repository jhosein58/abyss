Arena :: @import("std/allocator").Arena
Str :: @import("std/string").Str
Vec :: @import("std/collections/vec").Vec
Maybe :: @import("core/maybe").Maybe

Record :: struct {
    id   u32
    name Str

    new :: fn(id u32, name Str) Self {
        .{ id: id, name: name }
    }

    display :: fn(self &Self) {
        printf("Record(id={}, name={})\n", .{self.id, self.name})
    }
}

Database :: struct {
    arena   &Arena
    records Vec(Record)

    new :: fn(arena &Arena) Self {
        .{
            arena:   arena,
            records: Vec(Record).new(),
        }
    }

    destroy :: fn(self &Self) {
        self.records.destroy()
    }

    add :: fn(self &Self, id u32, name Str) {
        self.records.push(Record.new(id, name))
    }

    find_by_id :: fn(self &Self, id u32) Maybe(Record) {
        i: u64 = 0
        while i < self.records.len {
            rec := self.records.get(i)
            if rec.id == id {
                ret Maybe(Record).some(rec)
            }
            i = i + 1
        }
        Maybe(Record).none()
    }
}

main :: fn() {
    arena := Arena.new(65536)
    db := Database.new(&arena)

    db.add(1, "Alpha")
    db.add(2, "Beta")

    res := db.find_by_id(1)
    if res.is_some() {
        rec := res.unwrap()
        rec.display()
    } else {
        printf("Record not found\n", .{})
    }

    db.destroy()
    arena.destroy()
}

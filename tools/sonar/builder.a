import std.string: Str, String
import std.allocator: Arena
import std.collections.vec: Vec
import std.fs: File, to_cstr
import std.path: Path
import .resolver: ResolvedPod
import .vendor: ensure_dir_all

system :: fn(cmd &u8) i32

Builder :: struct {
    arena      &Arena
    vendor_dir Str
    cache_dir  Str
    cc         Str

    new :: fn(arena &Arena, vendor_dir Str) Self {
        c_dir := Path.join(arena, vendor_dir, ".cache")
        .{
            arena: arena
            vendor_dir: vendor_dir
            cache_dir: c_dir
            cc: "gcc"
        }
    }

    compile_c_sources :: fn(self &Self, pods Vec(ResolvedPod), objects &Vec(Str), ld_flags &Vec(Str)) bool {
        ensure_dir_all(self.arena, self.cache_dir)

        i: u64 = 0
        while i < pods.len {
            pod := pods.get(i)
            pod_vendor_dir := Path.join(self.arena, self.vendor_dir, pod.name)
            pod_cache_dir := Path.join(self.arena, self.cache_dir, pod.name)
            ensure_dir_all(self.arena, pod_cache_dir)

            si: u64 = 0
            while si < pod.c_build.sources.len {
                src_rel := pod.c_build.sources.get(si)
                src_path := Path.join(self.arena, pod_vendor_dir, src_rel)
                base_name := Path.base(src_rel)
                obj_name := Path.ensure_ext(self.arena, base_name, ".o")
                obj_path := Path.join(self.arena, pod_cache_dir, obj_name)

                cmd_buf := String.new(self.arena)
                cmd_buf.push_str(self.cc)
                cmd_buf.push_str(" -c ")
                cmd_buf.push_str(src_path)
                cmd_buf.push_str(" -o ")
                cmd_buf.push_str(obj_path)

                ii: u64 = 0
                while ii < pod.c_build.include_dirs.len {
                    inc_rel := pod.c_build.include_dirs.get(ii)
                    inc_path := Path.join(self.arena, pod_vendor_dir, inc_rel)
                    cmd_buf.push_str(" -I")
                    cmd_buf.push_str(inc_path)
                    ii = ii + 1
                }

                cfi: u64 = 0
                while cfi < pod.c_build.c_flags.len {
                    cmd_buf.push_char(' ' as u8)
                    cmd_buf.push_str(pod.c_build.c_flags.get(cfi))
                    cfi = cfi + 1
                }

                c_cmd := to_cstr(self.arena, cmd_buf.as_str())
                status := system(c_cmd)
                if status != 0 {
                    ret false
                }

                objects.push(obj_path)
                si = si + 1
            }

            li: u64 = 0
            while li < pod.c_build.ld_flags.len {
                flag := pod.c_build.ld_flags.get(li)
                ld_flags.push(flag)
                li = li + 1
            }

            i = i + 1
        }
        true
    }

    build_target :: fn(self &Self, abyssc_bin Str, entry_src Str, out_bin Str, map_args Vec(Str), objects Vec(Str), ld_flags Vec(Str)) bool {
        out_dir := Path.dir(out_bin)
        if out_dir.len > 0 {
            ensure_dir_all(self.arena, out_dir)
        }
        out_c := Path.ensure_ext(self.arena, out_bin, ".c")

        cmd_abyss := String.new(self.arena)
        cmd_abyss.push_str(abyssc_bin)
        cmd_abyss.push_str(" b ")
        cmd_abyss.push_str(entry_src)
        cmd_abyss.push_char(' ' as u8)
        cmd_abyss.push_str(out_c)
        cmd_abyss.push_str(" -I ")
        cmd_abyss.push_str(self.vendor_dir)

        mi: u64 = 0
        while mi < map_args.len {
            cmd_abyss.push_str(" --map ")
            cmd_abyss.push_str(map_args.get(mi))
            mi = mi + 1
        }

        c_abyss := to_cstr(self.arena, cmd_abyss.as_str())
        status := system(c_abyss)
        if status != 0 {
            ret false
        }

        cmd_link := String.new(self.arena)
        cmd_link.push_str(self.cc)
        cmd_link.push_str(" -std=gnu99 -D_POSIX_C_SOURCE=200809L -Wno-implicit-function-declaration -Wno-error=incompatible-pointer-types -O2 ")
        cmd_link.push_str(out_c)

        oi: u64 = 0
        while oi < objects.len {
            cmd_link.push_char(' ' as u8)
            cmd_link.push_str(objects.get(oi))
            oi = oi + 1
        }

        cmd_link.push_str(" -o ")
        cmd_link.push_str(out_bin)

        li: u64 = 0
        while li < ld_flags.len {
            cmd_link.push_char(' ' as u8)
            cmd_link.push_str(ld_flags.get(li))
            li = li + 1
        }

        c_link := to_cstr(self.arena, cmd_link.as_str())
        link_status := system(c_link)
        link_status == 0
    }
}

import std.string: Str, String
import std.allocator: Arena
import std.collections.vec: Vec
import std.fs: File, Dir, to_cstr
import std.env: Env
import std.path: Path
import std.io: print, write
import std.sys: fall
import json: parse_json, JsonVal, JsonKind
import .semver: SemVer
import .manifest: PodManifest, Dependency, CBuildInfo
import .resolver: Resolver
import .vendor: VendorManager
import .builder: Builder

system :: fn(cmd &u8) i32

print_str :: fn(s Str) {
    write(s)
}

print_line :: fn(s Str) {
    print(s)
}

cmd_init :: fn(arena &Arena, name Str) {
    pod_name := if name.len > 0 { name } else { "my-pod" }
    manifest_buf := String.new(arena)
    manifest_buf.push_str("{\n  \"name\": \"")
    manifest_buf.push_str(pod_name)
    manifest_buf.push_str("\",\n  \"version\": \"0.1.0\",\n  \"entry\": \"main.a\",\n  \"dependencies\": {},\n  \"c_build\": {\n    \"sources\": [],\n    \"include_dirs\": [],\n    \"c_flags\": [],\n    \"ld_flags\": []\n  }\n}\n")
    File.write_string("pod.json", manifest_buf.as_str())
    print_line("initialized pod.json")
}

find_index_dir :: fn(arena &Arena) Str {
    env_idx := Str.of(Env.get_or(c"SONAR_INDEX_PATH", c""))
    if env_idx.len > 0 { ret env_idx }

    c_sibling := to_cstr(arena, "../abyss-index")
    if Dir.exists(c_sibling) { ret "../abyss-index" }

    c_sibling2 := to_cstr(arena, "/home/jhosein58/Workspace/abyss-index")
    if Dir.exists(c_sibling2) { ret "/home/jhosein58/Workspace/abyss-index" }

    home := Str.of(Env.get_or(c"HOME", c"."))
    idx_path := Path.join(arena, home, ".abyss/index")
    c_idx := to_cstr(arena, idx_path)
    if Dir.exists(c_idx) { ret idx_path }

    clone_cmd := String.new(arena)
    clone_cmd.push_str("git clone --depth 1 https://github.com/jhosein58/abyss-index.git ")
    clone_cmd.push_str(idx_path)
    clone_cmd.push_str(" >/dev/null 2>&1")
    system(to_cstr(arena, clone_cmd.as_str()))

    if Dir.exists(c_idx) { ret idx_path }
    Str.empty()
}

cmd_vendor :: fn(arena &Arena) Vec(Str) {
    manifest_opt := PodManifest.load_file(arena, "pod.json")
    if manifest_opt.is_none() {
        print_line("error: cannot find or parse pod.json in current directory")
        fall()
    }
    manifest := manifest_opt.unwrap()

    resolver := Resolver.new(arena)
    res := resolver.resolve_root(".", manifest)
    if not res.ok() {
        i: u64 = 0
        while i < res.errors.len {
            print_str("[sonar error] ")
            print_line(res.errors.get(i))
            i = i + 1
        }
        fall()
    }

    vm := VendorManager.new(arena, ".vendor")
    map_args := vm.vendor_all(res.pods)
    print_line("[sonar] vendored dependencies into .vendor/")
    map_args
}

cmd_add :: fn(arena &Arena, pod_name Str, ver_arg Str) {
    if pod_name.len == 0 {
        print_line("[sonar error] pod name required for 'sonar add'")
        fall()
    }

    idx_dir := find_index_dir(arena)
    if idx_dir.len == 0 {
        print_line("[sonar error] cannot locate pod index repository (abyss-index)")
        fall()
    }

    pod_meta_path := String.new(arena)
    pod_meta_path.push_str(idx_dir)
    pod_meta_path.push_str("/pods/")
    pod_meta_path.push_str(pod_name)
    pod_meta_path.push_str(".json")

    meta_src_opt := File.read_to_string(arena, pod_meta_path.as_str())
    if meta_src_opt.is_none() {
        print_str("[sonar error] pod '")
        print_str(pod_name)
        print_line("' not found in index")
        fall()
    }

    meta_json_opt := parse_json(arena, meta_src_opt.unwrap())
    if meta_json_opt.is_none() {
        print_line("[sonar error] corrupted index entry")
        fall()
    }
    meta_json := meta_json_opt.unwrap()

    git_url_opt := meta_json.get_str("git")
    git_url := if git_url_opt.is_some() { git_url_opt.unwrap() } else { Str.empty() }

    subdir_opt := meta_json.get_str("subdir")
    subdir := if subdir_opt.is_some() { subdir_opt.unwrap() } else { Str.empty() }

    latest_opt := meta_json.get_str("latest")
    latest := if latest_opt.is_some() { latest_opt.unwrap() } else { "0.1.0" }

    ver_req := if ver_arg.len > 0 {
        ver_arg
    } else {
        vbuf := String.new(arena)
        vbuf.push_str("^")
        vbuf.push_str(latest)
        vbuf.as_str()
    }

    manifest_opt := PodManifest.load_file(arena, "pod.json")
    manifest := if manifest_opt.is_some() {
        manifest_opt.unwrap()
    } else {
        PodManifest.default()
    }

    found := false
    di: u64 = 0
    while di < manifest.deps.len {
        d := manifest.deps.get(di)
        if d.name.eq(pod_name) {
            manifest.deps.set(di, Dependency.new(pod_name, ver_req, Str.empty(), git_url, subdir))
            found = true
            break
        }
        di = di + 1
    }
    if not found {
        manifest.deps.push(Dependency.new(pod_name, ver_req, Str.empty(), git_url, subdir))
    }

    File.write_string("pod.json", manifest.to_json(arena))
    print_str("[sonar] added '")
    print_str(pod_name)
    print_str("' (")
    print_str(ver_req)
    print_line(") to pod.json")

    cmd_vendor(arena)
}

cmd_update :: fn(arena &Arena) {
    idx_dir := find_index_dir(arena)
    if idx_dir.len == 0 {
        print_line("[sonar error] cannot locate pod index")
        fall()
    }
    cmd := String.new(arena)
    cmd.push_str("git -C ")
    cmd.push_str(idx_dir)
    cmd.push_str(" pull --ff-only >/dev/null 2>&1")
    system(to_cstr(arena, cmd.as_str()))
    print_line("[sonar] pod index updated successfully")
}

find_abyssc :: fn() Str {
    env_c := Str.of(Env.get_or(c"ABYSS_COMPILER", c""))
    if (env_c.len > 0) and File.exists(env_c) { ret env_c }
    if File.exists("abyssc") { ret "./abyssc" }
    if File.exists("../abyssc") { ret "../abyssc" }
    if File.exists("../../abyssc") { ret "../../abyssc" }
    "abyssc"
}

cmd_build :: fn(arena &Arena, target_arg Str, out_arg Str) Str {
    manifest_opt := PodManifest.load_file(arena, "pod.json")
    if manifest_opt.is_none() {
        print_line("error: cannot find or parse pod.json in current directory")
        fall()
    }
    manifest := manifest_opt.unwrap()

    target_src := if target_arg.len > 0 { target_arg } else { manifest.entry }
    out_bin := if out_arg.len > 0 { out_arg } else { Path.join(arena, "bin", manifest.name) }

    resolver := Resolver.new(arena)
    res := resolver.resolve_root(".", manifest)
    if not res.ok() {
        i: u64 = 0
        while i < res.errors.len {
            print_str("[sonar error] ")
            print_line(res.errors.get(i))
            i = i + 1
        }
        fall()
    }

    vm := VendorManager.new(arena, ".vendor")
    map_args := vm.vendor_all(res.pods)

    builder := Builder.new(arena, ".vendor")
    objects := Vec(Str).new()
    ld_flags := Vec(Str).new()

    c_ok := builder.compile_c_sources(res.pods, &objects, &ld_flags)
    if not c_ok {
        print_line("[sonar error] failed to compile native C sources")
        fall()
    }

    abyssc_bin := find_abyssc()
    ok := builder.build_target(abyssc_bin, target_src, out_bin, map_args, objects, ld_flags)
    if not ok {
        print_line("[sonar error] build failed")
        fall()
    }

    print_str("[sonar] successfully built ")
    print_line(out_bin)
    out_bin
}

cmd_run :: fn(arena &Arena, target_arg Str) {
    out_bin := cmd_build(arena, target_arg, Str.empty())
    print_str("[sonar] running ")
    print_line(out_bin)
    run_cmd := String.new(arena)
    run_cmd.push_str("./")
    run_cmd.push_str(out_bin)
    system(to_cstr(arena, run_cmd.as_str()))
}

cmd_help :: fn() {
    print_line("Sonar: The Abyss Package Manager")
    print_line("")
    print_line("Usage:")
    print_line("  sonar init [name]        Initialize a new pod.json")
    print_line("  sonar add <name> [ver]   Add a pod from index to dependencies")
    print_line("  sonar update             Update central pod index from git")
    print_line("  sonar vendor             Resolve and vendor dependencies into .vendor/")
    print_line("  sonar build [src] [out]  Build pod and its native dependencies")
    print_line("  sonar run [src]          Build and execute pod binary")
    print_line("  sonar help               Show this help message")
}

main :: fn() {
    arena := Arena.new(8 * 1024 * 1024)
    argc := Env.args_len()
    if argc < 2 {
        cmd_help()
        ret
    }

    cmd := Str.of(Env.arg(1))
    if cmd.eq("init") {
        name := if argc > 2 { Str.of(Env.arg(2)) } else { Str.empty() }
        cmd_init(&arena, name)
    } else if cmd.eq("add") {
        pod := if argc > 2 { Str.of(Env.arg(2)) } else { Str.empty() }
        ver := if argc > 3 { Str.of(Env.arg(3)) } else { Str.empty() }
        cmd_add(&arena, pod, ver)
    } else if cmd.eq("update") {
        cmd_update(&arena)
    } else if cmd.eq("vendor") {
        cmd_vendor(&arena)
    } else if cmd.eq("build") {
        target := if argc > 2 { Str.of(Env.arg(2)) } else { Str.empty() }
        out := if argc > 3 { Str.of(Env.arg(3)) } else { Str.empty() }
        cmd_build(&arena, target, out)
    } else if cmd.eq("run") {
        target := if argc > 2 { Str.of(Env.arg(2)) } else { Str.empty() }
        cmd_run(&arena, target)
    } else if cmd.eq("help") or cmd.eq("--help") or cmd.eq("-h") {
        cmd_help()
    } else {
        print_str("unknown command '")
        print_str(cmd)
        print_line("'. Run 'sonar help' for usage.")
        fall()
    }
}

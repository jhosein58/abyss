import std.string: Str, String
import std.allocator: Arena
import std.collections.vec: Vec
import std.path: Path
import std.fs: File, Dir, to_cstr
import core.maybe: Maybe
import .semver: SemVer
import .manifest: PodManifest, Dependency, CBuildInfo
import .vendor: ensure_dir_all

system :: fn(cmd &u8) i32

ResolvedPod :: struct {
    name       Str
    version    SemVer
    root_dir   Str
    entry      Str
    c_build    CBuildInfo

    new :: fn(name Str, version SemVer, root_dir Str, entry Str, c_build CBuildInfo) Self {
        .{
            name: name
            version: version
            root_dir: root_dir
            entry: entry
            c_build: c_build
        }
    }
}

ResolutionResult :: struct {
    pods   Vec(ResolvedPod)
    errors Vec(Str)

    ok :: fn(self &Self) bool {
        self.errors.len == 0
    }
}

Resolver :: struct {
    arena        &Arena
    resolved     Vec(ResolvedPod)
    active_stack Vec(Str)
    errors       Vec(Str)

    new :: fn(arena &Arena) Self {
        .{
            arena: arena
            resolved: Vec(ResolvedPod).new()
            active_stack: Vec(Str).new()
            errors: Vec(Str).new()
        }
    }

    find_resolved :: fn(self &Self, name Str) Maybe(u64) {
        i: u64 = 0
        while i < self.resolved.len {
            if self.resolved.get(i).name.eq(name) {
                ret Maybe(u64).some(i)
            }
            i = i + 1
        }
        Maybe(u64).none()
    }

    is_active :: fn(self &Self, name Str) bool {
        i: u64 = 0
        while i < self.active_stack.len {
            if self.active_stack.get(i).eq(name) { ret true }
            i = i + 1
        }
        false
    }

    add_error :: fn(self &Self, msg Str) {
        self.errors.push(msg)
    }

    resolve_dir :: fn(self &Self, base_dir Str, dep_path Str) Str {
        if dep_path.len == 0 { ret base_dir }
        joined := if base_dir.len > 0 { Path.join(self.arena, base_dir, dep_path) } else { dep_path }
        Path.normalize(self.arena, joined)
    }

    repo_name_from_url :: fn(self &Self, url Str) Str {
        last_slash: u64 = 0
        i: u64 = 0
        while i < url.len {
            ch := *(url.ptr + i)
            if (ch == ('/' as u8)) or (ch == (':' as u8)) {
                last_slash = i + 1
            }
            i = i + 1
        }
        name_part := url.sub(last_slash, url.len - last_slash)
        if name_part.ends_with(".git") and (name_part.len > 4) {
            name_part.sub(0, name_part.len - 4)
        } else {
            name_part
        }
    }

    resolve_git_pod :: fn(self &Self, dep Dependency) Str {
        repo_name := self.repo_name_from_url(dep.git)
        cache_base := Path.join(self.arena, ".vendor/.cache/git", repo_name)
        ensure_dir_all(self.arena, ".vendor/.cache/git")

        c_cache := to_cstr(self.arena, cache_base)
        if not Dir.exists(c_cache) {
            cmd := String.new(self.arena)
            cmd.push_str("git clone --depth 1 ")
            cmd.push_str(dep.git)
            cmd.push_str(" ")
            cmd.push_str(cache_base)
            cmd.push_str(" >/dev/null 2>&1")
            res := system(to_cstr(self.arena, cmd.as_str()))
            if res != 0 {
                cand1 := Path.join(self.arena, "..", repo_name)
                cand2 := Path.join(self.arena, "../..", repo_name)
                cand3 := Path.join(self.arena, "/home/jhosein58/Workspace", repo_name)
                cand_chosen := if Dir.exists(to_cstr(self.arena, cand1)) {
                    cand1
                } else if Dir.exists(to_cstr(self.arena, cand2)) {
                    cand2
                } else if Dir.exists(to_cstr(self.arena, cand3)) {
                    cand3
                } else {
                    Str.empty()
                }
                if cand_chosen.len > 0 {
                    cmd2 := String.new(self.arena)
                    cmd2.push_str("git clone --depth 1 ")
                    cmd2.push_str(cand_chosen)
                    cmd2.push_str(" ")
                    cmd2.push_str(cache_base)
                    cmd2.push_str(" >/dev/null 2>&1")
                    system(to_cstr(self.arena, cmd2.as_str()))
                }
            }
        }

        if dep.subdir.len > 0 {
            Path.join(self.arena, cache_base, dep.subdir)
        } else {
            cache_base
        }
    }

    resolve_pod :: fn(self &Self, base_dir Str, dep Dependency) {
        name := dep.name
        if self.is_active(name) {
            ret
        }

        target_dir := if dep.git.len > 0 {
            self.resolve_git_pod(dep)
        } else {
            self.resolve_dir(base_dir, dep.path)
        }
        manifest_path := Path.join(self.arena, target_dir, "pod.json")

        manifest_opt := PodManifest.load_file(self.arena, manifest_path)
        if manifest_opt.is_none() {
            err_buf := String.new(self.arena)
            err_buf.push_str("cannot find pod.json for dependency '")
            err_buf.push_str(name)
            err_buf.push_str("' at '")
            err_buf.push_str(manifest_path)
            err_buf.push_str("'")
            self.add_error(err_buf.as_str())
            ret
        }
        manifest := manifest_opt.unwrap()

        if not manifest.version.satisfies(dep.version_req) {
            err_buf := String.new(self.arena)
            err_buf.push_str("version mismatch: pod '")
            err_buf.push_str(name)
            err_buf.push_str("' version ")
            err_buf.push_str(manifest.version.format(self.arena))
            err_buf.push_str(" does not satisfy required '")
            err_buf.push_str(dep.version_req)
            err_buf.push_str("'")
            self.add_error(err_buf.as_str())
            ret
        }

        existing_idx := self.find_resolved(name)
        if existing_idx.is_some() {
            idx := existing_idx.unwrap()
            curr := self.resolved.get(idx)
            if curr.version.major != manifest.version.major {
                err_buf := String.new(self.arena)
                err_buf.push_str("incompatible major version conflict for pod '")
                err_buf.push_str(name)
                err_buf.push_str("': cannot unify ")
                err_buf.push_str(curr.version.format(self.arena))
                err_buf.push_str(" with ")
                err_buf.push_str(manifest.version.format(self.arena))
                self.add_error(err_buf.as_str())
                ret
            }
            if manifest.version.gt(curr.version) {
                self.resolved.set(idx, ResolvedPod.new(name, manifest.version, target_dir, manifest.entry, manifest.c_build))
            }
            ret
        }

        self.active_stack.push(name)
        self.resolved.push(ResolvedPod.new(name, manifest.version, target_dir, manifest.entry, manifest.c_build))

        i: u64 = 0
        while i < manifest.deps.len {
            child_dep := manifest.deps.get(i)
            self.resolve_pod(target_dir, child_dep)
            i = i + 1
        }

        self.active_stack.pop()
    }

    resolve_root :: fn(self &Self, root_dir Str, root_manifest PodManifest) ResolutionResult {
        i: u64 = 0
        while i < root_manifest.deps.len {
            dep := root_manifest.deps.get(i)
            self.resolve_pod(root_dir, dep)
            i = i + 1
        }
        .{
            pods: self.resolved
            errors: self.errors
        }
    }
}

import std.string: Str, String
import std.allocator: Arena
import core.maybe: Maybe

SemVer :: struct {
    major u32
    minor u32
    patch u32

    new :: fn(major u32, minor u32, patch u32) Self {
        .{
            major: major
            minor: minor
            patch: patch
        }
    }

    compare :: fn(self &Self, other SemVer) i32 {
        if self.major < other.major { ret -1 }
        if self.major > other.major { ret 1 }
        if self.minor < other.minor { ret -1 }
        if self.minor > other.minor { ret 1 }
        if self.patch < other.patch { ret -1 }
        if self.patch > other.patch { ret 1 }
        0
    }

    eq :: fn(self &Self, other SemVer) bool {
        self.compare(other) == 0
    }

    lt :: fn(self &Self, other SemVer) bool {
        self.compare(other) < 0
    }

    gt :: fn(self &Self, other SemVer) bool {
        self.compare(other) > 0
    }

    gte :: fn(self &Self, other SemVer) bool {
        self.compare(other) >= 0
    }

    format :: fn(self &Self, arena &Arena) Str {
        buf := String.new(arena)
        buf.push_u32(self.major)
        buf.push_char('.' as u8)
        buf.push_u32(self.minor)
        buf.push_char('.' as u8)
        buf.push_u32(self.patch)
        buf.as_str()
    }

    satisfies :: fn(self &Self, req Str) bool {
        clean := req
        while (clean.len > 0) and (*clean.ptr == (' ' as u8)) {
            clean = clean.sub(1, clean.len - 1)
        }
        if (clean.len == 0) or clean.eq("*") { ret true }

        if clean.starts_with("^") {
            target_opt := SemVer.parse(clean.sub(1, clean.len - 1))
            if target_opt.is_none() { ret false }
            target := target_opt.unwrap()
            if target.major > 0 {
                ret (self.major == target.major) and self.gte(target)
            } else if target.minor > 0 {
                ret (self.major == 0) and (self.minor == target.minor) and self.gte(target)
            } else {
                ret (self.major == 0) and (self.minor == 0) and (self.patch == target.patch)
            }
        }

        if clean.starts_with("~") {
            target_opt := SemVer.parse(clean.sub(1, clean.len - 1))
            if target_opt.is_none() { ret false }
            target := target_opt.unwrap()
            ret (self.major == target.major) and (self.minor == target.minor) and self.gte(target)
        }

        if clean.starts_with(">=") {
            target_opt := SemVer.parse(clean.sub(2, clean.len - 2))
            if target_opt.is_none() { ret false }
            ret self.gte(target_opt.unwrap())
        }

        if clean.starts_with("==") {
            target_opt := SemVer.parse(clean.sub(2, clean.len - 2))
            if target_opt.is_none() { ret false }
            ret self.eq(target_opt.unwrap())
        }

        target_opt := SemVer.parse(clean)
        if target_opt.is_none() { ret false }
        self.eq(target_opt.unwrap())
    }

    parse :: fn(s Str) Maybe(SemVer) {
        clean := s
        while (clean.len > 0) and ((*clean.ptr == (' ' as u8)) or (*clean.ptr == ('v' as u8))) {
            clean = clean.sub(1, clean.len - 1)
        }
        if clean.len == 0 { ret Maybe(SemVer).none() }

        p0: u64 = 0
        while (p0 < clean.len) and (*(clean.ptr + p0) != ('.' as u8)) {
            c := *(clean.ptr + p0)
            if (c < ('0' as u8)) or (c > ('9' as u8)) { ret Maybe(SemVer).none() }
            p0 = p0 + 1
        }
        if p0 == 0 { ret Maybe(SemVer).none() }
        maj := parse_u32(clean.sub(0, p0))

        if p0 >= clean.len {
            ret Maybe(SemVer).some(SemVer.new(maj, 0, 0))
        }

        clean2 := clean.sub(p0 + 1, clean.len - p0 - 1)
        p1: u64 = 0
        while (p1 < clean2.len) and (*(clean2.ptr + p1) != ('.' as u8)) {
            c := *(clean2.ptr + p1)
            if (c < ('0' as u8)) or (c > ('9' as u8)) { ret Maybe(SemVer).none() }
            p1 = p1 + 1
        }
        if p1 == 0 { ret Maybe(SemVer).none() }
        min := parse_u32(clean2.sub(0, p1))

        if p1 >= clean2.len {
            ret Maybe(SemVer).some(SemVer.new(maj, min, 0))
        }

        clean3 := clean2.sub(p1 + 1, clean2.len - p1 - 1)
        p2: u64 = 0
        while (p2 < clean3.len) and (*(clean3.ptr + p2) != ('-' as u8)) and (*(clean3.ptr + p2) != ('+' as u8)) {
            c := *(clean3.ptr + p2)
            if (c < ('0' as u8)) or (c > ('9' as u8)) { break }
            p2 = p2 + 1
        }
        if p2 == 0 { ret Maybe(SemVer).none() }
        pat := parse_u32(clean3.sub(0, p2))

        Maybe(SemVer).some(SemVer.new(maj, min, pat))
    }
}

parse_u32 :: fn(s Str) u32 {
    res: u32 = 0
    i: u64 = 0
    while i < s.len {
        c := *(s.ptr + i)
        if (c >= ('0' as u8)) and (c <= ('9' as u8)) {
            res = res * 10 + ((c - ('0' as u8)) as u32)
        }
        i = i + 1
    }
    res
}

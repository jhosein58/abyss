import malloc, free, mem_copy from "std/mem"

TokenKind :: enum u8 {
    eof
    unknown
    whitespace
    newline
    comment

    ident

    lit_int
    lit_float
    lit_str
    lit_cstr
    lit_raw_str
    lit_char

    kw_if
    kw_else
    kw_while
    kw_break
    kw_cont
    kw_ret
    kw_fn
    kw_struct
    kw_enum
    kw_match
    kw_in
    kw_for
    kw_as
    kw_and
    kw_or
    kw_not
    kw_true
    kw_false
    kw_from
    kw_import
    kw_cmpt

    plus
    minus
    star
    slash
    percent
    plus_eq
    minus_eq
    star_eq
    slash_eq
    percent_eq

    amp
    pipe
    caret
    tilde
    amp_eq
    pipe_eq
    caret_eq

    left_shift
    right_shift
    left_shift_eq
    right_shift_eq

    eq
    eq_eq
    bang_eq
    lt
    lt_eq
    gt
    gt_eq

    colon
    colon_colon
    semi
    comma
    dot

    hash
    at

    o_paren
    c_paren
    o_brace
    c_brace
    o_bracket
    c_bracket
}

kind_name :: fn(kind TokenKind) Str {
    match kind {
        whitespace     { "whitespace" }
        newline        { "newline" }
        comment        { "comment" }
        ident          { "ident" }
        lit_int        { "lit_int" }
        lit_float      { "lit_float" }
        lit_str        { "lit_str" }
        lit_cstr       { "lit_cstr" }
        lit_raw_str    { "lit_raw_str" }
        lit_char       { "lit_char" }
        kw_if          { "kw_if" }
        kw_else        { "kw_else" }
        kw_while       { "kw_while" }
        kw_break       { "kw_break" }
        kw_cont        { "kw_cont" }
        kw_ret         { "kw_ret" }
        kw_fn          { "kw_fn" }
        kw_struct      { "kw_struct" }
        kw_enum        { "kw_enum" }
        kw_match       { "kw_match" }
        kw_in          { "kw_in" }
        kw_for         { "kw_for" }
        kw_as          { "kw_as" }
        kw_and         { "kw_and" }
        kw_or          { "kw_or" }
        kw_not         { "kw_not" }
        kw_true        { "kw_true" }
        kw_false       { "kw_false" }
        kw_from        { "kw_from" }
        kw_import      { "kw_import" }
        kw_cmpt        { "kw_cmpt" }
        plus           { "+" }
        minus          { "-" }
        star           { "*" }
        slash          { "/" }
        percent        { "%" }
        plus_eq        { "+=" }
        minus_eq       { "-=" }
        star_eq        { "*=" }
        slash_eq       { "/=" }
        percent_eq     { "%=" }
        amp            { "&" }
        pipe           { "|" }
        caret          { "^" }
        tilde          { "~" }
        amp_eq         { "&=" }
        pipe_eq        { "|=" }
        caret_eq       { "^=" }
        left_shift     { "<<" }
        right_shift    { ">>" }
        left_shift_eq  { "<<=" }
        right_shift_eq { ">>=" }
        eq             { "=" }
        eq_eq          { "==" }
        bang_eq        { "!=" }
        lt             { "<" }
        lt_eq          { "<=" }
        gt             { ">" }
        gt_eq          { ">=" }
        colon          { ":" }
        colon_colon    { "::" }
        semi           { ";" }
        comma          { "," }
        dot            { "." }
        hash           { "#" }
        at             { "@" }
        o_paren        { "(" }
        c_paren        { ")" }
        o_brace        { "{" }
        c_brace        { "}" }
        o_bracket      { "[" }
        c_bracket      { "]" }
        eof            { "eof" }
        else           { "unknown" }
    }
}

Token :: struct {
    kind  TokenKind
    text  Str
    start u32
    len   u32

    new :: fn(kind TokenKind, text Str, start u32, len u32) Self {
        .{
            kind: kind,
            text: text,
            start: start,
            len: len,
        }
    }

    is_trivia :: fn(self &Self) bool {
        (self.kind == TokenKind.whitespace) or (self.kind == TokenKind.newline) or (self.kind == TokenKind.comment)
    }

    is_whitespace :: fn(self &Self) bool {
        self.kind == TokenKind.whitespace
    }

    is_newline :: fn(self &Self) bool {
        self.kind == TokenKind.newline
    }

    is_comment :: fn(self &Self) bool {
        self.kind == TokenKind.comment
    }

    is_ident :: fn(self &Self) bool {
        self.kind == TokenKind.ident
    }

    is_literal :: fn(self &Self) bool {
        k := self.kind as u8
        (k >= (TokenKind.lit_int as u8)) and (k <= (TokenKind.lit_char as u8))
    }

    is_keyword :: fn(self &Self) bool {
        k := self.kind as u8
        (k >= (TokenKind.kw_if as u8)) and (k <= (TokenKind.kw_cmpt as u8))
    }

    is_symbol :: fn(self &Self) bool {
        k := self.kind as u8
        (k >= (TokenKind.plus as u8)) and (k <= (TokenKind.c_bracket as u8))
    }

    is_eof :: fn(self &Self) bool {
        self.kind == TokenKind.eof
    }

    is_unknown :: fn(self &Self) bool {
        self.kind == TokenKind.unknown
    }

    kind_name :: fn(self &Self) Str {
        kind_name(self.kind)
    }
}

TokenList :: struct {
    tokens Vec(Token)

    new :: fn() Self {
        .{
            tokens: Vec(Token).new(),
        }
    }

    with_capacity :: fn(cap u64) Self {
        .{
            tokens: Vec(Token).with_cap(cap),
        }
    }

    destroy :: fn(self &Self) {
        self.tokens.destroy()
    }

    push :: fn(self &Self, token Token) {
        self.tokens.push(token)
    }

    len :: fn(self &Self) u64 {
        self.tokens.len
    }

    is_empty :: fn(self &Self) bool {
        self.tokens.len == 0
    }

    get :: fn(self &Self, idx u64) Token {
        self.tokens.get(idx)
    }

    get_ref :: fn(self &Self, idx u64) &Token {
        self.tokens.ptr_at(idx)
    }

    iter :: fn(self &Self) Iterator(Token) {
        self.tokens.iter()
    }

    iter_ref :: fn(self &Self) RefIterator(Token) {
        self.tokens.iter_ref()
    }

    reconstruct :: fn(self &Self) Str {
        total_len: u64 = 0
        i: u64 = 0
        while i < self.len() {
            tok := self.get(i)
            if not tok.is_eof() {
                total_len = total_len + (tok.len as u64)
            }
            i = i + 1
        }
        if total_len == 0 {
            ret Str.empty()
        }
        buf := malloc(total_len)
        offset: u64 = 0
        i = 0
        while i < self.len() {
            tok := self.get(i)
            if not tok.is_eof() {
                if tok.len > 0 {
                    mem_copy(buf + offset, tok.text.ptr, tok.len as u64)
                    offset = offset + (tok.len as u64)
                }
            }
            i = i + 1
        }
        Str.new(buf, total_len)
    }
}

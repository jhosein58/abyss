import VecU32 from "../../std/vec/u32.a"
import SliceU32 from "../../std/slice/u32.a"
import Arena from "../../std/allocator.a"
import String from "../../std/string.a"
sum :: import add from "arithmetic.a"

print :: (text &u8) unit
abyss_fall :: () unit

Counter :: struct {
    value: u32,

    new :: (initial u32) Self {
        .{ value: initial }
    }

    add :: (amount u32) &Self {
        if amount == 0 { ret }
        .value = .value + amount
    }

    read :: () u32 {
        .value
    }
}

require :: (condition bool) {
    if not condition { abyss_fall() }
}

sum_slice :: (values SliceU32) u32 {
    total: u32 = 0
    index: u64 = 0
    while index < values.len {
        total = total + *(values.ptr + index)
        index = index + 1
    }
    total
}

main :: () {
    counter := Counter.new(10)
    require(counter.add(0).add(2).add(3).read() == 15)
    pointer := &counter
    pointer.add(1)
    require(pointer.value == 16)

    ids := VecU32.new()
    ids.push(7)
    ids.push(19)
    require(sum_slice(ids.as_slice()) == 26)
    saved := ids.mark()
    ids.push(42)
    ids.reset(saved)
    require(ids.len == 2)
    ids.clear()
    require(ids.is_empty())
    ids.destroy()

    total: u32 = 0
    index: u32 = 0
    while true {
        if index >= 6 { break }
        current := index
        index = index + 1
        if current % 2 == 0 { cont }
        total = total + current
    }
    require(total == 9)
    require(sum(20, 22) == 42)

    zero: u32
    require(zero == 0)
    wide: u64 = (1 as u64) << (40 as u64)
    require(wide > (1 as u64))
    large: u128 = (1 as u128) << (80 as u128)
    require(large > (wide as u128))
    fraction: f64 = .5
    require(fraction == 0.5)
    require(0xAB_CD == 43_981)

    arena := Arena.new(1024)
    text := String_new(&arena)
    text.push_str(Str.of("item "))
    String_push_u32(&text, 42)
    require(String_as_str(&text).eq(Str.of("item 42")))
    raw := arena.alloc(8)
    *raw = *"A"
    grown := arena.realloc(raw, 8, 16)
    require(*grown == (65 as u8))
    arena.destroy()
    print("documentation examples passed\n")
}

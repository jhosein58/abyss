import .parser: parse_to_cst
import .formatter: format_cst
import std.allocator: Arena
import std.fs: File, Dir, to_cstr
import std.env: Env
import std.string: Str, String

format_source :: fn(arena &Arena, source Str) Str {
    tree := parse_to_cst(arena, source)
    format_cst(arena, tree)
}

format_file_in_place :: fn(path &u8) bool {
    arena := Arena.new(1024 * 512)
    file_opt := File.read_to_string(&arena, Str.of(path))
    if file_opt.is_none() {
        arena.destroy()
        ret false
    }
    source := file_opt.unwrap()
    formatted := format_source(&arena, source)
    ok := File.write_string(Str.of(path), formatted)
    arena.destroy()
    ok
}

format_path :: fn(arena &Arena, path &u8) u32 {
    if Dir.exists(path) {
        files := Dir.walk(arena, Str.of(path), Str.of(".a"))
        count: u32 = 0
        i: u64 = 0
        while i < files.len {
            file_str := files.get(i)
            c_p := to_cstr(arena, file_str)
            if format_file_in_place(c_p) {
                count = count + 1
            } else {
                printf("error: failed to format {}\n", .{c_p})
            }
            i = i + 1
        }
        ret count
    }

    if format_file_in_place(path) {
        ret 1
    }
    printf("error: failed to format {}\n", .{path})
    0
}

main :: fn() {
    count := Env.args_len()
    if count < 2 {
        printf("usage: abyss fmt <path> ...\n", .{})
        ret
    }

    arena := Arena.new(1024 * 1024)
    total_formatted: u32 = 0

    i: i32 = 1
    while i < count {
        path := Env.arg(i)
        n := format_path(&arena, path)
        total_formatted = total_formatted + n
        i = i + 1
    }

    printf("formatted {} files\n", .{total_formatted})
    arena.destroy()
}

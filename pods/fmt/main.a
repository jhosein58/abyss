import std.allocator: Arena
import std.env:       Env
import std.string:    Str

import .fmt: format_path

print_help :: fn() {
    printf("usage: abyssfmt <path> ... (or: abyss fmt <path> ...)\n", .{})
}

main :: fn() {
    count := Env.args_len()
    if count < 2 {
        print_help()
        ret
    }
    first := Str.of(Env.arg(1))
    if first.eq("-h") or first.eq("--help") or first.eq("help") {
        print_help()
        ret
    }
    arena := Arena.new(1024 * 1024)
    total_formatted: u32 = 0

    i: i32 = 1
    while i < count {
        path := Env.arg(i)
        n := format_path(&arena, path)
        total_formatted = total_formatted + n
        i = i + 1
    }

    printf("formatted {} files\n", .{ total_formatted })
    arena.destroy()
}

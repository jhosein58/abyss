Arena :: @import("std/allocator").Arena
Dir :: @import("std/fs").Dir
File :: @import("std/fs").File
to_cstr :: @import("std/fs").to_cstr
String :: @import("std/string").String

CstKind :: @import("./cst").CstKind
CstNode :: @import("./cst").CstNode
Formatter :: @import("./formatter").Formatter
default_width :: @import("./formatter").default_width
format_cst :: @import("./formatter").format_cst
format_cst_with_width :: @import("./formatter").format_cst_with_width
CstParser :: @import("./parser").CstParser
parse_to_cst :: @import("./parser").parse_to_cst
Lexer :: @import("./syntax/lexer").Lexer
tokenize :: @import("./syntax/lexer").tokenize
Token :: @import("./syntax/token").Token
TokenKind :: @import("./syntax/token").TokenKind
TokenList :: @import("./syntax/token").TokenList

format_source :: fn(arena &Arena, source Str) Str {
    format_source_with_width(arena, source, default_width)
}

format_source_with_width :: fn(arena &Arena, source Str, width u64) Str {
    scratch := Arena.new(65536)
    tree := parse_to_cst(&scratch, source)
    formatted := if tree == (0 as &CstNode) {
        copy := String.new(arena)
        copy.push_str(source)
        copy.as_str()
    } else {
        format_cst_with_width(arena, tree, width)
    }
    scratch.destroy()
    formatted
}

format_file_with_width :: fn(path Str, width u64) bool {
    arena := Arena.new(65536)
    file := File.read_to_string(&arena, path)
    ok := false
    if file.is_some() {
        source := file.unwrap()
        formatted := format_source_with_width(&arena, source, width)
        ok = source.eq(formatted) or File.write_string(path, formatted)
    }
    arena.destroy()
    ok
}

format_file_in_place :: fn(path &u8) bool {
    format_file_with_width(Str.of(path), default_width)
}

PathResult :: struct {
    files  u32
    failed bool
}

format_path_with_width :: fn(arena &Arena, path Str, width u64) PathResult {
    files := if Dir.exists(to_cstr(arena, path)) {
        Dir.walk(arena, path, ".a")
    } else {
        single := Vec(Str).new()
        single.push(path)
        single
    }
    count: u32 = 0
    failed := false
    for file in files.as_slice() {
        if format_file_with_width(file, width) {
            count = count + 1
        } else {
            printf("error: failed to format {}\n", .{ file })
            failed = true
        }
    }
    files.destroy()
    .{ files: count, failed: failed }
}

format_path :: fn(arena &Arena, path &u8) u32 {
    format_path_with_width(arena, Str.of(path), default_width).files
}

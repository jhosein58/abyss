Arena :: @import("std/allocator").Arena

CstKind :: enum u16 {
    file
    binding_stmt
    var_decl_stmt
    destructure_stmt
    empty_line
    continued_expr
    comment_stmt
    inline_comment
    type_slice
    type_array
    fn_def
    extern_decl
    fn_param
    struct_def
    struct_field
    struct_init
    struct_init_field
    array_lit
    enum_def
    enum_variant
    if_expr
    while_expr
    for_expr
    match_expr
    match_arm
    block_expr
    ret_expr
    break_expr
    cont_expr
    cmpt_expr
    splice_expr
    lit_int
    lit_float
    lit_str
    lit_cstr
    lit_raw_str
    lit_char
    lit_bool
    ident
    paren_expr
    call_expr
    index_expr
    member_expr
    unary_expr
    binary_expr
    assign_expr
    builtin_expr
}

CstNode :: struct {
    kind      CstKind
    text      Str
    multiline bool
    arena     &Arena
    children  Slice(&CstNode)
    capacity  u64
    height    u32

    alloc :: fn(arena &Arena, kind CstKind, text Str) &Self {
        node := arena.alloc(@sizeof(Self)) as &Self
        node.kind = kind
        node.text = text
        node.multiline = false
        node.arena = arena
        node.children = Slice(&CstNode).empty()
        node.capacity = 0
        node.height = 0
        node
    }

    add_child :: fn(self &Self, child &CstNode) {
        if self.children.len == self.capacity {
            next := if self.capacity == 0 { 1 as u64 } else { self.capacity * 2 }
            size := @sizeof(&CstNode)
            self.children.ptr = self.arena.realloc(
                self.children.ptr as &u8
                self.capacity * size
                next * size
            ) as &&CstNode
            self.capacity = next
        }
        *(self.children.ptr + self.children.len) = child
        self.children.len = self.children.len + 1
        if child.height >= self.height { self.height = child.height + 1 }
    }

    child :: fn(self &Self, idx u64) &CstNode {
        if idx < self.children.len {
            ret self.children.get(idx)
        }
        0 as &CstNode
    }

    child_count :: fn(self &Self) u64 {
        self.children.len
    }

    is_comment :: fn(self &Self) bool {
        self.kind == CstKind.comment_stmt or self.kind == CstKind.inline_comment
    }
}

cst_new :: fn(arena &Arena, kind CstKind, text Str) &CstNode {
    CstNode.alloc(arena, kind, text)
}

cst_leaf :: fn(arena &Arena, kind CstKind, text Str) &CstNode {
    CstNode.alloc(arena, kind, text)
}

cst_unary :: fn(arena &Arena, kind CstKind, op Str, operand &CstNode) &CstNode {
    node := CstNode.alloc(arena, kind, op)
    node.add_child(operand)
    node
}

cst_binary :: fn(arena &Arena, kind CstKind, op Str, lhs &CstNode, rhs &CstNode) &CstNode {
    node := CstNode.alloc(arena, kind, op)
    node.add_child(lhs)
    node.add_child(rhs)
    node
}

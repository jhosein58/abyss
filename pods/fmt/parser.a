import std.allocator: Arena
import std.ascii:     Ascii
import std.string:    String

import .cst:          CstKind, CstNode, cst_binary, cst_leaf, cst_new, cst_unary
import .syntax.lexer: tokenize
import .syntax.token: Token, TokenKind, TokenList

CstParser :: struct {
    tokens TokenList
    cursor u64
    arena  &Arena
    source Str
    failed bool
    depth  u32
    new :: fn(arena &Arena, source Str) Self {
        .{
            tokens: tokenize(source)
            cursor: 0
            arena: arena
            source: source
            failed: false
            depth: 0
        }
    }

    destroy :: fn(self &Self) {
        self.tokens.destroy()
    }

    is_eof :: fn(self &Self) bool {
        self.failed or self.peek() == TokenKind.eof
    }

    skip_ws :: fn(self &Self) {
        while (self.cursor < self.tokens.len()) and self.tokens.get(self.cursor).is_whitespace() {
            self.cursor = self.cursor + 1
        }
    }

    skip_ws_and_nl :: fn(self &Self) {
        while self.cursor < self.tokens.len() {
            t := self.tokens.get(self.cursor)
            if t.is_whitespace() or t.is_newline() {
                self.cursor = self.cursor + 1
            } else {
                break
            }
        }
    }

    peek_token :: fn(self &Self) Token {
        self.skip_ws()
        if self.cursor < self.tokens.len() {
            ret self.tokens.get(self.cursor)
        }
        Token.new(TokenKind.eof, Str.empty(), 0, 0)
    }

    peek :: fn(self &Self) TokenKind {
        self.peek_token().kind
    }

    bump :: fn(self &Self) Token {
        self.skip_ws()
        if self.cursor < self.tokens.len() {
            tok := self.tokens.get(self.cursor)
            self.cursor = self.cursor + 1
            ret tok
        }
        Token.new(TokenKind.eof, Str.empty(), 0, 0)
    }

    consume_if :: fn(self &Self, expected TokenKind) bool {
        if self.peek() == expected {
            self.bump()
            ret true
        }
        false
    }

    peek_non_ws :: fn(self &Self, offset u64) Token {
        idx := self.cursor
        count: u64 = 0
        while idx < self.tokens.len() {
            t := self.tokens.get(idx)
            if not t.is_whitespace() {
                if count == offset {
                    ret t
                }
                count = count + 1
            }
            idx = idx + 1
        }
        Token.new(TokenKind.eof, Str.empty(), 0, 0)
    }

    expect :: fn(self &Self, expected TokenKind) {
        if not self.consume_if(expected) {
            self.failed = true
        }
    }

    has_newline_before :: fn(self &Self) bool {
        idx := self.cursor
        while idx > 0 {
            idx = idx - 1
            token := self.tokens.get(idx)
            if not token.is_whitespace() {
                ret token.is_newline()
            }
        }
        false
    }

    read_trivia :: fn(self &Self, node &CstNode, end TokenKind) {
        lines: u32 = 0
        while not self.is_eof() {
            if self.consume_if(TokenKind.newline) {
                node.multiline = true
                lines = lines + 1
                cont
            }
            kind := self.peek()
            if lines > 1 and node.child_count() > 0 and kind != end {
                node.add_child(cst_new(self.arena, CstKind.empty_line, ""))
            }
            if kind != TokenKind.comment {
                break
            }
            inline := self.cursor > 0 and not self.has_newline_before()
            text := self.bump().text
            len := text.len
            while len > 0 and Ascii.is_whitespace(*(text.ptr + len - 1)) {
                len = len - 1
            }
            comment_kind := if inline { CstKind.inline_comment } else { CstKind.comment_stmt }
            node.add_child(cst_new(self.arena, comment_kind, text.sub(0, len)))
            node.multiline = true
            lines = 0
        }
    }

    list_separator :: fn(self &Self, end TokenKind) {
        if self.is_eof() or self.consume_if(TokenKind.comma) { ret }
        kind := self.peek()
        if kind != end and kind != TokenKind.newline and kind != TokenKind.comment {
            self.failed = true
        }
    }

    is_binding :: fn(self &Self) bool {
        t0 := self.peek_non_ws(0)
        t1 := self.peek_non_ws(1)
        (t0.kind == TokenKind.ident) and (t1.kind == TokenKind.colon_colon)
    }

    is_var_decl :: fn(self &Self) bool {
        t0 := self.peek_non_ws(0)
        if t0.kind != TokenKind.ident {
            ret false
        }
        t1 := self.peek_non_ws(1)
        if t1.kind != TokenKind.colon {
            ret false
        }
        t2 := self.peek_non_ws(2)
        if t2.kind == TokenKind.colon {
            ret false
        }
        true
    }

    is_destructure :: fn(self &Self) bool {
        t0 := self.peek_non_ws(0)
        t1 := self.peek_non_ws(1)
        if (t0.kind != TokenKind.ident) or (t1.kind != TokenKind.comma) {
            ret false
        }
        i: u64 = 2
        while true {
            tok := self.peek_non_ws(i)
            if tok.kind != TokenKind.ident {
                ret false
            }
            next := self.peek_non_ws(i + 1)
            if next.kind == TokenKind.comma {
                i = i + 2
                cont
            }
            if next.kind == TokenKind.colon {
                after_colon := self.peek_non_ws(i + 2)
                ret after_colon.kind == TokenKind.eq
            }
            ret false
        }
        false
    }

    is_path_token :: fn(self &Self, k TokenKind) bool {
        k == TokenKind.ident or
            ((k as u8) >= (TokenKind.kw_if as u8) and (k as u8) <= (TokenKind.kw_extern as u8))
    }

    is_type_token :: fn(self &Self, k TokenKind) bool {
        (k == TokenKind.amp) or (k == TokenKind.star) or (k == TokenKind.o_bracket) or
            (k == TokenKind.at) or
            (k == TokenKind.kw_fn) or
            (k == TokenKind.kw_struct) or
            (k == TokenKind.kw_enum)
    }

    peek_trivia_free :: fn(self &Self, offset u64) Token {
        idx := self.cursor
        count: u64 = 0
        while idx < self.tokens.len() {
            t := self.tokens.get(idx)
            if not t.is_trivia() {
                if count == offset {
                    ret t
                }
                count = count + 1
            }
            idx = idx + 1
        }
        Token.new(TokenKind.eof, Str.empty(), 0, 0)
    }

    is_tuple_struct :: fn(self &Self) bool {
        idx := self.cursor
        while self.tokens.get(idx).is_trivia() { idx = idx + 1 }
        kind := self.tokens.get(idx).kind
        if kind == TokenKind.c_brace or kind == TokenKind.eof or kind == TokenKind.hash or
            kind == TokenKind.kw_import {
            ret false
        }
        while kind == TokenKind.ident {
            idx = idx + 1
            while self.tokens.get(idx).is_whitespace() { idx = idx + 1 }
            kind = self.tokens.get(idx).kind
            if kind == TokenKind.comment or kind == TokenKind.newline or
                kind == TokenKind.c_brace or
                kind == TokenKind.eof {
                ret true
            }
            if kind != TokenKind.comma { ret false }
            idx = idx + 1
            while self.tokens.get(idx).is_trivia() { idx = idx + 1 }
            kind = self.tokens.get(idx).kind
            if kind == TokenKind.eof { ret true }
        }
        true
    }

    import_symbols_continue :: fn(self &Self, indent u64, allow_unindented bool) bool {
        idx := self.cursor
        newline := false
        while idx < self.tokens.len() {
            token := self.tokens.get(idx)
            if token.is_newline() {
                newline = true
            } else if token.is_comment() {
                if newline and not allow_unindented and
                    self.line_indent(token.start as u64) <= indent { ret false }
            } else if not token.is_whitespace() {
                if not newline or token.kind != TokenKind.ident { ret false }
                if not allow_unindented and self.line_indent(token.start as u64) <= indent {
                    ret false
                }
                idx = idx + 1
                while self.tokens.get(idx).is_whitespace() { idx = idx + 1 }
                next := self.tokens.get(idx).kind
                ret next != TokenKind.colon and next != TokenKind.colon_colon and
                    next != TokenKind.eq and
                    next != TokenKind.dot and
                    next != TokenKind.o_paren and
                    next != TokenKind.o_bracket
            }
            idx = idx + 1
        }
        false
    }

    line_indent :: fn(self &Self, start u64) u64 {
        pos := start
        while pos > 0 and not Ascii.is_newline(*(self.source.ptr + pos - 1)) {
            pos = pos - 1
        }
        width: u64 = 0
        while pos < self.source.len and Ascii.is_whitespace(*(self.source.ptr + pos)) {
            width = width + (if *(self.source.ptr + pos) == '\t' { 4 as u64 } else { 1 as u64 })
            pos = pos + 1
        }
        width
    }

    parse_import :: fn(self &Self, top_level bool) &CstNode {
        start := self.bump().start as u64
        path := String.new(self.arena)
        if self.consume_if(TokenKind.dot) { path.push_char('.') }
        if not self.is_path_token(self.peek()) { self.failed = true }
        path.push_str(self.bump().text)

        while self.consume_if(TokenKind.dot) {
            if not self.is_path_token(self.peek()) {
                self.failed = true
                break
            }
            path.push_char('.')
            path.push_str(self.bump().text)
        }

        node := cst_new(self.arena, CstKind.import_stmt, path.as_str())
        if self.consume_if(TokenKind.kw_as) {
            if self.peek() != TokenKind.ident { self.failed = true }
            node.add_child(cst_leaf(self.arena, CstKind.ident, self.bump().text))
        } else if self.consume_if(TokenKind.colon) {
            indent := self.line_indent(start)
            has_symbol := false
            while not self.is_eof() {
                kind := self.peek()
                if kind == TokenKind.newline or kind == TokenKind.comment {
                    if not self.import_symbols_continue(indent, top_level or not has_symbol) {
                        break
                    }
                    self.read_trivia(node, TokenKind.eof)
                }
                if self.peek() != TokenKind.ident or self.is_binding() or self.is_var_decl() {
                    break
                }
                symbol := cst_new(self.arena, CstKind.import_symbol, self.bump().text)
                if self.consume_if(TokenKind.kw_as) {
                    if self.peek() != TokenKind.ident { self.failed = true }
                    symbol.add_child(cst_leaf(self.arena, CstKind.ident, self.bump().text))
                }
                node.add_child(symbol)
                has_symbol = true
                if not self.consume_if(TokenKind.comma) and
                    not self.import_symbols_continue(indent, top_level) { break }
            }
            if not has_symbol { self.failed = true }
        }
        node
    }

    parse_binding :: fn(self &Self) &CstNode {
        name_tok := self.bump()
        self.bump()
        rhs := self.parse_expr(0 as u8)
        node := cst_new(self.arena, CstKind.binding_stmt, name_tok.text)
        node.add_child(rhs)
        node
    }

    parse_var_decl :: fn(self &Self) &CstNode {
        name_tok := self.bump()
        self.bump()

        if self.consume_if(TokenKind.eq) {
            init_expr := self.parse_expr(0 as u8)
            node := cst_new(self.arena, CstKind.var_decl_stmt, Str.of(":="))
            name_node := cst_leaf(self.arena, CstKind.ident, name_tok.text)
            node.add_child(name_node)
            node.add_child(init_expr)
            ret node
        }
        ty_node := self.parse_type()
        node := cst_new(self.arena, CstKind.var_decl_stmt, Str.of(":"))
        name_node := cst_leaf(self.arena, CstKind.ident, name_tok.text)
        node.add_child(name_node)
        node.add_child(ty_node)

        if self.consume_if(TokenKind.eq) {
            init_expr := self.parse_expr(0 as u8)
            node.add_child(init_expr)
        } else if self.consume_if(TokenKind.colon) {
            init_expr := self.parse_expr(0 as u8)
            node.text = Str.of("::")
            node.add_child(init_expr)
        }
        node
    }

    parse_destructure :: fn(self &Self) &CstNode {
        node := cst_new(self.arena, CstKind.destructure_stmt, Str.of(":="))
        first := self.bump()
        node.add_child(cst_leaf(self.arena, CstKind.ident, first.text))

        while self.consume_if(TokenKind.comma) {
            ident_tok := self.bump()
            node.add_child(cst_leaf(self.arena, CstKind.ident, ident_tok.text))
        }

        self.consume_if(TokenKind.colon)
        self.consume_if(TokenKind.eq)

        rhs := self.parse_expr(0 as u8)
        node.add_child(rhs)
        node
    }

    parse_block :: fn(self &Self) &CstNode {
        self.skip_ws_and_nl()
        self.expect(TokenKind.o_brace)
        node := cst_new(self.arena, CstKind.block_expr, "")
        self.parse_statements(node, TokenKind.c_brace)
        self.expect(TokenKind.c_brace)
        node
    }

    parse_statements :: fn(self &Self, node &CstNode, end TokenKind) {
        while not self.is_eof() {
            self.read_trivia(node, end)
            if self.is_eof() or self.peek() == end { break }
            node.add_child(self.parse_stmt(node.kind == CstKind.file))
            self.list_separator(end)
        }
    }

    parse_stmt :: fn(self &Self, top_level bool) &CstNode {
        if self.peek() == TokenKind.kw_import {
            ret self.parse_import(top_level)
        }
        if self.is_binding() {
            ret self.parse_binding()
        }
        if self.is_destructure() {
            ret self.parse_destructure()
        }
        if self.is_var_decl() {
            ret self.parse_var_decl()
        }
        self.parse_expr(0 as u8)
    }

    parse_extern :: fn(self &Self, min_bp u8) &CstNode {
        self.bump()
        kind := self.peek()
        name := if kind == TokenKind.lit_str or kind == TokenKind.lit_raw_str {
            self.bump().text
        } else {
            Str.empty()
        }
        node := cst_new(self.arena, CstKind.extern_decl, name)
        if self.peek() == TokenKind.lit_str {
            node.add_child(cst_leaf(self.arena, CstKind.lit_str, self.bump().text))
        }
        if self.peek() == TokenKind.kw_struct {
            node.add_child(self.parse_struct())
        } else if self.peek() == TokenKind.kw_fn {
            node.add_child(self.parse_fn(min_bp))
        } else {
            self.failed = true
        }
        node
    }

    flush_anonymous_params :: fn(self &Self, node &CstNode, pending &Vec(Str)) {
        for name in pending.as_slice() {
            param := cst_new(self.arena, CstKind.fn_param, "")
            param.add_child(cst_leaf(self.arena, CstKind.ident, name))
            node.add_child(param)
        }
        pending.clear()
    }

    is_primitive :: fn(self &Self, name Str) bool {
        name.eq("i8") or name.eq("i16") or name.eq("i32") or name.eq("i64") or name.eq("i128") or
            name.eq("u8") or
            name.eq("u16") or
            name.eq("u32") or
            name.eq("u64") or
            name.eq("u128") or
            name.eq("f32") or
            name.eq("f64") or
            name.eq("bool") or
            name.eq("type")
    }

    parse_fn :: fn(self &Self, min_bp u8) &CstNode {
        self.bump()
        node := cst_new(self.arena, CstKind.fn_def, "")
        self.expect(TokenKind.o_paren)
        pending := Vec(Str).new()
        while not self.is_eof() {
            k := self.peek()
            if k == TokenKind.comment or k == TokenKind.newline or k == TokenKind.c_paren {
                self.flush_anonymous_params(node, &pending)
                self.read_trivia(node, TokenKind.c_paren)
                if self.is_eof() or self.peek() == TokenKind.c_paren { break }
            }
            comptime := self.consume_if(TokenKind.kw_cmpt)
            param := cst_new(self.arena, CstKind.fn_param, if comptime { "cmpt" } else { "" })
            k = self.peek()
            next := self.peek_non_ws(1).kind
            if comptime {
                if pending.len != 0 or k != TokenKind.ident { self.failed = true }
                param.add_child(cst_leaf(self.arena, CstKind.ident, self.bump().text))
                param.add_child(self.parse_type())
            } else if self.is_type_token(k) or
                (
                    k == TokenKind.ident and
                        (
                            next == TokenKind.dot or next == TokenKind.o_paren or
                                next == TokenKind.pipe
                        )
                ) {
                self.flush_anonymous_params(node, &pending)
                param.add_child(self.parse_type())
            } else if k == TokenKind.ident {
                name := self.bump().text
                pending.push(name)
                k = self.peek()
                if k == TokenKind.ident or self.is_type_token(k) {
                    for item in pending.as_slice() {
                        param.add_child(cst_leaf(self.arena, CstKind.ident, item))
                    }
                    pending.clear()
                    param.add_child(self.parse_type())
                } else {
                    if self.is_primitive(name) { self.flush_anonymous_params(node, &pending) }
                    self.list_separator(TokenKind.c_paren)
                    cont
                }
            } else {
                self.failed = true
                break
            }
            node.add_child(param)
            self.list_separator(TokenKind.c_paren)
        }
        self.flush_anonymous_params(node, &pending)
        pending.destroy()
        self.expect(TokenKind.c_paren)
        self.skip_ws()
        next := self.peek()
        if next == TokenKind.ident or self.is_type_token(next) or next == TokenKind.o_paren {
            ret_ty := self.parse_type()
            node.add_child(ret_ty)
        }
        self.skip_ws()
        if min_bp <= 15 and self.peek_trivia_free(0).kind == TokenKind.o_brace and
            self.peek() != TokenKind.comment {
            self.skip_ws_and_nl()
            body := self.parse_block()
            node.add_child(body)
        }
        node
    }

    parse_struct :: fn(self &Self) &CstNode {
        self.bump()
        struct_node := cst_new(self.arena, CstKind.struct_def, Str.empty())

        if not self.consume_if(TokenKind.o_brace) {
            self.failed = true
            ret struct_node
        }
        if self.is_tuple_struct() {
            struct_node.text = Str.of("tuple")
            while not self.is_eof() {
                self.read_trivia(struct_node, TokenKind.c_brace)
                if self.is_eof() or self.peek() == TokenKind.c_brace { break }
                struct_node.add_child(self.parse_type())
                self.list_separator(TokenKind.c_brace)
            }
            self.expect(TokenKind.c_brace)
            ret struct_node
        }
        while not self.is_eof() {
            self.read_trivia(struct_node, TokenKind.c_brace)
            if self.is_eof() or self.peek() == TokenKind.c_brace { break }
            if self.peek() == TokenKind.kw_import {
                struct_node.add_child(self.parse_import(false))
                cont
            }
            if self.peek() == TokenKind.hash {
                struct_node.add_child(self.parse_expr(0 as u8))
                self.list_separator(TokenKind.c_brace)
                cont
            }
            if self.is_binding() {
                struct_node.add_child(self.parse_binding())
                self.list_separator(TokenKind.c_brace)
                cont
            }
            field_node := cst_new(self.arena, CstKind.struct_field, Str.empty())
            first_name := self.bump()
            if first_name.kind != TokenKind.ident { self.failed = true }
            field_node.add_child(cst_leaf(self.arena, CstKind.ident, first_name.text))

            while self.consume_if(TokenKind.comma) {
                self.skip_ws_and_nl()
                extra_name := self.bump()
                if extra_name.kind != TokenKind.ident { self.failed = true }
                field_node.add_child(cst_leaf(self.arena, CstKind.ident, extra_name.text))
            }

            field_ty := self.parse_type()
            field_node.add_child(field_ty)
            struct_node.add_child(field_node)

            self.list_separator(TokenKind.c_brace)
        }

        self.expect(TokenKind.c_brace)
        struct_node
    }

    parse_enum :: fn(self &Self) &CstNode {
        self.bump()
        enum_node := cst_new(self.arena, CstKind.enum_def, Str.empty())

        if self.peek() != TokenKind.o_brace {
            backing_ty := self.parse_type()
            enum_node.text = "backing"
            enum_node.add_child(backing_ty)
        }
        if not self.consume_if(TokenKind.o_brace) {
            self.failed = true
            ret enum_node
        }
        while not self.is_eof() {
            self.read_trivia(enum_node, TokenKind.c_brace)
            if self.is_eof() or self.peek() == TokenKind.c_brace { break }
            if self.peek() == TokenKind.kw_import {
                enum_node.add_child(self.parse_import(false))
                cont
            }
            if self.peek() == TokenKind.hash {
                enum_node.add_child(self.parse_expr(0 as u8))
                self.list_separator(TokenKind.c_brace)
                cont
            }
            if self.is_binding() {
                enum_node.add_child(self.parse_binding())
                self.list_separator(TokenKind.c_brace)
                cont
            }
            var_name := self.bump()
            if var_name.kind != TokenKind.ident { self.failed = true }
            var_node := cst_new(self.arena, CstKind.enum_variant, var_name.text)

            if self.consume_if(TokenKind.eq) {
                val_expr := self.parse_expr(0 as u8)
                var_node.add_child(val_expr)
            }
            enum_node.add_child(var_node)
            self.list_separator(TokenKind.c_brace)
        }

        self.expect(TokenKind.c_brace)
        enum_node
    }

    parse_if :: fn(self &Self) &CstNode {
        self.bump()
        cond := self.parse_expr(0 as u8)
        then_block := self.parse_block()

        if_node := cst_new(self.arena, CstKind.if_expr, Str.empty())
        if_node.add_child(cond)
        if_node.add_child(then_block)

        if self.peek_trivia_free(0).kind == TokenKind.kw_else {
            self.read_trivia(if_node, TokenKind.kw_else)
            self.expect(TokenKind.kw_else)
            self.skip_ws_and_nl()
            if self.peek() == TokenKind.comment {
                if_node.add_child(self.parse_expr(0 as u8))
            } else if self.peek() == TokenKind.kw_if {
                if self.depth >= 256 {
                    self.failed = true
                    ret if_node
                }
                self.depth = self.depth + 1
                if_node.add_child(self.parse_if())
                self.depth = self.depth - 1
            } else {
                if_node.add_child(self.parse_block())
            }
        }
        if_node
    }

    parse_while :: fn(self &Self) &CstNode {
        self.bump()
        cond := self.parse_expr(0 as u8)
        body := self.parse_block()

        while_node := cst_new(self.arena, CstKind.while_expr, Str.empty())
        while_node.add_child(cond)
        while_node.add_child(body)
        while_node
    }

    parse_for :: fn(self &Self) &CstNode {
        self.bump()
        for_node := cst_new(self.arena, CstKind.for_expr, Str.empty())

        vars_node := cst_new(self.arena, CstKind.ident, Str.empty())
        first_var := self.bump()
        vars_node.add_child(cst_leaf(self.arena, CstKind.ident, first_var.text))

        while self.consume_if(TokenKind.comma) {
            self.skip_ws_and_nl()
            v := self.bump()
            vars_node.add_child(cst_leaf(self.arena, CstKind.ident, v.text))
        }

        self.expect(TokenKind.kw_in)

        iters_node := cst_new(self.arena, CstKind.paren_expr, Str.empty())
        first_iter := self.parse_expr(0 as u8)
        iters_node.add_child(first_iter)

        while self.consume_if(TokenKind.comma) {
            self.skip_ws_and_nl()
            extra_iter := self.parse_expr(0 as u8)
            iters_node.add_child(extra_iter)
        }

        body := self.parse_block()

        for_node.add_child(vars_node)
        for_node.add_child(iters_node)
        for_node.add_child(body)
        for_node
    }

    parse_match :: fn(self &Self) &CstNode {
        self.bump()
        first_expr := self.parse_expr(0 as u8)
        match_node := cst_new(self.arena, CstKind.match_expr, Str.empty())

        if self.consume_if(TokenKind.kw_in) {
            in_val := self.parse_expr(0 as u8)
            match_node.text = Str.of("in")
            match_node.add_child(first_expr)
            match_node.add_child(in_val)
        } else {
            match_node.add_child(first_expr)
        }

        self.skip_ws_and_nl()
        if not self.consume_if(TokenKind.o_brace) {
            self.failed = true
            ret match_node
        }
        while not self.is_eof() {
            self.read_trivia(match_node, TokenKind.c_brace)
            if self.is_eof() or self.peek() == TokenKind.c_brace { break }
            arm_node := cst_new(self.arena, CstKind.match_arm, Str.empty())

            if self.consume_if(TokenKind.kw_else) {
                arm_node.text = Str.of("else")
                body := self.parse_block()
                arm_node.add_child(body)
            } else {
                pat := self.parse_expr(0 as u8)
                arm_node.add_child(pat)

                while self.consume_if(TokenKind.comma) {
                    self.skip_ws_and_nl()
                    if self.peek() == TokenKind.o_brace {
                        break
                    }
                    extra_pat := self.parse_expr(0 as u8)
                    arm_node.add_child(extra_pat)
                }

                body := self.parse_block()
                arm_node.add_child(body)
            }

            match_node.add_child(arm_node)
            self.list_separator(TokenKind.c_brace)
        }

        self.expect(TokenKind.c_brace)
        match_node
    }

    parse_type :: fn(self &Self) &CstNode {
        self.parse_expr(16 as u8)
    }

    parse_array_type :: fn(self &Self) &CstNode {
        self.bump()
        node := if self.consume_if(TokenKind.c_bracket) {
            cst_new(self.arena, CstKind.type_slice, "")
        } else {
            array := cst_new(self.arena, CstKind.type_array, "")
            array.add_child(self.parse_expr(0 as u8))
            self.expect(TokenKind.c_bracket)
            array
        }
        node.add_child(self.parse_type())
        node
    }

    parse_expr :: fn(self &Self, min_bp u8) &CstNode {
        if self.depth >= 256 {
            self.failed = true
            ret cst_leaf(self.arena, CstKind.ident, "")
        }
        self.depth = self.depth + 1
        lhs := self.parse_prefix(min_bp)

        while not self.is_eof() {
            checkpoint := self.cursor
            if self.peek() == TokenKind.newline {
                self.skip_ws_and_nl()
                if not self.is_soft_op(self.peek()) {
                    self.cursor = checkpoint
                    break
                }
            }
            bp := self.infix_binding_power(self.peek())
            if bp == 0 as u8 or bp < min_bp {
                self.cursor = checkpoint
                break
            }
            op_tok := self.bump()
            lhs = self.parse_infix(op_tok, lhs, bp)
        }

        self.depth = self.depth - 1
        lhs
    }

    is_soft_op :: fn(self &Self, k TokenKind) bool {
        if k == TokenKind.plus or k == TokenKind.slash or k == TokenKind.percent {
            ret true
        }
        if k == TokenKind.colon or k == TokenKind.colon_colon {
            ret true
        }
        if k == TokenKind.eq_eq or k == TokenKind.bang_eq {
            ret true
        }
        if k == TokenKind.lt or k == TokenKind.gt or k == TokenKind.lt_eq or k == TokenKind.gt_eq {
            ret true
        }
        if k == TokenKind.kw_and or k == TokenKind.kw_or {
            ret true
        }
        if k == TokenKind.pipe or k == TokenKind.caret or k == TokenKind.left_shift or
            k == TokenKind.right_shift {
            ret true
        }
        if k == TokenKind.eq or k == TokenKind.plus_eq or k == TokenKind.minus_eq or
            k == TokenKind.star_eq or
            k == TokenKind.slash_eq or
            k == TokenKind.percent_eq {
            ret true
        }
        if k == TokenKind.amp_eq or k == TokenKind.pipe_eq or k == TokenKind.caret_eq or
            k == TokenKind.left_shift_eq or
            k == TokenKind.right_shift_eq {
            ret true
        }
        if k == TokenKind.kw_as {
            ret true
        }
        false
    }

    infix_binding_power :: fn(self &Self, k TokenKind) u8 {
        if k == TokenKind.dot {
            ret 160
        }
        if k == TokenKind.o_paren or k == TokenKind.o_bracket {
            ret 150
        }
        if k == TokenKind.kw_as {
            ret 130
        }
        if k == TokenKind.star or k == TokenKind.slash or k == TokenKind.percent {
            ret 120
        }
        if k == TokenKind.plus or k == TokenKind.minus {
            ret 110
        }
        if k == TokenKind.left_shift or k == TokenKind.right_shift {
            ret 100
        }
        if k == TokenKind.amp {
            ret 90
        }
        if k == TokenKind.caret {
            ret 80
        }
        if k == TokenKind.pipe {
            ret 70
        }
        if k == TokenKind.eq_eq or k == TokenKind.bang_eq or k == TokenKind.lt or
            k == TokenKind.gt or
            k == TokenKind.lt_eq or
            k == TokenKind.gt_eq {
            ret 60
        }
        if k == TokenKind.kw_and {
            ret 40
        }
        if k == TokenKind.kw_or {
            ret 30
        }
        if k == TokenKind.eq or k == TokenKind.plus_eq or k == TokenKind.minus_eq or
            k == TokenKind.star_eq or
            k == TokenKind.slash_eq or
            k == TokenKind.percent_eq or
            k == TokenKind.amp_eq or
            k == TokenKind.pipe_eq or
            k == TokenKind.caret_eq or
            k == TokenKind.left_shift_eq or
            k == TokenKind.right_shift_eq {
            ret 10
        }
        0 as u8
    }

    has_newline_immediately_after :: fn(self &Self) bool {
        idx := self.cursor
        while idx < self.tokens.len() {
            t := self.tokens.get(idx)
            if t.is_newline() {
                ret true
            }
            if not t.is_whitespace() {
                ret false
            }
            idx = idx + 1
        }
        true
    }

    parse_prefix :: fn(self &Self, min_bp u8) &CstNode {
        self.skip_ws_and_nl()
        k := self.peek()

        if k == TokenKind.lit_int {
            ret cst_leaf(self.arena, CstKind.lit_int, self.bump().text)
        }
        if k == TokenKind.lit_float {
            ret cst_leaf(self.arena, CstKind.lit_float, self.bump().text)
        }
        if k == TokenKind.lit_str {
            ret cst_leaf(self.arena, CstKind.lit_str, self.bump().text)
        }
        if k == TokenKind.lit_cstr {
            ret cst_leaf(self.arena, CstKind.lit_cstr, self.bump().text)
        }
        if k == TokenKind.lit_raw_str {
            ret cst_leaf(self.arena, CstKind.lit_raw_str, self.bump().text)
        }
        if k == TokenKind.lit_char {
            ret cst_leaf(self.arena, CstKind.lit_char, self.bump().text)
        }
        if k == TokenKind.kw_true or k == TokenKind.kw_false {
            ret cst_leaf(self.arena, CstKind.lit_bool, self.bump().text)
        }
        if k == TokenKind.ident {
            ret cst_leaf(self.arena, CstKind.ident, self.bump().text)
        }
        if k == TokenKind.o_paren {
            self.bump()
            node := cst_new(self.arena, CstKind.paren_expr, "")
            self.read_trivia(node, TokenKind.c_paren)
            node.add_child(self.parse_expr(0 as u8))
            self.read_trivia(node, TokenKind.c_paren)
            self.expect(TokenKind.c_paren)
            ret node
        }
        if k == TokenKind.comment {
            node := cst_new(self.arena, CstKind.continued_expr, "")
            self.read_trivia(node, TokenKind.eof)
            node.add_child(self.parse_prefix(min_bp))
            ret node
        }
        if k == TokenKind.o_brace {
            ret self.parse_block()
        }
        if k == TokenKind.dot {
            next := self.peek_non_ws(1)
            if next.kind == TokenKind.o_brace {
                self.bump()
                self.bump()
                init_node := cst_new(self.arena, CstKind.struct_init, Str.empty())
                while not self.is_eof() {
                    self.read_trivia(init_node, TokenKind.c_brace)
                    if self.is_eof() or self.peek() == TokenKind.c_brace { break }
                    is_named := (self.peek() == TokenKind.ident) and
                        (self.peek_non_ws(1).kind == TokenKind.colon)
                    if is_named {
                        field_name := self.bump()
                        self.bump()
                        field_val := self.parse_type()
                        f := cst_new(self.arena, CstKind.struct_init_field, field_name.text)
                        f.add_child(field_val)
                        init_node.add_child(f)
                    } else {
                        field_val := self.parse_type()
                        f := cst_new(self.arena, CstKind.struct_init_field, Str.empty())
                        f.add_child(field_val)
                        init_node.add_child(f)
                    }
                    self.list_separator(TokenKind.c_brace)
                }
                self.expect(TokenKind.c_brace)
                ret init_node
            }
            if next.kind == TokenKind.o_bracket {
                self.bump()
                self.bump()
                arr_node := cst_new(self.arena, CstKind.array_lit, Str.empty())
                self.parse_arguments(arr_node, TokenKind.c_bracket)
                ret arr_node
            }
        }
        if k == TokenKind.o_bracket {
            ret self.parse_array_type()
        }
        if k == TokenKind.kw_extern {
            ret self.parse_extern(min_bp)
        }
        if k == TokenKind.kw_fn {
            ret self.parse_fn(min_bp)
        }
        if k == TokenKind.kw_struct {
            ret self.parse_struct()
        }
        if k == TokenKind.kw_enum {
            ret self.parse_enum()
        }
        if k == TokenKind.kw_if {
            ret self.parse_if()
        }
        if k == TokenKind.kw_while {
            ret self.parse_while()
        }
        if k == TokenKind.kw_for {
            ret self.parse_for()
        }
        if k == TokenKind.kw_match {
            ret self.parse_match()
        }
        if k == TokenKind.kw_ret {
            self.bump()
            ret_node := cst_new(self.arena, CstKind.ret_expr, Str.empty())
            if (not self.has_newline_immediately_after()) and (self.peek() != TokenKind.comma) and
                (self.peek() != TokenKind.comment) and
                (self.peek() != TokenKind.c_brace) and
                (not self.is_eof()) {
                val := self.parse_expr(0 as u8)
                ret_node.add_child(val)
            }
            ret ret_node
        }
        if k == TokenKind.kw_break {
            self.bump()
            ret cst_leaf(self.arena, CstKind.break_expr, Str.of("break"))
        }
        if k == TokenKind.kw_cont {
            self.bump()
            ret cst_leaf(self.arena, CstKind.cont_expr, Str.of("cont"))
        }
        if k == TokenKind.kw_cmpt {
            self.bump()
            bp := if min_bp > 11 { min_bp } else { 11 as u8 }
            body := self.parse_expr(bp)
            node := cst_new(self.arena, CstKind.cmpt_expr, Str.empty())
            node.add_child(body)
            ret node
        }
        if k == TokenKind.hash {
            hash := self.bump()
            bp := if min_bp > 11 { min_bp } else { 11 as u8 }
            expr := self.parse_expr(bp)
            node := cst_new(self.arena, CstKind.splice_expr, hash.text)
            node.add_child(expr)
            ret node
        }
        if k == TokenKind.at {
            self.bump()
            name_tok := self.bump()
            node := cst_new(self.arena, CstKind.builtin_expr, name_tok.text)
            if name_tok.kind != TokenKind.ident { self.failed = true }
            if self.consume_if(TokenKind.o_paren) {
                self.parse_arguments(node, TokenKind.c_paren)
            } else {
                self.failed = true
            }
            ret node
        }
        if k == TokenKind.minus or k == TokenKind.kw_not or k == TokenKind.tilde or
            k == TokenKind.amp or
            k == TokenKind.star {
            op_tok := self.bump()
            operand := self.parse_expr(140 as u8)
            ret cst_unary(self.arena, CstKind.unary_expr, op_tok.text, operand)
        }
        self.failed = true
        cst_leaf(self.arena, CstKind.ident, "")
    }

    parse_arguments :: fn(self &Self, node &CstNode, end TokenKind) {
        while not self.is_eof() {
            self.read_trivia(node, end)
            if self.is_eof() or self.peek() == end { break }
            node.add_child(self.parse_expr(0 as u8))
            self.list_separator(end)
        }
        self.expect(end)
    }

    parse_infix :: fn(self &Self, op Token, lhs &CstNode, bp u8) &CstNode {
        if op.kind == TokenKind.dot {
            k := self.peek()
            if k != TokenKind.ident and k != TokenKind.lit_int { self.failed = true }
            member_tok := self.bump()
            node := cst_new(self.arena, CstKind.member_expr, member_tok.text)
            node.add_child(lhs)
            ret node
        }
        if op.kind == TokenKind.o_paren {
            call_node := cst_new(self.arena, CstKind.call_expr, Str.empty())
            call_node.add_child(lhs)
            self.parse_arguments(call_node, TokenKind.c_paren)
            ret call_node
        }
        if op.kind == TokenKind.o_bracket {
            idx_node := cst_new(self.arena, CstKind.index_expr, Str.empty())
            idx_node.add_child(lhs)
            idx_expr := self.parse_expr(0 as u8)
            idx_node.add_child(idx_expr)
            self.expect(TokenKind.c_bracket)
            ret idx_node
        }
        if op.kind == TokenKind.kw_as {
            rhs_ty := self.parse_expr(bp + 1 as u8)
            node := cst_new(self.arena, CstKind.binary_expr, Str.of("as"))
            node.add_child(lhs)
            node.add_child(rhs_ty)
            ret node
        }
        is_assign := op.kind == TokenKind.eq or op.kind == TokenKind.plus_eq or
            op.kind == TokenKind.minus_eq or
            op.kind == TokenKind.star_eq or
            op.kind == TokenKind.slash_eq or
            op.kind == TokenKind.percent_eq or
            op.kind == TokenKind.amp_eq or
            op.kind == TokenKind.pipe_eq or
            op.kind == TokenKind.caret_eq or
            op.kind == TokenKind.left_shift_eq or
            op.kind == TokenKind.right_shift_eq

        rhs := self.parse_expr(bp + 1 as u8)
        k := if is_assign {
            CstKind.assign_expr
        } else {
            CstKind.binary_expr
        }
        cst_binary(self.arena, k, op.text, lhs, rhs)
    }

    parse :: fn(self &Self) &CstNode {
        node := cst_new(self.arena, CstKind.file, "")
        self.parse_statements(node, TokenKind.eof)
        node
    }
}

parse_to_cst :: fn(arena &Arena, source Str) &CstNode {
    parser := CstParser.new(arena, source)
    tree := parser.parse()
    parser.destroy()
    if parser.failed or tree.height > 256 { ret 0 as &CstNode }
    tree
}

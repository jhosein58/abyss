Arena :: @import("std/allocator").Arena

CstKind :: @import("./cst").CstKind
CstNode :: @import("./cst").CstNode
Layout :: @import("./layout").Layout

default_width :: 100

Formatter :: struct {
    layout Layout

    new :: fn() Self {
        .{ layout: Layout.new() }
    }

    format_node :: fn(self &Self, node &CstNode, level u32) {
        match node.kind {
            file { self.format_file(node) }
            binding_stmt {
                self.layout.push_str(node.text)
                self.layout.space_and_text("::")
                self.layout.spaces(1)
                self.format_node(node.child(0), level)
            }
            var_decl_stmt { self.format_var_decl(node, level) }
            destructure_stmt {
                last := node.child_count() - 1
                self.format_joined(node.children.sub(0, last), level)
                self.layout.space_and_text(":=")
                self.layout.spaces(1)
                self.format_node(node.child(last), level)
            }
            extern_decl {
                self.layout.push_str("extern ")
                if node.text.len > 0 {
                    self.layout.push_str(node.text)
                    self.layout.spaces(1)
                }
                for part in node.children {
                    self.format_node(part, level)
                    if part.kind == CstKind.lit_str { self.layout.spaces(1) }
                }
            }
            fn_def { self.format_fn(node, level) }
            fn_param { self.format_typed_names(node, level, 0) }
            struct_def { self.format_struct(node, level) }
            struct_field { self.format_typed_names(node, level, 0) }
            enum_def { self.format_enum(node, level) }
            enum_variant {
                self.layout.push_str(node.text)
                if node.child_count() > 0 {
                    self.layout.push_str(" = ")
                    self.format_node(node.child(0), level)
                }
            }
            if_expr { self.format_if(node, level) }
            while_expr {
                self.layout.push_str("while ")
                self.format_node(node.child(0), level)
                self.layout.spaces(1)
                self.format_node(node.child(1), level)
            }
            for_expr {
                self.layout.push_str("for ")
                self.format_joined(node.child(0).children, level)
                self.layout.push_str(" in ")
                self.format_joined(node.child(1).children, level)
                self.layout.spaces(1)
                self.format_node(node.child(2), level)
            }
            match_expr { self.format_match(node, level) }
            match_arm {
                last := node.child_count() - 1
                if node.text.eq("else") {
                    self.layout.push_str("else")
                } else {
                    self.format_joined(node.children.sub(0, last), level)
                }
                self.layout.spaces(1)
                self.format_node(node.child(last), level)
            }
            continued_expr { self.format_continuation(node, level) }
            block_expr { self.format_list(node.children, "{", "}", 1, level, node.multiline) }
            binary_expr { self.format_binary(node, level) }
            assign_expr {
                self.format_node(node.child(0), level)
                self.layout.spaces(1)
                self.layout.push_str(node.text)
                self.layout.spaces(1)
                self.format_node(node.child(1), level)
            }
            unary_expr {
                self.layout.push_str(node.text)
                arg := node.child(0)
                if node.text.eq("not") or
                    (node.text.eq("-") and arg.kind == CstKind.unary_expr and arg.text.eq("-")) {
                    self.layout.spaces(1)
                }
                self.format_node(arg, level)
            }
            call_expr {
                self.format_node(node.child(0), level)
                self.format_list(
                    node.children.sub(1, node.child_count() - 1)
                    "("
                    ")"
                    0
                    level
                    node.multiline
                )
            }
            member_expr {
                self.format_node(node.child(0), level)
                if node.child(0).kind == CstKind.lit_int and node.text.len > 0 and
                    *(node.text.ptr) >= '0' and
                    *(node.text.ptr) <= '9' {
                    self.layout.spaces(1)
                }
                self.layout.push_str(".")
                self.layout.push_str(node.text)
            }
            index_expr {
                self.format_node(node.child(0), level)
                self.layout.push_str("[")
                self.format_node(node.child(1), level)
                self.layout.push_str("]")
            }
            struct_init { self.format_list(node.children, ".{", "}", 1, level, node.multiline) }
            struct_init_field {
                if node.text.len > 0 {
                    self.layout.push_str(node.text)
                    self.layout.push_str(":")
                    self.layout.spaces(1)
                }
                self.format_node(node.child(0), level)
            }
            array_lit { self.format_list(node.children, ".[", "]", 1, level, node.multiline) }
            paren_expr { self.format_list(node.children, "(", ")", 0, level, node.multiline) }
            ret_expr {
                self.layout.push_str("ret")
                if node.child_count() > 0 {
                    self.layout.spaces(1)
                    self.format_node(node.child(0), level)
                }
            }
            cmpt_expr {
                self.layout.push_str("cmpt ")
                self.format_node(node.child(0), level)
            }
            splice_expr {
                self.layout.push_str(node.text)
                self.format_node(node.child(0), level)
            }
            builtin_expr {
                self.layout.push_str("@")
                self.layout.push_str(node.text)
                self.format_list(node.children, "(", ")", 0, level, node.multiline)
            }
            type_slice {
                self.layout.push_str("[]")
                self.format_node(node.child(0), level)
            }
            type_array {
                self.layout.push_str("[")
                self.format_node(node.child(0), level)
                self.layout.push_str("]")
                self.format_node(node.child(1), level)
            }
            comment_stmt { self.layout.comment(node.text, false) }
            else { self.layout.push_str(node.text) }
        }
    }

    format_continuation :: fn(self &Self, node &CstNode, level u32) {
        last := node.child_count() - 1
        for item in node.children.sub(0, last) {
            if item.kind == CstKind.inline_comment {
                self.layout.comment(item.text, true)
            } else if item.kind == CstKind.empty_line {
                self.layout.line(0)
            } else {
                self.layout.line(level + 1)
                self.layout.comment(item.text, false)
            }
        }
        self.layout.line(level + 1)
        self.format_node(node.child(last), level + 1)
    }

    format_binary :: fn(self &Self, node &CstNode, level u32) {
        mark := self.layout.start_group()
        self.format_node(node.child(0), level)
        self.layout.space_and_text(node.text)
        right := node.child(1)
        if right.kind == CstKind.continued_expr {
            self.format_node(right, level)
        } else if node.text.eq("as") {
            self.layout.spaces(1)
            self.format_node(right, level)
        } else {
            self.layout.soft_pad(1, level + 1)
            self.format_node(right, level + 1)
        }
        self.layout.end_group(mark, false)
    }

    format_var_decl :: fn(self &Self, node &CstNode, level u32) {
        self.format_node(node.child(0), level)
        if node.text.eq(":=") {
            self.layout.space_and_text(":=")
            self.layout.spaces(1)
            self.format_node(node.child(1), level)
            ret
        }
        self.layout.push_str(":")
        self.layout.spaces(1)
        self.format_node(node.child(1), level)
        if node.child_count() > 2 {
            self.layout.space_and_text(if node.text.eq("::") { ":" } else { "=" })
            self.layout.spaces(1)
            self.format_node(node.child(2), level)
        }
    }

    format_joined :: fn(self &Self, nodes Slice(&CstNode), level u32) {
        first := true
        for node in nodes {
            if not first { self.layout.push_str(", ") }
            self.format_node(node, level)
            first = false
        }
    }

    format_list :: fn(
        self &Self
        nodes Slice(&CstNode)
        open Str
        close Str
        pad u64
        level u32
        multiline bool
    ) {
        mark := self.layout.start_group()
        self.layout.push_str(open)
        if nodes.len > 0 {
            self.format_entries(nodes, pad, level + 1)
            self.layout.soft_pad(pad, level)
        }
        self.layout.push_str(close)
        self.layout.end_group(mark, multiline and nodes.len > 0)
    }

    format_entries :: fn(self &Self, nodes Slice(&CstNode), pad u64, level u32) {
        first := true
        align: u64 = 0
        in_fields := false
        i: u64 = 0
        while i < nodes.len {
            node := nodes.get(i)
            if node.kind == CstKind.inline_comment {
                self.layout.comment(node.text, true)
                first = false
            } else if node.kind == CstKind.empty_line {
                if not first { self.layout.line(0) }
                in_fields = false
            } else {
                if first {
                    self.layout.soft_pad(pad, level)
                } else {
                    self.layout.soft_line(", ", level)
                }
                if node.kind == CstKind.struct_field {
                    if not in_fields { align = self.field_alignment(nodes.sub(i, nodes.len - i)) }
                    in_fields = true
                    self.format_typed_names(node, level, align)
                } else {
                    in_fields = false
                    self.format_node(node, level)
                }
                first = false
            }
            i = i + 1
        }
    }

    format_fn :: fn(self &Self, node &CstNode, level u32) {
        count := node.child_count()
        has_body := count > 0 and node.child(count - 1).kind == CstKind.block_expr
        params := if has_body { count - 1 } else { count }
        has_ret := params > 0 and node.child(params - 1).kind != CstKind.fn_param and
            not node.child(params - 1).is_comment()
        if has_ret { params = params - 1 }
        self.format_list(node.children.sub(0, params), "fn(", ")", 0, level, node.multiline)
        if has_ret {
            self.layout.spaces(1)
            self.format_node(node.child(params), level)
        }
        if has_body {
            self.layout.spaces(1)
            self.format_node(node.child(count - 1), level)
        }
    }

    name_width :: fn(self &Self, names Slice(&CstNode)) u64 {
        width: u64 = 0
        for name in names {
            width = width + name.text.len + 2
        }
        if width > 0 { ret width - 2 }
        0
    }

    field_alignment :: fn(self &Self, nodes Slice(&CstNode)) u64 {
        shortest: u64 = 0
        longest: u64 = 0
        for node in nodes {
            if node.kind == CstKind.inline_comment { cont }
            if node.kind != CstKind.struct_field { break }
            width := self.name_width(node.children.sub(0, node.child_count() - 1))
            if shortest == 0 or width < shortest { shortest = width }
            if width > longest { longest = width }
        }
        if longest - shortest <= 24 { ret longest }
        0
    }

    format_typed_names :: fn(self &Self, node &CstNode, level u32, align u64) {
        if node.text.eq("cmpt") { self.layout.push_str("cmpt ") }
        last := node.child_count() - 1
        if last > 0 {
            names := node.children.sub(0, last)
            self.format_joined(names, level)
            width := self.name_width(names)
            self.layout.spaces(if align > width { align - width + 1 } else { 1 as u64 })
        }
        self.format_node(node.child(last), level)
    }

    format_struct :: fn(self &Self, node &CstNode, level u32) {
        self.format_list(
            node.children
            "struct {"
            "}"
            1
            level
            node.multiline or not node.text.eq("tuple")
        )
    }

    format_enum :: fn(self &Self, node &CstNode, level u32) {
        self.layout.push_str("enum ")
        start: u64 = 0
        if node.text.eq("backing") {
            self.format_node(node.child(0), level)
            self.layout.spaces(1)
            start = 1
        }
        self.format_list(
            node.children.sub(start, node.child_count() - start)
            "{"
            "}"
            1
            level
            true
        )
    }

    format_if :: fn(self &Self, node &CstNode, level u32) {
        self.layout.push_str("if ")
        self.format_node(node.child(0), level)
        self.layout.spaces(1)
        self.format_node(node.child(1), level)
        count := node.child_count()
        if count < 3 { ret }
        if count == 3 {
            self.layout.spaces(1)
        } else {
            for item in node.children.sub(2, count - 3) {
                if item.kind == CstKind.inline_comment {
                    self.layout.comment(item.text, true)
                } else if item.kind == CstKind.empty_line {
                    self.layout.line(0)
                } else {
                    self.layout.line(level)
                    self.layout.comment(item.text, false)
                }
            }
            self.layout.line(level)
        }
        self.layout.push_str("else")
        self.layout.spaces(1)
        self.format_node(node.child(count - 1), level)
    }

    format_match :: fn(self &Self, node &CstNode, level u32) {
        self.layout.push_str("match ")
        self.format_node(node.child(0), level)
        start: u64 = 1
        if node.text.eq("in") {
            self.layout.push_str(" in ")
            self.format_node(node.child(1), level)
            start = 2
        }
        self.layout.spaces(1)
        self.format_list(
            node.children.sub(start, node.child_count() - start)
            "{"
            "}"
            1
            level
            true
        )
    }

    format_file :: fn(self &Self, node &CstNode) {
        for index in Range.new(0, node.child_count() as i32) {
            i := index as u64
            child := node.child(i)
            if child.kind == CstKind.inline_comment {
                self.layout.comment(child.text, true)
            } else if child.kind == CstKind.empty_line {
                self.layout.line(0)
            } else {
                if i > 0 { self.layout.line(0) }
                self.format_node(child, 0)
            }
        }
        if node.child_count() > 0 { self.layout.line(0) }
    }
}

format_cst_with_width :: fn(arena &Arena, root &CstNode, width u64) Str {
    formatter := Formatter.new()
    formatter.format_node(root, 0)
    result := formatter.layout.render(arena, width)
    formatter.layout.destroy()
    result
}

format_cst :: fn(arena &Arena, root &CstNode) Str {
    format_cst_with_width(arena, root, default_width)
}

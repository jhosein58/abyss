import std.allocator:       Arena
import std.collections.vec: Vec
import std.string:          Str, String

import .cst: CstKind, CstNode

str_less :: fn(a Str, b Str) bool {
    min_len := if a.len < b.len {
        a.len
    } else {
        b.len
    }
    i: u64 = 0
    while i < min_len {
        ca := *(a.ptr + i)
        cb := *(b.ptr + i)
        if ca < cb {
            ret true
        }
        if ca > cb {
            ret false
        }
        i = i + 1
    }
    a.len < b.len
}

import_group :: fn(path Str) u32 {
    if path.starts_with(Str.of("std.")) or path.starts_with(Str.of("core.")) or path.eq(Str.of("std")) or path.eq(Str.of("core")) {
        ret 1 as u32
    }
    if path.starts_with(Str.of(".")) {
        ret 3 as u32
    }
    2 as u32
}

import_less :: fn(a &CstNode, b &CstNode) bool {
    if str_less(a.text, b.text) {
        ret true
    }
    if str_less(b.text, a.text) {
        ret false
    }
    a_count := a.child_count()
    b_count := b.child_count()
    if (a_count > 0) and (b_count > 0) {
        sym_a := a.child(0)
        sym_b := b.child(0)
        if (sym_a.kind == CstKind.import_symbol) and (sym_b.kind == CstKind.import_symbol) {
            if str_less(sym_a.text, sym_b.text) {
                ret true
            }
            if str_less(sym_b.text, sym_a.text) {
                ret false
            }
        }
    }
    a_count < b_count
}

sort_imports :: fn(v &Vec(&CstNode)) {
    if v.len < 2 {
        ret
    }
    i: u64 = 0
    while i < v.len {
        min_idx := i
        j := i + 1
        while j < v.len {
            node_j := v.get(j)
            node_min := v.get(min_idx)
            if import_less(node_j, node_min) {
                min_idx = j
            }
            j = j + 1
        }
        if min_idx != i {
            tmp := v.get(i)
            v.set(i, v.get(min_idx))
            v.set(min_idx, tmp)
        }
        i = i + 1
    }
}

sort_symbols :: fn(v &Vec(&CstNode)) {
    if v.len < 2 {
        ret
    }
    i: u64 = 0
    while i < v.len {
        min_idx := i
        j := i + 1
        while j < v.len {
            sym_j := v.get(j)
            sym_min := v.get(min_idx)
            if str_less(sym_j.text, sym_min.text) {
                min_idx = j
            }
            j = j + 1
        }
        if min_idx != i {
            tmp := v.get(i)
            v.set(i, v.get(min_idx))
            v.set(min_idx, tmp)
        }
        i = i + 1
    }
    write_idx: u64 = 1
    read_idx: u64 = 1
    while read_idx < v.len {
        prev := v.get(write_idx - 1)
        curr := v.get(read_idx)
        if not curr.text.eq(prev.text) {
            if write_idx != read_idx {
                v.set(write_idx, curr)
            }
            write_idx = write_idx + 1
        }
        read_idx = read_idx + 1
    }
    v.len = write_idx
}

Formatter :: struct {
    buf   String
    arena &Arena
    new :: fn(arena &Arena) Self {
        .{ buf: String.new(arena), arena: arena }
    }

    indent :: fn(self &Self, level u32) {
        i: u32 = 0
        while i < level {
            self.buf.push_str(Str.of("    "))
            i = i + 1
        }
    }

    format_node :: fn(self &Self, node &CstNode, level u32) {
        if node == (0 as &CstNode) {
            ret
        }
        k := node.kind

        if k == CstKind.file {
            self.format_file(node)
            ret
        }
        if k == CstKind.import_stmt {
            self.format_import(node, 0 as u64)
            ret
        }
        if k == CstKind.binding_stmt {
            self.format_binding(node, level)
            ret
        }
        if k == CstKind.var_decl_stmt {
            self.format_var_decl(node, level)
            ret
        }
        if k == CstKind.destructure_stmt {
            self.format_destructure(node, level)
            ret
        }
        if k == CstKind.fn_def {
            self.format_fn(node, level)
            ret
        }
        if k == CstKind.struct_def {
            self.format_struct(node, level)
            ret
        }
        if k == CstKind.enum_def {
            self.format_enum(node, level)
            ret
        }
        if k == CstKind.if_expr {
            self.format_if(node, level)
            ret
        }
        if k == CstKind.while_expr {
            self.format_while(node, level)
            ret
        }
        if k == CstKind.for_expr {
            self.format_for(node, level)
            ret
        }
        if k == CstKind.match_expr {
            self.format_match(node, level)
            ret
        }
        if k == CstKind.block_expr {
            self.format_block(node, level)
            ret
        }
        if k == CstKind.empty_line {
            self.buf.push_char('\n' as u8)
            ret
        }
        if k == CstKind.comment_stmt {
            self.buf.push_str(node.text)
            ret
        }
        if k == CstKind.binary_expr or k == CstKind.assign_expr {
            self.format_binary(node, level)
            ret
        }
        if k == CstKind.unary_expr {
            self.format_unary(node, level)
            ret
        }
        if k == CstKind.call_expr {
            self.format_call(node, level)
            ret
        }
        if k == CstKind.member_expr {
            self.format_member(node, level)
            ret
        }
        if k == CstKind.index_expr {
            self.format_index(node, level)
            ret
        }
        if k == CstKind.struct_init {
            self.format_struct_init(node, level)
            ret
        }
        if k == CstKind.array_lit {
            self.format_array_lit(node, level)
            ret
        }
        if k == CstKind.paren_expr {
            self.buf.push_char('(' as u8)
            if node.child_count() > 0 {
                self.format_node(node.child(0), level)
            }
            self.buf.push_char(')' as u8)
            ret
        }
        if k == CstKind.ret_expr {
            self.buf.push_str(Str.of("ret"))
            if node.child_count() > 0 {
                self.buf.push_char(' ' as u8)
                self.format_node(node.child(0), level)
            }
            ret
        }
        if k == CstKind.break_expr {
            self.buf.push_str(Str.of("break"))
            ret
        }
        if k == CstKind.cont_expr {
            self.buf.push_str(Str.of("cont"))
            ret
        }
        if k == CstKind.cmpt_expr {
            self.buf.push_str(Str.of("cmpt "))
            if node.child_count() > 0 {
                self.format_node(node.child(0), level)
            }
            ret
        }
        if k == CstKind.splice_expr {
            self.buf.push_char('#' as u8)
            if node.text.eq("paren") {
                self.buf.push_char('(' as u8)
                if node.child_count() > 0 {
                    self.format_node(node.child(0), level)
                }
                self.buf.push_char(')' as u8)
            } else {
                if node.child_count() > 0 {
                    self.format_node(node.child(0), level)
                }
            }
            ret
        }
        if k == CstKind.builtin_expr {
            self.buf.push_char('@' as u8)
            self.buf.push_str(node.text)
            self.buf.push_char('(' as u8)
            i: u64 = 0
            while i < node.child_count() {
                if i > 0 {
                    self.buf.push_str(Str.of(", "))
                }
                self.format_node(node.child(i), level)
                i = i + 1
            }
            self.buf.push_char(')' as u8)
            ret
        }
        if k == CstKind.type_ptr {
            self.buf.push_char('&' as u8)
            if node.child_count() > 0 {
                self.format_node(node.child(0), level)
            }
            ret
        }
        if k == CstKind.type_slice {
            self.buf.push_str(Str.of("[]"))
            if node.child_count() > 0 {
                self.format_node(node.child(0), level)
            }
            ret
        }
        if k == CstKind.type_array {
            self.buf.push_char('[' as u8)
            self.buf.push_str(node.text)
            self.buf.push_char(']' as u8)
            if node.child_count() > 0 {
                self.format_node(node.child(0), level)
            }
            ret
        }
        if k == CstKind.type_generic {
            self.buf.push_str(node.text)
            self.buf.push_char('(' as u8)
            i: u64 = 0
            while i < node.child_count() {
                if i > 0 {
                    self.buf.push_str(Str.of(", "))
                }
                self.format_node(node.child(i), level)
                i = i + 1
            }
            self.buf.push_char(')' as u8)
            ret
        }
        self.buf.push_str(node.text)
    }

    format_file :: fn(self &Self, node &CstNode) {
        has_imports := false
        first_import_idx: u64 = node.child_count()
        idx: u64 = 0
        while idx < node.child_count() {
            c := node.child(idx)
            if c.kind == CstKind.import_stmt {
                if not has_imports {
                    has_imports = true
                    first_import_idx = idx
                }
            }
            idx = idx + 1
        }

        if not has_imports {
            i: u64 = 0
            while i < node.child_count() {
                c := node.child(i)
                if c.kind == CstKind.empty_line {
                    self.buf.push_char('\n' as u8)
                } else if c.kind == CstKind.comment_stmt {
                    self.buf.push_str(c.text)
                    self.buf.push_char('\n' as u8)
                } else {
                    self.format_node(c, 0)
                    self.buf.push_char('\n' as u8)
                }
                i = i + 1
            }
            ret
        }
        leading_content := false
        i: u64 = 0
        while i < first_import_idx {
            c := node.child(i)
            if c.kind == CstKind.comment_stmt {
                leading_content = true
                self.buf.push_str(c.text)
                self.buf.push_char('\n' as u8)
            } else if c.kind == CstKind.empty_line {
                if leading_content {
                    self.buf.push_char('\n' as u8)
                }
            }
            i = i + 1
        }

        g1 := Vec(&CstNode).new()
        g2 := Vec(&CstNode).new()
        g3 := Vec(&CstNode).new()

        scan_idx: u64 = 0
        while scan_idx < node.child_count() {
            c := node.child(scan_idx)
            if c.kind == CstKind.import_stmt {
                if (c.child_count() > 0) and (c.child(0).kind == CstKind.import_symbol) {
                    sort_symbols(&c.children)
                }
                grp := import_group(c.text)
                if grp == (1 as u32) {
                    g1.push(c)
                } else if grp == (2 as u32) {
                    g2.push(c)
                } else {
                    g3.push(c)
                }
            }
            scan_idx = scan_idx + 1
        }

        sort_imports(&g1)
        sort_imports(&g2)
        sort_imports(&g3)

        groups_emitted: u32 = 0

        if g1.len > 0 {
            self.format_import_group(&g1)
            groups_emitted = groups_emitted + 1
        }
        if g2.len > 0 {
            if groups_emitted > 0 {
                self.buf.push_char('\n' as u8)
            }
            self.format_import_group(&g2)
            groups_emitted = groups_emitted + 1
        }
        if g3.len > 0 {
            if groups_emitted > 0 {
                self.buf.push_char('\n' as u8)
            }
            self.format_import_group(&g3)
            groups_emitted = groups_emitted + 1
        }
        g1.destroy()
        g2.destroy()
        g3.destroy()

        first_rest_idx: u64 = node.child_count()
        has_rest := false
        r_idx: u64 = first_import_idx
        while r_idx < node.child_count() {
            c := node.child(r_idx)
            if (c.kind != CstKind.import_stmt) and (c.kind != CstKind.empty_line) {
                first_rest_idx = r_idx
                has_rest = true
                break
            }
            r_idx = r_idx + 1
        }

        if has_rest {
            self.buf.push_char('\n' as u8)
            last_was_empty := true

            rem_idx := first_rest_idx
            while rem_idx < node.child_count() {
                c := node.child(rem_idx)
                if c.kind == CstKind.import_stmt {
                    rem_idx = rem_idx + 1
                    cont
                }
                if c.kind == CstKind.empty_line {
                    if not last_was_empty {
                        self.buf.push_char('\n' as u8)
                        last_was_empty = true
                    }
                } else if c.kind == CstKind.comment_stmt {
                    self.buf.push_str(c.text)
                    self.buf.push_char('\n' as u8)
                    last_was_empty = false
                } else {
                    self.format_node(c, 0)
                    self.buf.push_char('\n' as u8)
                    last_was_empty = false
                }
                rem_idx = rem_idx + 1
            }
        }
    }

    calc_group_align :: fn(self &Self, g &Vec(&CstNode)) u64 {
        max_len: u64 = 0
        min_len: u64 = 999999
        has_symbols := false
        j: u64 = 0
        while j < g.len {
            item := g.get(j)
            if (item.child_count() > 0) and (item.child(0).kind == CstKind.import_symbol) {
                has_symbols = true
                l := item.text.len
                if l > max_len {
                    max_len = l
                }
                if l < min_len {
                    min_len = l
                }
            }
            j = j + 1
        }
        if has_symbols and (max_len - min_len <= 12) {
            ret max_len
        }
        0 as u64
    }

    format_import_group :: fn(self &Self, g &Vec(&CstNode)) {
        align_len := self.calc_group_align(g)
        j: u64 = 0
        while j < g.len {
            self.format_import(g.get(j), align_len)
            self.buf.push_char('\n' as u8)
            j = j + 1
        }
    }

    format_import :: fn(self &Self, node &CstNode, align_len u64) {
        self.buf.push_str(Str.of("import "))
        self.buf.push_str(node.text)

        if (node.child_count() == 1) and (node.child(0).kind == CstKind.ident) {
            self.buf.push_str(Str.of(" as "))
            self.buf.push_str(node.child(0).text)
            ret
        }
        if node.child_count() > 0 {
            if node.child(0).kind == CstKind.import_symbol {
                sort_symbols(&node.children)
            }
            self.buf.push_char(':' as u8)
            pad := if (align_len > 0) and (align_len >= node.text.len) {
                align_len - node.text.len + 1
            } else {
                1 as u64
            }
            p_i: u64 = 0
            while p_i < pad {
                self.buf.push_char(' ' as u8)
                p_i = p_i + 1
            }
            i: u64 = 0
            while i < node.child_count() {
                if i > 0 {
                    self.buf.push_str(Str.of(", "))
                }
                sym := node.child(i)
                self.buf.push_str(sym.text)
                if sym.child_count() > 0 {
                    self.buf.push_str(Str.of(" as "))
                    self.buf.push_str(sym.child(0).text)
                }
                i = i + 1
            }
        }
    }

    format_binding :: fn(self &Self, node &CstNode, level u32) {
        self.buf.push_str(node.text)
        self.buf.push_str(Str.of(" :: "))
        if node.child_count() > 0 {
            self.format_node(node.child(0), level)
        }
    }

    format_var_decl :: fn(self &Self, node &CstNode, level u32) {
        if node.child_count() > 0 {
            self.format_node(node.child(0), level)
        }
        if node.text.eq(":=") {
            self.buf.push_str(Str.of(" := "))
            if node.child_count() > 1 {
                self.format_node(node.child(1), level)
            }
        } else if node.text.eq("::") {
            self.buf.push_str(Str.of(": "))
            if node.child_count() > 1 {
                self.format_node(node.child(1), level)
            }
            self.buf.push_str(Str.of(" : "))
            if node.child_count() > 2 {
                self.format_node(node.child(2), level)
            }
        } else {
            self.buf.push_str(Str.of(": "))
            if node.child_count() > 1 {
                self.format_node(node.child(1), level)
            }
            if node.child_count() > 2 {
                self.buf.push_str(Str.of(" = "))
                self.format_node(node.child(2), level)
            }
        }
    }

    format_destructure :: fn(self &Self, node &CstNode, level u32) {
        n := node.child_count()
        if n == 0 {
            ret
        }
        i: u64 = 0
        while i < n - 1 {
            if i > 0 {
                self.buf.push_str(Str.of(", "))
            }
            self.format_node(node.child(i), level)
            i = i + 1
        }
        self.buf.push_str(Str.of(" := "))
        self.format_node(node.child(n - 1), level)
    }

    format_fn :: fn(self &Self, node &CstNode, level u32) {
        self.buf.push_str(Str.of("fn("))
        n := node.child_count()
        has_body := (n > 0) and (node.child(n - 1).kind == CstKind.block_expr)
        param_end := if has_body {
            n - 1
        } else {
            n
        }

        has_ret := false
        if has_body and (param_end > 0) {
            last_before_body := node.child(param_end - 1)
            if last_before_body.kind != CstKind.fn_param {
                has_ret = true
                param_end = param_end - 1
            }
        } else if (not has_body) and (param_end > 0) {
            last := node.child(param_end - 1)
            if last.kind != CstKind.fn_param {
                has_ret = true
                param_end = param_end - 1
            }
        }
        i: u64 = 0
        while i < param_end {
            if i > 0 {
                self.buf.push_str(Str.of(", "))
            }
            p := node.child(i)
            if p.text.eq("cmpt") {
                self.buf.push_str(Str.of("cmpt "))
            }
            p_len := p.child_count()
            if p_len > 1 {
                j: u64 = 0
                while j < p_len - 1 {
                    if j > 0 {
                        self.buf.push_str(Str.of(", "))
                    }
                    self.format_node(p.child(j), level)
                    j = j + 1
                }
                self.buf.push_char(' ' as u8)
                self.format_node(p.child(p_len - 1), level)
            } else if p_len == 1 {
                self.format_node(p.child(0), level)
            }
            i = i + 1
        }
        self.buf.push_char(')' as u8)

        if has_ret {
            self.buf.push_char(' ' as u8)
            self.format_node(node.child(param_end), level)
        }
        if has_body {
            self.buf.push_char(' ' as u8)
            self.format_block(node.child(n - 1), level)
        }
    }

    struct_field_name_len :: fn(self &Self, f &CstNode) u64 {
        f_len := f.child_count()
        if f_len <= 1 {
            ret 0
        }
        total: u64 = 0
        j: u64 = 0
        while j < f_len - 1 {
            if j > 0 {
                total = total + 2
            }
            total = total + f.child(j).text.len
            j = j + 1
        }
        total
    }

    format_struct :: fn(self &Self, node &CstNode, level u32) {
        if node.text.eq("tuple") {
            self.buf.push_str(Str.of("struct { "))
            i: u64 = 0
            while i < node.child_count() {
                if i > 0 {
                    self.buf.push_str(Str.of(", "))
                }
                f := node.child(i)
                if f.child_count() > 0 {
                    self.format_node(f.child(0), level)
                }
                i = i + 1
            }
            self.buf.push_str(Str.of(" }"))
            ret
        }
        self.buf.push_str(Str.of("struct {"))
        if node.child_count() == 0 {
            self.buf.push_char('}' as u8)
            ret
        }
        self.buf.push_char('\n' as u8)
        inner_level := level + 1

        i: u64 = 0
        while i < node.child_count() {
            c := node.child(i)
            if c.kind == CstKind.empty_line {
                self.buf.push_char('\n' as u8)
            } else if c.kind == CstKind.comment_stmt {
                self.indent(inner_level)
                self.buf.push_str(c.text)
                self.buf.push_char('\n' as u8)
            } else if c.kind == CstKind.splice_expr {
                self.indent(inner_level)
                self.format_node(c, inner_level)
                self.buf.push_char('\n' as u8)
            } else if c.kind == CstKind.struct_field {
                end := i
                while (end < node.child_count()) and (node.child(end).kind == CstKind.struct_field) {
                    end = end + 1
                }
                max_name_len: u64 = 0
                idx := i
                while idx < end {
                    f := node.child(idx)
                    nl := self.struct_field_name_len(f)
                    if nl > max_name_len {
                        max_name_len = nl
                    }
                    idx = idx + 1
                }
                idx = i
                while idx < end {
                    f := node.child(idx)
                    self.indent(inner_level)
                    f_len := f.child_count()
                    if f_len > 1 {
                        nl := self.struct_field_name_len(f)
                        j: u64 = 0
                        while j < f_len - 1 {
                            if j > 0 {
                                self.buf.push_str(Str.of(", "))
                            }
                            self.format_node(f.child(j), inner_level)
                            j = j + 1
                        }
                        pad := max_name_len - nl + 1
                        p_i: u64 = 0
                        while p_i < pad {
                            self.buf.push_char(' ' as u8)
                            p_i = p_i + 1
                        }
                        self.format_node(f.child(f_len - 1), inner_level)
                    } else if f_len == 1 {
                        self.format_node(f.child(0), inner_level)
                    }
                    self.buf.push_char('\n' as u8)
                    idx = idx + 1
                }
                i = end
                cont
            } else {
                self.indent(inner_level)
                self.format_node(c, inner_level)
                self.buf.push_char('\n' as u8)
            }
            i = i + 1
        }

        self.indent(level)
        self.buf.push_char('}' as u8)
    }

    format_enum :: fn(self &Self, node &CstNode, level u32) {
        self.buf.push_str(Str.of("enum"))
        start_idx: u64 = 0
        if (node.child_count() > 0) and (node.child(0).kind != CstKind.enum_variant) and (node.child(0).kind != CstKind.binding_stmt) and (node.child(0).kind != CstKind.comment_stmt) and (node.child(0).kind != CstKind.empty_line) {
            self.buf.push_char(' ' as u8)
            self.format_node(node.child(0), level)
            start_idx = 1
        }
        self.buf.push_str(Str.of(" {"))
        if node.child_count() <= start_idx {
            self.buf.push_char('}' as u8)
            ret
        }
        self.buf.push_char('\n' as u8)
        inner_level := level + 1

        i := start_idx
        while i < node.child_count() {
            c := node.child(i)
            if c.kind == CstKind.empty_line {
                self.buf.push_char('\n' as u8)
            } else if c.kind == CstKind.comment_stmt {
                self.indent(inner_level)
                self.buf.push_str(c.text)
                self.buf.push_char('\n' as u8)
            } else if c.kind == CstKind.splice_expr {
                self.indent(inner_level)
                self.format_node(c, inner_level)
                self.buf.push_char('\n' as u8)
            } else if c.kind == CstKind.enum_variant {
                self.indent(inner_level)
                self.buf.push_str(c.text)
                if c.child_count() > 0 {
                    self.buf.push_str(Str.of(" = "))
                    self.format_node(c.child(0), inner_level)
                }
                self.buf.push_char('\n' as u8)
            } else {
                self.indent(inner_level)
                self.format_node(c, inner_level)
                self.buf.push_char('\n' as u8)
            }
            i = i + 1
        }

        self.indent(level)
        self.buf.push_char('}' as u8)
    }

    format_if :: fn(self &Self, node &CstNode, level u32) {
        self.buf.push_str(Str.of("if "))
        self.format_node(node.child(0), level)
        self.buf.push_char(' ' as u8)
        self.format_block(node.child(1), level)

        if node.child_count() > 2 {
            else_branch := node.child(2)
            if else_branch.kind == CstKind.if_expr {
                self.buf.push_str(Str.of(" else "))
                self.format_if(else_branch, level)
            } else {
                self.buf.push_str(Str.of(" else "))
                self.format_block(else_branch, level)
            }
        }
    }

    format_while :: fn(self &Self, node &CstNode, level u32) {
        self.buf.push_str(Str.of("while "))
        self.format_node(node.child(0), level)
        self.buf.push_char(' ' as u8)
        self.format_block(node.child(1), level)
    }

    format_for :: fn(self &Self, node &CstNode, level u32) {
        self.buf.push_str(Str.of("for "))
        vars := node.child(0)
        i: u64 = 0
        while i < vars.child_count() {
            if i > 0 {
                self.buf.push_str(Str.of(", "))
            }
            self.format_node(vars.child(i), level)
            i = i + 1
        }
        self.buf.push_str(Str.of(" in "))
        iters := node.child(1)
        j: u64 = 0
        while j < iters.child_count() {
            if j > 0 {
                self.buf.push_str(Str.of(", "))
            }
            self.format_node(iters.child(j), level)
            j = j + 1
        }
        self.buf.push_char(' ' as u8)
        self.format_block(node.child(2), level)
    }

    format_match :: fn(self &Self, node &CstNode, level u32) {
        self.buf.push_str(Str.of("match "))
        arms_start: u64 = 1
        if node.text.eq("in") {
            self.format_node(node.child(0), level)
            self.buf.push_str(Str.of(" in "))
            self.format_node(node.child(1), level)
            arms_start = 2
        } else {
            self.format_node(node.child(0), level)
        }
        self.buf.push_str(Str.of(" {"))
        self.buf.push_char('\n' as u8)

        inner_level := level + 1
        i := arms_start
        while i < node.child_count() {
            arm := node.child(i)
            if arm.kind == CstKind.comment_stmt {
                self.indent(inner_level)
                self.buf.push_str(arm.text)
                self.buf.push_char('\n' as u8)
            } else if arm.kind == CstKind.match_arm {
                self.indent(inner_level)
                if arm.text.eq("else") {
                    self.buf.push_str(Str.of("else "))
                    self.format_block(arm.child(0), inner_level)
                } else {
                    n := arm.child_count()
                    j: u64 = 0
                    while j < n - 1 {
                        if j > 0 {
                            self.buf.push_str(Str.of(", "))
                        }
                        self.format_node(arm.child(j), inner_level)
                        j = j + 1
                    }
                    self.buf.push_char(' ' as u8)
                    self.format_block(arm.child(n - 1), inner_level)
                }
                self.buf.push_char('\n' as u8)
            }
            i = i + 1
        }

        self.indent(level)
        self.buf.push_char('}' as u8)
    }

    format_block :: fn(self &Self, node &CstNode, level u32) {
        self.buf.push_char('{' as u8)
        if node.child_count() == 0 {
            self.buf.push_char('}' as u8)
            ret
        }
        self.buf.push_char('\n' as u8)
        inner_level := level + 1

        i: u64 = 0
        while i < node.child_count() {
            c := node.child(i)
            if c.kind == CstKind.empty_line {
                self.buf.push_char('\n' as u8)
            } else if c.kind == CstKind.comment_stmt {
                self.indent(inner_level)
                self.buf.push_str(c.text)
                self.buf.push_char('\n' as u8)
            } else {
                self.indent(inner_level)
                self.format_node(c, inner_level)
                self.buf.push_char('\n' as u8)
            }
            i = i + 1
        }

        self.indent(level)
        self.buf.push_char('}' as u8)
    }

    format_binary :: fn(self &Self, node &CstNode, level u32) {
        self.format_node(node.child(0), level)
        self.buf.push_char(' ' as u8)
        self.buf.push_str(node.text)
        self.buf.push_char(' ' as u8)
        self.format_node(node.child(1), level)
    }

    format_unary :: fn(self &Self, node &CstNode, level u32) {
        self.buf.push_str(node.text)
        if node.text.eq("not") {
            self.buf.push_char(' ' as u8)
        }
        self.format_node(node.child(0), level)
    }

    format_call :: fn(self &Self, node &CstNode, level u32) {
        self.format_node(node.child(0), level)
        self.buf.push_char('(' as u8)
        i: u64 = 1
        while i < node.child_count() {
            if i > 1 {
                self.buf.push_str(Str.of(", "))
            }
            self.format_node(node.child(i), level)
            i = i + 1
        }
        self.buf.push_char(')' as u8)
    }

    format_member :: fn(self &Self, node &CstNode, level u32) {
        self.format_node(node.child(0), level)
        self.buf.push_char('.' as u8)
        self.buf.push_str(node.text)
    }

    format_index :: fn(self &Self, node &CstNode, level u32) {
        self.format_node(node.child(0), level)
        self.buf.push_char('[' as u8)
        self.format_node(node.child(1), level)
        self.buf.push_char(']' as u8)
    }

    format_struct_init :: fn(self &Self, node &CstNode, level u32) {
        self.buf.push_str(Str.of(".{"))
        if node.child_count() == 0 {
            self.buf.push_char('}' as u8)
            ret
        }
        self.buf.push_char(' ' as u8)
        i: u64 = 0
        while i < node.child_count() {
            if i > 0 {
                self.buf.push_str(Str.of(", "))
            }
            f := node.child(i)
            if f.text.len > 0 {
                self.buf.push_str(f.text)
                self.buf.push_str(Str.of(": "))
            }
            if f.child_count() > 0 {
                self.format_node(f.child(0), level)
            }
            i = i + 1
        }
        self.buf.push_str(Str.of(" }"))
    }

    format_array_lit :: fn(self &Self, node &CstNode, level u32) {
        self.buf.push_str(Str.of(".["))
        if node.child_count() == 0 {
            self.buf.push_char(']' as u8)
            ret
        }
        self.buf.push_char(' ' as u8)
        i: u64 = 0
        while i < node.child_count() {
            if i > 0 {
                self.buf.push_str(Str.of(", "))
            }
            self.format_node(node.child(i), level)
            i = i + 1
        }
        self.buf.push_str(Str.of(" ]"))
    }
}

format_cst :: fn(arena &Arena, root &CstNode) Str {
    fmt := Formatter.new(arena)
    fmt.format_node(root, 0)
    fmt.buf.as_str()
}

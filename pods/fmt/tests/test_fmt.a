import std.allocator: Arena
import std.fs: File, Dir
import std.string: Str
import test: Suite, Test
import fmt: format_source, format_path

mkdir :: fn(path &u8, mode u32) i32

test_imports :: fn(t &Test) {
    arena := Arena.new(65536)

    src1 := "import std.allocator: Arena\n"
    res1 := format_source(&arena, src1)
    t.assert_str_eq(res1, src1, "import basic")

    src2 := "import .path.to: x as y, z\n"
    res2 := format_source(&arena, src2)
    t.assert_str_eq(res2, src2, "import relative alias")

    src3 := "import std.mem as mem\n"
    res3 := format_source(&arena, src3)
    t.assert_str_eq(res3, src3, "import module alias")

    src4 := "import std.mem\n"
    res4 := format_source(&arena, src4)
    t.assert_str_eq(res4, src4, "import whole module")

    arena.destroy()
}

test_struct_and_enum :: fn(t &Test) {
    arena := Arena.new(65536)

    src := "Point :: struct {\n    x, y i32\n    dist :: fn(self &Self) i32 {\n        self.x * self.x + self.y * self.y\n    }\n}\n"
    res := format_source(&arena, src)
    t.assert_str_eq(res, src, "struct with method")

    src_tuple := "Pair :: struct { i32, Str }\n"
    res_tuple := format_source(&arena, src_tuple)
    t.assert_str_eq(res_tuple, src_tuple, "tuple struct")

    src_empty := "Empty :: struct {}\n"
    res_empty := format_source(&arena, src_empty)
    t.assert_str_eq(res_empty, src_empty, "empty struct")

    src_enum := "Color :: enum u32 {\n    Red\n    Green = 10\n    Blue\n}\n"
    res_enum := format_source(&arena, src_enum)
    t.assert_str_eq(res_enum, src_enum, "enum with values")

    src_aligned_in := "CCodeGen :: struct {\n    arena &Arena\n    struct_forward_decls String\n    struct_decls String\n    code String\n    emitted_structs Vec(u32)\n}\n"
    res_aligned := format_source(&arena, src_aligned_in)
    exp_aligned := "CCodeGen :: struct {\n    arena                &Arena\n    struct_forward_decls String\n    struct_decls         String\n    code                 String\n    emitted_structs      Vec(u32)\n}\n"
    t.assert_str_eq(res_aligned, exp_aligned, "struct field alignment")

    arena.destroy()
}

test_control_flow :: fn(t &Test) {
    arena := Arena.new(65536)

    src_if := "main :: fn() {\n    if x > 0 {\n        print(1)\n    } else if x < 0 {\n        print(2)\n    } else {\n        print(0)\n    }\n}\n"
    res_if := format_source(&arena, src_if)
    t.assert_str_eq(res_if, src_if, "if else if else")

    src_while := "main :: fn() {\n    while i < 10 {\n        i = i + 1\n    }\n}\n"
    res_while := format_source(&arena, src_while)
    t.assert_str_eq(res_while, src_while, "while loop")

    src_for := "main :: fn() {\n    for x in items {\n        print(x)\n    }\n}\n"
    res_for := format_source(&arena, src_for)
    t.assert_str_eq(res_for, src_for, "for loop")

    src_for_multi := "main :: fn() {\n    for a, b in xs.iter(), ys.iter() {\n        print(a + b)\n    }\n}\n"
    res_for_multi := format_source(&arena, src_for_multi)
    t.assert_str_eq(res_for_multi, src_for_multi, "for multi-variable multi-iterator")

    src_match := "main :: fn() {\n    match val {\n        1 {\n            print(10)\n        }\n        2, 3 {\n            print(20)\n        }\n        else {\n            print(0)\n        }\n    }\n}\n"
    res_match := format_source(&arena, src_match)
    t.assert_str_eq(res_match, src_match, "match expression")

    src_match_in := "main :: fn() {\n    match val in u {\n        Foo {\n            print(val)\n        }\n        Bar {\n            print(0)\n        }\n    }\n}\n"
    res_match_in := format_source(&arena, src_match_in)
    t.assert_str_eq(res_match_in, src_match_in, "match in expression")

    arena.destroy()
}

test_struct_init_and_tuples :: fn(t &Test) {
    arena := Arena.new(65536)

    src_named := "main :: fn() {\n    p := .{ x: 10, y: 20 }\n}\n"
    res_named := format_source(&arena, src_named)
    t.assert_str_eq(res_named, src_named, "struct init named")

    src_pos := "main :: fn() {\n    t := .{ 10, 20 }\n    printf(\"msg: {}\\n\", .{ msg })\n}\n"
    res_pos := format_source(&arena, src_pos)
    t.assert_str_eq(res_pos, src_pos, "struct init positional tuple")

    src_destruct := "main :: fn() {\n    a, b := .{ 10, 20 }\n    x, y, z := triple\n}\n"
    res_destruct := format_source(&arena, src_destruct)
    t.assert_str_eq(res_destruct, src_destruct, "destructure assignment")

    arena.destroy()
}

test_advanced_syntax :: fn(t &Test) {
    arena := Arena.new(65536)

    src_builtins := "main :: fn() {\n    sz := @sizeof(Point)\n    al := @alignof(Point)\n    name := @type_name(i32)\n}\n"
    res_builtins := format_source(&arena, src_builtins)
    t.assert_str_eq(res_builtins, src_builtins, "builtins sizeof alignof type_name")

    src_splice := "main :: fn() {\n    #x\n    #(expr + 1)\n}\n"
    res_splice := format_source(&arena, src_splice)
    t.assert_str_eq(res_splice, src_splice, "splices")

    src_fn_types := "SortFn :: fn(Str, Str) bool\nUnaryOp :: fn(i32) i32\n"
    res_fn_types := format_source(&arena, src_fn_types)
    t.assert_str_eq(res_fn_types, src_fn_types, "anonymous function types")

    src_fn_multi_params := "add3 :: fn(a, b, c i32) i32 {\n    a + b + c\n}\n"
    res_fn_multi_params := format_source(&arena, src_fn_multi_params)
    t.assert_str_eq(res_fn_multi_params, src_fn_multi_params, "multi-name parameters")

    src_arrays := "main :: fn() {\n    arr: [4]i32 = .[ 1, 2, 3, 4 ]\n    sl: []u8 = .[]\n}\n"
    res_arrays := format_source(&arena, src_arrays)
    t.assert_str_eq(res_arrays, src_arrays, "array and slice types and literals")

    src_vars := "main :: fn() {\n    a := 1\n    b: i32 = 2\n    c: i32 : 3\n    d: i32\n}\n"
    res_vars := format_source(&arena, src_vars)
    t.assert_str_eq(res_vars, src_vars, "var decl variants")

    src_multiline_bin := "main :: fn() {\n    if (a == 1) or\n       (b == 2) {\n        ret 0\n    }\n}\n"
    res_multiline_bin := format_source(&arena, src_multiline_bin)
    exp_multiline_bin := "main :: fn() {\n    if (a == 1) or (b == 2) {\n        ret 0\n    }\n}\n"
    t.assert_str_eq(res_multiline_bin, exp_multiline_bin, "multiline binary expr")

    arena.destroy()
}

test_idempotency :: fn(t &Test) {
    arena := Arena.new(65536)

    messy := "import   std.io :print ,printf as log\n\nPoint::struct{\nx,y i32\n}\n\nmain::fn(){\nx:=10+20*3\np:Point=.{x:1,y:2}\nt:=.{10,20}\nprintf(\"hello {}\\n\",.{x})\n}\n"
    pass1 := format_source(&arena, messy)
    pass2 := format_source(&arena, pass1)

    t.assert_str_eq(pass1, pass2, "formatting is idempotent")

    arena.destroy()
}

test_file_and_directory_formatting :: fn(t &Test) {
    arena := Arena.new(65536)
    dir_path := "tmp/fmt_dir_test"
    mkdir(c"tmp/fmt_dir_test", 511 as u32)

    path1 := "tmp/fmt_dir_test/file1.a"
    messy1 := "main::fn(){\nx:=42\nret x\n}\n"
    File.write_string(path1, messy1)

    path2 := "tmp/fmt_dir_test/file2.a"
    messy2 := "Point::struct{\nx,y i32\n}\n"
    File.write_string(path2, messy2)

    count := format_path(&arena, c"tmp/fmt_dir_test")
    t.assert_eq(u32, count, 2 as u32, "formatted 2 files in directory")

    read1 := File.read_to_string(&arena, path1).unwrap()
    exp1 := "main :: fn() {\n    x := 42\n    ret x\n}\n"
    t.assert_str_eq(read1, exp1, "file1 formatted correctly")

    read2 := File.read_to_string(&arena, path2).unwrap()
    exp2 := "Point :: struct {\n    x, y i32\n}\n"
    t.assert_str_eq(read2, exp2, "file2 formatted correctly")

    arena.destroy()
}

main :: fn() {
    arena := Arena.new(65536)
    suite := Suite.new(&arena, "Fmt Code Formatter Test Suite")
    suite.add("imports", test_imports)
    suite.add("struct_and_enum", test_struct_and_enum)
    suite.add("control_flow", test_control_flow)
    suite.add("struct_init_and_tuples", test_struct_init_and_tuples)
    suite.add("advanced_syntax", test_advanced_syntax)
    suite.add("idempotency", test_idempotency)
    suite.add("file_and_directory_formatting", test_file_and_directory_formatting)
    suite.run_and_exit()
    arena.destroy()
}

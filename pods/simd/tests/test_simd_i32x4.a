import std.allocator: Arena
import simd: Simd, i32x4
import test: Suite, Test, assert_true, assert_eq

test_i32x4_arithmetic :: fn(t &Test) {
    a := i32x4.splat(20)
    b := i32x4.splat(6)

    sum := a.add(b)
    diff := a.sub(b)
    prod := a.mul(b)
    quot := a.div(b)

    t.assert_eq(i32, sum.get(0), 26, "i32 add")
    t.assert_eq(i32, diff.get(0), 14, "i32 sub")
    t.assert_eq(i32, prod.get(0), 120, "i32 mul")
    t.assert_eq(i32, quot.get(0), 3, "i32 div")
}

test_i32x4_bitwise :: fn(t &Test) {
    a := i32x4.splat(12)
    b := i32x4.splat(10)

    and_v := a.bit_and(b)
    or_v  := a.bit_or(b)
    xor_v := a.bit_xor(b)

    t.assert_eq(i32, and_v.get(0), 8, "i32 bit_and")
    t.assert_eq(i32, or_v.get(0), 14, "i32 bit_or")
    t.assert_eq(i32, xor_v.get(0), 6, "i32 bit_xor")
}

test_i32x4_reductions :: fn(t &Test) {
    arr: [4]i32
    arr[0] = 5
    arr[1] = 15
    arr[2] = 2
    arr[3] = 8

    v := i32x4.load(&arr as &i32)
    t.assert_eq(i32, v.sum(), 30, "i32 sum")
    t.assert_eq(i32, v.product(), 1200, "i32 product")
    t.assert_eq(i32, v.reduce_min(), 2, "i32 min")
    t.assert_eq(i32, v.reduce_max(), 15, "i32 max")
}

main :: fn() {
    arena := Arena.new(4096)
    suite := Suite.new(&arena, "SIMD i32x4 Operations Suite")
    suite.add("i32x4_arithmetic", test_i32x4_arithmetic)
    suite.add("i32x4_bitwise", test_i32x4_bitwise)
    suite.add("i32x4_reductions", test_i32x4_reductions)
    suite.run_and_exit()
    arena.destroy()
}

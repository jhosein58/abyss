abyss_simd_sin_f32x4 :: fn(dst &f32, src &f32)
abyss_simd_cos_f32x4 :: fn(dst &f32, src &f32)
abyss_simd_tan_f32x4 :: fn(dst &f32, src &f32)
abyss_simd_exp_f32x4 :: fn(dst &f32, src &f32)
abyss_simd_ln_f32x4 :: fn(dst &f32, src &f32)
abyss_simd_sqrt_f32x4 :: fn(dst &f32, src &f32)
abyss_simd_rsqrt_f32x4 :: fn(dst &f32, src &f32)
abyss_simd_pow_f32x4 :: fn(dst &f32, a &f32, b &f32)
abyss_simd_fma_f32x4 :: fn(dst &f32, a &f32, b &f32, c &f32)

abyss_simd_sin_f64x2 :: fn(dst &f64, src &f64)
abyss_simd_cos_f64x2 :: fn(dst &f64, src &f64)
abyss_simd_exp_f64x2 :: fn(dst &f64, src &f64)
abyss_simd_ln_f64x2 :: fn(dst &f64, src &f64)
abyss_simd_sqrt_f64x2 :: fn(dst &f64, src &f64)
abyss_simd_pow_f64x2 :: fn(dst &f64, a &f64, b &f64)
abyss_simd_fma_f64x2 :: fn(dst &f64, a &f64, b &f64, c &f64)

SimdMask :: fn(cmpt N u64) type {
    struct {
        bits [N]bool

        all :: fn(self &Self) bool {
            i: u64 = 0
            while i < N {
                if not self.bits[i] { ret false }
                i = i + 1
            }
            true
        }

        any :: fn(self &Self) bool {
            i: u64 = 0
            while i < N {
                if self.bits[i] { ret true }
                i = i + 1
            }
            false
        }

        none :: fn(self &Self) bool {
            not self.any()
        }

        count_ones :: fn(self &Self) u64 {
            c: u64 = 0
            i: u64 = 0
            while i < N {
                if self.bits[i] { c = c + 1 }
                i = i + 1
            }
            c
        }

        get :: fn(self &Self, idx u64) bool {
            self.bits[idx]
        }

        set :: fn(self &Self, idx u64, val bool) {
            self.bits[idx] = val
        }
    }
}

Simd :: fn(T type, cmpt N u64) type {
    struct {
        data [N]T

        splat :: fn(v T) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = v
                i = i + 1
            }
            res
        }

        zero :: fn() Self {
            Self.splat(0)
        }

        from_array :: fn(arr [N]T) Self {
            res: Self
            res.data = arr
            res
        }

        load :: fn(ptr &T) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = *(ptr + i)
                i = i + 1
            }
            res
        }

        store :: fn(self &Self, ptr &T) {
            i: u64 = 0
            while i < N {
                *(ptr + i) = self.data[i]
                i = i + 1
            }
        }

        get :: fn(self &Self, idx u64) T {
            self.data[idx]
        }

        set :: fn(self &Self, idx u64, val T) {
            self.data[idx] = val
        }

        add :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = self.data[i] + other.data[i]
                i = i + 1
            }
            res
        }

        sub :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = self.data[i] - other.data[i]
                i = i + 1
            }
            res
        }

        mul :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = self.data[i] * other.data[i]
                i = i + 1
            }
            res
        }

        div :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = self.data[i] / other.data[i]
                i = i + 1
            }
            res
        }

        neg :: fn(self Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = -self.data[i]
                i = i + 1
            }
            res
        }

        abs :: fn(self Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                v := self.data[i]
                res.data[i] = if v < 0 { -v } else { v }
                i = i + 1
            }
            res
        }

        min :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                a := self.data[i]
                b := other.data[i]
                res.data[i] = if a < b { a } else { b }
                i = i + 1
            }
            res
        }

        max :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                a := self.data[i]
                b := other.data[i]
                res.data[i] = if a > b { a } else { b }
                i = i + 1
            }
            res
        }

        clamp :: fn(self Self, low Self, high Self) Self {
            self.max(low).min(high)
        }

        fma :: fn(self Self, b Self, c Self) Self {
            res: Self
            if (N == 4) and (@sizeof(T) == 4) {
                abyss_simd_fma_f32x4(&res.data as &f32, &self.data as &f32, &b.data as &f32, &c.data as &f32)
                ret res
            }
            if (N == 2) and (@sizeof(T) == 8) {
                abyss_simd_fma_f64x2(&res.data as &f64, &self.data as &f64, &b.data as &f64, &c.data as &f64)
                ret res
            }
            i: u64 = 0
            while i < N {
                res.data[i] = self.data[i] * b.data[i] + c.data[i]
                i = i + 1
            }
            res
        }

        sqrt :: fn(self Self) Self {
            res: Self
            if (N == 4) and (@sizeof(T) == 4) {
                abyss_simd_sqrt_f32x4(&res.data as &f32, &self.data as &f32)
                ret res
            }
            if (N == 2) and (@sizeof(T) == 8) {
                abyss_simd_sqrt_f64x2(&res.data as &f64, &self.data as &f64)
                ret res
            }
            res
        }

        rsqrt :: fn(self Self) Self {
            res: Self
            if (N == 4) and (@sizeof(T) == 4) {
                abyss_simd_rsqrt_f32x4(&res.data as &f32, &self.data as &f32)
                ret res
            }
            res
        }

        sin :: fn(self Self) Self {
            res: Self
            if (N == 4) and (@sizeof(T) == 4) {
                abyss_simd_sin_f32x4(&res.data as &f32, &self.data as &f32)
                ret res
            }
            if (N == 2) and (@sizeof(T) == 8) {
                abyss_simd_sin_f64x2(&res.data as &f64, &self.data as &f64)
                ret res
            }
            res
        }

        cos :: fn(self Self) Self {
            res: Self
            if (N == 4) and (@sizeof(T) == 4) {
                abyss_simd_cos_f32x4(&res.data as &f32, &self.data as &f32)
                ret res
            }
            if (N == 2) and (@sizeof(T) == 8) {
                abyss_simd_cos_f64x2(&res.data as &f64, &self.data as &f64)
                ret res
            }
            res
        }

        tan :: fn(self Self) Self {
            res: Self
            if (N == 4) and (@sizeof(T) == 4) {
                abyss_simd_tan_f32x4(&res.data as &f32, &self.data as &f32)
                ret res
            }
            res
        }

        exp :: fn(self Self) Self {
            res: Self
            if (N == 4) and (@sizeof(T) == 4) {
                abyss_simd_exp_f32x4(&res.data as &f32, &self.data as &f32)
                ret res
            }
            if (N == 2) and (@sizeof(T) == 8) {
                abyss_simd_exp_f64x2(&res.data as &f64, &self.data as &f64)
                ret res
            }
            res
        }

        ln :: fn(self Self) Self {
            res: Self
            if (N == 4) and (@sizeof(T) == 4) {
                abyss_simd_ln_f32x4(&res.data as &f32, &self.data as &f32)
                ret res
            }
            if (N == 2) and (@sizeof(T) == 8) {
                abyss_simd_ln_f64x2(&res.data as &f64, &self.data as &f64)
                ret res
            }
            res
        }

        pow :: fn(self Self, exp Self) Self {
            res: Self
            if (N == 4) and (@sizeof(T) == 4) {
                abyss_simd_pow_f32x4(&res.data as &f32, &self.data as &f32, &exp.data as &f32)
                ret res
            }
            if (N == 2) and (@sizeof(T) == 8) {
                abyss_simd_pow_f64x2(&res.data as &f64, &self.data as &f64, &exp.data as &f64)
                ret res
            }
            res
        }

        bit_and :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                if @sizeof(T) == 8 {
                    a_bits := *(&self.data[i] as &u64)
                    b_bits := *(&other.data[i] as &u64)
                    r_bits := a_bits & b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 4 {
                    a_bits := *(&self.data[i] as &u32)
                    b_bits := *(&other.data[i] as &u32)
                    r_bits := a_bits & b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 2 {
                    a_bits := *(&self.data[i] as &u16)
                    b_bits := *(&other.data[i] as &u16)
                    r_bits := a_bits & b_bits
                    res.data[i] = *(&r_bits as &T)
                } else {
                    a_bits := *(&self.data[i] as &u8)
                    b_bits := *(&other.data[i] as &u8)
                    r_bits := a_bits & b_bits
                    res.data[i] = *(&r_bits as &T)
                }
                i = i + 1
            }
            res
        }

        bit_or :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                if @sizeof(T) == 8 {
                    a_bits := *(&self.data[i] as &u64)
                    b_bits := *(&other.data[i] as &u64)
                    r_bits := a_bits | b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 4 {
                    a_bits := *(&self.data[i] as &u32)
                    b_bits := *(&other.data[i] as &u32)
                    r_bits := a_bits | b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 2 {
                    a_bits := *(&self.data[i] as &u16)
                    b_bits := *(&other.data[i] as &u16)
                    r_bits := a_bits | b_bits
                    res.data[i] = *(&r_bits as &T)
                } else {
                    a_bits := *(&self.data[i] as &u8)
                    b_bits := *(&other.data[i] as &u8)
                    r_bits := a_bits | b_bits
                    res.data[i] = *(&r_bits as &T)
                }
                i = i + 1
            }
            res
        }

        bit_xor :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                if @sizeof(T) == 8 {
                    a_bits := *(&self.data[i] as &u64)
                    b_bits := *(&other.data[i] as &u64)
                    r_bits := a_bits ^ b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 4 {
                    a_bits := *(&self.data[i] as &u32)
                    b_bits := *(&other.data[i] as &u32)
                    r_bits := a_bits ^ b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 2 {
                    a_bits := *(&self.data[i] as &u16)
                    b_bits := *(&other.data[i] as &u16)
                    r_bits := a_bits ^ b_bits
                    res.data[i] = *(&r_bits as &T)
                } else {
                    a_bits := *(&self.data[i] as &u8)
                    b_bits := *(&other.data[i] as &u8)
                    r_bits := a_bits ^ b_bits
                    res.data[i] = *(&r_bits as &T)
                }
                i = i + 1
            }
            res
        }

        bit_not :: fn(self Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                if @sizeof(T) == 8 {
                    a_bits := *(&self.data[i] as &u64)
                    r_bits := ~a_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 4 {
                    a_bits := *(&self.data[i] as &u32)
                    r_bits := ~a_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 2 {
                    a_bits := *(&self.data[i] as &u16)
                    r_bits := ~a_bits
                    res.data[i] = *(&r_bits as &T)
                } else {
                    a_bits := *(&self.data[i] as &u8)
                    r_bits := ~a_bits
                    res.data[i] = *(&r_bits as &T)
                }
                i = i + 1
            }
            res
        }

        sum :: fn(self Self) T {
            acc: T = 0
            i: u64 = 0
            while i < N {
                acc = acc + self.data[i]
                i = i + 1
            }
            acc
        }

        product :: fn(self Self) T {
            acc: T = 1
            i: u64 = 0
            while i < N {
                acc = acc * self.data[i]
                i = i + 1
            }
            acc
        }

        reduce_min :: fn(self Self) T {
            res := self.data[0]
            i: u64 = 1
            while i < N {
                v := self.data[i]
                if v < res { res = v }
                i = i + 1
            }
            res
        }

        reduce_max :: fn(self Self) T {
            res := self.data[0]
            i: u64 = 1
            while i < N {
                v := self.data[i]
                if v > res { res = v }
                i = i + 1
            }
            res
        }

        dot :: fn(self Self, other Self) T {
            self.mul(other).sum()
        }

        reverse :: fn(self Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = self.data[N - 1 - i]
                i = i + 1
            }
            res
        }

        cmp_eq :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] == other.data[i]
                i = i + 1
            }
            res
        }

        cmp_ne :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] != other.data[i]
                i = i + 1
            }
            res
        }

        cmp_lt :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] < other.data[i]
                i = i + 1
            }
            res
        }

        cmp_le :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] <= other.data[i]
                i = i + 1
            }
            res
        }

        cmp_gt :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] > other.data[i]
                i = i + 1
            }
            res
        }

        cmp_ge :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] >= other.data[i]
                i = i + 1
            }
            res
        }

        select :: fn(mask SimdMask(N), on_true Self, on_false Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = if mask.bits[i] { on_true.data[i] } else { on_false.data[i] }
                i = i + 1
            }
            res
        }
    }
}

f32x4  :: Simd(f32, 4)
f32x8  :: Simd(f32, 8)
f64x2  :: Simd(f64, 2)
f64x4  :: Simd(f64, 4)
i32x4  :: Simd(i32, 4)
i32x8  :: Simd(i32, 8)
u32x4  :: Simd(u32, 4)
u32x8  :: Simd(u32, 8)
i64x2  :: Simd(i64, 2)
i64x4  :: Simd(i64, 4)
u64x2  :: Simd(u64, 2)
u64x4  :: Simd(u64, 4)
i16x8  :: Simd(i16, 8)
u16x8  :: Simd(u16, 8)
i8x16  :: Simd(i8, 16)
u8x16  :: Simd(u8, 16)

import core.target: Arch, target_arch
import .mask: SimdMask
import .scalar:
    scalar_sin_f32, scalar_sin_f64, scalar_cos_f32, scalar_cos_f64, scalar_tan_f32,
    scalar_tan_f64, scalar_asin_f32, scalar_asin_f64, scalar_acos_f32, scalar_acos_f64,
    scalar_atan_f32, scalar_atan_f64, scalar_exp_f32, scalar_exp_f64, scalar_exp2_f32,
    scalar_exp2_f64, scalar_ln_f32, scalar_ln_f64, scalar_log2_f32, scalar_log2_f64,
    scalar_log10_f32, scalar_log10_f64, scalar_sqrt_f32, scalar_sqrt_f64, scalar_cbrt_f32,
    scalar_cbrt_f64, scalar_sinh_f32, scalar_sinh_f64, scalar_cosh_f32, scalar_cosh_f64,
    scalar_tanh_f32, scalar_tanh_f64, scalar_atan2_f32, scalar_atan2_f64, scalar_pow_f32,
    scalar_pow_f64, scalar_hypot_f32, scalar_hypot_f64, scalar_fma_f32, scalar_fma_f64,
    sin_approx, cos_approx, tan_approx, exp_approx, ln_approx,
    rsqrt_approx

abyss_simd_cpu_features :: fn() u32 {
    if target_arch == Arch.x86_64 { ret 3 }
    if target_arch == Arch.aarch64 { ret 17 }
    1
}

Simd :: fn(T type, cmpt N u64) type {
    struct {
        data [N]T
        splat :: fn(v T) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = v
                i = i + 1
            }
            res
        }

        zero :: fn() Self {
            Self.splat(0)
        }

        from_array :: fn(arr [N]T) Self {
            res: Self
            res.data = arr
            res
        }

        load :: fn(ptr &T) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = *(ptr + i)
                i = i + 1
            }
            res
        }

        store :: fn(self &Self, ptr &T) {
            i: u64 = 0
            while i < N {
                *(ptr + i) = self.data[i]
                i = i + 1
            }
        }

        get :: fn(self &Self, idx u64) T {
            self.data[idx]
        }

        set :: fn(self &Self, idx u64, val T) {
            self.data[idx] = val
        }

        extract :: fn(self &Self, idx u64) T {
            self.data[idx]
        }

        insert :: fn(self &Self, idx u64, val T) Self {
            res := *self
            res.data[idx] = val
            res
        }

        add :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = self.data[i] + other.data[i]
                i = i + 1
            }
            res
        }

        sub :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = self.data[i] - other.data[i]
                i = i + 1
            }
            res
        }

        mul :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = self.data[i] * other.data[i]
                i = i + 1
            }
            res
        }

        div :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = self.data[i] / other.data[i]
                i = i + 1
            }
            res
        }

        neg :: fn(self Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = -self.data[i]
                i = i + 1
            }
            res
        }

        abs :: fn(self Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                v := self.data[i]
                res.data[i] = if v < 0 {
                    -v
                } else {
                    v
                }
                i = i + 1
            }
            res
        }

        min :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                a := self.data[i]
                b := other.data[i]
                res.data[i] = if a < b {
                    a
                } else {
                    b
                }
                i = i + 1
            }
            res
        }

        max :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                a := self.data[i]
                b := other.data[i]
                res.data[i] = if a > b {
                    a
                } else {
                    b
                }
                i = i + 1
            }
            res
        }

        clamp :: fn(self Self, low Self, high Self) Self {
            self.max(low).min(high)
        }

        fma :: fn(self Self, b Self, c Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            if not (single_precision or double_precision) { ret self.mul(b).add(c) }
            result: Self
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_fma_f32(self.data[lane] as f32, b.data[lane] as f32, c.data[lane] as f32) as T
                } else {
                    scalar_fma_f64(self.data[lane] as f64, b.data[lane] as f64, c.data[lane] as f64) as T
                }
            }
            result
        }

        bit_and :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                if @sizeof(T) == 8 {
                    a_bits := *(&self.data[i] as &u64)
                    b_bits := *(&other.data[i] as &u64)
                    r_bits := a_bits & b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 4 {
                    a_bits := *(&self.data[i] as &u32)
                    b_bits := *(&other.data[i] as &u32)
                    r_bits := a_bits & b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 2 {
                    a_bits := *(&self.data[i] as &u16)
                    b_bits := *(&other.data[i] as &u16)
                    r_bits := a_bits & b_bits
                    res.data[i] = *(&r_bits as &T)
                } else {
                    a_bits := *(&self.data[i] as &u8)
                    b_bits := *(&other.data[i] as &u8)
                    r_bits := a_bits & b_bits
                    res.data[i] = *(&r_bits as &T)
                }
                i = i + 1
            }
            res
        }

        and_ :: fn(self Self, other Self) Self {
            self.bit_and(other)
        }

        bit_or :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                if @sizeof(T) == 8 {
                    a_bits := *(&self.data[i] as &u64)
                    b_bits := *(&other.data[i] as &u64)
                    r_bits := a_bits | b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 4 {
                    a_bits := *(&self.data[i] as &u32)
                    b_bits := *(&other.data[i] as &u32)
                    r_bits := a_bits | b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 2 {
                    a_bits := *(&self.data[i] as &u16)
                    b_bits := *(&other.data[i] as &u16)
                    r_bits := a_bits | b_bits
                    res.data[i] = *(&r_bits as &T)
                } else {
                    a_bits := *(&self.data[i] as &u8)
                    b_bits := *(&other.data[i] as &u8)
                    r_bits := a_bits | b_bits
                    res.data[i] = *(&r_bits as &T)
                }
                i = i + 1
            }
            res
        }

        or_ :: fn(self Self, other Self) Self {
            self.bit_or(other)
        }

        bit_xor :: fn(self Self, other Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                if @sizeof(T) == 8 {
                    a_bits := *(&self.data[i] as &u64)
                    b_bits := *(&other.data[i] as &u64)
                    r_bits := a_bits ^ b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 4 {
                    a_bits := *(&self.data[i] as &u32)
                    b_bits := *(&other.data[i] as &u32)
                    r_bits := a_bits ^ b_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 2 {
                    a_bits := *(&self.data[i] as &u16)
                    b_bits := *(&other.data[i] as &u16)
                    r_bits := a_bits ^ b_bits
                    res.data[i] = *(&r_bits as &T)
                } else {
                    a_bits := *(&self.data[i] as &u8)
                    b_bits := *(&other.data[i] as &u8)
                    r_bits := a_bits ^ b_bits
                    res.data[i] = *(&r_bits as &T)
                }
                i = i + 1
            }
            res
        }

        xor_ :: fn(self Self, other Self) Self {
            self.bit_xor(other)
        }

        bit_not :: fn(self Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                if @sizeof(T) == 8 {
                    a_bits := *(&self.data[i] as &u64)
                    r_bits := not a_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 4 {
                    a_bits := *(&self.data[i] as &u32)
                    r_bits := not a_bits
                    res.data[i] = *(&r_bits as &T)
                } else if @sizeof(T) == 2 {
                    a_bits := *(&self.data[i] as &u16)
                    r_bits := not a_bits
                    res.data[i] = *(&r_bits as &T)
                } else {
                    a_bits := *(&self.data[i] as &u8)
                    r_bits := not a_bits
                    res.data[i] = *(&r_bits as &T)
                }
                i = i + 1
            }
            res
        }

        not_ :: fn(self Self) Self {
            self.bit_not()
        }

        sum :: fn(self Self) T {
            acc: T = self.data[0]
            i: u64 = 1
            while i < N {
                acc = acc + self.data[i]
                i = i + 1
            }
            acc
        }

        product :: fn(self Self) T {
            acc: T = self.data[0]
            i: u64 = 1
            while i < N {
                acc = acc * self.data[i]
                i = i + 1
            }
            acc
        }

        reduce_min :: fn(self Self) T {
            res := self.data[0]
            i: u64 = 1
            while i < N {
                v := self.data[i]
                if v < res {
                    res = v
                }
                i = i + 1
            }
            res
        }

        reduce_max :: fn(self Self) T {
            res := self.data[0]
            i: u64 = 1
            while i < N {
                v := self.data[i]
                if v > res {
                    res = v
                }
                i = i + 1
            }
            res
        }

        dot :: fn(self Self, other Self) T {
            self.mul(other).sum()
        }

        reverse :: fn(self Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = self.data[N - 1 - i]
                i = i + 1
            }
            res
        }

        cmp_eq :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] == other.data[i]
                i = i + 1
            }
            res
        }

        cmpeq :: fn(self Self, other Self) SimdMask(N) {
            self.cmp_eq(other)
        }

        cmp_ne :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] != other.data[i]
                i = i + 1
            }
            res
        }

        cmpne :: fn(self Self, other Self) SimdMask(N) {
            self.cmp_ne(other)
        }

        cmp_lt :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] < other.data[i]
                i = i + 1
            }
            res
        }

        cmplt :: fn(self Self, other Self) SimdMask(N) {
            self.cmp_lt(other)
        }

        cmp_le :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] <= other.data[i]
                i = i + 1
            }
            res
        }

        cmple :: fn(self Self, other Self) SimdMask(N) {
            self.cmp_le(other)
        }

        cmp_gt :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] > other.data[i]
                i = i + 1
            }
            res
        }

        cmpgt :: fn(self Self, other Self) SimdMask(N) {
            self.cmp_gt(other)
        }

        cmp_ge :: fn(self Self, other Self) SimdMask(N) {
            res: SimdMask(N)
            i: u64 = 0
            while i < N {
                res.bits[i] = self.data[i] >= other.data[i]
                i = i + 1
            }
            res
        }

        cmpge :: fn(self Self, other Self) SimdMask(N) {
            self.cmp_ge(other)
        }

        select :: fn(mask SimdMask(N), on_true Self, on_false Self) Self {
            res: Self
            i: u64 = 0
            while i < N {
                res.data[i] = if mask.bits[i] {
                    on_true.data[i]
                } else {
                    on_false.data[i]
                }
                i = i + 1
            }
            res
        }

        sin :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_sin_f32(self.data[lane] as f32) as T
                } else {
                    scalar_sin_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        cos :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_cos_f32(self.data[lane] as f32) as T
                } else {
                    scalar_cos_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        tan :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_tan_f32(self.data[lane] as f32) as T
                } else {
                    scalar_tan_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        asin :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_asin_f32(self.data[lane] as f32) as T
                } else {
                    scalar_asin_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        acos :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_acos_f32(self.data[lane] as f32) as T
                } else {
                    scalar_acos_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        atan :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_atan_f32(self.data[lane] as f32) as T
                } else {
                    scalar_atan_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        exp :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_exp_f32(self.data[lane] as f32) as T
                } else {
                    scalar_exp_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        exp2 :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_exp2_f32(self.data[lane] as f32) as T
                } else {
                    scalar_exp2_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        ln :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_ln_f32(self.data[lane] as f32) as T
                } else {
                    scalar_ln_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        log2 :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_log2_f32(self.data[lane] as f32) as T
                } else {
                    scalar_log2_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        log10 :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_log10_f32(self.data[lane] as f32) as T
                } else {
                    scalar_log10_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        sqrt :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_sqrt_f32(self.data[lane] as f32) as T
                } else {
                    scalar_sqrt_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        cbrt :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_cbrt_f32(self.data[lane] as f32) as T
                } else {
                    scalar_cbrt_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        sinh :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_sinh_f32(self.data[lane] as f32) as T
                } else {
                    scalar_sinh_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        cosh :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_cosh_f32(self.data[lane] as f32) as T
                } else {
                    scalar_cosh_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        tanh :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_tanh_f32(self.data[lane] as f32) as T
                } else {
                    scalar_tanh_f64(self.data[lane] as f64) as T
                }
            }
            result
        }

        atan2 :: fn(self Self, other Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_atan2_f32(self.data[lane] as f32, other.data[lane] as f32) as T
                } else {
                    scalar_atan2_f64(self.data[lane] as f64, other.data[lane] as f64) as T
                }
            }
            result
        }

        pow :: fn(self Self, other Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_pow_f32(self.data[lane] as f32, other.data[lane] as f32) as T
                } else {
                    scalar_pow_f64(self.data[lane] as f64, other.data[lane] as f64) as T
                }
            }
            result
        }

        hypot :: fn(self Self, other Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    scalar_hypot_f32(self.data[lane] as f32, other.data[lane] as f32) as T
                } else {
                    scalar_hypot_f64(self.data[lane] as f64, other.data[lane] as f64) as T
                }
            }
            result
        }

        sin_fast :: fn(self Self) Self {
            result: Self
            if not ((@type_name(T).eq("f32")) or (@type_name(T).eq("f64"))) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = sin_approx(self.data[lane] as f64) as T
            }
            result
        }

        cos_fast :: fn(self Self) Self {
            result: Self
            if not ((@type_name(T).eq("f32")) or (@type_name(T).eq("f64"))) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = cos_approx(self.data[lane] as f64) as T
            }
            result
        }

        tan_fast :: fn(self Self) Self {
            result: Self
            if not ((@type_name(T).eq("f32")) or (@type_name(T).eq("f64"))) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = tan_approx(self.data[lane] as f64) as T
            }
            result
        }

        exp_fast :: fn(self Self) Self {
            result: Self
            if not ((@type_name(T).eq("f32")) or (@type_name(T).eq("f64"))) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = exp_approx(self.data[lane] as f64) as T
            }
            result
        }

        ln_fast :: fn(self Self) Self {
            result: Self
            if not ((@type_name(T).eq("f32")) or (@type_name(T).eq("f64"))) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = ln_approx(self.data[lane] as f64) as T
            }
            result
        }

        rsqrt :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    (1.0 / scalar_sqrt_f32(self.data[lane] as f32)) as T
                } else {
                    (1.0 / scalar_sqrt_f64(self.data[lane] as f64)) as T
                }
            }
            result
        }

        rsqrt_fast :: fn(self Self) Self {
            single_precision := @type_name(T).eq("f32")
            double_precision := @type_name(T).eq("f64")
            result: Self
            if not (single_precision or double_precision) { ret result }
            for lane in Range.new(0, N as i32) {
                result.data[lane] = if single_precision {
                    rsqrt_approx(self.data[lane] as f32) as T
                } else {
                    (1.0 / scalar_sqrt_f64(self.data[lane] as f64)) as T
                }
            }
            result
        }
    }
}

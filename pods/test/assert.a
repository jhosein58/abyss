assert_str_eq :: fn(actual Str, expected Str, hint Str) {
    if not actual.eq(expected) {
        Color.red()
        write("\n[assertion failed]")
        Color.reset()
        print(": string equality")
        Color.cyan()
        write("  left:  \"")
        Color.reset()
        write(actual)
        print("\"")
        Color.magenta()
        write("  right: \"")
        Color.reset()
        write(expected)
        print("\"")
        if hint.len > 0 {
            Color.yellow()
            write("  hint:  ")
            Color.reset()
            print(hint)
        }
        fall()
    }
}

assert_str_ne :: fn(actual Str, expected Str, hint Str) {
    if actual.eq(expected) {
        Color.red()
        write("\n[assertion failed]")
        Color.reset()
        print(": string inequality")
        Color.cyan()
        write("  value: \"")
        Color.reset()
        write(actual)
        print("\"")
        if hint.len > 0 {
            Color.yellow()
            write("  hint:  ")
            Color.reset()
            print(hint)
        }
        fall()
    }
}

assert_null :: fn(T type, ptr &T, hint Str) {
    if ptr != null {
        Color.red()
        write("\n[assertion failed]")
        Color.reset()
        print(": pointer must be null")
        if hint.len > 0 {
            Color.yellow()
            write("  hint:  ")
            Color.reset()
            print(hint)
        }
        fall()
    }
}

assert_not_null :: fn(T type, ptr &T, hint Str) {
    if ptr == null {
        Color.red()
        write("\n[assertion failed]")
        Color.reset()
        print(": pointer must not be null")
        if hint.len > 0 {
            Color.yellow()
            write("  hint:  ")
            Color.reset()
            print(hint)
        }
        fall()
    }
}

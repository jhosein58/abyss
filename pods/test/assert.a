import std.string: Str, String
import std.allocator: Arena
import std.fmt: fmt
import std.io: write, print
import std.sys: fall
import .color: Color

assert :: fn(cond bool, hint Str) {
    if not cond {
        Color.red()
        write("[assertion failed]")
        Color.reset()
        print(": condition was false")
        if hint.len > 0 {
            Color.yellow()
            write("  hint: ")
            Color.reset()
            print(hint)
        }
        fall()
    }
}

assert_true :: fn(cond bool, hint Str) {
    assert(cond, hint)
}

assert_false :: fn(cond bool, hint Str) {
    assert(not cond, hint)
}

assert_eq :: fn(T type, actual T, expected T, hint Str) {
    if actual != expected {
        arena := Arena.new(2048)
        Color.red()
        write("\n[assertion failed]")
        Color.reset()
        print(": left == right")
        Color.blue()
        write("  type:  ")
        Color.reset()
        print(@type_name(T))
        Color.cyan()
        write("  left:  ")
        Color.reset()
        print(fmt(&arena, "{}", .{actual}).as_str())
        Color.magenta()
        write("  right: ")
        Color.reset()
        print(fmt(&arena, "{}", .{expected}).as_str())
        if hint.len > 0 {
            Color.yellow()
            write("  hint:  ")
            Color.reset()
            print(hint)
        }
        arena.destroy()
        fall()
    }
}

assert_ne :: fn(T type, actual T, expected T, hint Str) {
    if actual == expected {
        arena := Arena.new(2048)
        Color.red()
        write("\n[assertion failed]")
        Color.reset()
        print(": left != right")
        Color.blue()
        write("  type:  ")
        Color.reset()
        print(@type_name(T))
        Color.cyan()
        write("  value: ")
        Color.reset()
        print(fmt(&arena, "{}", .{actual}).as_str())
        if hint.len > 0 {
            Color.yellow()
            write("  hint:  ")
            Color.reset()
            print(hint)
        }
        arena.destroy()
        fall()
    }
}


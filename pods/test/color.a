import std.io: write, print_char

Color :: struct {
    reset :: fn() {
        print_char(27 as u8)
        write("[0m")
    }

    bold :: fn() {
        print_char(27 as u8)
        write("[1m")
    }

    dim :: fn() {
        print_char(27 as u8)
        write("[2m")
    }

    red :: fn() {
        print_char(27 as u8)
        write("[1;31m")
    }

    green :: fn() {
        print_char(27 as u8)
        write("[1;32m")
    }

    yellow :: fn() {
        print_char(27 as u8)
        write("[1;33m")
    }

    blue :: fn() {
        print_char(27 as u8)
        write("[1;34m")
    }

    magenta :: fn() {
        print_char(27 as u8)
        write("[1;35m")
    }

    cyan :: fn() {
        print_char(27 as u8)
        write("[1;36m")
    }
}

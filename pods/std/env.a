import std.allocator: Arena
import std.path:      Path
import std.string:    Str, String

import std.sys:       environment

abyss_process_arg_count :: extern fn() i32
abyss_process_arg :: extern fn(idx i32) &u8
abyss_process_args :: extern fn() &&u8
abyss_process_set_args :: extern fn(argc i32, argv &&u8)

Env :: struct {
    args_len :: fn() i32 {
        abyss_process_arg_count()
    }

    arg :: fn(idx i32) &u8 {
        abyss_process_arg(idx)
    }

    get :: fn(name &u8) &u8 {
        environment(name)
    }

    get_or :: fn(name &u8, default_val &u8) &u8 {
        val := environment(name)
        if val != (0 as &u8) {
            ret val
        }
        default_val
    }

    has :: fn(name &u8) bool {
        environment(name) != (0 as &u8)
    }

    shift_args :: fn(index i32) {
        count := Env.args_len()
        if index > 0 and index < count {
            abyss_process_set_args(count - index, abyss_process_args() + index)
        }
    }

    home_dir :: fn(arena &Arena) Str {
        h := environment(c"HOME")
        if h != (0 as &u8) {
            ret Str.of(h)
        }
        up := environment(c"USERPROFILE")
        if up != (0 as &u8) {
            ret Str.of(up)
        }
        hd := environment(c"HOMEDRIVE")
        hp := environment(c"HOMEPATH")
        if (hd != (0 as &u8)) and (hp != (0 as &u8)) {
            out := String.new(arena)
            out.push_str(Str.of(hd))
            out.push_str(Str.of(hp))
            ret out.as_str()
        }
        Str.empty()
    }

    abyss_home :: fn(arena &Arena) Str {
        inst := environment(c"ABYSS_INSTALL_DIR")
        if inst != (0 as &u8) {
            ret Str.of(inst)
        }
        p := environment(c"ABYSS_PATH")
        if p != (0 as &u8) {
            ret Str.of(p)
        }
        home := Env.home_dir(arena)
        if home.len > 0 {
            ret Path.join(arena, home, Str.of(".abyss"))
        }
        lad := environment(c"LOCALAPPDATA")
        if lad != (0 as &u8) {
            ret Path.join(arena, Str.of(lad), Str.of("abyss"))
        }
        ad := environment(c"APPDATA")
        if ad != (0 as &u8) {
            ret Path.join(arena, Str.of(ad), Str.of("abyss"))
        }
        Str.empty()
    }
}

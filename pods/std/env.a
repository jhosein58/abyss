import std.allocator: Arena
import std.path:      Path
import std.string:    Str, String

get_arg_count :: extern fn() i32
get_arg :: extern fn(idx i32) &u8
get_env :: extern fn(name &u8) &u8
abyss_vm_shift_args :: extern fn()

Env :: struct {
    args_len :: fn() i32 {
        get_arg_count()
    }

    arg :: fn(idx i32) &u8 {
        get_arg(idx)
    }

    get :: fn(name &u8) &u8 {
        get_env(name)
    }

    get_or :: fn(name &u8, default_val &u8) &u8 {
        val := get_env(name)
        if val != (0 as &u8) {
            ret val
        }
        default_val
    }

    has :: fn(name &u8) bool {
        get_env(name) != (0 as &u8)
    }

    shift_args :: fn() {
        abyss_vm_shift_args()
    }

    home_dir :: fn(arena &Arena) Str {
        h := get_env(c"HOME")
        if h != (0 as &u8) {
            ret Str.of(h)
        }
        up := get_env(c"USERPROFILE")
        if up != (0 as &u8) {
            ret Str.of(up)
        }
        hd := get_env(c"HOMEDRIVE")
        hp := get_env(c"HOMEPATH")
        if (hd != (0 as &u8)) and (hp != (0 as &u8)) {
            out := String.new(arena)
            out.push_str(Str.of(hd))
            out.push_str(Str.of(hp))
            ret out.as_str()
        }
        Str.empty()
    }

    abyss_home :: fn(arena &Arena) Str {
        inst := get_env(c"ABYSS_INSTALL_DIR")
        if inst != (0 as &u8) {
            ret Str.of(inst)
        }
        p := get_env(c"ABYSS_PATH")
        if p != (0 as &u8) {
            ret Str.of(p)
        }
        home := Env.home_dir(arena)
        if home.len > 0 {
            ret Path.join(arena, home, Str.of(".abyss"))
        }
        lad := get_env(c"LOCALAPPDATA")
        if lad != (0 as &u8) {
            ret Path.join(arena, Str.of(lad), Str.of("abyss"))
        }
        ad := get_env(c"APPDATA")
        if ad != (0 as &u8) {
            ret Path.join(arena, Str.of(ad), Str.of("abyss"))
        }
        Str.empty()
    }
}

get_arg_count       :: fn() i32
get_arg             :: fn(idx i32) &u8
get_env             :: fn(name &u8) &u8
abyss_vm_shift_args :: fn()

Env :: struct {
    args_len :: fn() i32 {
        get_arg_count()
    }

    arg :: fn(idx i32) &u8 {
        get_arg(idx)
    }

    get :: fn(name &u8) &u8 {
        get_env(name)
    }

    get_or :: fn(name &u8, default_val &u8) &u8 {
        val := get_env(name)
        if val != (0 as &u8) {
            ret val
        }
        default_val
    }

    has :: fn(name &u8) bool {
        get_env(name) != (0 as &u8)
    }

    shift_args :: fn() {
        abyss_vm_shift_args()
    }
}

import core.maybe:          Maybe
import std.allocator:       Arena
import std.collections.vec: Vec
import std.convert:         Convert
import std.mem:             free, malloc
import std.path:            Path
import std.string:          Str, String
import std.sys:             Directory, OpenMode, close_handle, environment, fall, make_directory, open_handle, read_handle, seek_handle, write_all, write_console

SEEK_SET :: fn() i32 {
    0
}
SEEK_CUR :: fn() i32 {
    1
}
SEEK_END :: fn() i32 {
    2
}

to_cstr :: fn(a &Arena, s Str) &u8 {
    buf := a.alloc(s.len + 1)
    i: u64 = 0
    while i < s.len {
        *(buf + i) = *(s.ptr + i)
        i = i + 1
    }
    *(buf + s.len) = 0 as u8
    buf
}

str_to_cstr :: fn(s Str) &u8 {
    buf := malloc(s.len + 1)
    i: u64 = 0
    while i < s.len {
        *(buf + i) = *(s.ptr + i)
        i = i + 1
    }
    *(buf + s.len) = 0 as u8
    buf
}

FileStream :: struct {
    handle i64
    opened bool
    open :: fn(path &u8, mode &u8) Maybe(Self) {
        parsed := OpenMode.parse(mode)
        if parsed.is_none() { ret Maybe(Self).none() }
        handle := open_handle(path, parsed.unwrap())
        if handle < 0 { ret Maybe(Self).none() }
        Maybe(Self).some(.{ handle: handle, opened: true })
    }

    open_read :: fn(path &u8) Maybe(Self) {
        Self.open(path, c"rb")
    }

    create :: fn(path &u8) Maybe(Self) {
        Self.open(path, c"wb")
    }

    open_append :: fn(path &u8) Maybe(Self) {
        Self.open(path, c"ab")
    }

    is_open :: fn(self &Self) bool {
        self.opened
    }

    close :: fn(self &Self) bool {
        if not self.opened { ret false }
        ok := close_handle(self.handle)
        self.opened = false
        ok
    }

    read :: fn(self &Self, buf &u8, count u64) u64 {
        if not self.opened { ret 0 }
        received := read_handle(self.handle, buf, count)
        if received < 0 { ret 0 }
        received as u64
    }

    read_all :: fn(self &Self, a &Arena) Str {
        if not self.opened { ret Str.empty() }
        raw_size := seek_handle(self.handle, 0, SEEK_END())
        if raw_size < 0 or not self.seek_to_start() { ret Str.empty() }
        file_size := raw_size as u64
        buf := a.alloc(file_size + 1)
        if buf == (0 as &u8) { ret Str.empty() }
        received: u64 = 0
        while received < file_size {
            count := read_handle(self.handle, buf + received, file_size - received)
            if count < 0 { ret Str.empty() }
            if count == 0 { break }
            received = received + (count as u64)
        }
        buf[received] = 0
        Str.new(buf, received)
    }

    write :: fn(self &Self, buf &u8, count u64) u64 {
        if not self.opened { ret 0 }
        write_all(self.handle, buf, count)
    }

    write_str :: fn(self &Self, s Str) bool {
        if not self.opened {
            ret false
        }
        written := self.write(s.ptr, s.len)
        written == s.len
    }

    seek :: fn(self &Self, offset i64, whence i32) bool {
        if not self.opened {
            ret false
        }
        seek_handle(self.handle, offset, whence) >= 0
    }

    seek_to_start :: fn(self &Self) bool {
        self.seek(0, SEEK_SET())
    }

    seek_to_end :: fn(self &Self) bool {
        self.seek(0, SEEK_END())
    }

    tell :: fn(self &Self) i64 {
        if not self.opened {
            ret -1
        }
        seek_handle(self.handle, 0, SEEK_CUR())
    }

    size :: fn(self &Self) u64 {
        if not self.opened { ret 0 }
        cur := self.tell()
        if cur < 0 { ret 0 }
        end := seek_handle(self.handle, 0, SEEK_END())
        self.seek(cur, SEEK_SET())
        if end < 0 {
            ret 0
        }
        end as u64
    }
}

File :: struct {
    open :: fn(path Str, mode &u8) Maybe(FileStream) {
        c_path := str_to_cstr(path)
        stream_opt := FileStream.open(c_path, mode)
        free(c_path)
        stream_opt
    }

    open_read :: fn(path Str) Maybe(FileStream) {
        c_path := str_to_cstr(path)
        stream_opt := FileStream.open_read(c_path)
        free(c_path)
        stream_opt
    }

    create :: fn(path Str) Maybe(FileStream) {
        c_path := str_to_cstr(path)
        stream_opt := FileStream.create(c_path)
        free(c_path)
        stream_opt
    }

    open_append :: fn(path Str) Maybe(FileStream) {
        c_path := str_to_cstr(path)
        stream_opt := FileStream.open_append(c_path)
        free(c_path)
        stream_opt
    }

    read_to_string :: fn(a &Arena, path Str) Maybe(Str) {
        c_path := to_cstr(a, path)
        stream_opt := FileStream.open_read(c_path)
        if stream_opt.is_none() {
            ret Maybe(Str).none()
        }
        stream := stream_opt.unwrap()
        res := stream.read_all(a)
        stream.close()
        if res.ptr == (0 as &u8) { ret Maybe(Str).none() }
        Maybe(Str).some(res)
    }

    write_string :: fn(path Str, content Str) bool {
        stream_opt := File.create(path)
        if stream_opt.is_none() {
            ret false
        }
        stream := stream_opt.unwrap()
        ok := stream.write_str(content)
        stream.close() and ok
    }

    append_string :: fn(path Str, content Str) bool {
        stream_opt := File.open_append(path)
        if stream_opt.is_none() {
            ret false
        }
        stream := stream_opt.unwrap()
        ok := stream.write_str(content)
        stream.close() and ok
    }

    exists :: fn(path Str) bool {
        stream_opt := File.open_read(path)
        if stream_opt.is_some() {
            stream := stream_opt.unwrap()
            stream.close()
            ret true
        }
        false
    }

    size :: fn(path Str) u64 {
        stream_opt := File.open_read(path)
        if stream_opt.is_some() {
            stream := stream_opt.unwrap()
            s := stream.size()
            stream.close()
            ret s
        }
        0
    }
}

read_file :: fn(a &Arena, path &u8) Str {
    source := try_read_file(a, path)
    if source.ptr == (0 as &u8) {
        write_console(Str.of("\n\x1b[1;31merror:\x1b[0m cannot open file '"))
        write_console(Str.of(path))
        write_console("': file not found or permission denied\n")
        fall()
    }
    source
}

try_read_file :: fn(a &Arena, path &u8) Str {
    opt := File.read_to_string(a, Str.of(path))
    if opt.is_some() {
        ret opt.unwrap()
    }
    Str.empty()
}

write_file :: fn(path &u8, content Str) bool {
    ok := File.write_string(Str.of(path), content)
    if not ok {
        write_console(Str.of("\n\x1b[1;31merror:\x1b[0m failed to write file '"))
        write_console(Str.of(path))
        write_console("'\n")
        fall()
    }
    true
}

append_file :: fn(path &u8, content Str) bool {
    ok := File.append_string(Str.of(path), content)
    if not ok {
        write_console(Str.of("\n\x1b[1;31merror:\x1b[0m failed to append to file '"))
        write_console(Str.of(path))
        write_console("'\n")
        fall()
    }
    true
}

file_exists :: fn(path &u8) bool {
    File.exists(Str.of(path))
}

DirEntryKind :: enum u8 {
    unknown
    file
    directory
}

DirEntry :: struct {
    name Str
    kind DirEntryKind
    is_file :: fn(self &Self) bool {
        self.kind == DirEntryKind.file
    }
    is_dir :: fn(self &Self) bool {
        self.kind == DirEntryKind.directory
    }
}

DirStream :: struct {
    directory Directory

    open :: fn(path &u8) Maybe(Self) {
        result := Directory.open(path)
        if result.is_none() { ret Maybe(Self).none() }
        Maybe(Self).some(.{ directory: result.unwrap() })
    }

    close :: fn(self &Self) bool { self.directory.close() }

    next :: fn(self &Self) Maybe(DirEntry) {
        while true {
            result := self.directory.next()
            if result.is_none() { ret Maybe(DirEntry).none() }
            entry := result.unwrap()
            if entry.name.eq(".") or entry.name.eq("..") { cont }
            ret Maybe(DirEntry).some(.{ name: entry.name, kind: entry.kind as DirEntryKind })
        }
        Maybe(DirEntry).none()
    }
}

Dir :: struct {
    create :: fn(path &u8) bool {
        make_directory(path)
    }

    open :: fn(path &u8) Maybe(DirStream) {
        DirStream.open(path)
    }

    exists :: fn(path &u8) bool {
        stream_opt := DirStream.open(path)
        if stream_opt.is_some() {
            stream := stream_opt.unwrap()
            stream.close()
            ret true
        }
        false
    }

    is_directory :: fn(path &u8) bool {
        Dir.exists(path)
    }

    walk :: fn(a &Arena, root Str, ext Str) Vec(Str) {
        out := Vec(Str).new()
        Dir.collect_entries(a, &out, Str.empty(), root, ext)
        out
    }

    collect_entries :: fn(a &Arena, out &Vec(Str), base_prefix Str, rel_dir Str, ext Str) {
        full_dir := if base_prefix.len > 0 {
            Path.join(a, base_prefix, rel_dir)
        } else {
            rel_dir
        }
        c_dir := to_cstr(a, full_dir)
        d_opt := DirStream.open(c_dir)
        if d_opt.is_none() {
            ret
        }
        d := d_opt.unwrap()
        for entry in d {
            full_child := Path.join(a, full_dir, entry.name)
            rel_child := Path.join(a, rel_dir, entry.name)
            c_child := to_cstr(a, full_child)
            if Dir.exists(c_child) {
                Dir.collect_entries(a, out, base_prefix, rel_child, ext)
            } else if (ext.len == 0) or entry.name.ends_with(ext) {
                out.push(rel_child)
            }
        }
        d.close()
    }
}

str_less :: fn(a Str, b Str) bool {
    min_len := if a.len < b.len {
        a.len
    } else {
        b.len
    }
    i: u64 = 0
    while i < min_len {
        ca := *(a.ptr + i)
        cb := *(b.ptr + i)
        if ca < cb {
            ret true
        }
        if ca > cb {
            ret false
        }
        i = i + 1
    }
    a.len < b.len
}

sort_strings :: fn(v &Vec(Str)) {
    i: u64 = 0
    while i < v.len {
        j := i + 1
        while j < v.len {
            if str_less(v.get(j), v.get(i)) {
                tmp := v.get(i)
                v.set(i, v.get(j))
                v.set(j, tmp)
            }
            j = j + 1
        }
        i = i + 1
    }
}

Embed :: struct {
    tree :: fn(a &Arena, root Str, ext Str) Str {
        files := Dir.walk(a, root, ext)
        sort_strings(&files)
        out := String.new(a)
        out.push_str("{\n")
        i: u64 = 0
        while i < files.len {
            p := files.get(i)
            c_p := to_cstr(a, p)
            content := read_file(a, c_p)
            out.push_str("    if path.eq(Str.of(")
            Convert.quote_source(&out, p)
            out.push_str(")) { ret Str.of(")
            Convert.quote_source(&out, content)
            out.push_str(") }\n")
            i = i + 1
        }
        out.push_str("    Str.empty()\n}")
        out.as_str()
    }

    file :: fn(a &Arena, path Str) Str {
        c_p := to_cstr(a, path)
        content := read_file(a, c_p)
        out := String.new(a)
        out.push_str("Str.of(")
        Convert.quote_source(&out, content)
        out.push_str(")")
        out.as_str()
    }

    sources :: fn(a &Arena) Str {
        pods_prefix := if Dir.exists(c"pods") {
            Str.of("pods")
        } else {
            root_prefix := Str.empty()
            env_dev := environment(c"ABYSS_DEV")
            if env_dev != (0 as &u8) {
                dev_str := Str.of(env_dev)
                if (not dev_str.eq(Str.of("1"))) and (not dev_str.eq(Str.of("true"))) {
                    root_prefix = dev_str
                }
            }
            if root_prefix.len > 0 {
                Path.join(a, root_prefix, Str.of("pods"))
            } else {
                Str.of("pods")
            }
        }
        files := Vec(Str).new()
        Dir.collect_entries(a, &files, pods_prefix, Str.of("core"), Str.of(".a"))
        Dir.collect_entries(a, &files, pods_prefix, Str.of("std"), Str.of(".a"))
        sort_strings(&files)

        out := String.new(a)
        out.push_str("fn(mod_path Str) Str {\n")
        i: u64 = 0
        while i < files.len {
            rel_p := files.get(i)
            is_test_or_vendor := rel_p.starts_with(".vendor/") or rel_p.starts_with("std/.vendor/") or rel_p.starts_with("core/tests/") or rel_p.starts_with("std/tests/")
            if not is_test_or_vendor {
                full_p := Path.join(a, pods_prefix, rel_p)
                c_full := to_cstr(a, full_p)
                content := read_file(a, c_full)
                out.push_str("    if mod_path.eq(Str.of(")
                Convert.quote_source(&out, rel_p)
                out.push_str(")) {\n        ret Str.of(")
                Convert.quote_source(&out, content)
                out.push_str(")\n    }\n")
            }
            i = i + 1
        }
        out.push_str("    Str.empty()\n}")
        out.as_str()
    }
}

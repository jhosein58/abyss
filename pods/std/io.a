import std.allocator: Arena
import std.fmt:       fmt
import std.string:    String
import std.sys:       write_console

write_str :: fn(value Str) {
    write_console(value)
}

write_byte :: fn(value u8) {
    byte := value
    write_str(Str.new(&byte, 1))
}

print_body :: fn(newline bool) Str {
    if newline {
        ret `{
            arena := Arena.new(1024)
            text := fmt(&arena, "{}", .{value})
            write_str(text.as_str())
            arena.destroy()
            write_byte('\n')
        }`
    }
    `{
        arena := Arena.new(1024)
        text := fmt(&arena, "{}", .{value})
        write_str(text.as_str())
        arena.destroy()
    }`
}

write :: fn(T type, value T) {
    #print_body(false)
}

print :: fn(T type, value T) {
    #print_body(true)
}

print_codepoint :: fn(cp u32) {
    arena := Arena.new(64)
    s := String.new(&arena)
    s.push_codepoint(cp)
    write_str(s.as_str())
    arena.destroy()
}

printf :: fn(T type, cmpt pattern Str, args T) {
    arena := Arena.new(1024)
    text := fmt(&arena, pattern, args)
    write_str(text.as_str())
    arena.destroy()
}

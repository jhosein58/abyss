import Str, String from "string"
import Arena from "allocator"

Path :: struct {
    ensure_ext :: fn(arena &Arena, path Str, ext Str) Str {
        if path.ends_with(ext) {
            ret path
        }
        out := String.new(arena)
        out.push_str(path)
        out.push_str(ext)
        out.as_str()
    }

    dir :: fn(path Str) Str {
        if path.len == 0 { ret Str.empty() }
        i := path.len
        while i > 0 {
            i = i - 1
            c := *(path.ptr + i)
            if c == '/' or c == '\\' {
                ret path.sub(0, i)
            }
        }
        Str.empty()
    }

    base :: fn(path Str) Str {
        if path.len == 0 { ret Str.empty() }
        i := path.len
        while i > 0 {
            i = i - 1
            c := *(path.ptr + i)
            if c == '/' or c == '\\' {
                ret path.sub(i + 1, path.len - (i + 1))
            }
        }
        path
    }

    join :: fn(arena &Arena, base Str, rel Str) Str {
        if base.len == 0 { ret rel }
        if rel.len == 0 { ret base }
        out := String.new(arena)
        out.push_str(base)
        last_c := *(base.ptr + base.len - 1)
        if last_c != '/' and last_c != '\\' {
            out.push_char('/')
        }
        out.push_str(rel)
        out.as_str()
    }

    normalize :: fn(arena &Arena, path Str) Str {
        if path.len == 0 { ret Str.empty() }
        is_drive := false
        is_abs := false
        start_idx: u64 = 0

        if path.len >= 2 {
            c0 := *(path.ptr)
            c1 := *(path.ptr + 1)
            is_letter := (c0 >= 'a' and c0 <= 'z') or (c0 >= 'A' and c0 <= 'Z')
            if is_letter and (c1 == ':') {
                is_drive = true
                if path.len >= 3 {
                    c2 := *(path.ptr + 2)
                    if c2 == '/' or c2 == '\\' {
                        is_abs = true
                        start_idx = 3
                    } else {
                        start_idx = 2
                    }
                } else {
                    start_idx = 2
                }
            }
        }

        if not is_drive {
            c0 := *(path.ptr)
            if c0 == '/' or c0 == '\\' {
                is_abs = true
                start_idx = 1
            }
        }

        segs := Vec(Str).new()
        i: u64 = start_idx
        start: u64 = start_idx

        while i <= path.len {
            is_sep := (i == path.len) or (*(path.ptr + i) == '/') or (*(path.ptr + i) == '\\')
            if is_sep {
                if i > start {
                    seg := path.sub(start, i - start)
                    if seg.eq(Str.of(".")) {
                    } else if seg.eq(Str.of("..")) {
                        if (segs.len > 0) and (not segs.last().eq(Str.of(".."))) {
                            segs.pop()
                        } else if not is_abs {
                            segs.push(seg)
                        }
                    } else {
                        segs.push(seg)
                    }
                }
                start = i + 1
            }
            i = i + 1
        }

        out := String.new(arena)
        if is_drive {
            out.push_str(path.sub(0, 2))
            if is_abs {
                out.push_char('/')
            }
        } else if is_abs {
            out.push_char('/')
        }
        idx: u64 = 0
        while idx < segs.len {
            if idx > 0 {
                out.push_char('/')
            }
            out.push_str(segs.get(idx))
            idx = idx + 1
        }
        segs.destroy()
        out.as_str()
    }

    resolve :: fn(arena &Arena, base Str, rel Str) Str {
        if base.len == 0 {
            ret Path.normalize(arena, rel)
        }
        d := Path.dir(base)
        if d.len == 0 {
            ret Path.normalize(arena, rel)
        }
        Path.normalize(arena, Path.join(arena, d, rel))
    }
}

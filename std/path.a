import Str, String from "string.a"
import Arena from "allocator.a"
import Vec from "collections/vec.a"

Path :: struct {
    dir :: fn(path Str) Str {
        if path.len == 0 { ret Str.empty() }
        i := path.len
        while i > 0 {
            i = i - 1
            if *(path.ptr + i) == '/' {
                ret path.sub(0, i)
            }
        }
        Str.empty()
    }

    base :: fn(path Str) Str {
        if path.len == 0 { ret Str.empty() }
        i := path.len
        while i > 0 {
            i = i - 1
            if *(path.ptr + i) == '/' {
                ret path.sub(i + 1, path.len - (i + 1))
            }
        }
        path
    }

    join :: fn(arena &Arena, base Str, rel Str) Str {
        if base.len == 0 { ret rel }
        if rel.len == 0 { ret base }
        out := String.new(arena)
        out.push_str(base)
        if *(base.ptr + base.len - 1) != '/' {
            out.push_char('/')
        }
        out.push_str(rel)
        out.as_str()
    }

    normalize :: fn(arena &Arena, path Str) Str {
        if path.len == 0 { ret Str.empty() }
        is_abs := *(path.ptr) == '/'
        segs := Vec(Str).new()
        i: u64 = 0
        start: u64 = 0

        while i <= path.len {
            is_sep := (i == path.len) or (*(path.ptr + i) == '/')
            if is_sep {
                if i > start {
                    seg := path.sub(start, i - start)
                    if seg.eq(Str.of(".")) {
                    } else if seg.eq(Str.of("..")) {
                        if (segs.len > 0) and (not segs.last().eq(Str.of(".."))) {
                            segs.pop()
                        } else if not is_abs {
                            segs.push(seg)
                        }
                    } else {
                        segs.push(seg)
                    }
                }
                start = i + 1
            }
            i = i + 1
        }

        out := String.new(arena)
        if is_abs {
            out.push_char('/')
        }
        idx: u64 = 0
        while idx < segs.len {
            if idx > 0 {
                out.push_char('/')
            }
            out.push_str(segs.get(idx))
            idx = idx + 1
        }
        segs.destroy()
        out.as_str()
    }

    resolve :: fn(arena &Arena, base Str, rel Str) Str {
        if base.len == 0 {
            ret Path.normalize(arena, rel)
        }
        d := Path.dir(base)
        if d.len == 0 {
            ret Path.normalize(arena, rel)
        }
        Path.normalize(arena, Path.join(arena, d, rel))
    }
}

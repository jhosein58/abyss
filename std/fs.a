import Arena, Arena_alloc from "allocator.a"
import Str, Str_empty     from "string.a"
import fall               from "sys.a"


print :: (s &u8) unit

file_open  :: (path, mode &u8) &u8
file_seek  :: (handle &u8, offset i64, w i32) i32
file_tell  :: (handle &u8) i64
file_read  :: (handle, ptr &u8, s, count u64) u64
file_write :: (handle, ptr &u8, s, count u64) u64
file_close :: (handle &u8) i32

SEEK_SET :: () i32 { 0 }
SEEK_END :: () i32 { 2 }

read_file :: (a &Arena, path &u8) Str {
    file_handle := file_open(path, "rb")

    if file_handle == (0 as &u8) {
        print("\n\033[1;31merror:\033[0m cannot open file '")
        print(path)
        print("': file not found or permission denied\n")
        fall()
    }

    file_seek(file_handle, 0, SEEK_END())
    raw_size := file_tell(file_handle)

    if raw_size < 0 {
        print("\n\033[1;31merror:\033[0m failed to determine size of file '")
        print(path)
        print("'\n")
        file_close(file_handle)
        fall()
    }

    file_size := raw_size as u64
    file_seek(file_handle, 0, SEEK_SET())

    buf := Arena_alloc(a, file_size + 1)
    if buf == (0 as &u8) {
        print("\n\033[1;31merror:\033[0m out of memory allocating buffer for '")
        print(path)
        print("'\n")
        file_close(file_handle)
        fall()
    }

    read_bytes := file_read(file_handle, buf, 1, file_size)
    file_close(file_handle)

    *(buf + read_bytes) = 0 as u8

    .{
        ptr: buf,
        len: read_bytes
    }
}

write_file :: (path &u8, content Str) bool {
    file_handle := file_open(path, "wb")

    if file_handle == (0 as &u8) {
        print("\n\033[1;31merror:\033[0m failed to open file for writing: '")
        print(path)
        print("'\n")
        fall()
    }

    written := file_write(file_handle, content.ptr, 1, content.len)
    file_close(file_handle)

    if written != content.len {
        print("\n\033[1;31merror:\033[0m incomplete write to file '")
        print(path)
        print("'\n")
        fall()
    }

    true
}

append_file :: (path &u8, content Str) bool {
    file_handle := file_open(path, "ab")

    if file_handle == (0 as &u8) {
        print("\n\033[1;31merror:\033[0m failed to open file for appending: '")
        print(path)
        print("'\n")
        fall()
    }

    written := file_write(file_handle, content.ptr, 1, content.len)
    file_close(file_handle)

    if written != content.len {
        print("\n\033[1;31merror:\033[0m incomplete append to file '")
        print(path)
        print("'\n")
        fall()
    }

    true
}
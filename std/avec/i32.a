import Arena         from "../allocator.a"
import Arena_alloc   from "../allocator.a"
import Arena_realloc from "../allocator.a"
import I32_size      from "../primitive/i32.a"

ArenaVecType :: i32

ArenaVecI32 :: struct {
    arena: &Arena,
    ptr: &ArenaVecType,
    len: u64,
    cap: u64
}

ArenaVecI32_new :: (arena &Arena) ArenaVecI32 {
    initial_cap: u64 = 4
    bytes := initial_cap * I32_size()
    p := Arena_alloc(arena, bytes) as &ArenaVecType

    .{
        arena: arena,
        ptr: p,
        len: 0,
        cap: initial_cap
    }
}

ArenaVecI32_with_cap :: (arena &Arena, initial_cap u64) ArenaVecI32 {
    bytes := initial_cap * I32_size()
    p := Arena_alloc(arena, bytes) as &ArenaVecType

    .{
        arena: arena,
        ptr: p,
        len: 0,
        cap: initial_cap
    }
}

ArenaVecI32_grow :: (v &ArenaVecI32) {
    if (*v).len == (*v).cap {
        new_cap := (*v).cap * 2
        old_bytes := (*v).cap * I32_size()
        new_bytes := new_cap * I32_size()

        new_ptr := Arena_realloc((*v).arena, (*v).ptr as &u8, old_bytes, new_bytes) as &ArenaVecType

        (*v).ptr = new_ptr
        (*v).cap = new_cap
    }
}

ArenaVecI32_push :: (v &ArenaVecI32, val ArenaVecType) {
    ArenaVecI32_grow(v)

    *((*v).ptr + (*v).len) = val
    (*v).len = (*v).len + 1
}

ArenaVecI32_get :: (v &ArenaVecI32, idx u64) ArenaVecType {
    *((*v).ptr + idx)
}

ArenaVecI32_set :: (v &ArenaVecI32, idx u64, val ArenaVecType) {
    *((*v).ptr + idx) = val
}

ArenaVecI32_pop :: (v &ArenaVecI32) ArenaVecType {
    (*v).len = (*v).len - 1
    *((*v).ptr + (*v).len)
}

ArenaVecI32_clear :: (v &ArenaVecI32) {
    (*v).len = 0
}
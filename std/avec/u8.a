import Arena         from "../allocator.a"
import U8_size       from "../primitive/u8.a"

ArenaVecType :: u8


AVecU8 :: struct {
    arena: &Arena,
    ptr: &ArenaVecType,
    len: u64,
    cap: u64,

    new :: (arena &Arena) Self {
        Self.with_cap(arena, 4)
    }

    with_cap :: (arena &Arena, initial_cap u64) Self {
        bytes := initial_cap * U8_size()
        p := arena.alloc(bytes) as &ArenaVecType

        .{
            arena: arena,
            ptr: p,
            len: 0,
            cap: initial_cap
        }
    }

    grow :: () {
        if .len == .cap {
            new_cap := .cap * 2
            old_bytes := .cap * U8_size()
            new_bytes := new_cap * U8_size()

            new_ptr := .arena.realloc(.ptr as &u8, old_bytes, new_bytes) as &ArenaVecType

            .ptr = new_ptr
            .cap = new_cap
        }
    }

    push :: (val ArenaVecType) {
        .grow()

        *(.ptr + .len) = val
        .len = .len + 1
    }

    get :: (idx u64) ArenaVecType {
        *(.ptr + idx)
    }

    set :: (idx u64, val ArenaVecType) {
        *(.ptr + idx) = val
    }

    pop :: () ArenaVecType {
        .len = .len - 1
        *(.ptr + .len)
    }

    clear :: () {
        .len = 0
    }
}
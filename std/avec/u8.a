import Arena         from "../allocator.a"
import U8_size       from "../primitive/u8.a"

ArenaVecType :: u8


AVecU8 :: struct {
    arena &Arena
    ptr &ArenaVecType
    len u64
    cap u64

    new :: fn(arena &Arena) Self {
        Self.with_cap(arena, 4)
    }

    with_cap :: fn(arena &Arena, initial_cap u64) Self {
        bytes := initial_cap * U8_size()
        p := arena.alloc(bytes) as &ArenaVecType

        .{
            arena: arena,
            ptr: p,
            len: 0,
            cap: initial_cap
        }
    }

    grow :: fn(self &Self) {
        if self.len == self.cap {
            new_cap := self.cap * 2
            old_bytes := self.cap * U8_size()
            new_bytes := new_cap * U8_size()

            new_ptr := self.arena.realloc(self.ptr as &u8, old_bytes, new_bytes) as &ArenaVecType

            self.ptr = new_ptr
            self.cap = new_cap
        }
    }

    push :: fn(self &Self, val ArenaVecType) {
        self.grow()

        *(self.ptr + self.len) = val
        self.len = self.len + 1
    }

    get :: fn(self &Self, idx u64) ArenaVecType {
        *(self.ptr + idx)
    }

    set :: fn(self &Self, idx u64, val ArenaVecType) {
        *(self.ptr + idx) = val
    }

    pop :: fn(self &Self) ArenaVecType {
        self.len = self.len - 1
        *(self.ptr + self.len)
    }

    clear :: fn(self &Self) {
        self.len = 0
    }
}
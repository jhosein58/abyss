import Arena         from "../allocator.a"
import Arena_alloc   from "../allocator.a"
import Arena_realloc from "../allocator.a"
import U8_size      from "../primitive/u8.a"

ArenaVecType :: u8
Self :: ArenaVecU8

ArenaVecU8 :: struct {
    arena: &Arena,
    ptr: &ArenaVecType,
    len: u64,
    cap: u64
}

ArenaVecU8_new :: (arena &Arena) Self {
    initial_cap: u64 = 4
    bytes := initial_cap * U8_size()
    p := Arena_alloc(arena, bytes) as &ArenaVecType

    .{
        arena: arena,
        ptr: p,
        len: 0,
        cap: initial_cap
    }
}

ArenaVecU8_with_cap :: (arena &Arena, initial_cap u64) Self {
    bytes := initial_cap * U8_size()
    p := Arena_alloc(arena, bytes) as &ArenaVecType

    .{
        arena: arena,
        ptr: p,
        len: 0,
        cap: initial_cap
    }
}

ArenaVecU8_grow :: (v &Self) {
    if (*v).len == (*v).cap {
        new_cap := (*v).cap * 2
        old_bytes := (*v).cap * U8_size()
        new_bytes := new_cap * U8_size()

        new_ptr := Arena_realloc((*v).arena, (*v).ptr as &u8, old_bytes, new_bytes) as &ArenaVecType

        (*v).ptr = new_ptr
        (*v).cap = new_cap
    }
}

ArenaVecU8_push :: (v &Self, val ArenaVecType) {
    ArenaVecI32_grow(v)

    *((*v).ptr + (*v).len) = val
    (*v).len = (*v).len + 1
}

ArenaVecU8_get :: (v &Self, idx u64) ArenaVecType {
    *((*v).ptr + idx)
}

ArenaVecU8_set :: (v &Self, idx u64, val ArenaVecType) {
    *((*v).ptr + idx) = val
}

ArenaVecU8_pop :: (v &Self) ArenaVecType {
    (*v).len = (*v).len - 1
    *((*v).ptr + (*v).len)
}

ArenaVecU8_clear :: (v &Self) {
    (*v).len = 0
}
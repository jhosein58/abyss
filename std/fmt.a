import Arena  from "allocator.a"
import Str, String from "string.a"

Escape :: struct {
    reset     &u8
    bold      &u8
    dim       &u8
    italic    &u8
    underline &u8
    blink     &u8
    reverse   &u8
    hidden    &u8
    strike    &u8

    fg_black   &u8
    fg_red     &u8
    fg_green   &u8
    fg_yellow  &u8
    fg_blue    &u8
    fg_magenta &u8
    fg_cyan    &u8
    fg_white   &u8

    fg_bright_black   &u8
    fg_bright_red     &u8
    fg_bright_green   &u8
    fg_bright_yellow  &u8
    fg_bright_blue    &u8
    fg_bright_magenta &u8
    fg_bright_cyan    &u8
    fg_bright_white   &u8

    bg_black   &u8
    bg_red     &u8
    bg_green   &u8
    bg_yellow  &u8
    bg_blue    &u8
    bg_magenta &u8
    bg_cyan    &u8
    bg_white   &u8

    bg_bright_black   &u8
    bg_bright_red     &u8
    bg_bright_green   &u8
    bg_bright_yellow  &u8
    bg_bright_blue    &u8
    bg_bright_magenta &u8
    bg_bright_cyan    &u8
    bg_bright_white   &u8
}

escape :: fn() Escape {
    .{
        reset     : c"\x1b[0m",
        bold      : c"\x1b[1m",
        dim       : c"\x1b[2m",
        italic    : c"\x1b[3m",
        underline : c"\x1b[4m",
        blink     : c"\x1b[5m",
        reverse   : c"\x1b[7m",
        hidden    : c"\x1b[8m",
        strike    : c"\x1b[9m",

        fg_black   : c"\x1b[30m",
        fg_red     : c"\x1b[31m",
        fg_green   : c"\x1b[32m",
        fg_yellow  : c"\x1b[33m",
        fg_blue    : c"\x1b[34m",
        fg_magenta : c"\x1b[35m",
        fg_cyan    : c"\x1b[36m",
        fg_white   : c"\x1b[37m",

        fg_bright_black   : c"\x1b[90m",
        fg_bright_red     : c"\x1b[91m",
        fg_bright_green   : c"\x1b[92m",
        fg_bright_yellow  : c"\x1b[93m",
        fg_bright_blue    : c"\x1b[94m",
        fg_bright_magenta : c"\x1b[95m",
        fg_bright_cyan    : c"\x1b[96m",
        fg_bright_white   : c"\x1b[97m",

        bg_black   : c"\x1b[40m",
        bg_red     : c"\x1b[41m",
        bg_green   : c"\x1b[42m",
        bg_yellow  : c"\x1b[43m",
        bg_blue    : c"\x1b[44m",
        bg_magenta : c"\x1b[45m",
        bg_cyan    : c"\x1b[46m",
        bg_white   : c"\x1b[47m",

        bg_bright_black   : c"\x1b[100m",
        bg_bright_red     : c"\x1b[101m",
        bg_bright_green   : c"\x1b[102m",
        bg_bright_yellow  : c"\x1b[103m",
        bg_bright_blue    : c"\x1b[104m",
        bg_bright_magenta : c"\x1b[105m",
        bg_bright_cyan    : c"\x1b[106m",
        bg_bright_white   : c"\x1b[107m"
    }
}

Fmt :: struct {
    buf String

    new :: fn(arena &Arena) Self {
        .{ buf: String.new(arena) }
    }

    str :: fn(self &Self, s Str) &Self {
        self.buf.push_str(s)
        ret self
    }

    cstr :: fn(self &Self, s &u8) &Self {
        self.str(Str.of(s))
        ret self
    }

    char :: fn(self &Self, c u8) &Self {
        self.buf.push_char(c)
        ret self
    }

    uint32 :: fn(self &Self, v u32) &Self {
        self.buf.push_u32(v)
        ret self
    }

    uint64 :: fn(self &Self, v u64) &Self {
        if v == 0 {
            self.buf.push_char(48 as u8)
            ret self
        }
        divisor: u64 = 1
        temp := v
        while temp >= 10 {
            divisor = divisor * 10
            temp = temp / 10
        }
        rem := v
        while divisor > 0 {
            d := (rem / divisor) as u8
            self.buf.push_char(48 as u8 + d)
            rem = rem - ((d as u64) * divisor)
            divisor = divisor / 10
        }
        ret self
    }

    int32 :: fn(self &Self, v i32) &Self {
        if v < 0 {
            self.buf.push_char(45 as u8)
            self.uint32((0 - v) as u32)
        } else {
            self.uint32(v as u32)
        }
        ret self
    }

    boolean :: fn(self &Self, v bool) &Self {
        if v {
            self.str(Str.of("true"))
        } else {
            self.str(Str.of("false"))
        }
        ret self
    }

    space :: fn(self &Self) &Self {
        self.buf.push_char(32 as u8)
        ret self
    }

    newline :: fn(self &Self) &Self {
        self.buf.push_char(10 as u8)
        ret self
    }

    semi :: fn(self &Self) &Self {
        self.str(Str.of(";\n"))
        ret self
    }

    comma :: fn(self &Self) &Self {
        self.str(Str.of(", "))
        ret self
    }

    paren :: fn(self &Self, inner Str) &Self {
        self.buf.push_char(40 as u8)
        self.str(inner)
        self.buf.push_char(41 as u8)
        ret self
    }

    wrap :: fn(self &Self, left Str, inner Str, right Str) &Self {
        self.str(left)
        self.str(inner)
        self.str(right)
        ret self
    }

    sym :: fn(self &Self, prefix Str, id u32) &Self {
        self.str(prefix)
        self.uint32(id)
        ret self
    }

    binary :: fn(self &Self, op Str, lhs Str, rhs Str) &Self {
        self.buf.push_char(40 as u8)
        self.str(lhs)
        self.str(op)
        self.str(rhs)
        self.buf.push_char(41 as u8)
        ret self
    }

    indent :: fn(self &Self, level u32) &Self {
        i: u32 = 0
        while i < level {
            self.str(Str.of("    "))
            i = i + 1
        }
        ret self
    }

    as_str :: fn(self &Self) Str {
        self.buf.as_str()
    }

    print :: fn(self &Self) {
        self.as_str().print()
    }
}

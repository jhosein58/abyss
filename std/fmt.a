
Escape :: struct {
    -- control sequences
    reset     : &u8,
    bold      : &u8,
    dim       : &u8,
    italic    : &u8,
    underline : &u8,
    blink     : &u8,
    reverse   : &u8,
    hidden    : &u8,
    strike    : &u8,

    -- foreground (normal)
    fg_black   : &u8,
    fg_red     : &u8,
    fg_green   : &u8,
    fg_yellow  : &u8,
    fg_blue    : &u8,
    fg_magenta : &u8,
    fg_cyan    : &u8,
    fg_white   : &u8,

    -- foreground (bright)
    fg_bright_black   : &u8,
    fg_bright_red     : &u8,
    fg_bright_green   : &u8,
    fg_bright_yellow  : &u8,
    fg_bright_blue    : &u8,
    fg_bright_magenta : &u8,
    fg_bright_cyan    : &u8,
    fg_bright_white   : &u8,

    -- background (normal)
    bg_black   : &u8,
    bg_red     : &u8,
    bg_green   : &u8,
    bg_yellow  : &u8,
    bg_blue    : &u8,
    bg_magenta : &u8,
    bg_cyan    : &u8,
    bg_white   : &u8,

    -- background (bright)
    bg_bright_black   : &u8,
    bg_bright_red     : &u8,
    bg_bright_green   : &u8,
    bg_bright_yellow  : &u8,
    bg_bright_blue    : &u8,
    bg_bright_magenta : &u8,
    bg_bright_cyan    : &u8,
    bg_bright_white   : &u8,
}

escape :: () Escape {
    .{
        reset     : "\x1b[0m",
        bold      : "\x1b[1m",
        dim       : "\x1b[2m",
        italic    : "\x1b[3m",
        underline : "\x1b[4m",
        blink     : "\x1b[5m",
        reverse   : "\x1b[7m",
        hidden    : "\x1b[8m",
        strike    : "\x1b[9m",

        fg_black   : "\x1b[30m",
        fg_red     : "\x1b[31m",
        fg_green   : "\x1b[32m",
        fg_yellow  : "\x1b[33m",
        fg_blue    : "\x1b[34m",
        fg_magenta : "\x1b[35m",
        fg_cyan    : "\x1b[36m",
        fg_white   : "\x1b[37m",

        fg_bright_black   : "\x1b[90m",
        fg_bright_red     : "\x1b[91m",
        fg_bright_green   : "\x1b[92m",
        fg_bright_yellow  : "\x1b[93m",
        fg_bright_blue    : "\x1b[94m",
        fg_bright_magenta : "\x1b[95m",
        fg_bright_cyan    : "\x1b[96m",
        fg_bright_white   : "\x1b[97m",

        bg_black   : "\x1b[40m",
        bg_red     : "\x1b[41m",
        bg_green   : "\x1b[42m",
        bg_yellow  : "\x1b[43m",
        bg_blue    : "\x1b[44m",
        bg_magenta : "\x1b[45m",
        bg_cyan    : "\x1b[46m",
        bg_white   : "\x1b[47m",

        bg_bright_black   : "\x1b[100m",
        bg_bright_red     : "\x1b[101m",
        bg_bright_green   : "\x1b[102m",
        bg_bright_yellow  : "\x1b[103m",
        bg_bright_blue    : "\x1b[104m",
        bg_bright_magenta : "\x1b[105m",
        bg_bright_cyan    : "\x1b[106m",
        bg_bright_white   : "\x1b[107m"
    }
}
import Arena  from "allocator"
import Str, String from "string"
import Convert, conversion_error from "convert"

Escape :: struct {
    reset     &u8
    bold      &u8
    dim       &u8
    italic    &u8
    underline &u8
    blink     &u8
    reverse   &u8
    hidden    &u8
    strike    &u8

    fg_black   &u8
    fg_red     &u8
    fg_green   &u8
    fg_yellow  &u8
    fg_blue    &u8
    fg_magenta &u8
    fg_cyan    &u8
    fg_white   &u8

    fg_bright_black   &u8
    fg_bright_red     &u8
    fg_bright_green   &u8
    fg_bright_yellow  &u8
    fg_bright_blue    &u8
    fg_bright_magenta &u8
    fg_bright_cyan    &u8
    fg_bright_white   &u8

    bg_black   &u8
    bg_red     &u8
    bg_green   &u8
    bg_yellow  &u8
    bg_blue    &u8
    bg_magenta &u8
    bg_cyan    &u8
    bg_white   &u8

    bg_bright_black   &u8
    bg_bright_red     &u8
    bg_bright_green   &u8
    bg_bright_yellow  &u8
    bg_bright_blue    &u8
    bg_bright_magenta &u8
    bg_bright_cyan    &u8
    bg_bright_white   &u8
}

escape :: fn() Escape {
    .{
        reset     : c"\x1b[0m",
        bold      : c"\x1b[1m",
        dim       : c"\x1b[2m",
        italic    : c"\x1b[3m",
        underline : c"\x1b[4m",
        blink     : c"\x1b[5m",
        reverse   : c"\x1b[7m",
        hidden    : c"\x1b[8m",
        strike    : c"\x1b[9m",

        fg_black   : c"\x1b[30m",
        fg_red     : c"\x1b[31m",
        fg_green   : c"\x1b[32m",
        fg_yellow  : c"\x1b[33m",
        fg_blue    : c"\x1b[34m",
        fg_magenta : c"\x1b[35m",
        fg_cyan    : c"\x1b[36m",
        fg_white   : c"\x1b[37m",

        fg_bright_black   : c"\x1b[90m",
        fg_bright_red     : c"\x1b[91m",
        fg_bright_green   : c"\x1b[92m",
        fg_bright_yellow  : c"\x1b[93m",
        fg_bright_blue    : c"\x1b[94m",
        fg_bright_magenta : c"\x1b[95m",
        fg_bright_cyan    : c"\x1b[96m",
        fg_bright_white   : c"\x1b[97m",

        bg_black   : c"\x1b[40m",
        bg_red     : c"\x1b[41m",
        bg_green   : c"\x1b[42m",
        bg_yellow  : c"\x1b[43m",
        bg_blue    : c"\x1b[44m",
        bg_magenta : c"\x1b[45m",
        bg_cyan    : c"\x1b[46m",
        bg_white   : c"\x1b[47m",

        bg_bright_black   : c"\x1b[100m",
        bg_bright_red     : c"\x1b[101m",
        bg_bright_green   : c"\x1b[102m",
        bg_bright_yellow  : c"\x1b[103m",
        bg_bright_blue    : c"\x1b[104m",
        bg_bright_magenta : c"\x1b[105m",
        bg_bright_cyan    : c"\x1b[106m",
        bg_bright_white   : c"\x1b[107m"
    }
}

Fmt :: struct {
    buf String

    new :: fn(arena &Arena) Self {
        .{ buf: String.new(arena) }
    }

    str :: fn(self &Self, s Str) &Self {
        self.buf.push_str(s)
        ret self
    }

    cstr :: fn(self &Self, s &u8) &Self {
        self.str(Str.of(s))
        ret self
    }

    char :: fn(self &Self, c u8) &Self {
        self.buf.push_char(c)
        ret self
    }

    uint32 :: fn(self &Self, v u32) &Self {
        self.buf.push_u32(v)
        ret self
    }

    uint64 :: fn(self &Self, v u64) &Self {
        Convert.unsigned64(&self.buf, v)
        ret self
    }

    int32 :: fn(self &Self, v i32) &Self {
        Convert.signed64(&self.buf, v as i64)
        ret self
    }

    boolean :: fn(self &Self, v bool) &Self {
        Convert.boolean(&self.buf, v)
        ret self
    }

    space :: fn(self &Self) &Self {
        self.buf.push_char(32 as u8)
        ret self
    }

    newline :: fn(self &Self) &Self {
        self.buf.push_char(10 as u8)
        ret self
    }

    semi :: fn(self &Self) &Self {
        self.str(Str.of(";\n"))
        ret self
    }

    comma :: fn(self &Self) &Self {
        self.str(Str.of(", "))
        ret self
    }

    paren :: fn(self &Self, inner Str) &Self {
        self.buf.push_char(40 as u8)
        self.str(inner)
        self.buf.push_char(41 as u8)
        ret self
    }

    wrap :: fn(self &Self, left Str, inner Str, right Str) &Self {
        self.str(left)
        self.str(inner)
        self.str(right)
        ret self
    }

    sym :: fn(self &Self, prefix Str, id u32) &Self {
        self.str(prefix)
        self.uint32(id)
        ret self
    }

    binary :: fn(self &Self, op Str, lhs Str, rhs Str) &Self {
        self.buf.push_char(40 as u8)
        self.str(lhs)
        self.str(op)
        self.str(rhs)
        self.buf.push_char(41 as u8)
        ret self
    }

    indent :: fn(self &Self, level u32) &Self {
        i: u32 = 0
        while i < level {
            self.str(Str.of("    "))
            i = i + 1
        }
        ret self
    }

    as_str :: fn(self &Self) Str {
        self.buf.as_str()
    }

    print :: fn(self &Self) {
        print_bytes(self.buf.ptr, self.buf.len)
    }
}

print_bytes :: fn(ptr &u8, len u64)

format_code :: fn(pattern Str, info &TypeInfo()) Str {
    if (info.kind != TypeKind.tuple) and ((info.kind != TypeKind.struct_) or (info.field_count != 0)) {
        conversion_error("[format error] format arguments must be a tuple\n")
    }
    arena := Arena.new(4096)
    out := String.new(&arena)
    text := String.new(&arena)
    argument: u64 = 0
    i: u64 = 0
    while i < pattern.len {
        c := *(pattern.ptr + i)
        if (c == '{') or (c == '}') {
            if (i + 1 < pattern.len) and (*(pattern.ptr + i + 1) == c) {
                text.push_char(c)
                i = i + 2
                cont
            }
            if c == '}' { conversion_error("[format error] unmatched '}' in format string\n") }
            if (i + 1 >= pattern.len) or (*(pattern.ptr + i + 1) != '}') {
                conversion_error("[format error] expected '{}' placeholder or '{{' escape\n")
            }
            if argument >= info.field_count {
                conversion_error("[format error] not enough arguments for format string\n")
            }
            Convert.literal(&out, text.as_str())
            text.reset(0)
            field := *(info.fields + argument)
            expr := String.new(&arena)
            expr.push_str("args.")
            expr.push_str(field.name)
            Convert.value(&out, field.type_info, expr.as_str(), 0)
            argument = argument + 1
            i = i + 2
        } else {
            text.push_char(c)
            i = i + 1
        }
    }
    if argument != info.field_count {
        conversion_error("[format error] too many arguments for format string\n")
    }
    Convert.literal(&out, text.as_str())
    out.as_str()
}

fmt :: fn(T type, arena &Arena, cmpt pattern Str, args T) String {
    out := String.new(arena)
    #format_code(pattern, @type_info(T))
    out
}

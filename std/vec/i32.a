import I32_size from "../primitive/i32.a"

malloc  :: (size u64) &u8
realloc :: (ptr &u8, size u64) &u8
free    :: (ptr &u8) unit

VecType :: i32

VecI32 :: struct {
    ptr: &VecType,
    len: u64,
    cap: u64
}

VecI32_new :: () VecI32 {
    p := malloc(4 * I32_size()) as &VecType

    .{
        ptr: p,
        len: 0,
        cap: I32_size()
    }
}

VecI32_destroy :: (v &VecI32) {
    free((*v).ptr as &u8)
}

VecI32_grow :: (v &VecI32) {
    if (*v).len == (*v).cap {
        new_cap := (*v).cap * 2
        new_ptr := realloc((*v).ptr as &u8, new_cap * I32_size()) as &VecType

        (*v).ptr = new_ptr
        (*v).cap = new_cap
    }
}

VecI32_push :: (v &VecI32, val VecType) {
    VecI32_grow(v)

    *((*v).ptr + (*v).len) = val
    (*v).len = (*v).len + 1
}

VecI32_get :: (v &VecI32, idx u64) VecType {
    *((*v).ptr + idx)
}

VecI32_set :: (v &VecI32, idx u64, val VecType) {
    *((*v).ptr + idx) = val
}

VecI32_pop :: (v &VecI32) VecType {
    (*v).len = (*v).len - 1
    *((*v).ptr + (*v).len)
}
import malloc, realloc, free, mem_copy from "../mem.a"
import U32_size from "../primitive/u32.a"
import SliceU32 from "../slice/u32.a"

VecType            :: u32
SliceType          :: SliceU32 

elem_size          :: () u64 { U32_size() }


VecU32 :: struct {
    ptr: &VecType,
    len: u64,
    cap: u64

    new :: () Self {
        Self.with_cap(4)
    }

    with_cap :: (initial_cap u64) Self {
        cap := initial_cap
        if cap < 4 {
            cap = 4
        }

        p := malloc(cap * elem_size()) as &VecType

        .{
            ptr: p,
            len: 0,
            cap: cap
        }
    }

    destroy :: () {
        free(.ptr as &u8)
        .ptr = 0 as &VecType
        .len = 0
        .cap = 0
    }

    reserve :: (additional u64) {
        needed := .len + additional
        if needed > .cap {
            new_cap := .cap * 2
            if new_cap < 4 { new_cap = 4 }
            while new_cap < needed {
                new_cap = new_cap * 2
            }

            new_ptr := realloc(.ptr as &u8, new_cap * elem_size()) as &VecType
            .ptr = new_ptr
            .cap = new_cap
        }
    }

    grow :: () {
        if .len == .cap {
            .reserve(1)
        }
    }


    push :: (val VecType) {
        .grow()

        *(.ptr + .len) = val
        .len = .len + 1
    }


    get :: (idx u64) VecType {
        *(.ptr + idx)
    }

    pop :: () VecType {
        .len = .len - 1
        .get(.len)
    }

    set :: (idx u64, val VecType) {
        *(.ptr + idx) = val
    }


    last :: () VecType {
        *(.ptr + (.len - 1))
    }

    is_empty :: () bool {
        .len == 0
    }

    extend :: (src &VecType, count u64) {
        if count == 0 { ret }

        .reserve(count)
        dst := (.ptr + .len) as &u8

        mem_copy(dst, src as &u8, count * elem_size())
        .len = .len + count
    }

    mark :: () u64 {
        .len
    }

    reset :: (mark u64) {
        if mark <= .len {
            .len = mark
        }
    }

    clear :: () {
        .len = 0
    }

    ptr_at :: (offset u64) &VecType {
        .ptr + offset
    }

    swap_remove :: (idx u64) VecType {
        last_idx := .len - 1
        removed := *(.ptr + idx)
    
        if idx != last_idx {
            *(.ptr + idx) = *(.ptr + last_idx)
        }
    
        .len = last_idx
        removed
    }

    as_slice :: () SliceType {
        .{
            ptr: .ptr,
            len: .len
        }
    }
}
import Str from "../string.a"

--- Generics -------------------------------------------------------------------------------
SliceTy  :: Str
SliceStr :: Self

SliceStr_new :: (p &SliceTy, len u64) Self { Self_new() }
--------------------------------------------------------------------------------------------

Self :: struct {
    ptr: &SliceTy,
    len: u64
}


Self_new :: (p &SliceTy, len u64) Self {
    .{
        ptr: p,
        len: len
    }
}
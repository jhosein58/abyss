
--- Generics -------------------------------------------------------------------------------
SliceTy :: u8
SliceU8 :: Self

SliceU8_new :: fn(p &SliceTy, len u64) Self { Self_new() }
--------------------------------------------------------------------------------------------

Self :: struct {
    ptr: &SliceTy,
    len: u64
}


Self_new :: fn(p &SliceTy, len u64) Self {
    .{
        ptr: p,
        len: len
    }
}
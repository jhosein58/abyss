import Arena           from "allocator.a"
import ArenaVecU8      from "avec/u8.a"
import ArenaVecU8_new  from "avec/u8.a"
import ArenaVecU8_push from "avec/u8.a"

str_len    :: (s &u8) u64
print_char :: (c u8)  unit

----------------------> Str

Str :: struct {
    ptr: &u8,
    len: u64 


    size :: () u64 {
        16
    }

    new :: (ptr &u8, len u64) Str {
        .{
            ptr: ptr,
            len: len,
        }
    }

    empty :: () Str {
        .{
            ptr: 0 as &u8,
            len: 0,
        }
    }

    of :: (s &u8) Self {
        .{
            ptr: s,
            len: str_len(s)
        }
    }

    print :: () {
        i := 0

        while i < .len {
            print_char(*(.ptr + i))
            i = i + 1
        }
    }

    println :: (s Str) {
        s.print()
        print_char(*"\n")
    }

    sub :: (start u64, len u64) Str {
        .{
            ptr: (.ptr + start),
            len: len
        }
    }

    eq :: (b Str) bool {
        if .len != b.len {
            ret false
        }

        i: u64 = 0
        while i < .len {
            if *(.ptr + i) != *(b.ptr + i) {
                ret false
            }
            i = i + 1
        }

        true
    }
}






----------------------> String

String :: struct {
    buf: ArenaVecU8,
}

String_new :: (a &Arena) String {
    .{
        buf: ArenaVecU8_new(a)
    }
}

String_push_str :: (self &String, s Str) {
    i := 0

    while i < s.len {
        ArenaVecU8_push(&(*self).buf, *(s.ptr + i))
        i = i + 1
    }
}

String_as_str :: (self &String) Str {
    .{
        ptr: (*self).buf.ptr,
        len: (*self).buf.len
    }
}

String_push_char :: (self &String, c u8) {
    ArenaVecU8_push(&(*self).buf, c)
}

String_push_u32 :: (self &String, val u32) {
    if val == 0 {
        String_push_char(self, *"0") 
        ret
    }

    v := val
    divisor: u32 = 1

    while (((v / divisor) >= 10) and (divisor <= 100000000)) or false {
        divisor = divisor * 10
    }

    while (divisor > 0) or false {
        digit := v / divisor
        String_push_char(self, (digit + 48) as u8)
        
        v = v - (digit * divisor)
        divisor = divisor / 10
    }
}
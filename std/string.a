import Str from "../core/string.a"
import Arena  from "allocator.a"

str_len    :: fn(s &u8) u64
print_char :: fn(c u8)  unit


String :: struct {
    arena &Arena
    ptr   &u8
    len   u64
    cap   u64

    new :: fn(a &Arena) String {
        cap: u64 = 4
        p := a.alloc(cap) as &u8
        .{
            arena: a,
            ptr: p,
            len: 0,
            cap: cap
        }
    }

    grow :: fn(self &Self) {
        if self.len == self.cap {
            new_cap := self.cap * 2
            old_bytes := self.cap
            new_bytes := new_cap
            new_ptr := self.arena.realloc(self.ptr, old_bytes, new_bytes) as &u8
            self.ptr = new_ptr
            self.cap = new_cap
        }
    }

    push_char :: fn(self &Self, c u8) {
        self.grow()
        *(self.ptr + self.len) = c
        self.len = self.len + 1
    }

    push_str :: fn(self &Self, s Str) {
        i: u64 = 0
        while i < s.len {
            self.push_char(*(s.ptr + i))
            i = i + 1
        }
    }

    as_str :: fn(self &Self) Str {
        Str.new(self.ptr, self.len)
    }

    len :: fn(self &Self) u64 {
        self.len
    }

    mark :: fn(self &Self) u64 {
        self.len
    }

    reset :: fn(self &Self, mark u64) {
        self.len = mark
    }

    ptr_at :: fn(self &Self, offset u64) &u8 {
        self.ptr + offset
    }

    push_u32 :: fn(self &Self, val u32) {
        if val == 0 {
            self.push_char('0')
            ret
        }

        v := val
        divisor: u32 = 1

        while ((v / divisor) >= 10) and (divisor <= 100000000) {
            divisor = divisor * 10
        }

        while divisor > 0 {
            digit := v / divisor
            self.push_char((digit + 48) as u8)
        
            v = v - (digit * divisor)
            divisor = divisor / 10
        }
    }
}

u32_to_str :: fn(arena &Arena, val u32) Str {
    s := String.new(arena)
    s.push_u32(val)
    s.as_str()
}

parse_u32 :: fn(s Str) Maybe(u32) {
    if s.len == 0 { ret Maybe(u32).none() }
    res: u32 = 0
    i: u64 = 0
    base: u32 = 10
    if s.len >= 2 {
        if (*(s.ptr) == 48) and ((*(s.ptr + 1) == 120) or (*(s.ptr + 1) == 88)) {
            base = 16
            i = 2
        }
    }
    if i == s.len { ret Maybe(u32).none() }
    while i < s.len {
        c := *(s.ptr + i)
        if c == 95 {
            i = i + 1
            cont
        }
        digit: u32 = 16
        if (c >= 48) and (c <= 57) { digit = (c - 48) as u32 }
        if (c >= 65) and (c <= 70) { digit = (c - 65) as u32 + 10 }
        if (c >= 97) and (c <= 102) { digit = (c - 97) as u32 + 10 }
        if digit >= base { ret Maybe(u32).none() }
        res = (res * base) + digit
        i = i + 1
    }
    Maybe(u32).some(res)
}

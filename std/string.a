import Str from "../core/string.a"
import Convert, value_code from "convert.a"
import mem_copy from "mem.a"
import Arena  from "allocator.a"


String :: struct {
    arena &Arena
    ptr   &u8
    len   u64
    cap   u64

    new :: fn(a &Arena) String {
        .{ arena: a, ptr: 0 as &u8, len: 0, cap: 0 }
    }

    of :: fn(T type, arena &Arena, value T) Self {
        out := String.new(arena)
        #value_code(@type_info(T), "value")
        out
    }

    reserve :: fn(self &Self, needed u64) {
        if needed <= self.cap { ret }
        capacity := self.cap
        if capacity < 64 { capacity = 64 }
        while capacity < needed { capacity = capacity * 2 }
        self.ptr = self.arena.realloc(self.ptr, self.len, capacity)
        self.cap = capacity
    }

    push_char :: fn(self &Self, c u8) {
        self.reserve(self.len + 1)
        *(self.ptr + self.len) = c
        self.len = self.len + 1
    }

    push_str :: fn(self &Self, s Str) {
        if s.len == 0 { ret }
        self.reserve(self.len + s.len)
        mem_copy(self.ptr + self.len, s.ptr, s.len)
        self.len = self.len + s.len
    }

    as_str :: fn(self &Self) Str {
        Str.new(self.ptr, self.len)
    }

    len :: fn(self &Self) u64 {
        self.len
    }

    mark :: fn(self &Self) u64 {
        self.len
    }

    reset :: fn(self &Self, mark u64) {
        self.len = mark
    }

    ptr_at :: fn(self &Self, offset u64) &u8 {
        self.ptr + offset
    }

    push_u32 :: fn(self &Self, val u32) {
        Convert.unsigned64(self, val as u64)
    }
}

parse_u32 :: fn(s Str) Maybe(u32) {
    if s.len == 0 { ret Maybe(u32).none() }
    res: u32 = 0
    i: u64 = 0
    base: u32 = 10
    if s.len >= 2 {
        if (*(s.ptr) == 48) and ((*(s.ptr + 1) == 120) or (*(s.ptr + 1) == 88)) {
            base = 16
            i = 2
        }
    }
    if i == s.len { ret Maybe(u32).none() }
    while i < s.len {
        c := *(s.ptr + i)
        if c == 95 {
            i = i + 1
            cont
        }
        digit: u32 = 16
        if (c >= 48) and (c <= 57) { digit = (c - 48) as u32 }
        if (c >= 65) and (c <= 70) { digit = (c - 65) as u32 + 10 }
        if (c >= 97) and (c <= 102) { digit = (c - 97) as u32 + 10 }
        if digit >= base { ret Maybe(u32).none() }
        res = (res * base) + digit
        i = i + 1
    }
    Maybe(u32).some(res)
}

to_cstr :: fn(arena &Arena, s Str) &u8 {
    buf := arena.alloc(s.len + 1)
    i: u64 = 0
    while i < s.len {
        *(buf + i) = *(s.ptr + i)
        i = i + 1
    }
    *(buf + s.len) = 0 as u8
    buf
}


import Arena  from "allocator.a"
import AVecU8 from "avec/u8.a"

str_len    :: (s &u8) u64
print_char :: (c u8)  unit

----------------------> Str

Str :: struct {
    ptr: &u8,
    len: u64 


    size :: () u64 {
        16
    }

    new :: (ptr &u8, len u64) Str {
        .{
            ptr: ptr,
            len: len,
        }
    }

    empty :: () Str {
        .{
            ptr: 0 as &u8,
            len: 0,
        }
    }

    of :: (s &u8) Self {
        .{
            ptr: s,
            len: str_len(s)
        }
    }

    print :: () {
        i := 0

        while i < .len {
            print_char(*(.ptr + i))
            i = i + 1
        }
    }

    println :: (s Str) {
        s.print()
        print_char(*"\n")
    }

    sub :: (start u64, len u64) Str {
        .{
            ptr: (.ptr + start),
            len: len
        }
    }

    eq :: (b Str) bool {
        if .len != b.len {
            ret false
        }

        i: u64 = 0
        while i < .len {
            if *(.ptr + i) != *(b.ptr + i) {
                ret false
            }
            i = i + 1
        }

        true
    }
}






----------------------> String

String :: struct {
    buf: AVecU8,

    new :: (a &Arena) String {
        .{
            buf: AVecU8.new(a)
        }
    }

    push_str :: (s Str) {
        i := 0

        while i < s.len {
            .buf.push(*(s.ptr + i))
            i = i + 1
        }
    }

    as_str :: () Str {
        Str.new(.buf.ptr, .buf.len)
    }

    push_char :: (c u8) {
        .buf.push(c)
    }

    push_u32 :: (val u32) {
        if val == 0 {
            .push_char(*"0") 
            ret
        }

        v := val
        divisor: u32 = 1

        while ((v / divisor) >= 10) and (divisor <= 100000000) {
            divisor = divisor * 10
        }

        while divisor > 0 {
            digit := v / divisor
            .push_char((digit + 48) as u8)
        
            v = v - (digit * divisor)
            divisor = divisor / 10
        }
    }
}
import Str from "../core/string.a"
import Arena  from "allocator.a"
import AVecU8 from "avec/u8.a"

str_len    :: (s &u8) u64
print_char :: (c u8)  unit


String :: struct {
    buf: AVecU8,

    new :: (a &Arena) String {
        .{
            buf: AVecU8.new(a)
        }
    }

    push_str :: (s Str) {
        i := 0

        while i < s.len {
            .buf.push(*(s.ptr + i))
            i = i + 1
        }
    }

    as_str :: () Str {
        Str.new(.buf.ptr, .buf.len)
    }

    push_char :: (c u8) {
        .buf.push(c)
    }

    push_u32 :: (val u32) {
        if val == 0 {
            .push_char('0') 
            ret
        }

        v := val
        divisor: u32 = 1

        while ((v / divisor) >= 10) and (divisor <= 100000000) {
            divisor = divisor * 10
        }

        while divisor > 0 {
            digit := v / divisor
            .push_char((digit + 48) as u8)
        
            v = v - (digit * divisor)
            divisor = divisor / 10
        }
    }
}

u32_to_str :: (arena &Arena, val u32) Str {
    s := String.new(arena)
    s.push_u32(val)
    s.as_str()
}

parse_u32 :: (s Str) Maybe(u32) {
    if s.len == 0 { ret Maybe(u32).none() }
    res: u32 = 0
    i: u64 = 0
    base: u32 = 10
    if s.len >= 2 {
        if (*(s.ptr) == 48) and ((*(s.ptr + 1) == 120) or (*(s.ptr + 1) == 88)) {
            base = 16
            i = 2
        }
    }
    if i == s.len { ret Maybe(u32).none() }
    while i < s.len {
        c := *(s.ptr + i)
        if c == 95 {
            i = i + 1
            cont
        }
        digit: u32 = 16
        if (c >= 48) and (c <= 57) { digit = (c - 48) as u32 }
        if (c >= 65) and (c <= 70) { digit = (c - 65) as u32 + 10 }
        if (c >= 97) and (c <= 102) { digit = (c - 97) as u32 + 10 }
        if digit >= base { ret Maybe(u32).none() }
        res = (res * base) + digit
        i = i + 1
    }
    Maybe(u32).some(res)
}
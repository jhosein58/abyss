import Str from "../core/string.a"
import Arena  from "allocator.a"
import AVecU8 from "avec/u8.a"

str_len    :: (s &u8) u64
print_char :: (c u8)  unit


String :: struct {
    buf: AVecU8,

    new :: (a &Arena) String {
        .{
            buf: AVecU8.new(a)
        }
    }

    push_str :: (s Str) {
        i := 0

        while i < s.len {
            .buf.push(*(s.ptr + i))
            i = i + 1
        }
    }

    as_str :: () Str {
        Str.new(.buf.ptr, .buf.len)
    }

    push_char :: (c u8) {
        .buf.push(c)
    }

    push_u32 :: (val u32) {
        if val == 0 {
            .push_char('0') 
            ret
        }

        v := val
        divisor: u32 = 1

        while ((v / divisor) >= 10) and (divisor <= 100000000) {
            divisor = divisor * 10
        }

        while divisor > 0 {
            digit := v / divisor
            .push_char((digit + 48) as u8)
        
            v = v - (digit * divisor)
            divisor = divisor / 10
        }
    }
}
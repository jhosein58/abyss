import Str from "string.a"
import malloc, free, mem_set from "mem.a"

hash_str :: fn(s Str) u32 {
    h: u32 = 2166136261 as u32
    i: u64 = 0
    while i < s.len {
        c := *(s.ptr + i) as u32
        h = (h ^ c) * 16777619 as u32
        i = i + 1
    }
    h
}

intern_none :: fn() u32 {
    4294967295 as u32
}

Interner :: struct {
    strings Vec(Str)
    table   &u32
    cap     u64
    count   u64

    new :: fn() Self {
        Self.with_cap(64)
    }

    with_cap :: fn(initial_cap u64) Self {
        cap := initial_cap
        if cap < 64 {
            cap = 64
        }

        bytes := cap * @sizeof(u32)
        ptr := malloc(bytes) as &u32

        mem_set(ptr as &u8, 255 as u8, bytes)

        .{
            strings : Vec(Str).new(),
            table   : ptr,
            cap     : cap,
            count   : 0
        }
    }

    destroy :: fn(self &Self) {
        self.strings.destroy()
        free(self.table as &u8)

        self.table = 0 as &u32
        self.cap = 0
        self.count = 0
    }

    grow :: fn(self &Self) {
        old_cap := self.cap
        old_table := self.table

        new_cap := old_cap * 2
        new_bytes := new_cap * @sizeof(u32)
        new_table := malloc(new_bytes) as &u32

        mem_set(new_table as &u8, 255 as u8, new_bytes)

        mask := new_cap - 1
        empty := intern_none()

        i: u64 = 0
        while i < old_cap {
            id := *(old_table + i)
            if id != empty {
                s := self.strings.get(id as u64)
                idx := (hash_str(s) as u64) & mask

                while *(new_table + idx) != empty {
                    idx = (idx + 1) & mask
                }

                *(new_table + idx) = id
            }
            i = i + 1
        }

        free(old_table as &u8)
        self.table = new_table
        self.cap = new_cap
    }

    intern :: fn(self &Self, s Str) u32 {
        if (self.count + 1) * 10 >= self.cap * 7 {
            self.grow()
        }

        mask := self.cap - 1
        h := hash_str(s) as u64
        idx := h & mask
        empty := intern_none()

        while true {
            id := *(self.table + idx)

            if id == empty {
                new_id := self.strings.len as u32
                self.strings.push(s)

                *(self.table + idx) = new_id
                self.count = self.count + 1
                ret new_id
            }

            existing_str := self.strings.get(id as u64)
            if s.eq(existing_str) {
                ret id
            }

            idx = (idx + 1) & mask
        }

        empty
    }

    get :: fn(self &Self, id u32) Str {
        self.strings.get(id as u64)
    }

    len :: fn(self &Self) u64 {
        self.strings.len
    }
}



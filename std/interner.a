import Str from "string.a"
import hash_str from "hash/str.a"
import VecStr from "vec/str.a"
import U32_size, U32_MAX from "primitive/u32.a"
import malloc, free, mem_set from "mem.a"

intern_none :: () u32 {
    U32_MAX()
}


Interner :: struct {
    strings : VecStr, 
    table   : &u32,
    cap     : u64,
    count   : u64,

    new :: () Self {
        .with_cap(64)
    }

    with_cap :: (initial_cap u64) Self {
        cap := initial_cap
        if cap < 64 {
            cap = 64
        }

        bytes := cap * U32_size()
        ptr := malloc(bytes) as &u32

        mem_set(ptr as &u8, 255 as u8, bytes)

        .{
            strings : VecStr.new(),
            table   : ptr,
            cap     : cap,
            count   : 0
        }
    }

    destroy :: () {
        .strings.destroy()
        free(self.table as &u8)

        .table = 0 as &u32
        .cap = 0
        .count = 0
    }

    grow :: () {
        old_cap := .cap
        old_table := .table

        new_cap := old_cap * 2
        new_bytes := new_cap * U32_size()
        new_table := malloc(new_bytes) as &u32

        mem_set(new_table as &u8, 255 as u8, new_bytes)

        mask := new_cap - 1
        empty := intern_none()

        i: u64 = 0
        while i < old_cap {
            id := *(old_table + i)
            if id != empty {
                s := .strings.get(id as u64)
                idx := (hash_str(s) as u64) & mask

                while *(new_table + idx) != empty {
                    idx = (idx + 1) & mask
                }

                *(new_table + idx) = id
            }
            i = i + 1
        }

        free(old_table as &u8)
        .table = new_table
        .cap = new_cap
    }

    intern :: (s Str) u32 {
        if (.count + 1) * 10 >= .cap * 7 {
            .grow()
        }

        mask := .cap - 1
        h := hash_str(s) as u64
        idx := h & mask
        empty := intern_none()

        while true {
            id := *(.table + idx)

            if id == empty {
                new_id := .strings.len as u32
                .strings.push(s)

                *(.table + idx) = new_id
                .count = .count + 1
                ret new_id
            }

            existing_str := .strings.get(id as u64)
            if s.eq(existing_str) {
                ret id
            }

            idx = (idx + 1) & mask
        }

        empty
    }

    get :: (id u32) Str {
        .strings.get(id as u64)
    }

    len :: () u64 {
        .strings.len
    }
}



import Arena from "allocator"
import fmt from "fmt"
import String from "string"

print_bytes :: fn(ptr &u8, len u64)
print_char :: fn(value u8)

write_str :: fn(value Str) {
    print_bytes(value.ptr, value.len)
}

print_body :: fn(newline bool) Str {
    if newline {
        ret `{
            arena := Arena.new(1024)
            text := fmt(&arena, "{}", .{value})
            write_str(text.as_str())
            arena.destroy()
            print_char('\n')
        }`
    }
    `{
        arena := Arena.new(1024)
        text := fmt(&arena, "{}", .{value})
        write_str(text.as_str())
        arena.destroy()
    }`
}

write :: fn(T type, value T) {
    #print_body(false)
}

print :: fn(T type, value T) {
    #print_body(true)
}

print_codepoint :: fn(cp u32) {
    arena := Arena.new(64)
    s := String.new(&arena)
    s.push_codepoint(cp)
    write_str(s.as_str())
    arena.destroy()
}

printf :: fn(T type, cmpt pattern Str, args T) {
    arena := Arena.new(1024)
    text := fmt(&arena, pattern, args)
    write_str(text.as_str())
    arena.destroy()
}

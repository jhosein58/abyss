import malloc, realloc, free, mem_copy from "../mem.a"
import Iterator as Iter from "core/iterator.a"


Vec :: fn(T type) type {
    struct {
        ptr &T
        len u64
        cap u64

        new :: fn() Self {
            Self.with_cap(4)
        }

        with_cap :: fn(initial_cap u64) Self {
            cap := initial_cap
            if cap < 4 {
                cap = 4
            }

            p := malloc(cap * @sizeof(T)) as &T

            .{
                ptr: p,
                len: 0,
                cap: cap
            }
        }

        destroy :: fn(self &Self) {
            free(self.ptr as &u8)
            self.ptr = 0 as &T
            self.len = 0
            self.cap = 0
        }

        reserve :: fn(self &Self, additional u64) {
            needed := self.len + additional
            if needed > self.cap {
                new_cap := self.cap * 2
                if new_cap < 4 { new_cap = 4 }
                while new_cap < needed {
                    new_cap = new_cap * 2
                }

                new_ptr := realloc(self.ptr as &u8, new_cap * @sizeof(T)) as &T
                self.ptr = new_ptr
                self.cap = new_cap
            }
        }

        grow :: fn(self &Self) {
            if self.len == self.cap {
                self.reserve(1)
            }
        }


        push :: fn(self &Self, val T) {
            self.grow()

            *(self.ptr + self.len) = val
            self.len = self.len + 1
        }


        get :: fn(self &Self, idx u64) T {
            *(self.ptr + idx)
        }

        pop :: fn(self &Self) T {
            self.len = self.len - 1
            self.get(self.len)
        }

        set :: fn(self &Self, idx u64, val T) {
            *(self.ptr + idx) = val
        }


        last :: fn(self &Self) T {
            *(self.ptr + (self.len - 1))
        }

        is_empty :: fn(self &Self) bool {
            self.len == 0
        }

        extend :: fn(self &Self, src &T, count u64) {
            if count == 0 { ret }

            self.reserve(count)
            dst := (self.ptr + self.len) as &u8

            mem_copy(dst, src as &u8, count * @sizeof(T))
            self.len = self.len + count
        }

        mark :: fn(self &Self) u64 {
            self.len
        }

        reset :: fn(self &Self, mark u64) {
            if mark <= self.len {
                self.len = mark
            }
        }

        clear :: fn(self &Self) {
            self.len = 0
        }

        ptr_at :: fn(self &Self, offset u64) &T {
            self.ptr + offset
        }

        swap_remove :: fn(self &Self, idx u64) T {
            last_idx := self.len - 1
            removed := *(self.ptr + idx)
        
            if idx != last_idx {
                *(self.ptr + idx) = *(self.ptr + last_idx)
            }
        
            self.len = last_idx
            removed
        }

        iter :: fn(self &Self) Iter(T) {
            .{ ptr: self.ptr, len: self.len, index: 0 }
        }

        collect :: fn(iter Iter(T)) Self {
            result := Self.new()
            while true {
                item := iter.next()
                if item.is_none() { break }
                result.push(item.unwrap())
            }
            result
        }
    }
}

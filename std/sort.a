sort :: fn(T type, values Slice(T)) {
    sort_chunks(values, 1)
}

sort_chunks :: fn(T type, values Slice(T), width u64) {
    if width == 0 { ret }
    count := values.len / width
    start := count / 2
    while start > 0 {
        start = start - 1
        sift(values, width, start, count)
    }
    end := count
    while end > 1 {
        end = end - 1
        swap(values, width, 0, end)
        sift(values, width, 0, end)
    }
}

swap :: fn(T type, values Slice(T), width u64, a u64, b u64) {
    i: u64 = 0
    while i < width {
        left := values.ptr + a * width + i
        right := values.ptr + b * width + i
        value := *left
        *left = *right
        *right = value
        i = i + 1
    }
}

sift :: fn(T type, values Slice(T), width u64, root u64, end u64) {
    while root < end / 2 {
        child := root * 2 + 1
        if (child + 1 < end) and (values.get(child * width) < values.get((child + 1) * width)) {
            child = child + 1
        }
        if not (values.get(root * width) < values.get(child * width)) { break }
        swap(values, width, root, child)
        root = child
    }
}

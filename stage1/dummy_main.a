import lex   from "dummy_compiler/lexer.a"

import Str_from, Str_println from "../std/string.a"

import Arena_new from "../std/allocator.a"
import read_file, write_file from "../std/fs.a"

import HirTable_new, HirTable_len from "dummy_compiler/hir.a"
import Parser_new from "dummy_compiler/parser/core.a"
import parse_expr from "dummy_compiler/parser/parser.a"
import dump_hir from "dummy_compiler/dump.a"
import type_check from "dummy_compiler/typer/tyck.a"
import FastMapU32_new, FastMapU32_destroy, FastMapU32_insert, FastMapU32_get from "../std/fast_map/u32.a"
import Interner_new, Interner_intern, Interner_get from "../std/interner.a"


import Nexus_new from "dummy_compiler/nexus/nexus.a"


import TypeStorage_new, TypeStorage_alloc_int, TypeStorage_name from "dummy_compiler/types.a"

import UnifyStorage_get_slot, UnifyStorage_resolve_type, slot_none from "dummy_compiler/unify.a"


import Engine_new, Engine_add_file, Engine_get_symbol_id, Engine_parse, Engine_type_check from "dummy_compiler/engine.a"

import CCodeGen_finish from "dummy_compiler/codegen.a"
import Engine_new, Engine_add_file, Engine_get_symbol_id, Engine_parse, Engine_type_check, Engine_abyss_main, Engine_compile from "dummy_compiler/engine.a"

print_u32 :: (s u32) unit
print_u64 :: (s u64) unit
print_u8 :: (s u8) unit
print_char :: (s u8) unit
print :: (s &u8) unit

compile_and_run :: (path &u8) i32

main :: () {
    print("--> dummy main \n")
    arena := Arena_new(1024 * 1024 * 16)

    main_path := "main.a"

    source := read_file(&arena, main_path)

    eng := Engine_new()

    fid := Engine_add_file(&eng, &arena, Str_from(main_path), source)

    sym_id := Engine_get_symbol_id(&eng, fid, Str_from("main"))

    Engine_parse(&eng, sym_id)
    Engine_type_check(&eng, sym_id)

    Engine_abyss_main(&eng, sym_id)
    Engine_compile(&eng, &arena, sym_id)

    c_code := CCodeGen_finish(&eng.ccg, read_file(&arena, "prelude.c"))
    write_file("dummy_out.c", c_code)

    --compile_and_run("tmp/stg1_out.c")

    
}
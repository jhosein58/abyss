import token, token_name, TokenStream_new, TokenStream_destroy, TokenStream_push, TokenStream_kind, TokenStream_text, TokenStream_count from "compiler/token.a"
import lex   from "compiler/lexer.a"

import Str_from, Str_println from "../std/string.a"

import Arena_new from "../std/allocator.a"
import read_file, write_file from "../std/fs.a"

import HirTable_new, HirTable_len from "compiler/hir.a"
import Parser_new from "compiler/parser/core.a"
import parse_expr from "compiler/parser/parser.a"
import dump_hir from "compiler/dump.a"
import type_check from "compiler/typer/tyck.a"
import FastMapU32_new, FastMapU32_destroy, FastMapU32_insert, FastMapU32_get from "../std/fast_map/u32.a"
import Interner_new, Interner_intern, Interner_get from "../std/interner.a"


import Nexus_new from "compiler/nexus/nexus.a"


import TypeStorage_new, TypeStorage_alloc_int, TypeStorage_name from "compiler/types.a"

import UnifyStorage_get_slot, UnifyStorage_resolve_type, slot_none from "compiler/unify.a"


import Engine_new, Engine_add_file, Engine_get_symbol_id, Engine_parse, Engine_type_check from "compiler/engine.a"

import CCodeGen_finish from "compiler/codegen.a"
import Engine_new, Engine_add_file, Engine_get_symbol_id, Engine_parse, Engine_type_check, Engine_abyss_main, Engine_compile from "compiler/engine.a"

print_u32 :: (s u32) unit
print_u64 :: (s u64) unit
print_u8 :: (s u8) unit
print_char :: (s u8) unit
print :: (s &u8) unit

compile_and_run :: (path &u8) i32

main :: () {
    arena := Arena_new(1024)
    source := read_file(&arena, "tmp/main.a")

    eng := Engine_new()

    fid := Engine_add_file(&eng, Str_from("tmp/main.a"), source)

    sym_id := Engine_get_symbol_id(&eng, fid, Str_from("main"))

    Engine_parse(&eng, sym_id)
    Engine_type_check(&eng, sym_id)

    Engine_abyss_main(&eng, sym_id)
    Engine_compile(&eng, &arena, sym_id)

    c_code := CCodeGen_finish(&eng.ccg, read_file(&arena, "prelude.c"))
    write_file("tmp/stg1_out.c", c_code)
    Str_println(c_code)

    --compile_and_run("tmp/stg1_out.c")

    dump_hir(&eng.nexus, &eng.nexus.hir, &arena)

}


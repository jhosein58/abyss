import Str, Str_println from "../../std/string.a"

print_u64 :: (v u64) unit
print_char :: (c u8) unit

Lexer :: struct {
    source: Str,
    cursor: u64
}

Lexer_new :: (source Str) Lexer {
    .{
        source: source,
        cursor: 0,
    }
}

bump :: (l &Lexer) {
    (*l).cursor = (*l).cursor + 1
}

read_char :: (l &Lexer, offset u64) u8 {
    *((*l).source.ptr + offset)
}

peek :: (l &Lexer) u8 {
    curr := (*l).cursor

    read_char(l, curr + 1)
}

next :: (l &Lexer) u8 {
    curr := &(*l).cursor

    *curr = *curr + 1

    read_char(l, curr - 1)
}

lex :: (source Str) {

    lexer := Lexer_new(source)

    print_char(read_char(&lexer, 0))
}
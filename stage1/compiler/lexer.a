import Str, Str_new, Str_println from "../../std/string.a"
import token, TokenStream, TokenStream_push from "token.a"

print_u64 :: (v u64) unit
print_char :: (c u8) unit
print_bool :: (v bool) unit
print_u8 :: (v u8) unit
print_u32 :: (v u32) unit

Lexer :: struct {
    source: Str,
    cursor: u64
}

Lexer_new :: (source Str) Lexer {
    .{
        source: source,
        cursor: 0,
    }
}

bump :: (l &Lexer) {
    (*l).cursor = (*l).cursor + 1
}

read_char :: (l &Lexer, offset u64) u8 {
    *((*l).source.ptr + offset)
}

peek :: (l &Lexer) u8 {
    curr := (*l).cursor

    read_char(l, curr + 1)
}

current :: (l &Lexer) u8 {
    read_char(l, (*l).cursor)
}

next :: (l &Lexer) u8 {
    curr := &(*l).cursor

    *curr = *curr + 1

    read_char(l, (*curr) - 1)
}

is_eof :: (l &Lexer) bool {
    (*l).cursor >= (*l).source.len
}

is_digit :: (c u8) bool {
    (c >= 48) and (c <= 57)
}

lex :: (stream &TokenStream, source Str) {

    lexer := Lexer_new(source)
    

    curr := current(&lexer)

    if is_digit(curr) {
        scan_number(&lexer, stream)
    }

    bump(&lexer)


    if is_digit(curr) {
        scan_number(&lexer, stream)
    }


    bump(&lexer)


    if is_digit(curr) {
        scan_number(&lexer, stream)
    }
}

scan_number :: (lexer &Lexer, stream &TokenStream) {

    len: u32 = 0
    offset: u64 = (*lexer).cursor

    while true {
        curr := current(lexer)


        if not is_digit(curr) {
            break
        }

        bump(lexer)

        len = len + 1
    } 

    TokenStream_push(stream, token().lit_int,0,  len, Str_new((*lexer).source.ptr + offset, len as u64), false)
}
import VecU32 from "../../std/vec/u32.a"
import VecStr from "../../std/vec/str.a"

TokenType :: struct {
    lit_int: u32,
    ident  : u32,
}

token :: () TokenType {
    .{
        lit_int: 0,
        ident  : 1,
    }
}


TokenStream :: struct {
    kind : VecU32,
    lhs  : VecU32,
    rhs  : VecU32,
    extra: VecU32,
    len  : VecU32,
    text : VecStr,
}
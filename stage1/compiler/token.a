import VecU32,  VecU32_new  from "../../std/vec/u32.a"
import VecStr,  VecStr_new  from "../../std/vec/str.a"
import VecBool, VecBool_new from "../../std/vec/bool.a"

TokenType :: struct {
    lit_int: u32,
    ident  : u32,
}

token :: () TokenType {
    .{
        lit_int: 0,
        ident  : 1,
    }
}


TokenStream :: struct {
    kind          : VecU32,
    lhs           : VecU32,
    rhs           : VecU32,
    extra         : VecU32,
    len           : VecU32,
    text          : VecStr,
    newline_before: VecBool,
}

TokenStream_new :: () TokenStream {
    .{
        kind          : VecU32_new(),
        lhs           : VecU32_new(),
        rhs           : VecU32_new(),
        extra         : VecU32_new(),
        len           : VecU32_new(),
        text          : VecStr_new(),
        newline_before: VecBool_new(),
    }
}
import token, TokenStream_kind, TokenStream_text, TokenStream_count from "token.a"
import lex from "lexer.a"
import Nexus, Nexus_alloc_symbol, Nexus_alloc_symbol_alias, Nexus_find_symbol from "nexus/nexus.a"
import Interner_intern, Interner_get from "../../std/interner.a"
import Str, Str_from, Str_print from "../../std/string.a"
import Arena, Arena_alloc from "../../std/allocator.a"
import read_file from "../../std/fs.a"
import VecU32, VecU32_new, VecU32_destroy, VecU32_push, VecU32_get, VecU32_set from "../../std/vec/u32.a"
import id_none from "nexus/pool.a"

str_eq :: (a Str, b Str) bool {
    if a.len != b.len { ret false }
    i: u64 = 0
    while i < a.len {
        if *(a.ptr + i) != *(b.ptr + i) { ret false }
        i = i + 1
    }
    true
}

trim_quotes :: (s Str) Str {
    if s.len >= 2 {
        first := *(s.ptr)
        last := *(s.ptr + s.len - 1)
        if (first == 34 as u8) and (last == 34 as u8) {
            ret .{
                ptr: s.ptr + 1,
                len: s.len - 2
            }
        }
    }
    s
}

path_resolve :: (arena &Arena, base Str, rel Str) Str {
    dir_len: u64 = 0
    if base.len > 0 {
        idx := base.len
        while idx > 0 {
            idx = idx - 1
            if *(base.ptr + idx) == 47 as u8 { -- '/'
                dir_len = idx
                break
            }
        }
    }

    combined_len := rel.len
    if dir_len > 0 {
        combined_len = dir_len + 1 + rel.len
    }

    comb_buf := Arena_alloc(arena, combined_len + 1)
    if dir_len > 0 {
        i: u64 = 0
        while i < dir_len {
            *(comb_buf + i) = *(base.ptr + i)
            i = i + 1
        }
        *(comb_buf + dir_len) = 47 as u8
        j: u64 = 0
        while j < rel.len {
            *(comb_buf + dir_len + 1 + j) = *(rel.ptr + j)
            j = j + 1
        }
    } else {
        i: u64 = 0
        while i < rel.len {
            *(comb_buf + i) = *(rel.ptr + i)
            i = i + 1
        }
    }

    combined: Str = .{ ptr: comb_buf, len: combined_len }

    seg_starts := VecU32_new()
    seg_lens   := VecU32_new()

    c_i: u64 = 0
    seg_start: u64 = 0
    while c_i <= combined.len {
        is_end := c_i == combined.len
        is_slash := false
        if not is_end {
            if *(combined.ptr + c_i) == 47 as u8 { is_slash = true }
        }

        if is_end or is_slash {
            s_len := c_i - seg_start
            if s_len > 0 {
                is_dot := (s_len == 1) and (*(combined.ptr + seg_start) == 46 as u8)
                is_dotdot := (s_len == 2) and (*(combined.ptr + seg_start) == 46 as u8) and (*(combined.ptr + seg_start + 1) == 46 as u8)

                if is_dot {
                } else if is_dotdot {
                    if seg_starts.len > 0 {
                        last_idx := seg_starts.len - 1
                        top_start := VecU32_get(&seg_starts, last_idx) as u64
                        top_len   := VecU32_get(&seg_lens, last_idx) as u64
                        top_is_dotdot := (top_len == 2) and (*(combined.ptr + top_start) == 46 as u8) and (*(combined.ptr + top_start + 1) == 46 as u8)
                        if top_is_dotdot {
                            VecU32_push(&seg_starts, seg_start as u32)
                            VecU32_push(&seg_lens, s_len as u32)
                        } else {
                            seg_starts.len = seg_starts.len - 1
                            seg_lens.len = seg_lens.len - 1
                        }
                    } else {
                        VecU32_push(&seg_starts, seg_start as u32)
                        VecU32_push(&seg_lens, s_len as u32)
                    }
                } else {
                    VecU32_push(&seg_starts, seg_start as u32)
                    VecU32_push(&seg_lens, s_len as u32)
                }
            }
            seg_start = c_i + 1
        }
        c_i = c_i + 1
    }

    final_len: u64 = 0
    k_i: u64 = 0
    while k_i < seg_starts.len {
        final_len = final_len + (VecU32_get(&seg_lens, k_i) as u64)
        if (k_i + 1) < seg_starts.len {
            final_len = final_len + 1
        }
        k_i = k_i + 1
    }

    out_buf := Arena_alloc(arena, final_len + 1)
    write_pos: u64 = 0
    k_i = 0
    while k_i < seg_starts.len {
        s_off := VecU32_get(&seg_starts, k_i) as u64
        s_len := VecU32_get(&seg_lens, k_i) as u64
        cp_i: u64 = 0
        while cp_i < s_len {
            *(out_buf + write_pos) = *(combined.ptr + s_off + cp_i)
            write_pos = write_pos + 1
            cp_i = cp_i + 1
        }
        if (k_i + 1) < seg_starts.len {
            *(out_buf + write_pos) = 47 as u8
            write_pos = write_pos + 1
        }
        k_i = k_i + 1
    }
    *(out_buf + write_pos) = 0 as u8

    VecU32_destroy(&seg_starts)
    VecU32_destroy(&seg_lens)

    .{ ptr: out_buf, len: final_len }
}

resolve_and_load_file :: (
    db              &Nexus,
    arena           &Arena,
    curr_path       Str,
    import_path     Str,
    loaded_paths    &VecU32,
    queue_fids      &VecU32,
    queue_tok_start &VecU32,
    queue_tok_end   &VecU32
) u32 {
    target_path := path_resolve(arena, curr_path, import_path)
    path_id := Interner_intern(&(*db).interner, target_path)

    i: u64 = 0
    while i < (*loaded_paths).len {
        if VecU32_get(loaded_paths, i) == path_id {
            ret i as u32
        }
        i = i + 1
    }

    fid := (*loaded_paths).len as u32
    VecU32_push(loaded_paths, path_id)

    source := read_file(arena, target_path.ptr)
    tok_start := TokenStream_count(&(*db).tokens) as u32
    lex(&(*db).tokens, source)
    tok_end := TokenStream_count(&(*db).tokens) as u32

    VecU32_push(queue_fids, fid)
    VecU32_push(queue_tok_start, tok_start)
    VecU32_push(queue_tok_end, tok_end)

    fid
}

scan_file_symbols :: (
    db              &Nexus,
    arena           &Arena,
    file_id         u32,
    curr_path       Str,
    start_tok       u32,
    end_tok         u32,
    loaded_paths    &VecU32,
    queue_fids      &VecU32,
    queue_tok_start &VecU32,
    queue_tok_end   &VecU32,
    pending_imports &VecU32
) {
    t := token()
    cursor := start_tok
    depth: u32 = 0

    has_sym := false
    curr_sym_name: u32 = 0
    curr_sym_tok:  u32 = 0

    while cursor < end_tok {
        tk := TokenStream_kind(&(*db).tokens, cursor)
        tk_text := TokenStream_text(&(*db).tokens, cursor)

        if (tk == t.o_brace) or (tk == t.o_paren) {
            depth = depth + 1
        } else if (tk == t.c_brace) or (tk == t.c_paren) {
            if depth > 0 {
                depth = depth - 1
            }
        } else if (depth == 0) and (str_eq(tk_text, Str_from("import"))) {
            if has_sym {
                Nexus_alloc_symbol(db, file_id, curr_sym_name, curr_sym_tok, cursor)
                has_sym = false
            }

            scan := cursor + 1
            imported_names := VecU32_new()

            while scan < end_tok {
                stk_text := TokenStream_text(&(*db).tokens, scan)
                if str_eq(stk_text, Str_from("from")) {
                    scan = scan + 1
                    break
                }
                if not str_eq(stk_text, Str_from(",")) {
                    name_id := Interner_intern(&(*db).interner, stk_text)
                    VecU32_push(&imported_names, name_id)
                }
                scan = scan + 1
            }

            if scan < end_tok {
                raw_path := TokenStream_text(&(*db).tokens, scan)
                path_str := trim_quotes(raw_path)

                target_fid := resolve_and_load_file(
                    db, arena, curr_path, path_str,
                    loaded_paths, queue_fids, queue_tok_start, queue_tok_end
                )

                n_i: u64 = 0
                while n_i < imported_names.len {
                    nid := VecU32_get(&imported_names, n_i)
                    VecU32_push(pending_imports, file_id)
                    VecU32_push(pending_imports, nid)
                    VecU32_push(pending_imports, nid)
                    VecU32_push(pending_imports, target_fid)
                    n_i = n_i + 1
                }
                VecU32_destroy(&imported_names)
                cursor = scan + 1
                cont
            }
            VecU32_destroy(&imported_names)
        } else if (depth == 0) and (tk == t.ident) {
            if (cursor + 1) < end_tok {
                next_tk := TokenStream_kind(&(*db).tokens, cursor + 1)
                if next_tk == t.colon_colon {
                    if (cursor + 2) < end_tok {
                        c2_text := TokenStream_text(&(*db).tokens, cursor + 2)
                        if str_eq(c2_text, Str_from("import")) {
                            if has_sym {
                                Nexus_alloc_symbol(db, file_id, curr_sym_name, curr_sym_tok, cursor)
                                has_sym = false
                            }

                            loc_str := TokenStream_text(&(*db).tokens, cursor)
                            loc_name := Interner_intern(&(*db).interner, loc_str)

                            rem_str := TokenStream_text(&(*db).tokens, cursor + 3)
                            rem_name := Interner_intern(&(*db).interner, rem_str)

                            raw_path := TokenStream_text(&(*db).tokens, cursor + 5)
                            path_str := trim_quotes(raw_path)

                            target_fid := resolve_and_load_file(
                                db, arena, curr_path, path_str,
                                loaded_paths, queue_fids, queue_tok_start, queue_tok_end
                            )

                            VecU32_push(pending_imports, file_id)
                            VecU32_push(pending_imports, loc_name)
                            VecU32_push(pending_imports, rem_name)
                            VecU32_push(pending_imports, target_fid)

                            cursor = cursor + 6
                            cont
                        }
                    }

                    if has_sym {
                        Nexus_alloc_symbol(db, file_id, curr_sym_name, curr_sym_tok, cursor)
                    }

                    text := TokenStream_text(&(*db).tokens, cursor)
                    curr_sym_name = Interner_intern(&(*db).interner, text)
                    curr_sym_tok  = cursor
                    has_sym = true

                    cursor = cursor + 1
                }
            }
        }

        cursor = cursor + 1
    }

    if has_sym {
        Nexus_alloc_symbol(db, file_id, curr_sym_name, curr_sym_tok, end_tok)
    }
}

index_file :: (db &Nexus, arena &Arena, root_fid u32, root_path Str, start_tok u32, end_tok u32) {
    loaded_paths    := VecU32_new()
    queue_fids      := VecU32_new()
    queue_tok_start := VecU32_new()
    queue_tok_end   := VecU32_new()
    pending_imports := VecU32_new()

    root_path_id := Interner_intern(&(*db).interner, root_path)
    VecU32_push(&loaded_paths, root_path_id)

    VecU32_push(&queue_fids, root_fid)
    VecU32_push(&queue_tok_start, start_tok)
    VecU32_push(&queue_tok_end, end_tok)

    q_head: u64 = 0
    while q_head < queue_fids.len {
        fid   := VecU32_get(&queue_fids, q_head)
        s_tok := VecU32_get(&queue_tok_start, q_head)
        e_tok := VecU32_get(&queue_tok_end, q_head)

        path_id := VecU32_get(&loaded_paths, fid as u64)
        c_path  := Interner_get(&(*db).interner, path_id)

        scan_file_symbols(
            db, arena, fid, c_path, s_tok, e_tok,
            &loaded_paths, &queue_fids, &queue_tok_start, &queue_tok_end,
            &pending_imports
        )

        q_head = q_head + 1
    }

    changed := true
    while changed {
        changed = false
        p_i: u64 = 0
        while p_i < pending_imports.len {
            src_fid := VecU32_get(&pending_imports, p_i)
            if src_fid != id_none() {
                loc_name := VecU32_get(&pending_imports, p_i + 1)
                imp_name := VecU32_get(&pending_imports, p_i + 2)
                tgt_fid  := VecU32_get(&pending_imports, p_i + 3)

                target_sym := Nexus_find_symbol(db, tgt_fid, imp_name)
                if target_sym != id_none() {
                    Nexus_alloc_symbol_alias(db, src_fid, loc_name, target_sym)
                    VecU32_set(&pending_imports, p_i, id_none())
                    changed = true
                }
            }
            p_i = p_i + 4
        }
    }

    VecU32_destroy(&loaded_paths)
    VecU32_destroy(&queue_fids)
    VecU32_destroy(&queue_tok_start)
    VecU32_destroy(&queue_tok_end)
    VecU32_destroy(&pending_imports)
}
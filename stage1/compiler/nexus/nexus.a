import VecU32, VecU32_new, VecU32_extend, VecU32_len, VecU32_push from "../../../std/vec/u32.a"
import SliceU32 from "../../../std/slice/u32.a"

print_u64 :: (v u64) unit

Nexus :: struct {
    glob_stack : VecU32
    u32_items  : VecU32
}

Nexus_new :: () Nexus {
    .{
        glob_stack : VecU32_new(),
        u32_items  : VecU32_new()
    }
}

Nexus_add_list :: (self &Nexus, items SliceU32) {
    list := &(*self).u32_items
    start := VecU32_len(list)
    VecU32_push(list, items.len as u32)
    VecU32_extend(list, items.ptr, items.len)
}

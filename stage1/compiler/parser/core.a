import token, token_name, TokenType, TokenStream, TokenStream_kind, TokenStream_text,
       TokenStream_start, TokenStream_len, TokenStream_newline_before from "../token.a"
import HirTable from "../hir.a"
import Str, Str_empty, Str_print from "../../../std/string.a"
import Nexus, Nexus_find_symbol, Nexus_get_file_path, Nexus_get_file_source,
       calc_pos, Span, Pos, span_new, span_merge from "../nexus/nexus.a"
import ScopeEnv, ScopeEnv_new, ScopeEnv_destroy, ScopeEnv_lookup from "env.a"
import id_none from "../nexus/pool.a"
import fall from "../../../std/sys.a"


print     :: (s &u8) unit
print_u32 :: (v u32) unit

Parser :: struct {
    db        : &Nexus,
    tokens    : &TokenStream,
    hir       : &HirTable,
    cursor    : u32,
    end       : u32,
    file_id   : u32,
    toplv_sym : u32,
    env       : ScopeEnv,
    allow_fn  : bool
}

Parser_new :: (db &Nexus, tokens &TokenStream, hir &HirTable, file_id u32, toplv_sym u32, start u32, count u32) Parser {
    .{
        db        : db,
        tokens    : tokens,
        hir       : hir,
        cursor    : start,
        end       : start + count,
        file_id   : file_id,
        toplv_sym : toplv_sym,
        env       : ScopeEnv_new(),
        allow_fn  : true
    }
}

lookup_sym :: (p &Parser, name_id u32) u32 {
    sym := ScopeEnv_lookup(&(*p).env, name_id)
    if sym != id_none() {
        ret sym
    }

    Nexus_find_symbol((*p).db, (*p).file_id, name_id)
}

is_eof :: (p &Parser) bool {
    (*p).cursor >= (*p).end
}

peek :: (p &Parser) u8 {
    if (*p).cursor >= (*p).end {
        ret token().eof
    }
    TokenStream_kind((*p).tokens, (*p).cursor)
}

peek_n :: (p &Parser, n u32) u8 {
    target := (*p).cursor + n
    if target >= (*p).end {
        ret token().eof
    }
    TokenStream_kind((*p).tokens, target)
}

bump :: (p &Parser) u32 {
    c := (*p).cursor
    if (*p).cursor < (*p).end {
        (*p).cursor = (*p).cursor + 1
    }
    c
}

optional :: (p &Parser, kind u8) bool {
    if peek(p) == kind {
        bump(p)
        ret true
    }
    false
}

expect :: (p &Parser, kind u8) bool {
    if peek(p) == kind {
        bump(p)
        ret true
    }
    false
}

peek_preceded_by_newline :: (p &Parser) bool {
    if (*p).cursor >= (*p).end {
        ret false
    }
    TokenStream_newline_before((*p).tokens, (*p).cursor)
}

curr_text :: (p &Parser) Str {
    if (*p).cursor >= (*p).end {
        ret Str_empty()
    }
    TokenStream_text((*p).tokens, (*p).cursor)
}

prev_text :: (p &Parser) Str {
    if (*p).cursor == 0 {
        ret Str_empty()
    }
    TokenStream_text((*p).tokens, (*p).cursor - 1)
}

str_to_u32 :: (s Str) u32 {
    res: u32 = 0
    i: u64 = 0
    while i < s.len {
        c := *(s.ptr + i)
        if c >= 48 and c <= 57 {
            res = (res * 10) + ((c - 48) as u32)
        }
        i = i + 1
    }
    res
}

tok_span :: (p &Parser, idx u32) Span {
    if idx >= (*p).end {
        if (*p).end > 0 {
            last := (*p).end - 1
            st := TokenStream_start((*p).tokens, last)
            ln := TokenStream_len((*p).tokens, last)
            ret span_new(st + ln, st + ln)
        }
        ret span_new(0, 0)
    }
    st := TokenStream_start((*p).tokens, idx)
    ln := TokenStream_len((*p).tokens, idx)
    span_new(st, st + ln)
}

curr_span :: (p &Parser) Span {
    tok_span(p, (*p).cursor)
}

prev_span :: (p &Parser) Span {
    if (*p).cursor == 0 { ret span_new(0, 0) }
    tok_span(p, (*p).cursor - 1)
}

parse_error_at :: (p &Parser, msg &u8, sp Span) {
    path := Nexus_get_file_path((*p).db, (*p).file_id)
    src := Nexus_get_file_source((*p).db, (*p).file_id)
    pos := calc_pos(src, sp.start)

    print("\n\033[1;31m[syntax error]\033[0m ")
    print(msg)
    print("\n       --> ")
    print(path.ptr)
    print(":")
    print_u32(pos.line)
    print(":")
    print_u32(pos.col)
    print("\n\n")
    fall()
}

expect :: (p &Parser, kind u8) {
    if peek(p) == kind {
        bump(p)
        ret
    }

    sp := curr_span(p)
    path := Nexus_get_file_path((*p).db, (*p).file_id)
    src := Nexus_get_file_source((*p).db, (*p).file_id)
    pos := calc_pos(src, sp.start)

    print("\n\033[1;31m[syntax error]\033[0m expected '")
    exp_name := token_name(kind)
    Str_print(exp_name)
    print("', but found '")
    got_name := token_name(peek(p))
    Str_print(got_name)
    if peek(p) != token().eof {
        print("' (")
        txt := curr_text(p)
        Str_print(txt)
        print(")")
    } else {
        print("'")
    }
    print("\n       --> ")
    print(path.ptr)
    print(":")
    print_u32(pos.line)
    print(":")
    print_u32(pos.col)
    print("\n\n")
    fall()
}
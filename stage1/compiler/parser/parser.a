import token from "../token.a"
import hir_kind, HirTable, HirTable_push, HirTable_lhs, HirTable_rhs, hir_none from "../hir.a"

import Parser, Parser_new, is_eof, peek, bump, expect, optional,
       peek_preceded_by_newline, curr_text, prev_text, str_to_u32, lookup_sym from "core.a"
import ScopeEnv_mark, ScopeEnv_reset, ScopeEnv_define from "env.a"
import is_soft, bp_from_infix, prec from "prec.a"

import VecU32_mark, VecU32_reset, VecU32_push, VecU32_new, VecU32_as_slice, VecU32_ptr_at, VecU32_len from "../../../std/vec/u32.a"
import SliceU32 from "../../../std/slice/u32.a"
import Interner_intern from "../../../std/interner.a"

import Nexus_add_list, Nexus_get_list, Nexus_alloc_local_symbol,
       Nexus_set_sym_hir, Nexus_get_sym_hir, Nexus_set_hir_symbol from "../nexus/nexus.a"
import id_none from "../nexus/pool.a"

print :: (s &u8) unit
print_u32 :: (v u32) unit

--- Pratt Engine ---------------------------------------------------------------------------------

parse_expr :: (p &Parser, min_bp u8) u32 {
    lhs := dispatch_prefix(p)

    while not is_eof(p) {
        tk := peek(p)

        if peek_preceded_by_newline(p) and (not is_soft(tk)) {
            break
        }

        bp := bp_from_infix(tk)
        if (not bp.is_some) or (bp.left < min_bp) {
            break
        }

        bump(p) 
        lhs = dispatch_infix(p, tk, lhs, bp.right)
    }

    lhs
}

--- Dispatch Layer -------------------------------------------------------------------------------

dispatch_prefix :: (p &Parser) u32 {
    t := token()
    tk := peek(p)

    if tk == t.lit_int { ret parse_lit_int(p) }
    if tk == t.ident   { ret parse_ident(p) }
    if tk == t.o_paren { ret parse_paren(p) }
    if tk == t.o_brace { ret parse_block(p) }

    if tk == t.minus or tk == t.kw_not or tk == t.tilde {
        ret parse_unary(p, tk)
    }

    bump(p)
    HirTable_push((*p).hir, hir_kind().error, hir_none(), hir_none(), hir_none())
}

dispatch_infix :: (p &Parser, op u8, lhs u32, right_bp u8) u32 {
    t := token()

    if op == t.colon_colon { ret parse_binding(p, lhs, right_bp) }
    if op == t.colon       { ret parse_var_decl(p, lhs, right_bp) }
    if op == t.eq          { ret parse_assign(p, lhs, right_bp) }

    if op == t.plus or op == t.minus or op == t.star or op == t.slash or op == t.percent {
        ret parse_binary(p, op, lhs, right_bp)
    }

    HirTable_push((*p).hir, hir_kind().error, hir_none(), hir_none(), hir_none())
}

--- Prefix Handlers ------------------------------------------------------------------------------

parse_lit_int :: (p &Parser) u32 {
    k := hir_kind()
    val := str_to_u32(curr_text(p))
    bump(p)
    HirTable_push((*p).hir, k.lit_int, val, hir_none(), hir_none())
}

parse_ident :: (p &Parser) u32 {
    k := hir_kind()
    name := curr_text(p)
    name_id := Interner_intern(&(*(*p).db).interner, name)
    bump(p)

    ident_hir := HirTable_push((*p).hir, k.ident, name_id, hir_none(), hir_none())

    sym_id := lookup_sym(p, name_id)
    if sym_id != id_none() {
        Nexus_set_hir_symbol((*p).db, ident_hir, sym_id)
    }

    ident_hir
}

parse_paren :: (p &Parser) u32 {
    t := token()
    k := hir_kind()
    bump(p) -- '('

    if optional(p, t.c_paren) {
        if peek(p) == t.o_brace {
            body := parse_block(p)
            ret HirTable_push((*p).hir, k.function, hir_none(), hir_none(), body)
        }
        ret hir_none()
    }

    expr := parse_expr(p, 0 as u8)
    expect(p, t.c_paren)
    expr
}

parse_block :: (p &Parser) u32 {
    k := hir_kind()
    t := token()

    db := &(*(*p).db)
    glob_stack := &(*db).glob_stack

    mark := VecU32_mark(glob_stack)
    env_mark := ScopeEnv_mark(&(*p).env) 

    bump(p) -- {

    while true {
        peek_tk := peek(p)

        if peek_tk == t.c_brace {
            bump(p)
            break
        }

        if peek_tk == t.eof {
            break
        }

        VecU32_push(glob_stack, parse_expr(p, 0))
    }

    slice: SliceU32 = .{
        ptr: VecU32_ptr_at(glob_stack, mark),
        len: VecU32_len(glob_stack) - mark
    }

    list_id := Nexus_add_list(db, slice)

    VecU32_reset(glob_stack, mark)
    ScopeEnv_reset(&(*p).env, env_mark) 

    HirTable_push((*p).hir, k.block, list_id, hir_none(), hir_none())
}

parse_unary :: (p &Parser, op u8) u32 {
    t := token()
    k := hir_kind()
    bump(p)

    body := parse_expr(p, prec().unary)

    op_kind := k.empty
    if op == t.minus  { op_kind = k.unary_neg }
    if op == t.kw_not { op_kind = k.unary_not }
    if op == t.tilde  { op_kind = k.unary_bit_not }

    HirTable_push((*p).hir, op_kind, body, hir_none(), hir_none())
}

--- Infix Handlers -------------------------------------------------------------------------------

parse_binary :: (p &Parser, op u8, lhs u32, right_bp u8) u32 {
    t := token()
    k := hir_kind()

    rhs := parse_expr(p, right_bp)

    op_kind := k.empty
    if op == t.plus    { op_kind = k.binary_add }
    if op == t.minus   { op_kind = k.binary_sub }
    if op == t.star    { op_kind = k.binary_mul }
    if op == t.slash   { op_kind = k.binary_div }
    if op == t.percent { op_kind = k.binary_mod }

    HirTable_push((*p).hir, op_kind, lhs, rhs, hir_none())
}

parse_binding :: (p &Parser, lhs u32, right_bp u8) u32 {
    k := hir_kind()

    name_id := HirTable_lhs((*p).hir, lhs)
    sym_id := lookup_sym(p, name_id)

    if sym_id != id_none() {
        curr_hir := Nexus_get_sym_hir((*p).db, sym_id)
        if curr_hir == id_none() {
            Nexus_set_sym_hir((*p).db, sym_id, lhs)
        }
        Nexus_set_hir_symbol((*p).db, lhs, sym_id)
    }

    rhs := parse_expr(p, right_bp)
    binding_id := HirTable_push((*p).hir, k.binding, lhs, hir_none(), rhs)

    if sym_id != id_none() {
        Nexus_set_hir_symbol((*p).db, binding_id, sym_id)
    }

    binding_id
}

parse_var_decl :: (p &Parser, lhs u32, right_bp u8) u32 {
    t := token()
    k := hir_kind()

    name_id := HirTable_lhs((*p).hir, lhs)

    sym_id := Nexus_alloc_local_symbol((*p).db, (*p).file_id, name_id, lhs)
    ScopeEnv_define(&(*p).env, name_id, sym_id)

    if optional(p, t.eq) {
        val := parse_expr(p, 0 as u8)
        var_id := HirTable_push((*p).hir, k.var, lhs, hir_none(), val)

        Nexus_set_hir_symbol((*p).db, var_id, sym_id)
        ret var_id
    }

    ty := parse_expr(p, prec().var_def + (1 as u8))

    if optional(p, t.eq) {
        val := parse_expr(p, 0 as u8)
        var_id := HirTable_push((*p).hir, k.var, lhs, ty, val)

        Nexus_set_hir_symbol((*p).db, var_id, sym_id)
        ret var_id
    }

    if optional(p, t.colon) {
        val := parse_expr(p, 0 as u8)
        binding_id := HirTable_push((*p).hir, k.binding, lhs, ty, val)

        Nexus_set_hir_symbol((*p).db, binding_id, sym_id)
        ret binding_id
    }

    var_id := HirTable_push((*p).hir, k.var, lhs, ty, hir_none())
    Nexus_set_hir_symbol((*p).db, var_id, sym_id)
    var_id
}

parse_assign :: (p &Parser, lhs u32, right_bp u8) u32 {
    k := hir_kind()
    rhs := parse_expr(p, right_bp)
    HirTable_push((*p).hir, k.binary_assign, lhs, rhs, hir_none())
}
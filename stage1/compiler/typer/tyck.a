import Nexus, Nexus_get_list, Nexus_get_hir_symbol, Nexus_get_sym_hir,
       Nexus_set_const_type, Nexus_get_const_type from "../nexus/nexus.a"
import HirTable, HirTable_kind, HirTable_lhs, HirTable_rhs, HirTable_extra, hir_kind, hir_none from "../hir.a"
import Str, Str_from, Str_print from "../../../std/string.a"
import SliceU32 from "../../../std/slice/u32.a"
import VecU32, VecU32_new, VecU32_destroy, VecU32_push, VecU32_ptr_at from "../../../std/vec/u32.a"

import TypeStorage, ty_kind, ty_id_none, ty_id_type, ty_id_unit, ty_id_untyped_int, ty_id_unknown,ty_id_never, ty_id_untyped_float, ty_id_bool,
       TypeStorage_alloc_bool, TypeStorage_alloc_unit, TypeStorage_alloc_int,
       TypeStorage_alloc_uint, TypeStorage_alloc_float, TypeStorage_alloc_func, TypeStorage_payload,
       TypeStorage_func_return, TypeStorage_func_params, TypeStorage_kind, TypeStorage_alloc_ptr from "../types.a"

import UnifyStorage, UnifyStorage_new_slot, UnifyStorage_get_slot, UnifyStorage_resolve_type_deep, UnifyStorage_tmp_slot,
       UnifyStorage_bind_type, UnifyStorage_union, UnifyStorage_resolve_type, slot_none from "../unify.a"
import Interner_get from "../../../std/interner.a"
import id_none from "../nexus/pool.a"

import Engine, Engine_slot_of from "../engine.a"

print :: (s &u8) unit
print_u32 :: (v u32) unit

str_eq :: (a Str, b Str) bool {
    if a.len != b.len { ret false }
    i: u64 = 0
    while i < a.len {
        if *(a.ptr + i) != *(b.ptr + i) { ret false }
        i = i + 1
    }
    true
}

parse_builtin_type :: (types &TypeStorage, name Str) u32 {
    if str_eq(name, Str_from("bool")) { ret TypeStorage_alloc_bool() }
    if str_eq(name, Str_from("unit")) { ret TypeStorage_alloc_unit() }

    if name.len < 2 { ret ty_id_none() }

    first := *(name.ptr)
    if (first != 105) and (first != 117) and (first != 102) { -- 'i', 'u', 'f'
        ret ty_id_none()
    }

    bits: u32 = 0
    i: u64 = 1
    while i < name.len {
        c := *(name.ptr + i)
        if (c < 48) or (c > 57) { ret ty_id_none() }
        bits = (bits * 10) + ((c - 48) as u32)
        i = i + 1
    }

    if (bits != 8) and (bits != 16) and (bits != 32) and (bits != 64) and (bits != 128) {
        ret ty_id_none()
    }

    if first == 105 { ret TypeStorage_alloc_int(types, bits as u16) }
    if first == 117 { ret TypeStorage_alloc_uint(types, bits as u16) }
    if first == 102 { ret TypeStorage_alloc_float(types, bits as u16) }

    ty_id_none()
}

type_check :: (eng &Engine, start u32, len u32) {
   

    db := &(*eng).nexus
    tbl := &(*db).hir
    k := hir_kind()

    fn_ret_slot := slot_none()
    if len > 0 {
        last_id := len - 1
        if HirTable_kind(tbl, last_id) == k.binding {
            func_id := HirTable_extra(tbl, last_id)
            if (func_id != hir_none()) and (HirTable_kind(tbl, func_id) == k.function) {
                fn_ret_slot = UnifyStorage_tmp_slot(&(*db).unify)
                ret_hir_id := HirTable_rhs(tbl, func_id)
                if ret_hir_id != hir_none() {
                    ret_val := Nexus_get_const_type(db, ret_hir_id)
                    if ret_val != ty_id_none() {
                        UnifyStorage_bind_type(&(*db).unify, &(*db).types, fn_ret_slot, ret_val)
                    }
                } else {
                    UnifyStorage_bind_type(&(*db).unify, &(*db).types, fn_ret_slot, ty_id_unit())
                }
            }
        }
    }

    i := start
    while i < len {
        synth_node(eng, i, fn_ret_slot)
        i = i + 1
    }
}

synth_node :: (eng &Engine, id u32, fn_ret_slot u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    k := hir_kind()
    curr := HirTable_kind(tbl, id)

    if curr == k.lit_int       { synth_lit_int(db, tbl, id) }
    if curr == k.ident         { synth_ident(eng, id) }
    if curr == k.var           { synth_var_or_binding(db, tbl, id) }
    if curr == k.binding       { synth_var_or_binding(db, tbl, id) }
    if curr == k.arg           { synth_arg(db, tbl, id) }
    if curr == k.function      { synth_func(db, tbl, id, fn_ret_slot) }
    if curr == k.k_ret         { synth_return(db, tbl, id, fn_ret_slot) }
    if curr == k.call          { synth_call(db, tbl, id) }
    if curr == k.block         { synth_block(db, tbl, id) }
    if curr == k.binary_add    { synth_binary(db, tbl, id) }
    if curr == k.binary_assign { synth_assign(db, tbl, id) }

    if curr == k.lit_float      { synth_lit_float(db, tbl, id) }
    if (curr == k.lit_bool_true) or (curr == k.lit_bool_false) { synth_lit_bool(db, tbl, id) }
    if curr == k.lit_str        { synth_lit_str(db, tbl, id) }

    if (curr == k.unary_neg) or (curr == k.unary_bit_not) { synth_unary_num(db, tbl, id) }
    if curr == k.unary_not      { synth_unary_not(db, tbl, id) }
    if curr == k.unary_addr_of  { synth_unary_addr_of(db, tbl, id) }
    if curr == k.unary_deref    { synth_unary_deref(db, tbl, id) }
    if (curr == k.k_break) or (curr == k.k_cont) { synth_break_cont(db, tbl, id) }

    if curr == k.k_if           { synth_if(db, tbl, id) }
    if curr == k.k_while        { synth_while(db, tbl, id) }

    if curr == k.cast           { synth_cast(db, tbl, id) }
    if (curr == k.binary_and) or (curr == k.binary_or) { synth_logic_and_or(db, tbl, id) }
    if (curr == k.binary_eq_eq) or (curr == k.binary_neq) or
       (curr == k.binary_lt) or (curr == k.binary_lt_eq) or
       (curr == k.binary_gt) or (curr == k.binary_gt_eq) {
        synth_binary_comp(db, tbl, id)
    }

}

synth_lit_int :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)
    UnifyStorage_bind_type(unify_ptr, types_ptr, slot, ty_id_untyped_int())
}

synth_ident :: (eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    name_id := HirTable_lhs(tbl, id)
    name := Interner_get(&(*db).interner, name_id)

    slot := UnifyStorage_get_slot(unify_ptr, id)
    if slot == slot_none() {
        slot = UnifyStorage_new_slot(unify_ptr, id)
    }

    builtin_ty := parse_builtin_type(types_ptr, name)
    if builtin_ty != ty_id_none() {
        UnifyStorage_bind_type(unify_ptr, types_ptr, slot, ty_id_type())
        Nexus_set_const_type(db, id, builtin_ty)
        ret
    }

    sym_id := Nexus_get_hir_symbol(db, id)
    if sym_id != id_none() {
        origin_hir := Nexus_get_sym_hir(db, sym_id)
        if origin_hir == id {
            ret
        }

        origin_slot := Engine_slot_of(eng, sym_id)
        if origin_slot != slot_none() {
            UnifyStorage_union(unify_ptr, types_ptr, slot, origin_slot)
        }

        if origin_hir != id_none() {
            const_val := Nexus_get_const_type(db, origin_hir)
            if const_val != ty_id_none() {
                Nexus_set_const_type(db, id, const_val)
            }
        }
    }
}

synth_var_or_binding :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    ident_id := HirTable_lhs(tbl, id)
    type_id  := HirTable_rhs(tbl, id)
    value_id := HirTable_extra(tbl, id)

    slot := UnifyStorage_new_slot(unify_ptr, id)

    ident_slot := UnifyStorage_get_slot(unify_ptr, ident_id)
    if ident_slot == slot_none() {
        ident_slot = UnifyStorage_new_slot(unify_ptr, ident_id)
    }

    if type_id != hir_none() {
        type_slot := UnifyStorage_get_slot(unify_ptr, type_id)
        if type_slot != slot_none() {
            UnifyStorage_bind_type(unify_ptr, types_ptr, type_slot, ty_id_type())
        }

        type_value := Nexus_get_const_type(db, type_id)
        if type_value != ty_id_none() {
            UnifyStorage_bind_type(unify_ptr, types_ptr, ident_slot, type_value)
            Nexus_set_const_type(db, ident_id, type_value)
            Nexus_set_const_type(db, id, type_value)
        }
    }

    if value_id != hir_none() {
        val_slot := UnifyStorage_get_slot(unify_ptr, value_id)
        if val_slot != slot_none() {
            val_ty := UnifyStorage_resolve_type(unify_ptr, val_slot)
            if TypeStorage_kind(types_ptr, val_ty) == ty_kind().type_ {
                type_val := Nexus_get_const_type(db, value_id)
                Nexus_set_const_type(db, ident_id, type_val)
                Nexus_set_const_type(db, id, type_val)
            }

            UnifyStorage_union(unify_ptr, types_ptr, ident_slot, val_slot)
        }
    }

    UnifyStorage_union(unify_ptr, types_ptr, slot, ident_slot)
}

synth_arg :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    ident_id := HirTable_lhs(tbl, id)
    ty_id    := HirTable_rhs(tbl, id)

    ident_slot := UnifyStorage_get_slot(unify_ptr, ident_id)
    if ident_slot == slot_none() {
        ident_slot = UnifyStorage_new_slot(unify_ptr, ident_id)
    }

    if ty_id != hir_none() {
        type_val := Nexus_get_const_type(db, ty_id)
        if type_val != ty_id_none() {
            UnifyStorage_bind_type(unify_ptr, types_ptr, ident_slot, type_val)
            Nexus_set_const_type(db, ident_id, type_val)
            Nexus_set_const_type(db, id, type_val)
        }
    }
}

synth_func :: (db &Nexus, tbl &HirTable, id u32, fn_ret_slot u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)

    params_list_id := HirTable_lhs(tbl, id)
    ret_hir_id     := HirTable_rhs(tbl, id)
    body_id        := HirTable_extra(tbl, id)

    is_extern := body_id == hir_none()

    ret_ty := ty_id_unit()
    if fn_ret_slot != slot_none() {
        resolved := UnifyStorage_resolve_type(unify_ptr, fn_ret_slot)
        if resolved != ty_id_none() {
            ret_ty = resolved
        }
    } else if ret_hir_id != hir_none() {
        val := Nexus_get_const_type(db, ret_hir_id)
        if val != ty_id_none() {
            ret_ty = val
        }
    }

    params_vec := VecU32_new()
    if params_list_id != hir_none() {
        args := Nexus_get_list(db, params_list_id)
        i: u64 = 0
        while i < args.len {
            arg_id := *(args.ptr + i)
            ty_node := HirTable_rhs(tbl, arg_id)
            param_ty := Nexus_get_const_type(db, ty_node)

            if param_ty == ty_id_none() {
                arg_ident := HirTable_lhs(tbl, arg_id)
                arg_slot := UnifyStorage_get_slot(unify_ptr, arg_ident)
                if arg_slot != slot_none() {
                    param_ty = UnifyStorage_resolve_type(unify_ptr, arg_slot)
                }
            }

            if param_ty == ty_id_none() {
                param_ty = ty_id_unknown()
            }

            VecU32_push(&params_vec, param_ty)
            i = i + 1
        }
    }

    slice: SliceU32 = .{ ptr: 0 as &u32, len: 0 }
    if params_vec.len > 0 {
        slice.ptr = VecU32_ptr_at(&params_vec, 0)
        slice.len = params_vec.len
    }

    func_ty := TypeStorage_alloc_func(types_ptr, slice, ret_ty, is_extern)
    VecU32_destroy(&params_vec)

    UnifyStorage_bind_type(unify_ptr, types_ptr, slot, func_ty)

    if (not is_extern) and (body_id != hir_none()) {
        body_slot := UnifyStorage_get_slot(unify_ptr, body_id)
        if body_slot != slot_none() {
            UnifyStorage_bind_type(unify_ptr, types_ptr, body_slot, ret_ty)
        }
    }
}

synth_return :: (db &Nexus, tbl &HirTable, id u32, fn_ret_slot u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)
    UnifyStorage_bind_type(unify_ptr, types_ptr, slot, ty_id_never())

    val_id := HirTable_lhs(tbl, id)
    if val_id != hir_none() {
        val_slot := UnifyStorage_get_slot(unify_ptr, val_id)
        if (val_slot != slot_none()) and (fn_ret_slot != slot_none()) {
            UnifyStorage_union(unify_ptr, types_ptr, val_slot, fn_ret_slot)
        }
    } else {
        if fn_ret_slot != slot_none() {
            unit_slot := UnifyStorage_tmp_slot(unify_ptr)
            UnifyStorage_bind_type(unify_ptr, types_ptr, unit_slot, ty_id_unit())
            UnifyStorage_union(unify_ptr, types_ptr, unit_slot, fn_ret_slot)
        }
    }
}

synth_call :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)

    callee := HirTable_lhs(tbl, id)
    callee_slot := UnifyStorage_get_slot(unify_ptr, callee)

    if callee_slot != slot_none() {
        callee_ty := UnifyStorage_resolve_type(unify_ptr, callee_slot)
        if TypeStorage_kind(types_ptr, callee_ty) == ty_kind().func {
            ret_ty := TypeStorage_func_return(types_ptr, callee_ty)
            UnifyStorage_bind_type(unify_ptr, types_ptr, slot, ret_ty)

            args_list_id := HirTable_rhs(tbl, id)
            if args_list_id != hir_none() {
                args := Nexus_get_list(db, args_list_id)
                params := TypeStorage_func_params(types_ptr, callee_ty)

                i: u64 = 0
                while (i < args.len) and (i < params.len) {
                    arg_node := *(args.ptr + i)
                    arg_slot := UnifyStorage_get_slot(unify_ptr, arg_node)
                    param_ty := *(params.ptr + i)

                    if arg_slot != slot_none() {
                        UnifyStorage_bind_type(unify_ptr, types_ptr, arg_slot, param_ty)
                    }
                    i = i + 1
                }
            }
        }
    }
}

synth_block :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)
    list_id := HirTable_lhs(tbl, id)
    items := Nexus_get_list(db, list_id)

    if items.len > 0 {
        last_id := *(items.ptr + items.len - 1)
        last_slot := UnifyStorage_get_slot(unify_ptr, last_id)
        if last_slot != slot_none() {
            UnifyStorage_union(unify_ptr, types_ptr, slot, last_slot)
        }
    } else {
        UnifyStorage_bind_type(unify_ptr, types_ptr, slot, ty_id_unit())
    }
}

synth_binary :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)
    lhs := HirTable_lhs(tbl, id)
    rhs := HirTable_rhs(tbl, id)

    lhs_slot := UnifyStorage_get_slot(unify_ptr, lhs)
    rhs_slot := UnifyStorage_get_slot(unify_ptr, rhs)

    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        UnifyStorage_union(unify_ptr, types_ptr, lhs_slot, rhs_slot)
        UnifyStorage_union(unify_ptr, types_ptr, slot, lhs_slot)
    }
}

synth_assign :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)
    lhs := HirTable_lhs(tbl, id)
    rhs := HirTable_rhs(tbl, id)

    lhs_slot := UnifyStorage_get_slot(unify_ptr, lhs)
    rhs_slot := UnifyStorage_get_slot(unify_ptr, rhs)

    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        UnifyStorage_union(unify_ptr, types_ptr, lhs_slot, rhs_slot)
    }
    UnifyStorage_bind_type(unify_ptr, types_ptr, slot, ty_id_unit())
}

synth_lit_float :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, ty_id_untyped_float())
}

synth_lit_bool :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, ty_id_bool())
}

synth_lit_str :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    u8_ty := TypeStorage_alloc_uint(&(*db).types, 8 as u16)
    ptr_ty := TypeStorage_alloc_ptr(&(*db).types, u8_ty)
    UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, ptr_ty)
}

synth_unary_num :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    child := HirTable_lhs(tbl, id)
    child_slot := UnifyStorage_get_slot(&(*db).unify, child)
    if child_slot != slot_none() {
        UnifyStorage_union(&(*db).unify, &(*db).types, slot, child_slot)
    }
}

synth_unary_not :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    child := HirTable_lhs(tbl, id)
    child_slot := UnifyStorage_get_slot(&(*db).unify, child)
    if child_slot != slot_none() {
        UnifyStorage_bind_type(&(*db).unify, &(*db).types, child_slot, ty_id_bool())
    }
    UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, ty_id_bool())
}

synth_unary_addr_of :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    child := HirTable_lhs(tbl, id)
    child_slot := UnifyStorage_get_slot(&(*db).unify, child)

    if child_slot != slot_none() {
        child_ty := UnifyStorage_resolve_type(&(*db).unify, child_slot)
        if TypeStorage_kind(&(*db).types, child_ty) == ty_kind().type_ {
            UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, ty_id_type())
            val := Nexus_get_const_type(db, child)
            ptr_val := TypeStorage_alloc_ptr(&(*db).types, val)
            Nexus_set_const_type(db, id, ptr_val)
            ret
        }

        ptr_ty := TypeStorage_alloc_ptr(&(*db).types, child_ty)
        UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, ptr_ty)
    }
}

synth_unary_deref :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    child := HirTable_lhs(tbl, id)
    child_slot := UnifyStorage_get_slot(&(*db).unify, child)

    if child_slot != slot_none() {
        child_ty := UnifyStorage_resolve_type_deep(&(*db).unify, &(*db).types, child_slot)
        if TypeStorage_kind(&(*db).types, child_ty) == ty_kind().ptr {
            inner_ty := TypeStorage_payload(&(*db).types, child_ty)
            UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, inner_ty)
        }
    }
}

synth_break_cont :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, ty_id_unit())
}

synth_if :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    cond := HirTable_lhs(tbl, id)
    thenb := HirTable_rhs(tbl, id)
    elseb := HirTable_extra(tbl, id)

    cond_slot := UnifyStorage_get_slot(&(*db).unify, cond)
    if cond_slot != slot_none() {
        UnifyStorage_bind_type(&(*db).unify, &(*db).types, cond_slot, ty_id_bool())
    }

    then_slot := UnifyStorage_get_slot(&(*db).unify, thenb)
    if then_slot != slot_none() {
        UnifyStorage_union(&(*db).unify, &(*db).types, slot, then_slot)
    }

    if elseb != hir_none() {
        else_slot := UnifyStorage_get_slot(&(*db).unify, elseb)
        if else_slot != slot_none() {
            UnifyStorage_union(&(*db).unify, &(*db).types, slot, else_slot)
        }
    } else {
        UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, ty_id_unit())
    }
}

synth_while :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    cond := HirTable_lhs(tbl, id)
    cond_slot := UnifyStorage_get_slot(&(*db).unify, cond)
    if cond_slot != slot_none() {
        UnifyStorage_bind_type(&(*db).unify, &(*db).types, cond_slot, ty_id_bool())
    }
    UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, ty_id_unit())
}

synth_binary_comp :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    lhs := HirTable_lhs(tbl, id)
    rhs := HirTable_rhs(tbl, id)

    lhs_slot := UnifyStorage_get_slot(&(*db).unify, lhs)
    rhs_slot := UnifyStorage_get_slot(&(*db).unify, rhs)

    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        UnifyStorage_union(&(*db).unify, &(*db).types, lhs_slot, rhs_slot)
    }
    UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, ty_id_bool())
}

synth_logic_and_or :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    lhs := HirTable_lhs(tbl, id)
    rhs := HirTable_rhs(tbl, id)

    lhs_slot := UnifyStorage_get_slot(&(*db).unify, lhs)
    rhs_slot := UnifyStorage_get_slot(&(*db).unify, rhs)

    if lhs_slot != slot_none() {
        UnifyStorage_bind_type(&(*db).unify, &(*db).types, lhs_slot, ty_id_bool())
    }
    if rhs_slot != slot_none() {
        UnifyStorage_bind_type(&(*db).unify, &(*db).types, rhs_slot, ty_id_bool())
    }
    UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, ty_id_bool())
}

synth_cast :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    rhs := HirTable_rhs(tbl, id)
    rhs_type := Nexus_get_const_type(db, rhs)
    if rhs_type != ty_id_none() {
        UnifyStorage_bind_type(&(*db).unify, &(*db).types, slot, rhs_type)
    }
}
import Nexus, Nexus_get_list, Nexus_get_hir_symbol, Nexus_get_sym_hir,
       Nexus_set_const_type, Nexus_get_const_type, Nexus_print_loc from "../nexus/nexus.a"
import HirTable, HirTable_len, HirTable_kind, HirTable_lhs, HirTable_rhs, HirTable_extra, hir_kind, hir_none from "../hir.a"
import Str, Str_from from "../../../std/string.a"
import SliceU32 from "../../../std/slice/u32.a"
import VecU32, VecU32_new, VecU32_destroy, VecU32_push, VecU32_ptr_at, VecU32_get from "../../../std/vec/u32.a"
import VecU8, VecU8_new, VecU8_push, VecU8_get, VecU8_set, VecU8_destroy from "../../../std/vec/u8.a"

import TypeStorage, ty_kind, ty_id_none, ty_id_type, ty_id_unit, ty_id_untyped_int, ty_id_unknown,ty_id_never, ty_id_untyped_float, ty_id_bool,
       TypeStorage_alloc_bool, TypeStorage_alloc_unit, TypeStorage_alloc_int, TypeStorage_alloc_struct, TypeStorage_alloc_infer,
       TypeStorage_alloc_uint, TypeStorage_alloc_float, TypeStorage_alloc_func, TypeStorage_payload, TypeStorage_get_struct_fields,
       TypeStorage_func_return, TypeStorage_func_params, TypeStorage_kind, TypeStorage_alloc_ptr, TypeStorage_print_type from "../types.a"

import UnifyStorage, UnifyStorage_new_slot, UnifyStorage_get_slot, UnifyStorage_resolve_type_deep, UnifyStorage_tmp_slot,
       UnifyStorage_bind_type, UnifyStorage_union, UnifyStorage_resolve_type, slot_none from "../unify.a"
import Interner_get from "../../../std/interner.a"
import id_none from "../nexus/pool.a"

import Engine, Engine_slot_of from "../engine.a"

import fall from "../../../std/sys.a"

print :: (s &u8) unit
print_u32 :: (v u32) unit

str_eq :: (a Str, b Str) bool {
    if a.len != b.len { ret false }
    i: u64 = 0
    while i < a.len {
        if *(a.ptr + i) != *(b.ptr + i) { ret false }
        i = i + 1
    }
    true
}

parse_builtin_type :: (types &TypeStorage, name Str) u32 {
    if str_eq(name, Str_from("bool")) { ret TypeStorage_alloc_bool() }
    if str_eq(name, Str_from("unit")) { ret TypeStorage_alloc_unit() }

    if name.len < 2 { ret ty_id_none() }

    first := *(name.ptr)
    if (first != 105) and (first != 117) and (first != 102) { -- 'i', 'u', 'f'
        ret ty_id_none()
    }

    bits: u32 = 0
    i: u64 = 1
    while i < name.len {
        c := *(name.ptr + i)
        if (c < 48) or (c > 57) { ret ty_id_none() }
        bits = (bits * 10) + ((c - 48) as u32)
        i = i + 1
    }

    if (bits != 8) and (bits != 16) and (bits != 32) and (bits != 64) and (bits != 128) {
        ret ty_id_none()
    }

    if (first == 102) and (bits != 32) and (bits != 64) {
        ret ty_id_none()
    }

    if first == 105 { ret TypeStorage_alloc_int(types, bits as u16) }
    if first == 117 { ret TypeStorage_alloc_uint(types, bits as u16) }
    if first == 102 { ret TypeStorage_alloc_float(types, bits as u16) }

    ty_id_none()
}

type_check :: (eng &Engine, start u32, len u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir

    fn_ret_slot := UnifyStorage_tmp_slot(&(*db).unify)

    i := start
    while i < len {
        synth_node(eng, i, fn_ret_slot)
        i = i + 1
    }
}

type_check_calls :: (eng &Engine) {
    db := &(*eng).nexus
    count := HirTable_len(&(*db).hir) as u64
    pending := VecU8_new()
    i: u64 = 0
    while i < count {
        VecU8_push(&pending, 0 as u8)
        i = i + 1
    }
    i = 0
    while i < (*eng).pending_calls.len {
        id := VecU32_get(&(*eng).pending_calls, i)
        VecU8_set(&pending, id as u64, 1 as u8)
        i = i + 1
    }
    i = 0
    while i < count {
        if VecU8_get(&pending, i) == 0 {
            i = i + 1
            cont
        }
        id := i as u32
        kind := HirTable_kind(&(*db).hir, id)
        if kind == hir_kind().call { synth_call(db, &(*db).hir, id) }
        if kind == hir_kind().member { synth_member(db, &(*db).hir, id) }
        if kind == hir_kind().unary_deref { synth_unary_deref(db, &(*db).hir, id) }
        if kind == hir_kind().unary_addr_of { synth_unary_addr_of(db, &(*db).hir, id) }
        if kind == hir_kind().cast { synth_cast(db, &(*db).hir, id) }
        if (kind == hir_kind().unary_neg) or (kind == hir_kind().unary_bit_not) {
            validate_unary_num(db, &(*db).hir, id)
        }
        if (kind == hir_kind().binary_eq_eq) or (kind == hir_kind().binary_neq) or
            (kind == hir_kind().binary_lt) or (kind == hir_kind().binary_lt_eq) or
            (kind == hir_kind().binary_gt) or (kind == hir_kind().binary_gt_eq) {
            validate_binary_comp(db, &(*db).hir, id)
        }
        if (kind == hir_kind().binary_add) or (kind == hir_kind().binary_sub) or
            (kind == hir_kind().binary_mul) or (kind == hir_kind().binary_div) or
            (kind == hir_kind().binary_mod) or (kind == hir_kind().binary_bit_and) or
            (kind == hir_kind().binary_bit_or) or (kind == hir_kind().binary_bit_xor) or
            (kind == hir_kind().binary_shl) or (kind == hir_kind().binary_shr) {
            synth_binary(db, &(*db).hir, id)
        }
        i = i + 1
    }
    VecU8_destroy(&pending)
    (*eng).pending_calls.len = 0
}

synth_node :: (eng &Engine, id u32, fn_ret_slot u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    k := hir_kind()
    curr := HirTable_kind(tbl, id)

    if curr == k.lit_int       { synth_lit_int(db, tbl, id) }
    if curr == k.ident         { synth_ident(eng, id) }
    if curr == k.var           { synth_var_or_binding(db, tbl, id) }
    if curr == k.binding       { synth_var_or_binding(db, tbl, id) }
    if curr == k.arg           { synth_arg(db, tbl, id) }
    if curr == k.function      { synth_func(db, tbl, id, fn_ret_slot) }
    if curr == k.k_ret         { synth_return(db, tbl, id, fn_ret_slot) }
    if curr == k.call          {
        UnifyStorage_new_slot(&(*db).unify, id)
        VecU32_push(&(*eng).pending_calls, id)
    }
    if curr == k.block         { synth_block(db, tbl, id) }
    if curr == k.binary_assign { synth_assign(db, tbl, id) }

    if curr == k.lit_float      { synth_lit_float(db, tbl, id) }
    if (curr == k.lit_bool_true) or (curr == k.lit_bool_false) { synth_lit_bool(db, tbl, id) }
    if curr == k.lit_str        { synth_lit_str(db, tbl, id) }

    if (curr == k.unary_neg) or (curr == k.unary_bit_not) {
        synth_unary_num(db, tbl, id)
        VecU32_push(&(*eng).pending_calls, id)
    }
    if curr == k.unary_not      { synth_unary_not(db, tbl, id) }
    if curr == k.unary_addr_of {
        UnifyStorage_new_slot(&(*db).unify, id)
        child := HirTable_lhs(tbl, id)
        child_slot := UnifyStorage_get_slot(&(*db).unify, child)
        child_ty := ty_id_none()
        if child_slot != slot_none() {
            child_ty = UnifyStorage_resolve_type_deep(&(*db).unify, &(*db).types, child_slot)
        }
        if child_ty == ty_id_type() {
            synth_unary_addr_of(db, tbl, id)
        } else {
            VecU32_push(&(*eng).pending_calls, id)
        }
    }
    if curr == k.unary_deref {
        UnifyStorage_new_slot(&(*db).unify, id)
        VecU32_push(&(*eng).pending_calls, id)
    }
    if (curr == k.k_break) or (curr == k.k_cont) { synth_break_cont(db, tbl, id) }

    if curr == k.k_if           { synth_if(db, tbl, id) }
    if curr == k.k_while        { synth_while(db, tbl, id) }

    if curr == k.cast           {
        UnifyStorage_new_slot(&(*db).unify, id)
        VecU32_push(&(*eng).pending_calls, id)
    }

    if curr == k.struct_        { synth_struct(db, tbl, id) }
    if curr == k.struct_init    { synth_struct_init(db, tbl, id) }
    if curr == k.member         {
        UnifyStorage_new_slot(&(*db).unify, id)
        VecU32_push(&(*eng).pending_calls, id)
    }

    if (curr == k.binary_and) or (curr == k.binary_or) { synth_logic_and_or(db, tbl, id) }

    if (curr == k.binary_add) or (curr == k.binary_sub) or
        (curr == k.binary_mul) or (curr == k.binary_div) or
        (curr == k.binary_mod) or (curr == k.binary_bit_and) or
        (curr == k.binary_bit_or) or (curr == k.binary_bit_xor) or
        (curr == k.binary_shl) or (curr == k.binary_shr) {
        UnifyStorage_new_slot(&(*db).unify, id)
        VecU32_push(&(*eng).pending_calls, id)
    }

    if (curr == k.binary_eq_eq) or (curr == k.binary_neq) or
       (curr == k.binary_lt) or (curr == k.binary_lt_eq) or
       (curr == k.binary_gt) or (curr == k.binary_gt_eq) {
        synth_binary_comp(db, tbl, id)
        VecU32_push(&(*eng).pending_calls, id)
    }

}

synth_lit_int :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)
   UnifyStorage_bind_type(db, slot, ty_id_untyped_int())
}

synth_ident :: (eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    name_id := HirTable_lhs(tbl, id)
    name := Interner_get(&(*db).interner, name_id)

    slot := UnifyStorage_get_slot(unify_ptr, id)
    if slot == slot_none() {
        slot = UnifyStorage_new_slot(unify_ptr, id)
    }

    builtin_ty := parse_builtin_type(types_ptr, name)
    if builtin_ty != ty_id_none() {
        UnifyStorage_bind_type(db, slot, ty_id_type())
        Nexus_set_const_type(db, id, builtin_ty)
        ret
    }

    sym_id := Nexus_get_hir_symbol(db, id)

    if sym_id != id_none() {
        origin_hir := Nexus_get_sym_hir(db, sym_id)
        if origin_hir == id {
            ret
        }

        origin_slot := Engine_slot_of(eng, sym_id)
        if origin_slot != slot_none() {
            UnifyStorage_union(db, slot, origin_slot)
        }

        resolved_hir := Nexus_get_sym_hir(db, sym_id)
        if resolved_hir != id_none() {
            const_val := Nexus_get_const_type(db, resolved_hir)
            if const_val != ty_id_none() {
                Nexus_set_const_type(db, id, const_val)
            }
        }
    }
}

synth_var_or_binding :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    ident_id := HirTable_lhs(tbl, id)
    type_id  := HirTable_rhs(tbl, id)
    value_id := HirTable_extra(tbl, id)

    slot := UnifyStorage_new_slot(unify_ptr, id)

    ident_slot := UnifyStorage_get_slot(unify_ptr, ident_id)
    if ident_slot == slot_none() {
        ident_slot = UnifyStorage_new_slot(unify_ptr, ident_id)
    }

    if type_id != hir_none() {
        type_slot := UnifyStorage_get_slot(unify_ptr, type_id)
        if type_slot != slot_none() {
            UnifyStorage_bind_type(db, type_slot, ty_id_type())
        }

        type_value := Nexus_get_const_type(db, type_id)
        if type_value != ty_id_none() {
            UnifyStorage_bind_type(db, ident_slot, type_value)
            Nexus_set_const_type(db, ident_id, type_value)
            Nexus_set_const_type(db, id, type_value)
        }
    }

    if value_id != hir_none() {
        val_slot := UnifyStorage_get_slot(unify_ptr, value_id)
        if val_slot != slot_none() {
            val_ty := UnifyStorage_resolve_type(unify_ptr, val_slot)
            if TypeStorage_kind(types_ptr, val_ty) == ty_kind().type_ {
                type_val := Nexus_get_const_type(db, value_id)
                Nexus_set_const_type(db, ident_id, type_val)
                Nexus_set_const_type(db, id, type_val)
            }

            UnifyStorage_union(db, ident_slot, val_slot)
        }
    }

    UnifyStorage_union(db, slot, ident_slot)
}

synth_arg :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    ident_id := HirTable_lhs(tbl, id)
    ty_id    := HirTable_rhs(tbl, id)

    ident_slot := UnifyStorage_get_slot(unify_ptr, ident_id)
    if ident_slot == slot_none() {
        ident_slot = UnifyStorage_new_slot(unify_ptr, ident_id)
    }

    if ty_id != hir_none() {
        type_val := Nexus_get_const_type(db, ty_id)
        if type_val != ty_id_none() {
            UnifyStorage_bind_type(db, ident_slot, type_val)
            Nexus_set_const_type(db, ident_id, type_val)
            Nexus_set_const_type(db, id, type_val)
        }
    }
}
synth_func :: (db &Nexus, tbl &HirTable, id u32, fn_ret_slot u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)

    params_list_id := HirTable_lhs(tbl, id)
    ret_hir_id     := HirTable_rhs(tbl, id)
    body_id        := HirTable_extra(tbl, id)

    is_extern := body_id == hir_none()

    ret_ty := ty_id_unit()
    if ret_hir_id != hir_none() {
        val := Nexus_get_const_type(db, ret_hir_id)
        if val == ty_id_none() {
            print("\n[type error] unresolved return type\n       --> ")
            Nexus_print_loc(db, ret_hir_id)
            print("\n")
            fall()
        }
        ret_ty = val
    }

    if fn_ret_slot != slot_none() {
        UnifyStorage_bind_type(db, fn_ret_slot, ret_ty)
    }

    params_vec := VecU32_new()
    if params_list_id != hir_none() {
        args := Nexus_get_list(db, params_list_id)
        i: u64 = 0
        while i < args.len {
            arg_id := *(args.ptr + i)
            ty_node := HirTable_rhs(tbl, arg_id)
            param_ty := Nexus_get_const_type(db, ty_node)

            if param_ty == ty_id_none() {
                arg_ident := HirTable_lhs(tbl, arg_id)
                arg_slot := UnifyStorage_get_slot(unify_ptr, arg_ident)
                if arg_slot != slot_none() {
                    param_ty = UnifyStorage_resolve_type(unify_ptr, arg_slot)
                }
            }

            if param_ty == ty_id_none() {
                print("\n[type error] unresolved parameter type\n       --> ")
                Nexus_print_loc(db, arg_id)
                print("\n")
                fall()
            }
            if param_ty == ty_id_unit() {
                print("\n[type error] unit parameters have no runtime representation\n       --> ")
                Nexus_print_loc(db, arg_id)
                print("\n")
                fall()
            }

            VecU32_push(&params_vec, param_ty)
            i = i + 1
        }
    }

    slice: SliceU32 = .{ ptr: 0 as &u32, len: 0 }
    if params_vec.len > 0 {
        slice.ptr = VecU32_ptr_at(&params_vec, 0)
        slice.len = params_vec.len
    }

    func_ty := TypeStorage_alloc_func(types_ptr, slice, ret_ty, is_extern)
    VecU32_destroy(&params_vec)

    UnifyStorage_bind_type(db, slot, func_ty)

    if (not is_extern) and (body_id != hir_none()) {
        body_slot := UnifyStorage_get_slot(unify_ptr, body_id)
        if body_slot != slot_none() {
            if (fn_ret_slot != slot_none()) and (ret_ty != ty_id_unit()) {
                UnifyStorage_union(db, body_slot, fn_ret_slot)
            }
        }
    }
}

synth_return :: (db &Nexus, tbl &HirTable, id u32, fn_ret_slot u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)
    UnifyStorage_bind_type(db, slot, ty_id_never())

    val_id := HirTable_lhs(tbl, id)
    if val_id != hir_none() {
        val_slot := UnifyStorage_get_slot(unify_ptr, val_id)
        if (val_slot != slot_none()) and (fn_ret_slot != slot_none()) {
            UnifyStorage_union(db, val_slot, fn_ret_slot)
        }
    } else {
        if fn_ret_slot != slot_none() {
            unit_slot := UnifyStorage_tmp_slot(unify_ptr)
            UnifyStorage_bind_type(db, unit_slot, ty_id_unit())
            UnifyStorage_union(db, unit_slot, fn_ret_slot)
        }
    }
}

synth_call :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_get_slot(unify_ptr, id)
    callee := HirTable_lhs(tbl, id)
    callee_slot := UnifyStorage_get_slot(unify_ptr, callee)

    if callee_slot == slot_none() {
        print("\n[type error] cannot resolve call target\n       --> ")
        Nexus_print_loc(db, callee)
        print("\n")
        fall()
    }
    if callee_slot != slot_none() {
        callee_ty := UnifyStorage_resolve_type_deep(unify_ptr, types_ptr, callee_slot)

        if TypeStorage_kind(types_ptr, callee_ty) != ty_kind().func {
            print("\n\033[1;31m[type error]\033[0m cannot call non-function type '")
            TypeStorage_print_type(types_ptr, callee_ty)
            print("'\n       --> ")
            Nexus_print_loc(db, callee)
            print("\n\n")
            fall()
        }

        if TypeStorage_kind(types_ptr, callee_ty) == ty_kind().func {
            ret_ty := TypeStorage_func_return(types_ptr, callee_ty)
            UnifyStorage_bind_type(db, slot, ret_ty)

            args_list_id := HirTable_rhs(tbl, id)
            params := TypeStorage_func_params(types_ptr, callee_ty)
            args_len: u64 = 0
            if args_list_id != hir_none() {
                args := Nexus_get_list(db, args_list_id)
                args_len = args.len
            }

            if args_len != params.len {
                    print("\n\033[1;31m[type error]\033[0m function expected ")
                    print_u32(params.len as u32)
                    print(" arguments, but got ")
                    print_u32(args_len as u32)
                    print("\n       --> ")
                    Nexus_print_loc(db, id)
                    print("\n\n")
                    fall()
                }

            if args_list_id != hir_none() {
                args := Nexus_get_list(db, args_list_id)
                i: u64 = 0
                while i < args.len {
                    arg_node := *(args.ptr + i)
                    arg_slot := UnifyStorage_get_slot(unify_ptr, arg_node)
                    param_ty := *(params.ptr + i)

                    if arg_slot != slot_none() {
                        param_slot := UnifyStorage_tmp_slot(unify_ptr)
                        UnifyStorage_bind_type(db, param_slot, param_ty)
                        UnifyStorage_union(db, arg_slot, param_slot)
                    }
                    if arg_slot == slot_none() {
                        print("\n[type error] cannot resolve argument\n       --> ")
                        Nexus_print_loc(db, arg_node)
                        print("\n")
                        fall()
                    }
                    i = i + 1
                }
            }
        }
    }
}

synth_block :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)
    list_id := HirTable_lhs(tbl, id)
    items := Nexus_get_list(db, list_id)

    if items.len > 0 {
        last_id := *(items.ptr + items.len - 1)
        last_slot := UnifyStorage_get_slot(unify_ptr, last_id)
        if last_slot != slot_none() {
            UnifyStorage_union(db, slot, last_slot)
        }
    } else {
        UnifyStorage_bind_type(db, slot, ty_id_unit())
    }
}

synth_binary :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_get_slot(unify_ptr, id)
    lhs := HirTable_lhs(tbl, id)
    rhs := HirTable_rhs(tbl, id)

    lhs_slot := UnifyStorage_get_slot(unify_ptr, lhs)
    rhs_slot := UnifyStorage_get_slot(unify_ptr, rhs)

    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        lhs_ty := UnifyStorage_resolve_type_deep(unify_ptr, types_ptr, lhs_slot)
        rhs_ty := UnifyStorage_resolve_type_deep(unify_ptr, types_ptr, rhs_slot)

        lhs_k := TypeStorage_kind(types_ptr, lhs_ty)
        rhs_k := TypeStorage_kind(types_ptr, rhs_ty)

        k := ty_kind()
        lhs_int := (lhs_k == k.int) or (lhs_k == k.uint) or (lhs_k == k.untyped_int)
        rhs_int := (rhs_k == k.int) or (rhs_k == k.uint) or (rhs_k == k.untyped_int)
        lhs_num := lhs_int or (lhs_k == k.float) or (lhs_k == k.untyped_float)
        rhs_num := rhs_int or (rhs_k == k.float) or (rhs_k == k.untyped_float)
        op := HirTable_kind(tbl, id)

        if (lhs_k == k.ptr) or (rhs_k == k.ptr) {
            if (lhs_k == k.ptr) and rhs_int and ((op == hir_kind().binary_add) or (op == hir_kind().binary_sub)) {
                UnifyStorage_bind_type(db, slot, lhs_ty)
                ret
            }
            if (rhs_k == k.ptr) and lhs_int and (op == hir_kind().binary_add) {
                UnifyStorage_bind_type(db, slot, rhs_ty)
                ret
            }
        } else if lhs_num and rhs_num {
            bitwise := (op == hir_kind().binary_bit_and) or (op == hir_kind().binary_bit_or) or
                       (op == hir_kind().binary_bit_xor) or (op == hir_kind().binary_shl) or
                       (op == hir_kind().binary_shr)
            if (not bitwise) or (lhs_int and rhs_int) {
                UnifyStorage_union(db, lhs_slot, rhs_slot)
                UnifyStorage_union(db, slot, lhs_slot)
                ret
            }
        }

        print("\n[type error] invalid arithmetic operands\n       --> ")
        Nexus_print_loc(db, id)
        print("\n")
        fall()
    } else {
        print("\n[type error] missing arithmetic operand\n       --> ")
        Nexus_print_loc(db, id)
        print("\n")
        fall()
    }
}

synth_assign :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)
    lhs := HirTable_lhs(tbl, id)
    rhs := HirTable_rhs(tbl, id)

    lhs_slot := UnifyStorage_get_slot(unify_ptr, lhs)
    rhs_slot := UnifyStorage_get_slot(unify_ptr, rhs)

    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        UnifyStorage_union(db, lhs_slot, rhs_slot)
        rhs_ty := UnifyStorage_resolve_type_deep(unify_ptr, types_ptr, lhs_slot)
        if rhs_ty != ty_id_none() {
            UnifyStorage_bind_type(db, slot, rhs_ty)
        }
    }
}

synth_lit_float :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    UnifyStorage_bind_type(db, slot, ty_id_untyped_float())
}

synth_lit_bool :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    UnifyStorage_bind_type(db, slot, ty_id_bool())
}

synth_lit_str :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    u8_ty := TypeStorage_alloc_uint(&(*db).types, 8 as u16)
    ptr_ty := TypeStorage_alloc_ptr(&(*db).types, u8_ty)
    UnifyStorage_bind_type(db, slot, ptr_ty)
}

synth_unary_num :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    child := HirTable_lhs(tbl, id)
    child_slot := UnifyStorage_get_slot(&(*db).unify, child)
    if child_slot != slot_none() {
        UnifyStorage_union(db, slot, child_slot)
    }
}

validate_unary_num :: (db &Nexus, tbl &HirTable, id u32) {
    child := HirTable_lhs(tbl, id)
    child_slot := UnifyStorage_get_slot(&(*db).unify, child)
    if child_slot != slot_none() {
        child_ty := UnifyStorage_resolve_type_deep(&(*db).unify, &(*db).types, child_slot)
        kind := TypeStorage_kind(&(*db).types, child_ty)
        k := ty_kind()
        is_int := (kind == k.int) or (kind == k.uint) or (kind == k.untyped_int)
        if is_int { ret }
        if (HirTable_kind(tbl, id) == hir_kind().unary_neg) and
           ((kind == k.float) or (kind == k.untyped_float)) { ret }
    }
    print("\n[type error] invalid unary operand\n       --> ")
    Nexus_print_loc(db, id)
    print("\n")
    fall()
}

synth_unary_not :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    child := HirTable_lhs(tbl, id)
    child_slot := UnifyStorage_get_slot(&(*db).unify, child)
    if child_slot != slot_none() {
        UnifyStorage_bind_type(db, child_slot, ty_id_bool())
    }
    UnifyStorage_bind_type(db, slot, ty_id_bool())
}

synth_unary_addr_of :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_get_slot(&(*db).unify, id)
    child := HirTable_lhs(tbl, id)
    child_slot := UnifyStorage_get_slot(&(*db).unify, child)

    if child_slot != slot_none() {
        child_ty := UnifyStorage_resolve_type_deep(&(*db).unify, &(*db).types, child_slot)
        if TypeStorage_kind(&(*db).types, child_ty) == ty_kind().type_ {
            UnifyStorage_bind_type(db, slot, ty_id_type())
            val := Nexus_get_const_type(db, child)
            ptr_val := TypeStorage_alloc_ptr(&(*db).types, val)
            Nexus_set_const_type(db, id, ptr_val)
            ret
        }

        ptr_ty := TypeStorage_alloc_ptr(&(*db).types, child_ty)
        UnifyStorage_bind_type(db, slot, ptr_ty)
    }
}

synth_unary_deref :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_get_slot(&(*db).unify, id)
    child := HirTable_lhs(tbl, id)
    child_slot := UnifyStorage_get_slot(&(*db).unify, child)

    if child_slot != slot_none() {
        child_ty := UnifyStorage_resolve_type_deep(&(*db).unify, &(*db).types, child_slot)
        if TypeStorage_kind(&(*db).types, child_ty) == ty_kind().ptr {
            inner_ty := TypeStorage_payload(&(*db).types, child_ty)
            UnifyStorage_bind_type(db, slot, inner_ty)
        } else {
            print("\n[type error] cannot dereference non-pointer\n       --> ")
            Nexus_print_loc(db, id)
            print("\n")
            fall()
        }
    }
}

synth_break_cont :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    UnifyStorage_bind_type(db, slot, ty_id_unit())
}

synth_if :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    cond := HirTable_lhs(tbl, id)
    thenb := HirTable_rhs(tbl, id)
    elseb := HirTable_extra(tbl, id)

    cond_slot := UnifyStorage_get_slot(&(*db).unify, cond)
    if cond_slot != slot_none() {
        UnifyStorage_bind_type(db, cond_slot, ty_id_bool())
    }

    UnifyStorage_bind_type(db, slot, ty_id_unit())
}

synth_while :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    cond := HirTable_lhs(tbl, id)
    cond_slot := UnifyStorage_get_slot(&(*db).unify, cond)
    if cond_slot != slot_none() {
        UnifyStorage_bind_type(db, cond_slot, ty_id_bool())
    }
    UnifyStorage_bind_type(db, slot, ty_id_unit())
}

synth_binary_comp :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    lhs := HirTable_lhs(tbl, id)
    rhs := HirTable_rhs(tbl, id)

    lhs_slot := UnifyStorage_get_slot(&(*db).unify, lhs)
    rhs_slot := UnifyStorage_get_slot(&(*db).unify, rhs)

    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        UnifyStorage_union(db, lhs_slot, rhs_slot)
    }
    UnifyStorage_bind_type(db, slot, ty_id_bool())
}

validate_binary_comp :: (db &Nexus, tbl &HirTable, id u32) {
    lhs := HirTable_lhs(tbl, id)
    rhs := HirTable_rhs(tbl, id)
    lhs_slot := UnifyStorage_get_slot(&(*db).unify, lhs)
    rhs_slot := UnifyStorage_get_slot(&(*db).unify, rhs)
    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        lhs_ty := UnifyStorage_resolve_type_deep(&(*db).unify, &(*db).types, lhs_slot)
        rhs_ty := UnifyStorage_resolve_type_deep(&(*db).unify, &(*db).types, rhs_slot)
        lhs_kind := TypeStorage_kind(&(*db).types, lhs_ty)
        rhs_kind := TypeStorage_kind(&(*db).types, rhs_ty)
        k := ty_kind()
        lhs_num := (lhs_kind == k.int) or (lhs_kind == k.uint) or (lhs_kind == k.float) or
                   (lhs_kind == k.untyped_int) or (lhs_kind == k.untyped_float)
        rhs_num := (rhs_kind == k.int) or (rhs_kind == k.uint) or (rhs_kind == k.float) or
                   (rhs_kind == k.untyped_int) or (rhs_kind == k.untyped_float)
        if lhs_num and rhs_num { ret }
        op := HirTable_kind(tbl, id)
        if (op == hir_kind().binary_eq_eq) or (op == hir_kind().binary_neq) {
            if (lhs_kind == k.bool) and (rhs_kind == k.bool) { ret }
            if (lhs_kind == k.ptr) and (rhs_kind == k.ptr) { ret }
        }
    }
    print("\n[type error] invalid comparison operands\n       --> ")
    Nexus_print_loc(db, id)
    print("\n")
    fall()
}

synth_logic_and_or :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_new_slot(&(*db).unify, id)
    lhs := HirTable_lhs(tbl, id)
    rhs := HirTable_rhs(tbl, id)

    lhs_slot := UnifyStorage_get_slot(&(*db).unify, lhs)
    rhs_slot := UnifyStorage_get_slot(&(*db).unify, rhs)

    if lhs_slot != slot_none() {
        UnifyStorage_bind_type(db, lhs_slot, ty_id_bool())
    }
    if rhs_slot != slot_none() {
        UnifyStorage_bind_type(db, rhs_slot, ty_id_bool())
    }
    UnifyStorage_bind_type(db, slot, ty_id_bool())
}

synth_cast :: (db &Nexus, tbl &HirTable, id u32) {
    slot := UnifyStorage_get_slot(&(*db).unify, id)
    lhs := HirTable_lhs(tbl, id)
    rhs := HirTable_rhs(tbl, id)
    rhs_type := Nexus_get_const_type(db, rhs)
    if rhs_type != ty_id_none() {
        lhs_slot := UnifyStorage_get_slot(&(*db).unify, lhs)
        lhs_type := ty_id_none()
        if lhs_slot != slot_none() {
            lhs_type = UnifyStorage_resolve_type_deep(&(*db).unify, &(*db).types, lhs_slot)
        }
        types := &(*db).types
        src := TypeStorage_kind(types, lhs_type)
        dst := TypeStorage_kind(types, rhs_type)
        k := ty_kind()
        src_int := (src == k.int) or (src == k.uint) or (src == k.untyped_int)
        dst_int := (dst == k.int) or (dst == k.uint) or (dst == k.untyped_int)
        src_num := src_int or (src == k.float) or (src == k.untyped_float) or (src == k.bool)
        dst_num := dst_int or (dst == k.float) or (dst == k.untyped_float) or (dst == k.bool)
        if not ((src_num and dst_num) or ((src == k.ptr) and (dst == k.ptr)) or
                (src_int and (dst == k.ptr)) or ((src == k.ptr) and dst_int) or
                ((src == k.ptr) and (dst == k.bool))) {
            print("\n[type error] invalid cast\n       --> ")
            Nexus_print_loc(db, id)
            print("\n")
            fall()
        }
        UnifyStorage_bind_type(db, slot, rhs_type)
    } else {
        print("\n[type error] cast target is not a type\n       --> ")
        Nexus_print_loc(db, id)
        print("\n")
        fall()
    }
}

synth_struct :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)

    names_list := HirTable_lhs(tbl, id)
    types_list := HirTable_rhs(tbl, id)

    names := Nexus_get_list(db, names_list)
    types := Nexus_get_list(db, types_list)

    fields_vec := VecU32_new()

    i: u64 = 0
    while (i < names.len) and (i < types.len) {
        name_node := *(names.ptr + i)
        type_node := *(types.ptr + i)

        name_id := HirTable_lhs(tbl, name_node)

        ty_val := Nexus_get_const_type(db, type_node)
        if ty_val == ty_id_none() {
            s := UnifyStorage_get_slot(unify_ptr, type_node)
            if s != slot_none() {
                ty_val = UnifyStorage_resolve_type_deep(unify_ptr, types_ptr, s)
            }
        }

        VecU32_push(&fields_vec, name_id)
        VecU32_push(&fields_vec, ty_val)
        i = i + 1
    }

    ptr := 0 as &u32
    if fields_vec.len > 0 { ptr = VecU32_ptr_at(&fields_vec, 0) }
    slice: SliceU32 = .{ ptr: ptr, len: fields_vec.len }

    tyid := TypeStorage_alloc_struct(types_ptr, slice)
    VecU32_destroy(&fields_vec)

    Nexus_set_const_type(db, id, tyid)
    UnifyStorage_bind_type(db, slot, ty_id_type())
}

synth_struct_init :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_new_slot(unify_ptr, id)

    fields_list := HirTable_lhs(tbl, id)
    vals_list   := HirTable_rhs(tbl, id)

    fields := Nexus_get_list(db, fields_list)
    vals   := Nexus_get_list(db, vals_list)

    fields_vec := VecU32_new()

    i: u64 = 0
    while (i < fields.len) and (i < vals.len) {
        f_node := *(fields.ptr + i)
        v_node := *(vals.ptr + i)

        name_id := HirTable_lhs(tbl, f_node)

        v_slot := UnifyStorage_get_slot(unify_ptr, v_node)
        if v_slot == slot_none() {
            v_slot = UnifyStorage_new_slot(unify_ptr, v_node)
        }
        infer_ty := TypeStorage_alloc_infer(types_ptr, v_slot)

        VecU32_push(&fields_vec, name_id)
        VecU32_push(&fields_vec, infer_ty)
        i = i + 1
    }

    ptr := 0 as &u32
    if fields_vec.len > 0 { ptr = VecU32_ptr_at(&fields_vec, 0) }
    slice: SliceU32 = .{ ptr: ptr, len: fields_vec.len }

    tyid := TypeStorage_alloc_struct(types_ptr, slice)
    VecU32_destroy(&fields_vec)

    UnifyStorage_bind_type(db, slot, tyid)
}

synth_member :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := UnifyStorage_get_slot(unify_ptr, id)

    lhs_id := HirTable_lhs(tbl, id)
    lhs_slot := UnifyStorage_get_slot(unify_ptr, lhs_id)

    if lhs_slot != slot_none() {
        lhs_ty := UnifyStorage_resolve_type_deep(unify_ptr, types_ptr, lhs_slot)
        if TypeStorage_kind(types_ptr, lhs_ty) == ty_kind().ptr {
            lhs_ty = TypeStorage_payload(types_ptr, lhs_ty)
        }

        if TypeStorage_kind(types_ptr, lhs_ty) != ty_kind().struct_ {
            print("\n\033[1;31m[type error]\033[0m cannot access field on non-struct type '")
            TypeStorage_print_type(types_ptr, lhs_ty)
            print("'\n       --> ")
            Nexus_print_loc(db, lhs_id)
            print("\n\n")
            fall()
        }

        rhs_id := HirTable_rhs(tbl, id)
        name_id := HirTable_lhs(tbl, rhs_id)

        fields := TypeStorage_get_struct_fields(types_ptr, lhs_ty)
        count := fields.len / 2
        i: u64 = 0
        found := false

        while i < count {
            fn_name := *(fields.ptr + (i * 2))
            fn_ty   := *(fields.ptr + (i * 2) + 1)
            if fn_name == name_id {
                found = true
                if TypeStorage_kind(types_ptr, fn_ty) == ty_kind().infer {
                    infer_slot := TypeStorage_payload(types_ptr, fn_ty)
                    UnifyStorage_union(db, slot, infer_slot)
                } else {
                    UnifyStorage_bind_type(db, slot, fn_ty)
                }
                ret
            }
            i = i + 1
        }

        if not found {
            print("\n\033[1;31m[type error]\033[0m struct has no field with given name\n       --> ")
            Nexus_print_loc(db, id)
            print("\n\n")
            fall()
        }
    }
}

import Nexus from "nexus/nexus.a"
import TypeStorage, ty_kind, TypeStorage_kind, TypeStorage_len,
       TypeStorage_get_struct_fields, TypeStorage_get_array_type from "types.a"
import VecU32, VecU32_new, VecU32_destroy, VecU32_push, VecU32_get from "../../std/vec/u32.a"
import VecU8, VecU8_new, VecU8_destroy, VecU8_push, VecU8_get, VecU8_set from "../../std/vec/u8.a"

topo_dfs :: (types &TypeStorage, sorted &VecU32, states &VecU8, ty_id u32) {
    if (ty_id as u64) >= (*states).len { ret }
    st := VecU8_get(states, ty_id as u64)
    if st != (0 as u8) { ret }

    VecU8_set(states, ty_id as u64, 1 as u8) 

    k := ty_kind()
    kind := TypeStorage_kind(types, ty_id)

    if kind == k.struct_ {
        fields := TypeStorage_get_struct_fields(types, ty_id)
        count := fields.len / 2
        i: u64 = 0
        while i < count {
            f_ty := *(fields.ptr + (i * 2) + 1)
            f_kind := TypeStorage_kind(types, f_ty)
            if (f_kind == k.struct_) or (f_kind == k.array) {
                topo_dfs(types, sorted, states, f_ty)
            }
            i = i + 1
        }
    } else if kind == k.array {
        inner_ty := TypeStorage_get_array_type(types, ty_id)
        inner_kind := TypeStorage_kind(types, inner_ty)
        if (inner_kind == k.struct_) or (inner_kind == k.array) {
            topo_dfs(types, sorted, states, inner_ty)
        }
    }

    VecU32_push(sorted, ty_id)
    VecU8_set(states, ty_id as u64, 2 as u8)
}

topo_sort :: (types &TypeStorage, type_queue &VecU32) VecU32 {
    sorted := VecU32_new()
    states := VecU8_new()

    total_types := TypeStorage_len(types)
    i: u32 = 0
    while i < total_types {
        VecU8_push(&states, 0 as u8)
        i = i + 1
    }

    q_i: u64 = 0
    while q_i < (*type_queue).len {
        ty_id := VecU32_get(type_queue, q_i)
        topo_dfs(types, &sorted, &states, ty_id)
        q_i = q_i + 1
    }

    VecU8_destroy(&states)
    sorted
}
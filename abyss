#!/usr/bin/env bash
set -e

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT_DIR}"
mkdir -p tmp

CMD="${1:-help}"
shift || true

case "${CMD}" in
    r)
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" "${TARGET}" "${ROOT_DIR}/tmp/out.c"
        else
            "${ROOT_DIR}/abyssc"
        fi
        gcc -O0 -g1 -pipe -fno-plt "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out"
        "${ROOT_DIR}/tmp/out"
        ;;
    b)
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" "${TARGET}" "${ROOT_DIR}/tmp/out.c"
        else
            "${ROOT_DIR}/abyssc"
        fi
        gcc -O3 -march=native -mtune=native -fomit-frame-pointer -funroll-loops "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out"
        ;;
    br)
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" "${TARGET}" "${ROOT_DIR}/tmp/out.c"
        else
            "${ROOT_DIR}/abyssc"
        fi
        gcc -O3 -march=native -mtune=native -fomit-frame-pointer -funroll-loops "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out"
        "${ROOT_DIR}/tmp/out"
        ;;
    test|t)
        FILTER="${1:-}"
        PASSED=0
        FAILED=0
        CREATED=0
        TOTAL=0

        TEST_FILES=$(find "${ROOT_DIR}/tests" -maxdepth 1 -name "*.a" | sort)
        if [ -n "${FILTER}" ]; then
            TEST_FILES=$(echo "${TEST_FILES}" | grep "${FILTER}" || true)
        fi

        if [ -z "${TEST_FILES}" ]; then
            echo -e "\033[1;33mNo test files found matching filter: ${FILTER}\033[0m"
            exit 0
        fi

        echo -e "\033[1;36m====================================================\033[0m"
        echo -e "\033[1;36m            ABYSS LANGUAGE TEST RUNNER             \033[0m"
        echo -e "\033[1;36m====================================================\033[0m"

        for TEST_FILE in ${TEST_FILES}; do
            TOTAL=$((TOTAL + 1))
            TEST_NAME=$(basename "${TEST_FILE}")
            EXPECTED_FILE="${TEST_FILE%.a}.out"
            C_OUT="${ROOT_DIR}/tmp/test_out.c"
            BIN_OUT="${ROOT_DIR}/tmp/test_bin"
            ACTUAL_OUT="${ROOT_DIR}/tmp/actual.out"

            COMPILE_ERR=$("${ROOT_DIR}/abyssc" "${TEST_FILE}" "${C_OUT}" 2>&1 || true)
            if [ ! -f "${C_OUT}" ]; then
                echo -e "  \033[1;31m✘ FAIL\033[0m  ${TEST_NAME} (Abyss Compilation Error)"
                echo -e "${COMPILE_ERR}"
                FAILED=$((FAILED + 1))
                continue
            fi

            GCC_ERR=$(gcc -O0 "${C_OUT}" -o "${BIN_OUT}" 2>&1 || true)
            if [ ! -f "${BIN_OUT}" ]; then
                echo -e "  \033[1;31m✘ FAIL\033[0m  ${TEST_NAME} (GCC Error)"
                echo -e "${GCC_ERR}"
                FAILED=$((FAILED + 1))
                rm -f "${C_OUT}"
                continue
            fi

            RUN_STATUS=0
            bash -c "ulimit -v 500000 && timeout 5s '${BIN_OUT}'" > "${ACTUAL_OUT}" 2>&1 || RUN_STATUS=$?

            if [ ${RUN_STATUS} -ne 0 ]; then
                echo -e "  \033[1;31m✘ FAIL\033[0m  ${TEST_NAME} (Runtime Exit Code: ${RUN_STATUS})"
                cat "${ACTUAL_OUT}"
                FAILED=$((FAILED + 1))
                rm -f "${C_OUT}" "${BIN_OUT}" "${ACTUAL_OUT}"
                continue
            fi

            if [ ! -f "${EXPECTED_FILE}" ]; then
                cp "${ACTUAL_OUT}" "${EXPECTED_FILE}"
                echo -e "  \033[1;33m★ CREATED\033[0m ${TEST_NAME} -> $(basename "${EXPECTED_FILE}")"
                CREATED=$((CREATED + 1))
            else
                if diff -u "${EXPECTED_FILE}" "${ACTUAL_OUT}" > /dev/null 2>&1; then
                    echo -e "  \033[1;32m✔ PASS\033[0m   ${TEST_NAME}"
                    PASSED=$((PASSED + 1))
                else
                    echo -e "  \033[1;31m✘ FAIL\033[0m   ${TEST_NAME} (Output Mismatch)"
                    echo -e "  \033[1;33m--- Diff (Expected vs Actual): ---\033[0m"
                    diff -u "${EXPECTED_FILE}" "${ACTUAL_OUT}" || true
                    FAILED=$((FAILED + 1))
                fi
            fi

            rm -f "${C_OUT}" "${BIN_OUT}" "${ACTUAL_OUT}"
        done

        echo -e "\033[1;36m====================================================\033[0m"
        echo -e "Results: \033[1;32m${PASSED} passed\033[0m, \033[1;31m${FAILED} failed\033[0m, \033[1;33m${CREATED} created\033[0m (Total: ${TOTAL})"
        echo -e "\033[1;36m====================================================\033[0m"

        if [ ${FAILED} -ne 0 ]; then
            exit 1
        fi
        ;;
    bootstrap|test-bootstrap)
        bash "${ROOT_DIR}/scripts/bootstrap.sh" "$@"
        ;;
    clean)
        rm -rf "${ROOT_DIR}/tmp"/*
        echo "Cleaned tmp directory."
        ;;
    *)
        echo "Usage: ./abyss <command> [args]"
        echo ""
        echo "Commands:"
        echo "  r [file]          Build and run in debug mode"
        echo "  b [file]          Build in release mode"
        echo "  br [file]         Build and run in release mode"
        echo "  test [filter]     Run language test suite"
        echo "  bootstrap [n]     Run bootstrap stability test"
        echo "  clean             Clean tmp build artifacts"
        exit 1
        ;;
esac

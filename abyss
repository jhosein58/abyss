#!/usr/bin/env bash
set -e

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT_DIR}"
mkdir -p tmp
export ABYSS_OUT="${ROOT_DIR}/tmp/out.c"

CMD="${1:-help}"
shift || true

prepare_compiler() {
    python3 "${ROOT_DIR}/scripts/embed_sources.py"
    if [[ "${ROOT_DIR}/compiler/embedded.a" -nt "${ROOT_DIR}/abyssc" ]]; then
        BUILD_DIR=$(mktemp -d "${ROOT_DIR}/tmp/embed_build.XXXXXX")
        "${ROOT_DIR}/abyssc" "${ROOT_DIR}/main.a" "${BUILD_DIR}/stage1.c"
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O0 "${BUILD_DIR}/stage1.c" -o "${BUILD_DIR}/stage1"
        "${BUILD_DIR}/stage1" "${ROOT_DIR}/main.a" "${BUILD_DIR}/stage2.c"
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O2 "${BUILD_DIR}/stage2.c" -o "${BUILD_DIR}/abyssc"
        mv "${BUILD_DIR}/abyssc" "${ROOT_DIR}/abyssc"
    fi
}

case "${CMD}" in
    r)
        prepare_compiler
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" "${TARGET}" "${ROOT_DIR}/tmp/out.c"
        else
            "${ROOT_DIR}/abyssc"
        fi
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O0 -g1 -pipe -fno-plt "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out"
        "${ROOT_DIR}/tmp/out"
        ;;
    b)
        prepare_compiler
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" "${TARGET}" "${ROOT_DIR}/tmp/out.c"
        else
            "${ROOT_DIR}/abyssc"
        fi
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -march=native -mtune=native -fomit-frame-pointer -funroll-loops "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out"
        ;;
    br)
        prepare_compiler
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" "${TARGET}" "${ROOT_DIR}/tmp/out.c"
        else
            "${ROOT_DIR}/abyssc"
        fi
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -march=native -mtune=native -fomit-frame-pointer -funroll-loops "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out"
        "${ROOT_DIR}/tmp/out"
        ;;
    b-win|win)
        prepare_compiler
        TARGET="${1:-}"
        MINGW_CC="${MINGW_CC:-x86_64-w64-mingw32-gcc}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" "${TARGET}" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out.exe"
            echo "Built ${ROOT_DIR}/tmp/out.exe"
        else
            "${ROOT_DIR}/abyssc" "${ROOT_DIR}/main.a" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/abyssc.exe"
            echo "Built ${ROOT_DIR}/abyssc.exe"
        fi
        ;;
    r-win|br-win)
        prepare_compiler
        TARGET="${1:-}"
        MINGW_CC="${MINGW_CC:-x86_64-w64-mingw32-gcc}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" "${TARGET}" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out.exe"
            WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${ROOT_DIR}/tmp/out.exe"
        else
            "${ROOT_DIR}/abyssc" "${ROOT_DIR}/main.a" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/abyssc.exe"
            WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${ROOT_DIR}/abyssc.exe"
        fi
        ;;
    test|t)
        bash "${ROOT_DIR}/scripts/test_compiler.sh" "${ABYSS_COMPILER:-${ROOT_DIR}/abyssc}" "${1:-}"
        ;;
    bootstrap|test-bootstrap)
        bash "${ROOT_DIR}/scripts/bootstrap.sh" "$@"
        ;;
    clean)
        rm -rf "${ROOT_DIR}/tmp"/*
        echo "Cleaned tmp directory."
        ;;
    *)
        echo "Usage: ./abyss <command> [args]"
        echo ""
        echo "Commands:"
        echo "  r [file]          Build and run in debug mode"
        echo "  b [file]          Build in release mode"
        echo "  br [file]         Build and run in release mode"
        echo "  b-win [file]      Build Windows binary (default: abyssc.exe)"
        echo "  r-win [file]      Build and run Windows binary with wine"
        echo "  test [filter]     Run language test suite"
        echo "  bootstrap [n]     Run bootstrap stability test"
        echo "  clean             Clean tmp build artifacts"
        exit 1
        ;;
esac

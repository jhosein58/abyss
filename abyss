#!/usr/bin/env bash
set -e

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT_DIR}"
mkdir -p tmp
export ABYSS_OUT="${ROOT_DIR}/tmp/out.c"

CMD="${1:-help}"
shift || true

prepare_compiler() {
    export ABYSS_DEV="${ROOT_DIR}"
    if [ ! -f "${ROOT_DIR}/abyssc" ] || [ -n "$(find "${ROOT_DIR}/compiler" "${ROOT_DIR}/core" "${ROOT_DIR}/std" "${ROOT_DIR}/runtime" -type f -newer "${ROOT_DIR}/abyssc" 2>/dev/null)" ]; then
        BUILD_DIR=$(mktemp -d "${ROOT_DIR}/tmp/embed_build.XXXXXX")
        "${ROOT_DIR}/abyssc" "${ROOT_DIR}/compiler/main.a" "${BUILD_DIR}/stage1.c"
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O0 "${BUILD_DIR}/stage1.c" -o "${BUILD_DIR}/stage1"
        "${BUILD_DIR}/stage1" "${ROOT_DIR}/compiler/main.a" "${BUILD_DIR}/stage2.c"
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O2 "${BUILD_DIR}/stage2.c" -o "${BUILD_DIR}/abyssc"
        mv "${BUILD_DIR}/abyssc" "${ROOT_DIR}/abyssc"
        rm -rf "${BUILD_DIR}"
    fi
}

case "${CMD}" in
    r)
        if [ ! -f "${ROOT_DIR}/abyssc" ]; then
            prepare_compiler
        fi
        export ABYSS_DEV="${ROOT_DIR}"
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" r "${TARGET}"
        else
            "${ROOT_DIR}/abyssc" r
        fi
        ;;
    b)
        prepare_compiler
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" b "${TARGET}" "${ROOT_DIR}/tmp/out.c"
        else
            "${ROOT_DIR}/abyssc" b "${ROOT_DIR}/main.a" "${ROOT_DIR}/tmp/out.c"
        fi
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -march=native -mtune=native -fomit-frame-pointer -funroll-loops "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out"
        ;;
    br)
        prepare_compiler
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" b "${TARGET}" "${ROOT_DIR}/tmp/out.c"
        else
            "${ROOT_DIR}/abyssc" b "${ROOT_DIR}/main.a" "${ROOT_DIR}/tmp/out.c"
        fi
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -march=native -mtune=native -fomit-frame-pointer -funroll-loops "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out"
        "${ROOT_DIR}/tmp/out"
        ;;
    b-win|win)
        prepare_compiler
        TARGET="${1:-}"
        MINGW_CC="${MINGW_CC:-x86_64-w64-mingw32-gcc}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" b "${TARGET}" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out.exe"
            echo "Built ${ROOT_DIR}/tmp/out.exe"
        else
            "${ROOT_DIR}/abyssc" b "${ROOT_DIR}/main.a" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/abyssc.exe"
            echo "Built ${ROOT_DIR}/abyssc.exe"
        fi
        ;;
    r-win|br-win)
        prepare_compiler
        TARGET="${1:-}"
        MINGW_CC="${MINGW_CC:-x86_64-w64-mingw32-gcc}"
        if [ -n "${TARGET}" ]; then
            "${ROOT_DIR}/abyssc" b "${TARGET}" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out.exe"
            WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${ROOT_DIR}/tmp/out.exe"
        else
            "${ROOT_DIR}/abyssc" b "${ROOT_DIR}/main.a" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/abyssc.exe"
            WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${ROOT_DIR}/abyssc.exe"
        fi
        ;;
    test|t)
        bash "${ROOT_DIR}/scripts/test_compiler.sh" "${ABYSS_COMPILER:-${ROOT_DIR}/abyssc}" "${1:-}"
        ;;
    test-win|twin)
        if ! command -v wine >/dev/null 2>&1; then
            echo "[ERROR] wine is required to run Windows tests."
            exit 1
        fi
        TARGET="${1:-}"
        WRAPPER="${ROOT_DIR}/tmp/wine_abyssc"
        cat << EOF > "${WRAPPER}"
#!/bin/sh
WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${ROOT_DIR}/dist/abyssc-windows-x86_64.exe" "\$@"
EOF
        chmod +x "${WRAPPER}"
        bash "${ROOT_DIR}/scripts/test_compiler.sh" "${WRAPPER}" "${TARGET}"
        ;;
    bootstrap|test-bootstrap)
        bash "${ROOT_DIR}/scripts/bootstrap.sh" "$@"
        ;;
    release)
        ROUNDS="${1:-3}"
        export ABYSS_DEV="${ROOT_DIR}"
        bash "${ROOT_DIR}/scripts/bootstrap.sh" "${ROUNDS}"
        DIST_DIR="${ROOT_DIR}/dist"
        mkdir -p "${DIST_DIR}"
        "${ROOT_DIR}/abyssc" b "${ROOT_DIR}/compiler/main.a" "${DIST_DIR}/bootstrap.c"
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -fomit-frame-pointer "${DIST_DIR}/bootstrap.c" -o "${DIST_DIR}/abyssc-linux-x86_64"
        cp "${DIST_DIR}/abyssc-linux-x86_64" "${ROOT_DIR}/abyssc"

        echo "Verifying Linux release binary..."
        "${DIST_DIR}/abyssc-linux-x86_64" r "${ROOT_DIR}/tests/01_literals.a" >/dev/null 2>&1
        echo "✔ Linux x86_64 binary verified!"

        MINGW_CC="${MINGW_CC:-x86_64-w64-mingw32-gcc}"
        if command -v "${MINGW_CC}" >/dev/null 2>&1; then
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${DIST_DIR}/bootstrap.c" -o "${DIST_DIR}/abyssc-windows-x86_64.exe"
            if command -v wine >/dev/null 2>&1; then
                echo "Verifying Windows binary with Wine..."
                WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${DIST_DIR}/abyssc-windows-x86_64.exe" r "${ROOT_DIR}/tests/01_literals.a" >/dev/null 2>&1
                WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${DIST_DIR}/abyssc-windows-x86_64.exe" b "${ROOT_DIR}/tests/01_literals.a" "${ROOT_DIR}/tmp/win_verify.c" >/dev/null 2>&1
                echo "✔ Windows x86_64 binary verified via Wine (VM + C codegen)!"
            fi
        fi
        echo "Release artifacts generated in ${DIST_DIR}:"
        ls -lh "${DIST_DIR}"
        ;;
    clean)
        rm -rf "${ROOT_DIR}/tmp"/*
        echo "Cleaned tmp directory."
        ;;
    *)
        echo "Usage: ./abyss <command> [args]"
        echo ""
        echo "Commands:"
        echo "  r [file]          Run in debug mode on VM"
        echo "  b [file]          Build in release mode"
        echo "  br [file]         Build and run in release mode"
        echo "  b-win [file]      Build Windows binary (default: abyssc.exe)"
        echo "  r-win [file]      Build and run Windows binary with wine"
        echo "  test [filter]     Run language test suite"
        echo "  test-win [filter] Run language test suite on Windows binary with wine"
        echo "  bootstrap [n]     Run bootstrap stability test"
        echo "  release [n]       Build release packages in dist/ (bootstrap.c, Linux, Windows)"
        echo "  clean             Clean tmp build artifacts"
        exit 1
        ;;
esac

#!/usr/bin/env bash
set -e

ORIG_PWD="${PWD}"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT_DIR}"
mkdir -p tmp
export ABYSS_OUT="${ROOT_DIR}/tmp/out.c"

CMD="${1:-help}"
shift || true

prepare_compiler() {
    export ABYSS_DEV="${ROOT_DIR}"
    if [ ! -f "${ROOT_DIR}/abyssc" ]; then
        echo "[INFO] Seed compiler '${ROOT_DIR}/abyssc' not found. Fetching latest release..."
        SEED_TMP=$(mktemp -d "${ROOT_DIR}/tmp/seed_fetch.XXXXXX" 2>/dev/null || mktemp -d)
        SEED_URL="https://github.com/abysslang/abyss/releases/latest/download/abyss-linux-x86_64.tar.gz"
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL "${SEED_URL}" -o "${SEED_TMP}/abyss.tar.gz" 2>/dev/null || true
        elif command -v wget >/dev/null 2>&1; then
            wget -qO "${SEED_TMP}/abyss.tar.gz" "${SEED_URL}" 2>/dev/null || true
        fi
        if [ -s "${SEED_TMP}/abyss.tar.gz" ]; then
            tar -xzf "${SEED_TMP}/abyss.tar.gz" -C "${SEED_TMP}" --strip-components=1 2>/dev/null || true
            if [ -f "${SEED_TMP}/bin/abyssc" ]; then
                cp "${SEED_TMP}/bin/abyssc" "${ROOT_DIR}/abyssc"
                chmod +x "${ROOT_DIR}/abyssc"
                touch -d "2020-01-01" "${ROOT_DIR}/abyssc" 2>/dev/null || true
                echo "✔ Downloaded seed compiler to ${ROOT_DIR}/abyssc"
            fi
        fi
        rm -rf "${SEED_TMP}"
        if [ ! -f "${ROOT_DIR}/abyssc" ]; then
            echo "[ERROR] Seed compiler '${ROOT_DIR}/abyssc' not found and could not be fetched!" >&2
            exit 1
        fi
    fi

    SEED_COMPILER="${ROOT_DIR}/abyssc"
    COMPILER_BIN="${ROOT_DIR}/tmp/abyssc-current"
    if [ ! -x "${COMPILER_BIN}" ] || [ "${SEED_COMPILER}" -nt "${COMPILER_BIN}" ] || [ -n "$(find "${ROOT_DIR}/compiler" "${ROOT_DIR}/pods" -type f -not -path '*/.vendor/*' -newer "${COMPILER_BIN}" 2>/dev/null)" ]; then
        BUILD_DIR=$(mktemp -d "${ROOT_DIR}/tmp/embed_build.XXXXXX")
        if ! bash "${ROOT_DIR}/scripts/seed_compile.sh" "${SEED_COMPILER}" "${BUILD_DIR}/stage1.c" >"${BUILD_DIR}/stage1_compile.log" 2>&1; then
            echo "[ERROR] Stage 1 failed: Current seed compiler failed to compile compiler sources!" >&2
            cat "${BUILD_DIR}/stage1_compile.log" >&2
            rm -rf "${BUILD_DIR}"
            exit 1
        fi
        if [ ! -s "${BUILD_DIR}/stage1.c" ]; then
            echo "[ERROR] Stage 1 failed: '${BUILD_DIR}/stage1.c' was not generated or is empty!" >&2
            rm -rf "${BUILD_DIR}"
            exit 1
        fi
        STAGE1_CC="gcc"
        STAGE1_FLAGS="-std=gnu99 -D_POSIX_C_SOURCE=200809L -O0"
        if command -v tcc >/dev/null 2>&1; then
            STAGE1_CC="tcc"
            STAGE1_FLAGS="-std=c99 -D_POSIX_C_SOURCE=200809L"
        fi
        if ! ${STAGE1_CC} ${STAGE1_FLAGS} "${BUILD_DIR}/stage1.c" -o "${BUILD_DIR}/stage1" 2>"${BUILD_DIR}/stage1_c.log"; then
            echo "[ERROR] Stage 1 failed: C compiler failed to build stage1 binary!" >&2
            cat "${BUILD_DIR}/stage1_c.log" >&2
            rm -rf "${BUILD_DIR}"
            exit 1
        fi
        if ! "${BUILD_DIR}/stage1" "${ROOT_DIR}/compiler/main.a" "${BUILD_DIR}/stage2.c" 2>"${BUILD_DIR}/stage2_compile.log"; then
            echo "[ERROR] Stage 2 failed: Newly generated Stage 1 compiler failed to self-host (compile compiler sources with itself)!" >&2
            cat "${BUILD_DIR}/stage2_compile.log" >&2
            rm -rf "${BUILD_DIR}"
            exit 1
        fi
        if [ ! -s "${BUILD_DIR}/stage2.c" ]; then
            echo "[ERROR] Stage 2 failed: '${BUILD_DIR}/stage2.c' was not generated or is empty!" >&2
            rm -rf "${BUILD_DIR}"
            exit 1
        fi
        if ! gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O2 "${BUILD_DIR}/stage2.c" -o "${BUILD_DIR}/abyssc" 2>"${BUILD_DIR}/stage2_c.log"; then
            echo "[ERROR] Stage 2 failed: C compiler failed to build stage2 binary!" >&2
            cat "${BUILD_DIR}/stage2_c.log" >&2
            rm -rf "${BUILD_DIR}"
            exit 1
        fi
        mv "${BUILD_DIR}/abyssc" "${COMPILER_BIN}"
        rm -rf "${BUILD_DIR}"
    fi
}

build_wasi() {
    local dist_dir="${ROOT_DIR}/dist"
    mkdir -p "${dist_dir}"
    "${COMPILER_BIN}" b --target wasi "${ROOT_DIR}/compiler/main.a" "${dist_dir}/abyssc-wasi.c"
    clang -w --target=wasm32-wasi -ffreestanding -nostdlib -O3 -Wl,-z,stack-size=2097152 "${dist_dir}/abyssc-wasi.c" -o "${dist_dir}/abyssc.wasm"
    echo "Built ${dist_dir}/abyssc.wasm"
}

case "${CMD}" in
    emit)
        prepare_compiler
        "${COMPILER_BIN}" "$@"
        ;;
    r)
        prepare_compiler
        export ABYSS_DEV="${ROOT_DIR}"
        TARGET="${1:-}"
        shift || true
        if [ -n "${TARGET}" ]; then
            "${COMPILER_BIN}" r "${TARGET}" "$@"
        else
            "${COMPILER_BIN}" r
        fi
        ;;
    b)
        prepare_compiler
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            "${COMPILER_BIN}" b "${TARGET}" "${ROOT_DIR}/tmp/out.c"
        else
            "${COMPILER_BIN}" b "${ROOT_DIR}/main.a" "${ROOT_DIR}/tmp/out.c"
        fi
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -march=native -mtune=native -fomit-frame-pointer -funroll-loops "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out"
        ;;
    br)
        prepare_compiler
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            "${COMPILER_BIN}" b "${TARGET}" "${ROOT_DIR}/tmp/out.c"
        else
            "${COMPILER_BIN}" b "${ROOT_DIR}/main.a" "${ROOT_DIR}/tmp/out.c"
        fi
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -march=native -mtune=native -fomit-frame-pointer -funroll-loops "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out"
        "${ROOT_DIR}/tmp/out"
        ;;
    b-win|win)
        prepare_compiler
        TARGET="${1:-}"
        MINGW_CC="${MINGW_CC:-x86_64-w64-mingw32-gcc}"
        if [ -n "${TARGET}" ]; then
            "${COMPILER_BIN}" b --target windows --arch x86_64 "${TARGET}" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out.exe"
            echo "Built ${ROOT_DIR}/tmp/out.exe"
        else
            "${COMPILER_BIN}" b --target windows --arch x86_64 "${ROOT_DIR}/compiler/main.a" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/abyssc.exe"
            echo "Built ${ROOT_DIR}/abyssc.exe"
        fi
        ;;
    r-win|br-win)
        prepare_compiler
        TARGET="${1:-}"
        MINGW_CC="${MINGW_CC:-x86_64-w64-mingw32-gcc}"
        if [ -n "${TARGET}" ]; then
            "${COMPILER_BIN}" b --target windows --arch x86_64 "${TARGET}" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/tmp/out.exe"
            WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${ROOT_DIR}/tmp/out.exe"
        else
            "${COMPILER_BIN}" b --target windows --arch x86_64 "${ROOT_DIR}/compiler/main.a" "${ROOT_DIR}/tmp/out.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${ROOT_DIR}/tmp/out.c" -o "${ROOT_DIR}/abyssc.exe"
            WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${ROOT_DIR}/abyssc.exe"
        fi
        ;;
    test|t)
        prepare_compiler
        bash "${ROOT_DIR}/scripts/test_compiler.sh" "${ABYSS_COMPILER:-${COMPILER_BIN}}" "${1:-}"
        ;;
    test-all|t-all|test-full)
        prepare_compiler
        export ABYSS_TEST_FULL=true
        bash "${ROOT_DIR}/scripts/test_compiler.sh" "${ABYSS_COMPILER:-${COMPILER_BIN}}" "${1:-}"
        ;;
    test-win|twin)
        if ! command -v wine >/dev/null 2>&1; then
            echo "[ERROR] wine is required to run Windows tests."
            exit 1
        fi
        TARGET="${1:-}"
        WRAPPER="${ROOT_DIR}/tmp/wine_abyssc"
        cat << EOF > "${WRAPPER}"
#!/bin/sh
WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${ROOT_DIR}/dist/abyssc-windows-x86_64.exe" "\$@"
EOF
        chmod +x "${WRAPPER}"
        ABYSS_TEST_WINE=true bash "${ROOT_DIR}/scripts/test_compiler.sh" "${WRAPPER}" "${TARGET}"
        ;;
    bootstrap|test-bootstrap)
        prepare_compiler
        ABYSS_COMPILER="${ABYSS_COMPILER:-${COMPILER_BIN}}" bash "${ROOT_DIR}/scripts/bootstrap.sh" "$@"
        ;;
    promote)
        ROUNDS="${1:-3}"
        export PROMOTE=true
        prepare_compiler
        ABYSS_COMPILER="${ABYSS_COMPILER:-${COMPILER_BIN}}" bash "${ROOT_DIR}/scripts/bootstrap.sh" "${ROUNDS}"
        ;;
    wasm|b-wasm)
        prepare_compiler
        build_wasi
        ;;
    release)
        ROUNDS="${1:-3}"
        export ABYSS_DEV="${ROOT_DIR}"
        prepare_compiler
        ABYSS_COMPILER="${COMPILER_BIN}" bash "${ROOT_DIR}/scripts/bootstrap.sh" "${ROUNDS}"
        DIST_DIR="${ROOT_DIR}/dist"
        mkdir -p "${DIST_DIR}"
        "${COMPILER_BIN}" b "${ROOT_DIR}/compiler/main.a" "${DIST_DIR}/bootstrap.c"
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -fomit-frame-pointer "${DIST_DIR}/bootstrap.c" -o "${DIST_DIR}/abyssc-linux-x86_64"

        echo "Verifying Linux release compiler..."
        "${DIST_DIR}/abyssc-linux-x86_64" r "${ROOT_DIR}/tests/01_literals.a" >/dev/null 2>&1
        echo "✔ Linux x86_64 compiler verified!"

        echo "Building Linux Sonar package manager..."
        "${COMPILER_BIN}" --map json="${ROOT_DIR}/pods/json/json" b "${ROOT_DIR}/pods/sonar/main.a" "${DIST_DIR}/sonar_bootstrap.c"
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -fomit-frame-pointer -Wno-error=incompatible-pointer-types -Wno-implicit-function-declaration -Wno-builtin-declaration-mismatch -Wno-error=builtin-declaration-mismatch "${DIST_DIR}/sonar_bootstrap.c" -o "${DIST_DIR}/sonar-linux-x86_64"
        cp "${DIST_DIR}/sonar-linux-x86_64" "${ROOT_DIR}/sonar"

        echo "Building Linux Abyssfmt code formatter..."
        "${COMPILER_BIN}" b "${ROOT_DIR}/pods/fmt/main.a" "${DIST_DIR}/fmt_bootstrap.c"
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -fomit-frame-pointer -Wno-error=incompatible-pointer-types -Wno-implicit-function-declaration "${DIST_DIR}/fmt_bootstrap.c" -o "${DIST_DIR}/abyssfmt-linux-x86_64"
        cp "${DIST_DIR}/abyssfmt-linux-x86_64" "${ROOT_DIR}/abyssfmt"

        echo "Verifying Linux release tools and pods..."
        "${COMPILER_BIN}" --map json="${ROOT_DIR}/pods/json/json" r "${ROOT_DIR}/pods/sonar/test_sonar.a" >/dev/null 2>&1
        "${DIST_DIR}/sonar-linux-x86_64" help >/dev/null 2>&1
        "${DIST_DIR}/abyssfmt-linux-x86_64" --help >/dev/null 2>&1
        bash "${ROOT_DIR}/scripts/test_pods.sh" "${DIST_DIR}/abyssc-linux-x86_64"
        echo "✔ Linux x86_64 tools (abyssc, sonar, abyssfmt) and pods verified!"

        MINGW_CC="${MINGW_CC:-x86_64-w64-mingw32-gcc}"
        if command -v "${MINGW_CC}" >/dev/null 2>&1; then
            echo "Cross-compiling Windows release binaries with ${MINGW_CC}..."
            "${COMPILER_BIN}" b --target windows --arch x86_64 "${ROOT_DIR}/compiler/main.a" "${DIST_DIR}/windows_bootstrap.c"
            "${COMPILER_BIN}" --map json="${ROOT_DIR}/pods/json/json" b --target windows --arch x86_64 "${ROOT_DIR}/pods/sonar/main.a" "${DIST_DIR}/sonar_windows.c"
            "${COMPILER_BIN}" b --target windows --arch x86_64 "${ROOT_DIR}/pods/fmt/main.a" "${DIST_DIR}/fmt_windows.c"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer "${DIST_DIR}/windows_bootstrap.c" -o "${DIST_DIR}/abyssc-windows-x86_64.exe"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer -Wno-error=incompatible-pointer-types -Wno-implicit-function-declaration -Wno-builtin-declaration-mismatch -Wno-error=builtin-declaration-mismatch "${DIST_DIR}/sonar_windows.c" -o "${DIST_DIR}/sonar-windows-x86_64.exe"
            "${MINGW_CC}" -std=gnu99 -O3 -fomit-frame-pointer -Wno-error=incompatible-pointer-types -Wno-implicit-function-declaration "${DIST_DIR}/fmt_windows.c" -o "${DIST_DIR}/abyssfmt-windows-x86_64.exe"
            if command -v wine >/dev/null 2>&1; then
                echo "Verifying Windows binaries with Wine..."
                WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${DIST_DIR}/abyssc-windows-x86_64.exe" r "${ROOT_DIR}/tests/01_literals.a" >/dev/null 2>&1
                WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${DIST_DIR}/abyssc-windows-x86_64.exe" b "${ROOT_DIR}/tests/01_literals.a" "${ROOT_DIR}/tmp/win_verify.c" >/dev/null 2>&1
                WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${DIST_DIR}/sonar-windows-x86_64.exe" help >/dev/null 2>&1
                WINEDEBUG=-all WINEPREFIX="${ROOT_DIR}/tmp/.wine" wine "${DIST_DIR}/abyssfmt-windows-x86_64.exe" --help >/dev/null 2>&1
                echo "✔ Windows x86_64 binaries (abyssc.exe + sonar.exe + abyssfmt.exe) verified via Wine!"
            fi
        fi

        if command -v clang >/dev/null 2>&1; then
            build_wasi
        fi

        echo "Packaging release bundles..."
        LINUX_BUNDLE="${ROOT_DIR}/tmp/abyss"
        rm -rf "${LINUX_BUNDLE}"
        mkdir -p "${LINUX_BUNDLE}/bin"
        cp "${DIST_DIR}/abyssc-linux-x86_64" "${LINUX_BUNDLE}/bin/abyssc"
        cp "${DIST_DIR}/sonar-linux-x86_64" "${LINUX_BUNDLE}/bin/sonar"
        cp "${DIST_DIR}/abyssfmt-linux-x86_64" "${LINUX_BUNDLE}/bin/abyssfmt"
        ln -sf abyssfmt "${LINUX_BUNDLE}/bin/abyss-fmt"
        tar --exclude=.vendor -C "${ROOT_DIR}" -cf - pods | tar -xf - -C "${LINUX_BUNDLE}"
        cp "${ROOT_DIR}/README.md" "${LINUX_BUNDLE}/" 2>/dev/null || true
        cp "${ROOT_DIR}/LICENSE" "${LINUX_BUNDLE}/" 2>/dev/null || true
        tar -czf "${DIST_DIR}/abyss-linux-x86_64.tar.gz" -C "${ROOT_DIR}/tmp" "abyss"
        rm -rf "${LINUX_BUNDLE}"

        if [ -f "${DIST_DIR}/abyssc-windows-x86_64.exe" ] && [ -f "${DIST_DIR}/sonar-windows-x86_64.exe" ] && [ -f "${DIST_DIR}/abyssfmt-windows-x86_64.exe" ]; then
            WIN_BUNDLE="${ROOT_DIR}/tmp/abyss"
            rm -rf "${WIN_BUNDLE}"
            mkdir -p "${WIN_BUNDLE}/bin"
            cp "${DIST_DIR}/abyssc-windows-x86_64.exe" "${WIN_BUNDLE}/bin/abyssc.exe"
            cp "${DIST_DIR}/sonar-windows-x86_64.exe" "${WIN_BUNDLE}/bin/sonar.exe"
            cp "${DIST_DIR}/abyssfmt-windows-x86_64.exe" "${WIN_BUNDLE}/bin/abyssfmt.exe"
            cp "${DIST_DIR}/abyssfmt-windows-x86_64.exe" "${WIN_BUNDLE}/bin/abyss-fmt.exe"
            tar --exclude=.vendor -C "${ROOT_DIR}" -cf - pods | tar -xf - -C "${WIN_BUNDLE}"
            cp "${ROOT_DIR}/README.md" "${WIN_BUNDLE}/" 2>/dev/null || true
            cp "${ROOT_DIR}/LICENSE" "${WIN_BUNDLE}/" 2>/dev/null || true
            (cd "${ROOT_DIR}/tmp" && zip -rq "${DIST_DIR}/abyss-windows-x86_64.zip" "abyss")
            rm -rf "${WIN_BUNDLE}"
        fi

        (cd "${DIST_DIR}" && sha256sum abyss-linux-x86_64.tar.gz > abyss-linux-x86_64.tar.gz.sha256 2>/dev/null || true)
        if [ -f "${DIST_DIR}/abyss-windows-x86_64.zip" ]; then
            (cd "${DIST_DIR}" && sha256sum abyss-windows-x86_64.zip > abyss-windows-x86_64.zip.sha256 2>/dev/null || true)
        fi

        echo "Packaging multi-platform C bootstrap bundle..."
        "${COMPILER_BIN}" b --target darwin --arch x86_64 "${ROOT_DIR}/compiler/main.a" "${DIST_DIR}/darwin_bootstrap.c"
        "${COMPILER_BIN}" b --target darwin --arch aarch64 "${ROOT_DIR}/compiler/main.a" "${DIST_DIR}/darwin_arm_bootstrap.c"
        BOOTSTRAP_BUNDLE="${ROOT_DIR}/tmp/abyss-bootstrap-c"
        rm -rf "${BOOTSTRAP_BUNDLE}"
        mkdir -p "${BOOTSTRAP_BUNDLE}"
        cp "${DIST_DIR}/bootstrap.c" "${BOOTSTRAP_BUNDLE}/bootstrap-linux-x86_64.c"
        if [ -f "${DIST_DIR}/windows_bootstrap.c" ]; then
            cp "${DIST_DIR}/windows_bootstrap.c" "${BOOTSTRAP_BUNDLE}/bootstrap-windows-x86_64.c"
        else
            "${COMPILER_BIN}" b --target windows --arch x86_64 "${ROOT_DIR}/compiler/main.a" "${BOOTSTRAP_BUNDLE}/bootstrap-windows-x86_64.c"
        fi
        cp "${DIST_DIR}/darwin_bootstrap.c" "${BOOTSTRAP_BUNDLE}/bootstrap-darwin-x86_64.c"
        cp "${DIST_DIR}/darwin_arm_bootstrap.c" "${BOOTSTRAP_BUNDLE}/bootstrap-darwin-aarch64.c"
        if [ -f "${DIST_DIR}/abyssc-wasi.c" ]; then
            cp "${DIST_DIR}/abyssc-wasi.c" "${BOOTSTRAP_BUNDLE}/bootstrap-wasi.c"
        else
            "${COMPILER_BIN}" b --target wasi "${ROOT_DIR}/compiler/main.a" "${BOOTSTRAP_BUNDLE}/bootstrap-wasi.c"
        fi
        cat << 'EOF' > "${BOOTSTRAP_BUNDLE}/README.md"
# Abyss C Bootstrap Sources

Standalone ISO C99 source files to bootstrap the Abyss compiler (`abyssc`) on any platform without an existing binary.

## Compiling

- **Linux (x86_64):**
  `gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -fomit-frame-pointer bootstrap-linux-x86_64.c -o abyssc`

- **macOS (Darwin x86_64 / arm64):**
  `clang -std=c99 -D_POSIX_C_SOURCE=200809L -O3 -fomit-frame-pointer "bootstrap-darwin-$(uname -m | sed s/arm64/aarch64/).c" -o abyssc`

- **Windows (x86_64):**
  `gcc -std=gnu99 -O3 -fomit-frame-pointer bootstrap-windows-x86_64.c -o abyssc.exe`

- **WebAssembly (WASI):**
  `clang --target=wasm32-wasi -ffreestanding -nostdlib -O3 -Wl,-z,stack-size=2097152 bootstrap-wasi.c -o abyssc.wasm`
EOF
        tar -czf "${DIST_DIR}/abyss-bootstrap-c.tar.gz" -C "${ROOT_DIR}/tmp" "abyss-bootstrap-c"
        rm -rf "${BOOTSTRAP_BUNDLE}"
        (cd "${DIST_DIR}" && sha256sum abyss-bootstrap-c.tar.gz > abyss-bootstrap-c.tar.gz.sha256 2>/dev/null || true)

        echo "Release artifacts generated in ${DIST_DIR}:"
        ls -lh "${DIST_DIR}"
        ;;
    fmt)
        if [ -x "${ROOT_DIR}/abyssfmt" ]; then
            "${ROOT_DIR}/abyssfmt" "$@"
        else
            prepare_compiler
            "${COMPILER_BIN}" r "${ROOT_DIR}/pods/fmt/main.a" "$@"
        fi
        ;;
    b-fmt)
        prepare_compiler
        "${COMPILER_BIN}" b "${ROOT_DIR}/pods/fmt/main.a" "${ROOT_DIR}/tmp/fmt.c"
        gcc -std=gnu99 -D_POSIX_C_SOURCE=200809L -O3 -fomit-frame-pointer -Wno-error=incompatible-pointer-types -Wno-implicit-function-declaration "${ROOT_DIR}/tmp/fmt.c" -o "${ROOT_DIR}/abyssfmt"
        echo "Built ${ROOT_DIR}/abyssfmt"
        ;;
    sonar)
        CALLER_DIR="${ORIG_PWD}"
        prepare_compiler
        cd "${CALLER_DIR}"
        export ABYSS_COMPILER="${COMPILER_BIN}"
        if [ -x "${ROOT_DIR}/sonar" ]; then
            "${ROOT_DIR}/sonar" "$@"
        else
            "${COMPILER_BIN}" --map json="${ROOT_DIR}/pods/json/json" r "${ROOT_DIR}/pods/sonar/main.a" "$@"
        fi
        ;;
    sonar-test)
        prepare_compiler
        "${COMPILER_BIN}" --map json="${ROOT_DIR}/pods/json/json" r "${ROOT_DIR}/pods/sonar/test_sonar.a" "$@"
        ;;
    test-pods|pods-test)
        prepare_compiler
        bash "${ROOT_DIR}/scripts/test_pods.sh" "${ABYSS_COMPILER:-${COMPILER_BIN}}"
        ;;
    clean)
        rm -rf "${ROOT_DIR}/tmp"/*
        echo "Cleaned tmp directory."
        ;;
    *)
        echo "Usage: ./abyss <command> [args]"
        echo ""
        echo "Commands:"
        echo "  r [file]          Run on VM (auto-rebuilds compiler if sources changed)"
        echo "  b [file]          Build in release mode (auto-rebuilds compiler if sources changed)"
        echo "  br [file]         Build and run in release mode"
        echo "  emit [args]       Run the compiler directly (supports --target, --arch and --library)"
        echo "  fmt [path]...     Format Abyss source files with abyssfmt"
        echo "  b-fmt             Build standalone native abyssfmt binary"
        echo "  sonar             Run Sonar package manager (init, vendor, build, run)"
        echo "  sonar-test        Run Sonar package manager test suite"
        echo "  test-pods         Run pod unit test suites (core, std, test, json, simd, fmt)"
        echo "  b-win [file]      Build Windows binary (default: abyssc.exe)"
        echo "  r-win [file]      Build and run Windows binary with wine"
        echo "  test [filter]     Run fast dev test suite (C + VM backends via TCC/GCC)"
        echo "  test-all [filter] Run full test suite (fixed-point, reflection, standalone, CLI)"
        echo "  test-win [filter] Run language test suite on Windows binary with wine"
        echo "  bootstrap [n]     Run multi-generation fixed-point stability test"
        echo "  promote [n]       Verify multi-stage bootstrap & tests then promote to ./abyssc"
        echo "  wasm              Build WebAssembly binary in dist/"
        echo "  release [n]       Build release packages in dist/ (bootstrap.c, Linux, Windows, Wasm)"
        echo "  clean             Clean tmp build artifacts"
        exit 1
        ;;
esac

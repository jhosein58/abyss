import Str, String from "std/string"
import Arena from "std/allocator"
import Fmt from "std/fmt"
import TypeStorage, TyKind, ty_id_none from "./types"
import HirExprKind, hir_kind, hir_none from "./hir"
import fall from "std/sys"

print :: fn(s &u8)

append_str :: fn(v &String, s Str) {
    v.push_str(s)
}

append_char :: fn(v &String, c u8) {
    v.push_char(c)
}

append_u32 :: fn(v &String, n u32) {
    v.push_u32(n)
}

string_view :: fn(v &String) Str {
    v.as_str()
}

LoopCondition :: struct {
    id u32
    breaks bool
    continues bool
}

LoopScope :: struct {
    outer LoopCondition
    id u32
    breaks bool
    iterator bool
}

CCodeBuilder :: struct {
    new :: fn() Self { .{} }

    new_list :: fn(self &Self, arena &Arena) String {
        String.new(arena)
    }

    append_list_item :: fn(self &Self, list &String, value Str, first bool) {
        if not first { list.push_str(Str.of(", ")) }
        list.push_str(value)
    }

    finish_list :: fn(self &Self, list &String) Str {
        list.as_str()
    }
}

CCodeGen :: struct {
    arena           : &Arena,
    struct_decls    : String,
    struct_defs     : String,
    func_decls      : String,
    code            : String,
    emitted_structs : Vec(u32),
    main_sym        : u32,
    has_main        : bool,
    indent          : u32,
    loop_condition  : LoopCondition,
    temp_count      : u32,

    new :: fn(arena &Arena) Self {
        .{
            arena           : arena,
            struct_decls    : String.new(arena),
            struct_defs     : String.new(arena),
            func_decls      : String.new(arena),
            code            : String.new(arena),
            emitted_structs : Vec(u32).new(),
            main_sym        : 0,
            has_main        : false,
            indent          : 0,
            loop_condition  : .{ id: hir_none(), breaks: false, continues: false },
            temp_count      : 0
        }
    }

    destroy :: fn(self &Self) {
        self.emitted_structs.destroy()
    }

    empty_value :: fn(self &Self) Str { Str.empty() }

    is_vm :: fn(self &Self) bool { false }

    has_value :: fn(self &Self, value Str) bool { value.len > 0 }

    extern_name :: fn(self &Self, name Str) Str { name }

    expr_float :: fn(self &Self, raw Str) Str { raw }

    empty_parameters :: fn(self &Self) Str { Str.of("void") }

    parameter_name :: fn(self &Self, arena &Arena, index u32) Str {
        value := String.new(arena)
        value.push_str(Str.of("_a"))
        value.push_u32(index)
        value.as_str()
    }

    parameter :: fn(self &Self, arena &Arena, ty Str, name Str) Str {
        value := String.new(arena)
        value.push_str(ty)
        value.push_char(32 as u8)
        value.push_str(name)
        value.as_str()
    }

    indent_line :: fn(self &Self) {
        i: u32 = 0
        while i < self.indent {
            append_str(&self.code, Str.of("    "))
            i = i + 1
        }
    }

    abyss_main :: fn(self &Self, sym_id u32) {
        self.main_sym = sym_id
        self.has_main = true
    }

    reset_locals :: fn(self &Self) {
    }

    declare_function :: fn(self &Self, fn_name Str, ret_type Str, params Str) {
        append_str(&self.func_decls, ret_type)
        append_char(&self.func_decls, 32 as u8)
        append_str(&self.func_decls, fn_name)
        append_char(&self.func_decls, 40 as u8)
        append_str(&self.func_decls, params)
        append_str(&self.func_decls, Str.of(");\n"))
    }

    start_function :: fn(self &Self, fn_name Str, ret_type Str, params Str) {
        self.declare_function(fn_name, ret_type, params)
        self.temp_count = 0

        append_str(&self.code, ret_type)
        append_char(&self.code, 32 as u8)
        append_str(&self.code, fn_name)
        append_char(&self.code, 40 as u8)
        append_str(&self.code, params)
        append_str(&self.code, Str.of(") {\n"))
        self.indent = self.indent + 1
    }

    end_function :: fn(self &Self) {
        if self.indent > 0 {
            self.indent = self.indent - 1
        }
        append_str(&self.code, Str.of("}\n\n"))
    }

    begin_inline_scope :: fn(self &Self) {
        self.indent_line()
        append_str(&self.code, Str.of("{\n"))
        self.indent = self.indent + 1
    }

    end_inline_scope :: fn(self &Self) {
        self.indent = self.indent - 1
        self.indent_line()
        append_str(&self.code, Str.of("}\n"))
    }

    create_variable :: fn(self &Self, name Str, ty Str, init_val Str, has_init bool) {
        self.indent_line()
        append_str(&self.code, ty)
        append_char(&self.code, 32 as u8)
        append_str(&self.code, name)
        if has_init {
            append_str(&self.code, Str.of(" = "))
            append_str(&self.code, init_val)
        } else {
            append_str(&self.code, Str.of(" = {0}"))
        }
        append_str(&self.code, Str.of(";\n"))
    }

    new_temp :: fn(self &Self, arena &Arena, ty Str) Str {
        self.temp_count = self.temp_count + 1
        fmt := Fmt.new(arena)
        fmt.cstr(c"_t").uint32(self.temp_count)
        name := fmt.as_str()
        self.create_variable(name, ty, Str.empty(), false)
        name
    }

    expr :: fn(self &Self, e Str) {
        if e.len == 0 { ret }
        self.indent_line()
        append_str(&self.code, e)
        append_str(&self.code, Str.of(";\n"))
    }

    gen_return :: fn(self &Self, val Str, has_val bool) {
        self.indent_line()
        append_str(&self.code, Str.of("return"))
        if has_val and (val.len > 0) {
            append_char(&self.code, 32 as u8)
            append_str(&self.code, val)
        }
        append_str(&self.code, Str.of(";\n"))
    }

    start_if :: fn(self &Self, cond Str) {
        self.indent_line()
        append_str(&self.code, Str.of("if ("))
        append_str(&self.code, cond)
        append_str(&self.code, Str.of(") {\n"))
        self.indent = self.indent + 1
    }

    else_ :: fn(self &Self) {
        if self.indent > 0 {
            self.indent = self.indent - 1
        }
        self.indent_line()
        append_str(&self.code, Str.of("} else {\n"))
        self.indent = self.indent + 1
    }

    start_while :: fn(self &Self, cond Str) {
        self.indent_line()
        append_str(&self.code, Str.of("while ("))
        append_str(&self.code, cond)
        append_str(&self.code, Str.of(") {\n"))
        self.indent = self.indent + 1
    }

    end_block :: fn(self &Self) {
        if self.indent > 0 {
            self.indent = self.indent - 1
        }
        self.indent_line()
        append_str(&self.code, Str.of("}\n"))
    }

    loop_label :: fn(self &Self, arena &Arena, id u32, suffix Str) Str {
        fmt := Fmt.new(arena)
        fmt.sym(Str.of("_loop_"), id).str(suffix)
        fmt.as_str()
    }

    loop_begin_label :: fn(self &Self, arena &Arena, id u32) Str {
        self.loop_label(arena, id, Str.of("_begin"))
    }

    loop_end_label :: fn(self &Self, arena &Arena, id u32) Str {
        self.loop_label(arena, id, Str.of("_end"))
    }

    iterator_name :: fn(self &Self, arena &Arena, id u32, index u32) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"_for_").uint32(id).char(95 as u8).uint32(index)
        fmt.as_str()
    }

    iterator_next_name :: fn(self &Self, arena &Arena, id u32, index u32) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"_for_next_").uint32(id).char(95 as u8).uint32(index)
        fmt.as_str()
    }

    emit_label :: fn(self &Self, arena &Arena, label Str) {
        fmt := Fmt.new(arena)
        fmt.str(label).char(58 as u8)
        self.expr(fmt.as_str())
    }

    emit_goto :: fn(self &Self, arena &Arena, label Str) {
        fmt := Fmt.new(arena)
        fmt.cstr(c"goto ").str(label)
        self.expr(fmt.as_str())
    }

    emit_break :: fn(self &Self, arena &Arena) {
        if self.loop_condition.id == hir_none() {
            self.expr(Str.of("break"))
        } else {
            self.loop_condition.breaks = true
            self.emit_goto(arena, self.loop_label(arena, self.loop_condition.id, Str.of("_end")))
        }
    }

    emit_cont :: fn(self &Self, arena &Arena) {
        if self.loop_condition.id == hir_none() {
            self.expr(Str.of("continue"))
        } else {
            self.loop_condition.continues = true
            self.emit_goto(arena, self.loop_label(arena, self.loop_condition.id, Str.of("_begin")))
        }
    }

    break_statement :: fn(self &Self) {
        self.expr(Str.of("break"))
    }

    begin_loop :: fn(self &Self, id u32) LoopScope {
        scope: LoopScope = .{ outer: self.loop_condition, id: id, breaks: false, iterator: false }
        self.set_loop(id, false, false)
        scope
    }

    start_loop :: fn(self &Self, arena &Arena, scope &LoopScope) {
        scope.breaks = self.loop_condition.breaks
        continues := self.loop_condition.continues
        self.set_loop(hir_none(), false, false)
        if continues { self.emit_label(arena, self.loop_begin_label(arena, scope.id)) }
        self.start_while(self.expr_one(arena))
    }

    start_iterator_loop :: fn(self &Self, arena &Arena, scope &LoopScope) {
        scope.iterator = true
        self.start_while(self.expr_one(arena))
        self.emit_label(arena, self.loop_begin_label(arena, scope.id))
    }

    end_loop :: fn(self &Self, arena &Arena, scope &LoopScope) {
        breaks := scope.breaks
        if scope.iterator { breaks = self.loop_condition.breaks }
        self.end_block()
        if breaks { self.emit_label(arena, self.loop_end_label(arena, scope.id)) }
        self.loop_condition = scope.outer
    }

    loop_id :: fn(self &Self) u32 {
        self.loop_condition.id
    }

    loop_breaks :: fn(self &Self) bool {
        self.loop_condition.breaks
    }

    loop_continues :: fn(self &Self) bool {
        self.loop_condition.continues
    }

    set_loop :: fn(self &Self, id u32, breaks bool, continues bool) {
        self.loop_condition = .{ id: id, breaks: breaks, continues: continues }
    }

    decl_struct :: fn(self &Self, name Str) {
        append_str(&self.struct_decls, Str.of("typedef struct "))
        append_str(&self.struct_decls, name)
        append_char(&self.struct_decls, 32 as u8)
        append_str(&self.struct_decls, name)
        append_str(&self.struct_decls, Str.of(";\n"))
    }

    def_struct :: fn(self &Self, ty_id u32, name Str, body Str) {
        i: u64 = 0
        while i < self.emitted_structs.len {
            if self.emitted_structs.get(i) == ty_id {
                ret
            }
            i = i + 1
        }

        self.emitted_structs.push(ty_id)
        self.decl_struct(name)

        append_str(&self.struct_defs, Str.of("struct "))
        append_str(&self.struct_defs, name)
        append_str(&self.struct_defs, Str.of(" {\n"))
        append_str(&self.struct_defs, body)
        append_str(&self.struct_defs, Str.of("};\n\n"))
    }

    define_struct :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        i: u64 = 0
        while i < self.emitted_structs.len {
            if self.emitted_structs.get(i) == ty_id {
                ret
            }
            i = i + 1
        }

        s_name := TypeStorage.name(arena, ty_id)
        fmt := Fmt.new(arena)
        s_fields := (&(*types)).get_struct_fields(ty_id)
        f_count := s_fields.len / 2

        f_i: u64 = 0
        while f_i < f_count {
            fn_name := *(s_fields.ptr + (f_i * 2))
            fn_ty   := *(s_fields.ptr + (f_i * 2) + 1)
            fn_ty_str := self.type_str(types, arena, fn_ty)

            fmt.cstr(c"    ").str(fn_ty_str).cstr(c" _f").uint32(fn_name).cstr(c";\n")
            f_i = f_i + 1
        }

        self.def_struct(ty_id, s_name, fmt.as_str())
    }

    define_func_type :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        i: u64 = 0
        while i < self.emitted_structs.len {
            if self.emitted_structs.get(i) == ty_id {
                ret
            }
            i = i + 1
        }
        self.emitted_structs.push(ty_id)

        fn_name := TypeStorage.name(arena, ty_id)
        ret_ty := (&(*types)).func_return(ty_id)
        ret_str := self.type_str(types, arena, ret_ty)

        params := (&(*types)).func_params(ty_id)
        params_fmt := Fmt.new(arena)
        if params.len == 0 {
            params_fmt.cstr(c"void")
        } else {
            p_i: u64 = 0
            while p_i < params.len {
                p_ty := *(params.ptr + p_i)
                p_str := self.type_str(types, arena, p_ty)
                if p_i > 0 { params_fmt.cstr(c", ") }
                params_fmt.str(p_str)
                p_i = p_i + 1
            }
        }

        append_str(&self.struct_decls, Str.of("typedef "))
        append_str(&self.struct_decls, ret_str)
        append_str(&self.struct_decls, Str.of(" (*"))
        append_str(&self.struct_decls, fn_name)
        append_str(&self.struct_decls, Str.of(")("))
        append_str(&self.struct_decls, params_fmt.as_str())
        append_str(&self.struct_decls, Str.of(");\n"))
    }

    define_enum :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        i: u64 = 0
        while i < self.emitted_structs.len {
            if self.emitted_structs.get(i) == ty_id {
                ret
            }
            i = i + 1
        }
        self.emitted_structs.push(ty_id)

        e_name := TypeStorage.name(arena, ty_id)
        backing_ty := (&(*types)).enum_backing(ty_id)
        backing_str := self.type_str(types, arena, backing_ty)

        append_str(&self.struct_decls, Str.of("typedef "))
        append_str(&self.struct_decls, backing_str)
        append_char(&self.struct_decls, 32 as u8)
        append_str(&self.struct_decls, e_name)
        append_str(&self.struct_decls, Str.of(";\n"))
    }

    define_union :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        i: u64 = 0
        while i < self.emitted_structs.len {
            if self.emitted_structs.get(i) == ty_id {
                ret
            }
            i = i + 1
        }
        self.emitted_structs.push(ty_id)

        u_name := TypeStorage.name(arena, ty_id)
        self.decl_struct(u_name)

        members := (&(*types)).union_members(ty_id)
        fmt := Fmt.new(arena)
        fmt.cstr(c"    uint32_t tag;\n    union {\n")
        m_i: u64 = 0
        while m_i < members.len {
            m_ty := *(members.ptr + m_i)
            m_str := self.type_str(types, arena, m_ty)
            fmt.cstr(c"        ").str(m_str).cstr(c" _v").uint32(m_i as u32).cstr(c";\n")
            m_i = m_i + 1
        }
        fmt.cstr(c"    } val;\n")

        append_str(&self.struct_defs, Str.of("struct "))
        append_str(&self.struct_defs, u_name)
        append_str(&self.struct_defs, Str.of(" {\n"))
        append_str(&self.struct_defs, fmt.as_str())
        append_str(&self.struct_defs, Str.of("};\n\n"))
    }

    define_array :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        i: u64 = 0
        while i < self.emitted_structs.len {
            if self.emitted_structs.get(i) == ty_id {
                ret
            }
            i = i + 1
        }
        self.emitted_structs.push(ty_id)

        a_name := TypeStorage.name(arena, ty_id)
        self.decl_struct(a_name)

        elem_ty := (&(*types)).get_array_type(ty_id)
        elem_len := (&(*types)).get_array_len(ty_id)
        elem_str := self.type_str(types, arena, elem_ty)

        fmt := Fmt.new(arena)
        fmt.cstr(c"    ").str(elem_str).cstr(c" _v[").uint32(elem_len).cstr(c"];\n")

        append_str(&self.struct_defs, Str.of("struct "))
        append_str(&self.struct_defs, a_name)
        append_str(&self.struct_defs, Str.of(" {\n"))
        append_str(&self.struct_defs, fmt.as_str())
        append_str(&self.struct_defs, Str.of("};\n\n"))
    }

    finish :: fn(self &Self, pre Str) Str {
        out := String.new(self.arena)

        append_str(&out, pre)

        append_str(&out, Str.of("// Struct Declarations\n"))
        append_str(&out, string_view(&self.struct_decls))
        append_str(&out, Str.of("\n// Struct Definitions\n"))
        append_str(&out, string_view(&self.struct_defs))
        append_str(&out, Str.of("\n// Forward Declarations\n"))
        append_str(&out, string_view(&self.func_decls))
        append_str(&out, Str.of("\n// Implementations\n"))

        append_str(&out, string_view(&self.code))

        if self.has_main {
            append_str(&out, Str.of("int main(int argc, char **argv) {\n    abyss_argc = argc;\n    abyss_argv = argv;\n    sym_"))
            append_u32(&out, self.main_sym)
            append_str(&out, Str.of("();\n    return 0;\n}\n"))
        }

        string_view(&out)
    }

    type_str :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) Str {
        if ty_id == ty_id_none() {
            print(c"\n[codegen error] missing type\n")
            fall()
        }
        kind := types.kind(ty_id)
        payload := types.payload(ty_id)

        if kind == TyKind.unit { ret Str.of("void") }
        if kind == TyKind.bool { ret Str.of("bool") }
        if kind == TyKind.type_ { ret Str.of("uint32_t") }

        if kind == TyKind.int {
            if payload == 8   { ret Str.of("int8_t") }
            if payload == 16  { ret Str.of("int16_t") }
            if payload == 32  { ret Str.of("int32_t") }
            if payload == 64  { ret Str.of("int64_t") }
            if payload == 128 { ret Str.of("__int128") }
            print(c"\n[codegen error] unsupported integer width\n")
            fall()
            ret Str.empty()
        }

        if kind == TyKind.uint {
            if payload == 8   { ret Str.of("uint8_t") }
            if payload == 16  { ret Str.of("uint16_t") }
            if payload == 32  { ret Str.of("uint32_t") }
            if payload == 64  { ret Str.of("uint64_t") }
            if payload == 128 { ret Str.of("unsigned __int128") }
            print(c"\n[codegen error] unsupported integer width\n")
            fall()
            ret Str.empty()
        }

        if kind == TyKind.float {
            if payload == 32 { ret Str.of("float") }
            if payload == 64 { ret Str.of("double") }
            print(c"\n[codegen error] unsupported float width\n")
            fall()
            ret Str.empty()
        }

        if kind == TyKind.untyped_int   { ret Str.of("int32_t") }
        if kind == TyKind.untyped_float { ret Str.of("double") }

        if kind == TyKind.ptr {
            inner_ty := types.payload(ty_id)
            inner_str := self.type_str(types, arena, inner_ty)
            fmt := Fmt.new(arena)
            fmt.str(inner_str).cstr(c"*")
            ret fmt.as_str()
        }

        if (kind == TyKind.struct_) or (kind == TyKind.nominal) or (kind == TyKind.func) or (kind == TyKind.enum_) or (kind == TyKind.union_) or (kind == TyKind.array) {
            ret TypeStorage.name(arena, ty_id)
        }

        if (kind == TyKind.infer) or (kind == TyKind.unknown) or (kind == TyKind.error) {
            print(c"\n[codegen error] unresolved type\n")
            fall()
        }

        print(c"\n[codegen error] unsupported type\n")
        fall()
        Str.empty()
    }

    sym_name :: fn(self &Self, arena &Arena, sym_id u32) Str {
        fmt := Fmt.new(arena)
        fmt.sym(Str.of("sym_"), sym_id)
        fmt.as_str()
    }

    field_name :: fn(self &Self, arena &Arena, field_id u32) Str {
        fmt := Fmt.new(arena)
        fmt.sym(Str.of("_f"), field_id)
        fmt.as_str()
    }

    expr_int :: fn(self &Self, arena &Arena, val u32) Str {
        fmt := Fmt.new(arena)
        fmt.uint32(val)
        fmt.as_str()
    }

    expr_float_from_int :: fn(self &Self, arena &Arena, val u32, ty_id u32) Str {
        self.expr_int(arena, val)
    }

    expr_one :: fn(self &Self, arena &Arena) Str {
        self.expr_int(arena, 1)
    }

    format_raw_str :: fn(arena &Arena, raw Str) Str {
        if (raw.len < 2) or (*(raw.ptr) != 96) { ret raw }
        fmt := Fmt.new(arena)
        fmt.cstr(c"\"")
        i: u64 = 1
        end := raw.len - 1
        while i < end {
            c := *(raw.ptr + i)
            if c == 10 {
                fmt.cstr(c"\\n")
            } else if c == 13 {
                fmt.cstr(c"\\r")
            } else if c == 9 {
                fmt.cstr(c"\\t")
            } else if c == 34 {
                fmt.cstr(c"\\\"")
            } else if c == 92 {
                if (i + 1 < end) and (*(raw.ptr + i + 1) == 96) {
                    fmt.char(96 as u8)
                    i = i + 1
                } else {
                    fmt.cstr(c"\\\\")
                }
            } else {
                fmt.char(c)
            }
            i = i + 1
        }
        fmt.cstr(c"\"")
        fmt.as_str()
    }

    expr_str_lit :: fn(self &Self, arena &Arena, struct_name Str, ptr_id u32, len_id u32, raw Str) Str {
        c_raw := raw
        if (raw.len >= 2) and (*(raw.ptr) == 96) {
            c_raw = Self.format_raw_str(arena, raw)
        }
        fmt := Fmt.new(arena)
        if struct_name.len == 0 {
            fmt.wrap(Str.of("((uint8_t*)"), c_raw, Str.of(")"))
            ret fmt.as_str()
        }
        fmt.cstr(c"((").str(struct_name).cstr(c"){._f").uint32(ptr_id).cstr(c" = ((uint8_t*)").str(c_raw).cstr(c"), ._f").uint32(len_id).cstr(c" = (sizeof(").str(c_raw).cstr(c") - 1)})")
        fmt.as_str()
    }

    expr_char_lit :: fn(self &Self, arena &Arena, raw Str) Str {
        fmt := Fmt.new(arena)
        fmt.wrap(Str.of("((uint8_t)"), raw, Str.of(")"))
        fmt.as_str()
    }

    expr_cstr_lit :: fn(self &Self, arena &Arena, raw Str) Str {
        c_raw := raw
        if (raw.len >= 2) and (*(raw.ptr) == 99) {
            c_raw = raw.sub(1, raw.len - 1)
        } else if (raw.len >= 2) and (*(raw.ptr) == 96) {
            c_raw = Self.format_raw_str(arena, raw)
        }
        fmt := Fmt.new(arena)
        fmt.wrap(Str.of("((uint8_t*)"), c_raw, Str.of(")"))
        fmt.as_str()
    }

    expr_bool :: fn(self &Self, val bool) Str {
        if val {
            ret Str.of("true")
        }
        Str.of("false")
    }

    expr_assign :: fn(self &Self, arena &Arena, lhs Str, rhs Str) Str {
        fmt := Fmt.new(arena)
        fmt.str(lhs).cstr(c" = ").str(rhs)
        fmt.as_str()
    }

    expr_binary :: fn(self &Self, arena &Arena, op Str, lhs Str, rhs Str) Str {
        fmt := Fmt.new(arena)
        fmt.binary(op, lhs, rhs)
        fmt.as_str()
    }

    expr_zero :: fn(self &Self, arena &Arena, ty Str) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"((").str(ty).cstr(c"){0})")
        fmt.as_str()
    }

    expr_unary :: fn(self &Self, arena &Arena, op Str, inner Str) Str {
        fmt := Fmt.new(arena)
        fmt.char(40 as u8).str(op).char(40 as u8).str(inner).cstr(c"))")
        fmt.as_str()
    }

    expr_neg :: fn(self &Self, arena &Arena, inner Str) Str {
        self.expr_unary(arena, Str.of("-"), inner)
    }

    expr_not :: fn(self &Self, arena &Arena, inner Str) Str {
        self.expr_unary(arena, Str.of("!"), inner)
    }

    expr_bit_not :: fn(self &Self, arena &Arena, inner Str) Str {
        self.expr_unary(arena, Str.of("~"), inner)
    }

    expr_typed_address :: fn(self &Self, arena &Arena, inner Str, ty u32) Str {
        self.expr_address(arena, inner)
    }

    expr_address :: fn(self &Self, arena &Arena, inner Str) Str {
        self.expr_unary(arena, Str.of("&"), inner)
    }

    expr_deref :: fn(self &Self, arena &Arena, inner Str) Str {
        self.expr_unary(arena, Str.of("*"), inner)
    }

    expr_str_deref :: fn(self &Self, arena &Arena, inner Str, ptr_id u32) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"(*(").str(inner).cstr(c"._f").uint32(ptr_id).cstr(c"))")
        fmt.as_str()
    }

    expr_cast :: fn(self &Self, arena &Arena, ty_str Str, inner Str) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"((").str(ty_str).cstr(c")").str(inner).char(41 as u8)
        fmt.as_str()
    }

    expr_call :: fn(self &Self, arena &Arena, callee Str, args Str) Str {
        fmt := Fmt.new(arena)
        fmt.str(callee).char(40 as u8).str(args).char(41 as u8)
        fmt.as_str()
    }

    expr_typed_member :: fn(self &Self, arena &Arena, lhs Str, depth u32, field_id u32, struct_ty u32) Str {
        self.expr_member(arena, lhs, depth, field_id)
    }

    expr_member :: fn(self &Self, arena &Arena, lhs Str, depth u32, field_id u32) Str {
        fmt := Fmt.new(arena)
        fmt.char(40 as u8)
        d := depth
        while d > 0 {
            fmt.cstr(c"*(")
            d = d - 1
        }
        fmt.str(lhs)
        d = depth
        while d > 0 {
            fmt.char(41 as u8)
            d = d - 1
        }
        fmt.cstr(c")._f").uint32(field_id)
        fmt.as_str()
    }

    expr_struct_init_field :: fn(self &Self, arena &Arena, field_id u32, val_str Str) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"._f").uint32(field_id).cstr(c" = ").str(val_str)
        fmt.as_str()
    }

    expr_struct_init :: fn(self &Self, arena &Arena, struct_name Str, fields_body Str) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"((").str(struct_name).cstr(c"){").str(fields_body).cstr(c"})")
        fmt.as_str()
    }

    expr_comptime_pointer :: fn(self &Self, arena &Arena, value u64) Str {
        Str.empty()
    }

    expr_sizeof :: fn(self &Self, arena &Arena, ty Str) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"((uint64_t)sizeof(").str(ty).cstr(c"))")
        fmt.as_str()
    }

    expr_union :: fn(self &Self, arena &Arena, union_name Str, tag u32, value Str) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"((").str(union_name).cstr(c"){ .tag = ").uint32(tag).cstr(c", .val = { ._v").uint32(tag).cstr(c" = ").str(value).cstr(c" } })")
        fmt.as_str()
    }

    expr_union_member :: fn(self &Self, arena &Arena, value Str, tag u32) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"((").str(value).cstr(c").val._v").uint32(tag).cstr(c")")
        fmt.as_str()
    }

    expr_union_tag :: fn(self &Self, arena &Arena, value Str) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"((").str(value).cstr(c").tag)")
        fmt.as_str()
    }

    expr_union_is :: fn(self &Self, arena &Arena, value Str, tag u32) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"(").str(self.expr_union_tag(arena, value)).cstr(c" == ").uint32(tag).cstr(c")")
        fmt.as_str()
    }

    expr_enum_value :: fn(self &Self, arena &Arena, enum_name Str, value u32) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"((").str(enum_name).cstr(c")").uint32(value).cstr(c")")
        fmt.as_str()
    }

    expr_address_of_value :: fn(self &Self, arena &Arena, ty Str, value Str) Str {
        fmt := Fmt.new(arena)
        fmt.cstr(c"&((").str(ty).cstr(c"[]){").str(value).cstr(c"})[0]")
        fmt.as_str()
    }

    expr_field_value :: fn(self &Self, arena &Arena, value Str, field_id u32) Str {
        self.expr_member(arena, value, 0, field_id)
    }

    expr_index :: fn(self &Self, arena &Arena, value Str, index Str) Str {
        fmt := Fmt.new(arena)
        fmt.char(40 as u8).str(value).char(91 as u8).str(index).char(93 as u8).char(41 as u8)
        fmt.as_str()
    }

    expr_array_index :: fn(self &Self, arena &Arena, value Str, index Str, elem_ty u32, is_ptr bool) Str {
        fmt := Fmt.new(arena)
        if is_ptr {
            fmt.char(40 as u8).str(value).cstr(c"->_v[").str(index).cstr(c"])")
        } else {
            fmt.char(40 as u8).str(value).cstr(c"._v[").str(index).cstr(c"])")
        }
        fmt.as_str()
    }

    expr_slice_index :: fn(self &Self, arena &Arena, value Str, index Str, elem_ty u32, ptr_id u32) Str {
        fmt := Fmt.new(arena)
        fmt.char(40 as u8).str(value).cstr(c"._f").uint32(ptr_id).cstr(c"[").str(index).cstr(c"])")
        fmt.as_str()
    }

    expr_ptr_index :: fn(self &Self, arena &Arena, value Str, index Str, elem_ty u32) Str {
        fmt := Fmt.new(arena)
        fmt.char(40 as u8).str(value).cstr(c"[").str(index).cstr(c"])")
        fmt.as_str()
    }

    expr_array_init :: fn(self &Self, arena &Arena, arr_name Str, elems Str, elem_ty u32, count u32) Str {
        fmt := Fmt.new(arena)
        if count == 0 {
            fmt.cstr(c"((").str(arr_name).cstr(c"){ 0 })")
        } else {
            fmt.cstr(c"((").str(arr_name).cstr(c"){ { ").str(elems).cstr(c" } })")
        }
        fmt.as_str()
    }

    expr_array_init_elem :: fn(self &Self, arena &Arena, val Str) Str {
        val
    }

    append_list_item :: fn(self &Self, list &String, value Str, first bool) {
        if not first { list.push_str(Str.of(", ")) }
        list.push_str(value)
    }

    binary_op :: fn(self &Self, kind HirExprKind) Str {
        k := hir_kind
        if kind == k.binary_add     { ret Str.of(" + ") }
        if kind == k.binary_sub     { ret Str.of(" - ") }
        if kind == k.binary_mul     { ret Str.of(" * ") }
        if kind == k.binary_div     { ret Str.of(" / ") }
        if kind == k.binary_mod     { ret Str.of(" % ") }
        if kind == k.binary_eq_eq   { ret Str.of(" == ") }
        if kind == k.binary_neq     { ret Str.of(" != ") }
        if kind == k.binary_lt      { ret Str.of(" < ") }
        if kind == k.binary_gt      { ret Str.of(" > ") }
        if kind == k.binary_lt_eq   { ret Str.of(" <= ") }
        if kind == k.binary_gt_eq   { ret Str.of(" >= ") }
        if kind == k.binary_bit_and { ret Str.of(" & ") }
        if kind == k.binary_bit_or  { ret Str.of(" | ") }
        if kind == k.binary_bit_xor { ret Str.of(" ^ ") }
        if kind == k.binary_shl     { ret Str.of(" << ") }
        if kind == k.binary_shr     { ret Str.of(" >> ") }
        Str.of(" ")
    }

    expr_binary_kind :: fn(self &Self, arena &Arena, kind HirExprKind, lhs Str, rhs Str) Str {
        self.expr_binary(arena, self.binary_op(kind), lhs, rhs)
    }

    expr_equal :: fn(self &Self, arena &Arena, lhs Str, rhs Str) Str {
        self.expr_binary(arena, Str.of(" == "), lhs, rhs)
    }

    expr_or :: fn(self &Self, arena &Arena, lhs Str, rhs Str) Str {
        self.expr_binary(arena, Str.of(" || "), lhs, rhs)
    }

    expr_less_equal :: fn(self &Self, arena &Arena, lhs Str, rhs Str) Str {
        self.expr_binary(arena, Str.of(" <= "), lhs, rhs)
    }

    expr_add :: fn(self &Self, arena &Arena, lhs Str, rhs Str) Str {
        self.expr_binary(arena, Str.of(" + "), lhs, rhs)
    }
}

CCodeGen_finish :: fn(self &CCodeGen, pre Str) Str {
    self.finish(pre)
}

CCodeGen_new :: fn(arena &Arena) CCodeGen {
    CCodeGen.new(arena)
}

CCodeGen_destroy :: fn(self &CCodeGen) {
    self.destroy()
}

CCodeGen_abyss_main :: fn(self &CCodeGen, sym_id u32) {
    self.abyss_main(sym_id)
}

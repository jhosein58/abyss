import Vec from "std/collections/vec"
import id_none from "../nexus/pool"

ScopeEnv :: struct {
    names Vec(u32)
    syms  Vec(u32)

    new :: fn() ScopeEnv {
        .{
            names : Vec(u32).new(),
            syms  : Vec(u32).new()
        }
    }

    destroy :: fn(self &Self) {
        self.names.destroy()
        self.syms.destroy()
    }

    mark :: fn(self &Self) u32 {
        self.names.len as u32
    }

    define :: fn(self &Self, name_id u32, sym_id u32) {
        self.names.push(name_id)
        self.syms.push(sym_id)
    }

    reset :: fn(self &Self, mark u32) {
        self.names.reset(mark as u64)
        self.syms.reset(mark as u64)
    }

    lookup :: fn(self &Self, name_id u32) u32 {
        len := self.names.len
        if len == 0 {
            ret id_none()
        }

        i := len
        while i > 0 {
            i = i - 1
            n := self.names.get(i)
            if n == name_id {
                ret self.syms.get(i)
            }
        }

        id_none()
    }
}
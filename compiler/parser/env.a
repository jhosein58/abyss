import Vec from "std/collections/vec"
import id_none from "../nexus/pool"

ScopeEnv :: struct {
    names Vec(u32)
    syms  Vec(u32)

    new :: fn() ScopeEnv {
        .{
            names : Vec(u32).new(),
            syms  : Vec(u32).new()
        }
    }

    destroy :: fn() {
        .names.destroy()
        .syms.destroy()
    }

    mark :: fn() u32 {
        .names.len as u32
    }

    define :: fn(name_id u32, sym_id u32) {
        .names.push(name_id)
        .syms.push(sym_id)
    }

    reset :: fn(mark u32) {
        .names.reset(mark as u64)
        .syms.reset(mark as u64)
    }

    lookup :: fn(name_id u32) u32 {
        len := .names.len
        if len == 0 {
            ret id_none()
        }

        i := len
        while i > 0 {
            i = i - 1
            n := .names.get(i)
            if n == name_id {
                ret .syms.get(i)
            }
        }

        id_none()
    }
}
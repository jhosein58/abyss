import VecU32, VecU32_new, VecU32_destroy, VecU32_push, VecU32_get, VecU32_reset, VecU32_len from "../../../std/vec/u32.a"
import id_none from "../nexus/pool.a"

ScopeEnv :: struct {
    names : VecU32,
    syms  : VecU32
}

ScopeEnv_new :: () ScopeEnv {
    .{
        names : VecU32_new(),
        syms  : VecU32_new()
    }
}

ScopeEnv_destroy :: (self &ScopeEnv) {
    VecU32_destroy(&(*self).names)
    VecU32_destroy(&(*self).syms)
}

ScopeEnv_mark :: (self &ScopeEnv) u32 {
    VecU32_len(&(*self).names) as u32
}

ScopeEnv_define :: (self &ScopeEnv, name_id u32, sym_id u32) {
    VecU32_push(&(*self).names, name_id)
    VecU32_push(&(*self).syms, sym_id)
}

ScopeEnv_reset :: (self &ScopeEnv, mark u32) {
    VecU32_reset(&(*self).names, mark as u64)
    VecU32_reset(&(*self).syms, mark as u64)
}

ScopeEnv_lookup :: (self &ScopeEnv, name_id u32) u32 {
    len := VecU32_len(&(*self).names)
    if len == 0 {
        ret id_none()
    }

    i := len
    while i > 0 {
        i = i - 1
        n := VecU32_get(&(*self).names, i)
        if n == name_id {
            ret VecU32_get(&(*self).syms, i)
        }
    }

    id_none()
}
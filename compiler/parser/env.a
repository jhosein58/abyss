import VecU32 from "../../std/vec/u32.a"
import id_none from "../nexus/pool.a"

ScopeEnv :: struct {
    names : VecU32,
    syms  : VecU32
}

ScopeEnv_new :: () ScopeEnv {
    .{
        names : VecU32.new(),
        syms  : VecU32.new()
    }
}

ScopeEnv_destroy :: (self &ScopeEnv) {
    self.names.destroy()
    self.syms.destroy()
}

ScopeEnv_mark :: (self &ScopeEnv) u32 {
    self.names.len as u32
}

ScopeEnv_define :: (self &ScopeEnv, name_id u32, sym_id u32) {
    (*self).names.push(name_id)
    (*self).syms.push(sym_id)
}

ScopeEnv_reset :: (self &ScopeEnv, mark u32) {
    (*self).names.reset(mark as u64)
    (*self).syms.reset(mark as u64)
}

ScopeEnv_lookup :: (self &ScopeEnv, name_id u32) u32 {
    len := self.names.len
    if len == 0 {
        ret id_none()
    }

    i := len
    while i > 0 {
        i = i - 1
        n := (*self).names.get(i)
        if n == name_id {
            ret (*self).syms.get(i)
        }
    }

    id_none()
}
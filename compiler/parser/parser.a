hir :: @import("compiler/hir")
span_merge :: @import("compiler/nexus/nexus").span_merge
id_none :: @import("compiler/nexus/pool").id_none
Token :: @import("compiler/token").Token
parse_common :: @import("./common")
parse :: @import("./core")
decl :: @import("./decl")
expressions :: @import("./expr")
precedence :: @import("./prec")
stmt :: @import("./stmt")

parse_file :: fn(p &parse.Parser) {
    p.file_scope = true
    db := p.db
    while not parse.is_eof(p) {
        if parse.peek(p) == Token.comma {
            parse.parse_error_at(p, c"expected declaration before ','", parse.curr_span(p))
        }
        if not parse.begins_declaration(p) {
            parse.parse_error_at(p, c"expected a top-level declaration", parse.curr_span(p))
        }
        name := db.interner.intern(parse.curr_text(p))
        if db.find_local_symbol(p.file_id, name) != id_none() {
            parse.parse_error_at(p, c"duplicate declaration", parse.curr_span(p))
        }
        sym := db.alloc_symbol(p.file_id, name, p.cursor)
        p.toplv_sym = sym
        start := db.hir.len()
        root := parse_expr(p, 0)
        db.set_sym_hir_range(sym, start, db.hir.len())
        if db.hir.kind(root) == hir.hir_kind.binding {
            db.set_sym_is_const(sym, true)
            value := db.hir.extra(root)
            if db.hir.kind(value) == hir.hir_kind.ident {
                db.hir.set_rhs(value, sym)
            } else if db.hir.kind(value) == hir.hir_kind.member {
                db.hir.set_extra(value, sym)
            }
        }
        parse_common.check_separator(
            p
            Token.eof
            c"expected ',' or newline between top-level declarations"
        )
    }
}

parse_expr :: fn(p &parse.Parser, min_bp u8) u32 {
    lhs := dispatch_prefix(p, min_bp)

    while not parse.is_eof(p) {
        tk := parse.peek(p)

        if parse.peek_preceded_by_newline(p) {
            soft := precedence.is_soft(tk)
            if not soft {
                break
            }
        }
        bp := precedence.bp_from_infix(tk)
        if (not bp.is_some) or (bp.left < min_bp) {
            break
        }
        parse.bump(p)
        lhs = dispatch_infix(p, tk, lhs, bp.right)
    }

    lhs
}

is_destructure_start :: fn(p &parse.Parser) bool {
    t := Token
    c := p.cursor
    if p.tokens.kind(c) != t.ident {
        ret false
    }
    if c + 1 >= p.end {
        ret false
    }
    if p.tokens.kind(c + 1) != t.comma {
        ret false
    }
    scan := c + 2
    while scan < p.end {
        if p.tokens.kind(scan) != t.ident {
            ret false
        }
        scan = scan + 1
        if scan >= p.end {
            ret false
        }
        k := p.tokens.kind(scan)
        if k == t.comma {
            scan = scan + 1
            cont
        }
        if k == t.colon {
            if (scan + 1 < p.end) and (p.tokens.kind(scan + 1) == t.eq) {
                ret true
            }
            ret false
        }
        ret false
    }
    false
}

dispatch_prefix :: fn(p &parse.Parser, min_bp u8) u32 {
    t := Token
    tk := parse.peek(p)

    if tk == t.eof {
        ret hir.hir_none()
    }
    if tk == t.lit_int {
        ret expressions.parse_lit_int(p)
    }
    if tk == t.lit_float {
        ret expressions.parse_float(p)
    }
    if tk == t.lit_str {
        ret expressions.parse_str(p)
    }
    if tk == t.lit_char {
        ret expressions.parse_char(p)
    }
    if tk == t.lit_cstr {
        ret expressions.parse_cstr(p)
    }
    if tk == t.kw_true {
        ret expressions.parse_true(p)
    }
    if tk == t.kw_false {
        ret expressions.parse_false(p)
    }
    if tk == t.ident {
        if is_destructure_start(p) {
            ret decl.parse_destructure(p)
        }
        ret expressions.parse_ident(p)
    }
    if tk == t.o_paren {
        ret decl.parse_paren(p)
    }
    if tk == t.o_brace {
        ret stmt.parse_block(p)
    }
    if tk == t.kw_if {
        ret stmt.parse_if(p)
    }
    if tk == t.kw_while {
        ret stmt.parse_while(p)
    }
    if tk == t.kw_for {
        ret stmt.parse_for(p)
    }
    if tk == t.kw_break {
        ret stmt.parse_break(p)
    }
    if tk == t.kw_cont {
        ret stmt.parse_cont(p)
    }
    if tk == t.kw_ret {
        ret stmt.parse_return(p)
    }
    if tk == t.kw_match {
        ret stmt.parse_match(p)
    }
    if tk == t.kw_struct {
        ret decl.parse_struct(p)
    }
    if tk == t.kw_enum {
        ret decl.parse_enum(p)
    }
    if tk == t.kw_fn {
        ret decl.parse_fn(p, min_bp)
    }
    if tk == t.kw_extern {
        ret decl.parse_extern(p, min_bp)
    }
    if tk == t.at {
        ret expressions.parse_builtin(p)
    }
    if (tk == t.dot) and (parse.peek_n(p, 1) == t.o_brace) {
        ret decl.parse_struct_init(p)
    }
    if (tk == t.dot) and (parse.peek_n(p, 1) == t.o_bracket) {
        ret expressions.parse_array_lit(p)
    }
    if tk == t.o_bracket {
        ret expressions.parse_array_type(p, min_bp)
    }
    if tk == t.kw_cmpt {
        ret parse_cmpt(p, min_bp)
    }
    if tk == t.hash {
        ret parse_splice(p, min_bp)
    }
    if (tk == t.minus) or (tk == t.kw_not) or (tk == t.tilde) or (tk == t.amp) or (tk == t.star) {
        ret expressions.parse_unary(p, tk)
    }
    parse.parse_error_at(p, c"unexpected token in expression", parse.curr_span(p))
    hir.hir_none()
}

parse_cmpt :: fn(p &parse.Parser, min_bp u8) u32 {
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)
    min := min_bp
    pr := precedence.prec().assignment + (1 as u8)
    if min < pr {
        min = pr
    }
    body := parse_expr(p, min)
    sp_end := parse_common.span_of_hir(p, body)
    node := p.hir.push(k.k_cmpt, body, hir.hir_none(), hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
}

parse_splice :: fn(p &parse.Parser, min_bp u8) u32 {
    k := hir.hir_kind
    t := Token
    sp_start := parse.curr_span(p)
    parse.bump(p)

    has_paren := false
    if parse.peek(p) == t.o_paren {
        has_paren = true
        parse.bump(p)
    }
    min := min_bp
    pr := precedence.prec().assignment + (1 as u8)
    if min < pr {
        min = pr
    }
    expr := parse_expr(
        p
        if has_paren {
            0 as u8
        } else {
            min
        }
    )
    if has_paren {
        if not parse.expect(p, t.c_paren) {
            parse.parse_error_at(p, c"expected ')' after '#' expression", parse.curr_span(p))
        }
    }
    sp_end := parse_common.span_of_hir(p, expr)
    node := p.hir.push(k.splice, expr, hir.hir_none(), hir.hir_none())
    parse.capture_splice_scope(p, node)
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
    if p.toplv_sym != id_none() {
        p.db.set_hir_symbol(node, p.toplv_sym)
    }
    node
}

dispatch_infix :: fn(p &parse.Parser, op Token, lhs u32, right_bp u8) u32 {
    t := Token

    if op == t.colon_colon {
        ret decl.parse_binding(p, lhs, right_bp)
    }
    if op == t.colon {
        ret decl.parse_var_decl(p, lhs, right_bp)
    }
    if op == t.eq {
        ret expressions.parse_assign(p, lhs, right_bp)
    }
    if op == t.o_paren {
        ret decl.parse_call(p, lhs, right_bp)
    }
    if op == t.o_bracket {
        ret expressions.parse_index(p, lhs, right_bp)
    }
    if op == t.dot {
        ret decl.parse_member(p, lhs, right_bp)
    }
    expressions.parse_binary(p, op, lhs, right_bp)
}

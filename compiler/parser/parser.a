import token from "../token.a"
import hir_kind, hir_none from "../hir.a"
import Parser, is_eof, peek, bump, peek_n, peek_preceded_by_newline, curr_span, parse_error_at from "core.a"
import is_soft, bp_from_infix from "prec.a"
import span_merge from "../nexus/nexus.a"
import id_none from "../nexus/pool.a"

import span_of_hir, set_span, is_dot_continuation from "handlers/common.a"
import parse_lit_int, parse_float, parse_str, parse_true, parse_false from "handlers/lit.a"
import parse_ident from "handlers/ident.a"
import parse_if, parse_while, parse_block, parse_return, parse_break, parse_cont from "handlers/control.a"
import parse_unary, parse_binary, parse_assign from "handlers/op.a"
import parse_paren, parse_call from "handlers/fn.a"
import parse_binding, parse_var_decl from "handlers/var.a"
import parse_struct, parse_struct_init, parse_member from "handlers/struct.a"

parse_expr :: (p &Parser, min_bp u8) u32 {
    lhs := dispatch_prefix(p)

    while not is_eof(p) {
        tk := peek(p)

        if peek_preceded_by_newline(p) {
            soft := is_soft(tk)
            if (not soft) and (tk == token().dot) {
                soft = is_dot_continuation(p, lhs)
            }
            if not soft {
                break
            }
        }

        bp := bp_from_infix(tk)
        if (not bp.is_some) or (bp.left < min_bp) {
            break
        }

        bump(p)
        lhs = dispatch_infix(p, tk, lhs, bp.right)
    }

    lhs
}

dispatch_prefix :: (p &Parser) u32 {
    t := token()
    tk := peek(p)

    if tk == t.eof        { ret hir_none() }

    if tk == t.lit_int    { ret parse_lit_int(p) }
    if tk == t.lit_float  { ret parse_float(p) }
    if tk == t.lit_str    { ret parse_str(p) }
    if tk == t.kw_true    { ret parse_true(p) }
    if tk == t.kw_false   { ret parse_false(p) }

    if tk == t.ident      { ret parse_ident(p) }
    if tk == t.o_paren    { ret parse_paren(p) }
    if tk == t.o_brace    { ret parse_block(p) }

    if tk == t.kw_if      { ret parse_if(p) }
    if tk == t.kw_while   { ret parse_while(p) }
    if tk == t.kw_break   { ret parse_break(p) }
    if tk == t.kw_cont    { ret parse_cont(p) }
    if tk == t.kw_ret     { ret parse_return(p) }

    if tk == t.kw_struct  { ret parse_struct(p) }
    if (tk == t.dot) and (peek_n(p, 1) == t.o_brace) { ret parse_struct_init(p) }
    if tk == t.dot {
        if not (*p).inside_method {
            parse_error_at(p, "implicit field access is only valid inside a struct method", curr_span(p))
        }
        sp_start := curr_span(p)
        bump(p)
        field := parse_ident(p)
        (*p).db.set_hir_symbol(field, id_none())
        node := ((*p).hir).push(hir_kind().member, hir_none(), field, hir_none())
        ret set_span(p, node, span_merge(sp_start, span_of_hir(p, field)))
    }

    if (tk == t.minus) or (tk == t.kw_not) or (tk == t.tilde) or (tk == t.amp) or (tk == t.star) {
        ret parse_unary(p, tk)
    }

    parse_error_at(p, "unexpected token in expression", curr_span(p))
    hir_none()
}

dispatch_infix :: (p &Parser, op u8, lhs u32, right_bp u8) u32 {
    t := token()

    if op == t.colon_colon { ret parse_binding(p, lhs, right_bp) }
    if op == t.colon       { ret parse_var_decl(p, lhs, right_bp) }
    if op == t.eq          { ret parse_assign(p, lhs, right_bp) }
    if op == t.o_paren     { ret parse_call(p, lhs, right_bp) }
    if op == t.dot         { ret parse_member(p, lhs, right_bp) }

    parse_binary(p, op, lhs, right_bp)
}

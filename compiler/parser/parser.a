import token, TokenType, TokenStream from "../token"
import Str from "std/string"
import lex from "../lexer"
import malloc from "std/mem"
import hir_kind, hir_none from "../hir"
import Parser, is_eof, peek, bump, peek_n, peek_preceded_by_newline, curr_span, parse_error_at, curr_text, expect, Parser_new from "./core"
import prec, is_soft, bp_from_infix from "./prec"
import span_merge from "../nexus/nexus"
import span_of_hir, set_span from "./handlers/common"
import parse_lit_int, parse_float, parse_str, parse_char, parse_cstr, parse_true, parse_false from "./handlers/lit"
import parse_ident from "./handlers/ident"
import parse_if, parse_while, parse_for, parse_block, parse_return, parse_break, parse_cont from "./handlers/control"
import parse_unary, parse_binary, parse_assign from "./handlers/op"
import parse_paren, parse_call, parse_fn from "./handlers/fn"
import parse_binding, parse_var_decl from "./handlers/var"
import parse_struct, parse_struct_init, parse_member from "./handlers/struct"
import parse_builtin from "./handlers/builtin"
import parse_enum from "./handlers/enum"
import parse_match from "./handlers/match"

parse_expr :: fn(p &Parser, min_bp u8) u32 {
    lhs := dispatch_prefix(p, min_bp)

    while not is_eof(p) {
        tk := peek(p)

        if peek_preceded_by_newline(p) {
            soft := is_soft(tk)
            if not soft {
                break
            }
        }

        bp := bp_from_infix(tk)
        if (not bp.is_some) or (bp.left < min_bp) {
            break
        }

        bump(p)
        lhs = dispatch_infix(p, tk, lhs, bp.right)
    }

    lhs
}

dispatch_prefix :: fn(p &Parser, min_bp u8) u32 {
    t := token
    tk := peek(p)

    if tk == t.eof        { ret hir_none() }

    if tk == t.lit_int    { ret parse_lit_int(p) }
    if tk == t.lit_float  { ret parse_float(p) }
    if tk == t.lit_str    { ret parse_str(p) }
    if tk == t.lit_char   { ret parse_char(p) }
    if tk == t.lit_cstr   { ret parse_cstr(p) }
    if tk == t.kw_true    { ret parse_true(p) }
    if tk == t.kw_false   { ret parse_false(p) }

    if tk == t.ident      { ret parse_ident(p) }
    if tk == t.o_paren    { ret parse_paren(p) }
    if tk == t.o_brace    { ret parse_block(p) }

    if tk == t.kw_if      { ret parse_if(p) }
    if tk == t.kw_while   { ret parse_while(p) }
    if tk == t.kw_for     { ret parse_for(p) }
    if tk == t.kw_break   { ret parse_break(p) }
    if tk == t.kw_cont    { ret parse_cont(p) }
    if tk == t.kw_ret     { ret parse_return(p) }
    if tk == t.kw_match   { ret parse_match(p) }

    if tk == t.kw_struct  { ret parse_struct(p) }
    if tk == t.kw_enum    { ret parse_enum(p) }
    if tk == t.kw_fn      { ret parse_fn(p, min_bp) }
    if tk == t.at         { ret parse_builtin(p) }
    if (tk == t.dot) and (peek_n(p, 1) == t.o_brace) { ret parse_struct_init(p) }

    if tk == t.kw_cmpt    { ret parse_cmpt(p, min_bp) }
    if tk == t.hash       { ret parse_macro(p, min_bp) }

    if (tk == t.minus) or (tk == t.kw_not) or (tk == t.tilde) or (tk == t.amp) or (tk == t.star) {
        ret parse_unary(p, tk)
    }

    parse_error_at(p, c"unexpected token in expression", curr_span(p))
    hir_none()
}

parse_cmpt :: fn(p &Parser, min_bp u8) u32 {
    k := hir_kind
    sp_start := curr_span(p)
    bump(p)
    min := min_bp
    pr := prec().assignment + (1 as u8)
    if min < pr { min = pr }
    body := parse_expr(p, min)
    sp_end := span_of_hir(p, body)
    node := p.hir.push(k.k_cmpt, body, hir_none(), hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

unescape_macro_str :: fn(s Str) Str {
    if s.len == 0 { ret s }
    has_esc := false
    i: u64 = 0
    while i < s.len {
        if *(s.ptr + i) == 92 {
            has_esc = true
            break
        }
        i = i + 1
    }
    if not has_esc { ret s }

    buf := malloc(s.len) as &u8
    out_len: u64 = 0
    i = 0
    while i < s.len {
        c := *(s.ptr + i)
        if (c == 92) and (i + 1 < s.len) {
            next_c := *(s.ptr + i + 1)
            if (next_c == 34) or (next_c == 92) {
                *(buf + out_len) = next_c
                out_len = out_len + 1
                i = i + 2
                cont
            }
        }
        *(buf + out_len) = c
        out_len = out_len + 1
        i = i + 1
    }
    Str.new(buf, out_len)
}

parse_macro :: fn(p &Parser, min_bp u8) u32 {
    k := hir_kind
    t := token
    sp_start := curr_span(p)
    bump(p)

    has_paren := false
    if peek(p) == t.o_paren {
        has_paren = true
        bump(p)
    }

    if peek(p) == t.lit_str {
        raw := curr_text(p)
        bump(p)
        if has_paren {
            if not expect(p, t.c_paren) {
                parse_error_at(p, c"expected ')' after macro string", curr_span(p))
            }
        }
        content := raw
        if raw.len >= 2 {
            content = Str.new(raw.ptr + 1, raw.len - 2)
        }
        unescaped := content
        if *(raw.ptr) != 96 {
            unescaped = unescape_macro_str(content)
        }
        if unescaped.len == 0 {
            ret hir_none()
        }
        tokens := TokenStream.new()
        lex(&tokens, unescaped, Str.of("<macro>"))
        tok_count := tokens.count() as u32
        if tok_count > 1 {
            tok_count = tok_count - 1
        }
        sub_p := Parser_new(p.db, &tokens, p.hir, p.file_id, p.toplv_sym, 0, tok_count)
        i: u64 = 0
        while i < p.env.names.len {
            sub_p.env.define(p.env.names.get(i), p.env.syms.get(i))
            i = i + 1
        }
        first_node := parse_expr(&sub_p, 0 as u8)
        if first_node == hir_none() {
            parse_error_at(p, c"macro string did not produce a valid expression", sp_start)
        }
        if not is_eof(&sub_p) {
            db := p.db
            glob_stack := &db.glob_stack
            mark := glob_stack.mark()
            glob_stack.push(first_node)
            while not is_eof(&sub_p) {
                glob_stack.push(parse_expr(&sub_p, 0 as u8))
            }
            slice: Slice(u32) = .{
                ptr: glob_stack.ptr_at(mark),
                len: glob_stack.len - mark
            }
            list_id := db.add_list(slice)
            glob_stack.reset(mark)
            node := p.hir.push(k.block, list_id, hir_none(), hir_none())
            set_span(p, node, span_of_hir(p, first_node))
            first_node = node
        }
        sub_p.env.destroy()
        tokens.destroy()
        ret first_node
    }

    min := min_bp
    pr := prec().assignment + (1 as u8)
    if min < pr { min = pr }
    expr := parse_expr(p, if has_paren { 0 as u8 } else { min })
    if has_paren {
        if not expect(p, t.c_paren) {
            parse_error_at(p, c"expected ')' after macro expression", curr_span(p))
        }
    }
    sp_end := span_of_hir(p, expr)
    node := p.hir.push(k.k_macro, expr, hir_none(), hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
    node
}

dispatch_infix :: fn(p &Parser, op TokenType, lhs u32, right_bp u8) u32 {
    t := token

    if op == t.colon_colon { ret parse_binding(p, lhs, right_bp) }
    if op == t.colon       { ret parse_var_decl(p, lhs, right_bp) }
    if op == t.eq          { ret parse_assign(p, lhs, right_bp) }
    if op == t.o_paren     { ret parse_call(p, lhs, right_bp) }
    if op == t.dot         { ret parse_member(p, lhs, right_bp) }

    parse_binary(p, op, lhs, right_bp)
}

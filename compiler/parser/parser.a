import token, TokenStream from "../token.a"
import hir_kind, HirTable, hir_none from "../hir.a"

import Parser, is_eof, peek, bump, expect, optional, peek_n,
       peek_preceded_by_newline, curr_text, prev_text, str_to_u32, lookup_sym,
       tok_span, curr_span, prev_span, parse_error_at from "core.a"
import ScopeEnv_mark, ScopeEnv_reset, ScopeEnv_define from "env.a"
import is_soft, bp_from_infix, prec from "prec.a"

import VecU32 from "../../std/vec/u32.a"
import SliceU32 from "../../std/slice/u32.a"

import Nexus_add_list, Nexus_get_list, Nexus_alloc_local_symbol,
       Nexus_set_sym_hir, Nexus_get_sym_hir, Nexus_set_hir_symbol,
       Nexus_set_hir_span, Nexus_set_hir_file, Nexus_get_hir_span,
       Nexus_set_method_owner, Span, span_merge from "../nexus/nexus.a"
import id_none from "../nexus/pool.a"

span_of_hir :: (p &Parser, hir_id u32) Span {
    Nexus_get_hir_span((*p).db, hir_id)
}

set_span :: (p &Parser, hir_id u32, sp Span) u32 {
    Nexus_set_hir_span((*p).db, hir_id, sp.start, sp.end)
    Nexus_set_hir_file((*p).db, hir_id, (*p).file_id)
    hir_id
}

--- Pratt Engine ---------------------------------------------------------------------------------

is_assign_op :: (kind u8) bool {
    t := token()
    if kind == t.eq or kind == t.plus_eq or kind == t.minus_eq or kind == t.star_eq or kind == t.slash_eq or kind == t.percent_eq { ret true }
    if kind == t.amp_eq or kind == t.pipe_eq or kind == t.caret_eq or kind == t.left_shift_eq or kind == t.right_shift_eq { ret true }
    false
}

is_dot_continuation :: (p &Parser, lhs u32) bool {
    if lhs == hir_none() { ret false }

    t := token()
    if peek_n(p, 1) == t.o_brace { ret false }

    if not (*p).inside_method { ret true }

    k := hir_kind()
    lhs_kind := ((*p).hir).kind(lhs)
    if lhs_kind != k.call { ret false }

    callee := ((*p).hir).lhs(lhs)
    if callee == hir_none() { ret false }
    if ((*p).hir).kind(callee) != k.member { ret false }

    next2 := peek_n(p, 2)
    if is_assign_op(next2) { ret false }
    if next2 != t.o_paren { ret false }

    true
}

parse_expr :: (p &Parser, min_bp u8) u32 {
    lhs := dispatch_prefix(p)

    while not is_eof(p) {
        tk := peek(p)

        if peek_preceded_by_newline(p) {
            soft := is_soft(tk)
            if (not soft) and (tk == token().dot) {
                soft = is_dot_continuation(p, lhs)
            }
            if not soft {
                break
            }
        }

        bp := bp_from_infix(tk)
        if (not bp.is_some) or (bp.left < min_bp) {
            break
        }

        bump(p) 
        lhs = dispatch_infix(p, tk, lhs, bp.right)
    }

    lhs
}

--- Dispatch Layer -------------------------------------------------------------------------------

dispatch_prefix :: (p &Parser) u32 {
    t := token()
    tk := peek(p)

    if tk == t.eof        { ret hir_none() }

    if tk == t.lit_int    { ret parse_lit_int(p) }
    if tk == t.lit_float  { ret parse_float(p) }
    if tk == t.lit_str    { ret parse_str(p) }
    if tk == t.kw_true    { ret parse_true(p) }
    if tk == t.kw_false   { ret parse_false(p) }

    if tk == t.ident      { ret parse_ident(p) }
    if tk == t.o_paren    { ret parse_paren(p) }
    if tk == t.o_brace    { ret parse_block(p) }

    if tk == t.kw_if      { ret parse_if(p) }
    if tk == t.kw_while   { ret parse_while(p) }
    if tk == t.kw_break   { ret parse_break(p) }
    if tk == t.kw_cont    { ret parse_cont(p) }
    if tk == t.kw_ret     { ret parse_return(p) }

    if tk == t.kw_struct  { ret parse_struct(p) }
    if (tk == t.dot) and (peek_n(p, 1) == t.o_brace) { ret parse_struct_init(p) }
    if tk == t.dot {
        if not (*p).inside_method {
            parse_error_at(p, "implicit field access is only valid inside a struct method", curr_span(p))
        }
        sp_start := curr_span(p)
        bump(p)
        field := parse_ident(p)
        Nexus_set_hir_symbol((*p).db, field, id_none())
        node := ((*p).hir).push(hir_kind().member, hir_none(), field, hir_none())
        ret set_span(p, node, span_merge(sp_start, span_of_hir(p, field)))
    }

    if (tk == t.minus) or (tk == t.kw_not) or (tk == t.tilde) or (tk == t.amp) or (tk == t.star) {
        ret parse_unary(p, tk)
    }

    parse_error_at(p, "unexpected token in expression", curr_span(p))
    hir_none()
}

dispatch_infix :: (p &Parser, op u8, lhs u32, right_bp u8) u32 {
    t := token()

    if op == t.colon_colon { ret parse_binding(p, lhs, right_bp) }
    if op == t.colon       { ret parse_var_decl(p, lhs, right_bp) }
    if op == t.eq          { ret parse_assign(p, lhs, right_bp) }
    if op == t.o_paren     { ret parse_call(p, lhs, right_bp) }
    if op == t.dot         { ret parse_member(p, lhs, right_bp) }

    parse_binary(p, op, lhs, right_bp)
}

--- Control Flow Handlers ------------------------------------------------------------------------

parse_if :: (p &Parser) u32 {
    t := token()
    k := hir_kind()
    sp_start := curr_span(p)
    bump(p) -- 'if'

    prev_allow_fn := (*p).allow_fn
    (*p).allow_fn = false
    cond := parse_expr(p, 0 as u8)
    (*p).allow_fn = prev_allow_fn

    thenb := parse_expr(p, 0 as u8)
    sp_end := span_of_hir(p, thenb)

    elseb := hir_none()
    if optional(p, t.kw_else) {
        elseb = parse_expr(p, 0 as u8)
        sp_end = span_of_hir(p, elseb)
    }

    node := ((*p).hir).push(k.k_if, cond, thenb, elseb)
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_while :: (p &Parser) u32 {
    k := hir_kind()
    sp_start := curr_span(p)
    bump(p) -- 'while'

    prev_allow_fn := (*p).allow_fn
    (*p).allow_fn = false
    cond := parse_expr(p, 0 as u8)
    (*p).allow_fn = prev_allow_fn

    body := parse_expr(p, 0 as u8)
    sp_end := span_of_hir(p, body)

    node := ((*p).hir).push(k.k_while, cond, body, hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

--- Function Parsing Helpers ---------------------------------------------------------------------

define_param :: (p &Parser, name_hir u32) {
    k := hir_kind()
    if ((*p).hir).kind(name_hir) != k.ident {
        parse_error_at(p, "parameter name must be an identifier", span_of_hir(p, name_hir))
    }
    name_id := ((*p).hir).lhs(name_hir)
    sym_id := Nexus_alloc_local_symbol((*p).db, (*p).file_id, name_id, name_hir)
    ScopeEnv_define(&(*p).env, name_id, sym_id)
}

is_function_header :: (p &Parser) bool {
    if (*p).inside_method and ((*p).method_fn_depth != 0) { ret false }

    t := token()

    if peek(p) != t.ident { ret false }

    depth: u32 = 1
    i := p.cursor
    has_comma := false

    while i < p.end {
        tk := p.tokens.kind(i)
        if tk == t.o_paren {
            depth = depth + 1
        } else if tk == t.c_paren {
            depth = depth - 1
            if depth == 0 { break }
        } else if (tk == t.comma) and (depth == 1) {
            has_comma = true
        }
        i = i + 1
    }

    if depth != 0 { ret false }
    if has_comma { ret true }

    after_cp := t.eof
    if (i + 1) < p.end {
        after_cp = p.tokens.kind(i + 1)
    }

    if after_cp == t.o_brace { ret true }

    if after_cp == t.ident {
        if not  p.tokens.newline_before(i + 1) { ret true }
    }

    if (after_cp == t.amp) or (after_cp == t.star) or (after_cp == t.o_bracket) {
        if ((*p).toplv_sym != id_none()) or ((*p).inside_method and ((*p).method_fn_depth == 0)) { ret true }
    }

    false
}

parse_fn_tail :: (p &Parser, params u32, sp_start Span) u32 {
    if (*p).inside_method {
        if (*p).method_fn_depth != 0 {
            parse_error_at(p, "nested functions inside methods are not supported", sp_start)
        }
        (*p).method_fn_depth = 1
    }
    (*p).toplv_sym = id_none()
    t := token()
    k := hir_kind()

    ret_ty := hir_none()
    sp_end := sp_start
    if peek(p) != t.o_brace {
        ret_ty = parse_expr(p, 0 as u8)
        sp_end = span_of_hir(p, ret_ty)
    }

    body := hir_none()
    if peek(p) == t.o_brace {
        body = parse_block(p)
        sp_end = span_of_hir(p, body)
    }

    node := ((*p).hir).push(k.function, params, ret_ty, body)
    if (*p).inside_method { (*p).method_fn_depth = 0 }
    set_span(p, node, span_merge(sp_start, sp_end))
}

--- Prefix Handlers ------------------------------------------------------------------------------

parse_lit_int :: (p &Parser) u32 {
    k := hir_kind()
    sp := curr_span(p)
    val := str_to_u32(p, curr_text(p))
    bump(p)
    node := ((*p).hir).push(k.lit_int, val, hir_none(), hir_none())
    set_span(p, node, sp)
}

parse_ident :: (p &Parser) u32 {
    k := hir_kind()
    t := token()

    if peek(p) != t.ident {
        parse_error_at(p, "expected identifier", curr_span(p))
    }

    sp := curr_span(p)
    name := curr_text(p)
    name_id := p.db.interner.intern(name)
    bump(p)

    ident_hir := ((*p).hir).push(k.ident, name_id, hir_none(), hir_none())
    set_span(p, ident_hir, sp)

    sym_id := lookup_sym(p, name_id)
    if sym_id != id_none() {
        Nexus_set_hir_symbol((*p).db, ident_hir, sym_id)
    }

    ident_hir
}

parse_paren :: (p &Parser) u32 {
    t := token()
    sp_start := curr_span(p)
    bump(p) -- '('

    if (*p).allow_fn and ((not (*p).inside_method) or ((*p).method_fn_depth == 0)) and optional(p, t.c_paren) {
        env_mark := ScopeEnv_mark(&(*p).env)
        fn_id := parse_fn_tail(p, hir_none(), sp_start)
        ScopeEnv_reset(&(*p).env, env_mark)
        ret fn_id
    }

    if (*p).allow_fn and is_function_header(p) {
        env_mark := ScopeEnv_mark(&(*p).env)
        args := VecU32.new()
        pending_names := VecU32.new()

        while (peek(p) != t.c_paren) and (not is_eof(p)) {
            name := parse_ident(p)
            define_param(p, name)
            pending_names.push(name)

            if optional(p, t.comma) {
                cont
            }

            if (peek(p) != t.c_paren) and (peek(p) != t.eof) {
                ty := parse_expr(p, 0 as u8)
                p_i: u64 = 0
                while p_i < pending_names.len {
                    p_name := pending_names.get(p_i)
                    p_sp := span_merge(span_of_hir(p, p_name), span_of_hir(p, ty))
                    arg_id := ((*p).hir).push(hir_kind().arg, p_name, ty, hir_none())
                    set_span(p, arg_id, p_sp)
                    args.push(arg_id)
                    p_i = p_i + 1
                }
                pending_names.reset(0)
                optional(p, t.comma)
            }
        }

        p_i: u64 = 0
        while p_i < pending_names.len {
            p_name := pending_names.get(p_i)
            arg_id := ((*p).hir).push(hir_kind().arg, p_name, hir_none(), hir_none())
            set_span(p, arg_id, span_of_hir(p, p_name))
            args.push(arg_id)
            p_i = p_i + 1
        }

        expect(p, t.c_paren)

        slice: SliceU32 = .{
            ptr: args.ptr_at(0),
            len: args.len
        }
        params := Nexus_add_list((*p).db, slice)
        pending_names.destroy()
        args.destroy()

        fn_id := parse_fn_tail(p, params, sp_start)
        ScopeEnv_reset(&(*p).env, env_mark)
        ret fn_id
    }

    expr := parse_expr(p, 0 as u8)
    expect(p, t.c_paren)
    sp_end := prev_span(p)
    set_span(p, expr, span_merge(sp_start, sp_end))
}

parse_block :: (p &Parser) u32 {
    k := hir_kind()
    t := token()

    db := &(*(*p).db)
    glob_stack := &(*db).glob_stack

    sp_start := curr_span(p)
    mark := glob_stack.mark()
    env_mark := ScopeEnv_mark(&(*p).env) 

    bump(p) -- '{'

    while (peek(p) != t.c_brace) and (not is_eof(p)) {
        glob_stack.push(parse_expr(p, 0))
    }

    if is_eof(p) and (peek(p) != t.c_brace) {
        parse_error_at(p, "unclosed block, expected '}'", sp_start)
    }

    expect(p, t.c_brace)
    sp_end := prev_span(p)

    slice: SliceU32 = .{
        ptr: glob_stack.ptr_at(mark),
        len: glob_stack.len - mark
    }
    list_id := Nexus_add_list(db, slice)

    glob_stack.reset(mark)
    ScopeEnv_reset(&(*p).env, env_mark) 

    node := ((*p).hir).push(k.block, list_id, hir_none(), hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_unary :: (p &Parser, op u8) u32 {
    t := token()
    k := hir_kind()
    sp_start := curr_span(p)
    bump(p)

    body := parse_expr(p, prec().unary)
    sp_end := span_of_hir(p, body)

    op_kind := k.empty
    if op == t.minus  { op_kind = k.unary_neg }
    if op == t.kw_not { op_kind = k.unary_not }
    if op == t.tilde  { op_kind = k.unary_bit_not }
    if op == t.amp    { op_kind = k.unary_addr_of }
    if op == t.star   { op_kind = k.unary_deref }

    node := ((*p).hir).push(op_kind, body, hir_none(), hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_return :: (p &Parser) u32 {
    t := token()
    k := hir_kind()
    sp_start := curr_span(p)
    sp_end := sp_start
    bump(p) -- 'ret'

    val := hir_none()
    if (not peek_preceded_by_newline(p)) and (peek(p) != t.c_brace) and (peek(p) != t.eof) {
        val = parse_expr(p, 0 as u8)
        sp_end = span_of_hir(p, val)
    }

    node := ((*p).hir).push(k.k_ret, val, hir_none(), hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

--- Infix Handlers -------------------------------------------------------------------------------

parse_binary :: (p &Parser, op u8, lhs u32, right_bp u8) u32 {
    t := token()
    k := hir_kind()

    sp_lhs := span_of_hir(p, lhs)
    rhs := parse_expr(p, right_bp)
    sp_rhs := span_of_hir(p, rhs)

    op_kind := k.empty
    if op == t.plus        { op_kind = k.binary_add }
    if op == t.minus       { op_kind = k.binary_sub }
    if op == t.star        { op_kind = k.binary_mul }
    if op == t.slash       { op_kind = k.binary_div }
    if op == t.percent     { op_kind = k.binary_mod }
    if op == t.amp         { op_kind = k.binary_bit_and }
    if op == t.pipe        { op_kind = k.binary_bit_or }
    if op == t.caret       { op_kind = k.binary_bit_xor }
    if op == t.left_shift  { op_kind = k.binary_shl }
    if op == t.right_shift { op_kind = k.binary_shr }
    if op == t.eq_eq       { op_kind = k.binary_eq_eq }
    if op == t.bang_eq     { op_kind = k.binary_neq }
    if op == t.lt          { op_kind = k.binary_lt }
    if op == t.lt_eq       { op_kind = k.binary_lt_eq }
    if op == t.gt          { op_kind = k.binary_gt }
    if op == t.gt_eq       { op_kind = k.binary_gt_eq }
    if op == t.kw_and      { op_kind = k.binary_and }
    if op == t.kw_or       { op_kind = k.binary_or }
    if op == t.kw_as       { op_kind = k.cast }

    if op_kind == k.empty {
        parse_error_at(p, "unsupported binary operator", curr_span(p))
    }

    node := ((*p).hir).push(op_kind, lhs, rhs, hir_none())
    set_span(p, node, span_merge(sp_lhs, sp_rhs))
}

parse_binding :: (p &Parser, lhs u32, right_bp u8) u32 {
    k := hir_kind()
    sp_lhs := span_of_hir(p, lhs)

    name_id := ((*p).hir).lhs(lhs)
    sym_id := lookup_sym(p, name_id)

    if sym_id != id_none() {
        curr_hir := Nexus_get_sym_hir((*p).db, sym_id)
        if curr_hir == id_none() {
            Nexus_set_sym_hir((*p).db, sym_id, lhs)
        }
        Nexus_set_hir_symbol((*p).db, lhs, sym_id)
    }

    rhs := parse_expr(p, right_bp)
    sp_rhs := span_of_hir(p, rhs)

    binding_id := ((*p).hir).push(k.binding, lhs, hir_none(), rhs)
    set_span(p, binding_id, span_merge(sp_lhs, sp_rhs))

    if sym_id != id_none() {
        Nexus_set_hir_symbol((*p).db, binding_id, sym_id)
    }

    binding_id
}

parse_var_decl :: (p &Parser, lhs u32, right_bp u8) u32 {
    t := token()
    k := hir_kind()

    if ((*p).hir).kind(lhs) != k.ident {
        parse_error_at(p, "left-hand side of declaration must be an identifier", span_of_hir(p, lhs))
    }

    sp_lhs := span_of_hir(p, lhs)

    name_id := ((*p).hir).lhs(lhs)
    sym_id := Nexus_alloc_local_symbol((*p).db, (*p).file_id, name_id, lhs)
    ScopeEnv_define(&(*p).env, name_id, sym_id)

    if optional(p, t.eq) {
        val := parse_expr(p, 0 as u8)
        sp_val := span_of_hir(p, val)
        var_id := ((*p).hir).push(k.var, lhs, hir_none(), val)
        set_span(p, var_id, span_merge(sp_lhs, sp_val))
        Nexus_set_hir_symbol((*p).db, var_id, sym_id)
        ret var_id
    }

    ty := parse_expr(p, prec().var_def + (1 as u8))
    sp_end := span_of_hir(p, ty)

    if optional(p, t.eq) {
        val := parse_expr(p, 0 as u8)
        sp_end = span_of_hir(p, val)
        var_id := ((*p).hir).push(k.var, lhs, ty, val)
        set_span(p, var_id, span_merge(sp_lhs, sp_end))
        Nexus_set_hir_symbol((*p).db, var_id, sym_id)
        ret var_id
    }

    if optional(p, t.colon) {
        val := parse_expr(p, 0 as u8)
        sp_end = span_of_hir(p, val)
        binding_id := ((*p).hir).push(k.binding, lhs, ty, val)
        set_span(p, binding_id, span_merge(sp_lhs, sp_end))
        Nexus_set_hir_symbol((*p).db, binding_id, sym_id)
        ret binding_id
    }

    var_id := ((*p).hir).push(k.var, lhs, ty, hir_none())
    set_span(p, var_id, span_merge(sp_lhs, sp_end))
    Nexus_set_hir_symbol((*p).db, var_id, sym_id)
    var_id
}

parse_assign :: (p &Parser, lhs u32, right_bp u8) u32 {
    k := hir_kind()
    sp_lhs := span_of_hir(p, lhs)
    rhs := parse_expr(p, right_bp)
    sp_rhs := span_of_hir(p, rhs)

    node := ((*p).hir).push(k.binary_assign, lhs, rhs, hir_none())
    set_span(p, node, span_merge(sp_lhs, sp_rhs))
}

parse_call :: (p &Parser, lhs u32, right_bp u8) u32 {
    t := token()
    k := hir_kind()
    sp_lhs := span_of_hir(p, lhs)

    args := VecU32.new()
    if not optional(p, t.c_paren) {
        while true {
            if peek(p) == t.c_paren { break }
            if is_eof(p) {
                parse_error_at(p, "unclosed call, expected ')'", sp_lhs)
            }
            arg := parse_expr(p, 0 as u8)
            if arg == hir_none() {
                parse_error_at(p, "expected call argument", curr_span(p))
            }
            args.push(arg)

            if peek(p) == t.c_paren { break }
            if not expect(p, t.comma) {
                parse_error_at(p, "expected ',' or ')' after call argument", curr_span(p))
            }
        }
        expect(p, t.c_paren)
    }

    sp_end := prev_span(p)
    slice: SliceU32 = .{ ptr: args.ptr_at(0), len: args.len }
    args_list := Nexus_add_list((*p).db, slice)
    args.destroy()

    node := ((*p).hir).push(k.call, lhs, args_list, hir_none())
    set_span(p, node, span_merge(sp_lhs, sp_end))
}

parse_float :: (p &Parser) u32 {
    k := hir_kind()
    sp := curr_span(p)
    name := curr_text(p)
    name_id := p.db.interner.intern(name)
    bump(p)
    node := ((*p).hir).push(k.lit_float, name_id, hir_none(), hir_none())
    set_span(p, node, sp)
}

parse_str :: (p &Parser) u32 {
    k := hir_kind()
    sp := curr_span(p)
    raw := curr_text(p)
    bump(p)
    name_id := p.db.interner.intern(raw)
    node := ((*p).hir).push(k.lit_str, name_id, hir_none(), hir_none())
    set_span(p, node, sp)
}

parse_true :: (p &Parser) u32 {
    k := hir_kind()
    sp := curr_span(p)
    bump(p)

    node := ((*p).hir).push(k.lit_bool_true, hir_none(), hir_none(), hir_none())
    set_span(p, node, sp)
}

parse_false :: (p &Parser) u32 {
    k := hir_kind()
    sp := curr_span(p)
    bump(p)
    node := ((*p).hir).push(k.lit_bool_false, hir_none(), hir_none(), hir_none())
    set_span(p, node, sp)
}

parse_break :: (p &Parser) u32 {
    k := hir_kind()
    sp := curr_span(p)
    bump(p)
    node := ((*p).hir).push(k.k_break, hir_none(), hir_none(), hir_none())
    set_span(p, node, sp)
}

parse_cont :: (p &Parser) u32 {
    k := hir_kind()
    sp := curr_span(p)
    bump(p)
    node := ((*p).hir).push(k.k_cont, hir_none(), hir_none(), hir_none())
    set_span(p, node, sp)
}

ensure_unique_field :: (p &Parser, fields &VecU32, field u32) {
    name_id := ((*p).hir).lhs(field)
    i: u64 = 0
    while i < (*fields).len {
        previous := fields.get(i)
        if ((*p).hir).lhs(previous) == name_id {
            parse_error_at(p, "duplicate field name", span_of_hir(p, field))
        }
        i = i + 1
    }
}

parse_struct :: (p &Parser) u32 {
    t := token()
    k := hir_kind()
    sp_start := curr_span(p)
    bump(p) -- 'struct'
    if not expect(p, t.o_brace) {
        parse_error_at(p, "expected '{' after struct", curr_span(p))
    }

    names := VecU32.new()
    types := VecU32.new()
    methods := VecU32.new()
    method_names := VecU32.new()
    if (*p).inside_method {
        parse_error_at(p, "nested struct declarations inside methods are not supported", sp_start)
    }

    while (peek(p) != t.c_brace) and (not is_eof(p)) {
        if peek(p) == t.comma { bump(p) }
        if (peek(p) == t.c_brace) or (peek(p) == t.eof) { break }

        name := parse_ident(p)
        ensure_unique_field(p, &names, name)
        ensure_unique_field(p, &method_names, name)
        if peek(p) == t.colon_colon {
            bump(p)
            Nexus_set_hir_symbol((*p).db, name, id_none())
            (*p).inside_method = true
            func := parse_expr(p, prec().const_def)
            (*p).inside_method = false
            if func == hir_none() {
                parse_error_at(p, "expected a method function after '::'", curr_span(p))
            }
            if ((*p).hir).kind(func) != k.function {
                parse_error_at(p, "struct method must be a function", span_of_hir(p, func))
            }
            if ((*p).hir).extra(func) == hir_none() {
                parse_error_at(p, "struct method requires a body", span_of_hir(p, func))
            }
            method := ((*p).hir).push(k.binding, name, hir_none(), func)
            set_span(p, method, span_merge(span_of_hir(p, name), span_of_hir(p, func)))
            methods.push(method)
            method_names.push(name)
            if peek(p) == t.comma { bump(p) }
            cont
        }
        if not expect(p, t.colon) {
            parse_error_at(p, "expected ':' for a field or '::' for a method", curr_span(p))
        }
        ty := parse_expr(p, prec().var_def + (1 as u8))
        if ty == hir_none() {
            parse_error_at(p, "expected a field type after ':'", curr_span(p))
        }

        names.push(name)
        types.push(ty)

        if peek(p) == t.comma { bump(p) }
    }

    if is_eof(p) and (peek(p) != t.c_brace) {
        parse_error_at(p, "unclosed struct definition, expected '}'", sp_start)
    }

    expect(p, t.c_brace)
    sp_end := prev_span(p)

    ptr_n := 0 as &u32
    if names.len > 0 { ptr_n = names.ptr_at(0) }
    slice_n: SliceU32 = .{ ptr: ptr_n, len: names.len }

    ptr_t := 0 as &u32
    if types.len > 0 { ptr_t = types.ptr_at(0) }
    slice_t: SliceU32 = .{ ptr: ptr_t, len: types.len }

    names_id := Nexus_add_list((*p).db, slice_n)
    types_id := Nexus_add_list((*p).db, slice_t)
    methods_id := hir_none()
    if methods.len > 0 {
        methods_id = Nexus_add_list((*p).db, methods.as_slice())
    }

    names.destroy()
    types.destroy()
    method_names.destroy()

    node := ((*p).hir).push(k.struct_, names_id, types_id, methods_id)
    i: u64 = 0
    while i < methods.len {
        method := methods.get(i)
        start := ((*p).hir).lhs(method)
        while start <= method {
            Nexus_set_method_owner((*p).db, start, node)
            start = start + 1
        }
        i = i + 1
    }
    methods.destroy()
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_struct_init :: (p &Parser) u32 {
    t := token()
    k := hir_kind()
    sp_start := curr_span(p)
    bump(p) -- '.'
    expect(p, t.o_brace)

    fields := VecU32.new()
    values := VecU32.new()

    while (peek(p) != t.c_brace) and (not is_eof(p)) {
        if peek(p) == t.comma { bump(p) }
        if (peek(p) == t.c_brace) or (peek(p) == t.eof) { break }

        f := parse_ident(p)
        ensure_unique_field(p, &fields, f)
        expect(p, t.colon)
        v := parse_expr(p, prec().var_def + (1 as u8))

        fields.push(f)
        values.push(v)

        if peek(p) == t.comma { bump(p) }
    }

    if is_eof(p) and (peek(p) != t.c_brace) {
        parse_error_at(p, "unclosed struct literal, expected '}'", sp_start)
    }

    expect(p, t.c_brace)
    sp_end := prev_span(p)

    ptr_f := 0 as &u32
    if fields.len > 0 { ptr_f = fields.ptr_at(0) }
    slice_f: SliceU32 = .{ ptr: ptr_f, len: fields.len }

    ptr_v := 0 as &u32
    if values.len > 0 { ptr_v = values.ptr_at(0) }
    slice_v: SliceU32 = .{ ptr: ptr_v, len: values.len }

    fids := Nexus_add_list((*p).db, slice_f)
    vids := Nexus_add_list((*p).db, slice_v)

    fields.destroy()
    values.destroy()

    node := ((*p).hir).push(k.struct_init, fids, vids, hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_member :: (p &Parser, lhs u32, right_bp u8) u32 {
    k := hir_kind()
    sp_lhs := span_of_hir(p, lhs)
    rhs := parse_expr(p, right_bp)
    if rhs == hir_none() {
        parse_error_at(p, "expected a member name after '.'", curr_span(p))
    }
    sp_rhs := span_of_hir(p, rhs)

    if ((*p).hir).kind(rhs) != k.ident {
        parse_error_at(p, "member name must be an identifier", sp_rhs)
    }

    node := ((*p).hir).push(k.member, lhs, rhs, hir_none())
    set_span(p, node, span_merge(sp_lhs, sp_rhs))
}

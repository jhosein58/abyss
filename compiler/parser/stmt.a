hir :: @import("compiler/hir")
span_merge :: @import("compiler/nexus/nexus").span_merge
id_none :: @import("compiler/nexus/pool").id_none
parse :: @import("compiler/parser/core")
parse_expr :: @import("compiler/parser/parser").parse_expr
prec :: @import("compiler/parser/prec").prec
Token :: @import("compiler/token").Token
parse_common :: @import("./common")
parse_ident :: @import("./expr").parse_ident

parse_if :: fn(p &parse.Parser) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)

    cond := parse_expr(p, 0 as u8)

    thenb := parse_expr(p, 0 as u8)
    sp_end := parse_common.span_of_hir(p, thenb)

    elseb := hir.hir_none()
    if parse.optional(p, t.kw_else) {
        elseb = parse_expr(p, prec().assignment + (1 as u8))
        sp_end = parse_common.span_of_hir(p, elseb)
    }
    node := p.hir.push(k.k_if, cond, thenb, elseb)
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
}

parse_while :: fn(p &parse.Parser) u32 {
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)

    cond := parse_expr(p, 0 as u8)

    body := parse_expr(p, 0 as u8)
    sp_end := parse_common.span_of_hir(p, body)

    node := p.hir.push(k.k_while, cond, body, hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
}

parse_for :: fn(p &parse.Parser) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)
    env_mark := p.env.mark()

    vars := Vec(u32).new()
    first := parse_ident(p)
    first_name := p.hir.lhs(first)
    first_sym := p.db.alloc_local_symbol(p.file_id, first_name, first)
    p.env.define(first_name, first_sym)
    vars.push(first)
    while (parse.peek(p) != t.kw_in) and (not parse.is_eof(p)) {
        parse_common.check_separator(p, t.kw_in, c"expected ',' or newline between for variables")
        if parse.peek(p) == t.kw_in {
            break
        }
        name := parse_ident(p)
        name_id := p.hir.lhs(name)
        sym := p.db.alloc_local_symbol(p.file_id, name_id, name)
        p.env.define(name_id, sym)
        vars.push(name)
    }

    if not parse.expect(p, t.kw_in) {
        parse.parse_error_at(p, c"expected 'in' after for variables", parse.curr_span(p))
    }
    iters := Vec(u32).new()
    iters.push(parse_expr(p, 0 as u8))
    while (parse.peek(p) != t.o_brace) and (not parse.is_eof(p)) {
        parse_common.check_separator(p, t.o_brace, c"expected ',' or newline between for iterators")
        if parse.peek(p) == t.o_brace {
            break
        }
        iters.push(parse_expr(p, 0 as u8))
    }
    if vars.len != iters.len {
        parse.parse_error_at(
            p
            c"for requires one iterator for each loop variable"
            parse.curr_span(p)
        )
    }
    if parse.peek(p) != t.o_brace {
        parse.parse_error_at(p, c"expected '{' after for iterators", parse.curr_span(p))
    }
    vars_id := parse_common.add_list(p, &vars)
    iters_id := parse_common.add_list(p, &iters)
    vars.destroy()
    iters.destroy()

    node := p.hir.push(k.k_for, vars_id, iters_id, hir.hir_none())
    parse_common.set_span(p, node, sp_start)

    body := parse_expr(p, 0 as u8)
    p.env.reset(env_mark)

    sp_end := parse_common.span_of_hir(p, body)
    p.hir.set_extra(node, body)
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
    node
}

parse_block :: fn(p &parse.Parser) u32 {
    k := hir.hir_kind
    t := Token

    db := &p.db
    glob_stack := &db.glob_stack

    sp_start := parse.curr_span(p)
    mark := glob_stack.mark()
    env_mark := p.env.mark()

    parse.bump(p)

    while (parse.peek(p) != t.c_brace) and (not parse.is_eof(p)) {
        expr := parse_expr(p, 0)
        if (parse.peek(p) == t.ident) and (not parse.peek_preceded_by_newline(p)) {
            first := expr
            while p.hir.kind(first) == k.index {
                first = p.hir.lhs(first)
            }
            if (p.hir.kind(first) == k.ident) and (p.db.get_hir_symbol(first) == id_none()) {
                parse.parse_error_at(
                    p
                    c"field declarations require 'struct { ... }'; use ':' for local variable declarations"
                    parse_common.span_of_hir(p, first)
                )
            }
        }
        glob_stack.push(expr)
        parse_common.check_separator(
            p
            t.c_brace
            c"expected ',' or newline between block expressions"
        )
    }

    if parse.is_eof(p) and (parse.peek(p) != t.c_brace) {
        parse.parse_error_at(p, c"unclosed block, expected '}'", sp_start)
    }
    parse.expect(p, t.c_brace)
    sp_end := parse.prev_span(p)

    slice: Slice(u32) = .{ ptr: glob_stack.ptr_at(mark), len: glob_stack.len - mark }
    list_id := db.add_list(slice)

    glob_stack.reset(mark)
    p.env.reset(env_mark)

    node := p.hir.push(k.block, list_id, hir.hir_none(), hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
}

parse_return :: fn(p &parse.Parser) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    sp_end := sp_start
    parse.bump(p)

    val := hir.hir_none()
    if (not parse.peek_preceded_by_newline(p)) and (parse.peek(p) != t.comma) and
        (parse.peek(p) != t.c_brace) and
        (parse.peek(p) != t.eof) {
        val = parse_expr(p, 0 as u8)
        sp_end = parse_common.span_of_hir(p, val)
    }
    node := p.hir.push(k.k_ret, val, hir.hir_none(), hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
}

parse_break :: fn(p &parse.Parser) u32 {
    k := hir.hir_kind
    sp := parse.curr_span(p)
    parse.bump(p)
    node := p.hir.push(k.k_break, hir.hir_none(), hir.hir_none(), hir.hir_none())
    parse_common.set_span(p, node, sp)
}

parse_cont :: fn(p &parse.Parser) u32 {
    k := hir.hir_kind
    sp := parse.curr_span(p)
    parse.bump(p)
    node := p.hir.push(k.k_cont, hir.hir_none(), hir.hir_none(), hir.hir_none())
    parse_common.set_span(p, node, sp)
}

parse_match :: fn(p &parse.Parser) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)

    first := parse_expr(p, 0 as u8)
    value := first
    binder_name := hir.hir_none()
    binding_mode := false
    if parse.optional(p, t.kw_in) {
        second := parse_expr(p, 0 as u8)
        if p.hir.kind(first) != k.ident {
            parse.parse_error_at(
                p
                c"match binding must be an identifier"
                p.db.get_hir_span(first)
            )
        }
        value = second
        binder_name = p.hir.push(k.match_binding, p.hir.lhs(first), hir.hir_none(), hir.hir_none())
        parse_common.set_span(p, binder_name, p.db.get_hir_span(first))
        binding_mode = true
    }
    if not parse.expect(p, t.o_brace) {
        parse.parse_error_at(p, c"expected '{' after match value", parse.curr_span(p))
    }
    arms := Vec(u32).new()
    while (parse.peek(p) != t.c_brace) and (not parse.is_eof(p)) {
        arm_sp_start := parse.curr_span(p)

        patterns := Vec(u32).new()
        is_else := false
        if parse.peek(p) == t.kw_else {
            parse.bump(p)
            is_else = true
        } else {
            patterns.push(parse_expr(p, prec().logic_or))
            while (parse.peek(p) != t.o_brace) and (not parse.is_eof(p)) {
                parse_common.check_separator(
                    p
                    t.o_brace
                    c"expected ',' or newline between match patterns"
                )
                if parse.peek(p) == t.o_brace {
                    break
                }
                patterns.push(parse_expr(p, prec().logic_or))
            }
        }

        arm_env_mark := p.env.mark()
        binder_ident := hir.hir_none()
        if binding_mode {
            binder_ident = p.hir.push(
                k.ident
                p.hir.lhs(binder_name)
                hir.hir_none()
                hir.hir_none()
            )
            parse_common.set_span(p, binder_ident, p.db.get_hir_span(binder_name))
            binder_sym := p.db.alloc_local_symbol(p.file_id, p.hir.lhs(binder_name), binder_ident)
            p.env.define(p.hir.lhs(binder_name), binder_sym)
        }
        if parse.peek(p) != t.o_brace {
            parse.parse_error_at(p, c"expected '{' after match pattern", parse.curr_span(p))
        }
        body := parse_expr(p, 0 as u8)
        p.env.reset(arm_env_mark)

        patterns_id := parse_common.add_list(p, &patterns)
        patterns.destroy()
        marker := hir.hir_none()
        if binding_mode {
            marker = binder_ident
        }
        arm := p.hir.push(k.match_arm, patterns_id, body, marker)
        parse_common.set_span(p, arm, span_merge(arm_sp_start, parse.prev_span(p)))
        arms.push(arm)
        parse_common.check_separator(p, t.c_brace, c"expected ',' or newline between match arms")
    }

    if parse.is_eof(p) and (parse.peek(p) != t.c_brace) {
        parse.parse_error_at(p, c"unclosed match, expected '}'", sp_start)
    }
    parse.expect(p, t.c_brace)
    sp_end := parse.prev_span(p)
    arms_id := parse_common.add_list(p, &arms)
    arms.destroy()
    node := p.hir.push(k.k_match, value, arms_id, binder_name)
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
}

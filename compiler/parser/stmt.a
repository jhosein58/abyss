import compiler.token: Token
import compiler.hir: hir_kind, hir_none
import compiler.parser.core: Parser, bump, optional, peek, is_eof, expect, curr_span, prev_span, parse_error_at, peek_preceded_by_newline
import compiler.nexus.nexus: span_merge
import compiler.nexus.pool: id_none
import compiler.parser.prec: prec
import .common: span_of_hir, set_span, check_separator, parse_scoped_import, add_list
import .expr: parse_ident
import compiler.parser.parser: parse_expr

parse_if :: fn(p &Parser) u32 {
    t := Token
    k := hir_kind
    sp_start := curr_span(p)
    bump(p)

    cond := parse_expr(p, 0 as u8)

    thenb := parse_expr(p, 0 as u8)
    sp_end := span_of_hir(p, thenb)

    elseb := hir_none()
    if optional(p, t.kw_else) {
        elseb = parse_expr(p, prec().assignment + (1 as u8))
        sp_end = span_of_hir(p, elseb)
    }

    node := p.hir.push(k.k_if, cond, thenb, elseb)
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_while :: fn(p &Parser) u32 {
    k := hir_kind
    sp_start := curr_span(p)
    bump(p)

    cond := parse_expr(p, 0 as u8)

    body := parse_expr(p, 0 as u8)
    sp_end := span_of_hir(p, body)

    node := p.hir.push(k.k_while, cond, body, hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_for :: fn(p &Parser) u32 {
    t := Token
    k := hir_kind
    sp_start := curr_span(p)
    bump(p)
    env_mark := p.env.mark()

    vars := Vec(u32).new()
    first := parse_ident(p)
    first_name := p.hir.lhs(first)
    first_sym := p.db.alloc_local_symbol(p.file_id, first_name, first)
    p.env.define(first_name, first_sym)
    vars.push(first)
    while (peek(p) != t.kw_in) and (not is_eof(p)) {
        check_separator(p, t.kw_in, c"expected ',' or newline between for variables")
        if peek(p) == t.kw_in { break }
        name := parse_ident(p)
        name_id := p.hir.lhs(name)
        sym := p.db.alloc_local_symbol(p.file_id, name_id, name)
        p.env.define(name_id, sym)
        vars.push(name)
    }

    if not expect(p, t.kw_in) {
        parse_error_at(p, c"expected 'in' after for variables", curr_span(p))
    }

    iters := Vec(u32).new()
    iters.push(parse_expr(p, 0 as u8))
    while (peek(p) != t.o_brace) and (not is_eof(p)) {
        check_separator(p, t.o_brace, c"expected ',' or newline between for iterators")
        if peek(p) == t.o_brace { break }
        iters.push(parse_expr(p, 0 as u8))
    }
    if vars.len != iters.len {
        parse_error_at(p, c"for requires one iterator for each loop variable", curr_span(p))
    }

    if peek(p) != t.o_brace {
        parse_error_at(p, c"expected '{' after for iterators", curr_span(p))
    }
    vars_id := add_list(p, &vars)
    iters_id := add_list(p, &iters)
    vars.destroy()
    iters.destroy()

    node := p.hir.push(k.k_for, vars_id, iters_id, hir_none())
    set_span(p, node, sp_start)

    body := parse_expr(p, 0 as u8)
    p.env.reset(env_mark)

    sp_end := span_of_hir(p, body)
    p.hir.set_extra(node, body)
    set_span(p, node, span_merge(sp_start, sp_end))
    node
}

parse_block :: fn(p &Parser) u32 {
    k := hir_kind
    t := Token

    db := &p.db
    glob_stack := &db.glob_stack

    sp_start := curr_span(p)
    mark := glob_stack.mark()
    env_mark := p.env.mark()

    bump(p)

    while (peek(p) != t.c_brace) and (not is_eof(p)) {
        if peek(p) == t.kw_import {
            parse_scoped_import(p)
            check_separator(p, t.c_brace, c"expected ',' or newline between block expressions")
            cont
        }
        expr := parse_expr(p, 0)
        if (peek(p) == t.ident) and (not peek_preceded_by_newline(p)) {
            first := expr
            while p.hir.kind(first) == k.index {
                first = p.hir.lhs(first)
            }
            if (p.hir.kind(first) == k.ident) and (p.db.get_hir_symbol(first) == id_none()) {
                parse_error_at(p, c"field declarations require 'struct { ... }'; use ':' for local variable declarations", span_of_hir(p, first))
            }
        }
        glob_stack.push(expr)
        check_separator(p, t.c_brace, c"expected ',' or newline between block expressions")
    }

    if is_eof(p) and (peek(p) != t.c_brace) {
        parse_error_at(p, c"unclosed block, expected '}'", sp_start)
    }

    expect(p, t.c_brace)
    sp_end := prev_span(p)

    slice: Slice(u32) = .{
        ptr: glob_stack.ptr_at(mark),
        len: glob_stack.len - mark
    }
    list_id := db.add_list(slice)

    glob_stack.reset(mark)
    p.env.reset(env_mark)

    node := p.hir.push(k.block, list_id, hir_none(), hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_return :: fn(p &Parser) u32 {
    t := Token
    k := hir_kind
    sp_start := curr_span(p)
    sp_end := sp_start
    bump(p)

    val := hir_none()
    if (not peek_preceded_by_newline(p)) and (peek(p) != t.comma) and (peek(p) != t.c_brace) and (peek(p) != t.eof) {
        val = parse_expr(p, 0 as u8)
        sp_end = span_of_hir(p, val)
    }

    node := p.hir.push(k.k_ret, val, hir_none(), hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_break :: fn(p &Parser) u32 {
    k := hir_kind
    sp := curr_span(p)
    bump(p)
    node := p.hir.push(k.k_break, hir_none(), hir_none(), hir_none())
    set_span(p, node, sp)
}

parse_cont :: fn(p &Parser) u32 {
    k := hir_kind
    sp := curr_span(p)
    bump(p)
    node := p.hir.push(k.k_cont, hir_none(), hir_none(), hir_none())
    set_span(p, node, sp)
}

parse_match :: fn(p &Parser) u32 {
    t := Token
    k := hir_kind
    sp_start := curr_span(p)
    bump(p)

    first := parse_expr(p, 0 as u8)
    value := first
    binder_name := hir_none()
    binding_mode := false
    if optional(p, t.kw_in) {
        second := parse_expr(p, 0 as u8)
        if p.hir.kind(first) != k.ident {
            parse_error_at(p, c"match binding must be an identifier", p.db.get_hir_span(first))
        }
        value = second
        binder_name = p.hir.push(k.match_binding, p.hir.lhs(first), hir_none(), hir_none())
        set_span(p, binder_name, p.db.get_hir_span(first))
        binding_mode = true
    }
    if not expect(p, t.o_brace) {
        parse_error_at(p, c"expected '{' after match value", curr_span(p))
    }

    arms := Vec(u32).new()
    while (peek(p) != t.c_brace) and (not is_eof(p)) {
        arm_sp_start := curr_span(p)

        patterns := Vec(u32).new()
        is_else := false
        if peek(p) == t.kw_else {
            bump(p)
            is_else = true
        } else {
            patterns.push(parse_expr(p, prec().logic_or))
            while (peek(p) != t.o_brace) and (not is_eof(p)) {
                check_separator(p, t.o_brace, c"expected ',' or newline between match patterns")
                if peek(p) == t.o_brace { break }
                patterns.push(parse_expr(p, prec().logic_or))
            }
        }

        arm_env_mark := p.env.mark()
        binder_ident := hir_none()
        if binding_mode {
            binder_ident = p.hir.push(k.ident, p.hir.lhs(binder_name), hir_none(), hir_none())
            set_span(p, binder_ident, p.db.get_hir_span(binder_name))
            binder_sym := p.db.alloc_local_symbol(p.file_id, p.hir.lhs(binder_name), binder_ident)
            p.env.define(p.hir.lhs(binder_name), binder_sym)
        }

        if peek(p) != t.o_brace {
            parse_error_at(p, c"expected '{' after match pattern", curr_span(p))
        }
        body := parse_expr(p, 0 as u8)
        p.env.reset(arm_env_mark)

        patterns_id := add_list(p, &patterns)
        patterns.destroy()
        marker := hir_none()
        if binding_mode { marker = binder_ident }
        arm := p.hir.push(k.match_arm, patterns_id, body, marker)
        set_span(p, arm, span_merge(arm_sp_start, prev_span(p)))
        arms.push(arm)
        check_separator(p, t.c_brace, c"expected ',' or newline between match arms")
    }

    if is_eof(p) and (peek(p) != t.c_brace) {
        parse_error_at(p, c"unclosed match, expected '}'", sp_start)
    }
    expect(p, t.c_brace)
    sp_end := prev_span(p)
    arms_id := add_list(p, &arms)
    arms.destroy()
    node := p.hir.push(k.k_match, value, arms_id, binder_name)
    set_span(p, node, span_merge(sp_start, sp_end))
}

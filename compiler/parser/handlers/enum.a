import token from "../../token.a"
import hir_kind, hir_none from "../../hir.a"
import Parser, bump, optional, expect, peek, is_eof, curr_span, prev_span, parse_error_at from "../core.a"
import Vec from "../../../std/collections/vec.a"
import span_merge from "../../nexus/nexus.a"
import id_none from "../../nexus/pool.a"
import prec from "../prec.a"
import set_span, skip_separators, check_delimiter, parse_method, add_methods_id, bind_method_owners, ensure_type_node, finish_type_node, add_list from "common.a"
import parse_ident from "ident.a"
import parse_expr from "../parser.a"

parse_enum :: fn(p &Parser) u32 {
    t := token
    k := hir_kind
    sp_start := curr_span(p)
    bump(p)

    backing_ty := hir_none()
    if peek(p) != t.o_brace {
        backing_ty = parse_expr(p, prec().var_def + (1 as u8))
    }

    if not expect(p, t.o_brace) {
        parse_error_at(p, c"expected '{' after enum", curr_span(p))
    }

    names := Vec(u32).new()
    vals := Vec(u32).new()
    methods := Vec(u32).new()

    enum_node := id_none()
    enum_toplv := p.toplv_sym
    p.toplv_sym = id_none()

    while (peek(p) != t.c_brace) and (not is_eof(p)) {
        skip_separators(p)
        if (peek(p) == t.c_brace) or (peek(p) == t.eof) { break }

        name := parse_ident(p)
        if peek(p) == t.colon_colon {
            ensure_type_node(p, &enum_node, k.enum_, enum_toplv)
            parse_method(p, name, &methods)
            cont
        }

        val_expr := hir_none()
        if optional(p, t.eq) {
            val_expr = parse_expr(p, prec().assignment + (1 as u8))
        }

        names.push(name)
        vals.push(val_expr)

        check_delimiter(p, c"expected ';' or newline between enum variants")
    }

    if is_eof(p) and (peek(p) != t.c_brace) {
        parse_error_at(p, c"unclosed enum definition, expected '}'", sp_start)
    }

    expect(p, t.c_brace)
    sp_end := prev_span(p)

    names_id := add_list(p, &names)
    vals_id := add_list(p, &vals)
    names.destroy()
    vals.destroy()

    methods_id := add_methods_id(p, &methods)
    meta := Vec(u32).new()
    meta.push(backing_ty)
    meta.push(methods_id)
    meta_id := add_list(p, &meta)
    meta.destroy()

    finish_type_node(p, &enum_node, k.enum_, names_id, vals_id, meta_id, enum_toplv, &methods, span_merge(sp_start, sp_end))
}

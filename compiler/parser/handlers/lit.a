import token from "../../token.a"
import hir_kind, hir_none from "../../hir.a"
import Parser, bump, curr_text, curr_span from "../core.a"
import parse_u32 from "../../../std/string.a"
import set_span from "common.a"

parse_lit_int :: fn(p &Parser) u32 {
    k := hir_kind
    sp := curr_span(p)
    val := parse_u32(curr_text(p)).unwrap_or(0)
    bump(p)
    node := p.hir.push(k.lit_int, val, hir_none(), hir_none())
    set_span(p, node, sp)
}

parse_float :: fn(p &Parser) u32 {
    k := hir_kind
    sp := curr_span(p)
    name := curr_text(p)
    name_id := p.db.interner.intern(name)
    bump(p)
    node := p.hir.push(k.lit_float, name_id, hir_none(), hir_none())
    set_span(p, node, sp)
}

parse_str :: fn(p &Parser) u32 {
    k := hir_kind
    sp := curr_span(p)
    raw := curr_text(p)
    bump(p)
    name_id := p.db.interner.intern(raw)
    node := p.hir.push(k.lit_str, name_id, hir_none(), hir_none())
    set_span(p, node, sp)
}


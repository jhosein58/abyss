import token from "../../token.a"
import hir_kind, hir_none from "../../hir.a"
import Parser, peek, bump, optional, expect, is_eof, curr_span, prev_span, parse_error_at from "../core.a"
import ScopeEnv_mark, ScopeEnv_reset, ScopeEnv_define from "../env.a"
import VecU32 from "../../../std/vec/u32.a"
import Span, span_merge from "../../nexus/nexus.a"
import id_none from "../../nexus/pool.a"
import span_of_hir, set_span from "common.a"
import parse_ident from "ident.a"
import parse_block from "control.a"
import parse_expr from "../parser.a"
import prec from "../prec.a"

define_param :: (p &Parser, name_hir u32) {
    k := hir_kind
    if p.hir.kind(name_hir) != k.ident {
        parse_error_at(p, c"parameter name must be an identifier", span_of_hir(p, name_hir))
    }
    name_id := p.hir.lhs(name_hir)
    sym_id := p.db.alloc_local_symbol(p.file_id, name_id, name_hir)
    ScopeEnv_define(&p.env, name_id, sym_id)
}

is_named_group :: (p &Parser) bool {
    t := token
    depth: u32 = 1
    i := p.cursor + 1
    prev := t.eof
    while i < p.end {
        tk := p.tokens.kind(i)
        if tk == t.o_paren {
            depth = depth + 1
        } else if tk == t.c_paren {
            depth = depth - 1
            if depth == 0 { break }
        } else if depth == 1 {
            if (prev == t.ident) and
               ((tk == t.ident) or (tk == t.amp) or (tk == t.star) or
                (tk == t.o_bracket) or (tk == t.o_paren)) {
                ret true
            }
        }
        prev = tk
        i = i + 1
    }
    false
}

is_fn_header :: (p &Parser) bool {
    t := token
    if peek(p) == t.c_paren { ret true }

    i := p.cursor
    depth: u32 = 1
    has_type := false
    has_comma := false
    prev := t.eof

    while i < p.end {
        tk := p.tokens.kind(i)
        if tk == t.o_paren {
            depth = depth + 1
        } else if tk == t.c_paren {
            depth = depth - 1
            if depth == 0 { break }
        } else if depth == 1 {
            if tk == t.comma {
                has_comma = true
            } else if (prev == t.ident) and
                      ((tk == t.ident) or (tk == t.amp) or (tk == t.star) or
                       (tk == t.o_bracket) or (tk == t.o_paren)) {
                has_type = true
            } else if (tk != t.ident) and (tk != t.amp) and (tk != t.star) and
                      (tk != t.o_bracket) and (tk != t.c_bracket) and
                      (tk != t.o_paren) and (tk != t.c_paren) and (tk != t.pipe) {
                ret false
            }
        }
        prev = tk
        i = i + 1
    }

    if depth != 0 { ret false }

    after := t.eof
    if (i + 1) < p.end {
        after = p.tokens.kind(i + 1)
    }

    if after == t.o_brace {
        ret has_type or has_comma
    }

    if not p.tokens.newline_before(i + 1) {
        if (after == t.ident) or (after == t.amp) or (after == t.star) or (after == t.o_bracket) {
            ret true
        }
        if (after == t.o_paren) and (has_type or has_comma) {
            ret true
        }
    }

    false
}

fn_params_have_names :: (p &Parser, params u32) bool {
    if params == hir_none() { ret true }
    list := p.db.get_list(params)
    if list.len == 0 { ret true }
    first_arg := *(list.ptr)
    p.hir.lhs(first_arg) != hir_none()
}

parse_fn_tail :: (p &Parser, params u32, sp_start Span) u32 {
    saved_toplv := p.toplv_sym
    p.toplv_sym = id_none()

    t := token
    k := hir_kind

    ret_ty := hir_none()
    sp_end := sp_start
    if (peek(p) != t.o_brace) and (peek(p) != t.eq) and (peek(p) != t.comma) and
       (peek(p) != t.c_paren) and (peek(p) != t.c_brace) and (not is_eof(p)) {
        ret_ty = parse_expr(p, prec().var_def + (1 as u8))
        sp_end = span_of_hir(p, ret_ty)
    }

    p.toplv_sym = saved_toplv
    is_toplv_fn := p.toplv_sym != id_none()

    fn_sym := id_none()
    if is_toplv_fn {
        fn_sym = p.toplv_sym
        p.toplv_sym = id_none()
    }

    fn_node := p.hir.push(k.function, params, ret_ty, hir_none())
    if is_toplv_fn {
        p.db.set_hir_symbol(fn_node, fn_sym)
    }

    body := hir_none()
    if fn_params_have_names(p, params) and (peek(p) == t.o_brace) {
        body = parse_block(p)
        sp_end = span_of_hir(p, body)
        p.hir.set_rhs(body, fn_node)
        if not is_toplv_fn {
            fn_sym = p.db.alloc_local_symbol(p.file_id, 0, fn_node)
            p.db.set_hir_symbol(fn_node, fn_sym)
        }
    }

    p.hir.set_extra(fn_node, body)
    set_span(p, fn_node, span_merge(sp_start, sp_end))
}

parse_paren :: (p &Parser) u32 {
    t := token
    sp_start := curr_span(p)
    bump(p)

    if optional(p, t.c_paren) {
        env_mark := ScopeEnv_mark(&p.env)
        fn_id := parse_fn_tail(p, hir_none(), sp_start)
        ScopeEnv_reset(&p.env, env_mark)
        ret fn_id
    }

    if is_fn_header(p) {
        saved_toplv := p.toplv_sym
        p.toplv_sym = id_none()

        env_mark := ScopeEnv_mark(&p.env)
        args := VecU32.new()
        pending_names := VecU32.new()

        while (peek(p) != t.c_paren) and (not is_eof(p)) {
            is_type_token := (peek(p) == t.amp) or (peek(p) == t.star) or
                             (peek(p) == t.o_bracket) or (peek(p) == t.o_paren)

            if is_type_token {
                ty := parse_expr(p, 0 as u8)
                p_sp := span_of_hir(p, ty)
                arg_id := p.hir.push(hir_kind.arg, hir_none(), ty, hir_none())
                set_span(p, arg_id, p_sp)
                args.push(arg_id)
                optional(p, t.comma)
                cont
            }

            name_or_ty := parse_ident(p)

            next_tk := peek(p)
            has_explicit_type := (next_tk == t.ident) or (next_tk == t.amp) or
                                 (next_tk == t.star) or (next_tk == t.o_bracket) or
                                 (next_tk == t.o_paren)

            if has_explicit_type {
                define_param(p, name_or_ty)
                pending_names.push(name_or_ty)
                ty := parse_expr(p, 0 as u8)
                p_i: u64 = 0
                while p_i < pending_names.len {
                    p_name := pending_names.get(p_i)
                    p_sp := span_merge(span_of_hir(p, p_name), span_of_hir(p, ty))
                    arg_id := p.hir.push(hir_kind.arg, p_name, ty, hir_none())
                    set_span(p, arg_id, p_sp)
                    args.push(arg_id)
                    p_i = p_i + 1
                }
                pending_names.reset(0)
                optional(p, t.comma)
                cont
            }

            if next_tk == t.comma {
                if is_named_group(p) {
                    define_param(p, name_or_ty)
                    pending_names.push(name_or_ty)
                    bump(p)
                    cont
                }
            }

            p_sp := span_of_hir(p, name_or_ty)
            arg_id := p.hir.push(hir_kind.arg, hir_none(), name_or_ty, hir_none())
            set_span(p, arg_id, p_sp)
            args.push(arg_id)
            optional(p, t.comma)
        }

        expect(p, t.c_paren)

        params := p.db.add_list(args.as_slice())
        pending_names.destroy()
        args.destroy()

        p.toplv_sym = saved_toplv
        fn_id := parse_fn_tail(p, params, sp_start)
        ScopeEnv_reset(&p.env, env_mark)
        ret fn_id
    }

    expr := parse_expr(p, 0 as u8)
    expect(p, t.c_paren)
    sp_end := prev_span(p)
    set_span(p, expr, span_merge(sp_start, sp_end))
}

parse_call :: (p &Parser, lhs u32, right_bp u8) u32 {
    t := token
    k := hir_kind
    sp_lhs := span_of_hir(p, lhs)

    args := VecU32.new()
    if not optional(p, t.c_paren) {
        while true {
            if peek(p) == t.c_paren { break }
            if is_eof(p) {
                parse_error_at(p, c"unclosed call, expected ')'", sp_lhs)
            }
            arg := parse_expr(p, 0 as u8)
            if arg == hir_none() {
                parse_error_at(p, c"expected call argument", curr_span(p))
            }
            args.push(arg)

            if peek(p) == t.c_paren { break }
            if not expect(p, t.comma) {
                parse_error_at(p, c"expected ',' or ')' after call argument", curr_span(p))
            }
        }
        expect(p, t.c_paren)
    }

    sp_end := prev_span(p)
    args_list := p.db.add_list(args.as_slice())
    args.destroy()

    node := p.hir.push(k.call, lhs, args_list, hir_none())
    set_span(p, node, span_merge(sp_lhs, sp_end))
}

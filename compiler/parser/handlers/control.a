import token from "../../token.a"
import hir_kind, hir_none from "../../hir.a"
import Parser, bump, optional, peek, is_eof, expect, curr_span, prev_span, parse_error_at, peek_preceded_by_newline from "../core.a"
import ScopeEnv_mark, ScopeEnv_reset from "../env.a"
import SliceU32 from "../../../std/slice/u32.a"
import span_merge from "../../nexus/nexus.a"
import span_of_hir, set_span from "common.a"
import parse_expr from "../parser.a"

parse_if :: (p &Parser) u32 {
    t := token()
    k := hir_kind()
    sp_start := curr_span(p)
    bump(p)

    prev_allow_fn := (*p).allow_fn
    (*p).allow_fn = false
    cond := parse_expr(p, 0 as u8)
    (*p).allow_fn = prev_allow_fn

    thenb := parse_expr(p, 0 as u8)
    sp_end := span_of_hir(p, thenb)

    elseb := hir_none()
    if optional(p, t.kw_else) {
        elseb = parse_expr(p, 0 as u8)
        sp_end = span_of_hir(p, elseb)
    }

    node := ((*p).hir).push(k.k_if, cond, thenb, elseb)
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_while :: (p &Parser) u32 {
    k := hir_kind()
    sp_start := curr_span(p)
    bump(p)

    prev_allow_fn := (*p).allow_fn
    (*p).allow_fn = false
    cond := parse_expr(p, 0 as u8)
    (*p).allow_fn = prev_allow_fn

    body := parse_expr(p, 0 as u8)
    sp_end := span_of_hir(p, body)

    node := ((*p).hir).push(k.k_while, cond, body, hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_block :: (p &Parser) u32 {
    k := hir_kind()
    t := token()

    db := &(*(*p).db)
    glob_stack := &(*db).glob_stack

    sp_start := curr_span(p)
    mark := glob_stack.mark()
    env_mark := ScopeEnv_mark(&(*p).env)

    bump(p)

    while (peek(p) != t.c_brace) and (not is_eof(p)) {
        glob_stack.push(parse_expr(p, 0))
    }

    if is_eof(p) and (peek(p) != t.c_brace) {
        parse_error_at(p, "unclosed block, expected '}'", sp_start)
    }

    expect(p, t.c_brace)
    sp_end := prev_span(p)

    slice: SliceU32 = .{
        ptr: glob_stack.ptr_at(mark),
        len: glob_stack.len - mark
    }
    list_id := db.add_list(slice)

    glob_stack.reset(mark)
    ScopeEnv_reset(&(*p).env, env_mark)

    node := ((*p).hir).push(k.block, list_id, hir_none(), hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_return :: (p &Parser) u32 {
    t := token()
    k := hir_kind()
    sp_start := curr_span(p)
    sp_end := sp_start
    bump(p)

    val := hir_none()
    if (not peek_preceded_by_newline(p)) and (peek(p) != t.c_brace) and (peek(p) != t.eof) {
        val = parse_expr(p, 0 as u8)
        sp_end = span_of_hir(p, val)
    }

    fn_id := hir_none()
    if not (*p).fn_stack.is_empty() {
        fn_id = (*p).fn_stack.last()
    }

    node := ((*p).hir).push(k.k_ret, val, fn_id, hir_none())
    set_span(p, node, span_merge(sp_start, sp_end))
}

parse_break :: (p &Parser) u32 {
    k := hir_kind()
    sp := curr_span(p)
    bump(p)
    node := ((*p).hir).push(k.k_break, hir_none(), hir_none(), hir_none())
    set_span(p, node, sp)
}

parse_cont :: (p &Parser) u32 {
    k := hir_kind()
    sp := curr_span(p)
    bump(p)
    node := ((*p).hir).push(k.k_cont, hir_none(), hir_none(), hir_none())
    set_span(p, node, sp)
}

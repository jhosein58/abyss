import token, token_name, TokenType, TokenStream from "../token.a"
import HirTable from "../hir.a"
import Str from "../../std/string.a"
import Nexus,
       calc_pos, Span, Pos, span_new, span_merge from "../nexus/nexus.a"
import ScopeEnv, ScopeEnv_new, ScopeEnv_destroy, ScopeEnv_lookup from "env.a"
import id_none from "../nexus/pool.a"
import fall from "../../std/sys.a"


print     :: (s &u8) unit
print_u32 :: (v u32) unit

Parser :: struct {
    db        : &Nexus,
    tokens    : &TokenStream,
    hir       : &HirTable,
    cursor    : u32,
    end       : u32,
    file_id   : u32,
    toplv_sym : u32,
    env       : ScopeEnv,
    allow_fn  : bool,
    inside_method : bool,
    method_fn_depth : u32
}

Parser_new :: (db &Nexus, tokens &TokenStream, hir &HirTable, file_id u32, toplv_sym u32, start u32, count u32) Parser {
    .{
        db        : db,
        tokens    : tokens,
        hir       : hir,
        cursor    : start,
        end       : start + count,
        file_id   : file_id,
        toplv_sym : toplv_sym,
        env       : ScopeEnv_new(),
        allow_fn  : true,
        inside_method : false,
        method_fn_depth : 0
    }
}

lookup_sym :: (p &Parser, name_id u32) u32 {
    sym := ScopeEnv_lookup(&(*p).env, name_id)
    if sym != id_none() {
        ret sym
    }

    (*p).db.find_symbol((*p).file_id, name_id)
}

is_eof :: (p &Parser) bool {
    p.cursor >= p.end
}

peek :: (p &Parser) u8 {
    if p.cursor >= p.end {
        ret token().eof
    }
    p.tokens.kind(p.cursor)
}

peek_n :: (p &Parser, n u32) u8 {
    target := (*p).cursor + n
    if target >= (*p).end {
        ret token().eof
    }
    p.tokens.kind(target)
}

bump :: (p &Parser) u32 {
    c := (*p).cursor
    if (*p).cursor < (*p).end {
        (*p).cursor = (*p).cursor + 1
    }
    c
}

optional :: (p &Parser, kind u8) bool {
    if peek(p) == kind {
        bump(p)
        ret true
    }
    false
}

expect :: (p &Parser, kind u8) bool {
    if peek(p) == kind {
        bump(p)
        ret true
    }
    false
}

peek_preceded_by_newline :: (p &Parser) bool {
    if (*p).cursor >= (*p).end {
        ret false
    }
    p.tokens.newline_before(p.cursor)
}

curr_text :: (p &Parser) Str {
    if (*p).cursor >= (*p).end {
        ret Str.empty()
    }
    p.tokens.text(p.cursor)
}

prev_text :: (p &Parser) Str {
    if (*p).cursor == 0 {
        ret Str.empty()
    }
     p.tokens.text(p.cursor - 1)
}

str_to_u32 :: (p &Parser, s Str) u32 {
    res: u32 = 0
    i: u64 = 0
    base: u32 = 10
    if s.len == 0 {
        parse_error_at(p, "empty integer literal", curr_span(p))
    }
    if s.len >= 2 {
        if (*(s.ptr) == 48) and ((*(s.ptr + 1) == 120) or (*(s.ptr + 1) == 88)) {
            base = 16
            i = 2
        }
    }
    if i == s.len {
        parse_error_at(p, "missing hexadecimal digits", curr_span(p))
    }
    seen_digit := false
    after_sep := false
    while i < s.len {
        c := *(s.ptr + i)
        if c == 95 {
            if (not seen_digit) or after_sep or ((i + 1) == s.len) {
                parse_error_at(p, "misplaced integer separator", curr_span(p))
            }
            after_sep = true
            i = i + 1
            cont
        }

        digit: u32 = 16
        if (c >= 48) and (c <= 57) { digit = (c - 48) as u32 }
        if (c >= 65) and (c <= 70) { digit = (c - 65) as u32 + 10 }
        if (c >= 97) and (c <= 102) { digit = (c - 97) as u32 + 10 }
        if digit >= base {
            parse_error_at(p, "invalid integer digit", curr_span(p))
        }
        if ((base == 10) and ((res > 429496729) or ((res == 429496729) and (digit > 5)))) or
           ((base == 16) and (res > 268435455)) {
            parse_error_at(p, "integer literal exceeds u32", curr_span(p))
        }
        res = (res * base) + digit
        seen_digit = true
        after_sep = false
        i = i + 1
    }
    res
}

tok_span :: (p &Parser, idx u32) Span {
    if idx >= (*p).end {
        if (*p).end > 0 {
            last := (*p).end - 1
            st :=  p.tokens.start(last)
            ln :=  p.tokens.len(last)
            ret span_new(st + ln, st + ln)
        }
        ret span_new(0, 0)
    }
    st :=  p.tokens.start(idx)
    ln :=  p.tokens.len(idx)
    span_new(st, st + ln)
}

curr_span :: (p &Parser) Span {
    tok_span(p, (*p).cursor)
}

prev_span :: (p &Parser) Span {
    if (*p).cursor == 0 { ret span_new(0, 0) }
    tok_span(p, (*p).cursor - 1)
}

parse_error_at :: (p &Parser, msg &u8, sp Span) {
    path := (*p).db.get_file_path((*p).file_id)
    src := (*p).db.get_file_source((*p).file_id)
    pos := calc_pos(src, sp.start)

    print("\n\033[1;31m[syntax error]\033[0m ")
    print(msg)
    print("\n       --> ")
    print(path.ptr)
    print(":")
    print_u32(pos.line)
    print(":")
    print_u32(pos.col)
    print("\n\n")
    fall()
}

expect :: (p &Parser, kind u8) {
    if peek(p) == kind {
        bump(p)
        ret
    }

    sp := curr_span(p)
    path := (*p).db.get_file_path((*p).file_id)
    src := (*p).db.get_file_source((*p).file_id)
    pos := calc_pos(src, sp.start)

    print("\n\033[1;31m[syntax error]\033[0m expected '")
    exp_name := token_name(kind)
    exp_name.prin()
    print("', but found '")
    got_name := token_name(peek(p))
    got_name.print()
    if peek(p) != token().eof {
        print("' (")
        txt := curr_text(p)
        txt.print()
        print(")")
    } else {
        print("'")
    }
    print("\n       --> ")
    print(path.ptr)
    print(":")
    print_u32(pos.line)
    print(":")
    print_u32(pos.col)
    print("\n\n")
    fall()
}

fall :: @import("std/sys").fall

HirTable :: @import("compiler/hir").HirTable
nexus :: @import("compiler/nexus/nexus")
token :: @import("compiler/token")
ScopeEnv :: @import("./env").ScopeEnv

Parser :: struct {
    db         &nexus.Nexus
    tokens     &token.TokenStream
    hir        &HirTable
    cursor     u32
    end        u32
    file_id    u32
    toplv_sym  u32
    file_scope bool
    env        ScopeEnv
}

Parser_new :: fn(
    db &nexus.Nexus
    tokens &token.TokenStream
    hir &HirTable
    file_id u32
    toplv_sym u32
    start u32
    count u32
) Parser {
    .{
        db: db
        tokens: tokens
        hir: hir
        cursor: start
        end: start + count
        file_id: file_id
        toplv_sym: toplv_sym
        file_scope: false
        env: ScopeEnv.new()
    }
}

lookup_sym :: fn(p &Parser, name_id u32) u32 {
    p.env.lookup(name_id)
}

capture_splice_scope :: fn(p &Parser, node u32) {
    if p.env.syms.len > 0 {
        scope := p.db.add_list(p.env.syms.as_slice())
        p.db.splice_scopes.insert(node, scope)
    }
}

restore_splice_scope :: fn(p &Parser, node u32) {
    scope := p.db.splice_scopes.get(node)
    if scope == (0 as &u32) { ret }
    for sym in p.db.get_list(*scope) {
        p.env.define(p.db.sym_name(sym), sym)
    }
}

is_eof :: fn(p &Parser) bool {
    p.cursor >= p.end
}

peek :: fn(p &Parser) token.Token {
    if p.cursor >= p.end {
        ret token.Token.eof
    }
    p.tokens.kind(p.cursor)
}

peek_n :: fn(p &Parser, n u32) token.Token {
    target := (*p).cursor + n
    if target >= (*p).end {
        ret token.Token.eof
    }
    p.tokens.kind(target)
}

begins_declaration :: fn(p &Parser) bool {
    peek(p) == token.Token.ident and
        (peek_n(p, 1) == token.Token.colon or peek_n(p, 1) == token.Token.colon_colon)
}

bump :: fn(p &Parser) u32 {
    c := (*p).cursor
    if (*p).cursor < (*p).end {
        (*p).cursor = (*p).cursor + 1
    }
    c
}

optional :: fn(p &Parser, kind token.Token) bool {
    if peek(p) == kind {
        bump(p)
        ret true
    }
    false
}

peek_preceded_by_newline :: fn(p &Parser) bool {
    if (*p).cursor >= (*p).end {
        ret false
    }
    p.tokens.newline_before(p.cursor)
}

curr_text :: fn(p &Parser) Str {
    if (*p).cursor >= (*p).end {
        ret Str.empty()
    }
    p.tokens.text(p.cursor)
}

prev_text :: fn(p &Parser) Str {
    if (*p).cursor == 0 {
        ret Str.empty()
    }
    p.tokens.text(p.cursor - 1)
}

tok_span :: fn(p &Parser, idx u32) nexus.Span {
    if idx >= (*p).end {
        if (*p).end > 0 {
            last := (*p).end - 1
            st := p.tokens.start(last)
            ln := p.tokens.len(last)
            ret nexus.span_new(st + ln, st + ln)
        }
        ret nexus.span_new(0, 0)
    }
    st := p.tokens.start(idx)
    ln := p.tokens.len(idx)
    nexus.span_new(st, st + ln)
}

curr_span :: fn(p &Parser) nexus.Span {
    tok_span(p, (*p).cursor)
}

prev_span :: fn(p &Parser) nexus.Span {
    if (*p).cursor == 0 {
        ret nexus.span_new(0, 0)
    }
    tok_span(p, (*p).cursor - 1)
}

parse_error_at :: fn(p &Parser, msg &u8, sp nexus.Span) {
    path := (*p).db.get_file_path((*p).file_id)
    src := (*p).db.get_file_source((*p).file_id)
    pos := nexus.calc_pos(src, sp.start)
    printf(
        "\n\033[1;31m[syntax error]\033[0m {}\n       --> {}:{}:{}\n\n"
        .{ msg, path, pos.line, pos.col }
    )
    #fall
}

expect :: fn(p &Parser, kind token.Token) bool {
    if peek(p) == kind {
        bump(p)
        ret true
    }
    false
}

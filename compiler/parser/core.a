import token, token_name, TokenType, TokenStream from "../token.a"
import HirTable from "../hir.a"
import Str from "../../std/string.a"
import Nexus,
       calc_pos, Span, Pos, span_new, span_merge from "../nexus/nexus.a"
import ScopeEnv, ScopeEnv_new, ScopeEnv_destroy, ScopeEnv_lookup from "env.a"
import id_none from "../nexus/pool.a"
import fall from "../../std/sys.a"


print     :: (s &u8) unit
print_u32 :: (v u32) unit

Parser :: struct {
    db        : &Nexus,
    tokens    : &TokenStream,
    hir       : &HirTable,
    cursor    : u32,
    end       : u32,
    file_id   : u32,
    toplv_sym : u32,
    env       : ScopeEnv
}

Parser_new :: (db &Nexus, tokens &TokenStream, hir &HirTable, file_id u32, toplv_sym u32, start u32, count u32) Parser {
    .{
        db        : db,
        tokens    : tokens,
        hir       : hir,
        cursor    : start,
        end       : start + count,
        file_id   : file_id,
        toplv_sym : toplv_sym,
        env       : ScopeEnv_new()
    }
}

lookup_sym :: (p &Parser, name_id u32) u32 {
    sym := ScopeEnv_lookup(&(*p).env, name_id)
    if sym != id_none() {
        ret sym
    }

    (*p).db.find_symbol((*p).file_id, name_id)
}

is_eof :: (p &Parser) bool {
    p.cursor >= p.end
}

peek :: (p &Parser) TokenType {
    if p.cursor >= p.end {
        ret token.eof
    }
    p.tokens.kind(p.cursor)
}

peek_n :: (p &Parser, n u32) TokenType {
    target := (*p).cursor + n
    if target >= (*p).end {
        ret token.eof
    }
    p.tokens.kind(target)
}

bump :: (p &Parser) u32 {
    c := (*p).cursor
    if (*p).cursor < (*p).end {
        (*p).cursor = (*p).cursor + 1
    }
    c
}

optional :: (p &Parser, kind TokenType) bool {
    if peek(p) == kind {
        bump(p)
        ret true
    }
    false
}

peek_preceded_by_newline :: (p &Parser) bool {
    if (*p).cursor >= (*p).end {
        ret false
    }
    p.tokens.newline_before(p.cursor)
}

curr_text :: (p &Parser) Str {
    if (*p).cursor >= (*p).end {
        ret Str.empty()
    }
    p.tokens.text(p.cursor)
}

prev_text :: (p &Parser) Str {
    if (*p).cursor == 0 {
        ret Str.empty()
    }
     p.tokens.text(p.cursor - 1)
}

tok_span :: (p &Parser, idx u32) Span {
    if idx >= (*p).end {
        if (*p).end > 0 {
            last := (*p).end - 1
            st :=  p.tokens.start(last)
            ln :=  p.tokens.len(last)
            ret span_new(st + ln, st + ln)
        }
        ret span_new(0, 0)
    }
    st :=  p.tokens.start(idx)
    ln :=  p.tokens.len(idx)
    span_new(st, st + ln)
}

curr_span :: (p &Parser) Span {
    tok_span(p, (*p).cursor)
}

prev_span :: (p &Parser) Span {
    if (*p).cursor == 0 { ret span_new(0, 0) }
    tok_span(p, (*p).cursor - 1)
}

parse_error_at :: (p &Parser, msg &u8, sp Span) {
    path := (*p).db.get_file_path((*p).file_id)
    src := (*p).db.get_file_source((*p).file_id)
    pos := calc_pos(src, sp.start)

    print(c"\n\033[1;31m[syntax error]\033[0m ")
    print(msg)
    print(c"\n       --> ")
    print(path.ptr)
    print(c":")
    print_u32(pos.line)
    print(c":")
    print_u32(pos.col)
    print(c"\n\n")
    fall()
}

expect :: (p &Parser, kind TokenType) bool {
    if peek(p) == kind {
        bump(p)
        ret true
    }
    false
}

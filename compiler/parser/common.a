hir :: @import("compiler/hir")
nexus :: @import("compiler/nexus/nexus")
id_none :: @import("compiler/nexus/pool").id_none
parse :: @import("compiler/parser/core")
parse_expr :: @import("compiler/parser/parser").parse_expr
prec :: @import("compiler/parser/prec").prec
Token :: @import("compiler/token").Token

span_of_hir :: fn(p &parse.Parser, hir_id u32) nexus.Span {
    p.db.get_hir_span(hir_id)
}

set_span :: fn(p &parse.Parser, hir_id u32, sp nexus.Span) u32 {
    p.db.set_node_loc(hir_id, p.file_id, sp.start, sp.end)
    hir_id
}

add_list :: fn(p &parse.Parser, v &Vec(u32)) u32 {
    slice: Slice(u32) = .{ ptr: v.ptr, len: v.len }
    p.db.add_list(slice)
}

check_separator :: fn(p &parse.Parser, end Token, msg &u8) {
    if parse.optional(p, Token.comma) {
        ret
    }
    next := parse.peek(p)
    if (next != end) and (next != Token.eof) and (not parse.peek_preceded_by_newline(p)) {
        parse.parse_error_at(p, msg, parse.curr_span(p))
    }
}

parse_method :: fn(p &parse.Parser, name u32, methods &Vec(u32)) {
    k := hir.hir_kind
    parse.bump(p)
    name_id := p.hir.lhs(name)
    method_sym := p.db.alloc_local_symbol(p.file_id, name_id, name)
    p.toplv_sym = method_sym
    func := parse_expr(p, prec().const_def)
    p.toplv_sym = id_none()
    if func == hir.hir_none() {
        parse.parse_error_at(p, c"expected a declaration after '::'", parse.curr_span(p))
    }
    if p.hir.kind(func) == k.function {
        if p.hir.extra(func) == hir.hir_none() {
            parse.parse_error_at(p, c"method requires a body", span_of_hir(p, func))
        }
    }
    p.db.set_sym_hir(method_sym, func)
    p.db.set_hir_symbol(name, method_sym)
    p.db.set_hir_symbol(func, method_sym)
    method := p.hir.push(k.binding, name, hir.hir_none(), func)
    set_span(p, method, nexus.span_merge(span_of_hir(p, name), span_of_hir(p, func)))
    p.db.set_hir_symbol(method, method_sym)
    methods.push(method)
    check_separator(p, Token.c_brace, c"expected ',' or newline after method")
}

add_methods_id :: fn(p &parse.Parser, methods &Vec(u32)) u32 {
    if methods.len == 0 {
        ret hir.hir_none()
    }
    add_list(p, methods)
}

bind_method_owners :: fn(p &parse.Parser, owner u32, methods &Vec(u32)) {
    i: u64 = 0
    while i < methods.len {
        method := methods.get(i)
        start := p.hir.lhs(method)
        while start <= method {
            p.db.set_method_owner(start, owner)
            start = start + 1
        }
        i = i + 1
    }
    methods.destroy()
}

ensure_type_node :: fn(p &parse.Parser, node &u32, kind hir.HirExprKind, toplv u32) {
    if *node == id_none() {
        *node = p.hir.push(kind, hir.hir_none(), hir.hir_none(), hir.hir_none())
        if toplv != id_none() {
            p.db.set_hir_symbol(*node, toplv)
        }
    }
}

finish_type_node :: fn(
    p &parse.Parser
    node &u32
    kind hir.HirExprKind
    lhs u32
    rhs u32
    extra u32
    toplv u32
    methods &Vec(u32)
    sp nexus.Span
) u32 {
    if *node == id_none() {
        *node = p.hir.push(kind, lhs, rhs, extra)
        if toplv != id_none() {
            p.db.set_hir_symbol(*node, toplv)
        }
    } else {
        p.hir.set_lhs(*node, lhs)
        p.hir.set_rhs(*node, rhs)
        p.hir.set_extra(*node, extra)
    }
    bind_method_owners(p, *node, methods)
    set_span(p, *node, sp)
}

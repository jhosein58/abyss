}

parse_unary :: fn(p &parse.Parser, op Token) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)

    body := parse_expr(p, prec().unary)
    sp_end := parse_common.span_of_hir(p, body)

    op_kind := k.empty
    if op == t.minus {
        op_kind = k.unary_neg
    }
    if op == t.kw_not {
        op_kind = k.unary_not
    }
    if op == t.tilde {
        op_kind = k.unary_bit_not
    }
    if op == t.amp {
        op_kind = k.unary_addr_of
    }
    if op == t.star {
        op_kind = k.unary_deref
    }
    node := p.hir.push(op_kind, body, hir.hir_none(), hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
}

parse_binary :: fn(p &parse.Parser, op Token, lhs u32, right_bp u8) u32 {
    t := Token
    k := hir.hir_kind

    sp_lhs := parse_common.span_of_hir(p, lhs)
    rhs := parse_expr(p, right_bp)
    sp_rhs := parse_common.span_of_hir(p, rhs)

    op_kind := k.empty
    if op == t.plus {
        op_kind = k.binary_add
    }
    if op == t.minus {
        op_kind = k.binary_sub
    }
    if op == t.star {
        op_kind = k.binary_mul
    }
    if op == t.slash {
        op_kind = k.binary_div
    }
    if op == t.percent {
        op_kind = k.binary_mod
    }
    if op == t.amp {
        op_kind = k.binary_bit_and
    }
    if op == t.pipe {
        op_kind = k.binary_bit_or
    }
    if op == t.caret {
        op_kind = k.binary_bit_xor
    }
    if op == t.left_shift {
        op_kind = k.binary_shl
    }
    if op == t.right_shift {
        op_kind = k.binary_shr
    }
    if op == t.eq_eq {
        op_kind = k.binary_eq_eq
    }
    if op == t.bang_eq {
        op_kind = k.binary_neq
    }
    if op == t.lt {
        op_kind = k.binary_lt
    }
    if op == t.lt_eq {
        op_kind = k.binary_lt_eq
    }
    if op == t.gt {
        op_kind = k.binary_gt
    }
    if op == t.gt_eq {
        op_kind = k.binary_gt_eq
    }
    if op == t.kw_and {
        op_kind = k.binary_and
    }
    if op == t.kw_or {
        op_kind = k.binary_or
    }
    if op == t.kw_as {
        op_kind = k.cast
    }
    if op_kind == k.empty {
        parse.parse_error_at(p, c"unsupported binary operator", parse.curr_span(p))
    }
    node := p.hir.push(op_kind, lhs, rhs, hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_lhs, sp_rhs))
}

parse_assign :: fn(p &parse.Parser, lhs u32, right_bp u8) u32 {
    k := hir.hir_kind
    sp_lhs := parse_common.span_of_hir(p, lhs)
    rhs := parse_expr(p, right_bp)
    sp_rhs := parse_common.span_of_hir(p, rhs)

    node := p.hir.push(k.binary_assign, lhs, rhs, hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_lhs, sp_rhs))
}

parse_builtin :: fn(p &parse.Parser) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)

    if parse.peek(p) != t.ident {
        parse.parse_error_at(p, c"expected identifier after '@'", parse.curr_span(p))
    }
    name_id := p.db.interner.intern(parse.curr_text(p))
    parse.bump(p)

    if not parse.expect(p, t.o_paren) {
        parse.parse_error_at(p, c"expected '(' after builtin name", parse.curr_span(p))
    }
    args := Vec(u32).new()
    if not parse.optional(p, t.c_paren) {
        while true {
            if parse.peek(p) == t.c_paren {
                break
            }
            if parse.is_eof(p) {
                parse.parse_error_at(p, c"unclosed builtin call, expected ')'", sp_start)
            }
            arg := parse_expr(p, 0 as u8)
            if arg == hir.hir_none() {
                parse.parse_error_at(p, c"expected argument in builtin call", parse.curr_span(p))
            }
            args.push(arg)

            if parse.peek(p) == t.c_paren {
                break
            }
            parse_common.check_separator(
                p
                t.c_paren
                c"expected ',' or newline after builtin argument"
            )
        }
        parse.expect(p, t.c_paren)
    }
    sp_end := parse.prev_span(p)
    args_list := parse_common.add_list(p, &args)
    args.destroy()

    node := p.hir.push(k.builtin_call, name_id, args_list, hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
}

parse_array_type :: fn(p &parse.Parser, min_bp u8) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)

    if parse.peek(p) == t.c_bracket {
        parse.bump(p)
        elem_ty := parse_expr(p, prec().var_def + (1 as u8))
        if elem_ty == hir.hir_none() {
            parse.parse_error_at(p, c"expected element type after '[]'", parse.curr_span(p))
        }
        sp_end := parse_common.span_of_hir(p, elem_ty)
        slice_name := p.db.interner.intern(Str.of("Slice"))
        slice_ident := p.hir.push(k.ident, slice_name, hir.hir_none(), 0)
        parse_common.set_span(p, slice_ident, sp_start)
        sym_id := parse.lookup_sym(p, slice_name)
        if sym_id != id_none() {
            p.db.set_hir_symbol(slice_ident, sym_id)
        }
        args := Vec(u32).new()
        args.push(elem_ty)
        list_id := parse_common.add_list(p, &args)
        args.destroy()

        node := p.hir.push(k.call, slice_ident, list_id, hir.hir_none())
        parse_common.set_span(p, node, span_merge(sp_start, sp_end))
        ret node
    }
    len_expr := parse_expr(p, 0 as u8)
    if not parse.expect(p, t.c_bracket) {
        parse.parse_error_at(p, c"expected ']' after array length", parse.curr_span(p))
    }
    elem_ty := parse_expr(p, prec().var_def + (1 as u8))
    if elem_ty == hir.hir_none() {
        parse.parse_error_at(p, c"expected element type after array length", parse.curr_span(p))
    }
    sp_end := parse_common.span_of_hir(p, elem_ty)
    node := p.hir.push(k.array, len_expr, elem_ty, hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
}

parse_array_lit :: fn(p &parse.Parser) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)
    parse.expect(p, t.o_bracket)

    elements := Vec(u32).new()

    while (parse.peek(p) != t.c_bracket) and (not parse.is_eof(p)) {
        elem := parse_expr(p, 0 as u8)
        elements.push(elem)

        parse_common.check_separator(
            p
            t.c_bracket
            c"expected ',' or newline between array elements"
        )
    }

    if parse.is_eof(p) and (parse.peek(p) != t.c_bracket) {
        parse.parse_error_at(p, c"unclosed array literal, expected ']'", sp_start)
    }
    parse.expect(p, t.c_bracket)
    sp_end := parse.prev_span(p)

    list_id := parse_common.add_list(p, &elements)
    elements.destroy()

    node := p.hir.push(k.array_init, list_id, hir.hir_none(), hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
}

parse_index :: fn(p &parse.Parser, lhs u32, right_bp u8) u32 {
    t := Token
    k := hir.hir_kind
    sp_lhs := parse_common.span_of_hir(p, lhs)
    idx := parse_expr(p, 0 as u8)
    if not parse.expect(p, t.c_bracket) {
        parse.parse_error_at(p, c"expected ']' after index expression", parse.curr_span(p))
    }
    sp_end := parse.prev_span(p)

    node := p.hir.push(k.index, lhs, idx, hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_lhs, sp_end))
}

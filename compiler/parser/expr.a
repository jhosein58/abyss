parse_u32 :: @import("std/string").parse_u32

hir :: @import("compiler/hir")
span_merge :: @import("compiler/nexus/nexus").span_merge
id_none :: @import("compiler/nexus/pool").id_none
parse :: @import("compiler/parser/core")
parse_expr :: @import("compiler/parser/parser").parse_expr
prec :: @import("compiler/parser/prec").prec
Token :: @import("compiler/token").Token
parse_common :: @import("./common")

parse_ident :: fn(p &parse.Parser) u32 {
    k := hir.hir_kind
    t := Token

    if parse.peek(p) != t.ident {
        parse.parse_error_at(p, c"expected identifier", parse.curr_span(p))
    }
    sp := parse.curr_span(p)
    name := parse.curr_text(p)
    name_id := p.db.interner.intern(name)
    parse.bump(p)

    ident_hir := p.hir.push(k.ident, name_id, hir.hir_none(), 0)
    parse_common.set_span(p, ident_hir, sp)

    sym_id := parse.lookup_sym(p, name_id)
    if sym_id != id_none() {
        p.db.set_hir_symbol(ident_hir, sym_id)
    }
    ident_hir
}

parse_lit_int :: fn(p &parse.Parser) u32 {
    k := hir.hir_kind
    sp := parse.curr_span(p)
    val := parse_u32(parse.curr_text(p)).unwrap_or(0)
    parse.bump(p)
    node := p.hir.push(k.lit_int, val, hir.hir_none(), hir.hir_none())
    parse_common.set_span(p, node, sp)
}

parse_float :: fn(p &parse.Parser) u32 {
    k := hir.hir_kind
    sp := parse.curr_span(p)
    raw := parse.curr_text(p)
    has_underscore := false
    i: u64 = 0
    while i < raw.len {
        if *(raw.ptr + i) == '_' {
            has_underscore = true
        }
        i = i + 1
    }
    clean := raw
    if has_underscore {
        buf := p.db.comptime_arena.alloc(raw.len) as &u8
        c_len: u64 = 0
        j: u64 = 0
        while j < raw.len {
            ch := *(raw.ptr + j)
            if ch != '_' {
                *(buf + c_len) = ch
                c_len = c_len + 1
            }
            j = j + 1
        }
        clean = Str.new(buf, c_len)
    }
    name_id := p.db.interner.intern(clean)
    parse.bump(p)
    node := p.hir.push(k.lit_float, name_id, hir.hir_none(), hir.hir_none())
    parse_common.set_span(p, node, sp)
}

parse_str :: fn(p &parse.Parser) u32 {
    k := hir.hir_kind
    sp := parse.curr_span(p)
    raw := parse.curr_text(p)
    parse.bump(p)
    name_id := p.db.interner.intern(raw)
    node := p.hir.push(k.lit_str, name_id, hir.hir_none(), hir.hir_none())
    parse_common.set_span(p, node, sp)
}


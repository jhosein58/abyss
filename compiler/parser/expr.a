parse_false :: fn(p &parse.Parser) u32 {
    k := hir.hir_kind
    sp := parse.curr_span(p)
    parse.bump(p)
    node := p.hir.push(k.lit_bool_false, hir.hir_none(), hir.hir_none(), hir.hir_none())

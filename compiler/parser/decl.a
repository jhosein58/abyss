Ascii :: @import("std/ascii").Ascii
parse_u32 :: @import("std/string").parse_u32

hir :: @import("compiler/hir")
span_merge :: @import("compiler/nexus/nexus").span_merge
id_none :: @import("compiler/nexus/pool").id_none
parse :: @import("compiler/parser/core")
parse_expr :: @import("compiler/parser/parser").parse_expr
prec :: @import("compiler/parser/prec").prec
Token :: @import("compiler/token").Token
parse_builtin_type :: @import("compiler/typer/common").parse_builtin_type
is_core_source :: @import("compiler/typer/decl").is_core_source
ty_id_none :: @import("compiler/types").ty_id_none
parse_common :: @import("./common")
parse_ident :: @import("./expr").parse_ident
parse_block :: @import("./stmt").parse_block

parse_binding :: fn(p &parse.Parser, lhs u32, right_bp u8) u32 {
    k := hir.hir_kind
    sp_lhs := parse_common.span_of_hir(p, lhs)

    if p.hir.kind(lhs) != k.ident {
        parse.parse_error_at(p, c"left-hand side of declaration must be an identifier", sp_lhs)
    }
    name := p.hir.lhs(lhs)
    sym_id := p.toplv_sym
    tok := p.db.sym_tok_start(sym_id)
    if tok != id_none() and p.file_scope and p.tokens.start(tok) == sp_lhs.start {
        p.db.set_sym_hir(sym_id, lhs)
        p.db.set_hir_symbol(lhs, sym_id)
    } else {
        sym_id = p.db.alloc_local_symbol(p.file_id, name, lhs)
        p.env.define(name, sym_id)
    }
    saved_toplv := p.toplv_sym
    p.toplv_sym = sym_id
    if tok != id_none() and parse.peek_preceded_by_newline(p) and parse.begins_declaration(p) {
        parse.parse_error_at(p, c"expected a declaration after '::'", parse.prev_span(p))
    }
    rhs := parse_expr(p, right_bp)
    p.toplv_sym = saved_toplv
    if rhs == hir.hir_none() {
        parse.parse_error_at(p, c"expected a declaration after '::'", parse.curr_span(p))
    }
    sp_rhs := parse_common.span_of_hir(p, rhs)

    binding_id := p.hir.push(k.binding, lhs, hir.hir_none(), rhs)
    parse_common.set_span(p, binding_id, span_merge(sp_lhs, sp_rhs))

    if sym_id != id_none() {
        p.db.set_hir_symbol(binding_id, sym_id)
    }
    binding_id
}

parse_var_decl :: fn(p &parse.Parser, lhs u32, right_bp u8) u32 {
    t := Token
    k := hir.hir_kind

    if p.hir.kind(lhs) != k.ident {
        parse.parse_error_at(
            p
            c"left-hand side of declaration must be an identifier"
            parse_common.span_of_hir(p, lhs)
        )
    }
    sp_lhs := parse_common.span_of_hir(p, lhs)

    name_id := p.hir.lhs(lhs)
    sym_id := p.toplv_sym
    tok_start := p.db.sym_tok_start(sym_id)
    if p.file_scope and tok_start != id_none() and sp_lhs.start == p.tokens.start(tok_start) {
        p.db.set_sym_hir(sym_id, lhs)
        p.db.set_hir_symbol(lhs, sym_id)
    } else {
        sym_id = p.db.alloc_local_symbol(p.file_id, name_id, lhs)
        p.env.define(name_id, sym_id)
    }

    saved_toplv := p.toplv_sym
    p.toplv_sym = id_none()
    ty := hir.hir_none()
    val := hir.hir_none()
    kind := k.var
    has_init := false
    sp_end := sp_lhs
    if parse.optional(p, t.eq) {
        has_init = true
        if tok_start != id_none() and parse.peek_preceded_by_newline(p) and
            parse.begins_declaration(p) {
            parse.parse_error_at(
                p
                c"expected an initializer after declaration operator"
                parse.prev_span(p)
            )
        }
        val = parse_expr(p, 0)
    } else {
        ty = parse_expr(p, prec().var_def + (1 as u8))
        if ty == hir.hir_none() {
            parse.parse_error_at(p, c"expected a type after ':'", parse.curr_span(p))
        }
        sp_end = parse_common.span_of_hir(p, ty)
        if parse.optional(p, t.eq) {
            has_init = true
            val = parse_expr(p, 0)
        } else if parse.optional(p, t.colon) {
            kind = k.binding
            has_init = true
            val = parse_expr(p, 0)
        }
    }
    if val != hir.hir_none() {
        sp_end = parse_common.span_of_hir(p, val)
    } else if has_init {
        parse.parse_error_at(
            p
            c"expected an initializer after declaration operator"
            parse.curr_span(p)
        )
    }
    p.toplv_sym = saved_toplv
    node := p.hir.push(kind, lhs, ty, val)
    parse_common.set_span(p, node, span_merge(sp_lhs, sp_end))
    p.db.set_hir_symbol(node, sym_id)
    node
}

parse_destructure :: fn(p &parse.Parser) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)

    idents := Vec(u32).new()

    first := parse_ident(p)
    idents.push(first)

    while parse.optional(p, t.comma) {
        idents.push(parse_ident(p))
    }

    parse.expect(p, t.colon)
    parse.expect(p, t.eq)

    rhs := parse_expr(p, 0 as u8)
    sp_end := parse_common.span_of_hir(p, rhs)

    i: u64 = 0
    while i < idents.len {
        id_node := idents.get(i)
        name_id := p.hir.lhs(id_node)
        sym_id := p.db.alloc_local_symbol(p.file_id, name_id, id_node)
        p.env.define(name_id, sym_id)
        p.db.set_hir_symbol(id_node, sym_id)
        i = i + 1
    }

    list_id := parse_common.add_list(p, &idents)
    idents.destroy()

    node := p.hir.push(k.destructure, list_id, hir.hir_none(), rhs)
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
    node
}

define_param :: fn(p &parse.Parser, name_hir u32) u32 {
    k := hir.hir_kind
    if p.hir.kind(name_hir) != k.ident {
        parse.parse_error_at(
            p
            c"parameter name must be an identifier"
            parse_common.span_of_hir(p, name_hir)
        )
    }
    name_id := p.hir.lhs(name_hir)
    sym_id := p.db.alloc_local_symbol(p.file_id, name_id, name_hir)
    p.env.define(name_id, sym_id)
    p.db.set_hir_symbol(name_hir, sym_id)
    sym_id
}

push_arg :: fn(p &parse.Parser, args &Vec(u32), name u32, ty u32) {
    k := hir.hir_kind
    sp := parse_common.span_of_hir(p, ty)
    sym_id := id_none()
    if name != hir.hir_none() {
        sym_id = define_param(p, name)
        sp = span_merge(parse_common.span_of_hir(p, name), sp)
    }
    arg_id := p.hir.push(k.arg, name, ty, hir.hir_none())
    parse_common.set_span(p, arg_id, sp)
    if sym_id != id_none() {
        p.db.set_hir_symbol(arg_id, sym_id)
    }
    args.push(arg_id)
}

flush_anonymous_params :: fn(p &parse.Parser, args, pending &Vec(u32)) {
    for param in pending.as_slice() {
        push_arg(p, args, hir.hir_none(), param)
    }
    pending.clear()
}

reject_ellipsis :: fn(p &parse.Parser) {
    if parse.peek(p) == Token.dot and parse.peek_n(p, 1) == Token.dot and
        parse.peek_n(p, 2) == Token.dot {
        parse.parse_error_at(
            p
            c"variadic parameters are not supported; use tuples for type-safe formatting"
            parse.curr_span(p)
        )
    }
}

parse_params :: fn(p &parse.Parser) u32 {
    t := Token
    k := hir.hir_kind
    args := Vec(u32).new()
    pending_names := Vec(u32).new()

    while (parse.peek(p) != t.c_paren) and (not parse.is_eof(p)) {
        reject_ellipsis(p)
        if pending_names.len > 0 and parse.peek_preceded_by_newline(p) {
            flush_anonymous_params(p, &args, &pending_names)
        }
        if parse.optional(p, t.kw_cmpt) {
            if pending_names.len > 0 {
                parse.parse_error_at(
                    p
                    c"compile-time parameters cannot share a type with preceding parameters"
                    parse.curr_span(p)
                )
            }
            name := parse_ident(p)
            ty := parse_expr(p, prec().var_def + (1 as u8))
            push_arg(p, &args, name, ty)
            p.hir.set_extra(args.get(args.len - 1), 1)
            parse_common.check_separator(
                p
                t.c_paren
                c"expected ',' or newline after compile-time parameter"
            )
            cont
        }
        is_type_token := (parse.peek(p) == t.amp) or (parse.peek(p) == t.star) or
            (parse.peek(p) == t.o_bracket) or
            (parse.peek(p) == t.at) or
            (parse.peek(p) == t.kw_fn) or
            (parse.peek(p) == t.kw_struct) or
            (parse.peek(p) == t.kw_enum)

        if is_type_token or
            (
                parse.peek(p) == t.ident and parse.peek_n(p, 1) == t.dot and
                    parse.peek_n(p, 2) == t.ident
            ) {
            flush_anonymous_params(p, &args, &pending_names)
            ty := parse_expr(p, prec().var_def + (1 as u8))
            push_arg(p, &args, hir.hir_none(), ty)
            parse_common.check_separator(p, t.c_paren, c"expected ',' or newline after parameter")
            cont
        }
        if parse.peek(p) != t.ident {
            parse.parse_error_at(p, c"expected parameter name or type", parse.curr_span(p))
        }
        name := parse_ident(p)
        pending_names.push(name)
        reject_ellipsis(p)

        next_tk := parse.peek(p)
        has_explicit_type := (next_tk == t.ident) or (next_tk == t.amp) or (next_tk == t.star) or
            (next_tk == t.o_bracket) or
            (next_tk == t.at) or
            (next_tk == t.kw_fn) or
            (next_tk == t.kw_struct) or
            (next_tk == t.kw_enum)
        if has_explicit_type and not parse.peek_preceded_by_newline(p) {
            ty := parse_expr(p, prec().var_def + (1 as u8))
            for param in pending_names.as_slice() {
                push_arg(p, &args, param, ty)
            }
            pending_names.clear()
            parse_common.check_separator(p, t.c_paren, c"expected ',' or newline after parameter")
            cont
        }

        name_text := p.db.interner.get(p.hir.lhs(name))
        if parse_builtin_type(&p.db.types, name_text) != ty_id_none() {
            flush_anonymous_params(p, &args, &pending_names)
        }
        if parse.optional(p, t.comma) {
            cont
        }
        if parse.peek(p) == t.c_paren {
            break
        }
        if parse.peek_preceded_by_newline(p) {
            cont
        }
        parse.parse_error_at(p, c"expected parameter type or ','", parse.curr_span(p))
    }

    parse.expect(p, t.c_paren)

    flush_anonymous_params(p, &args, &pending_names)
    pending_names.destroy()

    params := hir.hir_none()
    if args.len > 0 {
        params = parse_common.add_list(p, &args)
    }
    args.destroy()
    params
}

parse_fn :: fn(p &parse.Parser, min_bp u8) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)
    parse.expect(p, t.o_paren)

    saved_toplv := p.toplv_sym
    p.toplv_sym = id_none()

    env_mark := p.env.mark()
    params := parse_params(p)

    ret_ty := hir.hir_none()
    sp_end := parse.prev_span(p)

    next := parse.peek(p)
    has_ret := (not parse.is_eof(p)) and (not parse.peek_preceded_by_newline(p)) and
        (next != t.o_brace) and
        (next != t.eq) and
        (next != t.comma) and
        (next != t.c_paren) and
        (next != t.c_brace) and
        (next != t.semi)

    if has_ret {
        ret_ty = parse_expr(p, prec().var_def + (1 as u8))
        sp_end = parse_common.span_of_hir(p, ret_ty)
    }
    p.toplv_sym = saved_toplv
    is_toplv_fn := p.toplv_sym != id_none()

    fn_sym := id_none()
    if is_toplv_fn {
        fn_sym = p.toplv_sym
        p.toplv_sym = id_none()
    }
    fn_node := p.hir.push(k.function, params, ret_ty, hir.hir_none())
    if is_toplv_fn {
        p.db.set_hir_symbol(fn_node, fn_sym)
    }
    body := hir.hir_none()
    can_have_body := min_bp <= prec().var_def
    if can_have_body and (parse.peek(p) == t.o_brace) {
        body = parse_block(p)
        sp_end = parse_common.span_of_hir(p, body)
        p.hir.set_rhs(body, fn_node)
        if not is_toplv_fn {
            fn_sym = p.db.alloc_local_symbol(p.file_id, 0, fn_node)
            p.db.set_hir_symbol(fn_node, fn_sym)
        }
    }
    p.env.reset(env_mark)

    p.hir.set_extra(fn_node, body)
    parse_common.set_span(p, fn_node, span_merge(sp_start, sp_end))
}

extern_identifier :: fn(p &parse.Parser) u32 {
    raw := parse.curr_text(p)
    name := raw.sub(1, raw.len - 2)
    if name.len == 0 or not Ascii.is_alpha(*name.ptr) {
        parse.parse_error_at(
            p
            c"expected a C identifier for the external symbol"
            parse.curr_span(p)
        )
    }
    for index in Range.new(1, name.len as i32) {
        if not Ascii.is_alphanumeric(*(name.ptr + index)) {
            parse.parse_error_at(
                p
                c"expected a C identifier for the external symbol"
                parse.curr_span(p)
            )
        }
    }
    parse.bump(p)
    p.db.interner.intern(name)
}

parse_extern :: fn(p &parse.Parser, min_bp u8) u32 {
    t := Token
    start := parse.curr_span(p)
    if is_core_source(p.db.get_file_path(p.file_id)) {
        parse.parse_error_at(p, c"core modules cannot declare extern", start)
    }
    parse.bump(p)
    custom_sym := id_none()
    import_module := id_none()
    if parse.peek(p) == t.lit_str {
        custom_sym = extern_identifier(p)
        if parse.peek(p) == t.lit_str {
            import_module = custom_sym
            custom_sym = extern_identifier(p)
        }
        if parse.peek(p) != t.kw_fn {
            parse.parse_error_at(p, c"expected 'fn' after custom extern symbol", parse.curr_span(p))
        }
    }
    if parse.peek(p) == t.kw_fn {
        if p.toplv_sym == id_none() or p.db.sym_tok_start(p.toplv_sym) == id_none() {
            parse.parse_error_at(p, c"external functions require a top-level binding", start)
        }
        fn_node := parse_fn(p, min_bp)
        if import_module != id_none() {
            if p.hir.extra(fn_node) != hir.hir_none() {
                parse.parse_error_at(p, c"WebAssembly imports cannot have a function body", start)
            }
            p.db.extern_modules.insert(fn_node, import_module)
        }
        p.db.set_extern_fn(fn_node, custom_sym)
        ret fn_node
    }
    if parse.peek(p) == t.kw_struct {
        struct_node := parse_struct(p)
        p.db.set_extern_struct(struct_node)
        ret struct_node
    }
    parse.parse_error_at(p, c"expected 'fn' or 'struct' after 'extern'", parse.curr_span(p))
    hir.hir_none()
}

parse_paren :: fn(p &parse.Parser) u32 {
    t := Token
    sp_start := parse.curr_span(p)
    parse.bump(p)
    expr := parse_expr(p, 0 as u8)
    parse.expect(p, t.c_paren)
    sp_end := parse.prev_span(p)
    parse_common.set_span(p, expr, span_merge(sp_start, sp_end))
}

parse_call :: fn(p &parse.Parser, lhs u32, right_bp u8) u32 {
    t := Token
    k := hir.hir_kind
    sp_lhs := parse_common.span_of_hir(p, lhs)

    args := Vec(u32).new()
    if not parse.optional(p, t.c_paren) {
        while true {
            if parse.peek(p) == t.c_paren {
                break
            }
            if parse.is_eof(p) {
                parse.parse_error_at(p, c"unclosed call, expected ')'", sp_lhs)
            }
            arg := parse_expr(p, 0 as u8)
            if arg == hir.hir_none() {
                parse.parse_error_at(p, c"expected call argument", parse.curr_span(p))
            }
            args.push(arg)

            if parse.peek(p) == t.c_paren {
                break
            }
            parse_common.check_separator(
                p
                t.c_paren
                c"expected ',' or newline after call argument"
            )
        }
        parse.expect(p, t.c_paren)
    }
    sp_end := parse.prev_span(p)
    args_list := parse_common.add_list(p, &args)
    args.destroy()

    node := p.hir.push(k.call, lhs, args_list, hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_lhs, sp_end))
}

is_tuple_struct :: fn(p &parse.Parser) bool {
    t := Token
    scan := p.cursor
    if (scan >= p.end) or (p.tokens.kind(scan) == t.c_brace) {
        ret false
    }
    if p.tokens.kind(scan) != t.ident {
        ret true
    }
    while scan + 1 < p.end {
        scan = scan + 1
        next := p.tokens.kind(scan)
        if (next == t.colon_colon) or (next == t.colon) {
            ret false
        }
        if (next == t.c_brace) or (next == t.semi) or p.tokens.newline_before(scan) {
            ret true
        }
        if next != t.comma {
            ret false
        }
        scan = scan + 1
        if scan >= p.end {
            ret false
        }
        if p.tokens.kind(scan) != t.ident {
            ret true
        }
    }
    false
}

parse_struct :: fn(p &parse.Parser) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)
    if not parse.expect(p, t.o_brace) {
        parse.parse_error_at(p, c"expected '{' after struct", parse.curr_span(p))
    }
    env_mark := p.env.mark()

    names := Vec(u32).new()
    types := Vec(u32).new()
    methods := Vec(u32).new()
    field_names := Vec(u32).new()

    struct_node := id_none()
    struct_toplv := p.toplv_sym
    p.toplv_sym = id_none()

    if is_tuple_struct(p) {
        idx: u32 = 0
        while (parse.peek(p) != t.c_brace) and (not parse.is_eof(p)) {
            sp_ty := parse.curr_span(p)
            ty := parse_expr(p, prec().var_def + (1 as u8))
            if ty == hir.hir_none() {
                parse.parse_error_at(p, c"expected a tuple field type", sp_ty)
            }
            f_name_id := p.db.tuple_field_name(idx)
            f_ident := p.hir.push(k.ident, f_name_id, hir.hir_none(), hir.hir_none())
            parse_common.set_span(p, f_ident, sp_ty)

            names.push(f_ident)
            types.push(ty)
            idx = idx + 1

            parse_common.check_separator(
                p
                t.c_brace
                c"expected ',' or newline between tuple fields"
            )
        }
    } else {
        while (parse.peek(p) != t.c_brace) and (not parse.is_eof(p)) {
            if parse.peek(p) == t.hash {
                parse_common.ensure_type_node(p, &struct_node, k.struct_, struct_toplv)
                sp_start := parse.curr_span(p)
                parse.bump(p)
                has_paren := false
                if parse.peek(p) == t.o_paren {
                    has_paren = true
                    parse.bump(p)
                }
                expr := parse_expr(
                    p
                    if has_paren {
                        0 as u8
                    } else {
                        prec().assignment + (1 as u8)
                    }
                )
                if has_paren {
                    if not parse.expect(p, t.c_paren) {
                        parse.parse_error_at(
                            p
                            c"expected ')' after macro expression"
                            parse.curr_span(p)
                        )
                    }
                }
                splice_node := p.hir.push(k.splice, expr, struct_node, hir.hir_none())
                parse.capture_splice_scope(p, splice_node)
                parse_common.set_span(p, splice_node, span_merge(sp_start, parse.prev_span(p)))
                if struct_toplv != id_none() {
                    p.db.set_hir_symbol(splice_node, struct_toplv)
                    p.db.set_method_owner(splice_node, struct_toplv)
                }
                methods.push(splice_node)
                parse_common.check_separator(
                    p
                    t.c_brace
                    c"expected ',' or newline after '#' in struct"
                )
                cont
            }
            name := parse_ident(p)
            if parse.peek(p) == t.colon_colon {
                parse_common.ensure_type_node(p, &struct_node, k.struct_, struct_toplv)
                parse_common.parse_method(p, name, &methods)
                cont
            }
            field_names.push(name)
            while parse.optional(p, t.comma) {
                field_names.push(parse_ident(p))
            }

            if parse.peek(p) == t.colon {
                parse.parse_error_at(
                    p
                    c"struct fields use 'name Type' without ':'"
                    parse.curr_span(p)
                )
            }
            ty := parse_expr(p, prec().var_def + (1 as u8))
            if ty == hir.hir_none() {
                parse.parse_error_at(p, c"expected a field type", parse.curr_span(p))
            }
            f_i: u64 = 0
            while f_i < field_names.len {
                names.push(field_names.get(f_i))
                types.push(ty)
                f_i = f_i + 1
            }
            field_names.clear()

            parse_common.check_separator(
                p
                t.c_brace
                c"expected ',' or newline between struct fields"
            )
        }
    }

    if parse.is_eof(p) and (parse.peek(p) != t.c_brace) {
        parse.parse_error_at(p, c"unclosed struct definition, expected '}'", sp_start)
    }
    parse.expect(p, t.c_brace)
    sp_end := parse.prev_span(p)

    names_id := parse_common.add_list(p, &names)
    types_id := parse_common.add_list(p, &types)
    names.destroy()
    types.destroy()
    field_names.destroy()

    p.env.reset(env_mark)

    methods_id := parse_common.add_methods_id(p, &methods)
    parse_common.finish_type_node(
        p
        &struct_node
        k.struct_
        names_id
        types_id
        methods_id
        struct_toplv
        &methods
        span_merge(sp_start, sp_end)
    )
}

parse_struct_init :: fn(p &parse.Parser) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)
    parse.expect(p, t.o_brace)

    fields := Vec(u32).new()
    values := Vec(u32).new()

    tup_idx: u32 = 0
    while (parse.peek(p) != t.c_brace) and (not parse.is_eof(p)) {
        is_named := (parse.peek(p) == t.ident) and (parse.peek_n(p, 1) == t.colon)
        if is_named {
            f := parse_ident(p)
            parse.expect(p, t.colon)
            v := parse_expr(p, prec().var_def + (1 as u8))
            fields.push(f)
            values.push(v)
        } else {
            sp_v := parse.curr_span(p)
            v := parse_expr(p, prec().var_def + (1 as u8))
            f_name_id := p.db.tuple_field_name(tup_idx)
            f := p.hir.push(k.ident, f_name_id, hir.hir_none(), hir.hir_none())
            parse_common.set_span(p, f, sp_v)
            fields.push(f)
            values.push(v)
            tup_idx = tup_idx + 1
        }

        parse_common.check_separator(p, t.c_brace, c"expected ',' or newline between struct values")
    }

    if parse.is_eof(p) and (parse.peek(p) != t.c_brace) {
        parse.parse_error_at(p, c"unclosed struct literal, expected '}'", sp_start)
    }
    parse.expect(p, t.c_brace)
    sp_end := parse.prev_span(p)

    fids := parse_common.add_list(p, &fields)
    vids := parse_common.add_list(p, &values)

    fields.destroy()
    values.destroy()

    node := p.hir.push(k.struct_init, fids, vids, hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_start, sp_end))
}

parse_member :: fn(p &parse.Parser, lhs u32, right_bp u8) u32 {
    k := hir.hir_kind
    sp_lhs := parse_common.span_of_hir(p, lhs)
    rhs := parse_expr(p, right_bp)
    if rhs == hir.hir_none() {
        parse.parse_error_at(p, c"expected a member name after '.'", parse.curr_span(p))
    }
    sp_rhs := parse_common.span_of_hir(p, rhs)

    if p.hir.kind(rhs) == k.lit_int {
        idx := p.hir.lhs(rhs)
        f_name_id := p.db.tuple_field_name(idx)
        rhs = p.hir.push(k.ident, f_name_id, hir.hir_none(), hir.hir_none())
        parse_common.set_span(p, rhs, sp_rhs)
    } else if p.hir.kind(rhs) == k.lit_float {
        name_id := p.hir.lhs(rhs)
        text := p.db.interner.get(name_id)
        dot_pos: u64 = 0
        while (dot_pos < text.len) and (*(text.ptr + dot_pos) != (46 as u8)) {
            dot_pos = dot_pos + 1
        }
        part1 := text.sub(0, dot_pos)
        part2 := text.sub(dot_pos + 1, text.len - dot_pos - 1)
        idx1 := parse_u32(part1).unwrap_or(0)
        idx2 := parse_u32(part2).unwrap_or(0)
        f1_id := p.db.tuple_field_name(idx1)
        f1 := p.hir.push(k.ident, f1_id, hir.hir_none(), hir.hir_none())
        parse_common.set_span(p, f1, sp_rhs)
        inner := p.hir.push(k.member, lhs, f1, hir.hir_none())
        parse_common.set_span(p, inner, sp_rhs)
        f2_id := p.db.tuple_field_name(idx2)
        f2 := p.hir.push(k.ident, f2_id, hir.hir_none(), hir.hir_none())
        parse_common.set_span(p, f2, sp_rhs)
        node := p.hir.push(k.member, inner, f2, hir.hir_none())
        parse_common.set_span(p, node, span_merge(sp_lhs, sp_rhs))
        ret node
    } else if p.hir.kind(rhs) != k.ident {
        parse.parse_error_at(p, c"member name must be an identifier", sp_rhs)
    } else {
        p.hir.set_extra(rhs, hir.hir_none())
        p.db.set_hir_symbol(rhs, id_none())
    }
    node := p.hir.push(k.member, lhs, rhs, hir.hir_none())
    parse_common.set_span(p, node, span_merge(sp_lhs, sp_rhs))
}

parse_enum :: fn(p &parse.Parser) u32 {
    t := Token
    k := hir.hir_kind
    sp_start := parse.curr_span(p)
    parse.bump(p)

    backing_ty := hir.hir_none()
    if parse.peek(p) != t.o_brace {
        backing_ty = parse_expr(p, prec().var_def + (1 as u8))
    }
    if not parse.expect(p, t.o_brace) {
        parse.parse_error_at(p, c"expected '{' after enum", parse.curr_span(p))
    }
    env_mark := p.env.mark()

    names := Vec(u32).new()
    vals := Vec(u32).new()
    methods := Vec(u32).new()

    enum_node := id_none()
    enum_toplv := p.toplv_sym
    p.toplv_sym = id_none()

    while (parse.peek(p) != t.c_brace) and (not parse.is_eof(p)) {
        if parse.peek(p) == t.hash {
            parse_common.ensure_type_node(p, &enum_node, k.enum_, enum_toplv)
            sp_start := parse.curr_span(p)
            parse.bump(p)
            has_paren := false
            if parse.peek(p) == t.o_paren {
                has_paren = true
                parse.bump(p)
            }
            expr := parse_expr(
                p
                if has_paren {
                    0 as u8
                } else {
                    prec().assignment + (1 as u8)
                }
            )
            if has_paren {
                if not parse.expect(p, t.c_paren) {
                    parse.parse_error_at(
                        p
                        c"expected ')' after macro expression"
                        parse.curr_span(p)
                    )
                }
            }
            splice_node := p.hir.push(k.splice, expr, enum_node, hir.hir_none())
            parse.capture_splice_scope(p, splice_node)
            parse_common.set_span(p, splice_node, span_merge(sp_start, parse.prev_span(p)))
            if enum_toplv != id_none() {
                p.db.set_hir_symbol(splice_node, enum_toplv)
                p.db.set_method_owner(splice_node, enum_toplv)
            }
            methods.push(splice_node)
            parse_common.check_separator(p, t.c_brace, c"expected ',' or newline after '#' in enum")
            cont
        }
        name := parse_ident(p)
        if parse.peek(p) == t.colon_colon {
            parse_common.ensure_type_node(p, &enum_node, k.enum_, enum_toplv)
            parse_common.parse_method(p, name, &methods)
            cont
        }
        val_expr := hir.hir_none()
        if parse.optional(p, t.eq) {
            val_expr = parse_expr(p, prec().assignment + (1 as u8))
        }
        names.push(name)
        vals.push(val_expr)

        parse_common.check_separator(p, t.c_brace, c"expected ',' or newline between enum variants")
    }

    if parse.is_eof(p) and (parse.peek(p) != t.c_brace) {
        parse.parse_error_at(p, c"unclosed enum definition, expected '}'", sp_start)
    }
    parse.expect(p, t.c_brace)
    sp_end := parse.prev_span(p)

    names_id := parse_common.add_list(p, &names)
    vals_id := parse_common.add_list(p, &vals)
    names.destroy()
    vals.destroy()

    methods_id := parse_common.add_methods_id(p, &methods)
    meta := Vec(u32).new()
    meta.push(backing_ty)
    meta.push(methods_id)
    meta_id := parse_common.add_list(p, &meta)
    meta.destroy()

    p.env.reset(env_mark)
    parse_common.finish_type_node(
        p
        &enum_node
        k.enum_
        names_id
        vals_id
        meta_id
        enum_toplv
        &methods
        span_merge(sp_start, sp_end)
    )
}

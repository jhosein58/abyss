import Str from "std/string"
import token, TokenType, TokenStream from "./token"
import calc_pos from "./nexus/nexus"
import fall from "std/sys"
import is_digit, is_hex_digit, is_alpha, is_alphanumeric, is_whitespace, is_newline from "std/ascii"

match_keyword :: fn(text Str) TokenType {
    t := token

    if text.len == 2 {
        if text.eq(Str.of("if")) { ret t.kw_if }
        if text.eq(Str.of("as")) { ret t.kw_as }
        if text.eq(Str.of("or")) { ret t.kw_or }
        if text.eq(Str.of("fn")) { ret t.kw_fn }
        if text.eq(Str.of("in")) { ret t.kw_in }
    }

    if text.len == 3 {
        if text.eq(Str.of("ret")) { ret t.kw_ret }
        if text.eq(Str.of("and")) { ret t.kw_and }
        if text.eq(Str.of("not")) { ret t.kw_not }
        if text.eq(Str.of("for")) { ret t.kw_for }
    }

    if text.len == 4 {
        if text.eq(Str.of("else")) { ret t.kw_else }
        if text.eq(Str.of("cont")) { ret t.kw_cont }
        if text.eq(Str.of("true")) { ret t.kw_true }
        if text.eq(Str.of("from")) { ret t.kw_from }
        if text.eq(Str.of("enum")) { ret t.kw_enum }
        if text.eq(Str.of("cmpt")) { ret t.kw_cmpt }
    }

    if text.len == 5 {
        if text.eq(Str.of("while")) { ret t.kw_while }
        if text.eq(Str.of("break")) { ret t.kw_break }
        if text.eq(Str.of("false")) { ret t.kw_false }
        if text.eq(Str.of("match")) { ret t.kw_match }
    }

    if text.len == 6 {
        if text.eq(Str.of("struct")) { ret t.kw_struct }
        if text.eq(Str.of("import")) { ret t.kw_import }
    }

    t.ident
}

Lexer :: struct {
    source Str
    path Str
    cursor u64
    had_newline bool

    new :: fn(source Str, path Str) Self {
        .{
            source: source,
            path: path,
            cursor: 0,
            had_newline: true
        }
    }

    is_eof :: fn(self &Self) bool {
        self.cursor >= self.source.len
    }

    current :: fn(self &Self) u8 {
        if self.is_eof() { ret 0 as u8 }
        *(self.source.ptr + self.cursor)
    }

    peek :: fn(self &Self) u8 {
        if self.cursor + 1 >= self.source.len { ret 0 as u8 }
        *(self.source.ptr + self.cursor + 1)
    }

    bump :: fn(self &Self) {
        if not self.is_eof() {
            self.cursor = self.cursor + 1
        }
    }

    consume_char :: fn(self &Self, expected u8) bool {
        if (self.current() == expected) and (not self.is_eof()) {
            self.bump()
            ret true
        }
        false
    }

    error :: fn(self &Self, msg &u8, offset u64) {
        pos := calc_pos(self.source, offset as u32)
        printf("\n[lex error] {}\n       --> {}:{}:{}\n", .{msg, self.path, pos.line, pos.col})
        fall()
    }

    emit :: fn(self &Self, stream &TokenStream, kind TokenType, offset u64) {
        len := (self.cursor - offset) as u32
        text := Str.new(self.source.ptr + offset, len as u64)
        stream.push(kind, offset as u32, len, text, self.had_newline)
        self.had_newline = false
    }

    valid_escape :: fn(self &Self) bool {
        c := self.current()
        if c == 'x' { ret is_hex_digit(self.peek()) }
        if (c >= '0') and (c <= '7') { ret true }
        (c == 'a') or (c == 'b') or (c == 'f') or (c == 'n') or (c == 'r') or
        (c == 't') or (c == 'v') or (c == '\\') or (c == '\'') or (c == '"') or (c == '?')
    }

    scan_number :: fn(self &Self, stream &TokenStream) {
        offset := self.cursor
        is_float := false

        if self.current() == '0' {
            p := self.peek()
            if (p == 'x') or (p == 'X') {
                self.bump()
                self.bump()
                while (not self.is_eof()) and (is_hex_digit(self.current()) or (self.current() == '_')) {
                    self.bump()
                }
                self.emit(stream, token.lit_int, offset)
                ret
            }
        }

        while (not self.is_eof()) and (is_digit(self.current()) or (self.current() == '_')) {
            self.bump()
        }

        if (self.current() == '.') and (self.peek() != '.') and is_digit(self.peek()) {
            is_float = true
            self.bump()
            while (not self.is_eof()) and (is_digit(self.current()) or (self.current() == '_')) {
                self.bump()
            }
        }

        if is_float {
            check := offset
            while check < self.cursor {
                if *(self.source.ptr + check) == '_' {
                    self.error(c"separators in float literals are unsupported", offset)
                }
                check = check + 1
            }
        }

        kind := token.lit_int
        if is_float { kind = token.lit_float }
        self.emit(stream, kind, offset)
    }

    scan_str :: fn(self &Self, stream &TokenStream, is_c bool) {
        offset := self.cursor
        if is_c { self.bump() }
        self.bump()

        while (not self.is_eof()) and (self.current() != '"') {
            if is_newline(self.current()) {
                self.error(c"newline in string literal", offset)
            }
            if self.current() == '\\' {
                self.bump()
                if self.is_eof() or (not self.valid_escape()) {
                    self.error(c"invalid string escape", offset)
                }
            }
            self.bump()
        }

        if self.is_eof() {
            self.error(c"unterminated string", offset)
        }
        self.bump()

        kind := token.lit_str
        if is_c { kind = token.lit_cstr }
        self.emit(stream, kind, offset)
    }

    scan_raw_str :: fn(self &Self, stream &TokenStream) {
        offset := self.cursor
        self.bump()

        while (not self.is_eof()) and (self.current() != '`') {
            if (self.current() == '\\') and (self.peek() == '`') {
                self.bump()
            }
            self.bump()
        }

        if self.is_eof() {
            self.error(c"unterminated multiline string", offset)
        }
        self.bump()

        self.emit(stream, token.lit_str, offset)
    }

    scan_char :: fn(self &Self, stream &TokenStream) {
        offset := self.cursor
        self.bump()

        if self.current() == '\\' {
            self.bump()
            if self.is_eof() or (not self.valid_escape()) {
                self.error(c"invalid character escape", offset)
            }
            if self.current() == 'x' {
                self.bump()
                while is_hex_digit(self.current()) {
                    self.bump()
                }
            } else {
                self.bump()
            }
        } else {
            if self.is_eof() or (self.current() == '\'') {
                self.error(c"invalid character literal", offset)
            }
            self.bump()
        }

        if self.current() != '\'' {
            self.error(c"unterminated or oversized character literal", offset)
        }
        self.bump()

        self.emit(stream, token.lit_char, offset)
    }

    scan_identifier :: fn(self &Self, stream &TokenStream) {
        offset := self.cursor
        while (not self.is_eof()) and is_alphanumeric(self.current()) {
            self.bump()
        }
        len := (self.cursor - offset) as u32
        text := Str.new(self.source.ptr + offset, len as u64)
        self.emit(stream, match_keyword(text), offset)
    }

    scan_symbol :: fn(self &Self) TokenType {
        t := token
        c := self.current()
        self.bump()

        if c == '+' { if self.consume_char('=') { ret t.plus_eq }, ret t.plus }
        if c == '-' { if self.consume_char('=') { ret t.minus_eq }, ret t.minus }
        if c == '*' { if self.consume_char('=') { ret t.star_eq }, ret t.star }
        if c == '/' { if self.consume_char('=') { ret t.slash_eq }, ret t.slash }
        if c == '%' { if self.consume_char('=') { ret t.percent_eq }, ret t.percent }
        if c == '&' { if self.consume_char('=') { ret t.amp_eq }, ret t.amp }
        if c == '|' { if self.consume_char('=') { ret t.pipe_eq }, ret t.pipe }
        if c == '^' { if self.consume_char('=') { ret t.caret_eq }, ret t.caret }
        if c == '~' { ret t.tilde }
        if c == '=' { if self.consume_char('=') { ret t.eq_eq }, ret t.eq }
        if c == '!' { if self.consume_char('=') { ret t.bang_eq }, ret t.unknown }
        if c == ':' { if self.consume_char(':') { ret t.colon_colon }, ret t.colon }
        if c == '.' { ret t.dot }
        if c == '<' {
            if self.consume_char('<') {
                if self.consume_char('=') { ret t.left_shift_eq }
                ret t.left_shift
            }
            if self.consume_char('=') { ret t.lt_eq }
            ret t.lt
        }
        if c == '>' {
            if self.consume_char('>') {
                if self.consume_char('=') { ret t.right_shift_eq }
                ret t.right_shift
            }
            if self.consume_char('=') { ret t.gt_eq }
            ret t.gt
        }
        if c == ',' { ret t.comma }
        if c == ';' { ret t.semi }
        if c == '(' { ret t.o_paren }
        if c == ')' { ret t.c_paren }
        if c == '{' { ret t.o_brace }
        if c == '}' { ret t.c_brace }
        if c == '[' { ret t.o_bracket }
        if c == ']' { ret t.c_bracket }
        if c == '#' { ret t.hash }
        if c == '@' { ret t.at }

        t.unknown
    }
}

lex :: fn(stream &TokenStream, source Str, path Str) {
    lexer := Lexer.new(source, path)

    while not lexer.is_eof() {
        c := lexer.current()

        if is_whitespace(c) {
            lexer.bump()
            while (not lexer.is_eof()) and is_whitespace(lexer.current()) {
                lexer.bump()
            }
            cont
        }

        if is_newline(c) {
            lexer.had_newline = true
            lexer.bump()
            while (not lexer.is_eof()) and is_newline(lexer.current()) {
                lexer.bump()
            }
            cont
        }

        if c == '-' and lexer.peek() == '-' {
            lexer.bump()
            lexer.bump()
            while (not lexer.is_eof()) and (not is_newline(lexer.current())) {
                lexer.bump()
            }
            cont
        }

        if is_digit(c) {
            lexer.scan_number(stream)
            cont
        }

        if c == 'c' and lexer.peek() == '"' {
            lexer.scan_str(stream, true)
            cont
        }

        if c == '"' {
            lexer.scan_str(stream, false)
            cont
        }

        if c == '`' {
            lexer.scan_raw_str(stream)
            cont
        }

        if c == '\'' {
            lexer.scan_char(stream)
            cont
        }

        if is_alpha(c) {
            lexer.scan_identifier(stream)
            cont
        }

        offset := lexer.cursor
        kind := lexer.scan_symbol()
        if kind == token.unknown {
            lexer.error(c"unknown character", offset)
        }
        lexer.emit(stream, kind, offset)
    }

    stream.push(token.eof, lexer.cursor as u32, 0, Str.empty(), lexer.had_newline)
}

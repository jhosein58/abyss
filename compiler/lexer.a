import Token as Tk, TokenStream from "./token"
import calc_pos from "./nexus/nexus"
import fall from "std/sys"
import is_digit, is_hex_digit, is_bin_digit, is_oct_digit, hex_digit_value, is_alpha, is_alphanumeric, is_whitespace, is_newline from "std/ascii"

match_keyword :: fn(text Str) Tk {
    if text.len == 2 {
        if text.eq("if") { ret Tk.kw_if }
        if text.eq("as") { ret Tk.kw_as }
        if text.eq("or") { ret Tk.kw_or }
        if text.eq("fn") { ret Tk.kw_fn }
        if text.eq("in") { ret Tk.kw_in }
    }

    if text.len == 3 {
        if text.eq("ret") { ret Tk.kw_ret }
        if text.eq("and") { ret Tk.kw_and }
        if text.eq("not") { ret Tk.kw_not }
        if text.eq("for") { ret Tk.kw_for }
    }

    if text.len == 4 {
        if text.eq("else") { ret Tk.kw_else }
        if text.eq("cont") { ret Tk.kw_cont }
        if text.eq("true") { ret Tk.kw_true }
        if text.eq("from") { ret Tk.kw_from }
        if text.eq("enum") { ret Tk.kw_enum }
        if text.eq("cmpt") { ret Tk.kw_cmpt }
    }

    if text.len == 5 {
        if text.eq("while") { ret Tk.kw_while }
        if text.eq("break") { ret Tk.kw_break }
        if text.eq("false") { ret Tk.kw_false }
        if text.eq("match") { ret Tk.kw_match }
    }

    if text.len == 6 {
        if text.eq("struct") { ret Tk.kw_struct }
        if text.eq("import") { ret Tk.kw_import }
    }

    Tk.ident
}

check_base_digit :: fn(c u8, is_hex, is_bin, is_oct bool) bool {
    if is_hex { ret is_hex_digit(c) }
    if is_bin { ret is_bin_digit(c) }
    if is_oct { ret is_oct_digit(c) }
    false
}

Lexer :: struct {
    source, path Str
    cursor u64
    had_newline bool

    new :: fn(source, path Str) Self {
        .{
            source: source,
            path: path,
            cursor: 0,
            had_newline: true
        }
    }

    is_eof :: fn(self &Self) bool {
        self.cursor >= self.source.len
    }

    current :: fn(self &Self) u8 {
        if self.is_eof() { ret 0 as u8 }
        *(self.source.ptr + self.cursor)
    }

    peek :: fn(self &Self) u8 {
        if self.cursor + 1 >= self.source.len { ret 0 as u8 }
        *(self.source.ptr + self.cursor + 1)
    }

    bump :: fn(self &Self) {
        if not self.is_eof() {
            self.cursor = self.cursor + 1
        }
    }

    consume_char :: fn(self &Self, expected u8) bool {
        if (self.current() == expected) and (not self.is_eof()) {
            self.bump()
            ret true
        }
        false
    }

    match_eq :: fn(self &Self, base Tk, with_eq Tk) Tk {
        if self.consume_char('=') { ret with_eq }
        base
    }

    error :: fn(self &Self, msg &u8, offset u64) {
        pos := calc_pos(self.source, offset as u32)
        printf("\n[lex error] {}\n       --> {}:{}:{}\n", .{msg, self.path, pos.line, pos.col})
        fall()
    }

    emit :: fn(self &Self, stream &TokenStream, kind Tk, offset u64) {
        len := (self.cursor - offset) as u32
        text := Str.new(self.source.ptr + offset, len as u64)
        stream.push(kind, offset as u32, len, text, self.had_newline)
        self.had_newline = false
    }

    valid_escape :: fn(self &Self) bool {
        c := self.current()
        if c == 'x' { ret is_hex_digit(self.peek()) }
        if c == 'u' { ret self.peek() == '{' }
        if (c >= '0') and (c <= '7') { ret true }
        (c == 'a') or (c == 'b') or (c == 'f') or (c == 'n') or (c == 'r') or
        (c == 't') or (c == 'v') or (c == '\\') or (c == '\'') or (c == '"') or (c == '?') or (c == '0')
    }

    scan_decimal_digits :: fn(self &Self) {
        while not self.is_eof() {
            c := self.current()
            if is_digit(c) {
                self.bump()
            } else if c == '_' {
                prev := *(self.source.ptr + self.cursor - 1)
                next := self.peek()
                if (not is_digit(prev)) or (not is_digit(next)) {
                    self.error(c"invalid digit separator '_'", self.cursor)
                }
                self.bump()
            } else {
                break
            }
        }
    }

    scan_base_digits :: fn(self &Self, is_hex, is_bin, is_oct bool) {
        offset := self.cursor
        self.bump()
        self.bump()
        if self.is_eof() or (not check_base_digit(self.current(), is_hex, is_bin, is_oct)) {
            self.error(c"expected digits after base prefix", offset)
        }
        self.bump()
        while not self.is_eof() {
            c := self.current()
            if check_base_digit(c, is_hex, is_bin, is_oct) {
                self.bump()
            } else if c == '_' {
                prev := *(self.source.ptr + self.cursor - 1)
                next := self.peek()
                if (not check_base_digit(prev, is_hex, is_bin, is_oct)) or (not check_base_digit(next, is_hex, is_bin, is_oct)) {
                    self.error(c"invalid digit separator '_'", self.cursor)
                }
                self.bump()
            } else {
                break
            }
        }
    }

    scan_number :: fn(self &Self, stream &TokenStream) {
        offset := self.cursor
        is_float := false

        if self.current() == '0' {
            p := self.peek()
            is_hex := (p == 'x') or (p == 'X')
            is_bin := (p == 'b') or (p == 'B')
            is_oct := (p == 'o') or (p == 'O')
            if is_hex or is_bin or is_oct {
                self.scan_base_digits(is_hex, is_bin, is_oct)
                self.emit(stream, Tk.lit_int, offset)
                ret
            }
        }

        self.scan_decimal_digits()

        if (self.current() == '.') and (self.peek() != '.') and is_digit(self.peek()) {
            is_float = true
            self.bump()
            self.scan_decimal_digits()
        }

        if (self.current() == 'e') or (self.current() == 'E') {
            has_sign := (self.peek() == '+') or (self.peek() == '-')
            has_exp_digits := false
            if has_sign {
                if (self.cursor + 2 < self.source.len) and is_digit(*(self.source.ptr + self.cursor + 2)) {
                    has_exp_digits = true
                }
            } else if is_digit(self.peek()) {
                has_exp_digits = true
            }

            if has_exp_digits {
                is_float = true
                self.bump()
                if (self.current() == '+') or (self.current() == '-') {
                    self.bump()
                }
                self.scan_decimal_digits()
            }
        }

        kind := if is_float { Tk.lit_float } else { Tk.lit_int }
        self.emit(stream, kind, offset)
    }

    scan_str :: fn(self &Self, stream &TokenStream, is_c bool) {
        offset := self.cursor
        if is_c { self.bump() }
        self.bump()

        while (not self.is_eof()) and (self.current() != '"') {
            if is_newline(self.current()) {
                self.error(c"newline in string literal", offset)
            }
            if self.current() == '\\' {
                self.bump()
                if self.is_eof() or (not self.valid_escape()) {
                    self.error(c"invalid string escape", offset)
                }
            }
            self.bump()
        }

        if self.is_eof() {
            self.error(c"unterminated string", offset)
        }
        self.bump()

        kind := if is_c { Tk.lit_cstr } else { Tk.lit_str }
        self.emit(stream, kind, offset)
    }

    scan_raw_str :: fn(self &Self, stream &TokenStream) {
        offset := self.cursor
        self.bump()

        while (not self.is_eof()) and (self.current() != '`') {
            if (self.current() == '\\') and (self.peek() == '`') {
                self.bump()
            }
            self.bump()
        }

        if self.is_eof() {
            self.error(c"unterminated multiline string", offset)
        }
        self.bump()

        self.emit(stream, Tk.lit_str, offset)
    }

    scan_char :: fn(self &Self, stream &TokenStream) {
        offset := self.cursor
        self.bump()

        if self.current() == '\\' {
            self.bump()
            if self.is_eof() or (not self.valid_escape()) {
                self.error(c"invalid character escape", offset)
            }
            if self.current() == 'x' {
                self.bump()
                while is_hex_digit(self.current()) {
                    self.bump()
                }
            } else if (self.current() == 'u') and (self.peek() == '{') {
                self.bump()
                self.bump()
                has_hex := false
                while is_hex_digit(self.current()) {
                    has_hex = true
                    self.bump()
                }
                if (not has_hex) or (self.current() != '}') {
                    self.error(c"invalid unicode escape", offset)
                }
                self.bump()
            } else {
                self.bump()
            }
        } else {
            if self.is_eof() or (self.current() == '\'') {
                self.error(c"invalid character literal", offset)
            }
            c := self.current()
            if (c & 0x80) == 0 {
                self.bump()
            } else {
                need: u32 = 0
                if (c & 0xE0) == 0xC0 { need = 1 }
                else if (c & 0xF0) == 0xE0 { need = 2 }
                else if (c & 0xF8) == 0xF0 { need = 3 }
                else {
                    self.error(c"invalid utf-8 lead byte in character literal", offset)
                }
                self.bump()
                while need > 0 {
                    if self.is_eof() or ((self.current() & 0xC0) != 0x80) {
                        self.error(c"invalid utf-8 sequence in character literal", offset)
                    }
                    self.bump()
                    need = need - 1
                }
            }
        }

        if self.current() != '\'' {
            self.error(c"unterminated or oversized character literal", offset)
        }
        self.bump()

        self.emit(stream, Tk.lit_char, offset)
    }

    scan_identifier :: fn(self &Self, stream &TokenStream) {
        offset := self.cursor
        while (not self.is_eof()) and is_alphanumeric(self.current()) {
            self.bump()
        }
        len := (self.cursor - offset) as u32
        text := Str.new(self.source.ptr + offset, len as u64)
        self.emit(stream, match_keyword(text), offset)
    }

    scan_symbol :: fn(self &Self) Tk {
        c := self.current()
        self.bump()

        if c == '+' { ret self.match_eq(Tk.plus, Tk.plus_eq) }
        if c == '-' { ret self.match_eq(Tk.minus, Tk.minus_eq) }
        if c == '*' { ret self.match_eq(Tk.star, Tk.star_eq) }
        if c == '/' { ret self.match_eq(Tk.slash, Tk.slash_eq) }
        if c == '%' { ret self.match_eq(Tk.percent, Tk.percent_eq) }
        if c == '&' { ret self.match_eq(Tk.amp, Tk.amp_eq) }
        if c == '|' { ret self.match_eq(Tk.pipe, Tk.pipe_eq) }
        if c == '^' { ret self.match_eq(Tk.caret, Tk.caret_eq) }
        if c == '~' { ret Tk.tilde }
        if c == '=' { ret self.match_eq(Tk.eq, Tk.eq_eq) }
        if c == '!' { ret self.match_eq(Tk.unknown, Tk.bang_eq) }
        if c == ':' {
            if self.consume_char(':') { ret Tk.colon_colon }
            ret Tk.colon
        }
        if c == '.' { ret Tk.dot }
        if c == '<' {
            if self.consume_char('<') {
                ret self.match_eq(Tk.left_shift, Tk.left_shift_eq)
            }
            ret self.match_eq(Tk.lt, Tk.lt_eq)
        }
        if c == '>' {
            if self.consume_char('>') {
                ret self.match_eq(Tk.right_shift, Tk.right_shift_eq)
            }
            ret self.match_eq(Tk.gt, Tk.gt_eq)
        }
        if c == ',' { ret Tk.comma }
        if c == ';' { ret Tk.semi }
        if c == '(' { ret Tk.o_paren }
        if c == ')' { ret Tk.c_paren }
        if c == '{' { ret Tk.o_brace }
        if c == '}' { ret Tk.c_brace }
        if c == '[' { ret Tk.o_bracket }
        if c == ']' { ret Tk.c_bracket }
        if c == '#' { ret Tk.hash }
        if c == '@' { ret Tk.at }

        Tk.unknown
    }
}

lex :: fn(stream &TokenStream, source Str, path Str) {
    lexer := Lexer.new(source, path)

    while not lexer.is_eof() {
        c := lexer.current()

        if is_whitespace(c) {
            lexer.bump()
            while (not lexer.is_eof()) and is_whitespace(lexer.current()) {
                lexer.bump()
            }
            cont
        }

        if is_newline(c) {
            lexer.had_newline = true
            lexer.bump()
            while (not lexer.is_eof()) and is_newline(lexer.current()) {
                lexer.bump()
            }
            cont
        }

        if (c == '-') and (lexer.peek() == '-') {
            lexer.bump()
            lexer.bump()
            while (not lexer.is_eof()) and (not is_newline(lexer.current())) {
                lexer.bump()
            }
            cont
        }

        if is_digit(c) {
            lexer.scan_number(stream)
            cont
        }

        if (c == 'c') and (lexer.peek() == '"') {
            lexer.scan_str(stream, true)
            cont
        }

        if c == '"' {
            lexer.scan_str(stream, false)
            cont
        }

        if c == '`' {
            lexer.scan_raw_str(stream)
            cont
        }

        if c == '\'' {
            lexer.scan_char(stream)
            cont
        }

        if is_alpha(c) {
            lexer.scan_identifier(stream)
            cont
        }

        offset := lexer.cursor
        kind := lexer.scan_symbol()
        if kind == Tk.unknown {
            lexer.error(c"unknown character", offset)
        }
        lexer.emit(stream, kind, offset)
    }

    stream.push(Tk.eof, lexer.cursor as u32, 0, Str.empty(), lexer.had_newline)
}

decode_char_lit :: fn(raw Str) u32 {
    if raw.len < 3 { ret 0 }
    ptr := raw.ptr + 1
    len := raw.len - 2

    if *ptr == '\\' {
        if len < 2 { ret 0 }
        esc := *(ptr + 1)
        if esc == 'n' { ret 10 }
        if esc == 'r' { ret 13 }
        if esc == 't' { ret 9 }
        if esc == '0' { ret 0 }
        if esc == 'a' { ret 7 }
        if esc == 'b' { ret 8 }
        if esc == 'f' { ret 12 }
        if esc == 'v' { ret 11 }
        if esc == '\\' { ret 92 }
        if esc == '\'' { ret 39 }
        if esc == '"' { ret 34 }
        if esc == 'x' {
            val: u32 = 0
            i: u64 = 2
            while i < len {
                ch := *(ptr + i)
                if not is_hex_digit(ch) { break }
                val = (val << 4) | hex_digit_value(ch)
                i = i + 1
            }
            ret val
        }
        if (esc == 'u') and (len >= 4) and (*(ptr + 2) == '{') {
            val: u32 = 0
            i: u64 = 3
            while i < len {
                ch := *(ptr + i)
                if ch == '}' { break }
                if not is_hex_digit(ch) { break }
                val = (val << 4) | hex_digit_value(ch)
                i = i + 1
            }
            ret val
        }
        ret esc as u32
    }

    b0 := *ptr
    if (b0 & 0x80) == 0 {
        ret b0 as u32
    }
    if (b0 & 0xE0) == 0xC0 {
        if len >= 2 {
            b1 := *(ptr + 1)
            ret (((b0 & 0x1F) as u32) << 6) | ((b1 & 0x3F) as u32)
        }
        ret b0 as u32
    }
    if (b0 & 0xF0) == 0xE0 {
        if len >= 3 {
            b1 := *(ptr + 1)
            b2 := *(ptr + 2)
            ret (((b0 & 0x0F) as u32) << 12) | (((b1 & 0x3F) as u32) << 6) | ((b2 & 0x3F) as u32)
        }
        ret b0 as u32
    }
    if (b0 & 0xF8) == 0xF0 {
        if len >= 4 {
            b1 := *(ptr + 1)
            b2 := *(ptr + 2)
            b3 := *(ptr + 3)
            ret (((b0 & 0x07) as u32) << 18) | (((b1 & 0x3F) as u32) << 12) | (((b2 & 0x3F) as u32) << 6) | ((b3 & 0x3F) as u32)
        }
        ret b0 as u32
    }
    b0 as u32
}

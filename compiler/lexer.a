import Str from "../std/string.a"
import token, TokenType, TokenStream from "token.a"
import calc_pos from "nexus/nexus.a"
import fall from "../std/sys.a"
import is_digit, is_hex_digit, is_alpha, is_alphanumeric, is_whitespace, is_newline from "../std/ascii.a"

print :: fn(s &u8) unit
print_u32 :: fn(v u32) unit

match_keyword :: fn(text Str) TokenType {
    t := token

    if text.len == 2 {
        if text.eq(Str.of("if")) { ret t.kw_if }
        if text.eq(Str.of("as")) { ret t.kw_as }
        if text.eq(Str.of("or")) { ret t.kw_or }
        if text.eq(Str.of("fn")) { ret t.kw_fn }
    }

    if text.len == 3 {
        if text.eq(Str.of("ret")) { ret t.kw_ret }
        if text.eq(Str.of("and")) { ret t.kw_and }
        if text.eq(Str.of("not")) { ret t.kw_not }
    }

    if text.len == 4 {
        if text.eq(Str.of("else")) { ret t.kw_else }
        if text.eq(Str.of("cont")) { ret t.kw_cont }
        if text.eq(Str.of("true")) { ret t.kw_true }
        if text.eq(Str.of("from")) { ret t.kw_from }
        if text.eq(Str.of("enum")) { ret t.kw_enum }
    }

    if text.len == 5 {
        if text.eq(Str.of("while")) { ret t.kw_while }
        if text.eq(Str.of("break")) { ret t.kw_break }
        if text.eq(Str.of("false")) { ret t.kw_false }
    }

    if text.len == 6 {
        if text.eq(Str.of("struct")) { ret t.kw_struct }
        if text.eq(Str.of("import")) { ret t.kw_import }
    }

    t.ident
}

Lexer :: struct {
    source Str
    path Str
    cursor u64
    had_newline bool

    new :: fn(source Str, path Str) Self {
        .{
            source: source,
            path: path,
            cursor: 0,
            had_newline: true
        }
    }

    is_eof :: fn() bool {
        .cursor >= .source.len
    }

    current :: fn() u8 {
        if .is_eof() { ret 0 as u8 }
        *(.source.ptr + .cursor)
    }

    peek :: fn() u8 {
        if .cursor + 1 >= .source.len { ret 0 as u8 }
        *(.source.ptr + .cursor + 1)
    }

    bump :: fn() {
        if not .is_eof() {
            .cursor = .cursor + 1
        }
    }

    match :: fn(expected u8) bool {
        if (.current() == expected) and (not .is_eof()) {
            .bump()
            ret true
        }
        false
    }

    error :: fn(msg &u8, offset u64) {
        print(c"\n[lex error] ")
        print(msg)
        print(c"\n       --> ")
        .path.print()
        print(c":")
        pos := calc_pos(.source, offset as u32)
        print_u32(pos.line)
        print(c":")
        print_u32(pos.col)
        print(c"\n")
        fall()
    }

    emit :: fn(stream &TokenStream, kind TokenType, offset u64) {
        len := (.cursor - offset) as u32
        text := Str.new(.source.ptr + offset, len as u64)
        stream.push(kind, offset as u32, len, text, .had_newline)
        .had_newline = false
    }

    valid_escape :: fn() bool {
        c := .current()
        if c == 120 { ret is_hex_digit(.peek()) }
        if (c >= 48) and (c <= 55) { ret true }
        (c == 97) or (c == 98) or (c == 102) or (c == 110) or (c == 114) or
        (c == 116) or (c == 118) or (c == 92) or (c == 39) or (c == 34) or (c == 63)
    }

    scan_number :: fn(stream &TokenStream) {
        offset := .cursor
        is_float := false

        if .current() == 48 {
            p := .peek()
            if (p == 120) or (p == 88) {
                .bump()
                .bump()
                while (not .is_eof()) and (is_hex_digit(.current()) or (.current() == 95)) {
                    .bump()
                }
                .emit(stream, token.lit_int, offset)
                ret
            }
        }

        while (not .is_eof()) and (is_digit(.current()) or (.current() == 95)) {
            .bump()
        }

        if (.current() == 46) and (.peek() != 46) and is_digit(.peek()) {
            is_float = true
            .bump()
            while (not .is_eof()) and (is_digit(.current()) or (.current() == 95)) {
                .bump()
            }
        }

        if is_float {
            check := offset
            while check < .cursor {
                if *(.source.ptr + check) == 95 {
                    .error(c"separators in float literals are unsupported", offset)
                }
                check = check + 1
            }
        }

        kind := token.lit_int
        if is_float { kind = token.lit_float }
        .emit(stream, kind, offset)
    }

    scan_str :: fn(stream &TokenStream, is_c bool) {
        offset := .cursor
        if is_c { .bump() }
        .bump()

        while (not .is_eof()) and (.current() != 34) {
            if is_newline(.current()) {
                .error(c"newline in string literal", offset)
            }
            if .current() == 92 {
                .bump()
                if .is_eof() or (not .valid_escape()) {
                    .error(c"invalid string escape", offset)
                }
            }
            .bump()
        }

        if .is_eof() {
            .error(c"unterminated string", offset)
        }
        .bump()

        kind := token.lit_str
        if is_c { kind = token.lit_cstr }
        .emit(stream, kind, offset)
    }

    scan_char :: fn(stream &TokenStream) {
        offset := .cursor
        .bump()

        if .current() == 92 {
            .bump()
            if .is_eof() or (not .valid_escape()) {
                .error(c"invalid character escape", offset)
            }
            if .current() == 120 {
                .bump()
                while is_hex_digit(.current()) {
                    .bump()
                }
            } else {
                .bump()
            }
        } else {
            if .is_eof() or (.current() == 39) {
                .error(c"invalid character literal", offset)
            }
            .bump()
        }

        if .current() != 39 {
            .error(c"unterminated or oversized character literal", offset)
        }
        .bump()

        .emit(stream, token.lit_char, offset)
    }

    scan_identifier :: fn(stream &TokenStream) {
        offset := .cursor
        while (not .is_eof()) and is_alphanumeric(.current()) {
            .bump()
        }
        len := (.cursor - offset) as u32
        text := Str.new(.source.ptr + offset, len as u64)
        .emit(stream, match_keyword(text), offset)
    }

    scan_symbol :: fn() TokenType {
        t := token
        c := .current()
        .bump()

        if c == 43 { if .match(61) { ret t.plus_eq } ret t.plus }
        if c == 45 { if .match(61) { ret t.minus_eq } ret t.minus }
        if c == 42 { if .match(61) { ret t.star_eq } ret t.star }
        if c == 47 { if .match(61) { ret t.slash_eq } ret t.slash }
        if c == 37 { if .match(61) { ret t.percent_eq } ret t.percent }
        if c == 38 { if .match(61) { ret t.amp_eq } ret t.amp }
        if c == 124 { if .match(61) { ret t.pipe_eq } ret t.pipe }
        if c == 94 { if .match(61) { ret t.caret_eq } ret t.caret }
        if c == 126 { ret t.tilde }
        if c == 61 { if .match(61) { ret t.eq_eq } ret t.eq }
        if c == 33 { if .match(61) { ret t.bang_eq } ret t.unknown }
        if c == 58 { if .match(58) { ret t.colon_colon } ret t.colon }
        if c == 46 { ret t.dot }
        if c == 60 {
            if .match(60) {
                if .match(61) { ret t.left_shift_eq }
                ret t.left_shift
            }
            if .match(61) { ret t.lt_eq }
            ret t.lt
        }
        if c == 62 {
            if .match(62) {
                if .match(61) { ret t.right_shift_eq }
                ret t.right_shift
            }
            if .match(61) { ret t.gt_eq }
            ret t.gt
        }
        if c == 44 { ret t.comma }
        if c == 59 { ret t.semi }
        if c == 40 { ret t.o_paren }
        if c == 41 { ret t.c_paren }
        if c == 123 { ret t.o_brace }
        if c == 125 { ret t.c_brace }
        if c == 91 { ret t.o_bracket }
        if c == 93 { ret t.c_bracket }
        if c == 35 { ret t.hash }
        if c == 64 { ret t.at }

        t.unknown
    }
}

lex :: fn(stream &TokenStream, source Str, path Str) {
    lexer := Lexer.new(source, path)

    while not lexer.is_eof() {
        c := lexer.current()

        if is_whitespace(c) {
            lexer.bump()
            while (not lexer.is_eof()) and is_whitespace(lexer.current()) {
                lexer.bump()
            }
            cont
        }

        if is_newline(c) {
            lexer.had_newline = true
            lexer.bump()
            while (not lexer.is_eof()) and is_newline(lexer.current()) {
                lexer.bump()
            }
            cont
        }

        if c == 45 and lexer.peek() == 45 {
            lexer.bump()
            lexer.bump()
            while (not lexer.is_eof()) and (not is_newline(lexer.current())) {
                lexer.bump()
            }
            cont
        }

        if is_digit(c) or (c == 46 and is_digit(lexer.peek())) {
            lexer.scan_number(stream)
            cont
        }

        if c == 99 and lexer.peek() == 34 {
            lexer.scan_str(stream, true)
            cont
        }

        if c == 34 {
            lexer.scan_str(stream, false)
            cont
        }

        if c == 39 {
            lexer.scan_char(stream)
            cont
        }

        if is_alpha(c) {
            lexer.scan_identifier(stream)
            cont
        }

        offset := lexer.cursor
        kind := lexer.scan_symbol()
        if kind == token.unknown {
            lexer.error(c"unknown character", offset)
        }
        lexer.emit(stream, kind, offset)
    }

    stream.push(token.eof, lexer.cursor as u32, 0, Str.empty(), lexer.had_newline)
}

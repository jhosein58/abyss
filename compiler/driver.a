import std.string: Str
import std.allocator: Arena
import std.fs: File, read_file, write_file, Embed
import std.env: Env
import std.path: Path
import compiler.engine: Engine
import compiler.codegen: CCodeGen, CCodeBuilder, CCodeGen_new, CCodeGen_destroy, CCodeGen_finish
import compiler.vm.codegen: VmCodeGen, VmCodeBuilder
import compiler.vm.vm: Vm

CompilerConfig :: struct {
    src_path    &u8
    out_path    &u8
    is_vm_run   bool
    import_dirs Vec(Str)
    map_keys    Vec(Str)
    map_values  Vec(Str)

    from_env :: fn() Self {
        argc := Env.args_len()
        src := Env.get_or(c"ABYSS_SRC", c"main.a")
        out := Env.get_or(c"ABYSS_OUT", c"out.c")
        vm_run := Env.has(c"ABYSS_VM")
        import_dirs := Vec(Str).new()
        map_keys := Vec(Str).new()
        map_values := Vec(Str).new()

        pos_idx: i32 = 0
        i: i32 = 1
        while i < argc {
            arg_cstr := Env.arg(i)
            arg_str := Str.of(arg_cstr)
            if arg_str.eq("r") or arg_str.eq("run") {
                vm_run = true
            } else if arg_str.eq("b") or arg_str.eq("build") {
                vm_run = false
            } else if arg_str.eq("-I") {
                if (i + 1) < argc {
                    i = i + 1
                    import_dirs.push(Str.of(Env.arg(i)))
                }
            } else if arg_str.starts_with("-I") and (arg_str.len > 2) {
                import_dirs.push(arg_str.sub(2, arg_str.len - 2))
            } else if arg_str.eq("--map") {
                if (i + 1) < argc {
                    i = i + 1
                    map_arg := Str.of(Env.arg(i))
                    eq_idx: u64 = 0
                    found_eq := false
                    while eq_idx < map_arg.len {
                        if *(map_arg.ptr + eq_idx) == ('=' as u8) {
                            found_eq = true
                            break
                        }
                        eq_idx = eq_idx + 1
                    }
                    if found_eq {
                        map_keys.push(map_arg.sub(0, eq_idx))
                        map_values.push(map_arg.sub(eq_idx + 1, map_arg.len - eq_idx - 1))
                    }
                }
            } else {
                if pos_idx == 0 {
                    src = arg_cstr
                    pos_idx = 1
                } else if pos_idx == 1 {
                    out = arg_cstr
                    pos_idx = 2
                }
            }
            i = i + 1
        }

        .{
            src_path    : src
            out_path    : out
            is_vm_run   : vm_run
            import_dirs : import_dirs
            map_keys    : map_keys
            map_values  : map_values
        }
    }
}

embedded_runtime_body :: fn() Str {
    arena := Arena.new(1024 * 1024)
    Embed.file(&arena, Str.of("runtime/prelude.c"))
}

embedded_runtime :: fn() Str {
    #embedded_runtime_body()
}

Driver :: struct {
    arena  &Arena
    config CompilerConfig

    new :: fn(arena &Arena) Self {
        .{
            arena  : arena,
            config : CompilerConfig.from_env(),
        }
    }

    with_config :: fn(arena &Arena, config CompilerConfig) Self {
        .{
            arena  : arena,
            config : config,
        }
    }

    resolve_prelude :: fn(self &Self) Str {
        prelude_source := embedded_runtime()
        env_prelude := Env.get(c"ABYSS_PRELUDE")
        if env_prelude != (0 as &u8) {
            opt := File.read_to_string(self.arena, Str.of(env_prelude))
            if opt.is_some() {
                prelude_source = opt.unwrap()
            }
        } else {
            env_dev := Env.get(c"ABYSS_DEV")
            if env_dev != (0 as &u8) {
                prelude_path := Str.of("runtime/prelude.c")
                dev_str := Str.of(env_dev)
                if (not dev_str.eq(Str.of("1"))) and (not dev_str.eq(Str.of("true"))) {
                    prelude_path = Path.join(self.arena, dev_str, Str.of("runtime/prelude.c"))
                }
                opt := File.read_to_string(self.arena, prelude_path)
                if opt.is_some() {
                    prelude_source = opt.unwrap()
                }
            }
        }
        prelude_source
    }

    run :: fn(self &Self) {
        source := read_file(self.arena, self.config.src_path)
        eng := Engine.new(self.arena)
        i: u64 = 0
        while i < self.config.import_dirs.len {
            eng.nexus.import_dirs.push(self.config.import_dirs.get(i))
            i = i + 1
        }
        j: u64 = 0
        while j < self.config.map_keys.len {
            eng.nexus.map_keys.push(self.config.map_keys.get(j))
            eng.nexus.map_values.push(self.config.map_values.get(j))
            j = j + 1
        }
        fid := eng.add_file(self.arena, Str.of(self.config.src_path), source)
        sym_id := eng.build_main(fid)

        if self.config.is_vm_run {
            Env.shift_args()
            vcg := VmCodeGen.new(self.arena)
            vcg.init_types(&eng.nexus.types, self.arena)
            vbuilder := VmCodeBuilder.new(&vcg)
            vcg.abyss_main(sym_id)
            eng.compile(&vcg, &vbuilder, self.arena, sym_id)
            vcg.finish_linking()
            vm := Vm.new()
            vm.run(&vcg.chunk, vcg.main_entry)
            vm.destroy()
            vcg.destroy()
            ret
        }

        ccg := CCodeGen_new(self.arena)
        builder := CCodeBuilder.new()
        ccg.abyss_main(sym_id)
        eng.compile(&ccg, &builder, self.arena, sym_id)
        prelude_source := self.resolve_prelude()
        c_code := CCodeGen_finish(&ccg, prelude_source)
        write_file(self.config.out_path, c_code)
        CCodeGen_destroy(&ccg)
    }
}

import core.target: Arch, Os
import std.allocator: Arena
import std.env:       Env
import std.fs:        read_file, write_file
import std.string:    Str
import std.sys:       exit_process, fall

import compiler.codegen:    CCodeBuilder, CCodeGen, CCodeGen_destroy, CCodeGen_finish, CCodeGen_new
import compiler.engine:     Engine
import compiler.nexus.pool: id_none
import compiler.platform:   host_arch, host_os, parse_arch, parse_os
import compiler.vm.codegen: VmCodeBuilder, VmCodeGen
import compiler.vm.vm:      Vm
import compiler.types:      TyKind

CompilerConfig :: struct {
    src_path    &u8
    out_path    &u8
    is_vm_run   bool
    import_dirs Vec(Str)
    map_keys    Vec(Str)
    map_values  Vec(Str)
    target_os   Os
    target_arch Arch
    is_library  bool
    source_index i32
    from_env :: fn() Self {
        argc := Env.args_len()
        src := Env.get_or(c"ABYSS_SRC", c"main.a")
        out := Env.get_or(c"ABYSS_OUT", c"out.c")
        vm_run := Env.has(c"ABYSS_VM")
        import_dirs := Vec(Str).new()
        map_keys := Vec(Str).new()
        map_values := Vec(Str).new()
        target_os := host_os()
        arch := Maybe(Arch).none()
        library := false

        pos_idx: i32 = 0
        source_index: i32 = 0
        i: i32 = 1
        while i < argc {
            arg_cstr := Env.arg(i)
            arg_str := Str.of(arg_cstr)
            if arg_str.eq("r") or arg_str.eq("run") {
                vm_run = true
            } else if arg_str.eq("b") or arg_str.eq("build") {
                vm_run = false
            } else if arg_str.eq("--version") {
                print("abyssc target-aware")
                exit_process(0)
            } else if arg_str.eq("--target") {
                i = i + 1
                os := parse_os(Str.of(Env.arg(i)))
                if os.is_none() {
                    print("--target expects linux, windows, darwin, wasi, or freestanding")
                    #fall
                }
                target_os = os.unwrap()
            } else if arg_str.eq("--arch") {
                i = i + 1
                arch = parse_arch(Str.of(Env.arg(i)))
                if arch.is_none() {
                    print("--arch expects x86_64, aarch64, or wasm32")
                    #fall
                }
            } else if arg_str.eq("--library") {
                library = true
            } else if arg_str.eq("-I") {
                if (i + 1) < argc {
                    i = i + 1
                    import_dirs.push(Str.of(Env.arg(i)))
                }
            } else if arg_str.starts_with("-I") and (arg_str.len > 2) {
                import_dirs.push(arg_str.sub(2, arg_str.len - 2))
            } else if arg_str.eq("--map") {
                if (i + 1) < argc {
                    i = i + 1
                    map_arg := Str.of(Env.arg(i))
                    eq_idx: u64 = 0
                    found_eq := false
                    while eq_idx < map_arg.len {
                        if *(map_arg.ptr + eq_idx) == ('=' as u8) {
                            found_eq = true
                            break
                        }
                        eq_idx = eq_idx + 1
                    }
                    if found_eq {
                        map_keys.push(map_arg.sub(0, eq_idx))
                        map_values.push(map_arg.sub(eq_idx + 1, map_arg.len - eq_idx - 1))
                    }
                }
            } else {
                if pos_idx == 0 {
                    src = arg_cstr
                    source_index = i
                    pos_idx = 1
                } else if pos_idx == 1 {
                    out = arg_cstr
                    pos_idx = 2
                }
            }
            i = i + 1
        }

        target_arch := arch.unwrap_or(if target_os == Os.wasi {
            Arch.wasm32
        } else if host_arch() == Arch.wasm32 and target_os != Os.freestanding {
            Arch.x86_64
        } else {
            host_arch()
        })
        if (target_os == Os.wasi and target_arch != Arch.wasm32) or (target_arch == Arch.wasm32 and target_os != Os.wasi and target_os != Os.freestanding) {
            print("unsupported target OS and architecture combination")
            #fall
        }
        if vm_run and (library or target_os != host_os() or target_arch != host_arch()) {
            print("VM execution requires a program for the host target")
            #fall
        }
        .{ src_path: src, out_path: out, is_vm_run: vm_run, import_dirs: import_dirs, map_keys: map_keys, map_values: map_values, target_os: target_os, target_arch: target_arch, is_library: library, source_index: source_index }
    }
}

Driver :: struct {
    arena  &Arena
    config CompilerConfig
    new :: fn(arena &Arena) Self {
        .{ arena: arena, config: CompilerConfig.from_env() }
    }

    with_config :: fn(arena &Arena, config CompilerConfig) Self {
        .{ arena: arena, config: config }
    }

    run :: fn(self &Self) {
        source := read_file(self.arena, self.config.src_path)
        eng := Engine.new(self.arena)
        eng.nexus.target_os = self.config.target_os
        eng.nexus.target_arch = self.config.target_arch
        i: u64 = 0
        while i < self.config.import_dirs.len {
            eng.nexus.import_dirs.push(self.config.import_dirs.get(i))
            i = i + 1
        }
        j: u64 = 0
        while j < self.config.map_keys.len {
            eng.nexus.map_keys.push(self.config.map_keys.get(j))
            eng.nexus.map_values.push(self.config.map_values.get(j))
            j = j + 1
        }
        executable := not self.config.is_library and self.config.target_os != Os.freestanding
        eng.nexus.native_output = not self.config.is_vm_run
        eng.nexus.native_executable = executable and eng.nexus.native_output
        fid := eng.add_file(self.arena, Str.of(self.config.src_path), source)
        sym_id := eng.build_entry(fid, executable)

        if self.config.is_vm_run {
            vcg := VmCodeGen.new(self.arena)
            vcg.init_types(&eng.nexus.types, self.arena)
            vbuilder := VmCodeBuilder.new(&vcg)
            vcg.abyss_main(sym_id)
            eng.compile(&vcg, &vbuilder, self.arena, sym_id)
            vcg.finish_linking()
            vm := Vm.new()
            Env.shift_args(self.config.source_index)
            if vcg.globals_entry != id_none() {
                vm.run(&vcg.chunk, vcg.globals_entry)
            }
            status := vm.run(&vcg.chunk, vcg.main_entry)
            vm.destroy()
            vcg.destroy()
            if eng.nexus.types.kind(eng.nexus.types.func_return(eng.type_of(sym_id))) != TyKind.unit {
                exit_process(status as i32)
            }
            ret
        }
        ccg := CCodeGen_new(self.arena)
        builder := CCodeBuilder.new()
        ccg.target_os = self.config.target_os
        if executable {
            ccg.abyss_main(sym_id)
            return_type := eng.nexus.types.func_return(eng.type_of(sym_id))
            ccg.main_returns_status = eng.nexus.types.kind(return_type) != TyKind.unit
        }
        eng.compile(&ccg, &builder, self.arena, sym_id)
        c_code := CCodeGen_finish(&ccg)
        write_file(self.config.out_path, c_code)
        CCodeGen_destroy(&ccg)
    }
}

import Nexus from "./nexus/nexus"
import TypeStorage, TyKind from "./types"
import fall from "std/sys"

is_composite_type :: fn(k TyKind) bool {
    (k == TyKind.struct_) or (k == TyKind.nominal) or (k == TyKind.func) or (k == TyKind.array) or (k == TyKind.union_) or (k == TyKind.enum_)
}

topo_dfs :: fn(db &Nexus, types &TypeStorage, sorted &Vec(u32), states &Vec(u8), ty_id u32) {
    if (ty_id as u64) >= (*states).len { ret }
    st := states.get(ty_id as u64)
    if st == (1 as u8) {
        printf("\n[type error] recursive value type has infinite size: '", .{})
        types.print_type(ty_id)
        printf("'; use a pointer for the recursive field\n", .{})
        if types.kind(ty_id) == TyKind.nominal {
            origin := types.nominal_origin(ty_id)
            node := origin
            if (origin & 2147483648) != 0 {
                node = types.get_nominal_struct_node(origin)
            }
            printf("       --> ", .{})
            db.print_loc(node)
            print("")
        }
        fall()
    }
    if st != (0 as u8) { ret }

    states.set(ty_id as u64, 1 as u8)

    kind := types.kind(ty_id)

    if (kind == TyKind.struct_) or (kind == TyKind.nominal) {
        fields := types.get_struct_fields(ty_id)
        count := fields.len / 2
        i: u64 = 0
        while i < count {
            f_ty := *(fields.ptr + (i * 2) + 1)
            if is_composite_type(types.kind(f_ty)) {
                topo_dfs(db, types, sorted, states, f_ty)
            }
            i = i + 1
        }
    } else if kind == TyKind.array {
        inner_ty := types.get_array_type(ty_id)
        if is_composite_type(types.kind(inner_ty)) {
            topo_dfs(db, types, sorted, states, inner_ty)
        }
    } else if kind == TyKind.func {
        ret_ty := types.func_return(ty_id)
        if is_composite_type(types.kind(ret_ty)) {
            topo_dfs(db, types, sorted, states, ret_ty)
        }
        params := types.func_params(ty_id)
        i: u64 = 0
        while i < params.len {
            p_ty := *(params.ptr + i)
            if is_composite_type(types.kind(p_ty)) {
                topo_dfs(db, types, sorted, states, p_ty)
            }
            i = i + 1
        }
    } else if kind == TyKind.union_ {
        members := types.union_members(ty_id)
        i: u64 = 0
        while i < members.len {
            m_ty := *(members.ptr + i)
            if is_composite_type(types.kind(m_ty)) {
                topo_dfs(db, types, sorted, states, m_ty)
            }
            i = i + 1
        }
    } else if kind == TyKind.enum_ {
        b_ty := types.enum_backing(ty_id)
        if is_composite_type(types.kind(b_ty)) {
            topo_dfs(db, types, sorted, states, b_ty)
        }
    }

    sorted.push(ty_id)
    states.set(ty_id as u64, 2 as u8)
}

topo_sort :: fn(db &Nexus, type_queue &Vec(u32)) Vec(u32) {
    types := &(*db).types
    sorted := Vec(u32).new()
    states := Vec(u8).new()

     total_types := (&(*types)).len()
    i: u32 = 0
    while i < total_types {
        states.push(0 as u8)
        i = i + 1
    }

    q_i: u64 = 0
    while q_i < (*type_queue).len {
        ty_id := type_queue.get(q_i)
        topo_dfs(db, types, &sorted, &states, ty_id)
        q_i = q_i + 1
    }

    states.destroy()
    sorted
}

import Nexus from "./nexus/nexus"
import TypeStorage, ty_kind from "./types"
import VecU32 from "std/vec/u32"
import fall from "std/sys"

print :: fn(s &u8) unit

import VecU8 from "std/vec/u8"

topo_dfs :: fn(db &Nexus, types &TypeStorage, sorted &VecU32, states &VecU8, ty_id u32) {
    if (ty_id as u64) >= (*states).len { ret }
    st := states.get(ty_id as u64)
    if st == (1 as u8) {
        print(c"\n[type error] recursive value type has infinite size: '")
        (&(*types)).print_type(ty_id)
        print(c"'; use a pointer for the recursive field\n")
        if (&(*types)).kind(ty_id) == ty_kind().nominal {
            origin := (&(*types)).nominal_origin(ty_id)
            node := origin
            if (origin & 2147483648) != 0 {
                node = (&(*types)).get_nominal_struct_node(origin)
            }
            print(c"       --> ")
            db.print_loc(node)
            print(c"\n")
        }
        fall()
    }
    if st != (0 as u8) { ret }

    states.set(ty_id as u64, 1 as u8) 

    k := ty_kind()
      kind := (&(*types)).kind( ty_id)

    if (kind == k.struct_) or (kind == k.nominal) {
          fields := (&(*types)).get_struct_fields( ty_id)
        count := fields.len / 2
        i: u64 = 0
        while i < count {
            f_ty := *(fields.ptr + (i * 2) + 1)
              f_kind := (&(*types)).kind( f_ty)
            if (f_kind == k.struct_) or (f_kind == k.nominal) or (f_kind == k.array) or (f_kind == k.func) or (f_kind == k.union_) or (f_kind == k.enum_) {
                topo_dfs(db, types, sorted, states, f_ty)
            }
            i = i + 1
        }
    } else if kind == k.array {
        inner_ty := (&(*types)).get_array_type(ty_id)
        inner_kind := (&(*types)).kind(inner_ty)
        if (inner_kind == k.struct_) or (inner_kind == k.nominal) or (inner_kind == k.array) or (inner_kind == k.func) or (inner_kind == k.union_) or (inner_kind == k.enum_) {
            topo_dfs(db, types, sorted, states, inner_ty)
        }
    } else if kind == k.func {
        ret_ty := (&(*types)).func_return(ty_id)
        ret_kind := (&(*types)).kind(ret_ty)
        if (ret_kind == k.struct_) or (ret_kind == k.nominal) or (ret_kind == k.func) or (ret_kind == k.array) or (ret_kind == k.union_) or (ret_kind == k.enum_) {
            topo_dfs(db, types, sorted, states, ret_ty)
        }
        params := (&(*types)).func_params(ty_id)
        i: u64 = 0
        while i < params.len {
            p_ty := *(params.ptr + i)
            p_kind := (&(*types)).kind(p_ty)
            if (p_kind == k.struct_) or (p_kind == k.nominal) or (p_kind == k.func) or (p_kind == k.array) or (p_kind == k.union_) or (p_kind == k.enum_) {
                topo_dfs(db, types, sorted, states, p_ty)
            }
            i = i + 1
        }
    } else if kind == k.union_ {
        members := (&(*types)).union_members(ty_id)
        i: u64 = 0
        while i < members.len {
            m_ty := *(members.ptr + i)
            m_kind := (&(*types)).kind(m_ty)
            if (m_kind == k.struct_) or (m_kind == k.nominal) or (m_kind == k.func) or (m_kind == k.array) or (m_kind == k.union_) or (m_kind == k.enum_) {
                topo_dfs(db, types, sorted, states, m_ty)
            }
            i = i + 1
        }
    } else if kind == k.enum_ {
        b_ty := (&(*types)).enum_backing(ty_id)
        b_kind := (&(*types)).kind(b_ty)
        if (b_kind == k.struct_) or (b_kind == k.nominal) or (b_kind == k.func) or (b_kind == k.array) or (b_kind == k.union_) or (b_kind == k.enum_) {
            topo_dfs(db, types, sorted, states, b_ty)
        }
    }

    sorted.push(ty_id)
    states.set(ty_id as u64, 2 as u8)
}

topo_sort :: fn(db &Nexus, type_queue &VecU32) VecU32 {
    types := &(*db).types
    sorted := VecU32.new()
    states := VecU8.new()

     total_types := (&(*types)).len()
    i: u32 = 0
    while i < total_types {
        states.push(0 as u8)
        i = i + 1
    }

    q_i: u64 = 0
    while q_i < (*type_queue).len {
        ty_id := type_queue.get(q_i)
        topo_dfs(db, types, &sorted, &states, ty_id)
        q_i = q_i + 1
    }

    states.destroy()
    sorted
}

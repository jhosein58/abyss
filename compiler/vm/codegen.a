import core.target:   target_ptr_bits
import std.allocator: Arena
import std.mem:       mem_set
import std.string:    Str, String

import compiler.hir:   HirExprKind, hir_kind, hir_none
import compiler.lexer: decode_char_lit
import compiler.types: TyKind, TypeStorage, ty_id_none

import .chunk: Chunk
import .ffi:   append_ffi_signature
import .op:    OpCode

malloc :: extern fn(size u64) &u8

vm_entry_tag :: fn() u64 { (1 as u64) << 63 }
vm_extern_tag :: fn() u64 { (1 as u64) << 62 }

VmValKind :: enum u8 {
    none
    stack
    local
    global
    data
    data_ref
    const_int
    ptr
    list
    deref
    member_local
    member_deref
    ffi_field
}

VmVal :: struct {
    kind      VmValKind
    elem_size u16
    id        u32
    raw       u64
    empty :: fn() Self {
        .{ kind: VmValKind.none, elem_size: 0, id: 0, raw: 0 }
    }

    stack :: fn() Self {
        .{ kind: VmValKind.stack, elem_size: 0, id: 0, raw: 0 }
    }

    local :: fn(slot u32) Self {
        .{ kind: VmValKind.local, elem_size: 0, id: slot, raw: 0 }
    }

    global :: fn(sym u32) Self {
        .{ kind: VmValKind.global, elem_size: 0, id: sym, raw: 0 }
    }

    const_int :: fn(val u64) Self {
        .{ kind: VmValKind.const_int, elem_size: 0, id: 0, raw: val }
    }

    ptr :: fn(addr u64) Self {
        .{ kind: VmValKind.ptr, elem_size: 0, id: 0, raw: addr }
    }

    list :: fn(count u32) Self {
        .{ kind: VmValKind.list, elem_size: 0, id: count, raw: 0 }
    }
}

VmLoopScope :: struct {
    loop_start_ip   u32
    prev_loop_start u32
    id              u32
    break_mark      u32
    iterator        bool
}

VmCodeBuilder :: struct {
    cg &VmCodeGen
    new :: fn(cg &VmCodeGen) Self {
        .{ cg: cg }
    }

    new_list :: fn(self &Self, arena &Arena) Vec(VmVal) {
        Vec(VmVal).new()
    }

    append_list_item :: fn(self &Self, list &Vec(VmVal), value VmVal, first bool) {
        if value.kind != VmValKind.none {
            self.cg.ensure_on_stack(value)
        }
        list.push(value)
    }

    finish_list :: fn(self &Self, list &Vec(VmVal)) VmVal {
        count := list.len as u32
        list.destroy()
        VmVal.list(count)
    }
}

VmCodeGen :: struct {
    arena               &Arena
    chunk               Chunk
    main_sym            u32
    main_entry          u32
    current_fn          u32
    current_fn_ret_type u32
    local_count         u32
    current_loop_start  u32
    data_cells          HashMap(u32, u64)
    globals_entry       u32
    types               &TypeStorage
    local_types         Vec(u32)
    init_field_ids      Vec(u32)
    local_syms          Vec(u32)
    fn_syms             Vec(u32)
    fn_ips              Vec(u32)
    call_fixups_ip      Vec(u32)
    call_fixups_sym     Vec(u32)
    if_patches          Vec(u32)
    loop_breaks         Vec(u32)
    field_ids           Vec(u32)
    field_offsets       Vec(u32)
    ffi_signatures      HashMap(u32, u16)
    fn_ptr_fixups_idx   Vec(u32)
    fn_ptr_fixups_sym   Vec(u32)
    new :: fn(arena &Arena) Self {
        .{
            arena: arena
            chunk: Chunk.new()
            main_sym: 0
            main_entry: 0
            current_fn: 0
            current_fn_ret_type: 0
            local_count: 0
            current_loop_start: 0
            data_cells: HashMap(u32, u64).new()
            globals_entry: hir_none()
            types: 0 as &TypeStorage
            local_types: Vec(u32).new()
            init_field_ids: Vec(u32).new()
            local_syms: Vec(u32).new()
            fn_syms: Vec(u32).new()
            fn_ips: Vec(u32).new()
            call_fixups_ip: Vec(u32).new()
            call_fixups_sym: Vec(u32).new()
            if_patches: Vec(u32).new()
            loop_breaks: Vec(u32).new()
            field_ids: Vec(u32).new()
            field_offsets: Vec(u32).new()
            ffi_signatures: HashMap(u32, u16).new()
            fn_ptr_fixups_idx: Vec(u32).new()
            fn_ptr_fixups_sym: Vec(u32).new()
        }
    }

    destroy :: fn(self &Self) {
        self.chunk.destroy()
        self.data_cells.destroy()
        self.local_types.destroy()
        self.init_field_ids.destroy()
        self.local_syms.destroy()
        self.fn_syms.destroy()
        self.fn_ips.destroy()
        self.call_fixups_ip.destroy()
        self.call_fixups_sym.destroy()
        self.if_patches.destroy()
        self.loop_breaks.destroy()
        self.field_ids.destroy()
        self.field_offsets.destroy()
        self.ffi_signatures.destroy()
        self.fn_ptr_fixups_idx.destroy()
        self.fn_ptr_fixups_sym.destroy()
    }

    empty_value :: fn(self &Self) VmVal {
        VmVal.empty()
    }

    is_vm :: fn(self &Self) bool {
        true
    }

    has_value :: fn(self &Self, val VmVal) bool {
        val.kind != VmValKind.none
    }

    abyss_main :: fn(self &Self, sym_id u32) {
        self.main_sym = sym_id
    }

    set_field_offset :: fn(self &Self, id u32, offset u32) {
        i: u64 = 0
        while i < self.field_ids.len {
            if self.field_ids.get(i) == id {
                self.field_offsets.set(i, offset)
                ret
            }
            i = i + 1
        }
        self.field_ids.push(id)
        self.field_offsets.push(offset)
    }

    get_field_offset :: fn(self &Self, id u32) u32 {
        i: u64 = 0
        while i < self.field_ids.len {
            if self.field_ids.get(i) == id {
                ret self.field_offsets.get(i)
            }
            i = i + 1
        }
        0
    }

    unwrap_base_type :: fn(self &Self, ty u32) u32 {
        t := ty
        while true {
            k := self.types.kind(t)
            if k == TyKind.nominal {
                t = self.types.nominal_base(t)
            } else if k == TyKind.ptr {
                t = self.types.payload(t)
            } else {
                break
            }
        }
        t
    }

    find_struct_field_offset :: fn(self &Self, struct_ty u32, field_id u32) u32 {
        if (self.types == (0 as &TypeStorage)) or (struct_ty == 0) {
            ret self.get_field_offset(field_id)
        }
        ty := self.unwrap_base_type(struct_ty)
        if self.types.kind(ty) != TyKind.struct_ {
            ret self.get_field_offset(field_id)
        }
        fields := self.types.get_struct_fields(ty)
        count := fields.len / 2
        if self.types.struct_is_extern(ty) {
            offset: u64 = 0
            i: u64 = 0
            while i < count {
                f_name := *(fields.ptr + (i * 2))
                f_ty := *(fields.ptr + (i * 2) + 1)
                a := type_align(self.types, f_ty)
                if a > 0 {
                    offset = (offset + a - 1) & ~(a - 1)
                }
                if f_name == field_id {
                    ret offset as u32
                }
                offset = offset + type_size(self.types, f_ty)
                i = i + 1
            }
        } else {
            i: u64 = 0
            while i < count {
                if *(fields.ptr + (i * 2)) == field_id {
                    ret (i * 8) as u32
                }
                i = i + 1
            }
        }
        self.get_field_offset(field_id)
    }

    set_local_type :: fn(self &Self, slot u32, ty_id u32) {
        while self.local_types.len <= (slot as u64) {
            self.local_types.push(0)
        }
        self.local_types.set(slot as u64, ty_id)
    }

    get_local_type :: fn(self &Self, slot u32) u32 {
        if (slot as u64) < self.local_types.len {
            ret self.local_types.get(slot as u64)
        }
        0
    }

    find_struct_field_elem_size :: fn(self &Self, struct_ty u32, field_id u32) u16 {
        if (self.types == (0 as &TypeStorage)) or (struct_ty == 0) {
            ret 0
        }
        ty := self.unwrap_base_type(struct_ty)
        if self.types.kind(ty) != TyKind.struct_ {
            ret 0
        }
        fields := self.types.get_struct_fields(ty)
        count := fields.len / 2
        i: u64 = 0
        while i < count {
            if *(fields.ptr + (i * 2)) == field_id {
                t_f := *(fields.ptr + (i * 2) + 1)
                while self.types.kind(t_f) == TyKind.nominal {
                    t_f = self.types.nominal_base(t_f)
                }
                if self.types.kind(t_f) == TyKind.ptr {
                    pointee := self.types.payload(t_f)
                    if self.is_struct_type(pointee) {
                        ret 8
                    }
                    ret vm_element_size(self.types, pointee) as u16
                }
                ret 0
            }
            i = i + 1
        }
        0
    }

    find_struct_field_type :: fn(self &Self, ty u32, field_id u32) u32 {
        for field in self.types.get_struct_fields(ty).chunks(2) {
            if field.get(0) == field_id {
                ret self.unwrap_nominal(field.get(1))
            }
        }
        ty_id_none()
    }

    emit_offset :: fn(self &Self, offset u64) {
        if offset != 0 {
            self.chunk.inst(OpCode.push_const)
            self.chunk.emit_u16(self.chunk.alloc_const(offset))
            self.chunk.inst(OpCode.add)
        }
    }

    emit_load :: fn(self &Self, size u64) {
        self.chunk.inst(
            if size == 1 {
                OpCode.load8
            } else if size == 2 {
                OpCode.load16
            } else if size == 4 {
                OpCode.load32
            } else {
                OpCode.load64
            }
        )
    }

    emit_store :: fn(self &Self, size u64) {
        self.chunk.inst(
            if size == 1 {
                OpCode.store8
            } else if size == 2 {
                OpCode.store16
            } else if size == 4 {
                OpCode.store32
            } else {
                OpCode.store64
            }
        )
    }

    emit_alloc_ffi :: fn(self &Self, size u64) {
        self.chunk.inst(OpCode.push_const)
        self.chunk.emit_u16(self.chunk.alloc_const(if size == 0 { 1 } else { size }))
        self.chunk.inst(OpCode.alloc_ffi)
    }

    emit_copy_ffi :: fn(self &Self, size u64) {
        self.chunk.inst(OpCode.copy_ffi)
        self.chunk.emit_u16(self.chunk.alloc_const(size))
    }

    prepare_ffi_store :: fn(self &Self, ty u32) {
        if self.types.kind(ty) == TyKind.func {
            self.chunk.inst(OpCode.ffi_callback)
            self.chunk.emit_u16(self.ffi_signature(ty))
        }
    }

    emit_ffi_store :: fn(self &Self, ty u32) {
        size := type_size(self.types, ty)
        if self.is_struct_type(ty) {
            self.emit_copy_ffi(size)
        } else {
            self.emit_store(size)
        }
    }

    get_local_pointee_type :: fn(self &Self, slot u32) u32 {
        ty := self.get_local_type(slot)
        if (self.types != (0 as &TypeStorage)) and (ty != 0) {
            t := ty
            while self.types.kind(t) == TyKind.nominal {
                t = self.types.nominal_base(t)
            }
            if self.types.kind(t) == TyKind.ptr {
                ret self.types.payload(t)
            }
        }
        0
    }

    get_local_elem_size :: fn(self &Self, slot u32) u16 {
        pointee := self.get_local_pointee_type(slot)
        if pointee != 0 {
            if self.is_struct_type(pointee) {
                ret 8
            }
            ret vm_element_size(self.types, pointee) as u16
        }
        0
    }

    find_local :: fn(self &Self, sym_id u32) u32 {
        i: u64 = 0
        while i < self.local_syms.len {
            if self.local_syms.get(i) == sym_id {
                ret self.local_syms.get(i + 1)
            }
            i = i + 2
        }
        4294967295
    }

    alloc_local :: fn(self &Self, sym_id u32) u32 {
        existing := self.find_local(sym_id)
        if existing != 4294967295 {
            ret existing
        }
        slot := self.local_count
        self.local_count = self.local_count + 1
        self.local_syms.push(sym_id)
        self.local_syms.push(slot)
        slot
    }

    alloc_temp :: fn(self &Self) u32 {
        slot := self.local_count
        self.local_count = self.local_count + 1
        slot
    }

    alloc_heap_temp :: fn(self &Self, size u64) u32 {
        slot := self.alloc_temp()
        c_sz := self.chunk.alloc_const(size)
        self.chunk.inst(OpCode.push_const)
        self.chunk.emit_u16(c_sz)
        self.chunk.inst(OpCode.call_extern)
        self.chunk.emit_u16(6)
        self.chunk.emit_u8(1)
        self.chunk.inst(OpCode.store_local)
        self.chunk.emit_u16(slot as u16)
        slot
    }

    emit_memcpy :: fn(self &Self, dst_slot u32, src_slot u32, size u64) {
        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(dst_slot as u16)
        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(src_slot as u16)
        c_sz := self.chunk.alloc_const(size)
        self.chunk.inst(OpCode.push_const)
        self.chunk.emit_u16(c_sz)
        self.chunk.inst(OpCode.call_extern)
        self.chunk.emit_u16(8)
        self.chunk.emit_u8(3)
        self.chunk.inst(OpCode.pop)
    }

    intrinsic_memcpy :: fn(self &Self, arena &Arena, args VmVal) VmVal {
        self.chunk.inst(OpCode.call_extern)
        self.chunk.emit_u16(8)
        self.chunk.emit_u8(3)
        VmVal.stack()
    }

    intrinsic_trap :: fn(self &Self) VmVal {
        self.chunk.inst(OpCode.call_extern)
        self.chunk.emit_u16(29)
        self.chunk.emit_u8(0)
        VmVal.stack()
    }

    ensure_on_stack :: fn(self &Self, val VmVal) {
        if val.kind == VmValKind.stack {
            ret
        }
        if val.kind == VmValKind.const_int {
            if val.raw == 0 {
                self.chunk.inst(OpCode.push_0)
            } else if val.raw == 1 {
                self.chunk.inst(OpCode.push_1)
            } else {
                c_idx := self.chunk.alloc_const(val.raw)
                self.chunk.inst(OpCode.push_const)
                self.chunk.emit_u16(c_idx)
            }
            ret
        }
        if val.kind == VmValKind.local {
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(val.id as u16)
            ret
        }
        if val.kind == VmValKind.data or val.kind == VmValKind.data_ref {
            ty := self.data_type(val)
            self.emit_data_address(val)
            if vm_is_aggregate(self.types, ty) {
                self.chunk.inst(OpCode.push_0)
                self.emit_copy_data(ty)
            } else {
                self.emit_load(type_size(self.types, ty))
                k := self.types.kind(ty)
                if k == TyKind.int {
                    self.emit_integer_cast(ty)
                } else if k == TyKind.enum_ {
                    self.emit_integer_cast(self.types.enum_backing(ty))
                }
            }
            ret
        }
        if val.kind == VmValKind.ptr {
            c_idx := self.chunk.alloc_const(val.raw)
            self.chunk.inst(OpCode.push_const)
            self.chunk.emit_u16(c_idx)
            self.chunk.inst(OpCode.load64)
            ret
        }
        if val.kind == VmValKind.global {
            if val.id >= 1000000 {
                foreign := val.id - 1000000
                if foreign >= 100 {
                    self.chunk.inst(OpCode.ffi_symbol)
                    self.chunk.emit_u16((foreign - 100) as u16)
                } else {
                    self.ensure_on_stack(VmVal.const_int(vm_extern_tag() | (foreign as u64)))
                }
                ret
            }
            c_idx := self.chunk.alloc_const(0)
            self.fn_ptr_fixups_idx.push(c_idx as u32)
            self.fn_ptr_fixups_sym.push(val.id)
            self.chunk.inst(OpCode.push_const)
            self.chunk.emit_u16(c_idx)
            ret
        }
        if val.kind == VmValKind.ffi_field {
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(val.id as u16)
            ty := val.raw as u32
            if not self.is_struct_type(ty) {
                self.emit_load(type_size(self.types, ty))
                kind := self.types.kind(ty)
                if kind == TyKind.int {
                    self.emit_integer_cast(ty)
                } else if kind == TyKind.enum_ {
                    self.emit_integer_cast(self.types.enum_backing(ty))
                }
            }
            ret
        }
        if val.kind == VmValKind.deref {
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(val.id as u16)
            if val.elem_size == 1 {
                self.chunk.inst(OpCode.load8)
            } else if val.elem_size == 2 {
                self.chunk.inst(OpCode.load16)
            } else if val.elem_size == 4 {
                self.chunk.inst(OpCode.load32)
            } else {
                self.chunk.inst(OpCode.load64)
            }
            ret
        }
        if (val.kind == VmValKind.member_local) or (val.kind == VmValKind.member_deref) {
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(val.id as u16)
            if val.raw > 0 {
                c_idx := self.chunk.alloc_const(val.raw)
                self.chunk.inst(OpCode.push_const)
                self.chunk.emit_u16(c_idx)
                self.chunk.inst(OpCode.add)
            }
            self.chunk.inst(OpCode.load64)
            ret
        }
    }

    get_fn_entry :: fn(self &Self, sym_id u32) u32 {
        i: u64 = 0
        while i < self.fn_syms.len {
            if self.fn_syms.get(i) == sym_id {
                ret self.fn_ips.get(i)
            }
            i = i + 1
        }
        0
    }

    register_fn_entry :: fn(self &Self, sym_id u32, ip u32) {
        self.fn_syms.push(sym_id)
        self.fn_ips.push(ip)
    }

    finish_linking :: fn(self &Self) {
        i: u64 = 0
        while i < self.call_fixups_ip.len {
            patch_offset := self.call_fixups_ip.get(i)
            target_sym := self.call_fixups_sym.get(i)
            entry_ip := self.get_fn_entry(target_sym)
            self.chunk.patch_u32(patch_offset, entry_ip)
            i = i + 1
        }
        j: u64 = 0
        while j < self.fn_ptr_fixups_idx.len {
            idx := self.fn_ptr_fixups_idx.get(j)
            target_sym := self.fn_ptr_fixups_sym.get(j)
            entry_ip := self.get_fn_entry(target_sym)
            self.chunk.const.set(idx as u64, vm_entry_tag() | (entry_ip as u64))
            j = j + 1
        }
        self.main_entry = self.get_fn_entry(self.main_sym)
        self.call_fixups_ip.clear()
        self.call_fixups_sym.clear()
        self.fn_ptr_fixups_idx.clear()
        self.fn_ptr_fixups_sym.clear()
    }

    start_function :: fn(self &Self, fn_name VmVal, ret_type VmVal, params VmVal, exported bool) {
        self.current_fn = fn_name.id
        self.current_fn_ret_type = ret_type.raw as u32
        entry_ip := self.chunk.buf.len as u32
        self.register_fn_entry(fn_name.id, entry_ip)
        for index in Range.new(0, self.local_types.len as i32) {
            slot := index as u16
            ty := self.get_local_type(slot as u32)
            if self.types.struct_is_extern(ty) {
                size := self.struct_alloc_size(ty)
                self.chunk.inst(OpCode.load_local)
                self.chunk.emit_u16(slot)
                self.emit_alloc_ffi(size)
                self.chunk.inst(OpCode.dup)
                self.chunk.inst(OpCode.store_local)
                self.chunk.emit_u16(slot)
                self.emit_copy_ffi(size)
            }
        }
    }

    end_function :: fn(self &Self) {
        self.chunk.inst(OpCode.push_0)
        self.chunk.inst(OpCode.ret_val)
        self.local_syms.clear()
        self.local_count = 0
        self.local_types.clear()
        self.current_fn_ret_type = 0
    }

    reset_locals :: fn(self &Self) {
        self.local_syms.clear()
        self.local_count = 0
        self.local_types.clear()
    }

    declare_function :: fn(self &Self, fn_name VmVal, ret_type VmVal, params VmVal) {}

    declare_foreign :: fn(
        self &Self
        fn_name VmVal
        ret_type VmVal
        params VmVal
        module Str
        name Str
    ) {}
    begin_inline_scope :: fn(self &Self) {}
    end_inline_scope :: fn(self &Self) {}

    zero_global :: fn(self &Self, ty u32) &u8 {
        size := vm_data_size(self.types, ty)
        storage := self.arena.alloc(if size == 0 { 8 } else { size })
        mem_set(storage, 0, size)
        base := self.unwrap_nominal(ty)
        kind := self.types.kind(base)
        if kind == TyKind.struct_ and not self.types.struct_is_extern(base) {
            fields := self.types.get_struct_fields(base)
            i: u64 = 0
            while i < fields.len / 2 {
                field_ty := fields.ptr[i * 2 + 1]
                if vm_is_aggregate(self.types, field_ty) {
                    (storage as &u64)[i] = self.zero_global(field_ty) as u64
                }
                i = i + 1
            }
        } else if kind == TyKind.array {
            elem := self.types.get_array_type(base)
            if vm_is_indirect(self.types, elem) {
                for i in Range.new(0, self.types.get_array_len(base) as i32) {
                    (storage as &u64)[i] = self.zero_global(elem) as u64
                }
            }
        } else if kind == TyKind.union_ {
            member := self.types.union_members(base).ptr[0]
            if vm_is_aggregate(self.types, member) {
                (storage as &u64)[1] = self.zero_global(member) as u64
            }
        }
        storage
    }

    data_type :: fn(self &Self, value VmVal) u32 {
        if value.kind == VmValKind.data {
            ret value.id
        }
        value.raw as u32
    }

    emit_data_address :: fn(self &Self, value VmVal) {
        if value.kind == VmValKind.data {
            self.ensure_on_stack(VmVal.const_int(value.raw))
        } else {
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(value.id as u16)
        }
    }

    capture_data_ref :: fn(self &Self, ty u32) VmVal {
        slot := self.alloc_temp()
        self.chunk.inst(OpCode.store_local)
        self.chunk.emit_u16(slot as u16)
        .{ kind: VmValKind.data_ref, elem_size: 0, id: slot, raw: ty as u64 }
    }

    emit_copy_data :: fn(self &Self, ty u32) {
        self.chunk.inst(OpCode.copy_data)
        self.chunk.emit_u32(ty)
    }

    global_ref :: fn(self &Self, arena &Arena, sym u32, ty u32) VmVal {
        .{ kind: VmValKind.data, elem_size: 0, id: ty, raw: *self.data_cells.get(sym) }
    }

    declare_global :: fn(self &Self, sym u32, ty u32, name VmVal, type_name VmVal) {
        self.data_cells.insert(sym, self.zero_global(ty) as u64)
    }

    begin_globals :: fn(self &Self) {
        self.reset_locals()
        self.globals_entry = self.chunk.buf.len as u32
    }

    initialize_global :: fn(self &Self, name VmVal, ty VmVal, value VmVal) {
        self.expr(self.expr_assign(self.arena, name, value))
    }

    end_globals :: fn(self &Self) {
        self.end_function()
    }

    create_variable :: fn(self &Self, name VmVal, ty VmVal, init_val VmVal, has_init bool) {
        slot := name.id
        if name.kind != VmValKind.local {
            slot = self.alloc_local(name.id)
        }
        self.set_local_type(slot, ty.raw as u32)
        if self.types.struct_is_extern(ty.raw as u32) {
            size := self.struct_alloc_size(ty.raw as u32)
            if has_init {
                self.ensure_on_stack(init_val)
            }
            self.emit_alloc_ffi(size)
            if has_init {
                self.chunk.inst(OpCode.dup)
            }
            self.chunk.inst(OpCode.store_local)
            self.chunk.emit_u16(slot as u16)
            if has_init {
                self.emit_copy_ffi(size)
            }
            ret
        }
        if has_init and (init_val.kind != VmValKind.none) {
            self.ensure_on_stack(init_val)
            self.chunk.inst(OpCode.store_local)
            self.chunk.emit_u16(slot as u16)
        } else {
            allocation_size: u64 = 0
            ty_id := ty.raw as u32
            if (self.types != (0 as &TypeStorage)) and (ty_id != 0) {
                t := self.unwrap_nominal(ty_id)
                if self.types.kind(t) == TyKind.struct_ {
                    allocation_size = self.struct_alloc_size(ty_id)
                } else if self.types.kind(t) == TyKind.array {
                    allocation_size = vm_element_size(self.types, self.types.get_array_type(t)) *
                        (self.types.get_array_len(t) as u64)
                }
            }
            if allocation_size > 0 {
                c_sz := self.chunk.alloc_const(allocation_size)
                self.chunk.inst(OpCode.push_const)
                self.chunk.emit_u16(c_sz)
                self.chunk.inst(OpCode.call_extern)
                self.chunk.emit_u16(6)
                self.chunk.emit_u8(1)
            } else {
                self.chunk.inst(OpCode.push_0)
            }
            self.chunk.inst(OpCode.store_local)
            self.chunk.emit_u16(slot as u16)
        }
    }

    new_temp :: fn(self &Self, arena &Arena, ty VmVal) VmVal {
        slot := self.alloc_temp()
        self.set_local_type(slot, ty.raw as u32)
        if self.types.struct_is_extern(ty.raw as u32) {
            self.emit_alloc_ffi(self.struct_alloc_size(ty.raw as u32))
        } else {
            self.chunk.inst(OpCode.push_0)
        }
        self.chunk.inst(OpCode.store_local)
        self.chunk.emit_u16(slot as u16)
        VmVal.local(slot)
    }

    expr :: fn(self &Self, e VmVal) {
        if e.kind == VmValKind.stack {
            self.chunk.inst(OpCode.pop)
        }
    }

    gen_return :: fn(self &Self, val VmVal, has_val bool) {
        if has_val and (val.kind != VmValKind.none) {
            self.ensure_on_stack(val)
        } else {
            self.chunk.inst(OpCode.push_0)
        }
        self.chunk.inst(OpCode.ret_val)
    }

    start_if :: fn(self &Self, cond VmVal) {
        self.ensure_on_stack(cond)
        self.chunk.inst(OpCode.jmp_if_false)
        patch_offset := self.chunk.buf.len as u32
        self.chunk.emit_u32(0)
        self.if_patches.push(patch_offset)
    }

    else_ :: fn(self &Self) {
        self.chunk.inst(OpCode.jmp)
        else_jump := self.chunk.buf.len as u32
        self.chunk.emit_u32(0)

        cond_jump := self.if_patches.pop()
        self.chunk.patch_u32(cond_jump, self.chunk.buf.len as u32)
        self.if_patches.push(else_jump)
    }

    end_block :: fn(self &Self) {
        if self.if_patches.len > 0 {
            jump := self.if_patches.pop()
            self.chunk.patch_u32(jump, self.chunk.buf.len as u32)
        }
    }

    begin_loop :: fn(self &Self, id u32) VmLoopScope {
        .{
            loop_start_ip: 0
            prev_loop_start: self.current_loop_start
            id: id
            break_mark: self.loop_breaks.len as u32
            iterator: false
        }
    }

    start_loop :: fn(self &Self, arena &Arena, scope &VmLoopScope) {
        scope.loop_start_ip = self.chunk.buf.len as u32
        self.current_loop_start = scope.loop_start_ip
    }

    start_iterator_loop :: fn(self &Self, arena &Arena, scope &VmLoopScope) {
        self.start_loop(arena, scope)
    }

    end_loop :: fn(self &Self, arena &Arena, scope &VmLoopScope) {
        self.chunk.inst(OpCode.jmp)
        self.chunk.emit_u32(scope.loop_start_ip)
        current_ip := self.chunk.buf.len as u32
        i: u64 = scope.break_mark as u64
        while i < self.loop_breaks.len {
            self.chunk.patch_u32(self.loop_breaks.get(i), current_ip)
            i = i + 1
        }
        self.loop_breaks.reset(scope.break_mark as u64)
        self.current_loop_start = scope.prev_loop_start
    }

    emit_break :: fn(self &Self, arena &Arena) {
        self.chunk.inst(OpCode.jmp)
        self.loop_breaks.push(self.chunk.buf.len as u32)
        self.chunk.emit_u32(0)
    }

    emit_cont :: fn(self &Self, arena &Arena) {
        self.chunk.inst(OpCode.jmp)
        self.chunk.emit_u32(self.current_loop_start)
    }

    break_statement :: fn(self &Self) {
        self.emit_break(0 as &Arena)
    }

    type_str :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) VmVal {
        VmVal.const_int(ty_id as u64)
    }

    sym_name :: fn(self &Self, arena &Arena, sym_id u32) VmVal {
        slot := self.find_local(sym_id)
        if slot != 4294967295 {
            ret VmVal.local(slot)
        }
        VmVal.global(sym_id)
    }

    ffi_signature :: fn(self &Self, ty u32) u16 {
        cached := self.ffi_signatures.get(ty)
        if cached != (0 as &u16) {
            ret *cached
        }
        ptr := 0 as &u32
        if ty != ty_id_none() and self.types.kind(ty) == TyKind.func {
            signature := Vec(u32).new()
            append_ffi_signature(self.types, &signature, ty)
            ptr = self.arena.alloc(signature.len * 4) as &u32
            for i in Range.new(0, signature.len as i32) {
                *(ptr + i) = signature.get(i as u64)
            }
            signature.destroy()
        }
        index := self.chunk.alloc_const(ptr as u64)
        self.ffi_signatures.insert(ty, index)
        index
    }

    extern_name :: fn(self &Self, name Str, ty u32) VmVal {
        ext_id: u32 = 0
        if name.eq("malloc") {
            ext_id = 6
        } else if name.eq("free") {
            ext_id = 7
        } else if name.eq("realloc") {
            ext_id = 16
        } else if name.eq("abyss_process_arg_count") {
            ext_id = 25
        } else if name.eq("abyss_process_arg") {
            ext_id = 26
        } else {
            buf := self.arena.alloc(name.len + 1)
            i: u64 = 0
            while i < name.len {
                *(buf + i) = *(name.ptr + i)
                i = i + 1
            }
            *(buf + name.len) = 0 as u8
            sig := self.chunk.const.get(self.ffi_signature(ty) as u64) as &u32
            ext_id = 100 + self.chunk.add_extern(buf, sig)
        }

        VmVal.global(1000000 + ext_id)
    }

    empty_parameters :: fn(self &Self) VmVal {
        VmVal.empty()
    }

    parameter_name :: fn(self &Self, arena &Arena, index u32) VmVal {
        VmVal.local(index)
    }

    parameter :: fn(self &Self, arena &Arena, ty VmVal, name VmVal) VmVal {
        slot := if name.kind == VmValKind.local {
            self.alloc_temp()
        } else {
            self.alloc_local(name.id)
        }
        self.set_local_type(slot, ty.raw as u32)
        VmVal.empty()
    }

    expr_reflection :: fn(self &Self, D type, arena &Arena, db &D, ty u32, value u64) VmVal {
        VmVal.const_int(value)
    }

    expr_int :: fn(self &Self, arena &Arena, val u32) VmVal {
        VmVal.const_int(val as u64)
    }

    expr_u64 :: fn(self &Self, arena &Arena, val u64) VmVal {
        VmVal.const_int(val)
    }

    emit_integer_cast :: fn(self &Self, ty u32) {
        width := self.types.payload(ty)
        if (width == 0) or (width >= 64) {
            ret
        }
        self.chunk.inst(OpCode.cast_integer)
        self.chunk.emit_u8(width as u8)
        self.chunk.emit_u8(
            if self.types.kind(ty) == TyKind.int {
                1 as u8
            } else {
                0 as u8
            }
        )
    }

    expr_typed_cast :: fn(self &Self, arena &Arena, target VmVal, inner VmVal, source u32) VmVal {
        ty := target.raw as u32
        src_kind := self.types.kind(source)
        dst_kind := self.types.kind(ty)
        src_float := (src_kind == TyKind.float) or (src_kind == TyKind.untyped_float)
        dst_float := dst_kind == TyKind.float
        src_int := (src_kind == TyKind.int) or (src_kind == TyKind.uint) or
            (src_kind == TyKind.untyped_int)
        dst_int := (dst_kind == TyKind.int) or (dst_kind == TyKind.uint)
        if (src_float or src_int) and (dst_float or dst_int) {
            self.ensure_on_stack(inner)
            if src_float {
                width := self.types.payload(source)
                if width == 32 {
                    self.chunk.inst(OpCode.f32_to_f64)
                }
            } else {
                self.emit_integer_cast(source)
            }
            if src_float and dst_int {
                self.chunk.inst(OpCode.f64_to_i64)
            }
            if src_int and dst_float {
                if src_kind == TyKind.uint {
                    self.chunk.inst(OpCode.u64_to_f64)
                } else {
                    self.chunk.inst(OpCode.i64_to_f64)
                }
            }
            if dst_float {
                width := self.types.payload(ty)
                if width == 32 {
                    self.chunk.inst(OpCode.f64_to_f32)
                }
            } else {
                self.emit_integer_cast(ty)
            }
            ret VmVal.stack()
        }
        self.expr_cast(arena, target, inner)
    }

    expr_float_from_int :: fn(self &Self, arena &Arena, val u32, ty_id u32) VmVal {
        if (self.types != (0 as &TypeStorage)) and (ty_id != 0) {
            p := self.types.payload(ty_id)
            if p == 32 {
                f := val as f32
                f_bits: u64 = 0
                *(&f_bits as &f32) = f
                ret .{ kind: VmValKind.const_int, elem_size: 32, id: 0, raw: f_bits }
            }
            if p == 64 {
                d := val as f64
                d_bits := *(&d as &u64)
                ret .{ kind: VmValKind.const_int, elem_size: 64, id: 0, raw: d_bits }
            }
        }
        VmVal.const_int(val as u64)
    }

    expr_typed_float :: fn(self &Self, raw Str, narrow bool) VmVal {
        self.expr_folded_float(self.arena, parse_float(raw), narrow)
    }

    expr_folded_float :: fn(self &Self, arena &Arena, value f64, narrow bool) VmVal {
        if narrow {
            f := value as f32
            bits := *(&f as &u32) as u64
            ret .{ kind: VmValKind.const_int, elem_size: 32, id: 0, raw: bits }
        }
        .{ kind: VmValKind.const_int, elem_size: 64, id: 0, raw: *(&value as &u64) }
    }

    expr_bool :: fn(self &Self, val bool) VmVal {
        VmVal.const_int(
            if val {
                1
            } else {
                0
            }
        )
    }

    expr_char_lit :: fn(self &Self, arena &Arena, raw Str) VmVal {
        VmVal.const_int(decode_char_lit(raw) as u64)
    }

    expr_cstr_lit :: fn(self &Self, arena &Arena, raw Str) VmVal {
        start: u64 = 1
        if *(raw.ptr) == 'c' {
            start = 2
        }
        end := raw.len - 1
        buf_len := end - start + 1
        buf := malloc(buf_len)
        dst: u64 = 0
        src := start
        is_backtick := *(raw.ptr) == 96
        while src < end {
            ch := *(raw.ptr + src)
            if (ch == '\\') and (src + 1 < end) {
                next := *(raw.ptr + src + 1)
                if (next == 96) and is_backtick {
                    *(buf + dst) = 96 as u8
                    src = src + 2
                    dst = dst + 1
                    cont
                } else if not is_backtick {
                    src = src + 1
                    if next == 'n' {
                        *(buf + dst) = 10 as u8
                    } else if next == 't' {
                        *(buf + dst) = 9 as u8
                    } else if next == 'r' {
                        *(buf + dst) = 13 as u8
                    } else if next == '0' {
                        *(buf + dst) = 0 as u8
                    } else {
                        *(buf + dst) = next
                    }
                    dst = dst + 1
                    src = src + 1
                    cont
                }
            }
            *(buf + dst) = ch
            dst = dst + 1
            src = src + 1
        }
        *(buf + dst) = 0 as u8
        .{ kind: VmValKind.const_int, elem_size: 0, id: dst as u32, raw: buf as u64 }
    }

    expr_str_lit :: fn(
        self &Self
        arena &Arena
        struct_name VmVal
        ptr_id u32
        len_id u32
        raw Str
    ) VmVal {
        cstr_val := self.expr_cstr_lit(arena, raw)
        cstr_ptr := cstr_val.raw
        str_len := cstr_val.id as u64

        struct_ty := struct_name.raw as u32
        ptr_offset := self.find_struct_field_offset(struct_ty, ptr_id)
        len_offset := self.find_struct_field_offset(struct_ty, len_id)

        temp_buf := self.alloc_heap_temp(16)

        c_ptr := self.chunk.alloc_const(cstr_ptr)
        self.chunk.inst(OpCode.push_const)
        self.chunk.emit_u16(c_ptr)
        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(temp_buf as u16)
        if ptr_offset > 0 {
            c_poff := self.chunk.alloc_const(ptr_offset as u64)
            self.chunk.inst(OpCode.push_const)
            self.chunk.emit_u16(c_poff)
            self.chunk.inst(OpCode.add)
        }
        self.chunk.inst(OpCode.store64)

        c_len := self.chunk.alloc_const(str_len)
        self.chunk.inst(OpCode.push_const)
        self.chunk.emit_u16(c_len)
        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(temp_buf as u16)
        if len_offset > 0 {
            c_loff := self.chunk.alloc_const(len_offset as u64)
            self.chunk.inst(OpCode.push_const)
            self.chunk.emit_u16(c_loff)
            self.chunk.inst(OpCode.add)
        }
        self.chunk.inst(OpCode.store64)

        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(temp_buf as u16)
        VmVal.stack()
    }

    unwrap_nominal :: fn(self &Self, ty u32) u32 {
        t := ty
        while (t != 0) and (self.types.kind(t) == TyKind.nominal) {
            t = self.types.nominal_base(t)
        }
        t
    }

    is_struct_type :: fn(self &Self, ty_id u32) bool {
        if (self.types == (0 as &TypeStorage)) or (ty_id == 0) {
            ret false
        }
        k := self.types.kind(self.unwrap_nominal(ty_id))
        (k == TyKind.struct_) or (k == TyKind.array)
    }

    struct_alloc_size :: fn(self &Self, ty_id u32) u64 {
        if (self.types == (0 as &TypeStorage)) or (ty_id == 0) {
            ret 8
        }
        t := self.unwrap_nominal(ty_id)
        k := self.types.kind(t)
        if k == TyKind.array {
            ret type_size(self.types, t)
        }
        if k != TyKind.struct_ {
            ret 8
        }
        if self.types.struct_is_extern(t) {
            ret type_size(self.types, t)
        }
        fields := self.types.get_struct_fields(t)
        sz := (fields.len / 2) * 8
        if sz == 0 {
            sz = 8
        }
        sz as u64
    }

    expr_one :: fn(self &Self, arena &Arena) VmVal {
        VmVal.const_int(1)
    }

    expr_assign :: fn(self &Self, arena &Arena, lhs VmVal, rhs VmVal) VmVal {
        self.ensure_on_stack(rhs)
        if lhs.kind == VmValKind.data or lhs.kind == VmValKind.data_ref {
            ty := self.data_type(lhs)
            self.chunk.inst(OpCode.dup)
            self.emit_data_address(lhs)
            if vm_is_aggregate(self.types, ty) {
                self.emit_copy_data(ty)
                self.chunk.inst(OpCode.pop)
            } else {
                self.emit_ffi_store(ty)
            }
            ret VmVal.stack()
        }
        if lhs.kind == VmValKind.ffi_field {
            self.chunk.inst(OpCode.dup)
            ty := lhs.raw as u32
            self.prepare_ffi_store(ty)
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(lhs.id as u16)
            self.emit_ffi_store(ty)
            ret VmVal.stack()
        }
        if lhs.kind == VmValKind.local {
            self.chunk.inst(OpCode.dup)
            ty := self.get_local_type(lhs.id)
            if self.types.struct_is_extern(ty) {
                self.chunk.inst(OpCode.load_local)
                self.chunk.emit_u16(lhs.id as u16)
                self.emit_copy_ffi(self.struct_alloc_size(ty))
                ret VmVal.stack()
            }
            self.chunk.inst(OpCode.store_local)
            self.chunk.emit_u16(lhs.id as u16)
            ret VmVal.stack()
        }
        if lhs.kind == VmValKind.deref {
            self.chunk.inst(OpCode.dup)
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(lhs.id as u16)
            if lhs.elem_size == 1 {
                self.chunk.inst(OpCode.store8)
            } else if lhs.elem_size == 2 {
                self.chunk.inst(OpCode.store16)
            } else if lhs.elem_size == 4 {
                self.chunk.inst(OpCode.store32)
            } else {
                self.chunk.inst(OpCode.store64)
            }
            ret VmVal.stack()
        }
        if (lhs.kind == VmValKind.member_local) or (lhs.kind == VmValKind.member_deref) {
            self.chunk.inst(OpCode.dup)
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(lhs.id as u16)
            if lhs.raw > 0 {
                c_idx := self.chunk.alloc_const(lhs.raw)
                self.chunk.inst(OpCode.push_const)
                self.chunk.emit_u16(c_idx)
                self.chunk.inst(OpCode.add)
            }
            self.chunk.inst(OpCode.store64)
            ret VmVal.stack()
        }
        if lhs.kind == VmValKind.ptr {
            self.chunk.inst(OpCode.dup)
            c_idx := self.chunk.alloc_const(lhs.raw)
            self.chunk.inst(OpCode.push_const)
            self.chunk.emit_u16(c_idx)
            self.chunk.inst(OpCode.store64)
            ret VmVal.stack()
        }
        VmVal.stack()
    }

    expr_binary_kind :: fn(self &Self, arena &Arena, kind HirExprKind, lhs VmVal, rhs VmVal) VmVal {
        elem_sz: u16 = 0
        if lhs.kind == VmValKind.local {
            elem_sz = self.get_local_elem_size(lhs.id)
        } else if lhs.kind == VmValKind.data or lhs.kind == VmValKind.data_ref {
            ty := self.data_type(lhs)
            if self.types.kind(ty) == TyKind.ptr {
                elem_sz = vm_element_size(self.types, self.types.payload(ty)) as u16
            }
        } else if lhs.kind == VmValKind.member_deref {
            elem_sz = lhs.elem_size
        } else if lhs.kind == VmValKind.member_local or lhs.kind == VmValKind.ffi_field {
            elem_sz = lhs.elem_size
        } else if lhs.kind == VmValKind.stack {
            elem_sz = lhs.elem_size
        }
        if (rhs.kind == VmValKind.stack) and (lhs.kind != VmValKind.stack) {
            temp_rhs := self.alloc_temp()
            self.chunk.inst(OpCode.store_local)
            self.chunk.emit_u16(temp_rhs as u16)
            self.ensure_on_stack(lhs)
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(temp_rhs as u16)
        } else {
            self.ensure_on_stack(lhs)
            self.ensure_on_stack(rhs)
        }
        if (kind == hir_kind.binary_add) or (kind == hir_kind.binary_sub) {
            if elem_sz > 1 {
                c_sz := self.chunk.alloc_const(elem_sz as u64)
                self.chunk.inst(OpCode.push_const)
                self.chunk.emit_u16(c_sz)
                self.chunk.inst(OpCode.mul)
                if kind == hir_kind.binary_add {
                    self.chunk.inst(OpCode.add)
                } else {
                    self.chunk.inst(OpCode.sub)
                }
                ret .{ kind: VmValKind.stack, elem_size: elem_sz, id: 0, raw: 0 }
            } else if elem_sz == 1 {
                if kind == hir_kind.binary_add {
                    self.chunk.inst(OpCode.add)
                } else {
                    self.chunk.inst(OpCode.sub)
                }
                ret .{ kind: VmValKind.stack, elem_size: 1, id: 0, raw: 0 }
            }
        }
        k := hir_kind
        if kind == k.binary_add {
            self.chunk.inst(OpCode.add)
        } else if kind == k.binary_sub {
            self.chunk.inst(OpCode.sub)
        } else if kind == k.binary_mul {
            self.chunk.inst(OpCode.mul)
        } else if kind == k.binary_div {
            self.chunk.inst(OpCode.div)
        } else if kind == k.binary_mod {
            self.chunk.inst(OpCode.mod)
        } else if kind == k.binary_eq_eq {
            self.chunk.inst(OpCode.eq)
        } else if kind == k.binary_neq {
            self.chunk.inst(OpCode.ne)
        } else if kind == k.binary_lt {
            self.chunk.inst(OpCode.lt)
        } else if kind == k.binary_lt_eq {
            self.chunk.inst(OpCode.le)
        } else if kind == k.binary_gt {
            self.chunk.inst(OpCode.gt)
        } else if kind == k.binary_gt_eq {
            self.chunk.inst(OpCode.ge)
        } else if kind == k.binary_bit_and {
            self.chunk.inst(OpCode.bit_and)
        } else if kind == k.binary_bit_or {
            self.chunk.inst(OpCode.bit_or)
        } else if kind == k.binary_bit_xor {
            self.chunk.inst(OpCode.bit_xor)
        } else if kind == k.binary_shl {
            self.chunk.inst(OpCode.shl)
        } else if kind == k.binary_shr {
            self.chunk.inst(OpCode.shr)
        } else {
            self.chunk.inst(OpCode.add)
        }
        VmVal.stack()
    }

    expr_typed_binary_kind :: fn(
        self &Self
        arena &Arena
        kind HirExprKind
        lhs VmVal
        rhs VmVal
        ty u32
    ) VmVal {
        start := self.chunk.buf.len
        base := self.unwrap_nominal(ty)
        result := self.expr_binary_kind(arena, kind, lhs, rhs)
        if self.chunk.buf.len <= start {
            ret result
        }
        k := self.types.kind(base)
        if k == TyKind.float or k == TyKind.untyped_float {
            last := (self.chunk.buf.len - 1)
            op := self.chunk.buf.get(last)
            self.chunk.buf.set(last, OpCode.float_binary as u8)
            self.chunk.emit_u8(op)
            self.chunk.emit_u8(self.types.payload(base) as u8)
        } else if k == TyKind.uint {
            op := OpCode.halt
            if kind == hir_kind.binary_div {
                op = OpCode.udiv
            } else if kind == hir_kind.binary_mod {
                op = OpCode.umod
            } else if kind == hir_kind.binary_lt {
                op = OpCode.ult
            } else if kind == hir_kind.binary_lt_eq {
                op = OpCode.ule
            } else if kind == hir_kind.binary_gt {
                op = OpCode.ugt
            } else if kind == hir_kind.binary_gt_eq {
                op = OpCode.uge
            }
            if op != OpCode.halt {
                self.chunk.buf.set(self.chunk.buf.len - 1, op as u8)
            }
        }
        result
    }

    expr_neg :: fn(self &Self, arena &Arena, inner VmVal, ty u32) VmVal {
        base := self.unwrap_nominal(ty)
        kind := self.types.kind(base)
        if kind == TyKind.float or kind == TyKind.untyped_float {
            bit := if self.types.payload(base) == 32 { 31 } else { 63 }
            mask := (1 as u64) << bit
            if inner.kind == VmValKind.const_int {
                ret VmVal.const_int(inner.raw ^ mask)
            }
            ret self.expr_binary_op(inner, VmVal.const_int(mask), OpCode.bit_xor)
        }
        self.expr_unary_op(inner, OpCode.neg)
    }

    expr_unary_op :: fn(self &Self, inner VmVal, op OpCode) VmVal {
        self.ensure_on_stack(inner)
        self.chunk.inst(op)
        VmVal.stack()
    }

    expr_binary_op :: fn(self &Self, lhs VmVal, rhs VmVal, op OpCode) VmVal {
        self.ensure_on_stack(lhs)
        self.ensure_on_stack(rhs)
        self.chunk.inst(op)
        VmVal.stack()
    }

    expr_not :: fn(self &Self, arena &Arena, inner VmVal) VmVal {
        self.expr_unary_op(inner, OpCode.l_not)
    }

    expr_bit_not :: fn(self &Self, arena &Arena, inner VmVal) VmVal {
        self.expr_unary_op(inner, OpCode.bit_not)
    }

    expr_typed_address :: fn(self &Self, arena &Arena, inner VmVal, ty u32) VmVal {
        if inner.kind == VmValKind.data or inner.kind == VmValKind.data_ref {
            ret self.expr_address(arena, inner)
        }
        if self.is_struct_type(ty) {
            self.ensure_on_stack(inner)
            ret VmVal.stack()
        }
        self.expr_address(arena, inner)
    }

    expr_address :: fn(self &Self, arena &Arena, inner VmVal) VmVal {
        if inner.kind == VmValKind.local {
            ty := self.get_local_type(inner.id)
            if self.is_struct_type(ty) {
                self.chunk.inst(OpCode.load_local)
                self.chunk.emit_u16(inner.id as u16)
                ret VmVal.stack()
            }
            self.chunk.inst(OpCode.addr_local)
            self.chunk.emit_u16(inner.id as u16)
            ret VmVal.stack()
        }
        if inner.kind == VmValKind.deref or inner.kind == VmValKind.ffi_field {
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(inner.id as u16)
            ret VmVal.stack()
        }
        if inner.kind == VmValKind.member_local {
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(inner.id as u16)
            if inner.raw > 0 {
                c_idx := self.chunk.alloc_const(inner.raw)
                self.chunk.inst(OpCode.push_const)
                self.chunk.emit_u16(c_idx)
                self.chunk.inst(OpCode.add)
            }
            ret VmVal.stack()
        }
        if inner.kind == VmValKind.data or inner.kind == VmValKind.data_ref {
            self.emit_data_address(inner)
            ret VmVal.stack()
        }
        if inner.kind == VmValKind.ptr {
            ret VmVal.const_int(inner.raw)
        }
        if inner.kind == VmValKind.stack {
            ret inner
        }
        self.ensure_on_stack(inner)
        temp := self.alloc_temp()
        self.chunk.inst(OpCode.store_local)
        self.chunk.emit_u16(temp as u16)
        self.chunk.inst(OpCode.addr_local)
        self.chunk.emit_u16(temp as u16)
        VmVal.stack()
    }

    expr_address_of_value :: fn(self &Self, arena &Arena, ty VmVal, value VmVal) VmVal {
        ty_id := ty.raw as u32
        if self.is_struct_type(ty_id) {
            sz := self.struct_alloc_size(ty_id)
            self.ensure_on_stack(value)
            temp_src := self.alloc_temp()
            self.chunk.inst(OpCode.store_local)
            self.chunk.emit_u16(temp_src as u16)
            temp_dst := self.alloc_heap_temp(sz)
            self.emit_memcpy(temp_dst, temp_src, sz)
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(temp_dst as u16)
            ret VmVal.stack()
        }
        self.expr_address(arena, value)
    }

    expr_typed_deref :: fn(self &Self, arena &Arena, inner VmVal, ty u32) VmVal {
        base := self.unwrap_nominal(ty)
        if self.types.struct_is_extern(base) or not self.is_struct_type(base) {
            self.ensure_on_stack(inner)
            slot := self.alloc_temp()
            self.chunk.inst(OpCode.store_local)
            self.chunk.emit_u16(slot as u16)
            ret .{ kind: VmValKind.ffi_field, elem_size: 0, id: slot, raw: base as u64 }
        }
        if inner.kind == VmValKind.const_int {
            self.ensure_on_stack(inner)
            ret self.capture_data_ref(ty)
        }
        self.expr_deref(arena, inner)
    }

    expr_deref :: fn(self &Self, arena &Arena, inner VmVal) VmVal {
        elem_sz := inner.elem_size
        if inner.kind == VmValKind.local {
            pointee_ty := self.get_local_pointee_type(inner.id)
            if self.is_struct_type(pointee_ty) {
                sz := self.struct_alloc_size(pointee_ty)
                temp_dst := self.alloc_heap_temp(sz)
                self.emit_memcpy(temp_dst, inner.id, sz)
                self.chunk.inst(OpCode.load_local)
                self.chunk.emit_u16(temp_dst as u16)
                ret VmVal.stack()
            }
            if elem_sz == 0 {
                elem_sz = self.get_local_elem_size(inner.id)
            }
            ret .{ kind: VmValKind.deref, elem_size: elem_sz, id: inner.id, raw: 0 }
        }
        self.ensure_on_stack(inner)
        temp := self.alloc_temp()
        self.chunk.inst(OpCode.store_local)
        self.chunk.emit_u16(temp as u16)
        ret .{ kind: VmValKind.deref, elem_size: elem_sz, id: temp, raw: 0 }
    }

    expr_str_deref :: fn(self &Self, arena &Arena, inner VmVal, ptr_id u32) VmVal {
        self.expr_deref(arena, inner)
    }

    expr_cast :: fn(self &Self, arena &Arena, ty_str VmVal, inner VmVal) VmVal {
        ty_id := ty_str.raw as u32
        if (self.types != (0 as &TypeStorage)) and (ty_id != 0) {
            k := self.types.kind(ty_id)
            if (k == TyKind.float) and (self.types.payload(ty_id) == 32) {
                if inner.kind == VmValKind.const_int {
                    d := *(&inner.raw as &f64)
                    f := d as f32
                    f_bits: u64 = 0
                    *(&f_bits as &f32) = f
                    ret .{ kind: VmValKind.const_int, elem_size: 32, id: 0, raw: f_bits }
                }
                self.ensure_on_stack(inner)
                self.chunk.inst(OpCode.f64_to_f32)
                ret .{ kind: VmValKind.stack, elem_size: 32, id: 0, raw: 0 }
            }
            if (k == TyKind.int) or (k == TyKind.uint) {
                if inner.kind == VmValKind.local {
                    src_ty := self.get_local_type(inner.id)
                    if (src_ty != 0) and (self.types.kind(src_ty) == TyKind.float) {
                        self.ensure_on_stack(inner)
                        self.chunk.inst(OpCode.f32_to_i32)
                        ret VmVal.stack()
                    }
                }
            }
        }
        inner
    }

    expr_call :: fn(self &Self, arena &Arena, callee VmVal, args VmVal, ty u32) VmVal {
        arg_count := args.id as u8
        if callee.kind == VmValKind.global and callee.id >= 1000000 {
            ext_id := (callee.id - 1000000) as u16
            self.chunk.inst(OpCode.call_extern)
            self.chunk.emit_u16(ext_id)
            self.chunk.emit_u8(arg_count)
            ret VmVal.stack()
        }
        if callee.kind == VmValKind.global {
            self.chunk.inst(OpCode.call)
            patch_offset := self.chunk.buf.len as u32
            self.call_fixups_ip.push(patch_offset)
            self.call_fixups_sym.push(callee.id)
            self.chunk.emit_u32(0)
            self.chunk.emit_u8(arg_count)
            ret VmVal.stack()
        }
        self.ensure_on_stack(callee)
        self.chunk.inst(OpCode.call_ptr)
        self.chunk.emit_u8(arg_count)
        self.chunk.emit_u16(self.ffi_signature(ty))
        self.chunk.emit_u8(if callee.kind == VmValKind.stack { 1 } else { 0 })
        VmVal.stack()
    }

    expr_member :: fn(self &Self, arena &Arena, lhs VmVal, depth u32, field_id u32) VmVal {
        struct_ty: u32 = 0
        if (lhs.kind == VmValKind.local) or (lhs.kind == VmValKind.deref) {
            struct_ty = self.get_local_type(lhs.id)
        }
        self.expr_typed_member(arena, lhs, depth, field_id, struct_ty)
    }

    expr_typed_member :: fn(
        self &Self
        arena &Arena
        lhs VmVal
        depth u32
        field_id u32
        struct_ty u32
    ) VmVal {
        value := lhs
        if (value.kind == VmValKind.deref) and self.is_struct_type(struct_ty) {
            self.ensure_on_stack(value)
            value = VmVal.stack()
        }
        offset := self.find_struct_field_offset(struct_ty, field_id)
        elem_sz := self.find_struct_field_elem_size(struct_ty, field_id)
        base := self.unwrap_base_type(struct_ty)
        if value.kind == VmValKind.data or value.kind == VmValKind.data_ref {
            if depth == 0 {
                self.emit_data_address(value)
            } else {
                self.ensure_on_stack(value)
                for _ in Range.new(1, depth as i32) {
                    self.chunk.inst(OpCode.load64)
                }
            }
            self.emit_offset(offset as u64)
            ty := self.find_struct_field_type(base, field_id)
            if not self.types.struct_is_extern(base) and vm_is_aggregate(self.types, ty) {
                self.chunk.inst(OpCode.load64)
            }
            if self.types.struct_is_extern(base) {
                slot := self.alloc_temp()
                self.chunk.inst(OpCode.store_local)
                self.chunk.emit_u16(slot as u16)
                ret .{ kind: VmValKind.ffi_field, elem_size: elem_sz, id: slot, raw: ty as u64 }
            }
            ret self.capture_data_ref(ty)
        }
        if self.types.struct_is_extern(base) {
            self.ensure_on_stack(value)
            d := depth
            while d > 1 {
                self.chunk.inst(OpCode.load64)
                d = d - 1
            }
            self.emit_offset(offset as u64)
            address := self.alloc_temp()
            self.chunk.inst(OpCode.store_local)
            self.chunk.emit_u16(address as u16)
            ty := self.find_struct_field_type(base, field_id)
            ret .{ kind: VmValKind.ffi_field, elem_size: elem_sz, id: address, raw: ty as u64 }
        }
        if depth <= 1 and value.kind == VmValKind.local {
            ret .{
                kind: VmValKind.member_local
                elem_size: elem_sz
                id: value.id
                raw: offset as u64
            }
        }
        self.ensure_on_stack(value)
        d := depth
        while d > 1 {
            self.chunk.inst(OpCode.load64)
            d = d - 1
        }
        address := self.alloc_temp()
        self.chunk.inst(OpCode.store_local)
        self.chunk.emit_u16(address as u16)
        .{ kind: VmValKind.member_local, elem_size: elem_sz, id: address, raw: offset as u64 }
    }

    expr_struct_init_field :: fn(self &Self, arena &Arena, field_id u32, val_str VmVal) VmVal {
        self.ensure_on_stack(val_str)
        self.init_field_ids.push(field_id)
        VmVal.stack()
    }

    expr_struct_init :: fn(self &Self, arena &Arena, struct_name VmVal, fields_body VmVal) VmVal {
        struct_ty := struct_name.raw as u32
        count := fields_body.id as u64
        is_extern := self.types.struct_is_extern(struct_ty)
        temp_buf := if is_extern {
            slot := self.alloc_temp()
            self.emit_alloc_ffi(self.struct_alloc_size(struct_ty))
            self.chunk.inst(OpCode.store_local)
            self.chunk.emit_u16(slot as u16)
            slot
        } else {
            self.alloc_heap_temp(if count == 0 { 8 } else { count * 8 })
        }

        for _ in Range.new(0, count as i32) {
            field := self.init_field_ids.pop()
            offset := self.find_struct_field_offset(struct_ty, field)
            ty := if is_extern {
                self.find_struct_field_type(self.unwrap_base_type(struct_ty), field)
            } else {
                ty_id_none()
            }
            if is_extern {
                self.prepare_ffi_store(ty)
            }
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(temp_buf as u16)
            self.emit_offset(offset as u64)
            if is_extern {
                self.emit_ffi_store(ty)
            } else {
                self.chunk.inst(OpCode.store64)
            }
        }

        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(temp_buf as u16)
        VmVal.stack()
    }

    expr_array_init_elem :: fn(self &Self, arena &Arena, val VmVal) VmVal {
        val
    }

    expr_array_init :: fn(
        self &Self
        arena &Arena
        arr_name VmVal
        elems_body VmVal
        elem_ty u32
        count u32
    ) VmVal {
        c := count as u64
        elem_size: u64 = 8
        if (self.types != (0 as &TypeStorage)) and (elem_ty != 0) {
            elem_size = vm_element_size(self.types, elem_ty)
        }
        if elem_size == 0 {
            elem_size = 8
        }
        total_size := c * elem_size
        if total_size == 0 {
            total_size = 8
        }
        temp_buf := self.alloc_heap_temp(total_size)

        i := c
        while i > 0 {
            i = i - 1
            offset := i * elem_size
            self.chunk.inst(OpCode.load_local)
            self.chunk.emit_u16(temp_buf as u16)
            if offset > 0 {
                c_off := self.chunk.alloc_const(offset)
                self.chunk.inst(OpCode.push_const)
                self.chunk.emit_u16(c_off)
                self.chunk.inst(OpCode.add)
            }
            if elem_size == 1 {
                self.chunk.inst(OpCode.store8)
            } else if elem_size == 2 {
                self.chunk.inst(OpCode.store16)
            } else if elem_size == 4 {
                self.chunk.inst(OpCode.store32)
            } else {
                self.chunk.inst(OpCode.store64)
            }
        }

        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(temp_buf as u16)
        VmVal.stack()
    }

    expr_array_index :: fn(
        self &Self
        arena &Arena
        value VmVal
        index VmVal
        elem_ty u32
        is_ptr bool
    ) VmVal {
        self.expr_ptr_index(arena, value, index, elem_ty)
    }

    expr_ptr_index :: fn(self &Self, arena &Arena, value VmVal, index VmVal, elem_ty u32) VmVal {
        elem_size: u64 = 8
        if (self.types != (0 as &TypeStorage)) and (elem_ty != 0) {
            elem_size = vm_element_size(self.types, elem_ty)
        }
        if elem_size == 0 {
            elem_size = 8
        }
        self.ensure_on_stack(index)
        if elem_size != 1 {
            c_sz := self.chunk.alloc_const(elem_size)
            self.chunk.inst(OpCode.push_const)
            self.chunk.emit_u16(c_sz)
            self.chunk.inst(OpCode.mul)
        }
        temp_off := self.alloc_temp()
        self.chunk.inst(OpCode.store_local)
        self.chunk.emit_u16(temp_off as u16)

        data := value.kind == VmValKind.data or value.kind == VmValKind.data_ref
        if data and vm_is_aggregate(self.types, self.data_type(value)) {
            self.emit_data_address(value)
        } else {
            self.ensure_on_stack(value)
        }
        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(temp_off as u16)
        self.chunk.inst(OpCode.add)

        if data {
            if vm_is_indirect(self.types, elem_ty) {
                self.chunk.inst(OpCode.load64)
            }
            ret self.capture_data_ref(elem_ty)
        }

        temp_addr := self.alloc_temp()
        self.chunk.inst(OpCode.store_local)
        self.chunk.emit_u16(temp_addr as u16)

        if not vm_is_indirect(self.types, elem_ty) {
            ret .{ kind: VmValKind.ffi_field, elem_size: 0, id: temp_addr, raw: elem_ty as u64 }
        }
        .{ kind: VmValKind.deref, elem_size: elem_size as u16, id: temp_addr, raw: 0 }
    }

    expr_slice_index :: fn(
        self &Self
        arena &Arena
        value VmVal
        index VmVal
        elem_ty u32
        ptr_id u32
    ) VmVal {
        elem_size: u64 = 8
        if (self.types != (0 as &TypeStorage)) and (elem_ty != 0) {
            elem_size = vm_element_size(self.types, elem_ty)
        }
        if elem_size == 0 {
            elem_size = 8
        }
        self.ensure_on_stack(index)
        if elem_size != 1 {
            c_sz := self.chunk.alloc_const(elem_size)
            self.chunk.inst(OpCode.push_const)
            self.chunk.emit_u16(c_sz)
            self.chunk.inst(OpCode.mul)
        }
        temp_off := self.alloc_temp()
        self.chunk.inst(OpCode.store_local)
        self.chunk.emit_u16(temp_off as u16)

        struct_ty: u32 = 0
        if (value.kind == VmValKind.local) or (value.kind == VmValKind.deref) {
            struct_ty = self.get_local_type(value.id)
        }
        ptr_offset := self.find_struct_field_offset(struct_ty, ptr_id)

        self.ensure_on_stack(value)
        if ptr_offset > 0 {
            c_poff := self.chunk.alloc_const(ptr_offset as u64)
            self.chunk.inst(OpCode.push_const)
            self.chunk.emit_u16(c_poff)
            self.chunk.inst(OpCode.add)
        }
        self.chunk.inst(OpCode.load64)
        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(temp_off as u16)
        self.chunk.inst(OpCode.add)

        temp_addr := self.alloc_temp()
        self.chunk.inst(OpCode.store_local)
        self.chunk.emit_u16(temp_addr as u16)

        ret .{ kind: VmValKind.deref, elem_size: elem_size as u16, id: temp_addr, raw: 0 }
    }

    expr_sizeof :: fn(self &Self, arena &Arena, ty VmVal) VmVal {
        ty_id := ty.raw as u32
        if self.types != (0 as &TypeStorage) {
            sz := type_size(self.types, ty_id)
            ret VmVal.const_int(sz)
        }
        VmVal.const_int(8)
    }

    expr_union :: fn(self &Self, arena &Arena, union_name VmVal, tag u32, value VmVal) VmVal {
        self.ensure_on_stack(value)
        val_temp := self.alloc_temp()
        self.chunk.inst(OpCode.store_local)
        self.chunk.emit_u16(val_temp as u16)

        u_temp := self.alloc_heap_temp(16)

        c_tag := self.chunk.alloc_const(tag as u64)
        self.chunk.inst(OpCode.push_const)
        self.chunk.emit_u16(c_tag)
        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(u_temp as u16)
        self.chunk.inst(OpCode.store64)

        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(val_temp as u16)
        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(u_temp as u16)
        c_off := self.chunk.alloc_const(8)
        self.chunk.inst(OpCode.push_const)
        self.chunk.emit_u16(c_off)
        self.chunk.inst(OpCode.add)
        self.chunk.inst(OpCode.store64)

        self.chunk.inst(OpCode.load_local)
        self.chunk.emit_u16(u_temp as u16)
        VmVal.stack()
    }

    expr_union_member :: fn(self &Self, arena &Arena, value VmVal, tag u32) VmVal {
        self.ensure_on_stack(value)
        c_off := self.chunk.alloc_const(8)
        self.chunk.inst(OpCode.push_const)
        self.chunk.emit_u16(c_off)
        self.chunk.inst(OpCode.add)
        self.chunk.inst(OpCode.load64)
        VmVal.stack()
    }

    expr_union_tag :: fn(self &Self, arena &Arena, value VmVal) VmVal {
        self.expr_unary_op(value, OpCode.load64)
    }

    expr_union_is :: fn(self &Self, arena &Arena, value VmVal, tag u32) VmVal {
        self.ensure_on_stack(value)
        self.chunk.inst(OpCode.load64)
        c_tag := self.chunk.alloc_const(tag as u64)
        self.chunk.inst(OpCode.push_const)
        self.chunk.emit_u16(c_tag)
        self.chunk.inst(OpCode.eq)
        VmVal.stack()
    }

    expr_enum_value :: fn(self &Self, arena &Arena, enum_name VmVal, value u32) VmVal {
        val := value as u64
        ty_id := enum_name.raw as u32
        if (self.types != (0 as &TypeStorage)) and (ty_id != 0) {
            backing := self.types.enum_backing(ty_id)
            k := self.types.kind(backing)
            if (k == TyKind.uint) or (k == TyKind.int) {
                p := self.types.payload(backing)
                if p <= 8 {
                    val = val & 255
                } else if p <= 16 {
                    val = val & 65535
                }
            }
        }
        VmVal.const_int(val)
    }

    expr_field_value :: fn(self &Self, arena &Arena, value VmVal, field_id u32) VmVal {
        self.expr_member(arena, value, 0, field_id)
    }

    expr_equal :: fn(self &Self, arena &Arena, lhs VmVal, rhs VmVal) VmVal {
        self.expr_binary_op(lhs, rhs, OpCode.eq)
    }

    expr_or :: fn(self &Self, arena &Arena, lhs VmVal, rhs VmVal) VmVal {
        self.expr_binary_op(lhs, rhs, OpCode.bit_or)
    }

    expr_less_equal :: fn(self &Self, arena &Arena, lhs VmVal, rhs VmVal) VmVal {
        self.expr_binary_op(lhs, rhs, OpCode.le)
    }

    expr_add :: fn(self &Self, arena &Arena, lhs VmVal, rhs VmVal) VmVal {
        self.expr_binary_kind(arena, hir_kind.binary_add, lhs, rhs)
    }

    define_struct :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        if (types.kind(ty_id) == TyKind.nominal) and (types.nominal_base(ty_id) == ty_id_none()) {
            ret
        }
        fields := types.get_struct_fields(ty_id)
        count := fields.len / 2
        if types.struct_is_extern(ty_id) {
            offset: u64 = 0
            i: u64 = 0
            while i < count {
                f_name := *(fields.ptr + (i * 2))
                f_ty := *(fields.ptr + (i * 2) + 1)
                a := type_align(types, f_ty)
                if a > 0 {
                    offset = (offset + a - 1) & ~(a - 1)
                }
                self.set_field_offset(f_name, offset as u32)
                offset = offset + type_size(types, f_ty)
                i = i + 1
            }
        } else {
            i: u64 = 0
            while i < count {
                f_name := *(fields.ptr + (i * 2))
                self.set_field_offset(f_name, (i * 8) as u32)
                i = i + 1
            }
        }
    }

    init_types :: fn(self &Self, types &TypeStorage, arena &Arena) {
        self.types = types
        self.chunk.types = types
        t: u32 = 0
        total := types.len()
        while t < total {
            k := types.kind(t)
            if (k == TyKind.struct_) or
                ((k == TyKind.nominal) and (types.nominal_base(t) != ty_id_none())) {
                self.define_struct(types, arena, t)
            }
            t = t + 1
        }
    }

    define_func_type :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {}
    define_union :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {}
    define_enum :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {}
    define_array :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {}

    iterator_name :: fn(self &Self, arena &Arena, id u32, index u32) VmVal {
        slot := self.alloc_temp()
        VmVal.local(slot)
    }

    iterator_next_name :: fn(self &Self, arena &Arena, id u32, index u32) VmVal {
        slot := self.alloc_temp()
        VmVal.local(slot)
    }
}

type_align :: fn(types &TypeStorage, ty_id u32) u64 {
    k := types.kind(ty_id)
    match k {
        bool {
            1
        }
        int, uint {
            p := types.payload(ty_id)
            if p <= 8 {
                ret 1
            }
            if p <= 16 {
                ret 2
            }
            if p <= 32 {
                ret 4
            }
            8
        }
        float {
            p := types.payload(ty_id)
            if p <= 32 {
                ret 4
            }
            8
        }
        ptr { (target_ptr_bits as u64) / 8 }
        func, type_, untyped_int, untyped_float, unknown, infer {
            8
        }
        unit, never, error {
            1
        }
        nominal {
            type_align(types, types.nominal_base(ty_id))
        }
        enum_ {
            type_align(types, types.enum_backing(ty_id))
        }
        array {
            type_align(types, types.get_array_type(ty_id))
        }
        struct_ {
            fields := types.get_struct_fields(ty_id)
            count := fields.len / 2
            max_a: u64 = 1
            i: u64 = 0
            while i < count {
                f_ty := *(fields.ptr + (i * 2) + 1)
                a := type_align(types, f_ty)
                if a > max_a {
                    max_a = a
                }
                i = i + 1
            }
            max_a
        }
        union_ {
            members := types.union_members(ty_id)
            max_a: u64 = 4
            i: u64 = 0
            while i < members.len {
                m_ty := *(members.ptr + i)
                a := type_align(types, m_ty)
                if a > max_a {
                    max_a = a
                }
                i = i + 1
            }
            max_a
        }
    }
}

vm_data_base :: fn(types &TypeStorage, ty u32) u32 {
    while types.kind(ty) == TyKind.nominal {
        ty = types.nominal_base(ty)
    }
    ty
}

vm_is_aggregate :: fn(types &TypeStorage, ty u32) bool {
    kind := types.kind(vm_data_base(types, ty))
    kind == TyKind.struct_ or kind == TyKind.array or kind == TyKind.union_
}

vm_is_indirect :: fn(types &TypeStorage, ty u32) bool {
    vm_is_aggregate(types, ty) and not types.struct_is_extern(ty)
}

vm_data_size :: fn(types &TypeStorage, ty u32) u64 {
    base := vm_data_base(types, ty)
    match types.kind(base) {
        union_ { ret 16 }
        array {
            ret vm_element_size(types, types.get_array_type(base)) *
                (types.get_array_len(base) as u64)
        }
        struct_ {
            if types.struct_is_extern(base) {
                ret type_size(types, base)
            }
            ret (types.get_struct_fields(base).len / 2) * 8
        }
        else { ret type_size(types, base) }
    }
}

vm_element_size :: fn(types &TypeStorage, ty u32) u64 {
    kind := types.kind(ty)
    while kind == TyKind.nominal {
        ty = types.nominal_base(ty)
        kind = types.kind(ty)
    }
    if types.struct_is_extern(ty) {
        ret type_size(types, ty)
    }
    if (kind == TyKind.struct_) or (kind == TyKind.array) or (kind == TyKind.union_) {
        ret 8
    }
    type_size(types, ty)
}

type_size :: fn(types &TypeStorage, ty_id u32) u64 {
    k := types.kind(ty_id)
    match k {
        bool {
            1
        }
        int, uint {
            p := types.payload(ty_id)
            if p <= 8 {
                ret 1
            }
            if p <= 16 {
                ret 2
            }
            if p <= 32 {
                ret 4
            }
            8
        }
        float {
            p := types.payload(ty_id)
            if p <= 32 {
                ret 4
            }
            8
        }
        ptr { (target_ptr_bits as u64) / 8 }
        func, type_, untyped_int, untyped_float, unknown, infer {
            8
        }
        unit, never, error {
            0
        }
        nominal {
            type_size(types, types.nominal_base(ty_id))
        }
        enum_ {
            type_size(types, types.enum_backing(ty_id))
        }
        array {
            elem_ty := types.get_array_type(ty_id)
            len := types.get_array_len(ty_id)
            type_size(types, elem_ty) * (len as u64)
        }
        struct_ {
            fields := types.get_struct_fields(ty_id)
            count := fields.len / 2
            offset: u64 = 0
            max_a: u64 = 1
            i: u64 = 0
            while i < count {
                f_ty := *(fields.ptr + (i * 2) + 1)
                sz := type_size(types, f_ty)
                a := type_align(types, f_ty)
                if a > max_a {
                    max_a = a
                }
                if a > 0 {
                    offset = (offset + a - 1) & ~(a - 1)
                }
                offset = offset + sz
                i = i + 1
            }
            if max_a > 0 {
                offset = (offset + max_a - 1) & ~(max_a - 1)
            }
            offset
        }
        union_ {
            members := types.union_members(ty_id)
            max_m_sz: u64 = 0
            max_a: u64 = 4
            i: u64 = 0
            while i < members.len {
                m_ty := *(members.ptr + i)
                sz := type_size(types, m_ty)
                a := type_align(types, m_ty)
                if sz > max_m_sz {
                    max_m_sz = sz
                }
                if a > max_a {
                    max_a = a
                }
                i = i + 1
            }
            offset: u64 = 4
            if max_a > 0 {
                offset = (offset + max_a - 1) & ~(max_a - 1)
            }
            offset = offset + max_m_sz
            if max_a > 0 {
                offset = (offset + max_a - 1) & ~(max_a - 1)
            }
            offset
        }
    }
}

parse_float :: fn(s Str) f64 {
    neg := false
    idx: u64 = 0
    if (s.len > 0) and (*(s.ptr) == '-') {
        neg = true
        idx = 1
    }
    int_part: f64 = 0.0
    while idx < s.len {
        c := *(s.ptr + idx)
        if (c == '.') or (c == 'e') or (c == 'E') {
            break
        }
        if (c >= '0') and (c <= '9') {
            int_part = int_part * 10.0 + ((c - '0') as f64)
        }
        idx = idx + 1
    }
    frac_part: f64 = 0.0
    frac_div: f64 = 1.0
    if (idx < s.len) and (*(s.ptr + idx) == '.') {
        idx = idx + 1
        while idx < s.len {
            c := *(s.ptr + idx)
            if (c == 'e') or (c == 'E') {
                break
            }
            if (c >= '0') and (c <= '9') {
                frac_div = frac_div * 10.0
                frac_part = frac_part + (((c - '0') as f64) / frac_div)
            }
            idx = idx + 1
        }
    }
    res := int_part + frac_part
    if (idx < s.len) and ((*(s.ptr + idx) == 'e') or (*(s.ptr + idx) == 'E')) {
        idx = idx + 1
        exp_neg := false
        if idx < s.len {
            if *(s.ptr + idx) == '-' {
                exp_neg = true
                idx = idx + 1
            } else if *(s.ptr + idx) == '+' {
                idx = idx + 1
            }
        }
        exp_val: u64 = 0
        while idx < s.len {
            c := *(s.ptr + idx)
            if (c >= '0') and (c <= '9') {
                exp_val = exp_val * 10 + ((c - '0') as u64)
            }
            idx = idx + 1
        }
        if exp_val > 400 {
            exp_val = 400
        }
        e_i: u64 = 0
        while e_i < exp_val {
            if exp_neg {
                res = res / 10.0
            } else {
                res = res * 10.0
            }
            e_i = e_i + 1
        }
    }
    if neg {
        ret -res
    }
    res
}

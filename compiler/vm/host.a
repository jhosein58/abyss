import core.maybe:          Maybe
import std.collections.vec: Vec
import std.mem:             free, malloc
import std.string:          Str
import std.sys:
    Directory
    OpenMode
    close_handle
    environment
    exit_process
    make_directory
    open_handle
    read_handle
    seek_handle
    write_handle

HostDirSlot :: struct {
    dir    Directory
    active bool
}

WasiPrestat :: extern struct {
    tag u32
    len u32
}

WasiCiovec :: extern struct {
    address &u8
    len     u32
}

WasiDirent :: extern struct {
    next     u64
    inode    u64
    name_len u32
    kind     u8
}

Win32FindData :: extern struct {
    attributes u32
    times      [6]u32
    size_hi    u32
    size_lo    u32
    reserved   [2]u32
    name       [260]u8
    short_name [14]u8
}

alloc_dir_slot :: fn(dirs &Vec(HostDirSlot), dir Directory) u32 {
    i: u64 = 0
    while i < dirs.len {
        slot := dirs.as_slice().ptr + i
        if not slot.active {
            slot.dir = dir
            slot.active = true
            ret i as u32
        }
        i = i + 1
    }
    dirs.push(.{ dir: dir, active: true })
    (dirs.len as u32) - 1
}

dispatch_host_call :: fn(dirs &Vec(HostDirSlot), name Str, args &u64) Maybe(u64) {
    if name.eq("fd_prestat_get") {
        fd := args[0] as u32
        result := args[1] as &WasiPrestat
        if fd == 3 {
            result.tag = 0
            result.len = 1
            ret Maybe(u64).some(0)
        }
        ret Maybe(u64).some(8)
    }
    if name.eq("fd_prestat_dir_name") {
        fd := args[0] as u32
        buf := args[1] as &u8
        len := args[2] as u32
        if fd == 3 and len >= 1 {
            buf[0] = '.' as u8
            ret Maybe(u64).some(0)
        }
        ret Maybe(u64).some(8)
    }
    if name.eq("path_open") {
        path_ptr := args[2] as &u8
        path_len := args[3] as u32
        flags := args[4] as u32
        rights := args[5]
        behavior := args[7] as u32
        opened := args[8] as &u32
        cstr := malloc((path_len as u64) + 1)
        i: u64 = 0
        while i < (path_len as u64) {
            *(cstr + i) = *(path_ptr + i)
            i = i + 1
        }
        *(cstr + (path_len as u64)) = 0 as u8
        is_dir := (flags & 2) != 0 or (rights & 16384) != 0
        if is_dir {
            opt_dir := Directory.open(cstr)
            free(cstr)
            if opt_dir.is_none() {
                ret Maybe(u64).some(44)
            }
            slot := alloc_dir_slot(dirs, opt_dir.unwrap())
            opened[0] = 1000 + slot
            ret Maybe(u64).some(0)
        }
        mode: OpenMode = .{
            read: (rights & 2) != 0
            write: (rights & 64) != 0
            create: (flags & 1) != 0
            truncate: (flags & 8) != 0
            append: (behavior & 1) != 0
        }
        h := open_handle(cstr, mode)
        free(cstr)
        if h < 0 {
            ret Maybe(u64).some(44)
        }
        opened[0] = h as u32
        ret Maybe(u64).some(0)
    }
    if name.eq("fd_read") {
        fd := args[0] as u32
        iovs := args[1] as &WasiCiovec
        count := args[2] as u32
        received := args[3] as &u32
        total: u64 = 0
        j: u32 = 0
        while j < count {
            iov := iovs + (j as u64)
            n := read_handle(fd as i64, iov.address, iov.len as u64)
            if n <= 0 { break }
            total = total + (n as u64)
            j = j + 1
        }
        received[0] = total as u32
        ret Maybe(u64).some(0)
    }
    if name.eq("fd_write") {
        fd := args[0] as u32
        iovs := args[1] as &WasiCiovec
        count := args[2] as u32
        sent := args[3] as &u32
        total: u64 = 0
        j: u32 = 0
        while j < count {
            iov := iovs + (j as u64)
            n := write_handle(fd as i64, iov.address, iov.len as u64)
            if n <= 0 { break }
            total = total + (n as u64)
            j = j + 1
        }
        sent[0] = total as u32
        ret Maybe(u64).some(0)
    }
    if name.eq("fd_close") {
        fd := args[0] as u32
        if fd >= 1000 {
            slot_idx := (fd - 1000) as u64
            if slot_idx < dirs.len {
                slot := dirs.as_slice().ptr + slot_idx
                if slot.active {
                    slot.dir.close()
                    slot.active = false
                }
            }
            ret Maybe(u64).some(0)
        }
        close_handle(fd as i64)
        ret Maybe(u64).some(0)
    }
    if name.eq("fd_seek") {
        fd := args[0] as u32
        offset := args[1] as i64
        whence := args[2] as u32
        position := args[3] as &u64
        pos := seek_handle(fd as i64, offset, whence as i32)
        if pos < 0 { ret Maybe(u64).some(29) }
        position[0] = pos as u64
        ret Maybe(u64).some(0)
    }
    if name.eq("fd_readdir") {
        fd := args[0] as u32
        buf := args[1] as &u8
        cookie := args[3]
        used := args[4] as &u32
        if fd >= 1000 {
            slot_idx := (fd - 1000) as u64
            if slot_idx < dirs.len {
                slot := dirs.as_slice().ptr + slot_idx
                if slot.active {
                    entry_opt := slot.dir.next()
                    if entry_opt.is_none() {
                        used[0] = 0
                        ret Maybe(u64).some(0)
                    }
                    entry := entry_opt.unwrap()
                    dirent := buf as &WasiDirent
                    dirent.next = cookie + 1
                    dirent.inode = 1
                    dirent.name_len = entry.name.len as u32
                    dirent.kind = if entry.kind == 2 { 3 as u8 } else if entry.kind == 1 {
                        4 as u8
                    } else { 0 as u8 }
                    name_dst := buf + 24
                    k: u64 = 0
                    while k < entry.name.len {
                        *(name_dst + k) = *(entry.name.ptr + k)
                        k = k + 1
                    }
                    used[0] = 24 + (entry.name.len as u32)
                    ret Maybe(u64).some(0)
                }
            }
        }
        used[0] = 0
        ret Maybe(u64).some(0)
    }
    if name.eq("path_create_directory") {
        path_ptr := args[1] as &u8
        path_len := args[2] as u32
        cstr := malloc((path_len as u64) + 1)
        k: u64 = 0
        while k < (path_len as u64) {
            *(cstr + k) = *(path_ptr + k)
            k = k + 1
        }
        *(cstr + (path_len as u64)) = 0 as u8
        ok := make_directory(cstr)
        free(cstr)
        ret Maybe(u64).some(if ok { 0 } else { 1 })
    }
    if name.eq("environ_sizes_get") {
        count := args[0] as &u32
        bytes := args[1] as &u32
        count[0] = 0
        bytes[0] = 0
        ret Maybe(u64).some(0)
    }
    if name.eq("environ_get") {
        ret Maybe(u64).some(0)
    }
    if name.eq("proc_exit") {
        exit_process(args[0] as i32)
        ret Maybe(u64).some(0)
    }
    if name.eq("CreateFileA") {
        path := args[0] as &u8
        access := args[1] as u32
        disp := args[4] as u32
        mode: OpenMode = .{
            read: (access & 0x80000000) != 0
            write: (access & 0x40000000) != 0 or (access & 4) != 0
            create: disp == 2 or disp == 4
            truncate: disp == 2
            append: (access & 4) != 0
        }
        h := open_handle(path, mode)
        if h < 0 { ret Maybe(u64).some(0xffffffffffffffff) }
        ret Maybe(u64).some(h as u64)
    }
    if name.eq("ReadFile") {
        h := args[0] as i64
        buf := args[1] as &u8
        count := args[2] as u32
        received := args[3] as &u32
        n := read_handle(h, buf, count as u64)
        if n < 0 { ret Maybe(u64).some(0) }
        if received != (0 as &u32) { received[0] = n as u32 }
        ret Maybe(u64).some(1)
    }
    if name.eq("WriteFile") {
        h := args[0] as i64
        buf := args[1] as &u8
        count := args[2] as u32
        sent := args[3] as &u32
        n := write_handle(h, buf, count as u64)
        if n < 0 { ret Maybe(u64).some(0) }
        if sent != (0 as &u32) { sent[0] = n as u32 }
        ret Maybe(u64).some(1)
    }
    if name.eq("CloseHandle") {
        h := args[0] as i64
        ret Maybe(u64).some(if close_handle(h) { 1 } else { 0 })
    }
    if name.eq("SetFilePointerEx") {
        h := args[0] as i64
        offset := args[1] as i64
        position := args[2] as &i64
        whence := args[3] as u32
        pos := seek_handle(h, offset, whence as i32)
        if pos < 0 { ret Maybe(u64).some(0) }
        if position != (0 as &i64) { position[0] = pos }
        ret Maybe(u64).some(1)
    }
    if name.eq("GetStdHandle") {
        kind := args[0] as u32
        if kind == 0xfffffff6 { ret Maybe(u64).some(0) }
        if kind == 0xfffffff5 { ret Maybe(u64).some(1) }
        if kind == 0xfffffff4 { ret Maybe(u64).some(2) }
        ret Maybe(u64).some(0)
    }
    if name.eq("FindFirstFileA") {
        pattern := args[0] as &u8
        entry := args[1] as &Win32FindData
        p_str := Str.of(pattern)
        dir_len := p_str.len
        if dir_len > 0 and (*(p_str.ptr + dir_len - 1) == ('*' as u8)) { dir_len = dir_len - 1 }
        if dir_len > 0 and
            (
                *(p_str.ptr + dir_len - 1) == ('/' as u8) or
                    *(p_str.ptr + dir_len - 1) == ('\\' as u8)
            ) { dir_len = dir_len - 1 }
        dir_cstr := malloc(dir_len + 1)
        idx: u64 = 0
        while idx < dir_len {
            *(dir_cstr + idx) = *(p_str.ptr + idx)
            idx = idx + 1
        }
        *(dir_cstr + dir_len) = 0 as u8
        opt_dir := Directory.open(dir_cstr)
        free(dir_cstr)
        if opt_dir.is_none() { ret Maybe(u64).some(0xffffffffffffffff) }
        slot := alloc_dir_slot(dirs, opt_dir.unwrap())
        slot_ptr := dirs.as_slice().ptr + (slot as u64)
        entry_opt := slot_ptr.dir.next()
        if entry_opt.is_none() {
            entry.attributes = 0
            entry.name[0] = 0 as u8
            ret Maybe(u64).some(1000 + (slot as u64))
        }
        e := entry_opt.unwrap()
        entry.attributes = if e.kind == 2 { 16 } else { 128 }
        k: u64 = 0
        while k < e.name.len {
            entry.name[k] = *(e.name.ptr + k)
            k = k + 1
        }
        entry.name[e.name.len] = 0 as u8
        ret Maybe(u64).some(1000 + (slot as u64))
    }
    if name.eq("FindNextFileA") {
        handle := args[0]
        entry := args[1] as &Win32FindData
        if handle < 1000 { ret Maybe(u64).some(0) }
        slot_idx := handle - 1000
        if slot_idx >= dirs.len { ret Maybe(u64).some(0) }
        slot_ptr := dirs.as_slice().ptr + slot_idx
        if not slot_ptr.active { ret Maybe(u64).some(0) }
        entry_opt := slot_ptr.dir.next()
        if entry_opt.is_none() { ret Maybe(u64).some(0) }
        e := entry_opt.unwrap()
        entry.attributes = if e.kind == 2 { 16 } else { 128 }
        k: u64 = 0
        while k < e.name.len {
            entry.name[k] = *(e.name.ptr + k)
            k = k + 1
        }
        entry.name[e.name.len] = 0 as u8
        ret Maybe(u64).some(1)
    }
    if name.eq("FindClose") {
        handle := args[0]
        if handle >= 1000 {
            slot_idx := handle - 1000
            if slot_idx < dirs.len {
                slot_ptr := dirs.as_slice().ptr + slot_idx
                if slot_ptr.active {
                    slot_ptr.dir.close()
                    slot_ptr.active = false
                }
            }
        }
        ret Maybe(u64).some(1)
    }
    if name.eq("GetFileAttributesA") {
        path := args[0] as &u8
        opt_dir := Directory.open(path)
        if opt_dir.is_some() {
            d := opt_dir.unwrap()
            d.close()
            ret Maybe(u64).some(16)
        }
        h := open_handle(
            path
            .{ read: true, write: false, create: false, truncate: false, append: false }
        )
        if h >= 0 {
            close_handle(h)
            ret Maybe(u64).some(128)
        }
        ret Maybe(u64).some(0xffffffff)
    }
    if name.eq("CreateDirectoryA") {
        path := args[0] as &u8
        ret Maybe(u64).some(if make_directory(path) { 1 } else { 0 })
    }
    if name.eq("GetEnvironmentVariableA") {
        key := args[0] as &u8
        val := environment(key)
        if val == (0 as &u8) { ret Maybe(u64).some(0) }
        val_str := Str.of(val)
        buf := args[1] as &u8
        size := args[2] as u32
        if size == 0 or size <= (val_str.len as u32) { ret Maybe(u64).some(val_str.len + 1) }
        idx: u64 = 0
        while idx < val_str.len {
            *(buf + idx) = *(val_str.ptr + idx)
            idx = idx + 1
        }
        *(buf + val_str.len) = 0 as u8
        ret Maybe(u64).some(val_str.len)
    }
    if name.eq("ExitProcess") {
        exit_process(args[0] as i32)
        ret Maybe(u64).some(0)
    }
    if name.eq("_errno") {
        ret Maybe(u64).some(0)
    }
    Maybe(u64).none()
}

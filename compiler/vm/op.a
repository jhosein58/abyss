OpCode :: enum u8 {
    halt,
    push_const,
    push_0,
    push_1,
    pop,
    dup,
    load_local,
    store_local,
    addr_local,
    load64,
    store64,
    load32,
    store32,
    load8,
    store8,
    add,
    sub,
    mul,
    div,
    mod,
    neg,
    bit_and,
    bit_or,
    bit_xor,
    bit_not,
    shl,
    shr,
    eq,
    ne,
    lt,
    le,
    gt,
    ge,
    l_not,
    jmp,
    jmp_if_false,
    jmp_if_true,
    call,
    call_extern,
    call_ptr,
    call_ptr_stack,
    ret_val,
    f64_to_f32,
    f32_to_i32
}

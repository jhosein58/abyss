target :: @import("core/target")
mem :: @import("std/mem")
sys :: @import("std/sys")

FfiKind :: @import("./ffi").FfiKind
loader :: @import("./loader")

VmCallback :: fn(&&u8, &u8, u32, &u64, u32) u64
FfiFunction :: fn()
FfiTrampoline :: fn(&u8, &u8, &&u8, &u8)
FfiPrepare :: fn(&u8, u32, u32, &FfiType, &&FfiType) u32
FfiCall :: fn(&u8, FfiFunction, &u8, &&u8)
ClosureAlloc :: fn(u64, &&u8) &u8
ClosureFree :: fn(&u8)
ClosurePrepare :: fn(&u8, &u8, FfiTrampoline, &u8, &u8) u32
CStrCall :: fn(&u8) i32

FfiType :: extern struct {
    size      u64
    alignment u16
    kind      u16
    elements  &&FfiType
}

FfiAllocation :: struct {
    next     &FfiAllocation
    reserved u64
}

FfiSignature :: struct {
    next        &FfiSignature
    key         &u32
    result      &u32
    params      &&u32
    param_types &&FfiType
    result_type &FfiType
    arity       u32
    cif         [8]u64
}

FfiClosure :: struct {
    next      &FfiClosure
    signature &FfiSignature
    context   &u8
    address   &u8
    scope     &&u8
    chunk     &u8
    invoke    VmCallback
    entry     u32
}

FfiScope :: struct {
    allocations &FfiAllocation
    signatures  &FfiSignature
    closures    &FfiClosure
}

FfiLibrary :: struct {
    prepare         FfiPrepare
    call            FfiCall
    closure_alloc   ClosureAlloc
    closure_free    ClosureFree
    closure_prepare ClosurePrepare
    types           [12]&FfiType
}

ffi_library: &FfiLibrary = 0 as &FfiLibrary

FFI_STRUCT :: 13
MAX_PARAMS :: 255
CLOSURE_STORAGE_BYTES :: 64

ffi_error :: fn(message, name Str) {
    prefix := "\n\x1b[1;31m[vm error]\x1b[0m "
    sys.write_all(sys.STDERR, prefix.ptr, prefix.len)
    sys.write_all(sys.STDERR, message.ptr, message.len)
    if name.len != 0 {
        sys.write_all(sys.STDERR, c": ", 2)
        sys.write_all(sys.STDERR, name.ptr, name.len)
    }
    sys.write_all(sys.STDERR, c"\n", 1)
    sys.exit_process(1)
}

ffi_scope :: fn(slot &&u8) &FfiScope {
    if *slot == (0 as &u8) {
        *slot = mem.malloc(@sizeof(FfiScope))
        if *slot == (0 as &u8) { ffi_error("foreign call allocation failed", Str.empty()) }
        mem.mem_set(*slot, 0, @sizeof(FfiScope))
    }
    *slot as &FfiScope
}

ffi_alloc :: fn(slot &&u8, size u64) &u8 {
    scope := ffi_scope(slot)
    header := @sizeof(FfiAllocation)
    item := mem.malloc(header + size) as &FfiAllocation
    if item == (0 as &FfiAllocation) { ffi_error("foreign call allocation failed", Str.empty()) }
    item.next = scope.allocations
    scope.allocations = item
    data := (item as &u8) + header
    mem.mem_set(data, 0, size)
    data
}

ffi_symbol_address :: fn(name &u8) u64 {
    address := loader.find_symbol(name)
    if address != (0 as &u8) { ret address as u64 }
    ffi_error("undefined external symbol", Str.of(name))
    0
}

ffi_load :: fn(handle, name &u8) &u8 {
    address := loader.load_symbol(handle, name)
    if address == (0 as &u8) { ffi_error("missing libffi symbol", Str.of(name)) }
    address
}

ffi_pointer :: fn(T type, address &u8) T {
    result: T
    @memcpy(&result as &u8, &address as &u8, @sizeof(&u8))
    result
}

ffi_init :: fn() &FfiLibrary {
    if ffi_library != (0 as &FfiLibrary) { ret ffi_library }
    handle := loader.load_libffi()
    if handle == (0 as &u8) { ffi_error("VM foreign calls require libffi", Str.empty()) }
    library := mem.malloc(@sizeof(FfiLibrary)) as &FfiLibrary
    if library == (0 as &FfiLibrary) { ffi_error("foreign call allocation failed", Str.empty()) }
    library.prepare = ffi_pointer(FfiPrepare, ffi_load(handle, c"ffi_prep_cif"))
    library.call = ffi_pointer(FfiCall, ffi_load(handle, c"ffi_call"))
    library.closure_alloc = ffi_pointer(ClosureAlloc, ffi_load(handle, c"ffi_closure_alloc"))
    library.closure_free = ffi_pointer(ClosureFree, ffi_load(handle, c"ffi_closure_free"))
    library.closure_prepare = ffi_pointer(ClosurePrepare, ffi_load(handle, c"ffi_prep_closure_loc"))
    names := .[
        c"ffi_type_void"
        c"ffi_type_sint8"
        c"ffi_type_uint8"
        c"ffi_type_sint16"
        c"ffi_type_uint16"
        c"ffi_type_sint32"
        c"ffi_type_uint32"
        c"ffi_type_sint64"
        c"ffi_type_uint64"
        c"ffi_type_float"
        c"ffi_type_double"
        c"ffi_type_pointer"
    ]
    for index in Range.new(0, 12) {
        library.types[index] = ffi_load(handle, names[index]) as &FfiType
    }
    ffi_library = library
    library
}

ffi_skip :: fn(cursor &&u32) {
    kind := **cursor as FfiKind
    *cursor = *cursor + 1
    if kind == FfiKind.record or kind == FfiKind.callback {
        count := **cursor + (if kind == FfiKind.callback { 1 } else { 0 })
        *cursor = *cursor + 1
        for _ in Range.new(0, count as i32) { ffi_skip(cursor) }
    }
}

ffi_type :: fn(slot &&u8, library &FfiLibrary, cursor &&u32) &FfiType {
    kind := **cursor as FfiKind
    if (kind as u32) <= (FfiKind.pointer as u32) {
        *cursor = *cursor + 1
        ret library.types[kind as u32]
    }
    if kind == FfiKind.callback {
        ffi_skip(cursor)
        ret library.types[FfiKind.pointer as u32]
    }
    if kind == FfiKind.record {
        count := (*cursor)[1]
        *cursor = *cursor + 2
        layout := ffi_alloc(slot, @sizeof(FfiType)) as &FfiType
        layout.kind = FFI_STRUCT
        layout.elements = ffi_alloc(slot, ((count as u64) + 1) * @sizeof(&FfiType)) as &&FfiType
        for index in Range.new(0, count as i32) {
            layout.elements[index] = ffi_type(slot, library, cursor)
        }
        ret layout
    }
    ffi_error("unsupported C ABI type in VM foreign call", Str.empty())
    0 as &FfiType
}

ffi_abi :: fn() u32 {
    if target.target_os == target.Os.windows {
        if target.target_arch == target.Arch.aarch64 { ret 2 }
        ret 1
    }
    if target.target_arch == target.Arch.x86_64 { ret 2 }
    1
}

ffi_signature :: fn(slot &&u8, key &u32) &FfiSignature {
    if key == (0 as &u32) { ffi_error("foreign call has no function signature", Str.empty()) }
    library := ffi_init()
    scope := ffi_scope(slot)
    cached := scope.signatures
    while cached != (0 as &FfiSignature) {
        if cached.key == key { ret cached }
        cached = cached.next
    }
    sig := ffi_alloc(slot, @sizeof(FfiSignature)) as &FfiSignature
    count := *key
    if count > MAX_PARAMS { ffi_error("too many VM foreign call parameters", Str.empty()) }
    cursor := key + 1
    sig.key = key
    sig.arity = count
    sig.result = cursor
    sig.result_type = ffi_type(slot, library, &cursor)
    sig.params = ffi_alloc(slot, (count as u64) * @sizeof(&u32)) as &&u32
    sig.param_types = ffi_alloc(slot, (count as u64) * @sizeof(&FfiType)) as &&FfiType
    for index in Range.new(0, count as i32) {
        sig.params[index] = cursor
        sig.param_types[index] = ffi_type(slot, library, &cursor)
    }
    if library.prepare(&sig.cif[0] as &u8, ffi_abi(), count, sig.result_type, sig.param_types) !=
        0 {
        ffi_error("invalid C ABI signature", Str.empty())
    }
    sig.next = scope.signatures
    scope.signatures = sig
    sig
}

ffi_read :: fn(slot &&u8, kind FfiKind, data &u8, size u64) u64 {
    match kind {
        unit { 0 }
        i8_ { *(data as &i8) as u64 }
        i16_ { *(data as &i16) as u64 }
        i32_ { *(data as &i32) as u64 }
        u8_ { *data as u64 }
        u16_ { *(data as &u16) as u64 }
        u32_, f32_ { *(data as &u32) as u64 }
        pointer, callback { *(data as &&u8) as u64 }
        record {
            copy := ffi_alloc(slot, size)
            mem.mem_copy(copy, data, size)
            copy as u64
        }
        else { *(data as &u64) }
    }
}

ffi_write :: fn(
    slot &&u8
    invoke VmCallback
    chunk &u8
    descriptor &u32
    dest &u8
    value, size u64
) {
    kind := *descriptor as FfiKind
    match kind {
        unit {}
        i8_, u8_ { *dest = value as u8, ret }
        i16_, u16_ { *(dest as &u16) = value as u16, ret }
        i32_, u32_, f32_ { *(dest as &u32) = value as u32, ret }
        callback {
            address := value
            if (address >> 63) != 0 {
                address = ffi_callback(slot, invoke, chunk, address as u32, descriptor + 1)
            }
            if (address >> 62) != 0 {
                ffi_error("foreign function value is not a native callback", Str.empty())
            }
            *(dest as &&u8) = address as &u8
            ret
        }
        pointer { *(dest as &&u8) = value as &u8, ret }
        record { mem.mem_copy(dest, value as &u8, size) }
        else { *(dest as &u64) = value, ret }
    }
}

ffi_is_narrow_integer :: fn(kind FfiKind) bool {
    code := kind as u32
    code >= (FfiKind.i8_ as u32) and code <= (FfiKind.u32_ as u32)
}

ffi_invoke :: fn(cif, out &u8, args &&u8, data &u8) {
    closure := data as &FfiClosure
    sig := closure.signature
    values: [MAX_PARAMS]u64
    for index in Range.new(0, sig.arity as i32) {
        values[index] = ffi_read(
            closure.scope
            *sig.params[index] as FfiKind
            args[index]
            sig.param_types[index].size
        )
    }
    result := closure.invoke(closure.scope, closure.chunk, closure.entry, &values[0], sig.arity)
    kind := *sig.result as FfiKind
    if ffi_is_narrow_integer(kind) {
        *(out as &u64) = result
    } else {
        ffi_write(
            closure.scope
            closure.invoke
            closure.chunk
            sig.result
            out
            result
            sig.result_type.size
        )
    }
}

ffi_callback :: fn(slot &&u8, invoke VmCallback, chunk &u8, entry u32, key &u32) u64 {
    sig := ffi_signature(slot, key)
    scope := ffi_scope(slot)
    cached := scope.closures
    while cached != (0 as &FfiClosure) {
        if cached.chunk == chunk and cached.entry == entry and cached.signature == sig {
            ret cached.address as u64
        }
        cached = cached.next
    }
    closure := ffi_alloc(slot, @sizeof(FfiClosure)) as &FfiClosure
    closure.signature = sig
    closure.scope = slot
    closure.chunk = chunk
    closure.invoke = invoke
    closure.entry = entry
    library := ffi_init()
    closure.context = library.closure_alloc(CLOSURE_STORAGE_BYTES, &closure.address)
    callback: FfiTrampoline = ffi_invoke
    if closure.context == (0 as &u8) or
        library.closure_prepare(
            closure.context
            &sig.cif[0] as &u8
            callback
            closure as &u8
            closure.address
        ) !=
            0 {
        ffi_error("could not create a VM callback", Str.empty())
    }
    closure.next = scope.closures
    scope.closures = closure
    closure.address as u64
}

ffi_call :: fn(
    slot &&u8
    invoke VmCallback
    chunk &u8
    name &u8
    address u64
    key &u32
    args &u64
) u64 {
    if name != (0 as &u8) { address = ffi_symbol_address(name) }
    if address == 0 { ffi_error("null foreign function pointer", Str.empty()) }
    if name != (0 as &u8) and key != (0 as &u32) and key[0] == 1 and
        key[1] == (FfiKind.i32_ as u32) and
        key[2] == (FfiKind.pointer as u32) {
        text := Str.of(name)
        if text.eq("puts") or text.eq("remove") {
            call := ffi_pointer(CStrCall, address as &u8)
            ret call(args[0] as &u8) as u64
        }
    }
    sig := ffi_signature(slot, key)
    slots: [MAX_PARAMS]u64
    values: [MAX_PARAMS]&u8
    for index in Range.new(0, sig.arity as i32) {
        descriptor := sig.params[index]
        if (*descriptor as FfiKind) == FfiKind.record {
            values[index] = args[index] as &u8
        } else {
            values[index] = &slots[index] as &u8
            ffi_write(
                slot
                invoke
                chunk
                descriptor
                values[index]
                args[index]
                sig.param_types[index].size
            )
        }
    }
    kind := *sig.result as FfiKind
    scalar: u64 = 0
    result := if kind == FfiKind.record { ffi_alloc(slot, sig.result_type.size) } else {
        &scalar as &u8
    }
    library := ffi_init()
    library.call(&sig.cif[0] as &u8, ffi_pointer(FfiFunction, address as &u8), result, &values[0])
    if kind == FfiKind.record { ret result as u64 }
    ffi_read(slot, kind, result, sig.result_type.size)
}

ffi_destroy :: fn(ptr &u8) {
    if ptr == (0 as &u8) { ret }
    scope := ptr as &FfiScope
    closure := scope.closures
    while closure != (0 as &FfiClosure) {
        library := ffi_init()
        library.closure_free(closure.context)
        closure = closure.next
    }
    item := scope.allocations
    while item != (0 as &FfiAllocation) {
        next := item.next
        mem.free(item as &u8)
        item = next
    }
    mem.free(ptr)
}

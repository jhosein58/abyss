type_defs :: @import("compiler/types")

FfiKind :: enum u32 {
    unit
    i8_
    u8_
    i16_
    u16_
    i32_
    u32_
    i64_
    u64_
    f32_
    f64_
    pointer
    record
    callback
    invalid
}

append_ffi_signature :: fn(types &type_defs.TypeStorage, signature &Vec(u32), ty u32) {
    params := types.func_params(ty)
    signature.push(params.len as u32)
    append_ffi_type(types, signature, types.func_return(ty))
    for param in params {
        append_ffi_type(types, signature, param)
    }
}

ffi_scalar_kind :: fn(types &type_defs.TypeStorage, ty u32) FfiKind {
    kind := types.kind(ty)
    match kind {
        unit { FfiKind.unit }
        bool { FfiKind.u8_ }
        ptr { FfiKind.pointer }
        float {
            width := types.payload(ty)
            if width == 32 { FfiKind.f32_ } else if width == 64 { FfiKind.f64_ } else {
                FfiKind.invalid
            }
        }
        int, uint {
            width := types.payload(ty)
            if width == 8 or width == 16 or width == 32 or width == 64 {
                base := if width == 8 { 0 } else if width == 16 { 2 } else if width == 32 {
                    4
                } else { 6 }
                (base + (if kind == type_defs.TyKind.int { 1 } else { 2 })) as FfiKind
            } else {
                FfiKind.invalid
            }
        }
        else { FfiKind.invalid }
    }
}

append_ffi_type :: fn(types &type_defs.TypeStorage, signature &Vec(u32), ty u32) {
    kind := types.kind(ty)
    if kind == type_defs.TyKind.nominal {
        append_ffi_type(types, signature, types.nominal_base(ty))
    } else if kind == type_defs.TyKind.enum_ {
        append_ffi_type(types, signature, types.enum_backing(ty))
    } else if types.struct_is_extern(ty) {
        fields := types.get_struct_fields(ty)
        signature.push(FfiKind.record as u32)
        signature.push((fields.len / 2) as u32)
        for field in fields.chunks(2) {
            append_ffi_type(types, signature, field.get(1))
        }
    } else if kind == type_defs.TyKind.func {
        signature.push(FfiKind.callback as u32)
        append_ffi_signature(types, signature, ty)
    } else {
        signature.push(ffi_scalar_kind(types, ty) as u32)
    }
}

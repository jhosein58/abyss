import .chunk: Chunk
import .op:    OpCode
import .codegen: vm_entry_tag, vm_extern_tag

print_cstr :: extern fn(s &u8)

print_bytes :: extern fn(s &u8, len u64)

print_char :: extern fn(c u8)

print_bool :: extern fn(v bool)

print_i8 :: extern fn(v i8)

print_i16 :: extern fn(v i16)

print_i32 :: extern fn(v i32)

print_i64 :: extern fn(v i64)

print_u8 :: extern fn(v u8)

print_u16 :: extern fn(v u16)

print_u32 :: extern fn(v u32)

print_u64 :: extern fn(v u64)

print_f32 :: extern fn(v f32)

print_f64 :: extern fn(v f64)

string_float64 :: extern fn(ptr &u8, capacity u64, value f64) u64
malloc :: extern fn(size u64) &u8
realloc :: extern fn(ptr &u8, size u64) &u8
free :: extern fn(ptr &u8)

mem_copy :: extern fn(dest &u8, src &u8, n u64)

mem_set :: extern fn(dest &u8, val u8, n u64)

file_open :: extern fn(path, mode &u8) &u8
file_close :: extern fn(handle &u8) i32
file_seek :: extern fn(handle &u8, offset i64, w i32) i32
file_tell :: extern fn(handle &u8) i64
file_read :: extern fn(handle, ptr &u8, s, count u64) u64
file_write :: extern fn(handle, ptr &u8, s, count u64) u64
get_arg_count :: extern fn() i32
get_arg :: extern fn(idx i32) &u8
get_env :: extern fn(name &u8) &u8
abyss_fall :: extern fn()

compile_and_run :: extern fn(path &u8) i32
str_len :: extern fn(s &u8) u64
dir_open :: extern fn(path &u8) &u8
dir_read :: extern fn(handle &u8) &u8
dir_close :: extern fn(handle &u8) i32
dir_create :: extern fn(path &u8) i32

VmCallback :: fn(&&u8, &u8, u32, &u64, u32) u64

abyss_ffi_call :: extern fn(scope &&u8, invoke VmCallback, chunk &u8, name &u8, address u64, signature &u32, args &u64) u64
abyss_ffi_callback :: extern fn(scope &&u8, invoke VmCallback, chunk &u8, entry u32, signature &u32) u64
abyss_ffi_alloc :: extern fn(scope &&u8, size u64) &u8
abyss_ffi_destroy :: extern fn(scope &u8)
abyss_ffi_symbol_address :: extern fn(name &u8) u64

invoke_vm_callback :: fn(scope &&u8, chunk &u8, entry u32, argv &u64, argc u32) u64 {
    vm := Vm.new()
    vm.ffi_owner = scope
    value := vm.run_with_args(chunk as &Chunk, entry, Slice(u64).new(argv, argc as u64))
    vm.destroy()
    value
}

vm_noop :: fn() {}

float_binary :: fn(T type, op OpCode, a, b T) u64 {
    if op == OpCode.eq { ret (a == b) as u64 }
    if op == OpCode.ne { ret (a != b) as u64 }
    if op == OpCode.lt { ret (a < b) as u64 }
    if op == OpCode.le { ret (a <= b) as u64 }
    if op == OpCode.gt { ret (a > b) as u64 }
    if op == OpCode.ge { ret (a >= b) as u64 }
    res := if op == OpCode.add {
        a + b
    } else if op == OpCode.sub {
        a - b
    } else if op == OpCode.mul {
        a * b
    } else {
        a / b
    }
    bits: u64 = 0
    *(&bits as &T) = res
    bits
}

Vm :: struct {
    stack     Vec(u64)
    locals    Vec(u64)
    frames_ip Vec(u32)
    frames_fp Vec(u32)
    ffi_scope &u8
    ffi_owner &&u8
    new :: fn() Self {
        .{ stack: Vec(u64).with_cap(4096), locals: Vec(u64).with_cap(4096), frames_ip: Vec(u32).with_cap(1024), frames_fp: Vec(u32).with_cap(1024), ffi_scope: 0 as &u8, ffi_owner: 0 as &&u8 }
    }

    destroy :: fn(self &Self) {
        self.stack.destroy()
        self.locals.destroy()
        self.frames_ip.destroy()
        self.frames_fp.destroy()
        abyss_ffi_destroy(self.ffi_scope)
    }

    ensure_local_slot :: fn(self &Self, idx u32) {
        target := idx as u64
        while self.locals.len <= target {
            self.locals.push(0)
        }
    }

    dispatch_extern :: fn(self &Self, prog &Chunk, id u32, arg_count u8) {
        if id == 1 {
            s := self.stack.pop() as &u8
            print_cstr(s)
            self.stack.push(0)
        } else if id == 2 {
            v := self.stack.pop() as i32
            print_i32(v)
            self.stack.push(0)
        } else if id == 3 {
            v := self.stack.pop() as u32
            print_u32(v)
            self.stack.push(0)
        } else if id == 4 {
            v := self.stack.pop()
            print_bool(v != 0)
            self.stack.push(0)
        } else if id == 5 {
            c := self.stack.pop() as u8
            print_char(c)
            self.stack.push(0)
        } else if id == 6 {
            sz := self.stack.pop()
            p := malloc(sz) as u64
            self.stack.push(p)
        } else if id == 7 {
            p := self.stack.pop() as &u8
            free(p)
            self.stack.push(0)
        } else if id == 8 {
            n := self.stack.pop()
            src := self.stack.pop() as &u8
            dst := self.stack.pop() as &u8
            mem_copy(dst, src, n)
            self.stack.push(0)
        } else if id == 9 {
            n := self.stack.pop()
            v := self.stack.pop() as u8
            dst := self.stack.pop() as &u8
            mem_set(dst, v, n)
            self.stack.push(0)
        } else if id == 10 {
            v := self.stack.pop() as i64
            print_i64(v)
            self.stack.push(0)
        } else if id == 11 {
            v := self.stack.pop()
            print_u64(v)
            self.stack.push(0)
        } else if id == 12 {
            v := self.stack.pop() as i8
            print_i8(v)
            self.stack.push(0)
        } else if id == 13 {
            v := self.stack.pop() as i16
            print_i16(v)
            self.stack.push(0)
        } else if id == 14 {
            v := self.stack.pop() as u8
            print_u8(v)
            self.stack.push(0)
        } else if id == 15 {
            v := self.stack.pop() as u16
            print_u16(v)
            self.stack.push(0)
        } else if id == 16 {
            sz := self.stack.pop()
            p := self.stack.pop() as &u8
            res := realloc(p, sz) as u64
            self.stack.push(res)
        } else if id == 17 {
            bits := self.stack.pop()
            f_val := *(&bits as &f32)
            print_f32(f_val)
            self.stack.push(0)
        } else if id == 18 {
            bits := self.stack.pop()
            f_val := *(&bits as &f64)
            print_f64(f_val)
            self.stack.push(0)
        } else if id == 19 {
            mode := self.stack.pop() as &u8
            path := self.stack.pop() as &u8
            res := file_open(path, mode) as u64
            self.stack.push(res)
        } else if id == 20 {
            handle := self.stack.pop() as &u8
            res := file_close(handle) as u64
            self.stack.push(res)
        } else if id == 21 {
            w := self.stack.pop() as i32
            offset := self.stack.pop() as i64
            handle := self.stack.pop() as &u8
            res := file_seek(handle, offset, w) as u64
            self.stack.push(res)
        } else if id == 22 {
            handle := self.stack.pop() as &u8
            res := file_tell(handle) as u64
            self.stack.push(res)
        } else if id == 23 {
            count := self.stack.pop()
            size := self.stack.pop()
            ptr := self.stack.pop() as &u8
            handle := self.stack.pop() as &u8
            res := file_read(handle, ptr, size, count)
            self.stack.push(res)
        } else if id == 24 {
            count := self.stack.pop()
            size := self.stack.pop()
            ptr := self.stack.pop() as &u8
            handle := self.stack.pop() as &u8
            res := file_write(handle, ptr, size, count)
            self.stack.push(res)
        } else if id == 25 {
            res := get_arg_count() as u64
            self.stack.push(res)
        } else if id == 26 {
            idx := self.stack.pop() as i32
            res := get_arg(idx) as u64
            self.stack.push(res)
        } else if id == 27 {
            name := self.stack.pop() as &u8
            res := get_env(name) as u64
            self.stack.push(res)
        } else if id == 28 {
            s := self.stack.pop() as &u8
            res := str_len(s)
            self.stack.push(res)
        } else if id == 29 {
            abyss_fall()
            self.stack.push(0)
        } else if id == 30 {
            path := self.stack.pop() as &u8
            res := compile_and_run(path) as u64
            self.stack.push(res)
        } else if id == 31 {
            self.stack.pop()
            self.stack.push(0)
        } else if id == 32 {
            len := self.stack.pop()
            ptr := self.stack.pop() as &u8
            print_bytes(ptr, len)
            self.stack.push(0)
        } else if id == 33 {
            print_i64(self.stack.pop() as i64)
            self.stack.push(0)
        } else if id == 34 {
            print_u64(self.stack.pop())
            self.stack.push(0)
        } else if id == 35 {
            bits := self.stack.pop()
            capacity := self.stack.pop()
            ptr := self.stack.pop() as &u8
            self.stack.push(string_float64(ptr, capacity, *(&bits as &f64)))
        } else if id == 36 {
            self.stack.push(dir_open(self.stack.pop() as &u8) as u64)
        } else if id == 37 {
            self.stack.push(dir_read(self.stack.pop() as &u8) as u64)
        } else if id == 38 {
            self.stack.push(dir_close(self.stack.pop() as &u8) as u64)
        } else if id == 39 {
            self.stack.push(dir_create(self.stack.pop() as &u8) as u64)
        } else if id >= 100 {
            foreign := prog.externs.get((id - 100) as u64)
            self.call_foreign(prog, foreign.name, 0, foreign.signature, arg_count)
        } else {
            self.stack.push(0)
        }
    }

    scope :: fn(self &Self) &&u8 {
        if self.ffi_owner != (0 as &&u8) {
            ret self.ffi_owner
        }
        &self.ffi_scope
    }

    call_foreign :: fn(self &Self, prog &Chunk, name &u8, address u64, signature &u32, argc u8) {
        start := self.stack.len - (argc as u64)
        args := self.stack.as_slice().ptr + start
        invoke: VmCallback = invoke_vm_callback
        result := abyss_ffi_call(self.scope(), invoke, prog as &u8, name, address, signature, args)
        self.stack.reset(start)
        self.stack.push(result)
    }

    push_frame :: fn(self &Self, ip, fp, argc u32) u32 {
        next := self.locals.len as u32
        self.frames_ip.push(ip)
        self.frames_fp.push(fp)
        while self.locals.len < ((next + argc) as u64) {
            self.locals.push(0)
        }
        i := argc
        while i > 0 {
            i = i - 1
            self.locals.set((next + i) as u64, self.stack.pop())
        }
        next
    }

    run :: fn(self &Self, prog &Chunk, entry_ip u32) u64 {
        self.run_with_args(prog, entry_ip, Slice(u64).empty())
    }

    run_with_args :: fn(self &Self, prog &Chunk, entry_ip u32, args Slice(u64)) u64 {
        ip := entry_ip
        fp: u32 = 0

        self.frames_ip.clear()
        self.frames_fp.clear()
        self.stack.clear()
        self.locals.clear()
        self.locals.extend(args.ptr, args.len)

        while ip < (prog.buf.len as u32) {
            op := prog.buf.get(ip as u64) as OpCode
            ip = ip + 1

            match op {
                halt {
                    break
                }
                push_const {
                    idx := prog.read_u16(ip)
                    ip = ip + 2
                    self.stack.push(prog.const.get(idx as u64))
                }
                push_0 {
                    self.stack.push(0)
                }
                udiv, umod, ult, ule, ugt, uge {
                    b := self.stack.pop()
                    a := self.stack.pop()
                    result: u64 = 0
                    if op == OpCode.udiv {
                        result = a / b
                    } else if op == OpCode.umod {
                        result = a % b
                    } else if op == OpCode.ult {
                        if a < b {
                            result = 1
                        }
                    } else if op == OpCode.ule {
                        if a <= b {
                            result = 1
                        }
                    } else if op == OpCode.ugt {
                        if a > b {
                            result = 1
                        }
                    } else if op == OpCode.uge {
                        if a >= b {
                            result = 1
                        }
                    }
                    self.stack.push(result)
                }
                push_1 {
                    self.stack.push(1)
                }
                pop {
                    if self.stack.len > 0 {
                        self.stack.pop()
                    }
                }
                dup {
                    top := self.stack.get(self.stack.len - 1)
                    self.stack.push(top)
                }
                load_local {
                    slot := prog.read_u16(ip) as u32
                    ip = ip + 2
                    target := (fp + slot) as u64
                    if target < self.locals.len {
                        self.stack.push(self.locals.get(target))
                    } else {
                        self.stack.push(0)
                    }
                }
                store_local {
                    slot := prog.read_u16(ip) as u32
                    ip = ip + 2
                    val := self.stack.pop()
                    self.ensure_local_slot(fp + slot)
                    self.locals.set((fp + slot) as u64, val)
                }
                addr_local {
                    slot := prog.read_u16(ip) as u32
                    ip = ip + 2
                    self.ensure_local_slot(fp + slot)
                    addr := self.locals.ptr_at((fp + slot) as u64) as u64
                    self.stack.push(addr)
                }
                load64 {
                    ptr := self.stack.pop() as &u64
                    self.stack.push(*ptr)
                }
                store64 {
                    ptr := self.stack.pop() as &u64
                    val := self.stack.pop()
                    *ptr = val
                    vm_noop()
                }
                load32 {
                    ptr := self.stack.pop() as &u32
                    self.stack.push(*ptr as u64)
                }
                store32 {
                    ptr := self.stack.pop() as &u32
                    val := self.stack.pop() as u32
                    *ptr = val
                    vm_noop()
                }
                load16 {
                    ptr := self.stack.pop() as &u16
                    self.stack.push(*ptr as u64)
                }
                store16 {
                    ptr := self.stack.pop() as &u16
                    val := self.stack.pop() as u16
                    *ptr = val
                    vm_noop()
                }
                load8 {
                    ptr := self.stack.pop() as &u8
                    self.stack.push(*ptr as u64)
                }
                store8 {
                    ptr := self.stack.pop() as &u8
                    val := self.stack.pop() as u8
                    *ptr = val
                    vm_noop()
                }
                add {
                    b := self.stack.pop()
                    a := self.stack.pop()
                    self.stack.push(a + b)
                }
                sub {
                    b := self.stack.pop()
                    a := self.stack.pop()
                    self.stack.push(a - b)
                }
                mul {
                    b := self.stack.pop()
                    a := self.stack.pop()
                    self.stack.push(a * b)
                }
                div {
                    b := self.stack.pop() as i64
                    a := self.stack.pop() as i64
                    if b == 0 {
                        self.stack.push(0)
                    } else {
                        self.stack.push((a / b) as u64)
                    }
                }
                mod {
                    b := self.stack.pop() as i64
                    a := self.stack.pop() as i64
                    if b == 0 {
                        self.stack.push(0)
                    } else {
                        self.stack.push((a % b) as u64)
                    }
                }
                neg {
                    a := self.stack.pop() as i64
                    self.stack.push((-a) as u64)
                }
                bit_and {
                    b := self.stack.pop()
                    a := self.stack.pop()
                    self.stack.push(a & b)
                }
                bit_or {
                    b := self.stack.pop()
                    a := self.stack.pop()
                    self.stack.push(a | b)
                }
                bit_xor {
                    b := self.stack.pop()
                    a := self.stack.pop()
                    self.stack.push(a ^ b)
                }
                bit_not {
                    a := self.stack.pop()
                    self.stack.push(~a)
                }
                shl {
                    b := self.stack.pop()
                    a := self.stack.pop()
                    self.stack.push(a << b)
                }
                shr {
                    b := self.stack.pop()
                    a := self.stack.pop()
                    self.stack.push(a >> b)
                }
                eq {
                    b := self.stack.pop()
                    a := self.stack.pop()
                    self.stack.push(if a == b {
                        1
                    } else {
                        0
                    })
                }
                ne {
                    b := self.stack.pop()
                    a := self.stack.pop()
                    self.stack.push(if a != b {
                        1
                    } else {
                        0
                    })
                }
                lt {
                    b := self.stack.pop() as i64
                    a := self.stack.pop() as i64
                    self.stack.push(if a < b {
                        1
                    } else {
                        0
                    })
                }
                le {
                    b := self.stack.pop() as i64
                    a := self.stack.pop() as i64
                    self.stack.push(if a <= b {
                        1
                    } else {
                        0
                    })
                }
                gt {
                    b := self.stack.pop() as i64
                    a := self.stack.pop() as i64
                    self.stack.push(if a > b {
                        1
                    } else {
                        0
                    })
                }
                ge {
                    b := self.stack.pop() as i64
                    a := self.stack.pop() as i64
                    self.stack.push(if a >= b {
                        1
                    } else {
                        0
                    })
                }
                l_not {
                    a := self.stack.pop()
                    self.stack.push(if a == 0 {
                        1
                    } else {
                        0
                    })
                }
                jmp {
                    target := prog.read_u32(ip)
                    ip = target
                    vm_noop()
                    vm_noop()
                }
                jmp_if_false {
                    target := prog.read_u32(ip)
                    ip = ip + 4
                    cond := self.stack.pop()
                    if cond == 0 {
                        ip = target
                    }
                }
                jmp_if_true {
                    target := prog.read_u32(ip)
                    ip = ip + 4
                    cond := self.stack.pop()
                    if cond != 0 {
                        ip = target
                    }
                }
                call {
                    target := prog.read_u32(ip)
                    argc := prog.read_u8(ip + 4)
                    ip = ip + 5
                    fp = self.push_frame(ip, fp, argc as u32)
                    ip = target
                    vm_noop()
                }
                call_extern {
                    ext_id := prog.read_u16(ip) as u32
                    argc := prog.read_u8(ip + 2)
                    ip = ip + 3
                    self.dispatch_extern(prog, ext_id, argc)
                }
                call_ptr {
                    argc := prog.read_u8(ip)
                    sig := prog.const.get(prog.read_u16(ip + 1) as u64) as &u32
                    pos := if prog.read_u8(ip + 3) == 1 {
                        self.stack.len - 1 - (argc as u64)
                    } else {
                        self.stack.len - 1
                    }
                    ip = ip + 4
                    address := self.stack.get(pos)
                    for i in Range.new(0, (self.stack.len - 1 - pos) as i32) {
                        index := pos + (i as u64)
                        self.stack.set(index, self.stack.get(index + 1))
                    }
                    self.stack.pop()
                    if (address & vm_entry_tag()) != 0 {
                        fp = self.push_frame(ip, fp, argc as u32)
                        ip = address as u32
                    } else if (address & vm_extern_tag()) != 0 {
                        self.dispatch_extern(prog, address as u32, argc)
                    } else {
                        self.call_foreign(prog, 0 as &u8, address, sig, argc)
                    }
                }
                ffi_symbol {
                    foreign := prog.externs.get(prog.read_u16(ip) as u64)
                    ip = ip + 2
                    self.stack.push(abyss_ffi_symbol_address(foreign.name))
                }
                ffi_callback {
                    sig := prog.const.get(prog.read_u16(ip) as u64) as &u32
                    ip = ip + 2
                    value := self.stack.pop()
                    if (value & vm_entry_tag()) != 0 {
                        invoke: VmCallback = invoke_vm_callback
                        value = abyss_ffi_callback(self.scope(), invoke, prog as &u8, value as u32, sig)
                    }
                    self.stack.push(value)
                }
                float_binary {
                    op := prog.read_u8(ip) as OpCode
                    width := prog.read_u8(ip + 1)
                    ip = ip + 2
                    b := self.stack.pop()
                    a := self.stack.pop()
                    if width == 32 {
                        self.stack.push(float_binary(f32, op, *(&a as &f32), *(&b as &f32)))
                    } else {
                        self.stack.push(float_binary(f64, op, *(&a as &f64), *(&b as &f64)))
                    }
                }
                alloc_ffi {
                    size := self.stack.pop()
                    self.stack.push(abyss_ffi_alloc(self.scope(), size) as u64)
                }
                copy_ffi {
                    size := prog.const.get(prog.read_u16(ip) as u64)
                    ip = ip + 2
                    dest := self.stack.pop() as &u8
                    src := self.stack.pop() as &u8
                    if dest != src {
                        mem_copy(dest, src, size)
                    }
                }
                ret_val {
                    rv: u64 = 0
                    if self.stack.len > 0 {
                        rv = self.stack.pop()
                    }
                    if self.frames_ip.len == 0 {
                        self.stack.push(rv)
                        break
                    }
                    self.locals.reset(fp as u64)
                    ip = self.frames_ip.pop()
                    fp = self.frames_fp.pop()
                    self.stack.push(rv)
                }
                f64_to_f32 {
                    bits := self.stack.pop()
                    d := *(&bits as &f64)
                    f := d as f32
                    f_bits: u64 = 0
                    *(&f_bits as &f32) = f
                    self.stack.push(f_bits)
                }
                f32_to_f64 {
                    bits := self.stack.pop()
                    value: f64 = 0.0
                    value = *(&bits as &f32) as f64
                    self.stack.push(*(&value as &u64))
                }
                i64_to_f64, u64_to_f64 {
                    bits := self.stack.pop()
                    value: f64 = 0.0
                    if op == OpCode.i64_to_f64 {
                        value = (bits as i64) as f64
                    } else {
                        value = bits as f64
                    }
                    self.stack.push(*(&value as &u64))
                }
                f64_to_i64 {
                    bits := self.stack.pop()
                    self.stack.push((*(&bits as &f64) as i64) as u64)
                }
                cast_integer {
                    width := prog.buf.get(ip as u64) as u32
                    signed := prog.buf.get((ip + 1) as u64) != 0
                    ip = ip + 2
                    value := self.stack.pop()
                    if width < 64 {
                        mask := ((1 as u64) << (width as u64)) - 1
                        value = value & mask
                        if signed and ((value & ((1 as u64) << ((width - 1) as u64))) != 0) {
                            value = value | ~mask
                        }
                    }
                    self.stack.push(value)
                }
                f32_to_i32 {
                    bits := self.stack.pop()
                    f := *(&bits as &f32)
                    self.stack.push((f as i32) as u64)
                }
                else {}
            }
        }

        if self.stack.len > 0 {
            ret self.stack.pop()
        }
        0
    }
}

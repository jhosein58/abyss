import Str, String from "std/string"
import Arena from "std/allocator"
import fmt from "std/fmt"
import write_str from "std/io"
import sort, sort_chunks from "std/sort"
import hash_combine, hash_words from "std/hash"

TyKind :: enum u8 {
    unknown,
    infer,
    untyped_int,
    untyped_float,
    int,
    uint,
    float,
    bool,
    ptr,
    type_,
    unit,
    func,
    never,
    struct_,
    array,
    error,
    nominal,
    enum_,
    union_
}

ty_kind_name :: fn(k TyKind) Str {
    names: [19]Str = .[
        "Unknown", "Infer", "UtInt", "UtFloat", "Int", "UInt", "Float", "Bool",
        "Ptr", "Type", "Unit", "Func", "Never", "Struct", "Array", "Error",
        "Nominal", "Enum", "Union"
    ]
    names[k as u64]
}

ty_id_none          :: fn() u32 { 4294967295 as u32 }
ty_id_unknown       :: fn() u32 { 0 }
ty_id_untyped_int   :: fn() u32 { 1 }
ty_id_untyped_float :: fn() u32 { 2 }
ty_id_bool          :: fn() u32 { 3 }
ty_id_type          :: fn() u32 { 4 }
ty_id_unit          :: fn() u32 { 5 }
ty_id_never         :: fn() u32 { 6 }
ty_id_error         :: fn() u32 { 7 }
ty_builtin_count    :: fn() u32 { 8 }

TypeStorage :: struct {
    kinds Vec(TyKind)
    payloads, next, extra_data Vec(u32)
    intern HashMap(u32, u32)
    names Vec(Str)
    origin_types HashMap(u32, u32)
    nominal_creators HashMap(u32, u32)
    nominal_creator_items Vec(u32)
    nominal_struct_node HashMap(u32, u32)
    dependent_funcs HashSet(u32)

    new :: fn() Self {
        result: Self = .{
            kinds: Vec(TyKind).new(), payloads: Vec(u32).new(),
            next: Vec(u32).new(), extra_data: Vec(u32).new(),
            intern: HashMap(u32, u32).new(), names: Vec(Str).new(),
            origin_types: HashMap(u32, u32).new(),
            nominal_creators: HashMap(u32, u32).new(),
            nominal_creator_items: Vec(u32).new(),
            nominal_struct_node: HashMap(u32, u32).new(),
            dependent_funcs: HashSet(u32).new()
        }
        builtins: [8]TyKind = .[
            TyKind.unknown, TyKind.untyped_int, TyKind.untyped_float, TyKind.bool,
            TyKind.type_, TyKind.unit, TyKind.never, TyKind.error
        ]
        for kind in Slice(TyKind).new(&builtins[0], 8) { result.push(kind, 0) }
        result
    }

    destroy :: fn(self &Self) {
        self.kinds.destroy()
        self.payloads.destroy()
        self.next.destroy()
        self.extra_data.destroy()
        self.intern.destroy()
        self.names.destroy()
        self.origin_types.destroy()
        self.nominal_creators.destroy()
        self.nominal_creator_items.destroy()
        self.nominal_struct_node.destroy()
        self.dependent_funcs.destroy()
    }

    len :: fn(self &Self) u32 {
        self.kinds.len as u32
    }

    kind :: fn(self &Self, id u32) TyKind {
        if id == ty_id_none() { TyKind.unknown } else { self.kinds.get(id as u64) }
    }

    payload :: fn(self &Self, id u32) u32 {
        self.payloads.get(id as u64)
    }

    push :: fn(self &Self, kind TyKind, payload u32) u32 {
        id := self.len()
        self.kinds.push(kind)
        self.payloads.push(payload)
        self.next.push(ty_id_none())
        id
    }

    append_record :: fn(self &Self, header Slice(u32), items Slice(u32)) u32 {
        start := self.extra_data.len as u32
        offset := (items.ptr as u64 - self.extra_data.ptr as u64) / @sizeof(u32)
        borrowed := (items.ptr as u64 >= self.extra_data.ptr as u64) and (offset < self.extra_data.len)
        self.extra_data.reserve(header.len + items.len)
        if borrowed { items.ptr = self.extra_data.ptr_at(offset) }
        self.extra_data.extend(header.ptr, header.len)
        self.extra_data.extend(items.ptr, items.len)
        start
    }

    alloc_unknown :: fn() u32 { ty_id_unknown() }

    alloc_untyped_int :: fn() u32 { ty_id_untyped_int() }

    alloc_untyped_float :: fn() u32 { ty_id_untyped_float() }

    alloc_bool :: fn() u32 { ty_id_bool() }

    alloc_type :: fn() u32 { ty_id_type() }

    alloc_unit :: fn() u32 { ty_id_unit() }

    alloc_never :: fn() u32 { ty_id_never() }

    alloc_error :: fn() u32 { ty_id_error() }

    extra :: fn(self &Self, id u32, offset u64) u32 {
        self.extra_data.get(self.payload(id) as u64 + offset)
    }

    items :: fn(self &Self, id u32, offset u64, count u64) Slice(u32) {
        Slice(u32).new(self.extra_data.ptr_at(self.payload(id) as u64 + offset), count)
    }

    intern_type :: fn(self &Self, kind TyKind, header Slice(u32), items Slice(u32)) u32 {
        inline := (kind != TyKind.array) and (kind != TyKind.func) and
                  (kind != TyKind.struct_) and (kind != TyKind.union_)
        h := hash_words(items, hash_words(header, hash_combine(2166136261, kind as u32)))
        bucket := self.intern.get(h)
        first := if bucket == (0 as &u32) { ty_id_none() } else { *bucket }
        id := first
        while id != ty_id_none() {
            if self.kind(id) == kind {
                stored := if inline {
                    Slice(u32).new(self.payloads.ptr_at(id as u64), 1)
                } else { self.items(id, 0, header.len + items.len) }
                if stored.sub(0, header.len).equals(header) and stored.sub(header.len, items.len).equals(items) {
                    ret id
                }
            }
            id = self.next.get(id as u64)
        }
        payload := if inline { header.get(0) } else { self.append_record(header, items) }
        id = self.push(kind, payload)
        self.next.set(id as u64, first)
        self.intern.insert(h, id)
        id
    }

    get_or_insert_simple :: fn(self &Self, kind TyKind, payload u32) u32 {
        self.intern_type(kind, Slice(u32).new(&payload, 1), Slice(u32).empty())
    }

    alloc_infer :: fn(self &Self, slot u32) u32 {
        self.get_or_insert_simple(TyKind.infer, slot)
    }

    alloc_int :: fn(self &Self, width u16) u32 {
        self.get_or_insert_simple(TyKind.int, width as u32)
    }

    alloc_uint :: fn(self &Self, width u16) u32 {
        self.get_or_insert_simple(TyKind.uint, width as u32)
    }

    alloc_float :: fn(self &Self, width u16) u32 {
        self.get_or_insert_simple(TyKind.float, width as u32)
    }

    alloc_ptr :: fn(self &Self, inner u32) u32 {
        self.get_or_insert_simple(TyKind.ptr, inner)
    }

    alloc_array :: fn(self &Self, ty u32, len u32) u32 {
        header: [2]u32 = .[ty, len]
        self.intern_type(TyKind.array, Slice(u32).new(&header[0], 2), Slice(u32).empty())
    }

    alloc_func :: fn(self &Self, params Slice(u32), ret_ty u32, is_extern bool) u32 {
        header: [2]u32 = .[((params.len as u32) << 16) | (is_extern as u32), ret_ty]
        self.intern_type(TyKind.func, Slice(u32).new(&header[0], 2), params)
    }

    alloc_nominal :: fn(self &Self, base u32, name Str, origin u32) u32 {
        generic := (origin & 2147483648) != 0
        if not generic {
            existing := self.origin_types.get(origin)
            if existing != (0 as &u32) { ret *existing }
        }
        header: [3]u32 = .[base, self.names.len as u32, origin]
        self.names.push(name)
        payload := self.append_record(Slice(u32).new(&header[0], 3), Slice(u32).empty())
        id := self.push(TyKind.nominal, payload)
        if not generic { self.origin_types.insert(origin, id) }
        id
    }

    nominal_base :: fn(self &Self, id u32) u32 { self.extra(id, 0) }

    set_nominal_base :: fn(self &Self, id u32, base u32) {
        self.extra_data.set(self.payload(id) as u64, base)
    }

    nominal_origin :: fn(self &Self, id u32) u32 { self.extra(id, 2) }

    nominal_name :: fn(self &Self, id u32) Str { self.names.get(self.extra(id, 1) as u64) }

    record_nominal_creator :: fn(self &Self, origin u32, sym u32, args Slice(u32)) {
        if (origin & 2147483648) == 0 { ret }
        origin = origin & 2147483647
        start := self.nominal_creator_items.len as u32
        self.nominal_creator_items.push(sym)
        self.nominal_creator_items.push(args.len as u32)
        self.nominal_creator_items.extend(args.ptr, args.len)
        self.nominal_creators.insert(origin, start)
    }

    get_nominal_creator_sym :: fn(self &Self, origin u32) u32 {
        start_ptr := self.nominal_creator_index(origin)
        if start_ptr == (0 as &u32) { ret ty_id_none() }
        self.nominal_creator_items.get(*start_ptr as u64)
    }

    get_nominal_creator_args :: fn(self &Self, origin u32) Slice(u32) {
        start_ptr := self.nominal_creator_index(origin)
        if start_ptr == (0 as &u32) { ret Slice(u32).empty() }
        start := *start_ptr as u64
        len := self.nominal_creator_items.get(start + 1)
        self.nominal_creator_items.as_slice().sub(start + 2, len as u64)
    }

    nominal_creator_index :: fn(self &Self, origin u32) &u32 {
        if (origin & 2147483648) == 0 { ret 0 as &u32 }
        self.nominal_creators.get(origin & 2147483647)
    }

    record_nominal_struct_node :: fn(self &Self, origin u32, node u32) {
        if (origin & 2147483648) == 0 { ret }
        origin = origin & 2147483647
        self.nominal_struct_node.insert(origin, node)
    }

    get_nominal_struct_node :: fn(self &Self, origin u32) u32 {
        if (origin & 2147483648) == 0 { ret ty_id_none() }
        origin = origin & 2147483647
        node := self.nominal_struct_node.get(origin)
        if node == (0 as &u32) { ret ty_id_none() }
        *node
    }

    alloc_struct :: fn(self &Self, fields Slice(u32)) u32 {
        sort_chunks(fields, 2)
        count := (fields.len / 2) as u32
        self.intern_type(TyKind.struct_, Slice(u32).new(&count, 1), fields)
    }

    alloc_enum :: fn(self &Self, backing_ty u32, name Str, origin u32, variants Slice(u32)) u32 {
        existing := self.origin_types.get(origin)
        if existing != (0 as &u32) { ret *existing }
        header: [4]u32 = .[backing_ty, self.names.len as u32, origin, (variants.len / 2) as u32]
        self.names.push(name)
        payload := self.append_record(Slice(u32).new(&header[0], 4), variants)
        id := self.push(TyKind.enum_, payload)
        self.origin_types.insert(origin, id)
        id
    }

    enum_backing :: fn(self &Self, id u32) u32 { self.nominal_base(id) }

    enum_name :: fn(self &Self, id u32) Str { self.nominal_name(id) }

    enum_origin :: fn(self &Self, id u32) u32 { self.nominal_origin(id) }

    enum_variant_count :: fn(self &Self, id u32) u32 { self.extra(id, 3) }

    enum_variants :: fn(self &Self, id u32) Slice(u32) { self.items(id, 4, self.enum_variant_count(id) as u64 * 2) }

    enum_has_variant :: fn(self &Self, id u32, name_id u32) bool {
        for variant in self.enum_variants(id).chunks(2) {
            if variant.get(0) == name_id { ret true }
        }
        false
    }

    enum_variant_val :: fn(self &Self, id u32, name_id u32) u32 {
        for variant in self.enum_variants(id).chunks(2) {
            if variant.get(0) == name_id { ret variant.get(1) }
        }
        0
    }

    alloc_union :: fn(self &Self, members Slice(u32)) u32 {
        sort(members)
        count := members.len as u32
        self.intern_type(TyKind.union_, Slice(u32).new(&count, 1), members)
    }

    union_members_len :: fn(self &Self, id u32) u32 { self.extra(id, 0) }

    union_members :: fn(self &Self, id u32) Slice(u32) { self.items(id, 1, self.union_members_len(id) as u64) }

    union_contains :: fn(self &Self, id u32, member u32) bool {
        self.union_members(id).contains(member)
    }

    union_member_index :: fn(self &Self, id u32, member u32) u32 {
        self.union_members(id).position(member).unwrap_or(0) as u32
    }

    make_union_2 :: fn(self &Self, a u32, b u32) u32 {
        if a == b { ret a }
        members := Vec(u32).new()
        self.extend_union(&members, a)
        self.extend_union(&members, b)
        sort(members.as_slice())
        members.dedup()
        result := if members.len == 1 { members.get(0) } else {
            count := members.len as u32
            self.intern_type(TyKind.union_, Slice(u32).new(&count, 1), members.as_slice())
        }
        members.destroy()
        result
    }

    extend_union :: fn(self &Self, members &Vec(u32), id u32) {
        if self.kind(id) == TyKind.union_ {
            items := self.union_members(id)
            members.extend(items.ptr, items.len)
        } else { members.push(id) }
    }

    infer_slot :: fn(self &Self, id u32) u32 {
        self.payload(id)
    }

    get_array_type :: fn(self &Self, id u32) u32 { self.extra(id, 0) }

    get_array_len :: fn(self &Self, id u32) u32 { self.extra(id, 1) }

    func_return :: fn(self &Self, func u32) u32 { self.extra(func, 1) }

    func_params_len :: fn(self &Self, func u32) u32 { self.extra(func, 0) >> 16 }

    func_is_extern :: fn(self &Self, func u32) bool { (self.extra(func, 0) & 65535) != 0 }

    func_params :: fn(self &Self, func u32) Slice(u32) { self.items(func, 2, self.func_params_len(func) as u64) }

    record_dependent_func :: fn(self &Self, func u32) {
        self.dependent_funcs.insert(func)
    }

    is_dependent_func :: fn(self &Self, func u32) bool {
        self.dependent_funcs.contains(func)
    }

    func_has_type_param :: fn(self &Self, func u32) bool {
        if self.kind(func) != TyKind.func { ret false }
        self.is_dependent_func(func) or self.func_params(func).contains(ty_id_type())
    }

    func_leading_type_params :: fn(self &Self, func u32) u32 {
        if self.kind(func) != TyKind.func { ret 0 }
        count: u32 = 0
        for param in self.func_params(func) {
            if param != ty_id_type() { break }
            count = count + 1
        }
        count
    }

    get_struct_fields_len :: fn(self &Self, id u32) u32 {
        if self.kind(id) == TyKind.nominal { ret self.get_struct_fields_len(self.nominal_base(id)) }
        self.extra(id, 0)
    }

    get_struct_fields :: fn(self &Self, id u32) Slice(u32) {
        if self.kind(id) == TyKind.nominal { ret self.get_struct_fields(self.nominal_base(id)) }
        self.items(id, 1, self.get_struct_fields_len(id) as u64 * 2)
    }

    print_type :: fn(self &Self, id u32) {
        arena := Arena.new(256)
        out := String.new(&arena)
        self.format_type(&out, id, false)
        write_str(out.as_str())
        arena.destroy()
    }

    name_to_buf :: fn(self &Self, s &String, id u32) {
        self.format_type(s, id, true)
    }

    format_list :: fn(self &Self, out &String, ids Slice(u32), separator Str, mangled bool) {
        first := true
        for id in ids {
            if not first { out.append(separator) }
            self.format_type(out, id, mangled)
            first = false
        }
    }

    format_type :: fn(self &Self, out &String, id u32, mangled bool) {
        if id == ty_id_none() { out.append("None"), ret }
        kind := self.kind(id)
        match kind {
            int, uint, float {
                prefix := match kind { int { "i" }, uint { "u" }, else { "f" } }
                out.append(prefix).append_u32(self.payload(id))
                ret
            }
            ptr {
                out.append(if mangled { "R_" } else { "&" })
                self.format_type(out, self.payload(id), mangled)
                ret
            }
            array {
                out.append(if mangled { "A_" } else { "[" })
                self.format_type(out, self.get_array_type(id), mangled)
                if mangled { out.append("_").append_u32(self.get_array_len(id)) }
                else { out.append("; ").append_u32(self.get_array_len(id)).append("]") }
                ret
            }
            func {
                out.append("fn(")
                self.format_list(out, self.func_params(id), ", ", mangled)
                out.append(") ")
                self.format_type(out, self.func_return(id), mangled)
                ret
            }
            struct_ {
                if mangled {
                    out.append("S_")
                    first := true
                    for field in self.get_struct_fields(id).chunks(2) {
                        if not first { out.append("_") }
                        out.append_u32(field.get(0)).append("_")
                        self.format_type(out, field.get(1), mangled)
                        first = false
                    }
                } else { out.append("struct { count: ").append_u32(self.get_struct_fields_len(id)).append(" }") }
                ret
            }
            enum_, nominal { out.append(self.nominal_name(id)), ret }
            union_ {
                if mangled { out.append("U_") }
                self.format_list(out, self.union_members(id), if mangled { "_" } else { " | " }, mangled)
                ret
            }
            infer { out.append("Infer(").append_u32(self.payload(id)).append(")"), ret }
            bool { out.append("bool"), ret }
            unit { out.append("void"), ret }
            never { out.append("!"), ret }
            error { out.append("Err!"), ret }
            else { out.append(ty_kind_name(kind)), ret }
        }
    }

    name :: fn(a &Arena, id u32) Str {
        fmt(a, "ty{}", .{id}).as_str()
    }
}

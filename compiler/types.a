import VecU8 from "../std/vec/u8.a"
import VecU32 from "../std/vec/u32.a"
import SliceU32 from "../std/slice/u32.a"
import VecStr from "../std/vec/str.a"
import U32_MAX from "../std/primitive/u32.a"
import Str, String from "../std/string.a"
import Arena from "../std/allocator.a"

print_char :: (c u8) unit
print_u32  :: (n u32) unit
print      :: (s &u8) unit


TyKind :: struct {
    unknown       : u8,
    infer         : u8,
    untyped_int   : u8,
    untyped_float : u8,
    int           : u8,
    uint          : u8,
    float         : u8,
    bool          : u8,
    ptr           : u8,
    type_         : u8,
    unit          : u8,
    func          : u8,
    never         : u8,
    struct_       : u8,
    array         : u8,
    error         : u8,
    nominal       : u8
}

ty_kind :: () TyKind {
    .{
        unknown       : 0,
        infer         : 1,
        untyped_int   : 2,
        untyped_float : 3,
        int           : 4,
        uint          : 5,
        float         : 6,
        bool          : 7,
        ptr           : 8,
        type_         : 9,
        unit          : 10,
        func          : 11,
        never         : 12,
        struct_       : 13,
        array         : 14,
        error         : 15,
        nominal       : 16
    }
}

ty_kind_name :: (k u8) Str {
    t := ty_kind()
    if k == t.unknown       { ret Str.of("Unknown")      }
    if k == t.infer         { ret Str.of("Infer")        }
    if k == t.untyped_int   { ret Str.of("UtInt")        }
    if k == t.untyped_float { ret Str.of("UtFloat")      }
    if k == t.int           { ret Str.of("Int")          }
    if k == t.uint          { ret Str.of("UInt")         }
    if k == t.float         { ret Str.of("Float")        }
    if k == t.bool          { ret Str.of("Bool")         }
    if k == t.ptr           { ret Str.of("Ptr")          }
    if k == t.type_         { ret Str.of("Type")         }
    if k == t.unit          { ret Str.of("Unit")         }
    if k == t.func          { ret Str.of("Func")         }
    if k == t.never         { ret Str.of("Never")        }
    if k == t.struct_       { ret Str.of("Struct")       }
    if k == t.array         { ret Str.of("Array")        }
    if k == t.error         { ret Str.of("Error")        }
    if k == t.nominal       { ret Str.of("Nominal")      }
    Str.of("Unknown")
}


ty_id_none          :: () u32 { U32_MAX() }
ty_id_unknown       :: () u32 { 0 }
ty_id_untyped_int   :: () u32 { 1 }
ty_id_untyped_float :: () u32 { 2 }
ty_id_bool          :: () u32 { 3 }
ty_id_type          :: () u32 { 4 }
ty_id_unit          :: () u32 { 5 }
ty_id_never         :: () u32 { 6 }
ty_id_error         :: () u32 { 7 }
ty_builtin_count    :: () u32 { 8 }


TyStore :: struct {
    kinds   : VecU8,
    payload : VecU32,
    extra   : VecU32

    new :: () Self {
        .{
            kinds   : VecU8.new(),
            payload : VecU32.new(),
            extra   : VecU32.new()
        }
    }

    destroy :: () {
        .kinds.destroy()
        .payload.destroy()
        .extra.destroy()
    }

    len :: () u32 {
        .kinds.len as u32
    }

    push :: (kind u8, payload u32) u32 {
        idx := .kinds.len as u32
        .kinds.push(kind)
        .payload.push(payload)
        idx
    }

    hash_combine :: (seed u32, val u32) u32 {
        (seed ^ val) * 16777619
    }

    type_eq_simple :: (id u32, kind u8, payload u32) bool {
        if .kinds.get(id as u64) != kind { ret false }
        .payload.get(id as u64) == payload
    }

    type_eq_array :: (id u32, kind u8, ty u32, len u32) bool {
        if .kinds.get(id as u64) != kind { ret false }
        extra_idx := .payload.get(id as u64) as u64
        ex_ty  := .extra.get(extra_idx)
        ex_len := .extra.get(extra_idx + 1)
        (ex_ty == ty) and (ex_len == len)
    }

    type_eq_func :: (id u32, kind u8, params SliceU32, ret_ty u32, packed u32) bool {
        if .kinds.get(id as u64) != kind { ret false }
        extra_idx := .payload.get(id as u64) as u64
        ex_packed := .extra.get(extra_idx)
        ex_ret    := .extra.get(extra_idx + 1)
        if (ex_packed != packed) or (ex_ret != ret_ty) { ret false }

        i: u64 = 0
        while i < params.len {
            param_in_extra := .extra.get(extra_idx + 2 + i)
            if param_in_extra != *(params.ptr + i) { ret false }
            i = i + 1
        }
        true
    }

    type_eq_struct :: (id u32, kind u8, fields SliceU32, fields_count u32) bool {
        if .kinds.get(id as u64) != kind { ret false }
        extra_idx := .payload.get(id as u64) as u64
        ex_len := .extra.get(extra_idx)
        if ex_len != fields_count { ret false }

        i: u64 = 0
        total_items := (fields_count * 2) as u64
        while i < total_items {
            item_in_extra := .extra.get(extra_idx + 1 + i)
            if (item_in_extra != *(fields.ptr + i)) or false { ret false }
            i = i + 1
        }
        true
    }
}






















TypeStorage :: struct {
    store     : TyStore,
    table     : VecU32,
    table_cap : u32,
    table_len : u32,
    nominal_names : VecStr,
    nominal_by_origin : VecU32

    new :: () Self {
        store := TyStore.new()

        k := ty_kind()
        store.push(k.unknown, 0)       -- 0: Unknown
        store.push(k.untyped_int, 0)   -- 1: UntypedInt
        store.push(k.untyped_float, 0) -- 2: UntypedFloat
        store.push(k.bool, 0)          -- 3: Bool
        store.push(k.type_, 0)         -- 4: Type
        store.push(k.unit, 0)          -- 5: Unit
        store.push(k.never, 0)         -- 6: Never
        store.push(k.error, 0)         -- 7: Error

        init_cap: u32 = 64
        tbl := VecU32.with_cap(init_cap as u64)
        i: u32 = 0
        while i < init_cap {
            tbl.push(ty_id_none())
            i = i + 1
        }

        .{
            store     : store,
            table     : tbl,
            table_cap : init_cap,
            table_len : 0,
            nominal_names : VecStr.new(),
            nominal_by_origin : VecU32.new()
        }
    }

    hash_combine :: (seed u32, val u32) u32 {
        (seed ^ val) * 16777619
    }

    sort_struct_fields :: (fields SliceU32) {
        count := fields.len / 2
        if count <= 1 { ret }

        i: u64 = 0
        while i < count {
            j: u64 = i + 1
            while j < count {
                idx_i := i * 2
                idx_j := j * 2

                name_i := *(fields.ptr + idx_i)
                name_j := *(fields.ptr + idx_j)

                if name_i > name_j {
                    ty_i := *(fields.ptr + idx_i + 1)
                    ty_j := *(fields.ptr + idx_j + 1)

                    *(fields.ptr + idx_i)     = name_j
                    *(fields.ptr + idx_i + 1) = ty_j

                    *(fields.ptr + idx_j)     = name_i
                    *(fields.ptr + idx_j + 1) = ty_i
                }
                j = j + 1
            }
            i = i + 1
        }
    }

    destroy :: () {
        .store.destroy()
        .table.destroy()
        .nominal_names.destroy()
        .nominal_by_origin.destroy()
    }

    len :: () u32 {
        .store.len()
    }

    kind :: (id u32) u8 {
        if id == ty_id_none() { ret ty_kind().unknown }
        .store.kinds.get(id as u64)
    }

    payload :: (id u32) u32 {
        .store.payload.get(id as u64)
    }

    hash_of :: (id u32) u32 {
        k := ty_kind()
        kind := .kind(id)
        payload := .payload(id)

        if kind == k.array {
            extra_idx := payload as u64
            ty  := .store.extra.get(extra_idx)
            len := .store.extra.get(extra_idx + 1)
            h := .hash_combine(2166136261, kind as u32)
            h = .hash_combine(h, ty)
            ret .hash_combine(h, len)
        }

        if kind == k.func {
            extra_idx := payload as u64
            packed := .store.extra.get(extra_idx)
            ret_ty := .store.extra.get(extra_idx + 1)
            params_len := packed >> 16

            h := .hash_combine(2166136261, kind as u32)
            h = .hash_combine(h, ret_ty)
            h = .hash_combine(h, packed)

            i: u64 = 0
            while (i < (params_len as u64)) or false {
                param := .store.extra.get(extra_idx + 2 + i)
                h = .hash_combine(h, param)
                i = i + 1
            }
            ret h
        }

        if kind == k.struct_ {
            extra_idx := payload as u64
            fields_count := .store.extra.get(extra_idx)
            total_items := (fields_count * 2) as u64

            h := .hash_combine(2166136261, kind as u32)
            h = .hash_combine(h, fields_count)

            i: u64 = 0
            while i < total_items {
                item := .store.extra.get(extra_idx + 1 + i)
                h = .hash_combine(h, item)
                i = i + 1
            }
            ret h
        }

        h := .hash_combine(2166136261, kind as u32)
        .hash_combine(h, payload)
    }

    grow_table :: () {
        old_cap := .table_cap
        new_cap := old_cap * 2
        new_tbl := VecU32.with_cap(new_cap as u64)

        i: u32 = 0
        while i < new_cap {
            new_tbl.push(ty_id_none())
            i = i + 1
        }

        mask := new_cap - 1
        total_types := .store.len()
        id: u32 = ty_builtin_count()

        while id < total_types {
            if .kind(id) == ty_kind().nominal {
                id = id + 1
                cont
            }
            h := .hash_of(id)
            idx := h & mask

            while new_tbl.get(idx as u64) != ty_id_none() {
                idx = (idx + 1) & mask
            }

            new_tbl.set(idx as u64, id)
            id = id + 1
        }

        .table.destroy()
        .table = new_tbl
        .table_cap = new_cap
    }

    alloc_unknown :: () u32 { ty_id_unknown()       }

    alloc_untyped_int :: () u32 { ty_id_untyped_int()   }

    alloc_untyped_float :: () u32 { ty_id_untyped_float() }

    alloc_bool :: () u32 { ty_id_bool()          }

    alloc_type :: () u32 { ty_id_type()          }

    alloc_unit :: () u32 { ty_id_unit()          }

    alloc_never :: () u32 { ty_id_never()         }

    alloc_error :: () u32 { ty_id_error()         }

    get_or_insert_simple :: (kind u8, payload u32) u32 {
        if (.table_len + 1) * 10 >= .table_cap * 7 {
            .grow_table()
        }

        h := .hash_combine(2166136261, kind as u32)
        h = .hash_combine(h, payload)

        mask := .table_cap - 1
        idx := h & mask

        while true {
            existing := .table.get(idx as u64)
            if existing == ty_id_none() {
                new_id := .store.push(kind, payload)
                .table.set(idx as u64, new_id)
                .table_len = .table_len + 1
                ret new_id
            }

            if .store.type_eq_simple(existing, kind, payload) {
                ret existing
            }

            idx = (idx + 1) & mask
        }

        ty_id_error()
    }

    alloc_infer :: (slot u32) u32 {
        .get_or_insert_simple(ty_kind().infer, slot)
    }

    alloc_int :: (width u16) u32 {
    .get_or_insert_simple(ty_kind().int, width as u32)
    }

    alloc_uint :: (width u16) u32 {
        .get_or_insert_simple(ty_kind().uint, width as u32)
    }

    alloc_float :: (width u16) u32 {
        .get_or_insert_simple(ty_kind().float, width as u32)
    }

    alloc_ptr :: (inner u32) u32 {
        .get_or_insert_simple(ty_kind().ptr, inner)
    }

    alloc_array :: (ty u32, len u32) u32 {
        k := ty_kind()
        if (.table_len + 1) * 10 >= .table_cap * 7 {
            .grow_table()
        }

        h := .hash_combine(2166136261, k.array as u32)
        h = .hash_combine(h, ty)
        h = .hash_combine(h, len)

        mask := .table_cap - 1
        idx := h & mask

        while true {
            existing := .table.get(idx as u64)
            if existing == ty_id_none() {
                extra_idx := .store.extra.len as u32
                .store.extra.push(ty)
                .store.extra.push(len)

                new_id := .store.push(k.array, extra_idx)
                .table.set(idx as u64, new_id)
                .table_len = .table_len + 1
                ret new_id
            }

            if .store.type_eq_array(existing, k.array, ty, len) {
                ret existing
            }

            idx = (idx + 1) & mask
        }

        ty_id_error()
    }

    alloc_func :: (params SliceU32, ret_ty u32, is_extern bool) u32 {
        k := ty_kind()
        if (.table_len + 1) * 10 >= .table_cap * 7 {
            .grow_table()
        }

        params_len := params.len as u32
        ext_val: u32 = 0
        if is_extern { ext_val = 1 }
        packed := (params_len << 16) | ext_val

        h := .hash_combine(2166136261, k.func as u32)
        h = .hash_combine(h, ret_ty)
        h = .hash_combine(h, packed)

        i: u64 = 0
        while i < params.len {
            h = .hash_combine(h, *(params.ptr + i))
            i = i + 1
        }

        mask := .table_cap - 1
        idx := h & mask

        while true {
            existing := .table.get(idx as u64)
            if existing == ty_id_none() {
                extra_idx := .store.extra.len as u32
                .store.extra.push(packed)
                .store.extra.push(ret_ty)

                p_i: u64 = 0
                while p_i < params.len {
                    .store.extra.push(*(params.ptr + p_i))
                    p_i = p_i + 1
                }

                new_id := .store.push(k.func, extra_idx)
                .table.set(idx as u64, new_id)
                .table_len = .table_len + 1
                ret new_id
            }

            if .store.type_eq_func(existing, k.func, params, ret_ty, packed) {
                ret existing
            }

            idx = (idx + 1) & mask
        }

        ty_id_error()
    }

    alloc_nominal :: (base u32, name Str, origin u32) u32 {
        while .nominal_by_origin.len <= origin as u64 {
            .nominal_by_origin.push(ty_id_none())
        }
        existing := .nominal_by_origin.get(origin as u64)
        if existing != ty_id_none() { ret existing }

        extra_idx := .store.extra.len as u32
        name_idx := .nominal_names.len as u32
        .nominal_names.push(name)
        .store.extra.push(base)
        .store.extra.push(name_idx)
        .store.extra.push(origin)
        nominal := .store.push(ty_kind().nominal, extra_idx)
        .nominal_by_origin.set(origin as u64, nominal)
        nominal
    }

    nominal_base :: (id u32) u32 {
        idx := .payload(id) as u64
        .store.extra.get(idx)
    }

    nominal_origin :: (id u32) u32 {
        idx := .payload(id) as u64
        .store.extra.get(idx + 2)
    }

    alloc_struct :: (fields SliceU32) u32 {

        .sort_struct_fields(fields)

        k := ty_kind()
        if (.table_len + 1) * 10 >= .table_cap * 7 {
            .grow_table()
        }

        fields_count := (fields.len / 2) as u32

        h := .hash_combine(2166136261, k.struct_ as u32)
        h = .hash_combine(h, fields_count)

        i: u64 = 0
        while i < fields.len {
            h = .hash_combine(h, *(fields.ptr + i))
            i = i + 1
        }

        mask := .table_cap - 1
        idx := h & mask

        while true {
            existing := .table.get(idx as u64)
            if existing == ty_id_none() {
                extra_idx := .store.extra.len as u32
                .store.extra.push(fields_count)

                f_i: u64 = 0
                while f_i < fields.len {
                    .store.extra.push(*(fields.ptr + f_i))
                    f_i = f_i + 1
                }

                new_id := .store.push(k.struct_, extra_idx)
                .table.set(idx as u64, new_id)
                .table_len = .table_len + 1
                ret new_id
            }

            if .store.type_eq_struct(existing, k.struct_, fields, fields_count) {
                ret existing
            }

            idx = (idx + 1) & mask
        }

        ty_id_error()
    }

    infer_slot :: (id u32) u32 {
        .payload(id)
    }

    get_array_type :: (id u32) u32 {
        extra_idx := .payload(id) as u64
        .store.extra.get(extra_idx)
    }

    get_array_len :: (id u32) u32 {
        extra_idx := .payload(id) as u64
        .store.extra.get(extra_idx + 1)
    }

    func_return :: (func u32) u32 {
        extra_idx := .payload(func) as u64
        .store.extra.get(extra_idx + 1)
    }

    func_params_len :: (func u32) u32 {
        extra_idx := .payload(func) as u64
        packed := .store.extra.get(extra_idx)
        packed >> 16
    }

    func_is_extern :: (func u32) bool {
        extra_idx := .payload(func) as u64
        packed := .store.extra.get(extra_idx)
        (packed & 65535) != 0
    }

    func_params :: (func u32) SliceU32 {
        extra_idx := .payload(func) as u64
        count := .func_params_len(func)
        start_ptr := .store.extra.ptr_at(extra_idx + 2)
        .{
            ptr: start_ptr,
            len: count as u64
        }
    }

    get_struct_fields_len :: (id u32) u32 {
        if .kind(id) == ty_kind().nominal {
            ret .get_struct_fields_len(.nominal_base(id))
        }
        extra_idx := .payload(id) as u64
        .store.extra.get(extra_idx)
    }

    get_struct_fields :: (id u32) SliceU32 {
        if .kind(id) == ty_kind().nominal {
            ret .get_struct_fields(.nominal_base(id))
        }
        extra_idx := .payload(id) as u64
        fields_count := .store.extra.get(extra_idx)
        start_ptr := .store.extra.ptr_at(extra_idx + 1)
        .{
            ptr: start_ptr,
            len: (fields_count * 2) as u64
        }
    }

    print_type :: (id u32) {
        if id == ty_id_none() {
            print("None")
            ret
        }

        k := ty_kind()
        kind := .kind(id)
        payload := .payload(id)

        if kind == k.unknown       { print("Unknown")   ret }
        if kind == k.infer         { print("Infer(") print_u32(payload) print(")") ret }
        if kind == k.untyped_int   { print("UtInt")     ret }
        if kind == k.untyped_float { print("UtFloat")   ret }
        if kind == k.int           { print("i") print_u32(payload) ret }
        if kind == k.uint          { print("u") print_u32(payload) ret }
        if kind == k.float         { print("f") print_u32(payload) ret }
        if kind == k.bool          { print("bool")      ret }
        if kind == k.type_         { print("Type")      ret }
        if kind == k.unit          { print("unit")      ret }
        if kind == k.never         { print("!")         ret }
        if kind == k.error         { print("Err!")      ret }
        if kind == k.nominal {
            idx := payload as u64
            name_idx := .store.extra.get(idx + 1)
            .nominal_names.get(name_idx as u64).print()
            ret
        }

        if kind == k.ptr {
            print("&")
            .print_type(payload)
            ret
        }

        if kind == k.array {
            print("[")
            .print_type(.get_array_type(id))
            print("; ")
            print_u32(.get_array_len(id))
            print("]")
            ret
        }

        if kind == k.func {
            print("fn(")
            params := .func_params(id)
            i: u64 = 0
            while i < params.len {
                .print_type(*(params.ptr + i))
                if i + 1 < params.len { print(", ") }
                i = i + 1
            }
            print(") ")
            .print_type(.func_return(id))
            ret
        }

        if kind == k.struct_ {
            print("struct { count: ")
            print_u32(.get_struct_fields_len(id))
            print(" }")
            ret
        }

        ty_kind_name(kind).print()
    }

    name_to_buf :: (s &String, id u32) {
        if id == ty_id_none() {
            s.push_str(Str.of("None"))
            ret
        }

        k := ty_kind()
        kind := .kind(id)
        payload := .payload(id)

        if kind == k.unknown       { s.push_str(Str.of("Unknown")) ret }
        if kind == k.infer         {
            s.push_str(Str.of("Infer("))
            s.push_u32(payload)
            s.push_char(*")")
            ret
        }
        if kind == k.untyped_int   { s.push_str(Str.of("UtInt"))   ret }
        if kind == k.untyped_float { s.push_str(Str.of("UtFloat")) ret }

        if kind == k.int {
            s.push_char(*"i")
            s.push_u32(payload)
            ret
        }

        if kind == k.uint {
            s.push_char(*"u")
            s.push_u32(payload)
            ret
        }

        if kind == k.float {
            s.push_char(*"f")
            s.push_u32(payload)
            ret
        }

        if kind == k.bool  { s.push_str(Str.of("bool")) ret }
        if kind == k.type_ { s.push_str(Str.of("Type")) ret }
        if kind == k.unit  { s.push_str(Str.of("unit")) ret }
        if kind == k.never { s.push_str(Str.of("!"))    ret }
        if kind == k.error { s.push_str(Str.of("Err!")) ret }
        if kind == k.nominal {
            idx := payload as u64
            name_idx := .store.extra.get(idx + 1)
            s.push_str(.nominal_names.get(name_idx as u64))
            ret
        }

        if kind == k.ptr {
            s.push_str(Str.of("R_"))
            .name_to_buf(s, payload)
            ret
        }

        if kind == k.array {
            s.push_str(Str.of("A_"))
            inner := .get_array_type(id)
            len := .get_array_len(id)

            .name_to_buf(s, inner)
            s.push_char(*"_")
            s.push_u32(len)
            ret
        }

        if kind == k.struct_ {
            s.push_str(Str.of("S_"))
            fields := .get_struct_fields(id)
            count := fields.len / 2

            i: u64 = 0
            while (i < count) or false {
                idx := i * 2
                name_id := *(fields.ptr + idx)
                field_ty := *(fields.ptr + idx + 1)

                s.push_u32(name_id)
                s.push_char(*"_")
                .name_to_buf(s, field_ty)

                if (i + 1 < count) or false {
                    s.push_char(*"_")
                }
                i = i + 1
            }
            ret
        }

        if kind == k.func {
            s.push_str(Str.of("fn("))
            params := .func_params(id)

            i: u64 = 0
            while (i < params.len) or false {
                param_ty := *(params.ptr + i)
                .name_to_buf(s, param_ty)

                if (i + 1 < params.len) or false {
                    s.push_str(Str.of(", "))
                }
                i = i + 1
            }

            s.push_str(Str.of(") "))
            ret_ty := .func_return(id)
            .name_to_buf(s, ret_ty)
            ret
        }

        s.push_str(ty_kind_name(kind))
    }

    name :: (a &Arena, id u32) Str {
        s := String.new(a)
        s.push_str(Str.of("ty"))
        s.push_u32(id)
        s.as_str()
    }
}

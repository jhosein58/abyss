import HirTable, hir_kind_name, hir_kind, hir_none from "./hir"
import Str from "std/string"
import Nexus from "./nexus/nexus"
import Arena from "std/allocator"

import TypeStorage, ty_id_none from "./types"
import UnifyStorage, slot_none from "./unify"

print_spaces :: fn(count u32) {
    i: u32 = 0
    while (i < count) or false {
        printf(" ", .{})
        i = i + 1
    }
}

u32_digits :: fn(val u32) u32 {
    if val == 0 {
        ret 1
    }
    count: u32 = 0
    v := val
    while (v > 0) or false {
        count = count + 1
        v = v / 10
    }
    count
}

print_str_padded :: fn(s Str, width u32) {
    printf("{}", .{s})
    len := s.len as u32
    if width > len {
        print_spaces(width - len)
    }
}

print_u32_padded :: fn(val u32, width u32) {
    printf("{}", .{val})
    d := u32_digits(val)
    if width > d {
        print_spaces(width - d)
    }
}

print_idx_or_none :: fn(val u32, width u32) {
    if val == hir_none() {
        print_str_padded(Str.of("None"), width)
    } else {
        print_u32_padded(val, width)
    }
}

print_divider :: fn() {
    print("------------------------------------------------------------------------------------------------------------")
}

dump_hir :: fn(db &Nexus, hir &HirTable, arena &Arena) {
    unify := &(*db).unify
    types := &(*db).types

    k := hir_kind
    total := hir.len()

    print_divider()
    print_str_padded(Str.of("ID"), 6)
    print_str_padded(Str.of("| Kind"), 22)
    print_str_padded(Str.of("| LHS (Left/Data)"), 24)
    print_str_padded(Str.of("| RHS (Right/Data)"), 22)
    print_str_padded(Str.of("| Extra"), 10)
    print_str_padded(Str.of("| Type"), 20)
    print("")
    print_divider()

    i: u32 = 0
    while (i < total) or false {
        kind := (hir).kind(i)
        lhs := (hir).lhs(i)
        rhs := (hir).rhs(i)
        extra := (hir).extra(i)

        print_u32_padded(i, 6)

        print_str_padded(Str.of("| "), 2)
        print_str_padded(hir_kind_name(kind), 20)

        print_str_padded(Str.of("| "), 2)

        if kind == k.lit_int {
            printf("Int({})", .{lhs})
            len := u32_digits(lhs) + 5
            if 22 > len {
                print_spaces(22 - len)
            }
        } else if kind == k.ident {
            if lhs == hir_none() {
                print_str_padded(Str.of("None"), 22)
            } else {
                name := db.interner.get(lhs)
                print_str_padded(name, 22)
            }
        } else if kind == k.block {
            printf("[", .{})
            slice := db.get_list(lhs)

            len: u32 = 2
            j: u64 = 0

            while (j < slice.len) or false {
                node_id := *(slice.ptr + j)
                printf("{}", .{node_id})
                len = len + u32_digits(node_id)

                if (j + 1) < slice.len {
                    printf(", ", .{})
                    len = len + 2
                }

                j = j + 1
            }

            printf("]", .{})
            if 22 > len {
                print_spaces(22 - len)
            }
        } else {
            print_idx_or_none(lhs, 22)
        }

        print_str_padded(Str.of("| "), 2)
        print_idx_or_none(rhs, 20)

        print_str_padded(Str.of("| "), 2)
        print_idx_or_none(extra, 8)

        print_str_padded(Str.of("| "), 2)

        slot := (unify).get_slot(i)
        if slot != slot_none() {
            tyid := (unify).resolve_type_deep(types, slot)

            if tyid != ty_id_none() {
                  ty_name := TypeStorage.name(arena, tyid)
                print_str_padded(ty_name, 18)
            } else {
                print_str_padded(Str.of("None"), 18)
            }
            _
        } else {
            print_str_padded(Str.of("None"), 18)
        }

        print("")

        i = i + 1
    }

    print_divider()
}

import token, TokenStream from "token.a"
import lex from "lexer.a"
import Nexus from "nexus/nexus.a"
import Str from "../std/string.a"
import Arena from "../std/allocator.a"
import read_file from "../std/fs.a"
import VecU32 from "../std/vec/u32.a"
import id_none from "nexus/pool.a"
import fall from "../std/sys.a"

print :: (s &u8) unit

index_error :: (path Str, msg &u8) {
    print("\n[import error] ")
    print(msg)
    print(" in ")
    path.print()
    print("\n")
    fall()
}

str_eq :: (a Str, b Str) bool {
    if a.len != b.len { ret false }
    i: u64 = 0
    while i < a.len {
        if *(a.ptr + i) != *(b.ptr + i) { ret false }
        i = i + 1
    }
    true
}

trim_quotes :: (s Str) Str {
    if s.len >= 2 {
        first := *(s.ptr)
        last := *(s.ptr + s.len - 1)
        if (first == 34 as u8) and (last == 34 as u8) {
            ret .{
                ptr: s.ptr + 1,
                len: s.len - 2
            }
        }
    }
    s
}

path_resolve :: (arena &Arena, base Str, rel Str) Str {
    dir_len: u64 = 0
    if base.len > 0 {
        idx := base.len
        while idx > 0 {
            idx = idx - 1
            if *(base.ptr + idx) == 47 as u8 { -- '/'
                dir_len = idx
                break
            }
        }
    }

    combined_len := rel.len
    if dir_len > 0 {
        combined_len = dir_len + 1 + rel.len
    }

    comb_buf := arena.alloc(combined_len + 1)
    if dir_len > 0 {
        i: u64 = 0
        while i < dir_len {
            *(comb_buf + i) = *(base.ptr + i)
            i = i + 1
        }
        *(comb_buf + dir_len) = 47 as u8
        j: u64 = 0
        while j < rel.len {
            *(comb_buf + dir_len + 1 + j) = *(rel.ptr + j)
            j = j + 1
        }
    } else {
        i: u64 = 0
        while i < rel.len {
            *(comb_buf + i) = *(rel.ptr + i)
            i = i + 1
        }
    }

    combined: Str = .{ ptr: comb_buf, len: combined_len }

    seg_starts := VecU32.new()
    seg_lens   := VecU32.new()

    c_i: u64 = 0
    seg_start: u64 = 0
    while c_i <= combined.len {
        is_end := c_i == combined.len
        is_slash := false
        if not is_end {
            if *(combined.ptr + c_i) == 47 as u8 { is_slash = true }
        }

        if is_end or is_slash {
            s_len := c_i - seg_start
            if s_len > 0 {
                is_dot := (s_len == 1) and (*(combined.ptr + seg_start) == 46 as u8)
                is_dotdot := (s_len == 2) and (*(combined.ptr + seg_start) == 46 as u8) and (*(combined.ptr + seg_start + 1) == 46 as u8)

                if is_dot {
                } else if is_dotdot {
                    if seg_starts.len > 0 {
                        last_idx := seg_starts.len - 1
                        top_start := seg_starts.get(last_idx) as u64
                        top_len   := seg_lens.get(last_idx) as u64
                        top_is_dotdot := (top_len == 2) and (*(combined.ptr + top_start) == 46 as u8) and (*(combined.ptr + top_start + 1) == 46 as u8)
                        if top_is_dotdot {
                            seg_starts.push(seg_start as u32)
                            seg_lens.push(s_len as u32)
                        } else {
                            seg_starts.len = seg_starts.len - 1
                            seg_lens.len = seg_lens.len - 1
                        }
                    } else {
                        seg_starts.push(seg_start as u32)
                        seg_lens.push(s_len as u32)
                    }
                } else {
                    seg_starts.push(seg_start as u32)
                    seg_lens.push(s_len as u32)
                }
            }
            seg_start = c_i + 1
        }
        c_i = c_i + 1
    }

    final_len: u64 = 0
    k_i: u64 = 0
    while k_i < seg_starts.len {
        final_len = final_len + (seg_lens.get(k_i) as u64)
        if (k_i + 1) < seg_starts.len {
            final_len = final_len + 1
        }
        k_i = k_i + 1
    }

    out_buf := arena.alloc(final_len + 1)
    write_pos: u64 = 0
    k_i = 0
    while k_i < seg_starts.len {
        s_off := seg_starts.get(k_i) as u64
        s_len := seg_lens.get(k_i) as u64
        cp_i: u64 = 0
        while cp_i < s_len {
            *(out_buf + write_pos) = *(combined.ptr + s_off + cp_i)
            write_pos = write_pos + 1
            cp_i = cp_i + 1
        }
        if (k_i + 1) < seg_starts.len {
            *(out_buf + write_pos) = 47 as u8
            write_pos = write_pos + 1
        }
        k_i = k_i + 1
    }
    *(out_buf + write_pos) = 0 as u8

    seg_starts.destroy()
    seg_lens.destroy()

    .{ ptr: out_buf, len: final_len }
}

resolve_and_load_file :: (
    db              &Nexus,
    arena           &Arena,
    curr_path       Str,
    import_path     Str,
    loaded_paths    &VecU32,
    queue_fids      &VecU32,
    queue_tok_start &VecU32,
    queue_tok_end   &VecU32
) u32 {
    target_path := path_resolve(arena, curr_path, import_path)
    path_id := db.interner.intern(target_path)

    i: u64 = 0
    while i < (*loaded_paths).len {
        if loaded_paths.get(i) == path_id {
            ret i as u32
        }
        i = i + 1
    }

    source := read_file(arena, target_path.ptr)
    fid := db.add_file(target_path, source)
    while (*loaded_paths).len < (fid as u64) {
        loaded_paths.push(id_none())
    }
    loaded_paths.push(path_id)
    tok_start := db.tokens.count() as u32
    lex(&(*db).tokens, source, target_path)
    tok_end := db.tokens.count() as u32

    queue_fids.push(fid)
    queue_tok_start.push(tok_start)
    queue_tok_end.push(tok_end)

    fid
}

scan_file_symbols :: (
    db              &Nexus,
    arena           &Arena,
    file_id         u32,
    curr_path       Str,
    start_tok       u32,
    end_tok         u32,
    loaded_paths    &VecU32,
    queue_fids      &VecU32,
    queue_tok_start &VecU32,
    queue_tok_end   &VecU32,
    pending_imports &VecU32
) {
    t := token()
    cursor := start_tok
    depth: u32 = 0

    has_sym := false
    curr_sym_name: u32 = 0
    curr_sym_tok:  u32 = 0

    while cursor < end_tok {
        tk := db.tokens.kind(cursor)
        tk_text := db.tokens.text(cursor)

        if (tk == t.o_brace) or (tk == t.o_paren) {
            depth = depth + 1
        } else if (tk == t.c_brace) or (tk == t.c_paren) {
            if depth > 0 {
                depth = depth - 1
            }
        } else if (depth == 0) and (str_eq(tk_text, Str.of("import"))) {
            if has_sym {
                db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, cursor)
                has_sym = false
            }

            scan := cursor + 1
            imported_names := VecU32.new()

            while scan < end_tok {
                stk_text := db.tokens.text(scan)
                if str_eq(stk_text, Str.of("from")) {
                    scan = scan + 1
                    break
                }
                if (db.tokens.kind(scan) != t.ident) and
                   (db.tokens.kind(scan) != t.comma) {
                    index_error(curr_path, "invalid import name")
                }
                if db.tokens.kind(scan) == t.ident {
                    name_id := db.interner.intern(stk_text)
                    imported_names.push(name_id)
                }
                scan = scan + 1
            }

            if (scan >= end_tok) or (imported_names.len == 0) {
                index_error(curr_path, "expected names, 'from', and a quoted path")
            }
            if db.tokens.kind(scan) != t.lit_str {
                index_error(curr_path, "expected quoted import path")
            }
            if scan < end_tok {
                raw_path := db.tokens.text(scan)
                path_str := trim_quotes(raw_path)

                target_fid := resolve_and_load_file(
                    db, arena, curr_path, path_str,
                    loaded_paths, queue_fids, queue_tok_start, queue_tok_end
                )

                n_i: u64 = 0
                while n_i < imported_names.len {
                    nid := imported_names.get(n_i)
                    pending_imports.push(file_id)
                    pending_imports.push(nid)
                    pending_imports.push(nid)
                    pending_imports.push(target_fid)
                    n_i = n_i + 1
                }
                imported_names.destroy()
                cursor = scan + 1
                cont
            }
            imported_names.destroy()
        } else if (depth == 0) and (tk == t.ident) {
            if (cursor + 1) < end_tok {
                next_tk := db.tokens.kind(cursor + 1)
                if next_tk == t.colon_colon {
                    if (cursor + 2) < end_tok {
                        c2_text := db.tokens.text(cursor + 2)
                        if str_eq(c2_text, Str.of("import")) {
                            if (cursor + 5 >= end_tok) or
                               (db.tokens.kind(cursor + 3) != t.ident) or
                               (not str_eq(db.tokens.text(cursor + 4), Str.of("from"))) or
                               (db.tokens.kind(cursor + 5) != t.lit_str) {
                                index_error(curr_path, "malformed symbol import")
                            }
                            if has_sym {
                                db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, cursor)
                                has_sym = false
                            }

                            loc_str := db.tokens.text(cursor)
                            loc_name := db.interner.intern(loc_str)

                            rem_str := db.tokens.text(cursor + 3)
                            rem_name := db.interner.intern(rem_str)

                            raw_path := db.tokens.text(cursor + 5)
                            path_str := trim_quotes(raw_path)

                            target_fid := resolve_and_load_file(
                                db, arena, curr_path, path_str,
                                loaded_paths, queue_fids, queue_tok_start, queue_tok_end
                            )

                            pending_imports.push(file_id)
                            pending_imports.push(loc_name)
                            pending_imports.push(rem_name)
                            pending_imports.push(target_fid)

                            cursor = cursor + 6
                            cont
                        }
                    }

                    if has_sym {
                        db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, cursor)
                    }

                    text := db.tokens.text(cursor)
                    curr_sym_name = db.interner.intern(text)
                    curr_sym_tok  = cursor
                    has_sym = true

                    cursor = cursor + 1
                }
            }
        }

        cursor = cursor + 1
    }

    if has_sym {
        db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, end_tok)
    }
}

index_file :: (db &Nexus, arena &Arena, root_fid u32, root_path Str, start_tok u32, end_tok u32) {
    loaded_paths    := VecU32.new()
    queue_fids      := VecU32.new()
    queue_tok_start := VecU32.new()
    queue_tok_end   := VecU32.new()
    pending_imports := VecU32.new()

    root_path_id := db.interner.intern(root_path)
    while loaded_paths.len < (root_fid as u64) {
        loaded_paths.push(id_none())
    }
    loaded_paths.push(root_path_id)

    queue_fids.push(root_fid)
    queue_tok_start.push(start_tok)
    queue_tok_end.push(end_tok)

    q_head: u64 = 0
    while q_head < queue_fids.len {
        fid   := queue_fids.get(q_head)
        s_tok := queue_tok_start.get(q_head)
        e_tok := queue_tok_end.get(q_head)

        path_id := loaded_paths.get(fid as u64)
        c_path  := db.interner.get(path_id)

        scan_file_symbols(
            db, arena, fid, c_path, s_tok, e_tok,
            &loaded_paths, &queue_fids, &queue_tok_start, &queue_tok_end,
            &pending_imports
        )

        q_head = q_head + 1
    }

    changed := true
    while changed {
        changed = false
        p_i: u64 = 0
        while p_i < pending_imports.len {
            src_fid := pending_imports.get(p_i)
            if src_fid != id_none() {
                loc_name := pending_imports.get(p_i + 1)
                imp_name := pending_imports.get(p_i + 2)
                tgt_fid  := pending_imports.get(p_i + 3)

                target_sym := db.find_symbol(tgt_fid, imp_name)
                if target_sym != id_none() {
                    db.alloc_symbol_alias(src_fid, loc_name, target_sym)
                    pending_imports.set(p_i, id_none())
                    changed = true
                }
            }
            p_i = p_i + 4
        }
    }

    p_i: u64 = 0
    while p_i < pending_imports.len {
        src_fid := pending_imports.get(p_i)
        if src_fid != id_none() {
            name_id := pending_imports.get(p_i + 2)
            print("\n[import error] symbol not found: ")
            db.interner.get(name_id).print()
            print("\n")
            fall()
        }
        p_i = p_i + 4
    }

    loaded_paths.destroy()
    queue_fids.destroy()
    queue_tok_start.destroy()
    queue_tok_end.destroy()
    pending_imports.destroy()
}

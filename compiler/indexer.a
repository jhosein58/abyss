import write_str from "std/io"
import token, TokenStream from "./token"
import lex from "./lexer"
import Nexus, calc_pos from "./nexus/nexus"
import Str from "std/string"
import Path from "std/path"
import Arena from "std/allocator"
import File, Embed from "std/fs"
import id_none from "./nexus/pool"
import fall from "std/sys"

print :: fn(s &u8)
print_u32 :: fn(v u32)
get_env :: fn(name &u8) &u8

to_cstr :: fn(arena &Arena, s Str) &u8 {
    buf := arena.alloc(s.len + 1)
    i: u64 = 0
    while i < s.len {
        *(buf + i) = *(s.ptr + i)
        i = i + 1
    }
    *(buf + s.len) = 0 as u8
    buf
}

index_error :: fn(db &Nexus, file_id u32, offset u32, msg &u8, detail Str) {
    print(c"\n[import error] ")
    print(msg)
    if detail.len > 0 {
        print(c": ")
        write_str(detail)
    }
    pos := calc_pos(db.get_file_source(file_id), offset)
    print(c"\n       --> ")
    write_str(db.get_file_path(file_id))
    print(c":")
    print_u32(pos.line)
    print(c":")
    print_u32(pos.col)
    print(c"\n\n")
    fall()
}

is_embedded_path :: fn(path Str) bool {
    path.starts_with(Str.of("std/")) or path.starts_with(Str.of("core/")) or path.starts_with(Str.of("std\\")) or path.starts_with(Str.of("core\\"))
}

embedded_source_body :: fn() Str {
    arena := Arena.new(2 * 1024 * 1024)
    Embed.sources(&arena)
}

embedded_source :: fn(mod_path Str) Str {
    #embedded_source_body()
}

module_path :: fn(db &Nexus, arena &Arena, file_id u32, offset u32, base Str, path Str) Str {
    if path.ends_with(".a") {
        index_error(db, file_id, offset, c"import paths must omit the '.a' extension", path)
    }
    full_path := Path.ensure_ext(arena, path, Str.of(".a"))
    is_rel := full_path.starts_with(Str.of("./")) or full_path.starts_with(Str.of("../")) or full_path.starts_with(Str.of(".\\")) or full_path.starts_with(Str.of("..\\"))
    embedded := is_embedded_path(full_path) or is_embedded_path(base)
    target := Str.empty()
    if is_rel {
        target = Path.resolve(arena, base, full_path)
    } else {
        if is_embedded_path(base) and (not is_embedded_path(full_path)) {
            target = Path.resolve(arena, base, full_path)
        } else {
            target = Path.normalize(arena, full_path)
        }
    }
    if embedded and (not is_embedded_path(target)) {
        index_error(db, file_id, offset, c"embedded import escapes library root", path)
    }
    target
}

Indexer :: struct {
    db              &Nexus
    arena           &Arena
    loaded_paths    Vec(u32)
    queue_fids      Vec(u32)
    queue_tok_start Vec(u32)
    queue_tok_end   Vec(u32)
    pending_imports Vec(u32)

    new :: fn(db &Nexus, arena &Arena) Self {
        .{
            db              : db,
            arena           : arena,
            loaded_paths    : Vec(u32).new(),
            queue_fids      : Vec(u32).new(),
            queue_tok_start : Vec(u32).new(),
            queue_tok_end   : Vec(u32).new(),
            pending_imports : Vec(u32).new()
        }
    }

    destroy :: fn(self &Self) {
        self.loaded_paths.destroy()
        self.queue_fids.destroy()
        self.queue_tok_start.destroy()
        self.queue_tok_end.destroy()
        self.pending_imports.destroy()
    }

    resolve_and_load :: fn(self &Self, curr_path Str, import_path Str, file_id u32, offset u32) u32 {
        db := self.db
        target_path := module_path(db, self.arena, file_id, offset, curr_path, import_path)
        path_id := db.interner.intern(target_path)

        i: u64 = 0
        while i < self.loaded_paths.len {
            if self.loaded_paths.get(i) == path_id {
                ret i as u32
            }
            i = i + 1
        }

        source := Str.empty()
        if is_embedded_path(target_path) {
            env_dev := get_env(c"ABYSS_DEV")
            if env_dev != (0 as &u8) {
                disk_path := target_path
                dev_str := Str.of(env_dev)
                if (not dev_str.eq(Str.of("1"))) and (not dev_str.eq(Str.of("true"))) {
                    disk_path = Path.join(self.arena, dev_str, target_path)
                }
                c_disk_path := to_cstr(self.arena, disk_path)
                disk_opt := File.read_to_string(self.arena, c_disk_path)
                if disk_opt.is_some() {
                    source = disk_opt.unwrap()
                }
            }
            if source.ptr == (0 as &u8) {
                source = embedded_source(target_path)
            }
            if source.ptr == (0 as &u8) {
                index_error(db, file_id, offset, c"embedded module not found", target_path)
            }
        } else {
            c_target_path := to_cstr(self.arena, target_path)
            file_opt := File.read_to_string(self.arena, c_target_path)
            if file_opt.is_some() {
                source = file_opt.unwrap()
            } else {
                index_error(db, file_id, offset, c"cannot open module", target_path)
            }
        }

        fid := db.add_file(target_path, source)
        while self.loaded_paths.len < (fid as u64) {
            self.loaded_paths.push(id_none())
        }
        self.loaded_paths.push(path_id)

        tok_start := db.tokens.count() as u32
        lex(&(*db).tokens, source, target_path)
        tok_end := db.tokens.count() as u32

        self.queue_fids.push(fid)
        self.queue_tok_start.push(tok_start)
        self.queue_tok_end.push(tok_end)

        fid
    }

    scan_symbols :: fn(self &Self, file_id u32, curr_path Str, start_tok u32, end_tok u32) {
        db := self.db
        t := token
        cursor := start_tok
        depth: u32 = 0

        has_sym := false
        curr_sym_name: u32 = 0
        curr_sym_tok:  u32 = 0

        while cursor < end_tok {
            tk := db.tokens.kind(cursor)

            if (tk == t.o_brace) or (tk == t.o_paren) or (tk == t.o_bracket) {
                depth = depth + 1
            } else if (tk == t.c_brace) or (tk == t.c_paren) or (tk == t.c_bracket) {
                if depth > 0 {
                    depth = depth - 1
                }
            } else if (depth == 0) and (tk == t.semi) {
                index_error(db, file_id, db.tokens.start(cursor), c"expected ',' or newline between top-level declarations", Str.empty())
            } else if (depth == 0) and (tk == t.comma) {
                if has_sym {
                    db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, cursor)
                    has_sym = false
                } else if (cursor == start_tok) or (db.tokens.kind(cursor - 1) != t.lit_str) {
                    index_error(db, file_id, db.tokens.start(cursor), c"expected declaration before ','", Str.empty())
                }
            } else if (depth == 0) and (tk == t.kw_import) {
                if (cursor > start_tok) and (not db.tokens.newline_before(cursor)) and (db.tokens.kind(cursor - 1) != t.comma) {
                    index_error(db, file_id, db.tokens.start(cursor), c"expected ',' or newline between top-level declarations", Str.empty())
                }
                if has_sym {
                    db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, cursor)
                    has_sym = false
                }

                scan := cursor + 1
                import_mark := self.pending_imports.len

                while scan < end_tok {
                    if db.tokens.kind(scan) != t.ident {
                        index_error(db, file_id, db.tokens.start(scan), c"expected import name", Str.empty())
                    }
                    name_tok := scan
                    name_id := db.interner.intern(db.tokens.text(scan))
                    scan = scan + 1
                    local_id := name_id
                    if (scan < end_tok) and (db.tokens.kind(scan) == t.kw_as) {
                        scan = scan + 1
                        if (scan >= end_tok) or (db.tokens.kind(scan) != t.ident) {
                            index_error(db, file_id, db.tokens.start(if scan < end_tok { scan } else { end_tok - 1 }), c"expected import alias after 'as'", Str.empty())
                        }
                        local_id = db.interner.intern(db.tokens.text(scan))
                        scan = scan + 1
                    }
                    self.pending_imports.push(file_id)
                    self.pending_imports.push(local_id)
                    self.pending_imports.push(name_id)
                    self.pending_imports.push(id_none())
                    self.pending_imports.push(name_tok)
                    if (scan < end_tok) and (db.tokens.kind(scan) == t.kw_from) {
                        scan = scan + 1
                        break
                    }
                    if (scan < end_tok) and (db.tokens.kind(scan) == t.comma) {
                        scan = scan + 1
                    } else if (scan >= end_tok) or (not db.tokens.newline_before(scan)) {
                        index_error(db, file_id, db.tokens.start(if scan < end_tok { scan } else { end_tok - 1 }), c"expected ',' or 'from' after import name", Str.empty())
                    }
                }

                if (scan >= end_tok) or (self.pending_imports.len == import_mark) {
                    index_error(db, file_id, db.tokens.start(if scan < end_tok { scan } else { end_tok - 1 }), c"expected names, 'from', and a quoted path", Str.empty())
                }
                if db.tokens.kind(scan) != t.lit_str {
                    index_error(db, file_id, db.tokens.start(scan), c"expected quoted import path", Str.empty())
                }

                raw_path := db.tokens.text(scan)
                path_str := raw_path.trim_quotes()

                target_fid := self.resolve_and_load(curr_path, path_str, file_id, db.tokens.start(scan))

                n_i := import_mark
                while n_i < self.pending_imports.len {
                    self.pending_imports.set(n_i + 3, target_fid)
                    n_i = n_i + 5
                }
                cursor = scan + 1
                cont
            } else if (depth == 0) and (tk == t.ident) {
                if (cursor + 1) < end_tok {
                    if db.tokens.kind(cursor + 1) == t.colon_colon {
                        if (cursor > start_tok) and (not db.tokens.newline_before(cursor)) and (db.tokens.kind(cursor - 1) != t.comma) {
                            index_error(db, file_id, db.tokens.start(cursor), c"expected ',' or newline between top-level declarations", Str.empty())
                        }
                        if has_sym {
                            db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, cursor)
                        }
                        curr_sym_name = db.interner.intern(db.tokens.text(cursor))
                        curr_sym_tok  = cursor
                        has_sym = true
                        cursor = cursor + 1
                    }
                }
            }

            cursor = cursor + 1
        }

        if has_sym {
            db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, end_tok)
        }
    }

    resolve_pending_imports :: fn(self &Self) {
        db := self.db
        changed := true
        while changed {
            changed = false
            p_i: u64 = 0
            while p_i < self.pending_imports.len {
                src_fid := self.pending_imports.get(p_i)
                if src_fid != id_none() {
                    loc_name := self.pending_imports.get(p_i + 1)
                    imp_name := self.pending_imports.get(p_i + 2)
                    tgt_fid  := self.pending_imports.get(p_i + 3)

                    target_sym := db.find_local_symbol(tgt_fid, imp_name)
                    if target_sym != id_none() {
                        existing := db.find_local_symbol(src_fid, loc_name)
                        if (existing != id_none()) and (existing != target_sym) {
                            name_tok := self.pending_imports.get(p_i + 4)
                            if db.tokens.kind(name_tok + 1) == token.kw_as { name_tok = name_tok + 2 }
                            index_error(db, src_fid, db.tokens.start(name_tok), c"import name conflicts with an existing symbol", db.interner.get(loc_name))
                        }
                        if existing == id_none() {
                            db.alloc_symbol_alias(src_fid, loc_name, target_sym)
                        }
                        self.pending_imports.set(p_i, id_none())
                        changed = true
                    }
                }
                p_i = p_i + 5
            }
        }

        check_i: u64 = 0
        while check_i < self.pending_imports.len {
            src_fid := self.pending_imports.get(check_i)
            if src_fid != id_none() {
                name_id := self.pending_imports.get(check_i + 2)
                name_tok := self.pending_imports.get(check_i + 4)
                index_error(db, src_fid, db.tokens.start(name_tok), c"symbol not found", db.interner.get(name_id))
            }
            check_i = check_i + 5
        }
    }

    run :: fn(self &Self, root_fid u32, root_path Str, start_tok u32, end_tok u32) {
        db := self.db
        root_path_id := db.interner.intern(root_path)
        while self.loaded_paths.len < (root_fid as u64) {
            self.loaded_paths.push(id_none())
        }
        self.loaded_paths.push(root_path_id)

        self.queue_fids.push(root_fid)
        self.queue_tok_start.push(start_tok)
        self.queue_tok_end.push(end_tok)

        db.core_prelude = self.resolve_and_load(Str.empty(), Str.of("core/prelude"), root_fid, 0)
        db.std_prelude  = self.resolve_and_load(Str.empty(), Str.of("std/prelude"), root_fid, 0)

        q_head: u64 = 0
        while q_head < self.queue_fids.len {
            fid   := self.queue_fids.get(q_head)
            s_tok := self.queue_tok_start.get(q_head)
            e_tok := self.queue_tok_end.get(q_head)

            path_id := self.loaded_paths.get(fid as u64)
            c_path  := db.interner.get(path_id)

            self.scan_symbols(fid, c_path, s_tok, e_tok)

            q_head = q_head + 1
        }

        self.resolve_pending_imports()
    }
}

index_file :: fn(db &Nexus, arena &Arena, root_fid u32, root_path Str, start_tok u32, end_tok u32) {
    indexer := Indexer.new(db, arena)
    indexer.run(root_fid, root_path, start_tok, end_tok)
    indexer.destroy()
}

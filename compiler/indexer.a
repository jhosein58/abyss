import .token: Token, is_path_ident
import .lexer: lex
import .nexus.nexus: Nexus, calc_pos
import std.string: Str, String
import std.path: Path
import std.allocator: Arena
import std.fs: File, Embed
import .nexus.pool: id_none
import std.sys: fall

QueuedFile :: struct {
    fid       u32
    tok_start u32
    tok_end   u32
}

PendingImport :: struct {
    src_fid  u32
    loc_name u32
    imp_name u32
    tgt_fid  u32
    sym_tok  u32
}

ParsedImportPath :: struct {
    path        Str
    last_seg_id u32
    start_tok   u32
    next_tok    u32
}

get_env :: fn(name &u8) &u8

index_error :: fn(db &Nexus, file_id u32, offset u32, msg &u8, detail Str) {
    pos := calc_pos(db.get_file_source(file_id), offset)
    path := db.get_file_path(file_id)
    if detail.len > 0 {
        printf("\n[import error] {}: {}\n       --> {}:{}:{}\n\n", .{msg, detail, path, pos.line, pos.col})
    } else {
        printf("\n[import error] {}\n       --> {}:{}:{}\n\n", .{msg, path, pos.line, pos.col})
    }
    fall()
}

is_embedded_path :: fn(path Str) bool {
    path.starts_with("std/") or path.starts_with("core/") or path.starts_with("std\\") or path.starts_with("core\\")
}

embedded_source_body :: fn() Str {
    arena := Arena.new(2 * 1024 * 1024)
    Embed.sources(&arena)
}

embedded_source :: fn(mod_path Str) Str {
    #embedded_source_body()
}

module_path :: fn(db &Nexus, arena &Arena, file_id u32, offset u32, base Str, path Str) Str {
    if path.ends_with(".a") {
        index_error(db, file_id, offset, c"import paths must omit the '.a' extension", path)
    }
    full_path := Path.ensure_ext(arena, path, ".a")
    is_rel := full_path.starts_with("./") or full_path.starts_with(".\\")
    embedded := is_embedded_path(full_path) or is_embedded_path(base)
    target := if is_rel or (is_embedded_path(base) and (not is_embedded_path(full_path))) {
        Path.resolve(arena, base, full_path)
    } else {
        Path.normalize(arena, full_path)
    }
    if embedded and (not is_embedded_path(target)) {
        index_error(db, file_id, offset, c"embedded import escapes library root", path)
    }
    target
}

ensure_decl_sep :: fn(db &Nexus, fid u32, cursor u32, start u32) {
    if (cursor > start) and (not db.tokens.newline_before(cursor)) and (db.tokens.kind(cursor - 1) != Token.comma) {
        index_error(db, fid, db.tokens.start(cursor), c"expected ',' or newline between top-level declarations", Str.empty())
    }
}

is_decl_start :: fn(db &Nexus, scan u32, end_tok u32) bool {
    if (scan >= end_tok) or (db.tokens.kind(scan) != Token.ident) or (scan + 1 >= end_tok) {
        ret false
    }
    k := db.tokens.kind(scan + 1)
    (k == Token.colon_colon) or (k == Token.colon) or (k == Token.o_paren) or (k == Token.dot) or (k == Token.eq)
}

scan_import_path :: fn(db &Nexus, arena &Arena, fid u32, start u32, end_tok u32) ParsedImportPath {
    scan := start
    dots: u32 = 0
    while (scan < end_tok) and (db.tokens.kind(scan) == Token.dot) {
        dots = dots + 1
        scan = scan + 1
    }
    if dots > 1 {
        index_error(db, fid, db.tokens.start(start), c"parent directory imports ('..') are not allowed; use absolute paths", Str.empty())
    }
    buf := String.new(arena)
    if dots == 1 {
        buf.push_str("./")
    }
    if (scan >= end_tok) or (not is_path_ident(db.tokens.kind(scan))) {
        err_tok := if scan < end_tok { scan } else { end_tok - 1 }
        index_error(db, fid, db.tokens.start(err_tok), c"expected module path", Str.empty())
    }
    seg := db.tokens.text(scan)
    seg_id := db.interner.intern(seg)
    buf.push_str(seg)
    scan = scan + 1
    while (scan < end_tok) and (db.tokens.kind(scan) == Token.dot) {
        scan = scan + 1
        if (scan >= end_tok) or (not is_path_ident(db.tokens.kind(scan))) {
            err_tok := if scan < end_tok { scan } else { end_tok - 1 }
            index_error(db, fid, db.tokens.start(err_tok), c"expected module path segment after '.'", Str.empty())
        }
        buf.push_char('/' as u8)
        seg = db.tokens.text(scan)
        seg_id = db.interner.intern(seg)
        buf.push_str(seg)
        scan = scan + 1
    }
    .{
        path: buf.as_str()
        last_seg_id: seg_id
        start_tok: start
        next_tok: scan
    }
}

Indexer :: struct {
    db              &Nexus
    arena           &Arena
    loaded_paths    Vec(u32)
    queue           Vec(QueuedFile)
    pending_imports Vec(PendingImport)

    new :: fn(db &Nexus, arena &Arena) Self {
        .{
            db: db
            arena: arena
            loaded_paths: Vec(u32).new()
            queue: Vec(QueuedFile).new()
            pending_imports: Vec(PendingImport).new()
        }
    }

    destroy :: fn(self &Self) {
        self.loaded_paths.destroy()
        self.queue.destroy()
        self.pending_imports.destroy()
    }

    find_loaded :: fn(self &Self, path_id u32) u32 {
        i: u64 = 0
        while i < self.loaded_paths.len {
            if self.loaded_paths.get(i) == path_id {
                ret i as u32
            }
            i = i + 1
        }
        id_none()
    }

    try_load_source :: fn(self &Self, target_path Str) Str {
        if is_embedded_path(target_path) {
            env_dev := get_env(c"ABYSS_DEV")
            if env_dev != (0 as &u8) {
                dev_str := Str.of(env_dev)
                disk_path := if (not dev_str.eq("1")) and (not dev_str.eq("true")) {
                    Path.join(self.arena, dev_str, target_path)
                } else {
                    target_path
                }
                disk_opt := File.read_to_string(self.arena, disk_path)
                if disk_opt.is_some() {
                    ret disk_opt.unwrap()
                }
            }
            ret embedded_source(target_path)
        }
        file_opt := File.read_to_string(self.arena, target_path)
        if file_opt.is_some() { file_opt.unwrap() } else { Str.empty() }
    }

    resolve_and_load :: fn(self &Self, curr_path Str, import_path Str, file_id u32, offset u32) u32 {
        db := self.db
        eff_path := import_path
        mi: u64 = 0
        while mi < db.map_keys.len {
            key := db.map_keys.get(mi)
            val := db.map_values.get(mi)
            if import_path.eq(key) {
                eff_path = val
                break
            } else if import_path.starts_with(key) and (import_path.len > key.len) {
                sep := *(import_path.ptr + key.len)
                if (sep == ('/' as u8)) or (sep == ('.' as u8)) or (sep == ('\\' as u8)) {
                    eff_path = Path.join(self.arena, val, import_path.sub(key.len + 1, import_path.len - key.len - 1))
                    break
                }
            }
            mi = mi + 1
        }
        target_path := module_path(db, self.arena, file_id, offset, curr_path, eff_path)
        path_id := db.interner.intern(target_path)

        fid := self.find_loaded(path_id)
        if fid != id_none() {
            ret fid
        }

        source := self.try_load_source(target_path)
        if source.ptr == (0 as &u8) {
            di: u64 = 0
            while (source.ptr == (0 as &u8)) and (di < db.import_dirs.len) {
                cand := Path.join(self.arena, db.import_dirs.get(di), target_path)
                cand_id := db.interner.intern(cand)
                cfid := self.find_loaded(cand_id)
                if cfid != id_none() { ret cfid }
                cand_src := self.try_load_source(cand)
                if cand_src.ptr != (0 as &u8) {
                    source = cand_src
                    target_path = cand
                    path_id = cand_id
                }
                di = di + 1
            }
        }

        if (source.ptr == (0 as &u8)) and target_path.ends_with(".a") {
            no_ext := target_path.sub(0, target_path.len - 2)
            dir_name := Path.base(no_ext)
            folder_file := Path.join(self.arena, no_ext, Path.ensure_ext(self.arena, dir_name, ".a"))
            f_path_id := db.interner.intern(folder_file)
            f_fid := self.find_loaded(f_path_id)
            if f_fid != id_none() {
                ret f_fid
            }
            folder_source := self.try_load_source(folder_file)
            if folder_source.ptr != (0 as &u8) {
                source = folder_source
                target_path = folder_file
                path_id = f_path_id
            } else {
                fdi: u64 = 0
                while (source.ptr == (0 as &u8)) and (fdi < db.import_dirs.len) {
                    f_cand := Path.join(self.arena, db.import_dirs.get(fdi), folder_file)
                    f_cand_id := db.interner.intern(f_cand)
                    f_cfid := self.find_loaded(f_cand_id)
                    if f_cfid != id_none() { ret f_cfid }
                    f_cand_src := self.try_load_source(f_cand)
                    if f_cand_src.ptr != (0 as &u8) {
                        source = f_cand_src
                        target_path = f_cand
                        path_id = f_cand_id
                    }
                    fdi = fdi + 1
                }
            }
        }

        if source.ptr == (0 as &u8) {
            if is_embedded_path(target_path) {
                index_error(db, file_id, offset, c"embedded module not found", target_path)
            } else {
                index_error(db, file_id, offset, c"cannot open module", target_path)
            }
        }

        fid = db.add_file(target_path, source)
        while self.loaded_paths.len < (fid as u64) {
            self.loaded_paths.push(id_none())
        }
        self.loaded_paths.push(path_id)

        tok_start := db.tokens.count() as u32
        lex(&db.tokens, source, target_path)
        tok_end := db.tokens.count() as u32

        self.queue.push(.{
            fid: fid
            tok_start: tok_start
            tok_end: tok_end
        })

        fid
    }

    scan_import_symbols :: fn(self &Self, fid u32, target_fid u32, start u32, end_tok u32, is_top bool) u32 {
        db := self.db
        scan := start
        while scan < end_tok {
            if db.tokens.kind(scan) != Token.ident {
                index_error(db, fid, db.tokens.start(scan), c"expected imported symbol name", Str.empty())
            }
            sym_tok := scan
            sym_name := db.interner.intern(db.tokens.text(scan))
            scan = scan + 1
            local_name := sym_name
            if (scan < end_tok) and (db.tokens.kind(scan) == Token.kw_as) {
                scan = scan + 1
                if (scan >= end_tok) or (db.tokens.kind(scan) != Token.ident) or db.tokens.newline_before(scan) {
                    err_tok := if scan < end_tok { scan } else { end_tok - 1 }
                    index_error(db, fid, db.tokens.start(err_tok), c"expected symbol alias after 'as'", Str.empty())
                }
                local_name = db.interner.intern(db.tokens.text(scan))
                scan = scan + 1
            }
            if is_top {
                self.pending_imports.push(.{
                    src_fid: fid
                    loc_name: local_name
                    imp_name: sym_name
                    tgt_fid: target_fid
                    sym_tok: sym_tok
                })
            }
            if (scan < end_tok) and (db.tokens.kind(scan) == Token.comma) {
                scan = scan + 1
                if (scan < end_tok) and db.tokens.newline_before(scan) and ((db.tokens.kind(scan) != Token.ident) or is_decl_start(db, scan, end_tok)) {
                    break
                }
            } else if (scan < end_tok) and db.tokens.newline_before(scan) {
                if (db.tokens.kind(scan) != Token.ident) or is_decl_start(db, scan, end_tok) {
                    break
                }
            } else {
                if (scan < end_tok) and (db.tokens.kind(scan) != Token.eof) and (not db.tokens.newline_before(scan)) {
                    index_error(db, fid, db.tokens.start(scan), c"expected ',' or newline between imported symbols", Str.empty())
                }
                break
            }
        }
        scan
    }

    scan_symbols :: fn(self &Self, file_id u32, curr_path Str, start_tok u32, end_tok u32) {
        db := self.db
        cursor := start_tok
        depth: u32 = 0

        has_sym := false
        curr_sym_name: u32 = 0
        curr_sym_tok:  u32 = 0

        while cursor < end_tok {
            tk := db.tokens.kind(cursor)

            if (tk == Token.o_brace) or (tk == Token.o_paren) or (tk == Token.o_bracket) {
                depth = depth + 1
            } else if (tk == Token.c_brace) or (tk == Token.c_paren) or (tk == Token.c_bracket) {
                if depth > 0 {
                    depth = depth - 1
                }
            } else if (depth == 0) and (tk == Token.semi) {
                index_error(db, file_id, db.tokens.start(cursor), c"expected ',' or newline between top-level declarations", Str.empty())
            } else if (depth == 0) and (tk == Token.comma) {
                if has_sym {
                    db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, cursor)
                    has_sym = false
                } else if (cursor == start_tok) or (db.tokens.kind(cursor - 1) != Token.lit_str) {
                    index_error(db, file_id, db.tokens.start(cursor), c"expected declaration before ','", Str.empty())
                }
            } else if tk == Token.kw_import {
                if depth == 0 {
                    ensure_decl_sep(db, file_id, cursor, start_tok)
                    if has_sym {
                        db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, cursor)
                        has_sym = false
                    }
                }

                parsed := scan_import_path(db, self.arena, file_id, cursor + 1, end_tok)
                scan := parsed.next_tok

                if (scan < end_tok) and (db.tokens.kind(scan) == Token.kw_as) {
                    scan = scan + 1
                    if (scan >= end_tok) or (db.tokens.kind(scan) != Token.ident) or db.tokens.newline_before(scan) {
                        err_tok := if scan < end_tok { scan } else { end_tok - 1 }
                        index_error(db, file_id, db.tokens.start(err_tok), c"expected import alias after 'as'", Str.empty())
                    }
                    mod_alias := db.interner.intern(db.tokens.text(scan))
                    scan = scan + 1
                    target_fid := self.resolve_and_load(curr_path, parsed.path, file_id, db.tokens.start(parsed.start_tok))
                    if depth == 0 {
                        db.alloc_module_symbol(file_id, mod_alias, target_fid)
                    }
                    cursor = scan
                    cont
                }

                target_fid := self.resolve_and_load(curr_path, parsed.path, file_id, db.tokens.start(parsed.start_tok))

                if (scan < end_tok) and (db.tokens.kind(scan) == Token.colon) {
                    cursor = self.scan_import_symbols(file_id, target_fid, scan + 1, end_tok, depth == 0)
                    cont
                }

                if depth == 0 {
                    db.alloc_module_symbol(file_id, parsed.last_seg_id, target_fid)
                }
                cursor = scan
                cont
            } else if (depth == 0) and (tk == Token.ident) {
                if (cursor + 1) < end_tok {
                    if db.tokens.kind(cursor + 1) == Token.colon_colon {
                        ensure_decl_sep(db, file_id, cursor, start_tok)
                        if has_sym {
                            db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, cursor)
                        }
                        curr_sym_name = db.interner.intern(db.tokens.text(cursor))
                        curr_sym_tok  = cursor
                        has_sym = true
                        cursor = cursor + 1
                    }
                }
            }

            cursor = cursor + 1
        }

        if has_sym {
            db.alloc_symbol(file_id, curr_sym_name, curr_sym_tok, end_tok)
        }
    }

    resolve_pending_imports :: fn(self &Self) {
        db := self.db
        changed := true
        while changed {
            changed = false
            i: u64 = 0
            while i < self.pending_imports.len {
                item := self.pending_imports.ptr_at(i)
                if item.src_fid != id_none() {
                    target_sym := db.find_local_symbol(item.tgt_fid, item.imp_name)
                    if target_sym != id_none() {
                        existing := db.find_local_symbol(item.src_fid, item.loc_name)
                        if (existing != id_none()) and (existing != target_sym) {
                            name_tok := item.sym_tok
                            if db.tokens.kind(name_tok + 1) == Token.kw_as {
                                name_tok = name_tok + 2
                            }
                            index_error(db, item.src_fid, db.tokens.start(name_tok), c"import name conflicts with an existing symbol", db.interner.get(item.loc_name))
                        }
                        if existing == id_none() {
                            db.alloc_symbol_alias(item.src_fid, item.loc_name, target_sym)
                        }
                        item.src_fid = id_none()
                        changed = true
                    }
                }
                i = i + 1
            }
        }

        for item in self.pending_imports {
            if item.src_fid != id_none() {
                index_error(db, item.src_fid, db.tokens.start(item.sym_tok), c"symbol not found", db.interner.get(item.imp_name))
            }
        }
    }

    run :: fn(self &Self, root_fid u32, root_path Str, start_tok u32, end_tok u32) {
        db := self.db
        root_path_id := db.interner.intern(root_path)
        while self.loaded_paths.len < (root_fid as u64) {
            self.loaded_paths.push(id_none())
        }
        self.loaded_paths.push(root_path_id)

        self.queue.push(.{
            fid: root_fid
            tok_start: start_tok
            tok_end: end_tok
        })

        db.core_prelude = self.resolve_and_load(Str.empty(), "core/prelude", root_fid, 0)
        db.std_prelude  = self.resolve_and_load(Str.empty(), "std/prelude", root_fid, 0)

        q_head: u64 = 0
        while q_head < self.queue.len {
            file := self.queue.get(q_head)
            path_id := self.loaded_paths.get(file.fid as u64)
            c_path := db.interner.get(path_id)

            self.scan_symbols(file.fid, c_path, file.tok_start, file.tok_end)

            q_head = q_head + 1
        }

        self.resolve_pending_imports()
    }
}

index_file :: fn(db &Nexus, arena &Arena, root_fid u32, root_path Str, start_tok u32, end_tok u32) {
    indexer := Indexer.new(db, arena)
    indexer.run(root_fid, root_path, start_tok, end_tok)
    indexer.destroy()
}

import VecU32 from "../../std/vec/u32.a"
import VecStr from "../../std/vec/str.a"
import SliceU32, SliceU32_new from "../../std/slice/u32.a"
import Interner from "../../std/interner.a"
import Str from "../../std/string.a"

import TypeStorage, ty_id_none from "../types.a"
import UnifyStorage from "../unify.a"
import TokenStream from "../token.a"
import HirTable from "../hir.a"
import PoolU32, id_none from "pool.a"

print :: (s &u8) unit
print_u32 :: (v u32) unit

Span :: struct {
    start : u32,
    end   : u32
}

Pos :: struct {
    line : u32,
    col  : u32
}

span_new :: (start u32, end u32) Span {
    .{ start: start, end: end }
}

span_merge :: (a Span, b Span) Span {
    s := a.start
    if b.start < s { s = b.start }
    
    e := a.end
    if b.end > e { e = b.end }

    .{ start: s, end: e }
}

calc_pos :: (source Str, offset u32) Pos {
    line: u32 = 1
    col:  u32 = 1
    i:    u64 = 0

    limit := offset as u64
    if limit > source.len {
        limit = source.len
    }

    while i < limit {
        c := *(source.ptr + i)
        if c == *"\n" {
            line = line + 1
            col  = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }

    .{ line: line, col: col }
}


Nexus :: struct {
    tokens         : TokenStream,
    hir            : HirTable,

    glob_stack     : VecU32,
    u32_items      : VecU32,
    interner       : Interner,
    types          : TypeStorage,
    unify          : UnifyStorage,

    sym_names      : PoolU32,
    sym_files      : PoolU32,
    sym_tok_start  : PoolU32,
    sym_tok_end    : PoolU32,
    sym_hir_start  : PoolU32,
    sym_hir_end    : PoolU32,
    sym_target     : PoolU32,

    sym_nodes      : PoolU32, -- SymbolId -> HirId
    hir_to_symbol  : PoolU32, -- HirId    -> SymbolId

    const_types    : PoolU32, -- HirId    -> TypeId 
    method_owner   : PoolU32,
    method_target  : PoolU32,
    sym_resolving  : PoolU32  -- SymbolId -> 0 or 1

    core_prelude   : u32,
    std_prelude    : u32,
    file_sources   : VecStr,
    file_paths     : VecStr,
    hir_files      : PoolU32, -- HirId    -> FileId
    hir_span_start : PoolU32, -- HirId    -> Span start offset
    hir_span_end   : PoolU32, -- HirId    -> Span end
    type_specialization_depth : u32,
    mono_method_owner : PoolU32,
    mono_orig_sym  : VecU32,
    mono_type      : VecU32,
    mono_sym       : VecU32,
    mono_nom_sym   : VecU32,
    mono_nom_arg   : VecU32,
    mono_nom_res   : VecU32,
    union_coerce_ty : PoolU32,
    union_coerce_idx : PoolU32

    new :: () Self {
        .{
            tokens         : TokenStream.new(),
            hir            : HirTable.new(),

            glob_stack     : VecU32.new(),
            u32_items      : VecU32.new(),
            interner       : Interner.new(),
             types          : TypeStorage.new(),
            unify          : UnifyStorage.new(),

            sym_names      : PoolU32.new(),
            sym_files      : PoolU32.new(),
            sym_tok_start  : PoolU32.new(),
            sym_tok_end    : PoolU32.new(),
            sym_hir_start  : PoolU32.new(),
            sym_hir_end    : PoolU32.new(),
            sym_target     : PoolU32.new(),
            sym_nodes      : PoolU32.new(),
            hir_to_symbol  : PoolU32.new(),

            const_types    : PoolU32.new(),
            method_owner   : PoolU32.new(),
            method_target  : PoolU32.new(),
            sym_resolving  : PoolU32.new(),

            core_prelude   : id_none(),
            std_prelude    : id_none(),
            file_sources   : VecStr.new(),
            file_paths     : VecStr.new(),
            hir_files      : PoolU32.new(),
            hir_span_start : PoolU32.new(),
            hir_span_end   : PoolU32.new(),
            type_specialization_depth : 0,
            mono_method_owner : PoolU32.new(),
            mono_orig_sym  : VecU32.new(),
            mono_type      : VecU32.new(),
            mono_sym       : VecU32.new(),
            mono_nom_sym   : VecU32.new(),
            mono_nom_arg   : VecU32.new(),
            mono_nom_res   : VecU32.new(),
            union_coerce_ty : PoolU32.new(),
            union_coerce_idx : PoolU32.new()
        }
    }

    add_list :: (items SliceU32) u32 {
        start := .u32_items.len as u32
        .u32_items.push(items.len as u32)
        .u32_items.extend(items.ptr, items.len)
        start
    }

    get_list :: (start u32) SliceU32 {
        len := .u32_items.get(start as u64)

        .{
            ptr: .u32_items.ptr_at((start as u64) + 1),
            len: len as u64
        }
    }

    alloc_symbol :: (file_id u32, name_id u32, tok_start u32, tok_end u32) u32 {
        sym_id := .sym_names.alloc(name_id)

        .sym_files.alloc(file_id)
        .sym_tok_start.alloc(tok_start)
        .sym_tok_end.alloc(tok_end)
        .sym_hir_start.alloc(id_none())
        .sym_hir_end.alloc(id_none())
        .sym_nodes.alloc(id_none())
        .sym_resolving.alloc(0)
        .sym_target.alloc(id_none())

        sym_id
    }

    alloc_local_symbol :: (file_id u32, name_id u32, hir_id u32) u32 {
        sym_id := .sym_names.alloc(name_id)

        .sym_files.alloc(file_id)
        .sym_tok_start.alloc(id_none())
        .sym_tok_end.alloc(id_none())
        .sym_hir_start.alloc(id_none())
        .sym_hir_end.alloc(id_none())
        .sym_nodes.alloc(hir_id)
        .sym_resolving.alloc(0)
        .sym_target.alloc(id_none())

        .set_hir_symbol(hir_id, sym_id)
        sym_id
    }

    alloc_symbol_alias :: (file_id u32, name_id u32, target_sym u32) u32 {
        sym_id := .sym_names.alloc(name_id)

        .sym_files.alloc(file_id)
        .sym_tok_start.alloc(id_none())
        .sym_tok_end.alloc(id_none())
        .sym_hir_start.alloc(id_none())
        .sym_hir_end.alloc(id_none())
        .sym_nodes.alloc(id_none())
        .sym_resolving.alloc(0)
        .sym_target.alloc(target_sym)

        sym_id
    }

    find_symbol :: (file_id u32, name_id u32) u32 {
        sym := .find_local_symbol(file_id, name_id)
        if sym != id_none() { ret sym }
        if .core_prelude != id_none() {
            sym = .find_local_symbol(.core_prelude, name_id)
            if sym != id_none() { ret sym }
        }
        if .std_prelude != id_none() {
            ret .find_local_symbol(.std_prelude, name_id)
        }
        id_none()
    }

    find_local_symbol :: (file_id u32, name_id u32) u32 {
        count := .sym_names.count()

        i: u32 = 0
        while i < count {
            f := .sym_files.get(i)
            n := .sym_names.get(i)
            if (f == file_id) and (n == name_id) {
                curr := i
                while curr != id_none() {
                    target := .sym_target.get(curr)
                    if (target == id_none()) or (target == curr) {
                        ret curr
                    }
                    curr = target
                }
                ret i
            }
            i = i + 1
        }
        id_none()
    }

    set_sym_hir :: (sym_id u32, hir_id u32) {
        .sym_nodes.set(sym_id, hir_id)
    }

    get_sym_hir :: (sym_id u32) u32 {
        if sym_id == id_none() { ret id_none() }
        if sym_id >= .sym_nodes.count() { ret id_none() }
        .sym_nodes.get(sym_id)
    }

    set_hir_symbol :: (hir_id u32, sym_id u32) {
        .hir_to_symbol.set_safe(hir_id, sym_id, id_none())
    }

    get_hir_symbol :: (hir_id u32) u32 {
        if hir_id == id_none() { ret id_none() }
        if hir_id >= .hir_to_symbol.count() { ret id_none() }
        .hir_to_symbol.get(hir_id)
    }

    set_const_type :: (hir_id u32, ty_id u32) {
        .const_types.set_safe(hir_id, ty_id, ty_id_none())
    }

    get_const_type :: (hir_id u32) u32 {
        if hir_id >= .const_types.count() { ret ty_id_none() }
        .const_types.get(hir_id)
    }

    set_method_owner :: (hir_id u32, struct_id u32) {
        .method_owner.set_safe(hir_id, struct_id, id_none())
    }

    get_method_owner :: (hir_id u32) u32 {
        if hir_id >= .method_owner.count() { ret id_none() }
        .method_owner.get(hir_id)
    }

    set_method_target :: (hir_id u32, method_id u32) {
        .method_target.set_safe(hir_id, method_id, id_none())
    }

    get_method_target :: (hir_id u32) u32 {
        if hir_id >= .method_target.count() { ret id_none() }
        .method_target.get(hir_id)
    }

    set_sym_resolving :: (sym_id u32, resolving bool) {
        val: u32 = 0
        if resolving { val = 1 }
        .sym_resolving.set_safe(sym_id, val, 0)
    }

    is_sym_resolving :: (sym_id u32) bool {
        if sym_id >= .sym_resolving.count() { ret false }
        .sym_resolving.get(sym_id) == 1
    }

    add_file_source :: (source Str) u32 {
        id := .file_sources.len as u32
        .file_sources.push(source)
        id
    }

    set_hir_span :: (hir_id u32, start u32, end u32) {
        .hir_span_start.set_safe(hir_id, start, 0)
        .hir_span_end.set_safe(hir_id, end, 0)
    }

    set_hir_file :: (hir_id u32, file_id u32) {
        .hir_files.set_safe(hir_id, file_id, id_none())
    }

    get_hir_file :: (hir_id u32) u32 {
        if hir_id >= .hir_files.count() { ret id_none() }
        .hir_files.get(hir_id)
    }

    get_hir_span :: (hir_id u32) Span {
        if hir_id >= .hir_span_start.count() {
            ret .{ start: 0, end: 0 }
        }
        start := .hir_span_start.get(hir_id)
        end   := .hir_span_end.get(hir_id)
        .{ start: start, end: end }
    }

    add_file :: (path Str, source Str) u32 {
        id := .file_sources.len as u32
        .file_paths.push(path)
        .file_sources.push(source)
        id
    }

    get_file_path :: (file_id u32) Str {
        if (file_id as u64) >= .file_paths.len { ret Str.of("unknown") }
        .file_paths.get(file_id as u64)
    }

    get_file_source :: (file_id u32) Str {
        if (file_id as u64) >= .file_sources.len { ret Str.of("") }
        .file_sources.get(file_id as u64)
    }

    get_pos :: (hir_id u32) Pos {
        fid := .get_hir_file(hir_id)
        span := .get_hir_span(hir_id)

        if (fid == id_none()) or ((fid as u64) >= .file_sources.len) {
            ret .{ line: 1, col: 1 }
        }

        src := .file_sources.get(fid as u64)
        calc_pos(src, span.start)
    }

    set_type_error_origin :: (hir_id u32) {
        file_id := .get_hir_file(hir_id)
        .unify.error_path = .get_file_path(file_id)
        .unify.error_source = .get_file_source(file_id)
        .unify.error_offset = .get_hir_span(hir_id).start
    }

    print_loc :: (hir_id u32) {
        fid := .get_hir_file(hir_id)
        path := .get_file_path(fid)
        pos := .get_pos(hir_id)

        print(path.ptr)
        print(":")
        print_u32(pos.line)
        print(":")
        print_u32(pos.col)
    }

    find_mono_sym :: (orig_sym u32, mono_ty u32) u32 {
        i: u64 = 0
        while i < .mono_orig_sym.len {
            if (.mono_orig_sym.get(i) == orig_sym) and (.mono_type.get(i) == mono_ty) {
                ret .mono_sym.get(i)
            }
            i = i + 1
        }
        id_none()
    }

    alloc_mono_sym :: (orig_sym u32, mono_ty u32) u32 {
        file_id: u32 = 0
        name_id: u32 = 0
        if (orig_sym & 2147483648) != 0 {
            binding_id := orig_sym & 2147483647
            file_id = .get_hir_file(binding_id)
            name_hir := .hir.lhs(binding_id)
            name_id = .hir.lhs(name_hir)
        } else {
            file_id = .sym_files.get(orig_sym)
            name_id = .sym_names.get(orig_sym)
        }
        sym_id := .sym_names.alloc(name_id)
        .sym_files.alloc(file_id)
        .sym_tok_start.alloc(id_none())
        .sym_tok_end.alloc(id_none())
        .sym_hir_start.alloc(id_none())
        .sym_hir_end.alloc(id_none())
        .sym_nodes.alloc(id_none())
        .sym_resolving.alloc(0)
        .sym_target.alloc(id_none())

        .mono_orig_sym.push(orig_sym)
        .mono_type.push(mono_ty)
        .mono_sym.push(sym_id)
        sym_id
    }

    find_mono_method :: (sym u32, owner u32, func_ty u32) u32 {
        i: u64 = 0
        while i < .mono_sym.len {
            candidate := .mono_sym.get(i)
            if (.mono_orig_sym.get(i) == sym) and (.mono_type.get(i) == func_ty) {
                if .get_mono_method_owner(candidate) == owner { ret candidate }
            }
            i = i + 1
        }
        id_none()
    }

    get_mono_method_owner :: (sym u32) u32 {
        if sym >= .mono_method_owner.count() { ret ty_id_none() }
        .mono_method_owner.get(sym)
    }

    get_mono_orig_sym :: (sym u32) u32 {
        i: u64 = 0
        while i < .mono_sym.len {
            if .mono_sym.get(i) == sym {
                ret .mono_orig_sym.get(i)
            }
            i = i + 1
        }
        id_none()
    }

    get_mono_type :: (sym u32) u32 {
        i: u64 = 0
        while i < .mono_sym.len {
            if .mono_sym.get(i) == sym {
                ret .mono_type.get(i)
            }
            i = i + 1
        }
        ty_id_none()
    }

    is_mono_sym :: (sym u32) bool {
        .get_mono_orig_sym(sym) != id_none()
    }

    find_mono_nominal :: (sym u32, args SliceU32) u32 {
        i: u64 = 0
        while i < .mono_nom_sym.len {
            if .mono_nom_sym.get(i) == sym {
                stored_list := .get_list(.mono_nom_arg.get(i))
                if stored_list.len == args.len {
                    matched := true
                    j: u64 = 0
                    while j < args.len {
                        if *(stored_list.ptr + j) != *(args.ptr + j) {
                            matched = false
                            break
                        }
                        j = j + 1
                    }
                    if matched {
                        ret .mono_nom_res.get(i)
                    }
                }
            }
            i = i + 1
        }
        ty_id_none()
    }

    add_mono_nominal :: (sym u32, args SliceU32, res_ty u32) {
        list_id := .add_list(args)
        .mono_nom_sym.push(sym)
        .mono_nom_arg.push(list_id)
        .mono_nom_res.push(res_ty)
    }

    set_union_coerce :: (expr u32, ty u32, idx u32) {
        .union_coerce_ty.set_safe(expr, ty, ty_id_none())
        .union_coerce_idx.set_safe(expr, idx, 0)
    }

    has_union_coerce :: (expr u32) bool {
        if expr >= .union_coerce_ty.count() { ret false }
        .union_coerce_ty.get(expr) != ty_id_none()
    }

    get_union_coerce_ty :: (expr u32) u32 {
        if expr >= .union_coerce_ty.count() { ret ty_id_none() }
        .union_coerce_ty.get(expr)
    }

    get_union_coerce_idx :: (expr u32) u32 {
        if expr >= .union_coerce_idx.count() { ret 0 }
        .union_coerce_idx.get(expr)
    }
}

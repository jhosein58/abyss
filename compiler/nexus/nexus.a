import VecU32 from "std/vec/u32"
import VecStr from "std/vec/str"
import SliceU32, SliceU32_new from "std/slice/u32"
import Interner from "std/interner"
import Str from "std/string"

import TypeStorage, ty_id_none from "../types"
import UnifyStorage, slot_none from "../unify"
import TokenStream from "../token"
import HirTable, hir_kind, hir_none from "../hir"
import PoolU32, id_none from "./pool"

print :: fn(s &u8) unit
print_u32 :: fn(v u32) unit

Span :: struct {
    start, end u32
}

Pos :: struct {
    line, col u32
}

span_new :: fn(start u32, end u32) Span {
    .{ start: start, end: end }
}

span_merge :: fn(a Span, b Span) Span {
    s := a.start
    if b.start < s { s = b.start }
    
    e := a.end
    if b.end > e { e = b.end }

    .{ start: s, end: e }
}

calc_pos :: fn(source Str, offset u32) Pos {
    line: u32 = 1
    col:  u32 = 1
    i:    u64 = 0

    limit := offset as u64
    if limit > source.len {
        limit = source.len
    }

    while i < limit {
        c := *(source.ptr + i)
        if c == *"\n" {
            line = line + 1
            col  = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }

    .{ line: line, col: col }
}


Nexus :: struct {
    tokens         TokenStream
    hir            HirTable

    glob_stack     VecU32
    u32_items      VecU32
    interner       Interner
    types          TypeStorage
    unify          UnifyStorage

    sym_names      PoolU32
    sym_files      PoolU32
    sym_tok_start  PoolU32
    sym_tok_end    PoolU32
    sym_hir_start  PoolU32
    sym_hir_end    PoolU32
    sym_target     PoolU32

    sym_nodes      PoolU32
    hir_to_symbol  PoolU32

    const_types    PoolU32
    method_owner   PoolU32
    sym_resolving  PoolU32

    core_prelude   u32
    std_prelude    u32
    file_sources   VecStr
    file_paths     VecStr
    hir_files      PoolU32
    hir_span_start PoolU32
    hir_span_end   PoolU32
    type_specialization_depth u32
    mono_orig_sym  VecU32
    mono_type      VecU32
    mono_sym       VecU32
    mono_nom_sym   VecU32
    mono_nom_arg   VecU32
    mono_nom_res   VecU32
    union_coerce_ty PoolU32
    union_coerce_idx PoolU32
    str_type       u32

    new :: fn() Self {
        .{
            tokens         : TokenStream.new(),
            hir            : HirTable.new(),

            glob_stack     : VecU32.new(),
            u32_items      : VecU32.new(),
            interner       : Interner.new(),
             types          : TypeStorage.new(),
            unify          : UnifyStorage.new(),

            sym_names      : PoolU32.new(),
            sym_files      : PoolU32.new(),
            sym_tok_start  : PoolU32.new(),
            sym_tok_end    : PoolU32.new(),
            sym_hir_start  : PoolU32.new(),
            sym_hir_end    : PoolU32.new(),
            sym_target     : PoolU32.new(),
            sym_nodes      : PoolU32.new(),
            hir_to_symbol  : PoolU32.new(),

            const_types    : PoolU32.new(),
            method_owner   : PoolU32.new(),
            sym_resolving  : PoolU32.new(),

            core_prelude   : id_none(),
            std_prelude    : id_none(),
            file_sources   : VecStr.new(),
            file_paths     : VecStr.new(),
            hir_files      : PoolU32.new(),
            hir_span_start : PoolU32.new(),
            hir_span_end   : PoolU32.new(),
            type_specialization_depth : 0,
            mono_orig_sym  : VecU32.new(),
            mono_type      : VecU32.new(),
            mono_sym       : VecU32.new(),
            mono_nom_sym   : VecU32.new(),
            mono_nom_arg   : VecU32.new(),
            mono_nom_res   : VecU32.new(),
            union_coerce_ty : PoolU32.new(),
            union_coerce_idx : PoolU32.new(),
            str_type       : ty_id_none()
        }
    }

    add_list :: fn(self &Self, items SliceU32) u32 {
        start := self.u32_items.len as u32
        self.u32_items.push(items.len as u32)
        self.u32_items.extend(items.ptr, items.len)
        start
    }

    get_list :: fn(self &Self, start u32) SliceU32 {
        len := self.u32_items.get(start as u64)

        .{
            ptr: self.u32_items.ptr_at((start as u64) + 1),
            len: len as u64
        }
    }

    alloc_symbol :: fn(self &Self, file_id u32, name_id u32, tok_start u32, tok_end u32) u32 {
        sym_id := self.sym_names.alloc(name_id)

        self.sym_files.alloc(file_id)
        self.sym_tok_start.alloc(tok_start)
        self.sym_tok_end.alloc(tok_end)
        self.sym_hir_start.alloc(id_none())
        self.sym_hir_end.alloc(id_none())
        self.sym_nodes.alloc(id_none())
        self.sym_resolving.alloc(0)
        self.sym_target.alloc(id_none())

        sym_id
    }

    alloc_local_symbol :: fn(self &Self, file_id u32, name_id u32, hir_id u32) u32 {
        sym_id := self.sym_names.alloc(name_id)

        self.sym_files.alloc(file_id)
        self.sym_tok_start.alloc(id_none())
        self.sym_tok_end.alloc(id_none())
        self.sym_hir_start.alloc(id_none())
        self.sym_hir_end.alloc(id_none())
        self.sym_nodes.alloc(hir_id)
        self.sym_resolving.alloc(0)
        self.sym_target.alloc(id_none())

        self.set_hir_symbol(hir_id, sym_id)
        sym_id
    }

    alloc_symbol_alias :: fn(self &Self, file_id u32, name_id u32, target_sym u32) u32 {
        sym_id := self.sym_names.alloc(name_id)

        self.sym_files.alloc(file_id)
        self.sym_tok_start.alloc(id_none())
        self.sym_tok_end.alloc(id_none())
        self.sym_hir_start.alloc(id_none())
        self.sym_hir_end.alloc(id_none())
        self.sym_nodes.alloc(id_none())
        self.sym_resolving.alloc(0)
        self.sym_target.alloc(target_sym)

        sym_id
    }

    find_symbol :: fn(self &Self, file_id u32, name_id u32) u32 {
        sym := self.find_local_symbol(file_id, name_id)
        if sym != id_none() { ret sym }
        if self.core_prelude != id_none() {
            sym = self.find_local_symbol(self.core_prelude, name_id)
            if sym != id_none() { ret sym }
        }
        if self.std_prelude != id_none() {
            ret self.find_local_symbol(self.std_prelude, name_id)
        }
        id_none()
    }

    find_local_symbol :: fn(self &Self, file_id u32, name_id u32) u32 {
        count := self.sym_names.count()

        i: u32 = 0
        while i < count {
            f := self.sym_files.get(i)
            n := self.sym_names.get(i)
            if (f == file_id) and (n == name_id) {
                ret self.resolve_sym(i)
            }
            i = i + 1
        }
        id_none()
    }

    resolve_sym :: fn(self &Self, sym_id u32) u32 {
        if sym_id == id_none() { ret id_none() }
        real_s := sym_id
        while true {
            tgt := self.sym_target.get(real_s)
            if (tgt == id_none()) or (tgt == real_s) { break }
            real_s = tgt
        }
        real_s
    }

    get_fn_node :: fn(self &Self, sym_id u32) u32 {
        real_s := self.resolve_sym(sym_id)
        if real_s == id_none() { ret id_none() }
        if self.is_mono_sym(real_s) {
            orig := self.get_mono_orig_sym(real_s)
            ret self.get_fn_node(orig)
        }
        hir := self.get_sym_hir(real_s)
        if hir != id_none() {
            if self.hir.kind(hir) == hir_kind.function { ret hir }
            if (self.hir.kind(hir) == hir_kind.binding) or (self.hir.kind(hir) == hir_kind.var) {
                cand := self.hir.extra(hir)
                if (cand != hir_none()) and (self.hir.kind(cand) == hir_kind.function) {
                    ret cand
                }
            }
        }
        hir_end := self.sym_hir_end.get(real_s)
        if (hir_end != 0) and (hir_end != id_none()) {
            b_id := hir_end - 1
            if (self.hir.kind(b_id) == hir_kind.binding) or (self.hir.kind(b_id) == hir_kind.var) {
                cand := self.hir.extra(b_id)
                if (cand != hir_none()) and (self.hir.kind(cand) == hir_kind.function) {
                    ret cand
                }
            }
        }
        if (real_s & 2147483648) != 0 {
            b_id := real_s & 2147483647
            if (self.hir.kind(b_id) == hir_kind.binding) or (self.hir.kind(b_id) == hir_kind.var) {
                cand := self.hir.extra(b_id)
                if (cand != hir_none()) and (self.hir.kind(cand) == hir_kind.function) {
                    ret cand
                }
            } else if self.hir.kind(b_id) == hir_kind.function {
                ret b_id
            }
        }
        if hir != id_none() {
            tbl_len := self.hir.len()
            scan_i := hir + 1
            while scan_i < tbl_len {
                sk := self.hir.kind(scan_i)
                if (sk == hir_kind.var) or (sk == hir_kind.binding) {
                    if self.hir.lhs(scan_i) == hir {
                        cand := self.hir.extra(scan_i)
                        if (cand != hir_none()) and (self.hir.kind(cand) == hir_kind.function) {
                            ret cand
                        }
                    }
                }
                if scan_i > (hir + 50) { break }
                scan_i = scan_i + 1
            }
        }
        id_none()
    }

    set_sym_hir :: fn(self &Self, sym_id u32, hir_id u32) {
        self.sym_nodes.set(sym_id, hir_id)
    }

    get_sym_hir :: fn(self &Self, sym_id u32) u32 {
        if sym_id == id_none() { ret id_none() }
        if sym_id >= self.sym_nodes.count() { ret id_none() }
        self.sym_nodes.get(sym_id)
    }

    set_hir_symbol :: fn(self &Self, hir_id u32, sym_id u32) {
        self.hir_to_symbol.set_safe(hir_id, sym_id, id_none())
    }

    get_hir_symbol :: fn(self &Self, hir_id u32) u32 {
        if hir_id == id_none() { ret id_none() }
        if hir_id >= self.hir_to_symbol.count() { ret id_none() }
        self.hir_to_symbol.get(hir_id)
    }

    set_const_type :: fn(self &Self, hir_id u32, ty_id u32) {
        self.const_types.set_safe(hir_id, ty_id, ty_id_none())
    }

    get_const_type :: fn(self &Self, hir_id u32) u32 {
        if hir_id >= self.const_types.count() { ret ty_id_none() }
        self.const_types.get(hir_id)
    }

    get_node_type :: fn(self &Self, id u32) u32 {
        if id == hir_none() { ret ty_id_none() }
        slot := (&self.unify).get_slot(id)
        if slot == slot_none() { ret ty_id_none() }
        (&self.unify).resolve_type_deep(&self.types, slot)
    }

    set_method_owner :: fn(self &Self, hir_id u32, struct_id u32) {
        self.method_owner.set_safe(hir_id, struct_id, id_none())
    }

    get_method_owner :: fn(self &Self, hir_id u32) u32 {
        if hir_id >= self.method_owner.count() { ret id_none() }
        self.method_owner.get(hir_id)
    }

    set_sym_resolving :: fn(self &Self, sym_id u32, resolving bool) {
        val: u32 = 0
        if resolving { val = 1 }
        self.sym_resolving.set_safe(sym_id, val, 0)
    }

    is_sym_resolving :: fn(self &Self, sym_id u32) bool {
        if sym_id >= self.sym_resolving.count() { ret false }
        self.sym_resolving.get(sym_id) == 1
    }

    add_file_source :: fn(self &Self, source Str) u32 {
        id := self.file_sources.len as u32
        self.file_sources.push(source)
        id
    }

    set_hir_span :: fn(self &Self, hir_id u32, start u32, end u32) {
        self.hir_span_start.set_safe(hir_id, start, 0)
        self.hir_span_end.set_safe(hir_id, end, 0)
    }

    set_hir_file :: fn(self &Self, hir_id u32, file_id u32) {
        self.hir_files.set_safe(hir_id, file_id, id_none())
    }

    get_hir_file :: fn(self &Self, hir_id u32) u32 {
        if hir_id >= self.hir_files.count() { ret id_none() }
        self.hir_files.get(hir_id)
    }

    get_hir_span :: fn(self &Self, hir_id u32) Span {
        if hir_id >= self.hir_span_start.count() {
            ret .{ start: 0, end: 0 }
        }
        start := self.hir_span_start.get(hir_id)
        end   := self.hir_span_end.get(hir_id)
        .{ start: start, end: end }
    }

    add_file :: fn(self &Self, path Str, source Str) u32 {
        id := self.file_sources.len as u32
        self.file_paths.push(path)
        self.file_sources.push(source)
        id
    }

    get_file_path :: fn(self &Self, file_id u32) Str {
        if (file_id as u64) >= self.file_paths.len { ret Str.of("unknown") }
        self.file_paths.get(file_id as u64)
    }

    get_file_source :: fn(self &Self, file_id u32) Str {
        if (file_id as u64) >= self.file_sources.len { ret Str.of("") }
        self.file_sources.get(file_id as u64)
    }

    get_pos :: fn(self &Self, hir_id u32) Pos {
        fid := self.get_hir_file(hir_id)
        span := self.get_hir_span(hir_id)

        if (fid == id_none()) or ((fid as u64) >= self.file_sources.len) {
            ret .{ line: 1, col: 1 }
        }

        src := self.file_sources.get(fid as u64)
        calc_pos(src, span.start)
    }

    set_type_error_origin :: fn(self &Self, hir_id u32) {
        file_id := self.get_hir_file(hir_id)
        self.unify.error_path = self.get_file_path(file_id)
        self.unify.error_source = self.get_file_source(file_id)
        self.unify.error_offset = self.get_hir_span(hir_id).start
    }

    print_loc :: fn(self &Self, hir_id u32) {
        fid := self.get_hir_file(hir_id)
        path := self.get_file_path(fid)
        pos := self.get_pos(hir_id)

        print(path.ptr)
        print(c":")
        print_u32(pos.line)
        print(c":")
        print_u32(pos.col)
    }

    find_mono_sym :: fn(self &Self, orig_sym u32, mono_ty u32) u32 {
        if (orig_sym == id_none()) or (mono_ty == ty_id_none()) { ret id_none() }
        i: u64 = 0
        while i < self.mono_orig_sym.len {
            if (self.mono_orig_sym.get(i) == orig_sym) and (self.mono_type.get(i) == mono_ty) {
                ret self.mono_sym.get(i)
            }
            i = i + 1
        }
        id_none()
    }

    alloc_mono_sym :: fn(self &Self, orig_sym u32, mono_ty u32) u32 {
        if (orig_sym == id_none()) or (mono_ty == ty_id_none()) { ret id_none() }
        file_id: u32 = 0
        name_id: u32 = 0
        if (orig_sym & 2147483648) != 0 {
            binding_id := orig_sym & 2147483647
            file_id = self.get_hir_file(binding_id)
            name_hir := self.hir.lhs(binding_id)
            name_id = self.hir.lhs(name_hir)
        } else {
            file_id = self.sym_files.get(orig_sym)
            name_id = self.sym_names.get(orig_sym)
        }
        sym_id := self.sym_names.alloc(name_id)
        self.sym_files.alloc(file_id)
        self.sym_tok_start.alloc(id_none())
        self.sym_tok_end.alloc(id_none())
        self.sym_hir_start.alloc(id_none())
        self.sym_hir_end.alloc(id_none())
        self.sym_nodes.alloc(id_none())
        self.sym_resolving.alloc(0)
        self.sym_target.alloc(id_none())

        self.mono_orig_sym.push(orig_sym)
        self.mono_type.push(mono_ty)
        self.mono_sym.push(sym_id)
        sym_id
    }

    get_mono_orig_sym :: fn(self &Self, sym u32) u32 {
        i: u64 = 0
        while i < self.mono_sym.len {
            if self.mono_sym.get(i) == sym {
                ret self.mono_orig_sym.get(i)
            }
            i = i + 1
        }
        id_none()
    }

    get_mono_type :: fn(self &Self, sym u32) u32 {
        i: u64 = 0
        while i < self.mono_sym.len {
            if self.mono_sym.get(i) == sym {
                ret self.mono_type.get(i)
            }
            i = i + 1
        }
        ty_id_none()
    }

    is_mono_sym :: fn(self &Self, sym u32) bool {
        self.get_mono_orig_sym(sym) != id_none()
    }

    find_mono_nominal :: fn(self &Self, sym u32, args SliceU32) u32 {
        i: u64 = 0
        while i < self.mono_nom_sym.len {
            if self.mono_nom_sym.get(i) == sym {
                stored_list := self.get_list(self.mono_nom_arg.get(i))
                if stored_list.len == args.len {
                    matched := true
                    j: u64 = 0
                    while j < args.len {
                        if *(stored_list.ptr + j) != *(args.ptr + j) {
                            matched = false
                            break
                        }
                        j = j + 1
                    }
                    if matched {
                        ret self.mono_nom_res.get(i)
                    }
                }
            }
            i = i + 1
        }
        ty_id_none()
    }

    add_mono_nominal :: fn(self &Self, sym u32, args SliceU32, res_ty u32) {
        list_id := self.add_list(args)
        self.mono_nom_sym.push(sym)
        self.mono_nom_arg.push(list_id)
        self.mono_nom_res.push(res_ty)
    }

    set_union_coerce :: fn(self &Self, expr u32, ty u32, idx u32) {
        self.union_coerce_ty.set_safe(expr, ty, ty_id_none())
        self.union_coerce_idx.set_safe(expr, idx, 0)
    }

    has_union_coerce :: fn(self &Self, expr u32) bool {
        if expr >= self.union_coerce_ty.count() { ret false }
        self.union_coerce_ty.get(expr) != ty_id_none()
    }

    get_union_coerce_ty :: fn(self &Self, expr u32) u32 {
        if expr >= self.union_coerce_ty.count() { ret ty_id_none() }
        self.union_coerce_ty.get(expr)
    }

    get_union_coerce_idx :: fn(self &Self, expr u32) u32 {
        if expr >= self.union_coerce_idx.count() { ret 0 }
        self.union_coerce_idx.get(expr)
    }
}

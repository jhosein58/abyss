import VecU32 from "../../std/vec/u32.a"
import VecStr from "../../std/vec/str.a"
import SliceU32, SliceU32_new from "../../std/slice/u32.a"
import Interner from "../../std/interner.a"
import Str from "../../std/string.a"

import TypeStorage, TypeStorage_new, ty_id_none from "../types.a"
import UnifyStorage, UnifyStorage_new from "../unify.a"
import TokenStream from "../token.a"
import HirTable from "../hir.a"
import PoolU32, id_none from "pool.a"

print :: (s &u8) unit
print_u32 :: (v u32) unit

Span :: struct {
    start : u32,
    end   : u32
}

Pos :: struct {
    line : u32,
    col  : u32
}

span_new :: (start u32, end u32) Span {
    .{ start: start, end: end }
}

span_merge :: (a Span, b Span) Span {
    s := a.start
    if b.start < s { s = b.start }
    
    e := a.end
    if b.end > e { e = b.end }

    .{ start: s, end: e }
}

calc_pos :: (source Str, offset u32) Pos {
    line: u32 = 1
    col:  u32 = 1
    i:    u64 = 0

    limit := offset as u64
    if limit > source.len {
        limit = source.len
    }

    while i < limit {
        c := *(source.ptr + i)
        if c == *"\n" {
            line = line + 1
            col  = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }

    .{ line: line, col: col }
}


Nexus :: struct {
    tokens         : TokenStream,
    hir            : HirTable,

    glob_stack     : VecU32,
    u32_items      : VecU32,
    interner       : Interner,
    types          : TypeStorage,
    unify          : UnifyStorage,

    sym_names      : PoolU32,
    sym_files      : PoolU32,
    sym_tok_start  : PoolU32,
    sym_tok_end    : PoolU32,
    sym_hir_start  : PoolU32,
    sym_hir_end    : PoolU32,
    sym_target     : PoolU32,

    sym_nodes      : PoolU32, -- SymbolId -> HirId
    hir_to_symbol  : PoolU32, -- HirId    -> SymbolId

    const_types    : PoolU32, -- HirId    -> TypeId 
    method_owner   : PoolU32,
    method_target  : PoolU32,
    sym_resolving  : PoolU32  -- SymbolId -> 0 or 1

    file_sources   : VecStr,
    file_paths     : VecStr,
    hir_files      : PoolU32, -- HirId    -> FileId
    hir_span_start : PoolU32, -- HirId    -> Span start offset
    hir_span_end   : PoolU32, -- HirId    -> Span end
}

Nexus_new :: () Nexus {
    .{
        tokens         : TokenStream.new(),
        hir            : HirTable.new(),

        glob_stack     : VecU32.new(),
        u32_items      : VecU32.new(),
        interner       : Interner.new(),
        types          : TypeStorage_new(),
        unify          : UnifyStorage_new(),

        sym_names      : PoolU32.new(),
        sym_files      : PoolU32.new(),
        sym_tok_start  : PoolU32.new(),
        sym_tok_end    : PoolU32.new(),
        sym_hir_start  : PoolU32.new(),
        sym_hir_end    : PoolU32.new(),
        sym_target     : PoolU32.new(),
        sym_nodes      : PoolU32.new(),
        hir_to_symbol  : PoolU32.new(),

        const_types    : PoolU32.new(),
        method_owner   : PoolU32.new(),
        method_target  : PoolU32.new(),
        sym_resolving  : PoolU32.new(),


        file_sources   : VecStr.new(),
        file_paths     : VecStr.new(),
        hir_files      : PoolU32.new(),
        hir_span_start : PoolU32.new(),
        hir_span_end   : PoolU32.new(),
    }
}

Nexus_add_list :: (self &Nexus, items SliceU32) u32 {
    list := &(*self).u32_items
    start := list.len as u32
    list.push(items.len as u32)
    list.extend(items.ptr, items.len)
    start
}

Nexus_get_list :: (self &Nexus, start u32) SliceU32 {
    list := &(*self).u32_items 
    len := list.get(start as u64)

    .{
        ptr: list.ptr_at((start as u64) + 1),
        len: len as u64
    }
}

Nexus_alloc_symbol :: (self &Nexus, file_id u32, name_id u32, tok_start u32, tok_end u32) u32 {
    sym_id := self.sym_names.alloc(name_id)
    self.sym_files.alloc(file_id)
    self.sym_tok_start.alloc(tok_start)
    self.sym_tok_end.alloc(tok_end)
    self.sym_hir_start.alloc(id_none())
    self.sym_hir_end.alloc(id_none())
    self.sym_nodes.alloc(id_none())
    self.sym_resolving.alloc(0)
    self.sym_target.alloc(id_none())
    sym_id
}

Nexus_alloc_local_symbol :: (self &Nexus, file_id u32, name_id u32, hir_id u32) u32 {
    sym_id := self.sym_names.alloc(name_id)
    self.sym_files.alloc(file_id)
    self.sym_tok_start.alloc(id_none())
    self.sym_tok_end.alloc(id_none())
    self.sym_hir_start.alloc(id_none())
    self.sym_hir_end.alloc(id_none())
    self.sym_nodes.alloc(hir_id)
    self.sym_resolving.alloc(0)
    self.sym_target.alloc(id_none())

    Nexus_set_hir_symbol(self, hir_id, sym_id)
    sym_id
}

Nexus_alloc_symbol_alias :: (self &Nexus, file_id u32, name_id u32, target_sym u32) u32 {
    sym_id := self.sym_names.alloc(name_id)
    self.sym_files.alloc(file_id)
    self.sym_tok_start.alloc(id_none())
    self.sym_tok_end.alloc(id_none())
    self.sym_hir_start.alloc(id_none())
    self.sym_hir_end.alloc(id_none())
    self.sym_nodes.alloc(id_none())
    self.sym_resolving.alloc(0)
    self.sym_target.alloc(target_sym)
    sym_id
}

Nexus_find_symbol :: (self &Nexus, file_id u32, name_id u32) u32 {
    count := self.sym_names.count()
    i: u32 = 0
    while i < count {
        f := self.sym_files.get(i)
        n := self.sym_names.get(i)
        if (f == file_id) and (n == name_id) {
            curr := i
            while curr != id_none() {
                target := self.sym_target.get(curr)
                if target == id_none() {
                    ret curr
                }
                curr = target
            }
            ret i
        }
        i = i + 1
    }
    id_none()
}

Nexus_set_sym_hir :: (self &Nexus, sym_id u32, hir_id u32) {
    self.sym_nodes.set(sym_id, hir_id)
}

Nexus_get_sym_hir :: (self &Nexus, sym_id u32) u32 {
    if sym_id == id_none() { ret id_none() }
    if sym_id >= self.sym_nodes.count() { ret id_none() }
    self.sym_nodes.get(sym_id)
}

Nexus_set_hir_symbol :: (self &Nexus, hir_id u32, sym_id u32) {
    self.hir_to_symbol.set_safe(hir_id, sym_id, id_none())
}

Nexus_get_hir_symbol :: (self &Nexus, hir_id u32) u32 {
    if hir_id == id_none() { ret id_none() }
    if hir_id >= self.hir_to_symbol.count() { ret id_none() }
    self.hir_to_symbol.get(hir_id)
}

Nexus_set_const_type :: (self &Nexus, hir_id u32, ty_id u32) {
    self.const_types.set_safe(hir_id, ty_id, ty_id_none())
}

Nexus_get_const_type :: (self &Nexus, hir_id u32) u32 {
    if hir_id >= self.const_types.count() { ret ty_id_none() }
    self.const_types.get(hir_id)
}

Nexus_set_method_owner :: (self &Nexus, hir_id u32, struct_id u32) {
    self.method_owner.set_safe(hir_id, struct_id, id_none())
}

Nexus_get_method_owner :: (self &Nexus, hir_id u32) u32 {
    if hir_id >= self.method_owner.count() { ret id_none() }
    self.method_owner.get(hir_id)
}

Nexus_set_method_target :: (self &Nexus, hir_id u32, method_id u32) {
    self.method_target.set_safe(hir_id, method_id, id_none())
}

Nexus_get_method_target :: (self &Nexus, hir_id u32) u32 {
    if hir_id >= self.method_target.count() { ret id_none() }
    self.method_target.get(hir_id)
}

Nexus_set_sym_resolving :: (self &Nexus, sym_id u32, resolving bool) {
    val: u32 = 0
    if resolving { val = 1 }
    self.sym_resolving.set_safe(sym_id, val, 0)
}

Nexus_is_sym_resolving :: (self &Nexus, sym_id u32) bool {
    if sym_id >= self.sym_resolving.count() { ret false }
    self.sym_resolving.get(sym_id) == 1
}

Nexus_add_file_source :: (self &Nexus, source Str) u32 {
    id := (*self).file_sources.len as u32
    VecStr_push(&(*self).file_sources, source)
    id
}

Nexus_set_hir_span :: (self &Nexus, hir_id u32, start u32, end u32) {
    self.hir_span_start.set_safe(hir_id, start, 0)
    self.hir_span_end.set_safe(hir_id, end, 0)
}

Nexus_set_hir_file :: (self &Nexus, hir_id u32, file_id u32) {
    self.hir_files.set_safe(hir_id, file_id, id_none())
}

Nexus_get_hir_file :: (self &Nexus, hir_id u32) u32 {
    if hir_id >= self.hir_files.count() { ret id_none() }
    self.hir_files.get(hir_id)
}

Nexus_get_hir_span :: (self &Nexus, hir_id u32) Span {
    if hir_id >= self.hir_span_start.count() {
        ret .{ start: 0, end: 0 }
    }
    start := self.hir_span_start.get(hir_id)
    end   := self.hir_span_end.get(hir_id)
    .{ start: start, end: end }
}

Nexus_get_pos :: (self &Nexus, hir_id u32) Pos {
    fid := Nexus_get_hir_file(self, hir_id)
    span := Nexus_get_hir_span(self, hir_id)

    if (fid == id_none()) or ((fid as u64) >= (*self).file_sources.len) {
        ret .{ line: 1, col: 1 }
    }

    src := self.file_sources.get(fid as u64)
    calc_pos(src, span.start)
}

Nexus_add_file :: (self &Nexus, path Str, source Str) u32 {
    id := (*self).file_sources.len as u32
    self.file_paths.push(path)
    self.file_sources.push(source)
    id
}

Nexus_get_file_path :: (self &Nexus, file_id u32) Str {
    if (file_id as u64) >= (*self).file_paths.len { ret Str.of("unknown") }
    self.file_paths.get(file_id as u64)
}

Nexus_get_file_source :: (self &Nexus, file_id u32) Str {
    if (file_id as u64) >= (*self).file_sources.len { ret Str.of("") }
    self.file_sources.get(file_id as u64)
}

Nexus_get_pos :: (self &Nexus, hir_id u32) Pos {
    fid := Nexus_get_hir_file(self, hir_id)
    span := Nexus_get_hir_span(self, hir_id)

    if (fid == id_none()) or ((fid as u64) >= (*self).file_sources.len) {
        ret .{ line: 1, col: 1 }
    }

    src := VecStr_get(&(*self).file_sources, fid as u64)
    calc_pos(src, span.start)
}

Nexus_print_loc :: (self &Nexus, hir_id u32) {
    fid := Nexus_get_hir_file(self, hir_id)
    path := Nexus_get_file_path(self, fid)
    pos := Nexus_get_pos(self, hir_id)

    print(path.ptr)
    print(":")
    print_u32(pos.line)
    print(":")
    print_u32(pos.col)
}

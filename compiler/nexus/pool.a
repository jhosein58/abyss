id_none :: fn() u32 {
    4294967295 as u32
}

PoolU32 :: struct {
    data Vec(u32)

    new :: fn() Self {
        .{
            data: Vec(u32).new()
        }
    }

    destroy :: fn(self &Self) {
        self.data.destroy()
    }

    count :: fn(self &Self) u32 {
        self.data.len as u32
    }

    alloc :: fn(self &Self, val u32) u32 {
        id := self.count()
        self.data.push(val)
        id
    }

    get :: fn(self &Self, id u32) u32 {
        self.data.get(id as u64)
    }

    set :: fn(self &Self, id u32, val u32) {
        self.data.set(id as u64, val)
    }

    grow_to :: fn(self &Self, new_len u32, default_val u32) {
        target := new_len as u64
        while self.data.len < target {
            self.data.push(default_val)
        }
    }

    set_safe :: fn(self &Self, id u32, val u32, default_val u32) {
        idx := id as u64
        if idx >= self.data.len {
            self.grow_to((id + 1) as u32, default_val)
        }
        self.data.set(idx, val)
    }
}
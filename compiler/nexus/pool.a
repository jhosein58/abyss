import VecU32 from "../../std/vec/u32.a"
import U32_MAX from "../../std/primitive/u32.a"

id_none :: fn() u32 {
    U32_MAX()
}

PoolU32 :: struct {
    data: VecU32,

    new :: fn() Self {
        .{
            data: VecU32.new()
        }
    }

    destroy :: fn() {
        .data.destroy()
    }

    count :: fn() u32 {
        .data.len as u32
    }

    alloc :: fn(val u32) u32 {
        id := .count()
        .data.push(val)
        id
    }

    get :: fn(id u32) u32 {
        .data.get(id as u64)
    }

    set :: fn(id u32, val u32) {
        .data.set(id as u64, val)
    }

    grow_to :: fn(new_len u32, default_val u32) {
        target := new_len as u64
        while .data.len < target {
            .data.push(default_val)
        }
    }

    set_safe :: fn(id u32, val u32, default_val u32) {
        idx := id as u64
        if idx >= .data.len {
            .grow_to((id + 1) as u32, default_val)
        }
        .data.set(idx, val)
    }
}
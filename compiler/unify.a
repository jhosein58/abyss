import write_str from "std/io"
import TyKind, ty_id_none, ty_id_never, ty_id_unknown, ty_id_error, TypeStorage from "./types"
import Str from "std/string"
import calc_pos from "./nexus/nexus"
import fall from "std/sys"

print_cstr :: fn(s &u8)
print_u32 :: fn(v u32)

slot_none :: fn() u32 {
    4294967295 as u32
}


UnifyStorage :: struct {
    error_path Str
    error_source Str
    error_offset u32
    parents     Vec(u32)
    ranks       Vec(u8)
    types       Vec(u32)
    origins     Vec(u32)
    hir_to_slot Vec(u32)
    scratch     Vec(u32)

    new :: fn() Self {
        .{
            error_path : Str.empty(),
            error_source : Str.empty(),
            error_offset : 0,
            parents     : Vec(u32).new(),
            ranks       : Vec(u8).new(),
            types       : Vec(u32).new(),
            origins     : Vec(u32).new(),
            hir_to_slot : Vec(u32).new(),
            scratch     : Vec(u32).new()
        }
    }

    destroy :: fn(self &Self) {
        self.parents.destroy()
        self.ranks.destroy()
         self.types.destroy()
        self.origins.destroy()
        self.hir_to_slot.destroy()
        self.scratch.destroy()
    }

    set_hir_slot :: fn(self &Self, hir_id u32, slot u32) {
        if hir_id == slot_none() { ret }
        idx := hir_id as u64
        while (idx >= self.hir_to_slot.len) {
            self.hir_to_slot.push(slot_none())
        }
        self.hir_to_slot.set(idx, slot)
    }

    new_slot :: fn(self &Self, origin u32) u32 {
        slot := self.parents.len as u32

        self.parents.push(slot)
        self.ranks.push(0 as u8)
        self.types.push(ty_id_none())
        self.origins.push(origin)

        if origin != slot_none() {
            self.set_hir_slot(origin, slot)
        }

        slot
    }

    tmp_slot :: fn(self &Self) u32 {
        slot := self.parents.len as u32

        self.parents.push(slot)
        self.ranks.push(0 as u8)
        self.types.push(ty_id_none())
        self.origins.push(slot_none())

        slot
    }

    get_slot :: fn(self &Self, id u32) u32 {
        idx := id as u64
        if idx >= self.hir_to_slot.len {
            ret slot_none()
        }
        self.hir_to_slot.get(idx)
    }

    print_error_location :: fn(self &Self) {
        if self.error_path.len == 0 { ret }
        pos := calc_pos(self.error_source, self.error_offset)
        print_cstr(c"       --> ")
        write_str(self.error_path)
        print_cstr(c":")
        print_u32(pos.line)
        print_cstr(c":")
        print_u32(pos.col)
        print_cstr(c"\n")
    }

    type_contains_slot :: fn(self &Self, types &TypeStorage, ty u32, target u32, seen &Vec(u32)) bool {
        if ty == ty_id_none() { ret false }
        i: u64 = 0
        while i < (*seen).len {
            if seen.get(i) == ty { ret false }
            i = i + 1
        }
        seen.push(ty)
        kind := types.kind(ty)
        if kind == TyKind.infer {
            root := self.find(types.infer_slot(ty))
            if root == target { ret true }
            ret self.type_contains_slot(types, self.types.get(root as u64), target, seen)
        }
        if kind == TyKind.ptr {
            ret self.type_contains_slot(types, types.payload(ty), target, seen)
        }
        if kind == TyKind.array {
            ret self.type_contains_slot(types, types.get_array_type(ty), target, seen)
        }
        if (kind == TyKind.struct_) or (kind == TyKind.nominal) {
            if (kind == TyKind.nominal) and (types.nominal_base(ty) == ty_id_none()) { ret false }
            fields := types.get_struct_fields(ty)
            i = 0
            while i < fields.len / 2 {
                if self.type_contains_slot(types, *(fields.ptr + i * 2 + 1), target, seen) { ret true }
                i = i + 1
            }
        }
        if kind == TyKind.func {
            if self.type_contains_slot(types, types.func_return(ty), target, seen) { ret true }
            params := types.func_params(ty)
            i = 0
            while i < params.len {
                if self.type_contains_slot(types, *(params.ptr + i), target, seen) { ret true }
                i = i + 1
            }
        }
        if kind == TyKind.union_ {
            members := types.union_members(ty)
            i = 0
            while i < members.len {
                if self.type_contains_slot(types, *(members.ptr + i), target, seen) { ret true }
                i = i + 1
            }
        }
        false
    }

    type_mismatch :: fn(self &Self, types &TypeStorage, expected u32, actual u32) {
        print_cstr(c"\n\033[1;31m[type error]\033[0m type mismatch: cannot unify '")
        types.print_type(expected)
        print_cstr(c"' with '")
        types.print_type(actual)
        print_cstr(c"'\n")
        if (types.kind(expected) == TyKind.nominal) or
           (types.kind(actual) == TyKind.nominal) {
            print_cstr(c"       Named structs require the same declaration; only an anonymous struct literal may initialize one.\n")
        }
        self.print_error_location()
        print_cstr(c"\n")
        fall()
    }

    find :: fn(self &Self, slot u32) u32 {
        curr := slot
        while true {
            parent := self.parents.get(curr as u64)
            if parent == curr {
                ret curr
            }
            grand := self.parents.get(parent as u64)
            self.parents.set(curr as u64, grand)
            curr = grand
        }
        curr
    }

    union :: fn(self &Self, types &TypeStorage, a u32, b u32) u32 {
        root_a := self.find(a)
        root_b := self.find(b)

        if root_a == root_b {
            ret root_a
        }

         type_a := self.types.get(root_a as u64)
         type_b := self.types.get(root_b as u64)

        if type_a == ty_id_never() or type_b == ty_id_never() {
            ret root_a
        }

        final_type := ty_id_none()
        has_a := type_a != ty_id_none()
        has_b := type_b != ty_id_none()

        if has_a and has_b {
            final_type = self.unify_types(types, type_a, type_b)
            
            if final_type == ty_id_error() {
                self.type_mismatch(types, type_a, type_b)
            }
        } else if has_a {
            final_type = type_a
        } else if has_b {
            final_type = type_b
        }

        rank_a := self.ranks.get(root_a as u64)
        rank_b := self.ranks.get(root_b as u64)

        new_root: u32 = root_a
        old_root: u32 = root_b

        if rank_a > rank_b {
            new_root = root_a
            old_root = root_b
        } else if rank_a < rank_b {
            new_root = root_b
            old_root = root_a
        } else {
            self.ranks.set(root_a as u64, rank_a + (1 as u8))
            new_root = root_a
            old_root = root_b
        }

        self.parents.set(old_root as u64, new_root)

        if final_type != ty_id_none() {
             self.types.set(new_root as u64, final_type)
        }

        new_root
    }

    bind_type :: fn(self &Self, types &TypeStorage, slot u32, ty u32) u32 {
        root := self.find(slot)
        existing := self.types.get(root as u64)
        if types.kind(ty) == TyKind.infer {
            if self.find(types.infer_slot(ty)) == root { ret existing }
        }
        seen := Vec(u32).new()
        recursive := self.type_contains_slot(types, ty, root, &seen)
        seen.destroy()
        if recursive {
            print_cstr(c"\n[type error] recursive generic inference would create an infinite type\n")
            self.print_error_location()
            fall()
        }

        unified := ty
        if existing != ty_id_none() {
            unified = self.unify_types(types, existing, ty)
            if unified == ty_id_error() {
                self.type_mismatch(types, existing, ty)
            }
        }

         self.types.set(root as u64, unified)
        unified
    }

    unify_types :: fn(self &Self, types &TypeStorage, a u32, b u32) u32 {
        if (a == ty_id_none()) or (b == ty_id_none()) or
           (a == ty_id_unknown()) or (b == ty_id_unknown()) {
            ret ty_id_error()
        }

        if a == b {
            ret a
        }

        kind_a := types.kind(a)
        kind_b := types.kind(b)

        if kind_a == TyKind.infer and kind_b == TyKind.infer {
            slot_a := types.infer_slot(a)
            slot_b := types.infer_slot(b)
            new_slot := self.union(types, slot_a, slot_b)
            ret types.alloc_infer(new_slot)
        } else if kind_a == TyKind.infer {
            slot_a := types.infer_slot(a)
            if self.bind_type(types, slot_a, b) == ty_id_error() { ret ty_id_error() }
            ret b
        } else if kind_b == TyKind.infer {
            slot_b := types.infer_slot(b)
            if self.bind_type(types, slot_b, a) == ty_id_error() { ret ty_id_error() }
            ret a
        }

        if kind_a == TyKind.never { ret b }
        if kind_b == TyKind.never { ret a }

        is_num_b := (kind_b == TyKind.int) or (kind_b == TyKind.uint) or (kind_b == TyKind.float) or (kind_b == TyKind.untyped_float)
        if (kind_a == TyKind.untyped_int) and is_num_b {
            ret b
        }

        is_num_a := (kind_a == TyKind.int) or (kind_a == TyKind.uint) or (kind_a == TyKind.float) or (kind_a == TyKind.untyped_float)
        if is_num_a and (kind_b == TyKind.untyped_int) {
            ret a
        }

        if (kind_a == TyKind.untyped_float) and (kind_b == TyKind.float) { ret b }
        if (kind_a == TyKind.float) and (kind_b == TyKind.untyped_float) { ret a }

        if (kind_a == TyKind.ptr) and (kind_b == TyKind.ptr) {
            inner_a := types.payload(a)
            inner_b := types.payload(b)
            unified_inner := self.unify_types(types, inner_a, inner_b)
            if unified_inner == ty_id_error() {
                ret ty_id_error()
            }
            ret types.alloc_ptr(unified_inner)
        }

        if (kind_a == TyKind.array) and (kind_b == TyKind.array) {
            len_a := types.get_array_len(a)
            len_b := types.get_array_len(b)
            if len_a != len_b {
                ret ty_id_error()
            }

            inner_a := types.get_array_type(a)
            inner_b := types.get_array_type(b)
            unified_inner := self.unify_types(types, inner_a, inner_b)
            if unified_inner == ty_id_error() {
                ret ty_id_error()
            }
            ret types.alloc_array(unified_inner, len_a)
        }
        
        if (kind_a == TyKind.struct_) and (kind_b == TyKind.struct_) {
            fields_a := types.get_struct_fields(a)
            fields_b := types.get_struct_fields(b)

            if fields_a.len != fields_b.len {
                ret ty_id_error()
            }

            local_scratch := Vec(u32).new()
            has_err := false
            count := fields_a.len / 2
            i: u64 = 0

            while (i < count) {
                fields_a = types.get_struct_fields(a)
                fields_b = types.get_struct_fields(b)
                idx := i * 2
                na := *(fields_a.ptr + idx)
                ta := *(fields_a.ptr + idx + 1)
                nb := *(fields_b.ptr + idx)
                tb := *(fields_b.ptr + idx + 1)

                if na != nb {
                    has_err = true
                    break
                }

                unified_t := self.unify_types(types, ta, tb)
                if unified_t == ty_id_error() {
                    has_err = true
                    break
                }

                local_scratch.push(na)
                local_scratch.push(unified_t)
                i = i + 1
            }

            if has_err {
                local_scratch.destroy()
                ret ty_id_error()
            }

            slice: Slice(u32) = .{
                ptr: local_scratch.ptr_at(0),
                len: fields_a.len
            }

            res := types.alloc_struct(slice)
            local_scratch.destroy()
            ret res
        }

        if (kind_a == TyKind.func) and (kind_b == TyKind.func) {
            params_a := types.func_params(a)
            params_b := types.func_params(b)
            if params_a.len != params_b.len {
                ret ty_id_error()
            }
            ret_a := types.func_return(a)
            ret_b := types.func_return(b)
            unified_ret := self.unify_types(types, ret_a, ret_b)
            if unified_ret == ty_id_error() {
                ret ty_id_error()
            }

            local_scratch := Vec(u32).new()
            has_err := false
            i: u64 = 0
            while i < params_a.len {
                params_a = types.func_params(a)
                params_b = types.func_params(b)
                pa := *(params_a.ptr + i)
                pb := *(params_b.ptr + i)
                unified_p := self.unify_types(types, pa, pb)
                if unified_p == ty_id_error() {
                    has_err = true
                    break
                }
                local_scratch.push(unified_p)
                i = i + 1
            }

            if has_err {
                local_scratch.destroy()
                ret ty_id_error()
            }

            slice: Slice(u32) = .{
                ptr: local_scratch.ptr_at(0),
                len: params_a.len
            }
            res := types.alloc_func(slice, unified_ret, false)
            local_scratch.destroy()
            ret res
        }

        if (kind_a == TyKind.nominal) and (kind_b == TyKind.nominal) {
            orig_a := types.nominal_origin(a)
            orig_b := types.nominal_origin(b)
            if orig_a == orig_b { ret a }

            sym_a := types.get_nominal_creator_sym(orig_a)
            sym_b := types.get_nominal_creator_sym(orig_b)

            if (sym_a != ty_id_none()) and (sym_a == sym_b) {
                args_a := types.get_nominal_creator_args(orig_a)
                args_b := types.get_nominal_creator_args(orig_b)
                if args_a.len == args_b.len {
                    has_err := false
                    i: u64 = 0
                    while i < args_a.len {
                        u_arg := self.unify_types(types, *(args_a.ptr + i), *(args_b.ptr + i))
                        if u_arg == ty_id_error() {
                            has_err = true
                            break
                        }
                        i = i + 1
                    }
                    if not has_err {
                        a_has_inf := false
                        chk_i: u64 = 0
                        while chk_i < args_a.len {
                            if types.kind(*(args_a.ptr + chk_i)) == TyKind.infer {
                                a_has_inf = true
                                break
                            }
                            chk_i = chk_i + 1
                        }
                        if a_has_inf { ret b }
                        ret a
                    }
                }
            }
            ret ty_id_error()
        }

        if (kind_a == TyKind.enum_) and (kind_b == TyKind.enum_) {
            orig_a := types.enum_origin(a)
            orig_b := types.enum_origin(b)
            if orig_a == orig_b { ret a }
            ret ty_id_error()
        }

        ty_id_error()
    }

    resolve_type :: fn(self &Self, slot u32) u32 {
        root := self.find(slot)
         self.types.get(root as u64)
    }

    resolve_type_deep :: fn(self &Self, types &TypeStorage, slot u32) u32 {
        tyid := self.resolve_type(slot)
        if tyid == ty_id_none() {
            ret ty_id_none()
        }

        kind := types.kind(tyid)

        if kind == TyKind.infer {
            inner_slot := types.infer_slot(tyid)
            resolved := self.resolve_type_deep(types, inner_slot)
            if resolved == ty_id_none() { ret tyid }
            ret resolved
        }

        if kind == TyKind.ptr {
            inner_ty := types.payload(tyid)
            if types.kind(inner_ty) == TyKind.infer {
                inner_slot := types.infer_slot(inner_ty)
                resolved := self.resolve_type_deep(types, inner_slot)
                if resolved == ty_id_none() { ret tyid }
                ret types.alloc_ptr(resolved)
            }
            ret tyid
        }

        if kind == TyKind.array {
            len := types.get_array_len(tyid)
            inner_ty := types.get_array_type(tyid)

            if types.kind(inner_ty) == TyKind.infer {
                infer_slot := types.infer_slot(inner_ty)
                resolved := self.resolve_type_deep(types, infer_slot)
                if resolved == ty_id_none() { ret tyid }
                ret types.alloc_array(resolved, len)
            }
            ret tyid
        }

        if kind == TyKind.union_ {
            count := types.union_members(tyid).len
            result := ty_id_none()
            i: u64 = 0
            while i < count {
                members := types.union_members(tyid)
                member := *(members.ptr + i)
                if types.kind(member) == TyKind.infer {
                    resolved := self.resolve_type_deep(types, types.infer_slot(member))
                    if resolved != ty_id_none() { member = resolved }
                }
                if result == ty_id_none() {
                    result = member
                } else {
                    result = types.make_union_2(result, member)
                }
                i = i + 1
            }
            ret result
        }

        if kind == TyKind.struct_ {
            fields := types.get_struct_fields(tyid)
            count := fields.len / 2

            local_scratch := Vec(u32).new()
            changed := false
            i: u64 = 0

            while i < count {
                fields = types.get_struct_fields(tyid)
                idx := i * 2
                name := *(fields.ptr + idx)
                field_ty := *(fields.ptr + idx + 1)

                if types.kind(field_ty) == TyKind.infer {
                    field_slot := types.infer_slot(field_ty)
                    resolved := self.resolve_type_deep(types, field_slot)
                    if resolved == ty_id_none() { resolved = field_ty }
                    local_scratch.push(name)
                    local_scratch.push(resolved)
                    changed = true
                } else {
                    local_scratch.push(name)
                    local_scratch.push(field_ty)
                }
                i = i + 1
            }

            res := tyid
            if changed {
                slice: Slice(u32) = .{
                    ptr: local_scratch.ptr_at(0),
                    len: fields.len
                }

                res = types.alloc_struct(slice)
            }

            local_scratch.destroy()
            ret res
        }

        tyid
    }
}

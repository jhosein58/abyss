import VecU8 from "../std/vec/u8.a"
import VecU32 from "../std/vec/u32.a"
import SliceU32 from "../std/slice/u32.a"
import U32_MAX from "../std/primitive/u32.a"

 import ty_kind, ty_id_none, ty_id_never, ty_id_unknown, ty_id_error, TypeStorage from "types.a"
import Str from "../std/string.a"
import calc_pos from "nexus/nexus.a"
import fall from "../std/sys.a"

print :: (s &u8) unit
print_u32 :: (v u32) unit

slot_none :: () u32 {
    U32_MAX()
}


UnifyStorage :: struct {
    error_path : Str,
    error_source : Str,
    error_offset : u32,
    parents     : VecU32,
    ranks       : VecU8,
    types       : VecU32,
    origins     : VecU32,
    hir_to_slot : VecU32,
    scratch     : VecU32

    new :: () Self {
        .{
            error_path : Str.empty(),
            error_source : Str.empty(),
            error_offset : 0,
            parents     : VecU32.new(),
            ranks       : VecU8.new(),
            types       : VecU32.new(),
            origins     : VecU32.new(),
            hir_to_slot : VecU32.new(),
            scratch     : VecU32.new()
        }
    }

    destroy :: () {
        .parents.destroy()
        .ranks.destroy()
         .types.destroy()
        .origins.destroy()
        .hir_to_slot.destroy()
        .scratch.destroy()
    }

    set_hir_slot :: (hir_id u32, slot u32) {
        if hir_id == slot_none() { ret }
        idx := hir_id as u64
        while (idx >= .hir_to_slot.len) {
            .hir_to_slot.push(slot_none())
        }
        .hir_to_slot.set(idx, slot)
    }

    new_slot :: (origin u32) u32 {
        slot := .parents.len as u32

        .parents.push(slot)
        .ranks.push(0 as u8)
         .types.push(ty_id_none())
        .origins.push(origin)

        if origin != slot_none() {
            .set_hir_slot(origin, slot)
        }

        slot
    }

    tmp_slot :: () u32 {
        slot := .parents.len as u32

        .parents.push(slot)
        .ranks.push(0 as u8)
        .types.push(ty_id_none())
        .origins.push(slot_none())

        slot
    }

    get_slot :: (id u32) u32 {
        idx := id as u64
        if idx >= .hir_to_slot.len {
            ret slot_none()
        }
        .hir_to_slot.get(idx)
    }

    print_error_location :: () {
        if .error_path.len == 0 { ret }
        pos := calc_pos(.error_source, .error_offset)
        print(c"       --> ")
        .error_path.print()
        print(c":")
        print_u32(pos.line)
        print(c":")
        print_u32(pos.col)
        print(c"\n")
    }

    type_contains_slot :: (types &TypeStorage, ty u32, target u32, seen &VecU32) bool {
        if ty == ty_id_none() { ret false }
        i: u64 = 0
        while i < (*seen).len {
            if seen.get(i) == ty { ret false }
            i = i + 1
        }
        seen.push(ty)
        k := ty_kind()
        kind := (&(*types)).kind(ty)
        if kind == k.infer {
            root := .find((&(*types)).infer_slot(ty))
            if root == target { ret true }
            ret .type_contains_slot(types, .types.get(root as u64), target, seen)
        }
        if kind == k.ptr {
            ret .type_contains_slot(types, (&(*types)).payload(ty), target, seen)
        }
        if kind == k.array {
            ret .type_contains_slot(types, (&(*types)).get_array_type(ty), target, seen)
        }
        if (kind == k.struct_) or (kind == k.nominal) {
            if (kind == k.nominal) and ((&(*types)).nominal_base(ty) == ty_id_none()) { ret false }
            fields := (&(*types)).get_struct_fields(ty)
            i = 0
            while i < fields.len / 2 {
                if .type_contains_slot(types, *(fields.ptr + i * 2 + 1), target, seen) { ret true }
                i = i + 1
            }
        }
        if kind == k.func {
            if .type_contains_slot(types, (&(*types)).func_return(ty), target, seen) { ret true }
            params := (&(*types)).func_params(ty)
            i = 0
            while i < params.len {
                if .type_contains_slot(types, *(params.ptr + i), target, seen) { ret true }
                i = i + 1
            }
        }
        if kind == k.union_ {
            members := (&(*types)).union_members(ty)
            i = 0
            while i < members.len {
                if .type_contains_slot(types, *(members.ptr + i), target, seen) { ret true }
                i = i + 1
            }
        }
        false
    }

    type_mismatch :: (types &TypeStorage, expected u32, actual u32) {
        print(c"\n\033[1;31m[type error]\033[0m type mismatch: cannot unify '")
          (&(*types)).print_type( expected)
        print(c"' with '")
          (&(*types)).print_type( actual)
        print(c"'\n")
          if ((&(*types)).kind( expected) == ty_kind().nominal) or
             ((&(*types)).kind( actual) == ty_kind().nominal) {
            print(c"       Named structs require the same declaration; only an anonymous struct literal may initialize one.\n")
        }
        .print_error_location()
        print(c"\n")
        fall()
    }

    find :: (slot u32) u32 {
        curr := slot
        while true {
            parent := .parents.get(curr as u64)
            if parent == curr {
                ret curr
            }
            grand := .parents.get(parent as u64)
            .parents.set(curr as u64, grand)
            curr = grand
        }
        curr
    }

    union :: (types &TypeStorage, a u32, b u32) u32 {
        root_a := .find(a)
        root_b := .find(b)

        if root_a == root_b {
            ret root_a
        }

         type_a := .types.get(root_a as u64)
         type_b := .types.get(root_b as u64)

        if type_a == ty_id_never() or type_b == ty_id_never() {
            ret root_a
        }

        final_type := ty_id_none()
        has_a := type_a != ty_id_none()
        has_b := type_b != ty_id_none()

        if has_a and has_b {
            final_type = .unify_types(types, type_a, type_b)
            
            if final_type == ty_id_error() {
                .type_mismatch(types, type_a, type_b)
            }
        } else if has_a {
            final_type = type_a
        } else if has_b {
            final_type = type_b
        }

        rank_a := .ranks.get(root_a as u64)
        rank_b := .ranks.get(root_b as u64)

        new_root: u32 = root_a
        old_root: u32 = root_b

        if rank_a > rank_b {
            new_root = root_a
            old_root = root_b
        } else if rank_a < rank_b {
            new_root = root_b
            old_root = root_a
        } else {
            .ranks.set(root_a as u64, rank_a + (1 as u8))
            new_root = root_a
            old_root = root_b
        }

        .parents.set(old_root as u64, new_root)

        if final_type != ty_id_none() {
             .types.set(new_root as u64, final_type)
        }

        new_root
    }

    bind_type :: (types &TypeStorage, slot u32, ty u32) u32 {
        root := .find(slot)
         existing := .types.get(root as u64)
        if (&(*types)).kind(ty) == ty_kind().infer {
            if .find((&(*types)).infer_slot(ty)) == root { ret existing }
        }
        seen := VecU32.new()
        recursive := .type_contains_slot(types, ty, root, &seen)
        seen.destroy()
        if recursive {
            print(c"\n[type error] recursive generic inference would create an infinite type\n")
            .print_error_location()
            fall()
        }

        unified := ty
        if existing != ty_id_none() {
            unified = .unify_types(types, existing, ty)
            if unified == ty_id_error() {
                .type_mismatch(types, existing, ty)
            }
        }

         .types.set(root as u64, unified)
        unified
    }

    unify_types :: (types &TypeStorage, a u32, b u32) u32 {
        if (a == ty_id_none()) or (b == ty_id_none()) or
           (a == ty_id_unknown()) or (b == ty_id_unknown()) {
            ret ty_id_error()
        }

        if a == b {
            ret a
        }

        k := ty_kind()
          kind_a := (&(*types)).kind( a)
          kind_b := (&(*types)).kind( b)

        if kind_a == k.infer and kind_b == k.infer {
              slot_a := (&(*types)).infer_slot( a)
              slot_b := (&(*types)).infer_slot( b)
            new_slot := .union(types, slot_a, slot_b)
              ret (&(*types)).alloc_infer( new_slot)
        } else if kind_a == k.infer {
              slot_a := (&(*types)).infer_slot(a)
            if .bind_type(types, slot_a, b) == ty_id_error() { ret ty_id_error() }
            ret b
        } else if kind_b == k.infer {
              slot_b := (&(*types)).infer_slot(b)
            if .bind_type(types, slot_b, a) == ty_id_error() { ret ty_id_error() }
            ret a
        }

        if kind_a == k.never { ret b }
        if kind_b == k.never { ret a }

        is_num_b := (kind_b == k.int) or (kind_b == k.uint) or (kind_b == k.float) or (kind_b == k.untyped_float)
        if (kind_a == k.untyped_int) and is_num_b {
            ret b
        }

        is_num_a := (kind_a == k.int) or (kind_a == k.uint) or (kind_a == k.float) or (kind_a == k.untyped_float)
        if is_num_a and (kind_b == k.untyped_int) {
            ret a
        }

        if (kind_a == k.untyped_float) and (kind_b == k.float) { ret b }
        if (kind_a == k.float) and (kind_b == k.untyped_float) { ret a }

        if (kind_a == k.ptr) and (kind_b == k.ptr) {
              inner_a := (&(*types)).payload( a)
              inner_b := (&(*types)).payload( b)
            unified_inner := .unify_types(types, inner_a, inner_b)
            if unified_inner == ty_id_error() {
                ret ty_id_error()
            }
              ret (&(*types)).alloc_ptr( unified_inner)
        }

        if (kind_a == k.array) and (kind_b == k.array) {
              len_a := (&(*types)).get_array_len( a)
              len_b := (&(*types)).get_array_len( b)
            if len_a != len_b {
                ret ty_id_error()
            }

              inner_a := (&(*types)).get_array_type( a)
              inner_b := (&(*types)).get_array_type( b)
            unified_inner := .unify_types(types, inner_a, inner_b)
            if unified_inner == ty_id_error() {
                ret ty_id_error()
            }
              ret (&(*types)).alloc_array( unified_inner, len_a)
        }
        
        if (kind_a == k.struct_) and (kind_b == k.struct_) {
              fields_a := (&(*types)).get_struct_fields( a)
              fields_b := (&(*types)).get_struct_fields( b)

            if fields_a.len != fields_b.len {
                ret ty_id_error()
            }

            local_scratch := VecU32.new()
            has_err := false
            count := fields_a.len / 2
            i: u64 = 0

            while (i < count) {
                fields_a = (&(*types)).get_struct_fields(a)
                fields_b = (&(*types)).get_struct_fields(b)
                idx := i * 2
                na := *(fields_a.ptr + idx)
                ta := *(fields_a.ptr + idx + 1)
                nb := *(fields_b.ptr + idx)
                tb := *(fields_b.ptr + idx + 1)

                if na != nb {
                    has_err = true
                    break
                }

                unified_t := .unify_types(types, ta, tb)
                if unified_t == ty_id_error() {
                    has_err = true
                    break
                }

                local_scratch.push(na)
                local_scratch.push(unified_t)
                i = i + 1
            }

            if has_err {
                local_scratch.destroy()
                ret ty_id_error()
            }

            slice: SliceU32 = .{
                ptr: local_scratch.ptr_at(0),
                len: fields_a.len
            }

              res := (&(*types)).alloc_struct( slice)
            local_scratch.destroy()
            ret res
        }

        if (kind_a == k.func) and (kind_b == k.func) {
            params_a := (&(*types)).func_params(a)
            params_b := (&(*types)).func_params(b)
            if params_a.len != params_b.len {
                ret ty_id_error()
            }
            ret_a := (&(*types)).func_return(a)
            ret_b := (&(*types)).func_return(b)
            unified_ret := .unify_types(types, ret_a, ret_b)
            if unified_ret == ty_id_error() {
                ret ty_id_error()
            }

            local_scratch := VecU32.new()
            has_err := false
            i: u64 = 0
            while i < params_a.len {
                params_a = (&(*types)).func_params(a)
                params_b = (&(*types)).func_params(b)
                pa := *(params_a.ptr + i)
                pb := *(params_b.ptr + i)
                unified_p := .unify_types(types, pa, pb)
                if unified_p == ty_id_error() {
                    has_err = true
                    break
                }
                local_scratch.push(unified_p)
                i = i + 1
            }

            if has_err {
                local_scratch.destroy()
                ret ty_id_error()
            }

            slice: SliceU32 = .{
                ptr: local_scratch.ptr_at(0),
                len: params_a.len
            }
            res := (&(*types)).alloc_func(slice, unified_ret, false)
            local_scratch.destroy()
            ret res
        }

        if (kind_a == k.nominal) and (kind_b == k.nominal) {
            orig_a := (&(*types)).nominal_origin(a)
            orig_b := (&(*types)).nominal_origin(b)
            if orig_a == orig_b { ret a }

            sym_a := (&(*types)).get_nominal_creator_sym(orig_a)
            sym_b := (&(*types)).get_nominal_creator_sym(orig_b)

            if (sym_a != ty_id_none()) and (sym_a == sym_b) {
                args_a := (&(*types)).get_nominal_creator_args(orig_a)
                args_b := (&(*types)).get_nominal_creator_args(orig_b)
                if args_a.len == args_b.len {
                    has_err := false
                    i: u64 = 0
                    while i < args_a.len {
                        u_arg := .unify_types(types, *(args_a.ptr + i), *(args_b.ptr + i))
                        if u_arg == ty_id_error() {
                            has_err = true
                            break
                        }
                        i = i + 1
                    }
                    if not has_err {
                        a_has_inf := false
                        chk_i: u64 = 0
                        while chk_i < args_a.len {
                            if (&(*types)).kind(*(args_a.ptr + chk_i)) == k.infer {
                                a_has_inf = true
                                break
                            }
                            chk_i = chk_i + 1
                        }
                        if a_has_inf { ret b }
                        ret a
                    }
                }
            }
            ret ty_id_error()
        }

        ty_id_error()
    }

    resolve_type :: (slot u32) u32 {
        root := .find(slot)
         .types.get(root as u64)
    }

    resolve_type_deep :: (types &TypeStorage, slot u32) u32 {
        tyid := .resolve_type(slot)
        if tyid == ty_id_none() {
            ret ty_id_none()
        }

        k := ty_kind()
          kind := (&(*types)).kind( tyid)

        if kind == k.infer {
              inner_slot := (&(*types)).infer_slot( tyid)
            resolved := .resolve_type_deep(types, inner_slot)
            if resolved == ty_id_none() { ret tyid }
            ret resolved
        }

        if kind == k.ptr {
              inner_ty := (&(*types)).payload( tyid)
              if (&(*types)).kind( inner_ty) == k.infer {
                  inner_slot := (&(*types)).infer_slot( inner_ty)
                resolved := .resolve_type_deep(types, inner_slot)
                if resolved == ty_id_none() { ret tyid }
                  ret (&(*types)).alloc_ptr( resolved)
            }
            ret tyid
        }

        if kind == k.array {
              len := (&(*types)).get_array_len( tyid)
              inner_ty := (&(*types)).get_array_type( tyid)

              if (&(*types)).kind(inner_ty) == k.infer {
                  infer_slot := (&(*types)).infer_slot( inner_ty)
                resolved := .resolve_type_deep(types, infer_slot)
                if resolved == ty_id_none() { ret tyid }
                  ret (&(*types)).alloc_array( resolved, len)
            }
            ret tyid
        }

        if kind == k.union_ {
            count := (&(*types)).union_members(tyid).len
            result := ty_id_none()
            i: u64 = 0
            while i < count {
                members := (&(*types)).union_members(tyid)
                member := *(members.ptr + i)
                if (&(*types)).kind(member) == k.infer {
                    resolved := .resolve_type_deep(types, (&(*types)).infer_slot(member))
                    if resolved != ty_id_none() { member = resolved }
                }
                if result == ty_id_none() {
                    result = member
                } else {
                    result = (&(*types)).make_union_2(result, member)
                }
                i = i + 1
            }
            ret result
        }

        if kind == k.struct_ {
              fields := (&(*types)).get_struct_fields( tyid)
            count := fields.len / 2

            local_scratch := VecU32.new()
            changed := false
            i: u64 = 0

            while i < count {
                fields = (&(*types)).get_struct_fields(tyid)
                idx := i * 2
                name := *(fields.ptr + idx)
                field_ty := *(fields.ptr + idx + 1)

                  if (&(*types)).kind( field_ty) == k.infer {
                      field_slot := (&(*types)).infer_slot( field_ty)
                    resolved := .resolve_type_deep(types, field_slot)
                    if resolved == ty_id_none() { resolved = field_ty }
                    local_scratch.push(name)
                    local_scratch.push(resolved)
                    changed = true
                } else {
                    local_scratch.push(name)
                    local_scratch.push(field_ty)
                }
                i = i + 1
            }

            res := tyid
            if changed {
                slice: SliceU32 = .{
                    ptr: local_scratch.ptr_at(0),
                    len: fields.len
                }

                  res = (&(*types)).alloc_struct( slice)
            }

            local_scratch.destroy()
            ret res
        }

        tyid
    }
}

import Str from "std/string"

Token :: enum u8 {
    eof,
    unknown,
    ident,

    lit_int,
    lit_float,
    lit_str,
    lit_char,

    kw_ret,
    kw_if,
    kw_else,
    kw_while,
    kw_break,
    kw_cont,
    kw_struct,
    kw_import,
    kw_from,
    kw_true,
    kw_false,
    kw_as,
    kw_and,
    kw_or,
    kw_not,
    kw_fn,
    kw_match,
    kw_in,
    kw_for,
    kw_cmpt,

    plus,
    minus,
    star,
    slash,
    percent,
    plus_eq,
    minus_eq,
    star_eq,
    slash_eq,
    percent_eq,

    amp,
    pipe,
    caret,
    tilde,
    amp_eq,
    pipe_eq,
    caret_eq,

    left_shift,
    right_shift,
    left_shift_eq,
    right_shift_eq,

    eq,
    eq_eq,
    bang_eq,
    lt,
    lt_eq,
    gt,
    gt_eq,

    colon,
    colon_colon,
    semi,
    comma,
    dot,

    hash,

    o_paren,
    c_paren,
    o_brace,
    c_brace,
    o_bracket,
    c_bracket,
    kw_enum,
    at,
    lit_cstr,

    name :: fn(self Self) Str {
        match self {
            eof { "eof" }
            ident { "ident" }
            lit_int { "lit_int" }
            lit_float { "lit_float" }
            lit_str { "lit_str" }
            lit_char { "lit_char" }
            lit_cstr { "lit_cstr" }
            kw_ret { "kw_ret" }
            kw_if { "kw_if" }
            kw_else { "kw_else" }
            kw_while { "kw_while" }
            kw_break { "kw_break" }
            kw_cont { "kw_cont" }
            kw_struct { "kw_struct" }
            kw_enum { "kw_enum" }
            kw_fn { "kw_fn" }
            kw_match { "kw_match" }
            kw_in { "kw_in" }
            kw_for { "kw_for" }
            kw_cmpt { "kw_cmpt" }
            at { "@" }
            kw_import { "kw_import" }
            kw_from { "kw_from" }
            kw_true { "kw_true" }
            kw_false { "kw_false" }
            kw_as { "kw_as" }
            kw_and { "kw_and" }
            kw_or { "kw_or" }
            kw_not { "kw_not" }
            plus { "+" }
            minus { "-" }
            star { "*" }
            slash { "/" }
            eq { "=" }
            eq_eq { "==" }
            bang_eq { "!=" }
            amp { "&" }
            colon { ":" }
            colon_colon { "::" }
            comma { "," }
            semi { ";" }
            dot { "." }
            o_paren { "(" }
            c_paren { ")" }
            o_brace { "{" }
            c_brace { "}" }
            o_bracket { "[" }
            c_bracket { "]" }
            else { "Unknown" }
        }
    }
}

TokenStream :: struct {
    kinds           Vec(u8)
    starts          Vec(u32)
    lens            Vec(u32)
    texts           Vec(Str)
    newline_befores Vec(bool)

    new :: fn() TokenStream {
        .{
            kinds          : Vec(u8).new(),
            starts         : Vec(u32).new(),
            lens           : Vec(u32).new(),
            texts          : Vec(Str).new(),
            newline_befores: Vec(bool).new(),
        }
    }

    destroy :: fn(self &Self) {
        self.kinds.destroy()
        self.starts.destroy()
        self.lens.destroy()
        self.texts.destroy()
        self.newline_befores.destroy()
    }

    push :: fn(self &Self, kind Token, start, len u32, text Str, newline_before bool) {
        self.kinds.push(kind as u8)
        self.starts.push(start)
        self.lens.push(len)
        self.texts.push(text)
        self.newline_befores.push(newline_before)
    }

    count :: fn(self &Self) u64 {
        self.kinds.len
    }

    kind :: fn(self &Self, idx u32) Token {
        self.kinds.get(idx as u64) as Token
    }

    start :: fn(self &Self, idx u32) u32 {
        self.starts.get(idx as u64)
    }

    len :: fn(self &Self, idx u32) u32 {
        self.lens.get(idx as u64)
    }

    text :: fn(self &Self, idx u32) Str {
        self.texts.get(idx as u64)
    }

    newline_before :: fn(self &Self, idx u32) bool {
        self.newline_befores.get(idx as u64)
    }
}

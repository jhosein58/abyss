import VecU8  from "../std/vec/u8.a"
import VecU32 from "../std/vec/u32.a"
import VecStr from "../std/vec/str.a"
import VecBool from "../std/vec/bool.a"

import Str from "../std/string.a"

TokenType :: struct {
    eof           : u8,
    unknown       : u8,
    ident         : u8,

    lit_int       : u8,
    lit_float     : u8,
    lit_str       : u8,
    lit_char      : u8,

    kw_ret        : u8,
    kw_if         : u8,
    kw_else       : u8,
    kw_while      : u8,
    kw_break      : u8,
    kw_cont       : u8,
    kw_struct     : u8,
    kw_import     : u8,
    kw_from       : u8,
    kw_true       : u8,
    kw_false      : u8,
    kw_as         : u8,
    kw_and        : u8,
    kw_or         : u8,
    kw_not        : u8,

    plus          : u8,
    minus         : u8,
    star          : u8,
    slash         : u8,
    percent       : u8,
    plus_eq       : u8,
    minus_eq      : u8,
    star_eq       : u8,
    slash_eq      : u8,
    percent_eq    : u8,

    amp           : u8,
    pipe          : u8,
    caret         : u8,
    tilde         : u8,
    amp_eq        : u8,
    pipe_eq       : u8,
    caret_eq      : u8,

    left_shift    : u8,
    right_shift   : u8,
    left_shift_eq : u8,
    right_shift_eq: u8,

    eq            : u8,
    eq_eq         : u8,
    bang_eq       : u8,
    lt            : u8,
    lt_eq         : u8,
    gt            : u8,
    gt_eq         : u8,

    colon         : u8,
    colon_colon   : u8,
    semi          : u8,
    comma         : u8,
    dot           : u8,
    hash          : u8,

    o_paren       : u8,
    c_paren       : u8,
    o_brace       : u8,
    c_brace       : u8,
    o_bracket     : u8,
    c_bracket     : u8,
}

token :: () TokenType {
    .{
        eof           : 0,
        unknown       : 1,
        ident         : 2,

        lit_int       : 3,
        lit_float     : 4,
        lit_str       : 5,
        lit_char      : 6,

        kw_ret        : 7,
        kw_if         : 8,
        kw_else       : 9,
        kw_while      : 10,
        kw_break      : 11,
        kw_cont       : 12,
        kw_struct     : 13,
        kw_import     : 14,
        kw_from       : 15,
        kw_true       : 16,
        kw_false      : 17,
        kw_as         : 18,
        kw_and        : 19,
        kw_or         : 20,
        kw_not        : 21,

        plus          : 22,
        minus         : 23,
        star          : 24,
        slash         : 25,
        percent       : 26,
        plus_eq       : 27,
        minus_eq      : 28,
        star_eq       : 29,
        slash_eq      : 30,
        percent_eq    : 31,

        amp           : 32,
        pipe          : 33,
        caret         : 34,
        tilde         : 35,
        amp_eq        : 36,
        pipe_eq       : 37,
        caret_eq      : 38,

        left_shift    : 39,
        right_shift   : 40,
        left_shift_eq : 41,
        right_shift_eq: 42,

        eq            : 43,
        eq_eq         : 44,
        bang_eq       : 45,
        lt            : 46,
        lt_eq         : 47,
        gt            : 48,
        gt_eq         : 49,

        colon         : 50,
        colon_colon   : 51,
        semi          : 52,
        comma         : 53,
        dot           : 54,

        hash          : 55,

        o_paren       : 56,
        c_paren       : 57,
        o_brace       : 58,
        c_brace       : 59,
        o_bracket     : 60,
        c_bracket     : 61,
    }
}

token_name :: (tk u8) Str {
    t := token()

    if tk == t.eof         { ret Str.of("eof")       }
    if tk == t.ident       { ret Str.of("ident")     }
    if tk == t.lit_int     { ret Str.of("lit_int")   }
    if tk == t.lit_float   { ret Str.of("lit_float") }
    if tk == t.lit_str     { ret Str.of("lit_str")   }
    if tk == t.lit_char    { ret Str.of("lit_char")  }

    if tk == t.kw_ret      { ret Str.of("kw_ret")    }
    if tk == t.kw_if       { ret Str.of("kw_if")     }
    if tk == t.kw_else     { ret Str.of("kw_else")   }
    if tk == t.kw_while    { ret Str.of("kw_while")  }
    if tk == t.kw_break    { ret Str.of("kw_break")  }
    if tk == t.kw_cont     { ret Str.of("kw_cont")   }
    if tk == t.kw_struct   { ret Str.of("kw_struct") }
    if tk == t.kw_import   { ret Str.of("kw_import") }
    if tk == t.kw_from     { ret Str.of("kw_from")   }
    if tk == t.kw_true     { ret Str.of("kw_true")   }
    if tk == t.kw_false    { ret Str.of("kw_false")  }

    if tk == t.plus        { ret Str.of("+")         }
    if tk == t.minus       { ret Str.of("-")         }
    if tk == t.star        { ret Str.of("*")         }
    if tk == t.slash       { ret Str.of("/")         }
    if tk == t.eq          { ret Str.of("=")         }
    if tk == t.eq_eq       { ret Str.of("==")        }
    if tk == t.bang_eq     { ret Str.of("!=")        }
    if tk == t.amp         { ret Str.of("&")         }
    if tk == t.colon       { ret Str.of(":")         }
    if tk == t.colon_colon { ret Str.of("::")        }
    if tk == t.comma       { ret Str.of(",")         }
    if tk == t.semi        { ret Str.of(";")         }
    if tk == t.dot         { ret Str.of(".")         }
    if tk == t.o_paren     { ret Str.of("(")         }
    if tk == t.c_paren     { ret Str.of(")")         }
    if tk == t.o_brace     { ret Str.of("{")         }
    if tk == t.c_brace     { ret Str.of("}")         }
    if tk == t.o_bracket   { ret Str.of("[")         }
    if tk == t.c_bracket   { ret Str.of("]")         }
    

    Str.of("Unknown")
}

TokenStream :: struct {
    kinds          : VecU8,
    starts         : VecU32,
    lens           : VecU32,
    texts          : VecStr,
    newline_befores: VecBool,

    new :: () TokenStream {
        .{
            kinds          : VecU8.new(),
            starts         : VecU32.new(),
            lens           : VecU32.new(),
            texts          : VecStr.new(),
            newline_befores: VecBool.new(),
        }
    }

    destroy :: () {
        .kinds.destroy()
        .starts.destroy()
        .lens.destroy()
        .texts.destroy()
        .newline_befores.destroy()
    }

    push :: (kind u8, start, len u32, text Str, newline_before bool) {
        .kinds.push(kind)
        .starts.push(start)
        .lens.push(len)
        .texts.push(text)
        .newline_befores.push(newline_before)
    }

    count :: () u64 {
        .kinds.len
    }

    kind :: (idx u32) u8 {
        .kinds.get(idx as u64)
    }

    start :: (idx u32) u32 {
        .starts.get(idx as u64)
    }

    len :: (idx u32) u32 {
        .lens.get(idx as u64)
    }

    text :: (idx u32) Str {
        .texts.get(idx as u64)
    }

    newline_before :: (idx u32) bool {
        .newline_befores.get(idx as u64)
    }
}
import Str from "std/string"

TokenType :: enum u8 {
    eof,
    unknown,
    ident,

    lit_int,
    lit_float,
    lit_str,
    lit_char,

    kw_ret,
    kw_if,
    kw_else,
    kw_while,
    kw_break,
    kw_cont,
    kw_struct,
    kw_import,
    kw_from,
    kw_true,
    kw_false,
    kw_as,
    kw_and,
    kw_or,
    kw_not,
    kw_fn,
    kw_match,
    kw_in,
    kw_for,

    plus,
    minus,
    star,
    slash,
    percent,
    plus_eq,
    minus_eq,
    star_eq,
    slash_eq,
    percent_eq,

    amp,
    pipe,
    caret,
    tilde,
    amp_eq,
    pipe_eq,
    caret_eq,

    left_shift,
    right_shift,
    left_shift_eq,
    right_shift_eq,

    eq,
    eq_eq,
    bang_eq,
    lt,
    lt_eq,
    gt,
    gt_eq,

    colon,
    colon_colon,
    semi,
    comma,
    dot,

    hash,

    o_paren,
    c_paren,
    o_brace,
    c_brace,
    o_bracket,
    c_bracket,
    kw_enum,
    at,
    lit_cstr
}

token :: TokenType

token_name :: fn(tk TokenType) Str {
    t := token

    if tk == t.eof         { ret Str.of("eof")       }
    if tk == t.ident       { ret Str.of("ident")     }
    if tk == t.lit_int     { ret Str.of("lit_int")   }
    if tk == t.lit_float   { ret Str.of("lit_float") }
    if tk == t.lit_str     { ret Str.of("lit_str")   }
    if tk == t.lit_char    { ret Str.of("lit_char")  }
    if tk == t.lit_cstr    { ret Str.of("lit_cstr")  }

    if tk == t.kw_ret      { ret Str.of("kw_ret")    }
    if tk == t.kw_if       { ret Str.of("kw_if")     }
    if tk == t.kw_else     { ret Str.of("kw_else")   }
    if tk == t.kw_while    { ret Str.of("kw_while")  }
    if tk == t.kw_break    { ret Str.of("kw_break")  }
    if tk == t.kw_cont     { ret Str.of("kw_cont")   }
    if tk == t.kw_struct   { ret Str.of("kw_struct") }
    if tk == t.kw_enum     { ret Str.of("kw_enum")   }
    if tk == t.kw_fn       { ret Str.of("kw_fn")     }
    if tk == t.kw_match   { ret Str.of("kw_match")   }
    if tk == t.kw_in      { ret Str.of("kw_in")      }
    if tk == t.kw_for     { ret Str.of("kw_for")     }
    if tk == t.at          { ret Str.of("@")         }
    if tk == t.kw_import   { ret Str.of("kw_import") }
    if tk == t.kw_from     { ret Str.of("kw_from")   }
    if tk == t.kw_true     { ret Str.of("kw_true")   }
    if tk == t.kw_false    { ret Str.of("kw_false")  }

    if tk == t.plus        { ret Str.of("+")         }
    if tk == t.minus       { ret Str.of("-")         }
    if tk == t.star        { ret Str.of("*")         }
    if tk == t.slash       { ret Str.of("/")         }
    if tk == t.eq          { ret Str.of("=")         }
    if tk == t.eq_eq       { ret Str.of("==")        }
    if tk == t.bang_eq     { ret Str.of("!=")        }
    if tk == t.amp         { ret Str.of("&")         }
    if tk == t.colon       { ret Str.of(":")         }
    if tk == t.colon_colon { ret Str.of("::")        }
    if tk == t.comma       { ret Str.of(",")         }
    if tk == t.semi        { ret Str.of(";")         }
    if tk == t.dot         { ret Str.of(".")         }
    if tk == t.o_paren     { ret Str.of("(")         }
    if tk == t.c_paren     { ret Str.of(")")         }
    if tk == t.o_brace     { ret Str.of("{")         }
    if tk == t.c_brace     { ret Str.of("}")         }
    if tk == t.o_bracket   { ret Str.of("[")         }
    if tk == t.c_bracket   { ret Str.of("]")         }
    

    Str.of("Unknown")
}

TokenStream :: struct {
    kinds           Vec(u8)
    starts          Vec(u32)
    lens            Vec(u32)
    texts           Vec(Str)
    newline_befores Vec(bool)

    new :: fn() TokenStream {
        .{
            kinds          : Vec(u8).new(),
            starts         : Vec(u32).new(),
            lens           : Vec(u32).new(),
            texts          : Vec(Str).new(),
            newline_befores: Vec(bool).new(),
        }
    }

    destroy :: fn(self &Self) {
        self.kinds.destroy()
        self.starts.destroy()
        self.lens.destroy()
        self.texts.destroy()
        self.newline_befores.destroy()
    }

    push :: fn(self &Self, kind TokenType, start, len u32, text Str, newline_before bool) {
        self.kinds.push(kind as u8)
        self.starts.push(start)
        self.lens.push(len)
        self.texts.push(text)
        self.newline_befores.push(newline_before)
    }

    count :: fn(self &Self) u64 {
        self.kinds.len
    }

    kind :: fn(self &Self, idx u32) TokenType {
        self.kinds.get(idx as u64) as TokenType
    }

    start :: fn(self &Self, idx u32) u32 {
        self.starts.get(idx as u64)
    }

    len :: fn(self &Self, idx u32) u32 {
        self.lens.get(idx as u64)
    }

    text :: fn(self &Self, idx u32) Str {
        self.texts.get(idx as u64)
    }

    newline_before :: fn(self &Self, idx u32) bool {
        self.newline_befores.get(idx as u64)
    }
}

import Str from "std/string"

Token :: enum u8 {
    eof            -- eof
    unknown        -- unknown
    ident          -- identifier

    lit_int        -- 123
    lit_float      -- 1.0
    lit_str        -- "..."
    lit_char       -- 'c'

    kw_ret         -- ret
    kw_if          -- if
    kw_else        -- else
    kw_while       -- while
    kw_break       -- break
    kw_cont        -- cont
    kw_struct      -- struct
    kw_import      -- import
    kw_from        -- from
    kw_true        -- true
    kw_false       -- false
    kw_as          -- as
    kw_and         -- and
    kw_or          -- or
    kw_not         -- not
    kw_fn          -- fn
    kw_match       -- match
    kw_in          -- in
    kw_for         -- for
    kw_cmpt        -- cmpt

    plus           -- +
    minus          -- -
    star           -- *
    slash          -- /
    percent        -- %
    plus_eq        -- +=
    minus_eq       -- -=
    star_eq        -- *=
    slash_eq       -- /=
    percent_eq     -- %=

    amp            -- &
    pipe           -- |
    caret          -- ^
    tilde          -- ~
    amp_eq         -- &=
    pipe_eq        -- |=
    caret_eq       -- ^=

    left_shift     -- <<
    right_shift    -- >>
    left_shift_eq  -- <<=
    right_shift_eq -- >>=

    eq             -- =
    eq_eq          -- ==
    bang_eq        -- !=
    lt             -- <
    lt_eq          -- <=
    gt             -- >
    gt_eq          -- >=

    colon          -- :
    colon_colon    -- ::
    semi           -- ;
    comma          -- ,
    dot            -- .

    hash           -- #

    o_paren        -- (
    c_paren        -- )
    o_brace        -- {
    c_brace        -- }
    o_bracket      -- [
    c_bracket      -- ]
    kw_enum        -- enum
    at             -- @
    lit_cstr       -- c"..."
}

TokenStream :: struct {
    kinds           Vec(u8)
    starts          Vec(u32)
    lens            Vec(u32)
    texts           Vec(Str) -- TODO: drop? slice from src[start..len]
    newline_befores Vec(bool)

    new :: fn() TokenStream {
        .{
            kinds          : Vec(u8).new(),
            starts         : Vec(u32).new(),
            lens           : Vec(u32).new(),
            texts          : Vec(Str).new(),
            newline_befores: Vec(bool).new(),
        }
    }

    destroy :: fn(self &Self) {
        self.kinds.destroy()
        self.starts.destroy()
        self.lens.destroy()
        self.texts.destroy()
        self.newline_befores.destroy()
    }

    push :: fn(self &Self, kind Token, start, len u32, text Str, newline_before bool) {
        self.kinds.push(kind as u8)
        self.starts.push(start)
        self.lens.push(len)
        self.texts.push(text)
        self.newline_befores.push(newline_before)
    }

    count :: fn(self &Self) u64 {
        self.kinds.len
    }

    kind :: fn(self &Self, idx u32) Token {
        self.kinds.get(idx as u64) as Token
    }

    start :: fn(self &Self, idx u32) u32 {
        self.starts.get(idx as u64)
    }

    len :: fn(self &Self, idx u32) u32 {
        self.lens.get(idx as u64)
    }

    text :: fn(self &Self, idx u32) Str {
        self.texts.get(idx as u64)
    }

    newline_before :: fn(self &Self, idx u32) bool {
        self.newline_befores.get(idx as u64)
    }
}

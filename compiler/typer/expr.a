fall :: @import("std/sys").fall

Engine :: @import("compiler/engine").Engine
hir :: @import("compiler/hir")
decode_char_lit :: @import("compiler/lexer").decode_char_lit
eval_const :: @import("compiler/lower").eval_const
Nexus :: @import("compiler/nexus/nexus").Nexus
id_none :: @import("compiler/nexus/pool").id_none
reflection :: @import("compiler/typer/reflection")
resolve_ty_id :: @import("compiler/typer/specialize").resolve_ty_id
tyck :: @import("compiler/typer/tyck")
type_defs :: @import("compiler/types")
slot_none :: @import("compiler/unify").slot_none
type_common :: @import("./common")
synth_type_node :: @import("./var").synth_type_node

synth_lit_int :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)
    (&(*db).unify).bind_type(&(*db).types, slot, type_defs.ty_id_untyped_int())
    db.set_is_const(id, true)
    db.set_const_val(id, tbl.lhs(id) as u64)
}

synth_lit_float :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    (&(*db).unify).bind_type(&(*db).types, slot, type_defs.ty_id_untyped_float())
    db.set_is_const(id, true)
}

synth_lit_bool :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    (&(*db).unify).bind_type(&(*db).types, slot, type_defs.ty_id_bool())
    db.set_is_const(id, true)
    b_val: u64 = 0
    if tbl.kind(id) == hir.hir_kind.lit_bool_true {
        b_val = 1
    }
    db.set_const_val(id, b_val)
}

synth_lit_str :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    slot := (&(*db).unify).new_slot(id)
    str_ty := eng.get_str_type()
    if str_ty != type_defs.ty_id_none() {
        (&(*db).unify).bind_type(&(*db).types, slot, str_ty)
        db.set_const_type(id, str_ty)
    }
    db.set_is_const(id, true)
}

synth_lit_char :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    (&(*db).unify).bind_type(&(*db).types, slot, type_defs.ty_id_untyped_int())
    db.set_is_const(id, true)
    raw := db.interner.get(tbl.lhs(id))
    c_val := decode_char_lit(raw) as u64
    db.set_const_val(id, c_val)
}

synth_lit_cstr :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    u8_ty := (&(*db).types).alloc_uint(8 as u16)
    ptr_ty := (&(*db).types).alloc_ptr(u8_ty)
    (&(*db).unify).bind_type(&(*db).types, slot, ptr_ty)
    db.set_const_type(id, ptr_ty)
    db.set_is_const(id, true)
}

synth_unary_num :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    slot := db.unify.new_slot(id)
    child := tbl.lhs(id)
    child_slot := db.unify.get_slot(child)
    if child_slot != slot_none() {
        db.unify.union(&db.types, slot, child_slot)
        child_ty := db.unify.resolve_type_deep(&db.types, child_slot)
        kind := db.types.kind(child_ty)
        is_int := (kind == type_defs.TyKind.int) or (kind == type_defs.TyKind.uint) or
            (kind == type_defs.TyKind.untyped_int)
        if is_int {
            if db.is_const(child) {
                db.set_is_const(id, true)
            }
            ret
        }
        if (tbl.kind(id) == hir.hir_kind.unary_neg) and
            ((kind == type_defs.TyKind.float) or (kind == type_defs.TyKind.untyped_float)) {
            if db.is_const(child) {
                db.set_is_const(id, true)
            }
            ret
        }
    }
    printf("\n[type error] invalid unary operand\n       --> ", .{})
    db.print_loc(id)
    print("")
    #fall
}

synth_unary_not :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    slot := db.unify.new_slot(id)
    child := tbl.lhs(id)
    child_slot := db.unify.get_slot(child)
    if child_slot != slot_none() {
        db.unify.bind_type(&db.types, child_slot, type_defs.ty_id_bool())
    }
    db.unify.bind_type(&db.types, slot, type_defs.ty_id_bool())
    if db.is_const(child) {
        db.set_is_const(id, true)
    }
}

synth_unary_addr_of :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    if db.get_const_type(id) != type_defs.ty_id_none() {
        ret
    }
    slot := db.unify.get_slot(id)
    if slot == slot_none() {
        slot = db.unify.new_slot(id)
    }
    child := tbl.lhs(id)
    child_slot := db.unify.get_slot(child)

    child_const := db.get_const_type(child)
    if child_const != type_defs.ty_id_none() {
        if db.types.kind(child_const) == type_defs.TyKind.infer {
            ptr_val := db.types.alloc_ptr(child_const)
            db.set_const_type(id, ptr_val)
            db.unify.bind_type(&db.types, slot, type_defs.ty_id_type())
            ret
        }
    }
    if child_slot != slot_none() {
        child_ty := db.unify.resolve_type_deep(&db.types, child_slot)
        if db.types.kind(child_ty) == type_defs.TyKind.type_ {
            db.unify.bind_type(&db.types, slot, type_defs.ty_id_type())
            val := db.get_const_type(child)
            if val != type_defs.ty_id_none() {
                ptr_val := db.types.alloc_ptr(val)
                db.set_const_type(id, ptr_val)
            }
            ret
        }
        if child_ty != type_defs.ty_id_none() {
            ptr_ty := db.types.alloc_ptr(child_ty)
            db.unify.bind_type(&db.types, slot, ptr_ty)
        }
    }
}

synth_unary_deref :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    slot := db.unify.get_slot(id)
    if slot == slot_none() {
        slot = db.unify.new_slot(id)
    }
    child := tbl.lhs(id)
    child_slot := db.unify.get_slot(child)

    if child_slot != slot_none() {
        child_ty := db.unify.resolve_type_deep(&db.types, child_slot)
        if db.types.kind(child_ty) == type_defs.TyKind.ptr {
            inner_ty := db.types.payload(child_ty)
            db.unify.bind_type(&db.types, slot, inner_ty)
        } else if child_ty == db.str_type {
            u8_ty := db.types.alloc_uint(8 as u16)
            db.unify.bind_type(&db.types, slot, u8_ty)
        } else {
            printf("\n[type error] cannot dereference non-pointer\n       --> ", .{})
            db.print_loc(id)
            print("")
            #fall
        }
    }
}

synth_binary :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    slot := db.unify.get_slot(id)
    if slot == slot_none() {
        slot = db.unify.new_slot(id)
    }
    lhs := tbl.lhs(id)
    rhs := tbl.rhs(id)

    lhs_slot := db.unify.get_slot(lhs)
    rhs_slot := db.unify.get_slot(rhs)

    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        lhs_ty := db.unify.resolve_type_deep(&db.types, lhs_slot)
        rhs_ty := db.unify.resolve_type_deep(&db.types, rhs_slot)

        lhs_k := db.types.kind(lhs_ty)
        rhs_k := db.types.kind(rhs_ty)

        lhs_int := (lhs_k == type_defs.TyKind.int) or (lhs_k == type_defs.TyKind.uint) or
            (lhs_k == type_defs.TyKind.untyped_int)
        rhs_int := (rhs_k == type_defs.TyKind.int) or (rhs_k == type_defs.TyKind.uint) or
            (rhs_k == type_defs.TyKind.untyped_int)
        lhs_num := lhs_int or (lhs_k == type_defs.TyKind.float) or
            (lhs_k == type_defs.TyKind.untyped_float)
        rhs_num := rhs_int or (rhs_k == type_defs.TyKind.float) or
            (rhs_k == type_defs.TyKind.untyped_float)
        op := tbl.kind(id)

        if op == hir.hir_kind.binary_bit_or {
            lhs_val := db.get_const_type(lhs)
            rhs_val := db.get_const_type(rhs)
            if (lhs_val != type_defs.ty_id_none()) and (rhs_val != type_defs.ty_id_none()) {
                union_ty := db.types.make_union_2(lhs_val, rhs_val)
                db.unify.bind_type(&db.types, slot, type_defs.ty_id_type())
                db.set_const_type(id, union_ty)
                db.set_is_const(id, true)
                ret
            }
        }
        if (lhs_k == type_defs.TyKind.ptr) or (rhs_k == type_defs.TyKind.ptr) {
            if (lhs_k == type_defs.TyKind.ptr) and rhs_int and
                ((op == hir.hir_kind.binary_add) or (op == hir.hir_kind.binary_sub)) {
                db.unify.bind_type(&db.types, slot, lhs_ty)
                ret
            }
            if (rhs_k == type_defs.TyKind.ptr) and lhs_int and (op == hir.hir_kind.binary_add) {
                db.unify.bind_type(&db.types, slot, rhs_ty)
                ret
            }
        } else if lhs_num and rhs_num {
            bitwise := (op == hir.hir_kind.binary_bit_and) or (op == hir.hir_kind.binary_bit_or) or
                (op == hir.hir_kind.binary_bit_xor) or
                (op == hir.hir_kind.binary_shl) or
                (op == hir.hir_kind.binary_shr)
            if (not bitwise) or (lhs_int and rhs_int) {
                db.unify.union(&db.types, lhs_slot, rhs_slot)
                db.unify.union(&db.types, slot, lhs_slot)
                if db.is_const(lhs) and db.is_const(rhs) {
                    db.set_is_const(id, true)
                }
                ret
            }
        }
        printf("\n[type error] invalid arithmetic operands\n       --> ", .{})
        db.print_loc(id)
        print("")
        #fall
    } else {
        printf("\n[type error] missing arithmetic operand\n       --> ", .{})
        db.print_loc(id)
        print("")
        #fall
    }
}

synth_assign :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    slot := db.unify.new_slot(id)
    lhs := tbl.lhs(id)
    rhs := tbl.rhs(id)

    if tbl.kind(lhs) == hir.hir_kind.ident {
        sym := db.get_hir_symbol(lhs)
        if sym != id_none() {
            real_sym := db.resolve_sym(sym)
            if db.is_sym_const(real_sym) {
                printf(
                    "\n\033[1;31m[type error]\033[0m cannot assign to constant\n       --> "
                    .{}
                )
                db.print_loc(id)
                print("")
                #fall
            }
        }
    } else if db.is_const(lhs) {
        printf("\n\033[1;31m[type error]\033[0m cannot assign to constant\n       --> ", .{})
        db.print_loc(id)
        print("")
        #fall
    }
    lhs_slot := db.unify.get_slot(lhs)
    rhs_slot := db.unify.get_slot(rhs)

    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        lhs_ty := db.unify.resolve_type(lhs_slot)
        if lhs_ty != type_defs.ty_id_none() {
            type_common.check_value(db, rhs, lhs_ty)
        }
        rhs_slot = db.unify.get_slot(rhs)
        db.unify.union(&db.types, lhs_slot, rhs_slot)
        rhs_ty := db.unify.resolve_type_deep(&db.types, lhs_slot)
        if rhs_ty != type_defs.ty_id_none() {
            db.unify.bind_type(&db.types, slot, rhs_ty)
        }
    }
}

synth_binary_comp :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    slot := db.unify.new_slot(id)
    lhs := tbl.lhs(id)
    rhs := tbl.rhs(id)
    lhs_slot := db.unify.get_slot(lhs)
    rhs_slot := db.unify.get_slot(rhs)
    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        db.unify.union(&db.types, lhs_slot, rhs_slot)
        lhs_ty := db.unify.resolve_type_deep(&db.types, lhs_slot)
        rhs_ty := db.unify.resolve_type_deep(&db.types, rhs_slot)
        lhs_kind := db.types.kind(lhs_ty)
        rhs_kind := db.types.kind(rhs_ty)
        lhs_num := (lhs_kind == type_defs.TyKind.int) or (lhs_kind == type_defs.TyKind.uint) or
            (lhs_kind == type_defs.TyKind.float) or
            (lhs_kind == type_defs.TyKind.untyped_int) or
            (lhs_kind == type_defs.TyKind.untyped_float)
        rhs_num := (rhs_kind == type_defs.TyKind.int) or (rhs_kind == type_defs.TyKind.uint) or
            (rhs_kind == type_defs.TyKind.float) or
            (rhs_kind == type_defs.TyKind.untyped_int) or
            (rhs_kind == type_defs.TyKind.untyped_float)
        valid := lhs_num and rhs_num
        if not valid {
            op := tbl.kind(id)
            if (op == hir.hir_kind.binary_eq_eq) or (op == hir.hir_kind.binary_neq) {
                valid = (
                    (lhs_kind == type_defs.TyKind.bool) and (rhs_kind == type_defs.TyKind.bool)
                ) or
                    ((lhs_kind == type_defs.TyKind.ptr) and (rhs_kind == type_defs.TyKind.ptr)) or
                    ((lhs_kind == type_defs.TyKind.enum_) and (rhs_kind == type_defs.TyKind.enum_))
            }
        }
        if not valid {
            printf("\n[type error] invalid comparison operands\n       --> ", .{})
            db.print_loc(id)
            print("")
            #fall
        }
    } else {
        printf("\n[type error] invalid comparison operands\n       --> ", .{})
        db.print_loc(id)
        print("")
        #fall
    }
    db.unify.bind_type(&db.types, slot, type_defs.ty_id_bool())
    if db.is_const(lhs) and db.is_const(rhs) {
        db.set_is_const(id, true)
    }
}

synth_logic_and_or :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    slot := db.unify.new_slot(id)
    lhs := tbl.lhs(id)
    rhs := tbl.rhs(id)
    type_common.check_bool_operand(db, lhs, c"logical operator operand")
    type_common.check_bool_operand(db, rhs, c"logical operator operand")
    db.unify.bind_type(&db.types, slot, type_defs.ty_id_bool())
    if db.is_const(lhs) and db.is_const(rhs) {
        db.set_is_const(id, true)
    }
}

synth_cast :: fn(eng &Engine, id u32) {
    db := &eng.nexus
    tbl := &db.hir
    slot := db.unify.get_slot(id)
    if slot == slot_none() {
        slot = db.unify.new_slot(id)
    }
    lhs := tbl.lhs(id)
    rhs := tbl.rhs(id)
    if db.is_const(lhs) {
        db.set_is_const(id, true)
    }
    rhs_type := db.get_const_type(rhs)
    if rhs_type == type_defs.ty_id_none() {
        rhs_type = synth_type_node(eng, rhs)
    }
    if (rhs_type == type_defs.ty_id_none()) and db.is_const(rhs) {
        rhs_type = eval_const(db, rhs) as u32
        if rhs_type != type_defs.ty_id_none() {
            db.set_const_type(rhs, rhs_type)
        }
    }
    if rhs_type != type_defs.ty_id_none() {
        lhs_slot := db.unify.get_slot(lhs)
        lhs_type := type_defs.ty_id_none()
        if lhs_slot != slot_none() {
            lhs_type = db.unify.resolve_type_deep(&db.types, lhs_slot)
            original := db.unify.resolve_type(lhs_slot)
            if db.types.kind(original) == type_defs.TyKind.union_ {
                lhs_type = resolve_ty_id(eng, &db.unify, &db.types, original)
            }
        }
        types := &db.types
        if types.kind(lhs_type) == type_defs.TyKind.union_ {
            lhs_type = resolve_ty_id(eng, &db.unify, types, lhs_type)
        }
        src := types.kind(lhs_type)
        dst := types.kind(rhs_type)
        src_int := (src == type_defs.TyKind.int) or (src == type_defs.TyKind.uint) or
            (src == type_defs.TyKind.untyped_int)
        dst_int := (dst == type_defs.TyKind.int) or (dst == type_defs.TyKind.uint) or
            (dst == type_defs.TyKind.untyped_int)
        src_num := src_int or (src == type_defs.TyKind.float) or
            (src == type_defs.TyKind.untyped_float) or
            (src == type_defs.TyKind.bool)
        dst_num := dst_int or (dst == type_defs.TyKind.float) or
            (dst == type_defs.TyKind.untyped_float) or
            (dst == type_defs.TyKind.bool)
        if src == type_defs.TyKind.union_ {
            if types.union_contains(lhs_type, rhs_type) {
                db.unify.bind_type(&db.types, slot, rhs_type)
                ret
            }
            printf("\n[type error] union does not contain target type in cast\n       --> ", .{})
            db.print_loc(id)
            print("")
            #fall
        }
        if (src == type_defs.TyKind.enum_) or (dst == type_defs.TyKind.enum_) {
            src_valid := src_int or (src == type_defs.TyKind.enum_)
            dst_valid := dst_int or (dst == type_defs.TyKind.enum_)
            if src_valid and dst_valid {
                db.unify.bind_type(&db.types, slot, rhs_type)
                ret
            }
        }
        if not (
            (src_num and dst_num) or
                ((src == type_defs.TyKind.ptr) and (dst == type_defs.TyKind.ptr)) or
                (src_int and (dst == type_defs.TyKind.ptr)) or
                ((src == type_defs.TyKind.ptr) and dst_int) or
                ((src == type_defs.TyKind.ptr) and (dst == type_defs.TyKind.bool))
        ) {
            printf("\n[type error] invalid cast\n       --> ", .{})
            db.print_loc(id)
            print("")
            #fall
        }
        db.unify.bind_type(&db.types, slot, rhs_type)
    } else {
        printf("\n[type error] cast target is not a type\n       --> ", .{})
        db.print_loc(id)
        print("")
        #fall
    }
}

synth_source_location :: fn(eng &Engine, id u32, slot u32) {
    db := &eng.nexus
    name := db.interner.intern("SourceLocation")
    sym := db.find_symbol(db.core_prelude, name)
    eng.ensure_resolved(sym)
    ty := db.get_const_type(db.get_sym_hir(db.resolve_sym(sym)))
    db.bind_type(slot, ty)
    db.set_is_const(id, true)

    if db.hir.extra(id) != hir.hir_none() {
        ret
    }

    path := db.get_file_path(db.get_hir_file(id))
    pos := db.get_pos(id)
    tbl := &db.hir
    file := tbl.push(
        hir.hir_kind.lit_str
        db.interner.intern(reflection.reflection_quote(db, path))
        hir.hir_none()
        hir.hir_none()
    )
    line := tbl.push(hir.hir_kind.lit_int, pos.line, hir.hir_none(), hir.hir_none())
    column := tbl.push(hir.hir_kind.lit_int, pos.col, hir.hir_none(), hir.hir_none())
    synth_lit_str(eng, file)
    u32_ty := db.types.alloc_uint(32)
    db.bind_type(db.ensure_slot(line), u32_ty)
    db.bind_type(db.ensure_slot(column), u32_ty)

    fields: [3]u32 = .[
        tbl.push(hir.hir_kind.ident, db.interner.intern("file"), hir.hir_none(), hir.hir_none())
        tbl.push(hir.hir_kind.ident, db.interner.intern("line"), hir.hir_none(), hir.hir_none())
        tbl.push(hir.hir_kind.ident, db.interner.intern("column"), hir.hir_none(), hir.hir_none())
    ]
    values: [3]u32 = .[ file, line, column ]
    field_list := db.add_list(Slice(u32).new(&fields[0], 3))
    value_list := db.add_list(Slice(u32).new(&values[0], 3))
    literal := tbl.push(hir.hir_kind.struct_init, field_list, value_list, hir.hir_none())
    db.bind_type(db.ensure_slot(literal), ty)
    db.hir.set_extra(id, literal)
}

import_path :: fn(eng &Engine, id u32) Str {
    db := &eng.nexus
    if db.hir.kind(id) == hir.hir_kind.lit_str {
        raw := db.interner.get(db.hir.lhs(id))
        if raw.ptr[0] == '`' {
            ret raw.trim_quotes()
        }
        escaped := false
        for ch in raw {
            if ch == '\\' {
                escaped = true
                break
            }
        }
        if not escaped { ret raw.trim_quotes() }
    }
    ty := eng.get_str_type()
    kind := db.hir.kind(id)
    binding := kind == hir.hir_kind.ident or (kind == hir.hir_kind.member and db.is_const(id))
    constant := kind == hir.hir_kind.lit_str or db.has_const_val(id) or
        (binding and db.is_sym_const(db.get_hir_symbol(id)))
    if db.get_node_type(id) != ty or not constant {
        db.type_error(id, "@import path must be a compile-time Str")
    }
    tyck.process_mono_funcs(eng)
    bits := eval_const(db, id)
    if bits == 0 {
        db.type_error(id, "@import path must be a compile-time Str")
    }
    Str.new(
        reflection.reflection_read(db, bits, ty, "ptr") as &u8
        reflection.reflection_read(db, bits, ty, "len")
    )
}

synth_import :: fn(eng &Engine, id, slot u32, args Slice(u32)) {
    db := &eng.nexus
    if args.len != 1 {
        db.type_error(id, "@import expects one path")
    }
    arg := args.ptr[0]
    path := import_path(eng, arg)
    fid := db.get_hir_file(id)
    module := eng.load_module(fid, db.get_hir_span(arg).start, db.get_file_path(fid), path)
    ty := db.module_type(module)
    db.bind_type(slot, ty)
    db.set_is_const(id, true)
}

synth_builtin_call :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }
    name_id := (tbl).lhs(id)
    name := db.interner.get(name_id)
    args_list_id := (tbl).rhs(id)
    args := db.get_list(args_list_id)

    if name.eq("import") {
        synth_import(eng, id, slot, args)
        ret
    }
    if name.eq("source_location") {
        if args.len != 0 { db.type_error(id, "@source_location expects no arguments") }
        synth_source_location(eng, id, slot)
        ret
    }
    if reflection.synth_reflection_builtin(eng, id, name, args) {
        ret
    }
    if name.eq("trap") {
        if args.len != 0 { db.type_error(id, "@trap expects no arguments") }
        db.bind_type(slot, type_defs.ty_id_unit())
        ret
    }
    if name.eq("memcpy") {
        if args.len != 3 { db.type_error(id, "@memcpy expects destination, source and byte count") }
        bytes := db.types.alloc_ptr(db.types.alloc_uint(8))
        type_common.check_value(db, args.ptr[0], bytes)
        type_common.check_value(db, args.ptr[1], bytes)
        type_common.check_value(db, args.ptr[2], db.types.alloc_uint(64))
        db.bind_type(slot, type_defs.ty_id_unit())
        ret
    }
    if name.eq(Str.of("sizeof")) {
        if args.len != 1 {
            printf(
                "\n\033[1;31m[type error]\033[0m @sizeof expects exactly 1 argument\n       --> "
                .{}
            )
            db.print_loc(id)
            print("")
            #fall
        }
        arg_node := *(args.ptr + 0)
        target_ty := synth_type_node(eng, arg_node)
        if target_ty == type_defs.ty_id_none() {
            printf(
                "\n\033[1;31m[type error]\033[0m @sizeof argument must be a type\n       --> "
                .{}
            )
            db.print_loc(arg_node)
            print("")
            #fall
        }
        u64_ty := (&(*types_ptr)).alloc_uint(64)
        (&(*db).unify).bind_type(&(*db).types, slot, u64_ty)
        db.set_const_type(id, target_ty)
        db.set_is_const(id, true)
        ret
    }
    if name.eq(Str.of("typeof")) {
        if args.len != 1 {
            printf(
                "\n\033[1;31m[type error]\033[0m @typeof expects exactly 1 argument\n       --> "
                .{}
            )
            db.print_loc(id)
            print("")
            #fall
        }
        arg_node := *(args.ptr + 0)
        tyck.synth_node(eng, arg_node)
        arg_slot := (unify_ptr).get_slot(arg_node)
        arg_ty := type_defs.ty_id_none()
        if arg_slot != slot_none() {
            arg_ty = (unify_ptr).resolve_type_deep(types_ptr, arg_slot)
        }
        if arg_ty == type_defs.ty_id_none() {
            arg_ty = db.get_const_type(arg_node)
        }
        if arg_ty == type_defs.ty_id_none() {
            printf(
                "\n\033[1;31m[type error]\033[0m cannot determine type for @typeof\n       --> "
                .{}
            )
            db.print_loc(arg_node)
            print("")
            #fall
        }
        (&(*db).unify).bind_type(&(*db).types, slot, type_defs.ty_id_type())
        db.set_const_type(id, arg_ty)
        db.set_is_const(id, true)
        ret
    }
    if name.eq(Str.of("is")) {
        if args.len != 2 {
            printf(
                "\n\033[1;31m[type error]\033[0m @is expects exactly 2 arguments (val, Type)\n       --> "
                .{}
            )
            db.print_loc(id)
            print("")
            #fall
        }
        val_node := *(args.ptr + 0)
        ty_node := *(args.ptr + 1)
        tyck.synth_node(eng, val_node)
        target_ty := synth_type_node(eng, ty_node)
        if target_ty == type_defs.ty_id_none() {
            printf(
                "\n\033[1;31m[type error]\033[0m second argument to @is must be a type\n       --> "
                .{}
            )
            db.print_loc(ty_node)
            print("")
            #fall
        }
        (&(*db).unify).bind_type(&(*db).types, slot, type_defs.ty_id_bool())
        db.set_const_type(id, target_ty)
        ret
    }
    if name.eq(Str.of("tag")) {
        if args.len != 1 {
            printf(
                "\n\033[1;31m[type error]\033[0m @tag expects exactly 1 argument\n       --> "
                .{}
            )
            db.print_loc(id)
            print("")
            #fall
        }
        val_node := *(args.ptr + 0)
        tyck.synth_node(eng, val_node)
        u32_ty := (&(*types_ptr)).alloc_uint(32)
        (&(*db).unify).bind_type(&(*db).types, slot, u32_ty)
        ret
    }
    printf("\n\033[1;31m[type error]\033[0m unknown builtin function '@{}'\n       --> ", .{ name })
    db.print_loc(id)
    print("")
    #fall
}

synth_array_type_node :: fn(eng &Engine, id u32) u32 {
    db := &(*eng).nexus
    tbl := &(*db).hir
    types_ptr := &(*db).types
    unify_ptr := &(*db).unify

    len_node := tbl.lhs(id)
    elem_node := tbl.rhs(id)
    elem_ty := synth_type_node(eng, elem_node)
    if elem_ty == type_defs.ty_id_none() {
        printf("\n[type error] invalid array element type\n       --> ", .{})
        db.print_loc(elem_node)
        print("")
        #fall
    }
    tyck.synth_node(eng, len_node)
    len_val := eval_const(db, len_node)
    if len_val == 0 {
        if tbl.kind(len_node) == hir.hir_kind.ident {
            sym := db.get_hir_symbol(len_node)
            if sym != id_none() {
                real_s := db.resolve_sym(sym)
                s_hir := db.get_sym_hir(real_s)
                if (db.sym_tok_start(real_s) == id_none()) or
                    ((s_hir != id_none()) and (tbl.kind(s_hir) == hir.hir_kind.arg)) {
                    s := unify_ptr.tmp_slot()
                    inf_ty := types_ptr.alloc_infer(s)
                    db.set_const_type(id, inf_ty)
                    ret inf_ty
                }
            }
        }
        printf("\n[type error] array length must be a constant integer > 0\n       --> ", .{})
        db.print_loc(len_node)
        print("")
        #fall
    }
    arr_ty := types_ptr.alloc_array(elem_ty, len_val as u32)
    db.set_const_type(id, arr_ty)
    slot := unify_ptr.get_slot(id)
    if slot == slot_none() {
        slot = unify_ptr.new_slot(id)
    }
    unify_ptr.bind_type(types_ptr, slot, type_defs.ty_id_type())
    arr_ty
}

synth_array_type :: fn(eng &Engine, id u32) {
    synth_array_type_node(eng, id)
}

synth_array_init :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    types_ptr := &(*db).types
    unify_ptr := &(*db).unify

    list_id := tbl.lhs(id)
    arr_slot := unify_ptr.new_slot(id)
    elem_slot := unify_ptr.tmp_slot()
    elem_infer_ty := types_ptr.alloc_infer(elem_slot)

    if list_id == hir.hir_none() {
        arr_ty := types_ptr.alloc_array(elem_infer_ty, 0)
        unify_ptr.bind_type(types_ptr, arr_slot, arr_ty)
        db.set_const_type(id, arr_ty)
        ret
    }
    elements := db.get_list(list_id)
    len := elements.len as u32
    i: u64 = 0
    while i < elements.len {
        elem_node := *(elements.ptr + i)
        tyck.synth_node(eng, elem_node)
        e_slot := unify_ptr.get_slot(elem_node)
        if e_slot != slot_none() {
            unify_ptr.union(types_ptr, elem_slot, e_slot)
        }
        i = i + 1
    }

    arr_ty := types_ptr.alloc_array(elem_infer_ty, len)
    unify_ptr.bind_type(types_ptr, arr_slot, arr_ty)
    db.set_const_type(id, arr_ty)
}

synth_index :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    types_ptr := &(*db).types
    unify_ptr := &(*db).unify

    lhs := tbl.lhs(id)
    idx := tbl.rhs(id)
    tyck.synth_node(eng, lhs)
    tyck.synth_node(eng, idx)

    idx_slot := unify_ptr.get_slot(idx)
    idx_ty := unify_ptr.resolve_type(idx_slot)
    idx_k := types_ptr.kind(idx_ty)
    if (idx_k != type_defs.TyKind.int) and (idx_k != type_defs.TyKind.uint) and
        (idx_k != type_defs.TyKind.untyped_int) and
        (idx_k != type_defs.TyKind.infer) {
        printf("\n[type error] array index must be an integer\n       --> ", .{})
        db.print_loc(idx)
        print("")
        #fall
    }
    if (idx_k == type_defs.TyKind.untyped_int) or (idx_k == type_defs.TyKind.infer) {
        unify_ptr.bind_type(types_ptr, idx_slot, types_ptr.alloc_uint(64))
    }
    lhs_slot := unify_ptr.get_slot(lhs)
    lhs_ty := unify_ptr.resolve_type(lhs_slot)
    if (lhs_ty == type_defs.ty_id_none()) or (types_ptr.kind(lhs_ty) == type_defs.TyKind.infer) {
        lhs_ty = unify_ptr.resolve_type_deep(types_ptr, lhs_slot)
    }
    if lhs_ty == type_defs.ty_id_none() {
        lhs_ty = db.get_node_type(lhs)
    }
    if lhs_ty == type_defs.ty_id_none() {
        lhs_ty = db.get_const_type(lhs)
    }
    k := types_ptr.kind(lhs_ty)
    if k == type_defs.TyKind.array {
        elem_ty := types_ptr.get_array_type(lhs_ty)
        arr_len := types_ptr.get_array_len(lhs_ty)
        if db.has_const_val(idx) or (tbl.kind(idx) == hir.hir_kind.lit_int) {
            idx_val := eval_const(db, idx)
            if idx_val >= (arr_len as u64) {
                printf("\n[type error] array index out of bounds\n       --> ", .{})
                db.print_loc(idx)
                print("")
                #fall
            }
        }
        res_slot := unify_ptr.new_slot(id)
        if types_ptr.kind(elem_ty) == type_defs.TyKind.infer {
            elem_s := types_ptr.infer_slot(elem_ty)
            unify_ptr.union(types_ptr, res_slot, elem_s)
        } else {
            unify_ptr.bind_type(types_ptr, res_slot, elem_ty)
        }
        db.set_const_type(id, elem_ty)
        ret
    }
    if k == type_defs.TyKind.ptr {
        elem_ty := types_ptr.payload(lhs_ty)
        res_slot := unify_ptr.new_slot(id)
        unify_ptr.bind_type(types_ptr, res_slot, elem_ty)
        db.set_const_type(id, elem_ty)
        ret
    }
    t := lhs_ty
    while types_ptr.kind(t) == type_defs.TyKind.nominal {
        t = types_ptr.nominal_base(t)
    }
    if types_ptr.kind(t) == type_defs.TyKind.struct_ {
        ptr_name := db.interner.intern(Str.of("ptr"))
        fields := types_ptr.get_struct_fields(t)
        count := fields.len / 2
        found_elem_ty := type_defs.ty_id_none()
        f_i: u64 = 0
        while f_i < count {
            f_name := *(fields.ptr + (f_i * 2))
            if f_name == ptr_name {
                f_ty := *(fields.ptr + (f_i * 2) + 1)
                if types_ptr.kind(f_ty) == type_defs.TyKind.ptr {
                    found_elem_ty = types_ptr.payload(f_ty)
                    break
                }
            }
            f_i = f_i + 1
        }
        if found_elem_ty != type_defs.ty_id_none() {
            res_slot := unify_ptr.new_slot(id)
            unify_ptr.bind_type(types_ptr, res_slot, found_elem_ty)
            db.set_const_type(id, found_elem_ty)
            ret
        }
    }
    printf("\n[type error] cannot index non-array type\n       --> ", .{})
    db.print_loc(lhs)
    print("")
    #fall
}

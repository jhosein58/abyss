import HirTable, hir_kind, hir_none from "../hir"
import TypeStorage, TyKind, ty_id_none, ty_id_type from "../types"
import slot_none from "../unify"
import id_none from "../nexus/pool"
import fall from "std/sys"
import Str from "std/string"
import token, TokenStream from "../token"
import lex from "../lexer"
import Parser_new, is_eof, peek, bump from "../parser/core"
import parse_expr from "../parser/parser"
import check_separator from "../parser/handlers/common"
import Engine from "../engine"
import synth_func, synth_return, synth_call from "./rules/fn"
import resolve_ty_id from "./specialize"
import synth_lit_int, synth_lit_float, synth_lit_bool, synth_lit_str, synth_lit_char, synth_lit_cstr from "./rules/lit"
import synth_ident, synth_var_or_binding, synth_arg, synth_destructure from "./rules/var"
import synth_unary_num, validate_unary_num, synth_unary_not, synth_unary_addr_of, synth_unary_deref,
       synth_binary, synth_assign, synth_binary_comp, validate_binary_comp,
       synth_logic_and_or, synth_cast from "./rules/op"
import synth_block, synth_if, synth_while, synth_for, synth_break_cont, synth_match, prepare_match_bindings from "./rules/control"
import synth_struct, synth_struct_init, synth_member from "./rules/struct"
import macro_template, reflection_read from "./reflection"
import synth_builtin_call from "./rules/builtin"
import synth_enum from "./rules/enum"
import synth_array_type, synth_array_init, synth_index from "./rules/array"
import eval_const from "../lower"

synth_node :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    db.set_type_error_origin(id)
    tbl := &(*db).hir
    k := hir_kind
    curr := (tbl).kind(id)

    if curr == k.lit_int       { synth_lit_int(db, tbl, id) }
    if curr == k.ident         { synth_ident(eng, id) }
    if curr == k.var           { synth_var_or_binding(eng, id) }
    if curr == k.destructure   { synth_destructure(eng, id) }
    if curr == k.binding       { synth_var_or_binding(eng, id) }
    if curr == k.arg           { synth_arg(db, tbl, id) }
    if curr == k.function      { synth_func(eng, id) }
    if curr == k.k_ret         { synth_return(db, tbl, id) }
    if curr == k.call          { synth_call(eng, id) }
    if curr == k.builtin_call  { synth_builtin_call(eng, id) }
    if curr == k.block         { synth_block(db, tbl, id) }
    if curr == k.binary_assign { synth_assign(db, tbl, id) }

    if curr == k.lit_float      { synth_lit_float(db, tbl, id) }
    if (curr == k.lit_bool_true) or (curr == k.lit_bool_false) { synth_lit_bool(db, tbl, id) }
    if curr == k.lit_str        { synth_lit_str(eng, id) }
    if curr == k.lit_char       { synth_lit_char(db, tbl, id) }
    if curr == k.lit_cstr       { synth_lit_cstr(db, tbl, id) }

    if (curr == k.unary_neg) or (curr == k.unary_bit_not) {
        synth_unary_num(db, tbl, id)
        validate_unary_num(db, tbl, id)
    }
    if curr == k.unary_not      { synth_unary_not(db, tbl, id) }
    if curr == k.unary_addr_of  { synth_unary_addr_of(db, tbl, id) }
    if curr == k.unary_deref    { synth_unary_deref(db, tbl, id) }
    if (curr == k.k_break) or (curr == k.k_cont) { synth_break_cont(db, tbl, id) }

    if curr == k.k_if           { synth_if(db, tbl, id) }
    if curr == k.k_while        { synth_while(db, tbl, id) }
    if curr == k.k_for          { synth_for(eng, id) }
    if curr == k.k_match        { synth_match(eng, id) }

    if curr == k.cast           { synth_cast(eng, id) }

    if curr == k.struct_        { synth_struct(eng, id) }
    if curr == k.struct_init    { synth_struct_init(db, tbl, id) }
    if curr == k.enum_          { synth_enum(eng, id) }
    if curr == k.member         { synth_member(eng, id) }

    if (curr == k.binary_and) or (curr == k.binary_or) { synth_logic_and_or(db, tbl, id) }

    if (curr == k.binary_add) or (curr == k.binary_sub) or
        (curr == k.binary_mul) or (curr == k.binary_div) or
        (curr == k.binary_mod) or (curr == k.binary_bit_and) or
        (curr == k.binary_bit_or) or (curr == k.binary_bit_xor) or
        (curr == k.binary_shl) or (curr == k.binary_shr) {
        synth_binary(db, tbl, id)
    }

    if (curr == k.binary_eq_eq) or (curr == k.binary_neq) or
       (curr == k.binary_lt) or (curr == k.binary_lt_eq) or
       (curr == k.binary_gt) or (curr == k.binary_gt_eq) {
        synth_binary_comp(db, tbl, id)
        validate_binary_comp(db, tbl, id)
    }

    if curr == k.k_cmpt {
        synth_cmpt(eng, id)
    }

    if curr == k.k_macro {
        synth_macro(eng, id)
    }

    if curr == k.array_init { synth_array_init(eng, id) }
    if curr == k.index      { synth_index(eng, id) }
    if curr == k.array      { synth_array_type(eng, id) }
}

synth_macro :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    types_ptr := &(*db).types
    unify_ptr := &(*db).unify

    child := tbl.lhs(id)
    tbl.set_rhs(id, hir_none())
    tbl.set_extra(id, hir_none())
    slot := unify_ptr.new_slot(id)

    synth_node(eng, child)
    child_ty := db.get_node_type(child)
    str_ty := eng.get_str_type()
    if (db.types.kind(child_ty) == TyKind.unit) and (tbl.kind(child) == hir_kind.call) {
        callee := tbl.lhs(child)
        sym := db.get_hir_symbol(callee)
        if (sym != id_none()) and (macro_template(db, sym) != hir_none()) {
            tbl.set_rhs(id, 1)
            tbl.set_extra(id, child)
            unify_ptr.bind_type(types_ptr, slot, child_ty)
            ret
        }
    }
    if (child_ty != ty_id_none()) and (str_ty != ty_id_none()) and (child_ty != str_ty) and (tbl.kind(child) != hir_kind.lit_str) {
        print(c"\n[type error] macro expression must evaluate to Str\n       --> ")
        db.print_loc(id)
        print(c"\n")
        fall()
    }
    val := eval_const(db, child)
    if val == 0 {
        ret
    }

    buf_ptr := reflection_read(db, val, str_ty, "ptr") as &u8
    buf_len := reflection_read(db, val, str_ty, "len")

    if buf_len == 0 {
        ret
    }
    macro_src := Str.new(buf_ptr, buf_len)

    tokens := TokenStream.new()
    lex(&tokens, macro_src, Str.of("<macro>"))
    tok_count := tokens.count() as u32
    if tok_count > 1 {
        tok_count = tok_count - 1
    }
    fid := db.get_hir_file(id)
    sub_p := Parser_new(db, &tokens, tbl, fid, 0, 0, tok_count)
    fn_start: u32 = 0
    s_idx := id
    while s_idx > 0 {
        s_idx = s_idx - 1
        if tbl.kind(s_idx) == hir_kind.function {
            fn_start = s_idx
            break
        }
    }
    if fn_start != 0 {
        params_id := tbl.lhs(fn_start)
        if params_id != hir_none() {
            params := db.get_list(params_id)
            p_i: u64 = 0
            while p_i < params.len {
                arg_node := *(params.ptr + p_i)
                if tbl.kind(arg_node) == hir_kind.arg {
                    ident_node := tbl.lhs(arg_node)
                    if tbl.kind(ident_node) == hir_kind.ident {
                        name_id := tbl.lhs(ident_node)
                        sym_id := db.get_hir_symbol(arg_node)
                        if sym_id != id_none() {
                            sub_p.env.define(name_id, sym_id)
                        }
                    }
                }
                p_i = p_i + 1
            }
        }
    }
    n := fn_start
    while n < id {
        nk := tbl.kind(n)
        if (nk == hir_kind.var) or (nk == hir_kind.binding) or (nk == hir_kind.arg) {
            ident_node := tbl.lhs(n)
            if tbl.kind(ident_node) == hir_kind.ident {
                name_id := tbl.lhs(ident_node)
                sym_id := db.get_hir_symbol(n)
                if sym_id != id_none() {
                    sub_p.env.define(name_id, sym_id)
                }
            }
        }
        n = n + 1
    }

    node_start := tbl.len()
    first_node := parse_expr(&sub_p, 0 as u8)
    check_separator(&sub_p, token.eof, c"expected ',' or newline between macro expressions")
    if not is_eof(&sub_p) {
        glob_stack := &db.glob_stack
        mark := glob_stack.mark()
        glob_stack.push(first_node)
        while not is_eof(&sub_p) {
            glob_stack.push(parse_expr(&sub_p, 0 as u8))
            check_separator(&sub_p, token.eof, c"expected ',' or newline between macro expressions")
        }
        slice: Slice(u32) = .{
            ptr: glob_stack.ptr_at(mark),
            len: glob_stack.len - mark
        }
        list_id := db.add_list(slice)
        glob_stack.reset(mark)
        node := tbl.push(hir_kind.block, list_id, hir_none(), hir_none())
        first_node = node
    }
    parsed_node := first_node
    node_end := tbl.len()
    sub_p.env.destroy()
    tokens.destroy()

    if parsed_node == hir_none() {
        print(c"\n[syntax error] macro expansion produced no expression\n       --> ")
        db.print_loc(id)
        print(c"\n")
        fall()
    }

    if parsed_node != hir_none() {
        tbl.set_extra(id, parsed_node)
        macro_sp := db.get_hir_span(id)
        prepare_match_bindings(eng, node_start, node_end)
        m_idx := node_start
        while m_idx < node_end {
            sp := db.get_hir_span(m_idx)
            if (sp.start == 0) and (sp.end == 0) {
                db.set_hir_span(m_idx, macro_sp.start, macro_sp.end)
                db.set_hir_file(m_idx, fid)
            }
            synth_node(eng, m_idx)
            m_idx = m_idx + 1
        }
        parsed_slot := unify_ptr.get_slot(parsed_node)
        if parsed_slot != slot_none() {
            unify_ptr.union(types_ptr, slot, parsed_slot)
        }
        p_ty := db.get_const_type(parsed_node)
        if p_ty != ty_id_none() {
            db.set_const_type(id, p_ty)
            unify_ptr.bind_type(types_ptr, slot, ty_id_type())
            db.set_const_val(id, p_ty as u64)
            db.set_is_const(id, true)
        }
        if db.has_const_val(parsed_node) {
            db.set_const_val(id, db.get_const_val(parsed_node))
        }
        if db.is_const(parsed_node) {
            db.set_is_const(id, true)
        }
    }
}

synth_cmpt :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    types_ptr := &(*db).types
    unify_ptr := &(*db).unify

    child := tbl.lhs(id)
    slot := unify_ptr.new_slot(id)
    child_slot := unify_ptr.get_slot(child)
    if child_slot != slot_none() {
        unify_ptr.union(types_ptr, slot, child_slot)
    }

    db.set_is_const(id, true)

    child_ty_val := db.get_const_type(child)
    if (child_ty_val != ty_id_none()) and (db.get_node_type(child) == ty_id_type()) {
        db.set_const_type(id, child_ty_val)
        unify_ptr.bind_type(types_ptr, slot, ty_id_type())
        db.set_const_val(id, child_ty_val as u64)
        ret
    }

    val := eval_const(db, child)
    db.set_const_val(id, val)
    resolved_ty := unify_ptr.resolve_type(slot)
    if resolved_ty == ty_id_type() {
        db.set_const_type(id, val as u32)
    }
}

type_check :: fn(eng &Engine, start u32, len u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    k := hir_kind
    prepare_match_bindings(eng, start, len)
    i := start
    while i < len {
        curr := (tbl).kind(i)
        synth_node(eng, i)
        if curr == k.function {
            func_ty := db.get_const_type(i)
            if (func_ty != ty_id_none()) and (&(*db).types).func_has_type_param(func_ty) {
                body := (tbl).extra(i)
                if (body != hir_none()) and (body >= i) {
                    i = body + 1
                    cont
                }
            }
        }
        i = i + 1
    }
}

print :: fn(s &u8)

vec_contains :: fn(v &Vec(u32), val u32) bool {
    i: u64 = 0
    while i < (*v).len {
        if v.get(i) == val { ret true }
        i = i + 1
    }
    false
}

type_has_infer :: fn(types &TypeStorage, ty_id u32) bool {
    visited := Vec(u32).new()
    result := type_has_infer_seen(types, ty_id, &visited)
    visited.destroy()
    result
}

type_has_infer_seen :: fn(types &TypeStorage, ty_id u32, visited &Vec(u32)) bool {
    if ty_id == ty_id_none() { ret true }
    if vec_contains(visited, ty_id) { ret false }
    visited.push(ty_id)
    kind := types.kind(ty_id)
    if (kind == TyKind.infer) or (kind == TyKind.unknown) or (kind == TyKind.error) { ret true }
    if (kind == TyKind.struct_) or (kind == TyKind.nominal) {
        if kind == TyKind.nominal {
            origin := types.nominal_origin(ty_id)
            creator_args := types.get_nominal_creator_args(origin)
            i: u64 = 0
            while i < creator_args.len {
                if type_has_infer_seen(types, *(creator_args.ptr + i), visited) { ret true }
                i = i + 1
            }
        }
        fields := types.get_struct_fields(ty_id)
        i: u64 = 0
        while i < fields.len / 2 {
            if type_has_infer_seen(types, *(fields.ptr + i * 2 + 1), visited) { ret true }
            i = i + 1
        }
    } else if kind == TyKind.ptr {
        ret type_has_infer_seen(types, types.payload(ty_id), visited)
    } else if kind == TyKind.array {
        ret type_has_infer_seen(types, types.get_array_type(ty_id), visited)
    } else if kind == TyKind.func {
        if type_has_infer_seen(types, types.func_return(ty_id), visited) { ret true }
        params := types.func_params(ty_id)
        i: u64 = 0
        while i < params.len {
            if type_has_infer_seen(types, *(params.ptr + i), visited) { ret true }
            i = i + 1
        }
    } else if kind == TyKind.union_ {
        members := types.union_members(ty_id)
        i: u64 = 0
        while i < members.len {
            if type_has_infer_seen(types, *(members.ptr + i), visited) { ret true }
            i = i + 1
        }
    }
    false
}

finalize_inferred_types :: fn(eng &Engine, func_id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    body := tbl.extra(func_id)
    if body == hir_none() { ret }
    skipped := Vec(u32).new()
    scan := func_id + 1
    while scan <= body {
        if tbl.kind(scan) == hir_kind.function {
            fn_ty := db.get_const_type(scan)
            if (&(*db).types).func_has_type_param(fn_ty) {
                nested_body := tbl.extra(scan)
                params := db.get_list(tbl.lhs(scan))
                first := *(params.ptr + 0)
                start := tbl.lhs(first)
                if start == hir_none() { start = tbl.rhs(first) }
                if nested_body != hir_none() {
                    skipped.push(start)
                    skipped.push(nested_body)
                }
            }
        }
        scan = scan + 1
    }
    node := func_id + 1
    while node <= body {
        skip_i: u64 = 0
        while skip_i < skipped.len {
            start := skipped.get(skip_i)
            end := skipped.get(skip_i + 1)
            if (node >= start) and (node <= end) {
                node = end + 1
            }
            skip_i = skip_i + 2
        }
        if node > body { break }
        slot := (&(*db).unify).get_slot(node)
        if slot != slot_none() {
            ty := (&(*db).unify).resolve_type(slot)
            if (ty != ty_id_none()) and (not (&(*db).types).func_has_type_param(ty)) {
                resolved := resolve_ty_id(eng, &(*db).unify, &(*db).types, ty)
                if type_has_infer(&(*db).types, resolved) {
                    print(c"\n[type error] cannot infer generic type argument; pass the type explicitly\n       --> ")
                    db.print_loc(node)
                    print(c"\n")
                    fall()
                }
                root := (&(*db).unify).find(slot)
                (*db).unify.types.set(root as u64, resolved)
            }
        }
        value_ty := db.get_const_type(node)
        if (value_ty != ty_id_none()) and (not (&(*db).types).func_has_type_param(value_ty)) {
            resolved := resolve_ty_id(eng, &(*db).unify, &(*db).types, value_ty)
            if type_has_infer(&(*db).types, resolved) {
                print(c"\n[type error] cannot infer generic type argument; pass the type explicitly\n       --> ")
                db.print_loc(node)
                print(c"\n")
                fall()
            }
            db.set_const_type(node, resolved)
        }
        if db.has_union_coerce(node) {
            target := db.get_union_coerce_ty(node)
            members := db.types.union_members(target)
            member := *(members.ptr + (db.get_union_coerce_idx(node) as u64))
            resolved_member := resolve_ty_id(eng, &db.unify, &db.types, member)
            resolved_target := resolve_ty_id(eng, &db.unify, &db.types, target)
            if db.types.kind(resolved_target) == TyKind.union_ {
                idx := db.types.union_member_index(resolved_target, resolved_member)
                db.set_union_coerce(node, resolved_target, idx)
            } else {
                db.set_union_coerce(node, ty_id_none(), 0)
            }
        }
        node = node + 1
    }
    skipped.destroy()
}

tyck_mono_function :: fn(eng &Engine, sym_id u32) {
    db := &eng.nexus
    tbl := &db.hir

    orig_sym := db.get_mono_orig_sym(sym_id)
    mono_func_ty := db.get_mono_type(sym_id)
    real_sym := db.resolve_sym(orig_sym)

    func_id := db.get_fn_node(real_sym)
    if func_id == id_none() { ret }
    if tbl.kind(func_id) != hir_kind.function { ret }
    if mono_func_ty == ty_id_none() { ret }

    orig_func_ty := db.get_const_type(func_id)
    saved_orig_ty := orig_func_ty
    if orig_func_ty == ty_id_none() {
        orig_func_ty = mono_func_ty
    }

    struct_ty := ty_id_none()
    mono_params := db.types.func_params(mono_func_ty)
    if mono_params.len > 0 {
        p0 := *(mono_params.ptr + 0)
        while db.types.kind(p0) == TyKind.ptr {
            p0 = db.types.payload(p0)
        }
        if db.types.kind(p0) == TyKind.nominal {
            s_origin := db.types.nominal_origin(p0)
            if db.types.get_nominal_creator_sym(s_origin) != ty_id_none() {
                struct_ty = p0
            }
        }
    }
    if struct_ty == ty_id_none() {
        r0 := db.types.func_return(mono_func_ty)
        while db.types.kind(r0) == TyKind.ptr {
            r0 = db.types.payload(r0)
        }
        if db.types.kind(r0) == TyKind.nominal {
            s_origin := db.types.nominal_origin(r0)
            if db.types.get_nominal_creator_sym(s_origin) != ty_id_none() {
                struct_ty = r0
            }
        }
    }

    if struct_ty != ty_id_none() {
        s_origin := (&(*db).types).nominal_origin(struct_ty)
        creator_sym := (&(*db).types).get_nominal_creator_sym(s_origin)
        creator_args := (&(*db).types).get_nominal_creator_args(s_origin)
        struct_node := (&(*db).types).get_nominal_struct_node(s_origin)
        if struct_node != ty_id_none() {
            db.set_const_type(struct_node, struct_ty)
        }
        creator_fn := db.get_fn_node(creator_sym)
        if creator_fn != id_none() {
            c_p_list := (tbl).lhs(creator_fn)
            if c_p_list != hir_none() {
                source_params := db.get_list(c_p_list)
                p_i: u64 = 0
                while p_i < source_params.len {
                    if p_i < creator_args.len {
                        p_arg := *(source_params.ptr + p_i)
                        p_ident := (tbl).lhs(p_arg)
                        arg_val := *(creator_args.ptr + p_i)
                        if p_ident != hir_none() {
                            type_slot := (&(*db).unify).new_slot(p_ident)
                            (&(*db).unify).bind_type(&(*db).types, type_slot, ty_id_type())
                            db.set_const_type(p_ident, arg_val)
                        }
                        db.set_const_type(p_arg, arg_val)
                    }
                    p_i = p_i + 1
                }
            }
        }
    }

    orig_params := (&(*db).types).func_params(orig_func_ty)
    args_list_id := (tbl).lhs(func_id)
    has_type_param := false
    orig_p_vec := Vec(u32).new()
    if args_list_id != hir_none() {
        fn_args := db.get_list(args_list_id)
        p_idx: u64 = 0
        while (p_idx < orig_params.len) or (p_idx < mono_params.len) {
            if (p_idx < fn_args.len) and (p_idx < mono_params.len) {
                arg_node := *(fn_args.ptr + p_idx)
                arg_ident := (tbl).lhs(arg_node)
                concrete_p_ty := *(mono_params.ptr + p_idx)
                is_type_param := false
                if p_idx < orig_params.len {
                    if *(orig_params.ptr + p_idx) == ty_id_type() {
                        is_type_param = true
                    }
                }
                arg_ty_node := (tbl).rhs(arg_node)
                if (not is_type_param) and (arg_ty_node != hir_none()) and ((tbl).kind(arg_ty_node) == hir_kind.ident) {
                    type_name_id := (tbl).lhs(arg_ty_node)
                    if db.interner.get(type_name_id).eq(Str.of("type")) {
                        is_type_param = true
                    }
                }
                if is_type_param {
                    has_type_param = true
                    orig_p_vec.push(ty_id_type())
                    type_slot := (&(*db).unify).new_slot(arg_ident)
                    (&(*db).unify).bind_type(&(*db).types, type_slot, ty_id_type())
                    db.set_const_type(arg_ident, concrete_p_ty)
                } else {
                    orig_p_vec.push(concrete_p_ty)
                    p_slot := (&(*db).unify).new_slot(arg_ident)
                    (&(*db).unify).bind_type(&(*db).types, p_slot, concrete_p_ty)
                    db.set_const_type(arg_ident, concrete_p_ty)
                    if tbl.extra(arg_node) == 1 {
                        value := db.const_param_value(mono_func_ty, p_idx as u32)
                        db.set_const_val(arg_ident, value)
                        db.set_is_const(arg_ident, true)
                        param_sym := db.get_hir_symbol(arg_ident)
                        if param_sym != id_none() { db.set_sym_is_const(param_sym, true) }
                    }
                }
            }
            p_idx = p_idx + 1
        }
    }
    if has_type_param {
        orig_func_ty = (&(*db).types).alloc_func(orig_p_vec.as_slice(), (&(*db).types).func_return(mono_func_ty), false)
    }
    orig_p_vec.destroy()

    db.set_const_type(func_id, mono_func_ty)

    body_id := (tbl).extra(func_id)
    if body_id != hir_none() {
        n := func_id + 1
        while n <= body_id {
            db.set_const_type(n, ty_id_none())
            db.set_const_val(n, 0)
            db.set_is_const(n, false)
            db.set_union_coerce(n, ty_id_none(), 0)
            (&(*db).unify).new_slot(n)
            n = n + 1
        }
        m_ret := db.types.func_return(mono_func_ty)
        if db.types.kind(m_ret) == TyKind.array {
            arr_len := db.types.get_array_len(m_ret)
            ret_hir_id := (tbl).rhs(func_id)
            if (ret_hir_id != hir_none()) and ((tbl).kind(ret_hir_id) == hir_kind.array) {
                len_node := (tbl).lhs(ret_hir_id)
                if (tbl).kind(len_node) == hir_kind.ident {
                    p_name := (tbl).lhs(len_node)
                    if args_list_id != hir_none() {
                        fn_args := db.get_list(args_list_id)
                        p_i: u64 = 0
                        while p_i < fn_args.len {
                            arg_node := *(fn_args.ptr + p_i)
                            arg_ident := (tbl).lhs(arg_node)
                            if (arg_ident != hir_none()) and ((tbl).lhs(arg_ident) == p_name) {
                                db.set_const_val(arg_ident, arr_len as u64)
                                db.set_const_val(arg_node, arr_len as u64)
                                db.set_is_const(arg_ident, true)
                                db.set_is_const(arg_node, true)
                            }
                            p_i = p_i + 1
                        }
                    }
                }
            }
        }
        type_check(eng, func_id + 1, body_id + 1)
    }

    finalize_inferred_types(eng, func_id)

    if has_type_param {
        db.set_const_type(func_id, orig_func_ty)
    } else if (saved_orig_ty != ty_id_none()) and (&(*db).types).func_has_type_param(saved_orig_ty) {
        db.set_const_type(func_id, saved_orig_ty)
    }
}

import Nexus from "../nexus/nexus.a"
import HirTable, hir_kind, hir_none from "../hir.a"
import Str from "../../std/string.a"
import SliceU32 from "../../std/slice/u32.a"
import VecU32 from "../../std/vec/u32.a"

import TypeStorage, ty_kind, ty_id_none, ty_id_type, ty_id_unit, ty_id_untyped_int, ty_id_unknown, ty_id_never, ty_id_untyped_float, ty_id_bool from "../types.a"

import UnifyStorage, slot_none from "../unify.a"
import id_none from "../nexus/pool.a"

import Engine from "../engine.a"

import fall from "../../std/sys.a"

print :: (s &u8) unit
print_u32 :: (v u32) unit

str_eq :: (a Str, b Str) bool {
    if a.len != b.len { ret false }
    i: u64 = 0
    while i < a.len {
        if *(a.ptr + i) != *(b.ptr + i) { ret false }
        i = i + 1
    }
    true
}

parse_builtin_type :: (types &TypeStorage, name Str) u32 {
    if str_eq(name, Str.of("bool")) { ret TypeStorage.alloc_bool() }
    if str_eq(name, Str.of("unit")) { ret TypeStorage.alloc_unit() }

    if name.len < 2 { ret ty_id_none() }

    first := *(name.ptr)
    if (first != 105) and (first != 117) and (first != 102) {
        ret ty_id_none()
    }

    bits: u32 = 0
    i: u64 = 1
    while i < name.len {
        c := *(name.ptr + i)
        if (c < 48) or (c > 57) { ret ty_id_none() }
        bits = (bits * 10) + ((c - 48) as u32)
        i = i + 1
    }

    if (bits != 8) and (bits != 16) and (bits != 32) and (bits != 64) and (bits != 128) {
        ret ty_id_none()
    }

    if (first == 102) and (bits != 32) and (bits != 64) {
        ret ty_id_none()
    }

    if first == 105 { ret (&(*types)).alloc_int(bits as u16) }
    if first == 117 { ret (&(*types)).alloc_uint(bits as u16) }
    if first == 102 { ret (&(*types)).alloc_float(bits as u16) }

    ty_id_none()
}

type_check :: (eng &Engine, start u32, len u32) {
    i := start
    while i < len {
        synth_node(eng, i)
        i = i + 1
    }
}

method_has_receiver :: (db &Nexus, method u32) bool {
    tbl := &(*db).hir
    node := (tbl).lhs(method)
    while node < method {
        if ((tbl).kind(node) == hir_kind().member) and
           ((tbl).lhs(node) == hir_none()) {
            ret true
        }
        node = node + 1
    }
    false
}

synth_node :: (eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    k := hir_kind()
    curr := (tbl).kind(id)

    if curr == k.lit_int       { synth_lit_int(db, tbl, id) }
    if curr == k.ident         { synth_ident(eng, id) }
    if curr == k.var           { synth_var_or_binding(db, tbl, id) }
    if curr == k.binding       { synth_var_or_binding(db, tbl, id) }
    if curr == k.arg           { synth_arg(db, tbl, id) }
    if curr == k.function      { synth_func(eng, id) }
    if curr == k.k_ret         { synth_return(db, tbl, id) }
    if curr == k.call          { synth_call(db, tbl, id) }
    if curr == k.block         { synth_block(db, tbl, id) }
    if curr == k.binary_assign { synth_assign(db, tbl, id) }

    if curr == k.lit_float      { synth_lit_float(db, tbl, id) }
    if (curr == k.lit_bool_true) or (curr == k.lit_bool_false) { synth_lit_bool(db, tbl, id) }
    if curr == k.lit_str        { synth_lit_str(db, tbl, id) }

    if (curr == k.unary_neg) or (curr == k.unary_bit_not) {
        synth_unary_num(db, tbl, id)
        validate_unary_num(db, tbl, id)
    }
    if curr == k.unary_not      { synth_unary_not(db, tbl, id) }
    if curr == k.unary_addr_of  { synth_unary_addr_of(db, tbl, id) }
    if curr == k.unary_deref    { synth_unary_deref(db, tbl, id) }
    if (curr == k.k_break) or (curr == k.k_cont) { synth_break_cont(db, tbl, id) }

    if curr == k.k_if           { synth_if(db, tbl, id) }
    if curr == k.k_while        { synth_while(db, tbl, id) }

    if curr == k.cast           { synth_cast(db, tbl, id) }

    if curr == k.struct_        { synth_struct(eng, id) }
    if curr == k.struct_init    { synth_struct_init(db, tbl, id) }
    if curr == k.member         { synth_member(eng, id) }

    if (curr == k.binary_and) or (curr == k.binary_or) { synth_logic_and_or(db, tbl, id) }

    if (curr == k.binary_add) or (curr == k.binary_sub) or
        (curr == k.binary_mul) or (curr == k.binary_div) or
        (curr == k.binary_mod) or (curr == k.binary_bit_and) or
        (curr == k.binary_bit_or) or (curr == k.binary_bit_xor) or
        (curr == k.binary_shl) or (curr == k.binary_shr) {
        synth_binary(db, tbl, id)
    }

    if (curr == k.binary_eq_eq) or (curr == k.binary_neq) or
       (curr == k.binary_lt) or (curr == k.binary_lt_eq) or
       (curr == k.binary_gt) or (curr == k.binary_gt_eq) {
        synth_binary_comp(db, tbl, id)
        validate_binary_comp(db, tbl, id)
    }
}

synth_lit_int :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)
     (&(*db).unify).bind_type(&(*db).types, slot, ty_id_untyped_int())
}

synth_ident :: (eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    name_id := (tbl).lhs(id)
    name := db.interner.get(name_id)

    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }

    owner := db.get_method_owner(id)
    if (owner != hir_none()) and str_eq(name, Str.of("Self")) {
        self_ty := db.get_const_type(owner)
          if (&(*types_ptr)).kind( self_ty) != ty_kind().nominal {
            print("\n\033[1;31m[type error]\033[0m Self requires a named struct method\n       --> ")
            db.print_loc(id)
            print("\n")
            fall()
        }
          (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
        db.set_const_type(id, self_ty)
        ret
    }

    builtin_ty := parse_builtin_type(types_ptr, name)
    if builtin_ty != ty_id_none() {
         (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
        db.set_const_type(id, builtin_ty)
        ret
    }

    sym_id := db.get_hir_symbol(id)

    if sym_id != id_none() {
        origin_hir := db.get_sym_hir(sym_id)
        if origin_hir == id {
            ret
        }

        origin_slot := eng.slot_of(sym_id)
        if origin_slot != slot_none() {
              (&(*db).unify).union(&(*db).types, slot, origin_slot)
        }

        resolved_hir := db.get_sym_hir(sym_id)
        if resolved_hir != id_none() {
            const_val := db.get_const_type(resolved_hir)
            if const_val != ty_id_none() {
                db.set_const_type(id, const_val)
            }
        }
    }
}

synth_type_node :: (eng &Engine, id u32) u32 {
    if id == hir_none() { ret ty_id_none() }
    db := &(*eng).nexus
    existing := db.get_const_type(id)
    if existing != ty_id_none() { ret existing }

    tbl := &(*db).hir
    k := hir_kind()
    curr := (tbl).kind(id)

    if curr == k.ident {
        synth_ident(eng, id)
        ret db.get_const_type(id)
    }

    if curr == k.unary_addr_of {
        child := (tbl).lhs(id)
        child_ty := synth_type_node(eng, child)
        if child_ty != ty_id_none() {
            ptr_ty := (&(*db).types).alloc_ptr(child_ty)
            db.set_const_type(id, ptr_ty)
            slot := (&(*db).unify).get_slot(id)
            if slot == slot_none() {
                slot = (&(*db).unify).new_slot(id)
            }
            (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
            ret ptr_ty
        }
    }

    synth_node(eng, id)
    db.get_const_type(id)
}

check_value :: (db &Nexus, expr u32, expected u32) {
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types := &(*db).types
    slot := (unify_ptr).get_slot(expr)
    if slot == slot_none() { ret }

    if (tbl).kind(expr) == hir_kind().block {
        items := db.get_list((tbl).lhs(expr))
        if items.len > 0 {
            check_value(db, *(items.ptr + items.len - 1), expected)
            ret
        }
    }

      kind := (&(*types)).kind( expected)
    if ((tbl).kind(expr) == hir_kind().struct_init) and
       ((kind == ty_kind().nominal) or (kind == ty_kind().struct_)) {
          target := (&(*types)).get_struct_fields( expected)
        names := db.get_list((tbl).lhs(expr))
        values := db.get_list((tbl).rhs(expr))
        if (names.len != target.len / 2) or (values.len != names.len) {
            print("\n\033[1;31m[type error]\033[0m struct literal has wrong number of fields for '")
              (&(*types)).print_type( expected)
            print("'\n       --> ")
            db.print_loc(expr)
            print("\n")
            fall()
        }

        i: u64 = 0
        while i < names.len {
              target = (&(*types)).get_struct_fields( expected)
            name_id := (tbl).lhs(*(names.ptr + i))
            field_ty := ty_id_none()
            j: u64 = 0
            while j < target.len / 2 {
                if *(target.ptr + j * 2) == name_id {
                    field_ty = *(target.ptr + j * 2 + 1)
                    break
                }
                j = j + 1
            }
            if field_ty == ty_id_none() {
                print("\n\033[1;31m[type error]\033[0m unexpected field '")
                db.interner.get(name_id).print()
                print("' in struct literal for '")
                  (&(*types)).print_type( expected)
                print("'\n       --> ")
                db.print_loc(*(names.ptr + i))
                print("\n")
                fall()
            }
            check_value(db, *(values.ptr + i), field_ty)
            i = i + 1
        }
        root := unify_ptr.find(slot)
        existing := (unify_ptr).resolve_type(slot)
          if (&(*types)).kind( existing) == ty_kind().nominal {
              (&(*db).unify).bind_type(&(*db).types, slot, expected)
            ret
        }
         (*unify_ptr).types.set(root as u64, expected)
        ret
    }
      (&(*db).unify).bind_type(&(*db).types, slot, expected)
}

synth_var_or_binding :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    ident_id := (tbl).lhs(id)
    type_id  := (tbl).rhs(id)
    value_id := (tbl).extra(id)

    slot := (unify_ptr).new_slot(id)

    ident_slot := (unify_ptr).get_slot(ident_id)
    if ident_slot == slot_none() {
        ident_slot = (unify_ptr).new_slot(ident_id)
    }

    if type_id != hir_none() {
        type_slot := (unify_ptr).get_slot(type_id)
        if type_slot != slot_none() {
              (&(*db).unify).bind_type(&(*db).types, type_slot, ty_id_type())
        }

        type_value := db.get_const_type(type_id)
        if type_value == ty_id_none() {
            print("\n\033[1;31m[type error]\033[0m declaration annotation is not a resolved type\n       --> ")
            db.print_loc(type_id)
            print("\n")
            fall()
        }
          (&(*db).unify).bind_type(&(*db).types, ident_slot, type_value)
        db.set_const_type(ident_id, type_value)
        db.set_const_type(id, type_value)
    }

    if value_id != hir_none() {
        if ((tbl).kind(id) == hir_kind().binding) and ((tbl).kind(value_id) == hir_kind().struct_) {
            structural := db.get_const_type(value_id)
            kind := (&(*types_ptr)).kind(structural)
            if (kind != ty_kind().struct_) and (kind != ty_kind().nominal) {
                print("\n\033[1;31m[type error]\033[0m struct declaration could not be resolved\n       --> ")
                db.print_loc(value_id)
                print("\n")
                fall()
            }
            named := structural
            if kind == ty_kind().struct_ {
                name_id := (tbl).lhs(ident_id)
                name := db.interner.get(name_id)
                named = (&(*types_ptr)).alloc_nominal(structural, name, id)
                db.set_const_type(value_id, named)
            }
            db.set_const_type(ident_id, named)
            db.set_const_type(id, named)
        }
        val_slot := (unify_ptr).get_slot(value_id)
        if val_slot != slot_none() {
            val_ty := (unify_ptr).resolve_type(val_slot)
              if (&(*types_ptr)).kind( val_ty) == ty_kind().type_ {
                type_val := db.get_const_type(value_id)
                if type_val == ty_id_none() {
                    print("\n\033[1;31m[type error]\033[0m type value cannot be resolved\n       --> ")
                    db.print_loc(value_id)
                    print("\n")
                    fall()
                }
                db.set_const_type(ident_id, type_val)
                db.set_const_type(id, type_val)
            }
            if (type_id != hir_none()) and ((tbl).kind(value_id) == hir_kind().struct_init) {
                expected := db.get_const_type(type_id)
                if expected != ty_id_none() { check_value(db, value_id, expected) }
            }
              (&(*db).unify).union(&(*db).types, ident_slot, val_slot)
        }
    }

      (&(*db).unify).union(&(*db).types, slot, ident_slot)
}

synth_arg :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    ident_id := (tbl).lhs(id)
    ty_id    := (tbl).rhs(id)

    ident_slot := (unify_ptr).get_slot(ident_id)
    if ident_slot == slot_none() {
        ident_slot = (unify_ptr).new_slot(ident_id)
    }

    if ty_id != hir_none() {
        type_val := db.get_const_type(ty_id)
        if type_val != ty_id_none() {
              (&(*db).unify).bind_type(&(*db).types, ident_slot, type_val)
            db.set_const_type(ident_id, type_val)
            db.set_const_type(id, type_val)
        }
    }
}
synth_func :: (eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    if db.get_const_type(id) != ty_id_none() {
        ret
    }

    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }

    params_list_id := (tbl).lhs(id)
    ret_hir_id     := (tbl).rhs(id)
    body_id        := (tbl).extra(id)

    is_extern := body_id == hir_none()

    ret_ty := ty_id_unit()
    if ret_hir_id != hir_none() {
        val := synth_type_node(eng, ret_hir_id)
        if val == ty_id_none() {
            print("\n[type error] unresolved return type\n       --> ")
            db.print_loc(ret_hir_id)
            print("\n")
            fall()
        }
        ret_ty = val
    }

    params_vec := VecU32.new()
    if params_list_id != hir_none() {
        args := db.get_list(params_list_id)
        i: u64 = 0
        while i < args.len {
            arg_id := *(args.ptr + i)
            ty_node := (tbl).rhs(arg_id)
            param_ty := ty_id_none()
            if ty_node != hir_none() {
                param_ty = synth_type_node(eng, ty_node)
            }

            if param_ty == ty_id_none() {
                arg_ident := (tbl).lhs(arg_id)
                arg_slot := (unify_ptr).get_slot(arg_ident)
                if arg_slot != slot_none() {
                    param_ty = (unify_ptr).resolve_type(arg_slot)
                }
            }

            if param_ty == ty_id_none() {
                print("\n[type error] unresolved parameter type\n       --> ")
                db.print_loc(arg_id)
                print("\n")
                fall()
            }
            if param_ty == ty_id_unit() {
                print("\n[type error] unit parameters have no runtime representation\n       --> ")
                db.print_loc(arg_id)
                print("\n")
                fall()
            }

            arg_ident := (tbl).lhs(arg_id)
            ident_slot := (unify_ptr).get_slot(arg_ident)
            if ident_slot == slot_none() {
                ident_slot = (unify_ptr).new_slot(arg_ident)
            }
            (&(*db).unify).bind_type(&(*db).types, ident_slot, param_ty)
            db.set_const_type(arg_ident, param_ty)
            db.set_const_type(arg_id, param_ty)

            params_vec.push(param_ty)
            i = i + 1
        }
    }

    slice: SliceU32 = .{ ptr: 0 as &u32, len: 0 }
    if params_vec.len > 0 {
        slice.ptr = params_vec.ptr_at(0)
        slice.len = params_vec.len
    }

    func_ty := (&(*types_ptr)).alloc_func(slice, ret_ty, is_extern)
    params_vec.destroy()

    (&(*db).unify).bind_type(&(*db).types, slot, func_ty)
    db.set_const_type(id, func_ty)

    sym_id := db.get_hir_symbol(id)
    if sym_id != id_none() {
        sym_hir := db.get_sym_hir(sym_id)
        if sym_hir != id_none() {
            sym_slot := (&(*db).unify).get_slot(sym_hir)
            if sym_slot == slot_none() {
                sym_slot = (&(*db).unify).new_slot(sym_hir)
            }
            (&(*db).unify).union(&(*db).types, sym_slot, slot)
            db.set_const_type(sym_hir, func_ty)
        }
    }
}

find_enclosing_method :: (db &Nexus, node_id u32) u32 {
    owner := db.get_method_owner(node_id)
    if owner == hir_none() { ret hir_none() }
    methods_id := (&(*db).hir).extra(owner)
    if methods_id == hir_none() { ret hir_none() }
    methods := db.get_list(methods_id)
    i: u64 = 0
    while i < methods.len {
        m := *(methods.ptr + i)
        start := (&(*db).hir).lhs(m)
        if (node_id >= start) and (node_id <= m) {
            ret m
        }
        i = i + 1
    }
    hir_none()
}

method_returns_ref_self :: (db &Nexus, node_id u32) bool {
    owner := db.get_method_owner(node_id)
    if owner == hir_none() { ret false }
    owner_ty := db.get_const_type(owner)
    if owner_ty == ty_id_none() { ret false }

    method := find_enclosing_method(db, node_id)
    if method == hir_none() { ret false }

    if not method_has_receiver(db, method) { ret false }

    func_id := (&(*db).hir).extra(method)
    if (func_id == hir_none()) or ((&(*db).hir).kind(func_id) != hir_kind().function) {
        ret false
    }

    ret_hir := (&(*db).hir).rhs(func_id)
    if ret_hir == hir_none() { ret false }

    ret_ty := db.get_const_type(ret_hir)
    if ret_ty == ty_id_none() { ret false }

    types := &(*db).types
    if (&(*types)).kind(ret_ty) != ty_kind().ptr { ret false }
    (&(*types)).payload(ret_ty) == owner_ty
}

synth_return :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)
    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_never())

    fn_id := (tbl).rhs(id)
    if fn_id == hir_none() { ret }

    func_ty := db.get_const_type(fn_id)
    ret_ty := ty_id_unit()
    if func_ty != ty_id_none() {
        ret_ty = (&(*types_ptr)).func_return(func_ty)
    }

    val_id := (tbl).lhs(id)
    if val_id != hir_none() {
        check_value(db, val_id, ret_ty)
        val_slot := (unify_ptr).get_slot(val_id)
        if val_slot != slot_none() {
            (&(*db).unify).bind_type(&(*db).types, val_slot, ret_ty)
        }
    } else {
        if method_returns_ref_self(db, id) {
            ret
        }
        if ret_ty != ty_id_unit() {
            print("\n\033[1;31m[type error]\033[0m return with no value in function returning non-unit\n       --> ")
            db.print_loc(id)
            print("\n")
            fall()
        }
    }
}

synth_call :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }
    callee := (tbl).lhs(id)
    callee_slot := (unify_ptr).get_slot(callee)

    if callee_slot == slot_none() {
        print("\n[type error] cannot resolve call target\n       --> ")
        db.print_loc(callee)
        print("\n")
        fall()
    }
    if callee_slot != slot_none() {
        callee_ty := (unify_ptr).resolve_type_deep(types_ptr, callee_slot)

          if (&(*types_ptr)).kind( callee_ty) != ty_kind().func {
            print("\n\033[1;31m[type error]\033[0m cannot call non-function type '")
              (&(*types_ptr)).print_type( callee_ty)
            print("'\n       --> ")
            db.print_loc(callee)
            print("\n\n")
            fall()
        }

          if (&(*types_ptr)).kind( callee_ty) == ty_kind().func {
              ret_ty := (&(*types_ptr)).func_return( callee_ty)
              (&(*db).unify).bind_type(&(*db).types, slot, ret_ty)

            args_list_id := (tbl).rhs(id)
              params := (&(*types_ptr)).func_params( callee_ty)
            args_len: u64 = 0
            if args_list_id != hir_none() {
                args := db.get_list(args_list_id)
                args_len = args.len
            }

            if args_len != params.len {
                    print("\n\033[1;31m[type error]\033[0m ")
                    method := db.get_method_target(callee)
                    if method != id_none() {
                        print("method '")
                        name_node := (tbl).lhs(method)
                        name_id := (tbl).lhs(name_node)
                        db.interner.get(name_id).print()
                        print("' expected ")
                    } else {
                        print("function expected ")
                    }
                    print_u32(params.len as u32)
                    print(" arguments, but got ")
                    print_u32(args_len as u32)
                    print("\n       --> ")
                    db.print_loc(id)
                    print("\n\n")
                    fall()
                }

            if args_list_id != hir_none() {
                args := db.get_list(args_list_id)
                i: u64 = 0
                while i < args.len {
                    arg_node := *(args.ptr + i)
                    arg_slot := (unify_ptr).get_slot(arg_node)
                    param_ty := *(params.ptr + i)

                    if arg_slot != slot_none() {
                        check_value(db, arg_node, param_ty)
                        param_slot := unify_ptr.tmp_slot()
                          (&(*db).unify).bind_type(&(*db).types, param_slot, param_ty)
                          (&(*db).unify).union(&(*db).types, arg_slot, param_slot)
                    }
                    if arg_slot == slot_none() {
                        print("\n[type error] cannot resolve argument\n       --> ")
                        db.print_loc(arg_node)
                        print("\n")
                        fall()
                    }
                    i = i + 1
                }
            }
        }
    }
}

synth_block :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)
    list_id := (tbl).lhs(id)
    items := db.get_list(list_id)

    if items.len > 0 {
        last_id := *(items.ptr + items.len - 1)
        last_slot := (unify_ptr).get_slot(last_id)
        if last_slot != slot_none() {
            (&(*db).unify).union(&(*db).types, slot, last_slot)
        }
    } else {
        (&(*db).unify).bind_type(&(*db).types, slot, ty_id_unit())
    }

    fn_id := (tbl).rhs(id)
    if fn_id != hir_none() {
        func_ty := db.get_const_type(fn_id)
        if func_ty != ty_id_none() {
            ret_ty := (&(*types_ptr)).func_return(func_ty)
            if (ret_ty != ty_id_unit()) and (not method_returns_ref_self(db, id)) {
                if items.len > 0 {
                    last_id := *(items.ptr + items.len - 1)
                    check_value(db, last_id, ret_ty)
                }
                (&(*db).unify).bind_type(&(*db).types, slot, ret_ty)
            }
        }
    }
}

synth_binary :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }
    lhs := (tbl).lhs(id)
    rhs := (tbl).rhs(id)

    lhs_slot := (unify_ptr).get_slot(lhs)
    rhs_slot := (unify_ptr).get_slot(rhs)

    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        lhs_ty := (unify_ptr).resolve_type_deep(types_ptr, lhs_slot)
        rhs_ty := (unify_ptr).resolve_type_deep(types_ptr, rhs_slot)

          lhs_k := (&(*types_ptr)).kind( lhs_ty)
          rhs_k := (&(*types_ptr)).kind( rhs_ty)

        k := ty_kind()
        lhs_int := (lhs_k == k.int) or (lhs_k == k.uint) or (lhs_k == k.untyped_int)
        rhs_int := (rhs_k == k.int) or (rhs_k == k.uint) or (rhs_k == k.untyped_int)
        lhs_num := lhs_int or (lhs_k == k.float) or (lhs_k == k.untyped_float)
        rhs_num := rhs_int or (rhs_k == k.float) or (rhs_k == k.untyped_float)
        op := (tbl).kind(id)

        if (lhs_k == k.ptr) or (rhs_k == k.ptr) {
            if (lhs_k == k.ptr) and rhs_int and ((op == hir_kind().binary_add) or (op == hir_kind().binary_sub)) {
                  (&(*db).unify).bind_type(&(*db).types, slot, lhs_ty)
                ret
            }
            if (rhs_k == k.ptr) and lhs_int and (op == hir_kind().binary_add) {
                  (&(*db).unify).bind_type(&(*db).types, slot, rhs_ty)
                ret
            }
        } else if lhs_num and rhs_num {
            bitwise := (op == hir_kind().binary_bit_and) or (op == hir_kind().binary_bit_or) or
                       (op == hir_kind().binary_bit_xor) or (op == hir_kind().binary_shl) or
                       (op == hir_kind().binary_shr)
            if (not bitwise) or (lhs_int and rhs_int) {
                  (&(*db).unify).union(&(*db).types, lhs_slot, rhs_slot)
                  (&(*db).unify).union(&(*db).types, slot, lhs_slot)
                ret
            }
        }

        print("\n[type error] invalid arithmetic operands\n       --> ")
        db.print_loc(id)
        print("\n")
        fall()
    } else {
        print("\n[type error] missing arithmetic operand\n       --> ")
        db.print_loc(id)
        print("\n")
        fall()
    }
}

synth_assign :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)
    lhs := (tbl).lhs(id)
    rhs := (tbl).rhs(id)

    lhs_slot := (unify_ptr).get_slot(lhs)
    rhs_slot := (unify_ptr).get_slot(rhs)

    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        lhs_ty := (unify_ptr).resolve_type(lhs_slot)
        if lhs_ty != ty_id_none() { check_value(db, rhs, lhs_ty) }
          (&(*db).unify).union(&(*db).types, lhs_slot, rhs_slot)
        rhs_ty := (unify_ptr).resolve_type_deep(types_ptr, lhs_slot)
        if rhs_ty != ty_id_none() {
              (&(*db).unify).bind_type(&(*db).types, slot, rhs_ty)
        }
    }
}

synth_lit_float :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
      (&(*db).unify).bind_type(&(*db).types, slot, ty_id_untyped_float())
}

synth_lit_bool :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
      (&(*db).unify).bind_type(&(*db).types, slot, ty_id_bool())
}

synth_lit_str :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
     u8_ty := (&(*db).types).alloc_uint(8 as u16)
     ptr_ty := (&(*db).types).alloc_ptr(u8_ty)
      (&(*db).unify).bind_type(&(*db).types, slot, ptr_ty)
}

synth_unary_num :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    child := (tbl).lhs(id)
    child_slot := (&(*db).unify).get_slot(child)
    if child_slot != slot_none() {
          (&(*db).unify).union(&(*db).types, slot, child_slot)
    }
}

validate_unary_num :: (db &Nexus, tbl &HirTable, id u32) {
    child := (tbl).lhs(id)
    child_slot := (&(*db).unify).get_slot(child)
    if child_slot != slot_none() {
        child_ty := (&(*db).unify).resolve_type_deep(&(*db).types, child_slot)
         kind := (&(*db).types).kind(child_ty)
        k := ty_kind()
        is_int := (kind == k.int) or (kind == k.uint) or (kind == k.untyped_int)
        if is_int { ret }
        if ((tbl).kind(id) == hir_kind().unary_neg) and
           ((kind == k.float) or (kind == k.untyped_float)) { ret }
    }
    print("\n[type error] invalid unary operand\n       --> ")
    db.print_loc(id)
    print("\n")
    fall()
}

synth_unary_not :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    child := (tbl).lhs(id)
    child_slot := (&(*db).unify).get_slot(child)
    if child_slot != slot_none() {
          (&(*db).unify).bind_type(&(*db).types, child_slot, ty_id_bool())
    }
     (&(*db).unify).bind_type(&(*db).types, slot, ty_id_bool())
}

synth_unary_addr_of :: (db &Nexus, tbl &HirTable, id u32) {
    if db.get_const_type(id) != ty_id_none() {
        ret
    }
    slot := (&(*db).unify).get_slot(id)
    if slot == slot_none() {
        slot = (&(*db).unify).new_slot(id)
    }
    child := (tbl).lhs(id)
    child_slot := (&(*db).unify).get_slot(child)

    if child_slot != slot_none() {
        child_ty := (&(*db).unify).resolve_type_deep(&(*db).types, child_slot)
        if (&(*db).types).kind(child_ty) == ty_kind().type_ {
            (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
            val := db.get_const_type(child)
            ptr_val := (&(*db).types).alloc_ptr(val)
            db.set_const_type(id, ptr_val)
            ret
        }

        ptr_ty := (&(*db).types).alloc_ptr(child_ty)
        (&(*db).unify).bind_type(&(*db).types, slot, ptr_ty)
    }
}

synth_unary_deref :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).get_slot(id)
    if slot == slot_none() {
        slot = (&(*db).unify).new_slot(id)
    }
    child := (tbl).lhs(id)
    child_slot := (&(*db).unify).get_slot(child)

    if child_slot != slot_none() {
        child_ty := (&(*db).unify).resolve_type_deep(&(*db).types, child_slot)
         if (&(*db).types).kind(child_ty) == ty_kind().ptr {
             inner_ty := (&(*db).types).payload(child_ty)
              (&(*db).unify).bind_type(&(*db).types, slot, inner_ty)
        } else {
            print("\n[type error] cannot dereference non-pointer\n       --> ")
            db.print_loc(id)
            print("\n")
            fall()
        }
    }
}

synth_break_cont :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
      (&(*db).unify).bind_type(&(*db).types, slot, ty_id_unit())
}

synth_if :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    cond := (tbl).lhs(id)
    thenb := (tbl).rhs(id)
    elseb := (tbl).extra(id)

    cond_slot := (&(*db).unify).get_slot(cond)
    if cond_slot != slot_none() {
          (&(*db).unify).bind_type(&(*db).types, cond_slot, ty_id_bool())
    }

     (&(*db).unify).bind_type(&(*db).types, slot, ty_id_unit())
}

synth_while :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    cond := (tbl).lhs(id)
    cond_slot := (&(*db).unify).get_slot(cond)
    if cond_slot != slot_none() {
         (&(*db).unify).bind_type(&(*db).types, cond_slot, ty_id_bool())
    }
    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_unit())
}

synth_binary_comp :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    lhs := (tbl).lhs(id)
    rhs := (tbl).rhs(id)

    lhs_slot := (&(*db).unify).get_slot(lhs)
    rhs_slot := (&(*db).unify).get_slot(rhs)

    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
         (&(*db).unify).union(&(*db).types, lhs_slot, rhs_slot)
    }
    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_bool())
}

validate_binary_comp :: (db &Nexus, tbl &HirTable, id u32) {
    lhs := (tbl).lhs(id)
    rhs := (tbl).rhs(id)
    lhs_slot := (&(*db).unify).get_slot(lhs)
    rhs_slot := (&(*db).unify).get_slot(rhs)
    if (lhs_slot != slot_none()) and (rhs_slot != slot_none()) {
        lhs_ty := (&(*db).unify).resolve_type_deep(&(*db).types, lhs_slot)
        rhs_ty := (&(*db).unify).resolve_type_deep(&(*db).types, rhs_slot)
         lhs_kind := (&(*db).types).kind(lhs_ty)
         rhs_kind := (&(*db).types).kind(rhs_ty)
        k := ty_kind()
        lhs_num := (lhs_kind == k.int) or (lhs_kind == k.uint) or (lhs_kind == k.float) or
                   (lhs_kind == k.untyped_int) or (lhs_kind == k.untyped_float)
        rhs_num := (rhs_kind == k.int) or (rhs_kind == k.uint) or (rhs_kind == k.float) or
                   (rhs_kind == k.untyped_int) or (rhs_kind == k.untyped_float)
        if lhs_num and rhs_num { ret }
        op := (tbl).kind(id)
        if (op == hir_kind().binary_eq_eq) or (op == hir_kind().binary_neq) {
            if (lhs_kind == k.bool) and (rhs_kind == k.bool) { ret }
            if (lhs_kind == k.ptr) and (rhs_kind == k.ptr) { ret }
        }
    }
    print("\n[type error] invalid comparison operands\n       --> ")
    db.print_loc(id)
    print("\n")
    fall()
}

synth_logic_and_or :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    lhs := (tbl).lhs(id)
    rhs := (tbl).rhs(id)

    lhs_slot := (&(*db).unify).get_slot(lhs)
    rhs_slot := (&(*db).unify).get_slot(rhs)

    if lhs_slot != slot_none() {
          (&(*db).unify).bind_type(&(*db).types, lhs_slot, ty_id_bool())
    }
    if rhs_slot != slot_none() {
          (&(*db).unify).bind_type(&(*db).types, rhs_slot, ty_id_bool())
    }
    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_bool())
}

synth_cast :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).get_slot(id)
    if slot == slot_none() {
        slot = (&(*db).unify).new_slot(id)
    }
    lhs := (tbl).lhs(id)
    rhs := (tbl).rhs(id)
    rhs_type := db.get_const_type(rhs)
    if rhs_type != ty_id_none() {
        lhs_slot := (&(*db).unify).get_slot(lhs)
        lhs_type := ty_id_none()
        if lhs_slot != slot_none() {
            lhs_type = (&(*db).unify).resolve_type_deep(&(*db).types, lhs_slot)
        }
        types := &(*db).types
        src := (&(*types)).kind(lhs_type)
        dst := (&(*types)).kind(rhs_type)
        k := ty_kind()
        src_int := (src == k.int) or (src == k.uint) or (src == k.untyped_int)
        dst_int := (dst == k.int) or (dst == k.uint) or (dst == k.untyped_int)
        src_num := src_int or (src == k.float) or (src == k.untyped_float) or (src == k.bool)
        dst_num := dst_int or (dst == k.float) or (dst == k.untyped_float) or (dst == k.bool)
        if not ((src_num and dst_num) or ((src == k.ptr) and (dst == k.ptr)) or
                (src_int and (dst == k.ptr)) or ((src == k.ptr) and dst_int) or
                ((src == k.ptr) and (dst == k.bool))) {
            print("\n[type error] invalid cast\n       --> ")
            db.print_loc(id)
            print("\n")
            fall()
        }
        (&(*db).unify).bind_type(&(*db).types, slot, rhs_type)
    } else {
        print("\n[type error] cast target is not a type\n       --> ")
        db.print_loc(id)
        print("\n")
        fall()
    }
}

synth_struct :: (eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)

    names_list := (tbl).lhs(id)
    types_list := (tbl).rhs(id)

    names := db.get_list(names_list)
    types := db.get_list(types_list)

    fields_vec := VecU32.new()

    i: u64 = 0
    while (i < names.len) and (i < types.len) {
        name_node := *(names.ptr + i)
        type_node := *(types.ptr + i)

        name_id := (tbl).lhs(name_node)

        ty_val := db.get_const_type(type_node)
        if ty_val == ty_id_none() {
            ty_val = synth_type_node(eng, type_node)
        }
        if ty_val == ty_id_none() {
            print("\n\033[1;31m[type error]\033[0m struct field requires a resolved type\n       --> ")
            db.print_loc(type_node)
            print("\n")
            fall()
        }

        fields_vec.push(name_id)
        fields_vec.push(ty_val)
        i = i + 1
    }

    ptr := 0 as &u32
    if fields_vec.len > 0 { ptr = fields_vec.ptr_at(0) }
    slice: SliceU32 = .{ ptr: ptr, len: fields_vec.len }

    tyid := (&(*types_ptr)).alloc_struct(slice)
    fields_vec.destroy()

    sym_id := db.get_hir_symbol(id)
    if sym_id != id_none() {
        name_id := db.sym_names.get(sym_id)
        name := db.interner.get(name_id)
        named := (&(*types_ptr)).alloc_nominal(tyid, name, id)
        db.set_const_type(id, named)
        sym_hir := db.get_sym_hir(sym_id)
        if sym_hir != id_none() {
            db.set_const_type(sym_hir, named)
            sym_slot := (&(*db).unify).get_slot(sym_hir)
            if sym_slot == slot_none() {
                sym_slot = (&(*db).unify).new_slot(sym_hir)
            }
            (&(*db).unify).bind_type(&(*db).types, sym_slot, ty_id_type())
        }
    } else {
        db.set_const_type(id, tyid)
    }

    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())

    methods_id := (tbl).extra(id)
    if methods_id != hir_none() {
        if sym_id == id_none() {
            print("\n\033[1;31m[type error]\033[0m methods require a named struct binding\n       --> ")
            db.print_loc(id)
            print("\n")
            fall()
        }
        methods := db.get_list(methods_id)
        m_i: u64 = 0
        while m_i < methods.len {
            method := *(methods.ptr + m_i)
            func_node := (tbl).extra(method)
            synth_func(eng, func_node)
            method_slot := (unify_ptr).new_slot(method)
            func_slot := (unify_ptr).get_slot(func_node)
            func_ty := (unify_ptr).resolve_type(func_slot)
            (&(*db).unify).bind_type(&(*db).types, method_slot, func_ty)
            m_i = m_i + 1
        }
    }
}

synth_struct_init :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)

    fields_list := (tbl).lhs(id)
    vals_list   := (tbl).rhs(id)

    fields := db.get_list(fields_list)
    vals   := db.get_list(vals_list)

    fields_vec := VecU32.new()

    i: u64 = 0
    while (i < fields.len) and (i < vals.len) {
        f_node := *(fields.ptr + i)
        v_node := *(vals.ptr + i)

        name_id := (tbl).lhs(f_node)

        v_slot := (unify_ptr).get_slot(v_node)
        if v_slot == slot_none() {
            v_slot = (unify_ptr).new_slot(v_node)
        }
        infer_ty := (&(*types_ptr)).alloc_infer(v_slot)

        fields_vec.push(name_id)
        fields_vec.push(infer_ty)
        i = i + 1
    }

    ptr := 0 as &u32
    if fields_vec.len > 0 { ptr = fields_vec.ptr_at(0) }
    slice: SliceU32 = .{ ptr: ptr, len: fields_vec.len }

    tyid := (&(*types_ptr)).alloc_struct(slice)
    fields_vec.destroy()

    (&(*db).unify).bind_type(&(*db).types, slot, tyid)
}

synth_member :: (eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types
    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }
    lhs_id := (tbl).lhs(id)

    is_type := false
    lhs_ty := ty_id_none()
    if lhs_id == hir_none() {
        owner := db.get_method_owner(id)
        if owner == hir_none() {
            print("\n\033[1;31m[type error]\033[0m implicit field access outside a method\n       --> ")
            db.print_loc(id)
            print("\n")
            fall()
        }
        lhs_ty = db.get_const_type(owner)
    } else {
        lhs_slot := (unify_ptr).get_slot(lhs_id)
        if lhs_slot == slot_none() {
            print("\n\033[1;31m[type error]\033[0m cannot resolve member receiver\n       --> ")
            db.print_loc(lhs_id)
            print("\n")
            fall()
        }
        lhs_ty = (unify_ptr).resolve_type_deep(types_ptr, lhs_slot)
        if lhs_ty == ty_id_type() {
            lhs_ty = db.get_const_type(lhs_id)
            is_type = true
        } else {
            while (&(*types_ptr)).kind(lhs_ty) == ty_kind().ptr {
                lhs_ty = (&(*types_ptr)).payload(lhs_ty)
            }
        }
    }

    kind := (&(*types_ptr)).kind(lhs_ty)
    if (kind != ty_kind().struct_) and (kind != ty_kind().nominal) {
        print("\n\033[1;31m[type error]\033[0m member receiver must be a struct value or named struct type, got '")
        (&(*types_ptr)).print_type(lhs_ty)
        print("'\n       --> ")
        db.print_loc(id)
        print("\n")
        fall()
    }

    rhs_id := (tbl).rhs(id)
    name_id := (tbl).lhs(rhs_id)
    if not is_type {
        fields := (&(*types_ptr)).get_struct_fields(lhs_ty)
        i: u64 = 0
        while i < fields.len / 2 {
            if *(fields.ptr + i * 2) == name_id {
                field_ty := *(fields.ptr + i * 2 + 1)
                if (&(*types_ptr)).kind(field_ty) == ty_kind().infer {
                    (&(*db).unify).union(&(*db).types, slot, (&(*types_ptr)).payload(field_ty))
                } else {
                    (&(*db).unify).bind_type(&(*db).types, slot, field_ty)
                }
                ret
            }
            i = i + 1
        }
    }

    if kind == ty_kind().nominal {
        origin := (&(*types_ptr)).nominal_origin(lhs_ty)
        struct_id := origin
        if (tbl).kind(origin) == hir_kind().binding {
            struct_id = (tbl).extra(origin)
        }
        methods_id := (tbl).extra(struct_id)
        if methods_id != hir_none() {
            methods := db.get_list(methods_id)
            i: u64 = 0
            while i < methods.len {
                method := *(methods.ptr + i)
                method_name := (tbl).lhs((tbl).lhs(method))
                if method_name == name_id {
                    receiver := method_has_receiver(db, method)
                    if is_type and receiver {
                        print("\n\033[1;31m[type error]\033[0m instance method requires a struct value; call it on an instance\n       --> ")
                        db.print_loc(id)
                        print("\n")
                        fall()
                    }
                    if (lhs_id != hir_none()) and (not is_type) and (not receiver) {
                        print("\n\033[1;31m[type error]\033[0m static method requires the named struct type\n       --> ")
                        db.print_loc(id)
                        print("\n")
                        fall()
                    }
                    method_slot := (unify_ptr).get_slot(method)
                    if method_slot == slot_none() {
                        func_node := (tbl).extra(method)
                        synth_func(eng, func_node)
                        method_slot = (unify_ptr).new_slot(method)
                        func_slot := (unify_ptr).get_slot(func_node)
                        func_ty := (unify_ptr).resolve_type(func_slot)
                        (&(*db).unify).bind_type(&(*db).types, method_slot, func_ty)
                    }
                    db.set_method_target(id, method)
                    (&(*db).unify).union(&(*db).types, slot, method_slot)
                    ret
                }
                i = i + 1
            }
        }
    }

    print("\n\033[1;31m[type error]\033[0m struct '")
    (&(*types_ptr)).print_type(lhs_ty)
    print("' has no field or method named '")
    db.interner.get(name_id).print()
    print("'\n       --> ")
    db.print_loc(id)
    print("\n")
    fall()
}

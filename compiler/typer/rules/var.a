import Nexus from "../../nexus/nexus"
import HirTable, hir_kind, hir_none from "../../hir"
import Str from "std/string"
import TypeStorage, TyKind, ty_id_none, ty_id_type, ty_id_unit from "../../types"
import slot_none from "../../unify"
import id_none from "../../nexus/pool"
import Engine from "../../engine"
import fall from "std/sys"
import parse_builtin_type, check_value from "./common"
import synth_node from "../tyck"
import eval_const from "../../lower"

print :: fn(s &u8)

synth_ident :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    name_id := (tbl).lhs(id)
    name := db.interner.get(name_id)

    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }

    owner := db.get_method_owner(id)
    if (owner != hir_none()) and name.eq(Str.of("Self")) {
        self_ty := db.get_const_type(owner)
        if (types_ptr.kind(self_ty) != TyKind.nominal) and (types_ptr.kind(self_ty) != TyKind.enum_) {
            print(c"\n\033[1;31m[type error]\033[0m Self requires a named struct or enum method\n       --> ")
            db.print_loc(id)
            print(c"\n")
            fall()
        }
        db.unify.bind_type(&db.types, slot, ty_id_type())
        db.set_const_type(id, self_ty)
        db.set_is_const(id, true)
        ret
    }

    builtin_ty := parse_builtin_type(types_ptr, name)
    if builtin_ty != ty_id_none() {
        (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
        db.set_const_type(id, builtin_ty)
        db.set_is_const(id, true)
        ret
    }

    sym_id := db.get_hir_symbol(id)

    if sym_id != id_none() {
        real_sym := db.resolve_sym(sym_id)
        if db.is_sym_const(real_sym) {
            db.set_is_const(id, true)
        }

        origin_hir := db.get_sym_hir(sym_id)
        if origin_hir == id {
            ret
        }

        origin_slot := eng.slot_of(sym_id)
        if origin_slot != slot_none() {
            (&(*db).unify).union(&(*db).types, slot, origin_slot)
        }

        resolved_hir := db.get_sym_hir(sym_id)
        if resolved_hir != id_none() {
            if db.is_const(resolved_hir) {
                db.set_is_const(id, true)
                if db.has_const_val(resolved_hir) {
                    db.set_const_val(id, db.get_const_val(resolved_hir))
                }
            }
            const_val := db.get_const_type(resolved_hir)
            if const_val != ty_id_none() {
                db.set_const_type(id, const_val)
                db.set_is_const(id, true)
            }
        }
    }
}

synth_type_node :: fn(eng &Engine, id u32) u32 {
    if id == hir_none() { ret ty_id_none() }
    db := &(*eng).nexus
    existing := db.get_const_type(id)
    if existing != ty_id_none() { ret existing }

    tbl := &(*db).hir
    k := hir_kind
    curr := (tbl).kind(id)

    if curr == k.ident {
        synth_ident(eng, id)
        ret db.get_const_type(id)
    }

    if (curr == k.k_cmpt) or (curr == k.k_macro) {
        synth_node(eng, id)
        ret db.get_const_type(id)
    }

    if curr == k.k_if {
        synth_node(eng, id)
        ret db.get_const_type(id)
    }

    if curr == k.block {
        synth_node(eng, id)
        ret db.get_const_type(id)
    }

    if curr == k.unary_addr_of {
        child := (tbl).lhs(id)
        child_ty := synth_type_node(eng, child)
        if child_ty != ty_id_none() {
            ptr_ty := (&(*db).types).alloc_ptr(child_ty)
            db.set_const_type(id, ptr_ty)
            slot := (&(*db).unify).get_slot(id)
            if slot == slot_none() {
                slot = (&(*db).unify).new_slot(id)
            }
            (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
            ret ptr_ty
        }
    }

    if curr == k.binary_bit_or {
        lhs := (tbl).lhs(id)
        rhs := (tbl).rhs(id)
        lhs_ty := synth_type_node(eng, lhs)
        rhs_ty := synth_type_node(eng, rhs)
        if (lhs_ty != ty_id_none()) and (rhs_ty != ty_id_none()) {
            union_ty := (&(*db).types).make_union_2(lhs_ty, rhs_ty)
            db.set_const_type(id, union_ty)
            slot := (&(*db).unify).get_slot(id)
            if slot == slot_none() {
                slot = (&(*db).unify).new_slot(id)
            }
            (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
            ret union_ty
        }
    }

    if curr == k.function {
        synth_node(eng, id)
        ret db.get_const_type(id)
    }

    if curr == k.call {
        callee := tbl.lhs(id)
        if tbl.kind(callee) == k.ident {
            synth_ident(eng, callee)
        }
        synth_node(eng, id)
        ret db.get_const_type(id)
    }

    synth_node(eng, id)
    db.get_const_type(id)
}

synth_var_or_binding :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    ident_id := (tbl).lhs(id)
    type_id  := (tbl).rhs(id)
    value_id := (tbl).extra(id)

    slot := (unify_ptr).new_slot(id)

    ident_slot := (unify_ptr).get_slot(ident_id)
    if ident_slot == slot_none() {
        ident_slot = (unify_ptr).new_slot(ident_id)
    }

    if type_id != hir_none() {
        type_slot := (unify_ptr).get_slot(type_id)
        if type_slot != slot_none() {
            (&(*db).unify).bind_type(&(*db).types, type_slot, ty_id_type())
        }

        type_value := db.get_const_type(type_id)
        if type_value == ty_id_none() {
            type_value = synth_type_node(eng, type_id)
        }
        if (type_value == ty_id_none()) and db.is_const(type_id) {
            type_slot_chk := unify_ptr.get_slot(type_id)
            if type_slot_chk != slot_none() {
                if unify_ptr.resolve_type_deep(types_ptr, type_slot_chk) == ty_id_type() {
                    c_val := eval_const(db, type_id) as u32
                    if (c_val != ty_id_none()) and (c_val < types_ptr.len()) {
                        type_value = c_val
                        db.set_const_type(type_id, type_value)
                    }
                }
            }
        }
        if type_value == ty_id_none() {
            print(c"\n\033[1;31m[type error]\033[0m declaration annotation is not a resolved type\n       --> ")
            db.print_loc(type_id)
            print(c"\n")
            fall()
        }
        (&(*db).unify).bind_type(&(*db).types, ident_slot, type_value)
        db.set_const_type(ident_id, type_value)
        db.set_const_type(id, type_value)
    }

    if value_id != hir_none() {
        if ((tbl).kind(id) == hir_kind.binding) and ((tbl).kind(value_id) == hir_kind.struct_) {
            structural := db.get_const_type(value_id)
            kind := types_ptr.kind(structural)
            if (kind != TyKind.struct_) and (kind != TyKind.nominal) {
                print(c"\n\033[1;31m[type error]\033[0m struct declaration could not be resolved\n       --> ")
                db.print_loc(value_id)
                print(c"\n")
                fall()
            }
            named := structural
            if kind == TyKind.struct_ {
                is_tuple := false
                fields := types_ptr.get_struct_fields(structural)
                if fields.len > 0 {
                    first_name_id := *(fields.ptr + 0)
                    is_tuple = db.is_tuple_name(first_name_id)
                }
                if not is_tuple {
                    name_id := tbl.lhs(ident_id)
                    name := db.interner.get(name_id)
                    named = types_ptr.alloc_nominal(structural, name, id)
                    db.set_const_type(value_id, named)
                }
            }
            db.set_const_type(ident_id, named)
            db.set_const_type(id, named)
        }
        val_slot := unify_ptr.get_slot(value_id)
        if val_slot != slot_none() {
            val_ty := unify_ptr.resolve_type(val_slot)
            if types_ptr.kind(val_ty) == TyKind.type_ {
                type_val := db.get_const_type(value_id)
                if type_val == ty_id_none() {
                    print(c"\n\033[1;31m[type error]\033[0m type value cannot be resolved\n       --> ")
                    db.print_loc(value_id)
                    print(c"\n")
                    fall()
                }
                db.set_const_type(ident_id, type_val)
                db.set_const_type(id, type_val)
            }
            if type_id != hir_none() {
                expected := db.get_const_type(type_id)
                if expected != ty_id_none() { check_value(db, value_id, expected) }
            }
            val_slot = (unify_ptr).get_slot(value_id)
            (&(*db).unify).union(&(*db).types, ident_slot, val_slot)
        }
    }

    (&(*db).unify).union(&(*db).types, slot, ident_slot)

    if (tbl).kind(id) == hir_kind.binding {
        db.set_is_const(id, true)
        db.set_is_const(ident_id, true)
        sym_id := db.get_hir_symbol(ident_id)
        if sym_id != id_none() {
            db.set_sym_is_const(sym_id, true)
        }
    } else {
        db.set_is_const(id, false)
        db.set_is_const(ident_id, false)
        sym_id := db.get_hir_symbol(ident_id)
        if sym_id != id_none() {
            db.set_sym_is_const(sym_id, false)
        }
    }
}

synth_arg :: fn(db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    ident_id := (tbl).lhs(id)
    ty_id    := (tbl).rhs(id)

    if ident_id != hir_none() {
        ident_slot := (unify_ptr).get_slot(ident_id)
        if ident_slot == slot_none() {
            ident_slot = (unify_ptr).new_slot(ident_id)
        }

        if ty_id != hir_none() {
            type_val := db.get_const_type(ty_id)
            if type_val != ty_id_none() {
                if type_val == ty_id_type() {
                    t_infer := (&(*types_ptr)).alloc_infer(ident_slot)
                    db.set_const_type(ident_id, t_infer)
                    db.set_const_type(id, t_infer)
                } else {
                    (&(*db).unify).bind_type(&(*db).types, ident_slot, type_val)
                    db.set_const_type(ident_id, type_val)
                    db.set_const_type(id, type_val)
                }
            }
        }
    } else {
        if ty_id != hir_none() {
            type_val := db.get_const_type(ty_id)
            if type_val != ty_id_none() {
                db.set_const_type(id, type_val)
            }
        }
    }
}

synth_destructure :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    rhs_node := (tbl).extra(id)
    synth_node(eng, rhs_node)

    rhs_slot := (unify_ptr).get_slot(rhs_node)
    rhs_ty := ty_id_none()
    if rhs_slot != slot_none() {
        rhs_ty = (unify_ptr).resolve_type_deep(types_ptr, rhs_slot)
    }
    if rhs_ty == ty_id_none() {
        rhs_ty = db.get_node_type(rhs_node)
    }

    t := rhs_ty
    while (*types_ptr).kind(t) == TyKind.nominal {
        t = (*types_ptr).nominal_base(t)
    }

    if (*types_ptr).kind(t) != TyKind.struct_ {
        print(c"\n\033[1;31m[type error]\033[0m expected tuple on right-hand side of destructuring\n       --> ")
        db.print_loc(rhs_node)
        print(c"\n")
        fall()
    }

    fields := (*types_ptr).get_struct_fields(t)
    field_count := fields.len / 2

    idents_list := (tbl).lhs(id)
    idents := db.get_list(idents_list)

    if idents.len != field_count {
        print(c"\n\033[1;31m[type error]\033[0m mismatched number of elements in tuple destructuring\n       --> ")
        db.print_loc(id)
        print(c"\n")
        fall()
    }

    i: u64 = 0
    while i < idents.len {
        ident_node := *(idents.ptr + i)
        f_name_id := db.tuple_field_name(i as u32)

        f_ty := ty_id_none()
        f_i: u64 = 0
        while f_i < field_count {
            fn_id := *(fields.ptr + (f_i * 2))
            if fn_id == f_name_id {
                f_ty = *(fields.ptr + (f_i * 2) + 1)
                break
            }
            f_i = f_i + 1
        }

        if f_ty == ty_id_none() {
            f_ty = *(fields.ptr + (i * 2) + 1)
        }

        ident_slot := (unify_ptr).get_slot(ident_node)
        if ident_slot == slot_none() {
            ident_slot = (unify_ptr).new_slot(ident_node)
        }
        (unify_ptr).bind_type(types_ptr, ident_slot, f_ty)
        db.set_const_type(ident_node, f_ty)

        i = i + 1
    }

    destruct_slot := (unify_ptr).new_slot(id)
    (unify_ptr).bind_type(types_ptr, destruct_slot, ty_id_unit())
    db.set_const_type(id, ty_id_unit())
}

import Nexus from "../../nexus/nexus"
import Engine from "../../engine"
import HirTable, hir_kind, hir_none from "../../hir"
import ty_kind, ty_id_none, ty_id_unit, ty_id_bool, ty_id_error, ty_id_never from "../../types"
import slot_none from "../../unify"
import check_value from "./common"
import synth_type_node from "./var"
import VecU32 from "std/vec/u32"
import fall from "std/sys"

print :: fn(s &u8) unit

match_error :: fn(db &Nexus, msg &u8, id u32) {
    print(c"\n\033[1;31m[type error]\033[0m ")
    print(msg)
    print(c"\n       --> ")
    db.print_loc(id)
    print(c"\n")
    fall()
}

synth_match :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    types := &(*db).types
    unify := &(*db).unify
    slot := unify.new_slot(id)
    value := tbl.lhs(id)
    value_slot := unify.get_slot(value)
    value_ty := ty_id_none()
    if value_slot != slot_none() { value_ty = unify.resolve_type_deep(types, value_slot) }
    if value_ty == ty_id_none() { match_error(db, c"match value type is unresolved", value) }
    value_kind := types.kind(value_ty)
    if (value_kind != ty_kind().enum_) and (value_kind != ty_kind().union_) {
        match_error(db, c"match requires an enum or union value", value)
    }

    arms := db.get_list(tbl.rhs(id))
    covered := VecU32.new()
    result_ty := ty_id_none()
    has_else := false
    i: u64 = 0
    while i < arms.len {
        arm := *(arms.ptr + i)
        patterns := db.get_list(tbl.lhs(arm))
        marker := tbl.extra(arm)
        if patterns.len == 0 {
            if has_else { match_error(db, c"match has more than one else arm", arm) }
            has_else = true
        }
        p_i: u64 = 0
        while p_i < patterns.len {
            pat := *(patterns.ptr + p_i)
            if value_kind == ty_kind().enum_ {
                name_id := tbl.lhs(pat)
                if not types.enum_has_variant(value_ty, name_id) { match_error(db, c"match pattern is not an enum variant", pat) }
                if vec_u32_contains(&covered, name_id) { match_error(db, c"match pattern is duplicated", pat) }
                covered.push(name_id)
            } else {
                pat_ty := synth_type_node(eng, pat)
                if pat_ty == ty_id_none() { match_error(db, c"match union pattern is not a type", pat) }
                if not types.union_contains(value_ty, pat_ty) { match_error(db, c"match pattern is not a member of the union", pat) }
                if vec_u32_contains(&covered, pat_ty) { match_error(db, c"match pattern is duplicated", pat) }
                covered.push(pat_ty)
            }
            p_i = p_i + 1
        }
        body := tbl.rhs(arm)
        binder := hir_none()
        if tbl.extra(id) != hir_none() and tbl.kind(tbl.extra(id)) == hir_kind.match_binding {
            binder = tbl.extra(arm)
            if binder != hir_none() {
                bind_ty := value_ty
                if (value_kind == ty_kind().union_) and (patterns.len == 1) {
                    bind_ty = synth_type_node(eng, *(patterns.ptr + 0))
                }
                db.set_const_type(binder, bind_ty)
                bind_slot := unify.get_slot(binder)
                if bind_slot == slot_none() { bind_slot = unify.new_slot(binder) }
                unify.bind_type(types, bind_slot, bind_ty)
            }
        }
        body_slot := unify.get_slot(body)
        body_ty := ty_id_none()
        if body_slot != slot_none() { body_ty = unify.resolve_type_deep(types, body_slot) }
        if body_ty != ty_id_none() and body_ty != ty_id_never() {
            if result_ty == ty_id_none() or result_ty == ty_id_never() {
                result_ty = body_ty
            } else {
                merged := unify.unify_types(types, result_ty, body_ty)
                if (merged == ty_id_error()) or (merged == ty_id_none()) {
                    match_error(db, c"match arms have incompatible result types", body)
                }
                result_ty = merged
            }
        }
        i = i + 1
    }

    if not has_else {
        required: u32 = 0
        if value_kind == ty_kind().enum_ { required = types.enum_variant_count(value_ty) }
        else { required = types.union_members_len(value_ty) }
        if covered.len < (required as u64) { match_error(db, c"non-exhaustive match; add the missing cases or else", id) }
    }
    if result_ty == ty_id_none() { result_ty = ty_id_never() }
    unify.bind_type(types, slot, result_ty)
    covered.destroy()
}

prepare_match_bindings :: fn(eng &Engine, start u32, len u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    types := &(*db).types
    unify := &(*db).unify
    i := start
    while i < len {
        if tbl.kind(i) != hir_kind.k_match {
            i = i + 1
            cont
        }
        meta := tbl.extra(i)
        if meta == hir_none() or tbl.kind(meta) != hir_kind.match_binding {
            i = i + 1
            cont
        }
        value := tbl.lhs(i)
        value_slot := unify.get_slot(value)
        value_ty := ty_id_none()
        if value_slot != slot_none() { value_ty = unify.resolve_type_deep(types, value_slot) }
        if value_ty == ty_id_none() {
            i = i + 1
            cont
        }
        value_kind := types.kind(value_ty)
        arms := db.get_list(tbl.rhs(i))
        a: u64 = 0
        while a < arms.len {
            arm := *(arms.ptr + a)
            binder := tbl.extra(arm)
            if binder == hir_none() {
                a = a + 1
                cont
            }
            patterns := db.get_list(tbl.lhs(arm))
            bind_ty := value_ty
            if (value_kind == ty_kind().union_) and (patterns.len == 1) {
                bind_ty = synth_type_node(eng, *(patterns.ptr + 0))
            }
            db.set_const_type(binder, bind_ty)
            bind_slot := unify.get_slot(binder)
            if bind_slot == slot_none() { bind_slot = unify.new_slot(binder) }
            unify.bind_type(types, bind_slot, bind_ty)
            a = a + 1
        }
        i = i + 1
    }
}

vec_u32_contains :: fn(v &VecU32, value u32) bool {
    i: u64 = 0
    while i < v.len {
        if v.get(i) == value { ret true }
        i = i + 1
    }
    false
}

synth_block :: fn(db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)
    list_id := (tbl).lhs(id)
    items := db.get_list(list_id)

    if items.len > 0 {
        last_id := *(items.ptr + items.len - 1)
        last_slot := (unify_ptr).get_slot(last_id)
        if last_slot != slot_none() {
            (&(*db).unify).union(&(*db).types, slot, last_slot)
        }
    } else {
        (&(*db).unify).bind_type(&(*db).types, slot, ty_id_unit())
    }

    fn_id := (tbl).rhs(id)
    if fn_id != hir_none() {
        func_ty := db.get_const_type(fn_id)
        if func_ty != ty_id_none() {
            ret_ty := (&(*types_ptr)).func_return(func_ty)
            if ret_ty != ty_id_unit() {
                if items.len > 0 {
                    last_id := *(items.ptr + items.len - 1)
                    check_value(db, last_id, ret_ty)
                }
                (&(*db).unify).bind_type(&(*db).types, slot, ret_ty)
            }
        }
    }
}

synth_if :: fn(db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)
    cond := (tbl).lhs(id)
    thenb := (tbl).rhs(id)
    elseb := (tbl).extra(id)

    check_value(db, cond, ty_id_bool())
    cond_slot := (unify_ptr).get_slot(cond)
    if cond_slot != slot_none() {
        cond_ty := (unify_ptr).resolve_type_deep(types_ptr, cond_slot)
        if (cond_ty != ty_id_none()) and (cond_ty != ty_id_bool()) {
            print(c"\n\033[1;31m[type error]\033[0m 'if' condition must be bool, got '")
            (&(*types_ptr)).print_type(cond_ty)
            print(c"'\n       --> ")
            db.print_loc(cond)
            print(c"\n")
            fall()
        }
        (&(*db).unify).bind_type(&(*db).types, cond_slot, ty_id_bool())
    }

    if elseb != hir_none() {
        then_slot := (unify_ptr).get_slot(thenb)
        else_slot := (unify_ptr).get_slot(elseb)

        then_ty := ty_id_none()
        if then_slot != slot_none() {
            then_ty = (unify_ptr).resolve_type_deep(types_ptr, then_slot)
        }

        else_ty := ty_id_none()
        if else_slot != slot_none() {
            else_ty = (unify_ptr).resolve_type_deep(types_ptr, else_slot)
        }

        if (then_ty != ty_id_none()) and (else_ty != ty_id_none()) {
            unified := (unify_ptr).unify_types(types_ptr, then_ty, else_ty)
            k := ty_kind()
            unified_k := (&(*types_ptr)).kind(unified)
            if (unified != ty_id_error()) and (unified != ty_id_unit()) and (unified_k != k.unit) {
                if then_slot != slot_none() {
                    (&(*db).unify).union(&(*db).types, slot, then_slot)
                }
                if else_slot != slot_none() {
                    (&(*db).unify).union(&(*db).types, slot, else_slot)
                }
                (&(*db).unify).bind_type(&(*db).types, slot, unified)
                ret
            }
        }
    } else {
        (&(*db).unify).bind_type(&(*db).types, slot, ty_id_unit())
    }
}

synth_while :: fn(db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)
    cond := (tbl).lhs(id)

    check_value(db, cond, ty_id_bool())
    cond_slot := (unify_ptr).get_slot(cond)
    if cond_slot != slot_none() {
        cond_ty := (unify_ptr).resolve_type_deep(types_ptr, cond_slot)
        if (cond_ty != ty_id_none()) and (cond_ty != ty_id_bool()) {
            print(c"\n\033[1;31m[type error]\033[0m 'while' condition must be bool, got '")
            (&(*types_ptr)).print_type(cond_ty)
            print(c"'\n       --> ")
            db.print_loc(cond)
            print(c"\n")
            fall()
        }
        (&(*db).unify).bind_type(&(*db).types, cond_slot, ty_id_bool())
    }
    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_unit())
}

synth_break_cont :: fn(db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_unit())
}

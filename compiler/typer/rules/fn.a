import Nexus from "../../nexus/nexus"
import HirTable, hir_kind, hir_none from "../../hir"
import Str from "std/string"
import TypeStorage, TyKind, ty_id_none, ty_id_unit, ty_id_never, ty_id_type, ty_id_untyped_int, ty_id_untyped_float, ty_id_error from "../../types"
import UnifyStorage, slot_none from "../../unify"
import id_none from "../../nexus/pool"
import Engine from "../../engine"
import fall from "std/sys"
import synth_type_node from "./var"
import check_value from "./common"
import synth_node from "../tyck"
import specialize_nominal_from_creator, instantiate_type, resolve_ty_id from "../specialize"
import eval_const from "../../lower"

print :: fn(s &u8) unit
print_u32 :: fn(v u32) unit

func_has_self :: fn(db &Nexus, func_node u32) bool {
    if func_node == hir_none() { ret false }
    tbl := &db.hir
    params_list := tbl.lhs(func_node)
    if params_list == hir_none() { ret false }
    args := db.get_list(params_list)
    if args.len == 0 { ret false }
    arg0 := *(args.ptr + 0)
    ident := tbl.lhs(arg0)
    if ident == hir_none() { ret false }
    db.interner.get(tbl.lhs(ident)).eq(Str.of("self"))
}


synth_func :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    if db.get_const_type(id) != ty_id_none() {
        ret
    }

    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }

    params_list_id := (tbl).lhs(id)
    ret_hir_id     := (tbl).rhs(id)
    body_id        := (tbl).extra(id)

    sym_id := db.get_hir_symbol(id)
    is_extern := (body_id == hir_none()) and (sym_id != id_none()) and (db.sym_tok_start.get(sym_id) != id_none())

    params_vec := Vec(u32).new()
    if params_list_id != hir_none() {
        args := db.get_list(params_list_id)
        i: u64 = 0
        while i < args.len {
            arg_id := *(args.ptr + i)
            ty_node := (tbl).rhs(arg_id)
            param_ty := ty_id_none()
            if ty_node != hir_none() {
                param_ty = synth_type_node(eng, ty_node)
            }

            if param_ty == ty_id_none() {
                arg_ident := (tbl).lhs(arg_id)
                if arg_ident != hir_none() {
                    arg_slot := (unify_ptr).get_slot(arg_ident)
                    if arg_slot != slot_none() {
                        param_ty = (unify_ptr).resolve_type(arg_slot)
                    }
                }
            }

            if param_ty == ty_id_none() {
                print(c"\n[type error] unresolved parameter type\n       --> ")
                db.print_loc(arg_id)
                print(c"\n")
                fall()
            }
            if param_ty == ty_id_unit() {
                print(c"\n[type error] unit parameters have no runtime representation\n       --> ")
                db.print_loc(arg_id)
                print(c"\n")
                fall()
            }

            arg_ident := (tbl).lhs(arg_id)
            if param_ty == ty_id_type() {
                t_slot := (unify_ptr).get_slot(arg_ident)
                if t_slot == slot_none() {
                    t_slot = (unify_ptr).new_slot(arg_ident)
                }
                t_infer := (&(*types_ptr)).alloc_infer(t_slot)
                if arg_ident != hir_none() {
                    db.set_const_type(arg_ident, t_infer)
                }
                db.set_const_type(arg_id, t_infer)
            } else {
                if arg_ident != hir_none() {
                    ident_slot := (unify_ptr).get_slot(arg_ident)
                    if ident_slot == slot_none() {
                        ident_slot = (unify_ptr).new_slot(arg_ident)
                    }
                    (&(*db).unify).bind_type(&(*db).types, ident_slot, param_ty)
                    db.set_const_type(arg_ident, param_ty)
                }
                db.set_const_type(arg_id, param_ty)
            }

            if arg_ident != hir_none() {
                ident_name := (tbl).lhs(arg_ident)
                if db.interner.get(ident_name).eq(Str.of("self")) {
                    if i != 0 {
                        print(c"\n[type error] self parameter must be the first parameter\n       --> ")
                        db.print_loc(arg_id)
                        print(c"\n")
                        fall()
                    }
                }
            }
            params_vec.push(param_ty)
            i = i + 1
        }
    }

    ret_ty := ty_id_unit()
    if ret_hir_id != hir_none() {
        val := synth_type_node(eng, ret_hir_id)
        if val == ty_id_none() {
            print(c"\n[type error] unresolved return type\n       --> ")
            db.print_loc(ret_hir_id)
            print(c"\n")
            fall()
        }
        ret_ty = val
    }

    slice: Slice(u32) = .{ ptr: 0 as &u32, len: 0 }
    if params_vec.len > 0 {
        slice.ptr = params_vec.ptr_at(0)
        slice.len = params_vec.len
    }

    func_ty := (&(*types_ptr)).alloc_func(slice, ret_ty, is_extern)
    params_vec.destroy()

    if (body_id == hir_none()) and (not is_extern) {
        (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
    } else {
        (&(*db).unify).bind_type(&(*db).types, slot, func_ty)
    }
    db.set_const_type(id, func_ty)

    if body_id != hir_none() {
        scan := id + 1
        while scan <= body_id {
            if (tbl).kind(scan) == hir_kind.function {
                inner_body := (tbl).extra(scan)
                if inner_body != hir_none() {
                    scan = inner_body
                }
            } else if ((tbl).kind(scan) == hir_kind.k_ret) and ((tbl).rhs(scan) == hir_none()) {
                (tbl).set_rhs(scan, id)
            }
            scan = scan + 1
        }
    }

    sym_id := db.get_hir_symbol(id)
    if sym_id != id_none() {
        sym_hir := db.get_sym_hir(sym_id)
        if (sym_hir != id_none()) and (sym_hir != id) {
            sym_slot := (&(*db).unify).get_slot(sym_hir)
            if sym_slot == slot_none() {
                sym_slot = (&(*db).unify).new_slot(sym_hir)
            }
            (&(*db).unify).union(&(*db).types, sym_slot, slot)
            db.set_const_type(sym_hir, func_ty)
        }
        db.set_sym_hir(sym_id, id)
    }
}

synth_return :: fn(db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)
    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_never())

    fn_id := (tbl).rhs(id)
    if fn_id == hir_none() { ret }

    func_ty := db.get_const_type(fn_id)
    ret_ty := ty_id_unit()
    if func_ty != ty_id_none() {
        ret_ty = (&(*types_ptr)).func_return(func_ty)
    }

    val_id := (tbl).lhs(id)
    if val_id != hir_none() {
        check_value(db, val_id, ret_ty)
        val_slot := (unify_ptr).get_slot(val_id)
        if val_slot != slot_none() {
            (&(*db).unify).bind_type(&(*db).types, val_slot, ret_ty)
        }
    } else {
        if ret_ty != ty_id_unit() {
            print(c"\n\033[1;31m[type error]\033[0m return with no value in function returning non-unit\n       --> ")
            db.print_loc(id)
            print(c"\n")
            fall()
        }
    }
}


report_arg_count_error :: fn(db &Nexus, id u32, callee u32, params_len u64, args_len u64, lhs_is_instance bool, type_params_count u32) {
    tbl := &db.hir
    expected := params_len
    actual := args_len
    if lhs_is_instance {
        expected = expected - 1
    }
    print(c"\n\033[1;31m[type error]\033[0m ")
    if (type_params_count == 0) and ((tbl).kind(callee) == hir_kind.member) {
        print(c"method '")
        name_node := (tbl).rhs(callee)
        name_id := (tbl).lhs(name_node)
        db.interner.get(name_id).print()
        print(c"' expected ")
    } else {
        print(c"function expected ")
    }
    print_u32(expected as u32)
    if type_params_count > 0 {
        print(c" (or ")
        print_u32((expected - (type_params_count as u64)) as u32)
        print(c")")
    }
    print(c" arguments, but got ")
    print_u32(actual as u32)
    print(c"\n       --> ")
    db.print_loc(id)
    print(c"\n\n")
    fall()
}

register_call_mono_sym :: fn(db &Nexus, id u32, callee u32, mono_func_ty u32) {
    db.set_const_type(id, mono_func_ty)
    target_sym := db.get_hir_symbol(callee)
    if target_sym != id_none() {
        target_sym = db.resolve_sym(target_sym)
        mono_sym := db.find_mono_sym(target_sym, mono_func_ty)
        if mono_sym == id_none() {
            db.alloc_mono_sym(target_sym, mono_func_ty)
        }
    }
}

unify_call_arg :: fn(eng &Engine, arg_node u32, expected_ty u32) {
    db := &(*eng).nexus
    unify_ptr := &(*db).unify
    arg_slot := unify_ptr.get_slot(arg_node)
    if arg_slot == slot_none() {
        synth_node(eng, arg_node)
        arg_slot = unify_ptr.get_slot(arg_node)
    }
    if arg_slot != slot_none() {
        check_value(db, arg_node, expected_ty)
        arg_slot = unify_ptr.get_slot(arg_node)
        p_tmp := unify_ptr.tmp_slot()
        unify_ptr.bind_type(&(*db).types, p_tmp, expected_ty)
        unify_ptr.union(&(*db).types, arg_slot, p_tmp)
    }
    if arg_slot == slot_none() {
        print(c"\n[type error] cannot resolve argument\n       --> ")
        db.print_loc(arg_node)
        print(c"\n")
        fall()
    }
}

check_method_receiver :: fn(db &Nexus, callee u32, params &Slice(u32), lhs_is_instance &bool, is_struct_generic &bool) u64 {
    tbl := &db.hir
    types_ptr := &db.types
    unify_ptr := &db.unify
    if tbl.kind(callee) != hir_kind.member { ret 0 }
    callee_lhs := tbl.lhs(callee)
    m_sym := db.get_hir_symbol(callee)
    if m_sym == id_none() { ret 0 }
    callee_fn := db.get_fn_node(m_sym)
    if func_has_self(db, callee_fn) {
        lhs_slot := unify_ptr.get_slot(callee_lhs)
        if lhs_slot != slot_none() {
            *lhs_is_instance = unify_ptr.resolve_type_deep(types_ptr, lhs_slot) != ty_id_type()
        }
    }
    lhs_slot := unify_ptr.get_slot(callee_lhs)
    if lhs_slot != slot_none() {
        struct_ty := unify_ptr.resolve_type_deep(types_ptr, lhs_slot)
        if struct_ty == ty_id_type() {
            struct_ty = db.get_const_type(callee_lhs)
        } else {
            while types_ptr.kind(struct_ty) == TyKind.ptr {
                struct_ty = types_ptr.payload(struct_ty)
            }
        }
        if struct_ty != ty_id_none() {
            if types_ptr.kind(struct_ty) == TyKind.nominal {
                s_origin := types_ptr.nominal_origin(struct_ty)
                if types_ptr.get_nominal_creator_sym(s_origin) != ty_id_none() {
                    *is_struct_generic = true
                }
            }
        }
    }
    if *lhs_is_instance {
        base_lhs := unify_ptr.resolve_type_deep(types_ptr, unify_ptr.get_slot(callee_lhs))
        while types_ptr.kind(base_lhs) == TyKind.ptr {
            base_lhs = types_ptr.payload(base_lhs)
        }
        base_p0 := *(params.ptr + 0)
        while types_ptr.kind(base_p0) == TyKind.ptr {
            base_p0 = types_ptr.payload(base_p0)
        }
        tmp_lhs := unify_ptr.tmp_slot()
        unify_ptr.bind_type(types_ptr, tmp_lhs, base_lhs)
        tmp_p0 := unify_ptr.tmp_slot()
        unify_ptr.bind_type(types_ptr, tmp_p0, base_p0)
        unify_ptr.union(types_ptr, tmp_lhs, tmp_p0)
        ret 1
    }
    0
}

synth_type_func_call :: fn(eng &Engine, id u32, callee u32, callee_ty u32, slot u32, args_vec &Vec(u32), params &Slice(u32), args_len u64) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    types_ptr := &(*db).types
    unify_ptr := &(*db).unify
    leading_types := (&(*types_ptr)).func_leading_type_params(callee_ty)
    omitted_types := (leading_types > 0) and (args_len == params.len - (leading_types as u64))
    if (args_len != params.len) and (not omitted_types) {
        print(c"\n[type error] type function expected ")
        print_u32(params.len as u32)
        print(c" arguments, but got ")
        print_u32(args_len as u32)
        print(c"\n       --> ")
        db.print_loc(id)
        print(c"\n")
        fall()
    }
    concrete_args := Vec(u32).new()
    if omitted_types {
        type_i: u32 = 0
        while type_i < leading_types {
            infer_slot := unify_ptr.tmp_slot()
            concrete_args.push((&(*types_ptr)).alloc_infer(infer_slot))
            type_i = type_i + 1
        }
    }
    if args_vec.len > 0 {
        args := args_vec.as_slice()
        i: u64 = 0
        while i < args.len {
            arg_node := *(args.ptr + i)
            arg_ty := synth_type_node(eng, arg_node)
            arg_slot := unify_ptr.get_slot(arg_node)
            expected_p_ty := ty_id_none()
            if i < params.len {
                expected_p_ty = *(params.ptr + i)
            }
            if expected_p_ty == ty_id_type() {
                if (arg_ty == ty_id_none()) or (arg_slot == slot_none()) {
                    print(c"\n[type error] type function argument must be a type\n       --> ")
                    db.print_loc(arg_node)
                    print(c"\n")
                    fall()
                }
                if (unify_ptr.resolve_type(arg_slot) != ty_id_type()) and (types_ptr.kind(arg_ty) != TyKind.infer) {
                    print(c"\n[type error] type function argument must be a type\n       --> ")
                    db.print_loc(arg_node)
                    print(c"\n")
                    fall()
                }
                concrete_args.push(arg_ty)
            } else {
                if (arg_slot == slot_none()) or (unify_ptr.resolve_type(arg_slot) == ty_id_none()) {
                    synth_node(eng, arg_node)
                    arg_slot = unify_ptr.get_slot(arg_node)
                }
                if (expected_p_ty != ty_id_none()) and (arg_slot != slot_none()) {
                    check_value(db, arg_node, expected_p_ty)
                }
                if db.is_const(arg_node) {
                    val := eval_const(db, arg_node) as u32
                    concrete_args.push(val)
                } else {
                    print(c"\n[type error] type function argument must be a compile-time constant\n       --> ")
                    db.print_loc(arg_node)
                    print(c"\n")
                    fall()
                }
            }
            i = i + 1
        }
    }
    callee_sym := id_none()
    if tbl.kind(callee) == hir_kind.ident {
        sym := db.get_hir_symbol(callee)
        if sym != id_none() { callee_sym = db.resolve_sym(sym) }
    }
    if callee_sym == id_none() { callee_sym = callee | 2147483648 }
    cached := db.find_mono_nominal(callee_sym, concrete_args.as_slice())
    if cached != ty_id_none() {
        concrete_args.destroy()
        db.set_const_type(id, cached)
        unify_ptr.bind_type(types_ptr, slot, ty_id_type())
        db.set_is_const(id, true)
        ret
    }
    spec_ty := specialize_nominal_from_creator(eng, callee_sym, &concrete_args)
    concrete_args.destroy()
    if spec_ty == ty_id_none() {
        print(c"\n[type error] type function did not produce a type\n       --> ")
        db.print_loc(id)
        print(c"\n")
        fall()
    }
    db.set_const_type(id, spec_ty)
    unify_ptr.bind_type(types_ptr, slot, ty_id_type())
    db.set_is_const(id, true)
}

synth_generic_call :: fn(eng &Engine, id u32, callee u32, callee_ty u32, slot u32, args_vec &Vec(u32), params &Slice(u32), args_len u64, param_start u64, lhs_is_instance bool) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    types_ptr := &(*db).types
    unify_ptr := &(*db).unify

    type_params_count: u32 = 0
    tp_idx: u64 = param_start
    while tp_idx < params.len {
        if *(params.ptr + tp_idx) == ty_id_type() { type_params_count = type_params_count + 1 }
        tp_idx = tp_idx + 1
    }
    expected_total := params.len - param_start
    expected_runtime := expected_total - (type_params_count as u64)
    is_explicit := args_len == expected_total
    is_omitted := (type_params_count > 0) and (args_len == expected_runtime)
    if (not is_explicit) and (not is_omitted) {
        report_arg_count_error(db, id, callee, params.len, args_len, lhs_is_instance, type_params_count)
    }

    func_node := id_none()
    c_kind := tbl.kind(callee)
    if (c_kind == hir_kind.ident) or (c_kind == hir_kind.member) {
        sym := db.get_hir_symbol(callee)
        if sym != id_none() { func_node = db.get_fn_node(sym) }
    } else if c_kind == hir_kind.function {
        func_node = callee
    }

    tmpl_slots := Vec(u32).new()
    fresh_slots := Vec(u32).new()
    fn_args_vec := Vec(u32).new()
    fn_args_slice: Slice(u32) = .{ ptr: 0 as &u32, len: 0 }
    if func_node != id_none() {
        fn_params_list := (tbl).lhs(func_node)
        if fn_params_list != hir_none() {
            fn_args := db.get_list(fn_params_list)
            fn_args_vec.extend(fn_args.ptr, fn_args.len)
            fn_args_slice = fn_args_vec.as_slice()
        }
    }
    tp_i: u64 = 0
    while tp_i < params.len {
        if *(params.ptr + tp_i) == ty_id_type() {
            t_slot := slot_none()
            if tp_i < fn_args_slice.len {
                p_arg := *(fn_args_slice.ptr + tp_i)
                t_inf := db.get_const_type(p_arg)
                if t_inf != ty_id_none() { t_slot = (&(*types_ptr)).infer_slot(t_inf) }
            }
            if t_slot == slot_none() {
                p_i: u64 = tp_i
                while p_i < params.len {
                    p_t := *(params.ptr + p_i)
                    if types_ptr.kind(p_t) == TyKind.infer {
                        cand := types_ptr.infer_slot(p_t)
                        found := false
                        chk_i: u64 = 0
                        while chk_i < tmpl_slots.len {
                            if tmpl_slots.get(chk_i) == cand { found = true break }
                            chk_i = chk_i + 1
                        }
                        if not found { t_slot = cand break }
                    }
                    p_i = p_i + 1
                }
            }
            f_slot := unify_ptr.tmp_slot()
            tmpl_slots.push(t_slot)
            fresh_slots.push(f_slot)
        }
        tp_i = tp_i + 1
    }
    ret_ty := (&(*types_ptr)).func_return(callee_ty)
    inst_ret := instantiate_type(eng, ret_ty, &tmpl_slots, &fresh_slots)
    unify_ptr.bind_type(types_ptr, slot, inst_ret)

    args := args_vec.as_slice()
    tp_seen: u64 = 0
    arg_idx: u64 = 0
    p_i: u64 = param_start
    while p_i < params.len {
        param_ty := *(params.ptr + p_i)
        if param_ty == ty_id_type() {
            if is_explicit {
                arg_node := *(args.ptr + arg_idx)
                arg_val := db.get_const_type(arg_node)
                type_slot := unify_ptr.get_slot(arg_node)
                if (arg_val == ty_id_none()) or (type_slot == slot_none()) {
                    print(c"\n[type error] generic type argument must be a type\n       --> ")
                    db.print_loc(arg_node)
                    print(c"\n")
                    fall()
                }
                if unify_ptr.resolve_type(type_slot) != ty_id_type() {
                    print(c"\n[type error] generic type argument must be a type\n       --> ")
                    db.print_loc(arg_node)
                    print(c"\n")
                    fall()
                }
                if arg_val != ty_id_none() {
                    t_target := fresh_slots.get(tp_seen)
                    unify_ptr.bind_type(types_ptr, t_target, arg_val)
                }
                tp_seen = tp_seen + 1
                arg_idx = arg_idx + 1
            }
        } else {
            arg_node := *(args.ptr + arg_idx)
            inst_param := instantiate_type(eng, param_ty, &tmpl_slots, &fresh_slots)
            unify_call_arg(eng, arg_node, inst_param)
            arg_idx = arg_idx + 1
        }
        p_i = p_i + 1
    }
    tp_i = 0
    while tp_i < fresh_slots.len {
        f_s := fresh_slots.get(tp_i)
        r_ty := (unify_ptr).resolve_type_deep(types_ptr, f_s)
        if r_ty == ty_id_untyped_int() {
            r_ty = (&(*types_ptr)).alloc_int(32)
            unify_ptr.bind_type(types_ptr, f_s, r_ty)
        } else if r_ty == ty_id_untyped_float() {
            r_ty = (&(*types_ptr)).alloc_float(64)
            unify_ptr.bind_type(types_ptr, f_s, r_ty)
        }
        tp_i = tp_i + 1
    }
    mono_p_vec := Vec(u32).new()
    tp_seen = 0 as u64
    p_i = 0
    while p_i < params.len {
        if *(params.ptr + p_i) == ty_id_type() {
            param_slot := fresh_slots.get(tp_seen)
            param_ty := (unify_ptr).resolve_type_deep(types_ptr, param_slot)
            if param_ty == ty_id_none() { param_ty = (&(*types_ptr)).alloc_infer(param_slot) }
            mono_p_vec.push(param_ty)
            tp_seen = tp_seen + 1
        } else {
            p_inst := instantiate_type(eng, *(params.ptr + p_i), &tmpl_slots, &fresh_slots)
            mono_p_vec.push(resolve_ty_id(eng, unify_ptr, types_ptr, p_inst))
        }
        p_i = p_i + 1
    }
    final_ret := resolve_ty_id(eng, unify_ptr, types_ptr, inst_ret)
    ptr_m := 0 as &u32
    if mono_p_vec.len > 0 { ptr_m = mono_p_vec.ptr_at(0) }
    m_slice: Slice(u32) = .{ ptr: ptr_m, len: mono_p_vec.len }
    mono_func_ty := (&(*types_ptr)).alloc_func(m_slice, final_ret, false)
    i: u64 = 0
    while i < args.len {
        arg_node := *(args.ptr + i)
        if db.has_union_coerce(arg_node) {
            source_union := db.get_union_coerce_ty(arg_node)
            source_idx := db.get_union_coerce_idx(arg_node)
            source_members := (&(*types_ptr)).union_members(source_union)
            source_ty := resolve_ty_id(eng, unify_ptr, types_ptr, *(source_members.ptr + (source_idx as u64)))
            param_idx: u64 = 0
            if is_omitted {
                scan_p: u64 = param_start
                rt_seen: u64 = 0
                while scan_p < params.len {
                    if *(params.ptr + scan_p) != ty_id_type() {
                        if rt_seen == i { param_idx = scan_p break }
                        rt_seen = rt_seen + 1
                    }
                    scan_p = scan_p + 1
                }
            } else {
                param_idx = i + param_start
            }
            final_params := types_ptr.func_params(mono_func_ty)
            target_ty := *(final_params.ptr + param_idx)
            if types_ptr.kind(target_ty) == TyKind.union_ {
                target_idx := types_ptr.union_member_index(target_ty, source_ty)
                db.set_union_coerce(arg_node, target_ty, target_idx)
            } else {
                db.set_union_coerce(arg_node, ty_id_none(), 0)
            }
            arg_slot := unify_ptr.get_slot(arg_node)
            arg_root := unify_ptr.find(arg_slot)
            unify_ptr.types.set(arg_root as u64, target_ty)
        }
        i = i + 1
    }
    mono_p_vec.destroy()
    fn_args_vec.destroy()
    tmpl_slots.destroy()
    fresh_slots.destroy()
    root := unify_ptr.find(slot)
    unify_ptr.types.set(root as u64, final_ret)
    register_call_mono_sym(db, id, callee, mono_func_ty)
}

synth_call :: fn(eng &Engine, id u32) {
    db := &eng.nexus
    tbl := &db.hir
    unify_ptr := &db.unify
    types_ptr := &db.types
    slot := unify_ptr.get_slot(id)
    if slot == slot_none() { slot = unify_ptr.new_slot(id) }
    callee := tbl.lhs(id)
    callee_slot := unify_ptr.get_slot(callee)
    if callee_slot == slot_none() {
        print(c"\n[type error] cannot resolve call target\n       --> ")
        db.print_loc(callee)
        print(c"\n")
        fall()
    }
    callee_ty := unify_ptr.resolve_type_deep(types_ptr, callee_slot)
    if callee_ty == ty_id_none() { callee_ty = db.get_const_type(callee) }
    if types_ptr.kind(callee_ty) != TyKind.func {
        print(c"\n\033[1;31m[type error]\033[0m cannot call non-function type '")
        types_ptr.print_type(callee_ty)
        print(c"'\n       --> ")
        db.print_loc(callee)
        print(c"\n\n")
        fall()
    }
    params_slice := types_ptr.func_params(callee_ty)
    params_vec := Vec(u32).new()
    params_vec.extend(params_slice.ptr, params_slice.len)
    params := params_vec.as_slice()
    args_vec := Vec(u32).new()
    if (tbl).rhs(id) != hir_none() {
        source_args := db.get_list((tbl).rhs(id))
        args_vec.extend(source_args.ptr, source_args.len)
    }
    args := args_vec.as_slice()
    if (&(*types_ptr)).func_return(callee_ty) == ty_id_type() {
        synth_type_func_call(eng, id, callee, callee_ty, slot, &args_vec, &params, args.len)
    } else {
        lhs_is_instance := false
        is_struct_generic := false
        param_start := check_method_receiver(db, callee, &params, &lhs_is_instance, &is_struct_generic)
        if (&(*types_ptr)).func_has_type_param(callee_ty) {
            synth_generic_call(eng, id, callee, callee_ty, slot, &args_vec, &params, args.len, param_start, lhs_is_instance)
        } else {
            unify_ptr.bind_type(types_ptr, slot, (&(*types_ptr)).func_return(callee_ty))
            if is_struct_generic { register_call_mono_sym(db, id, callee, callee_ty) }
            expected := params.len - param_start
            if args.len != expected { report_arg_count_error(db, id, callee, params.len, args.len, lhs_is_instance, 0) }
            i: u64 = 0
            while i < args.len {
                unify_call_arg(eng, *(args.ptr + i), *(params.ptr + (i + param_start)))
                i = i + 1
            }
        }
    }
    args_vec.destroy()
    params_vec.destroy()
}

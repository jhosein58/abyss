import Nexus from "../../nexus/nexus.a"
import HirTable, hir_kind, hir_none from "../../hir.a"
import SliceU32 from "../../../std/slice/u32.a"
import VecU32 from "../../../std/vec/u32.a"
import Str from "../../../std/string.a"
import TypeStorage, ty_kind, ty_id_none, ty_id_unit, ty_id_never, ty_id_type, ty_id_untyped_int, ty_id_untyped_float from "../../types.a"
import UnifyStorage, slot_none from "../../unify.a"
import id_none from "../../nexus/pool.a"
import Engine from "../../engine.a"
import fall from "../../../std/sys.a"
import synth_type_node from "var.a"
import check_value from "common.a"
import synth_node from "../tyck.a"

print :: (s &u8) unit
print_u32 :: (v u32) unit

method_has_explicit_self :: (db &Nexus, method u32) bool {
    tbl := &(*db).hir
    func_node := (tbl).extra(method)
    if func_node == hir_none() { ret false }
    params_list_id := (tbl).lhs(func_node)
    if params_list_id == hir_none() { ret false }
    args := db.get_list(params_list_id)
    if args.len == 0 { ret false }
    first_arg := *(args.ptr + 0)
    arg_ident := (tbl).lhs(first_arg)
    if arg_ident == hir_none() { ret false }
    name_id := (tbl).lhs(arg_ident)
    name := db.interner.get(name_id)
    name.eq(Str.of("self"))
}

method_has_receiver :: (db &Nexus, method u32) bool {
    if method_has_explicit_self(db, method) {
        ret true
    }
    tbl := &(*db).hir
    node := (tbl).lhs(method)
    while node < method {
        if ((tbl).kind(node) == hir_kind().member) and
           ((tbl).lhs(node) == hir_none()) {
            ret true
        }
        node = node + 1
    }
    false
}

synth_func :: (eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    if db.get_const_type(id) != ty_id_none() {
        ret
    }

    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }

    params_list_id := (tbl).lhs(id)
    ret_hir_id     := (tbl).rhs(id)
    body_id        := (tbl).extra(id)

    sym_id := db.get_hir_symbol(id)
    is_extern := (body_id == hir_none()) and (sym_id != id_none()) and (db.sym_tok_start.get(sym_id) != id_none())

    params_vec := VecU32.new()
    if params_list_id != hir_none() {
        args := db.get_list(params_list_id)
        i: u64 = 0
        while i < args.len {
            arg_id := *(args.ptr + i)
            ty_node := (tbl).rhs(arg_id)
            param_ty := ty_id_none()
            if ty_node != hir_none() {
                param_ty = synth_type_node(eng, ty_node)
            }

            if param_ty == ty_id_none() {
                arg_ident := (tbl).lhs(arg_id)
                if arg_ident != hir_none() {
                    arg_slot := (unify_ptr).get_slot(arg_ident)
                    if arg_slot != slot_none() {
                        param_ty = (unify_ptr).resolve_type(arg_slot)
                    }
                }
            }

            if param_ty == ty_id_none() {
                print(c"\n[type error] unresolved parameter type\n       --> ")
                db.print_loc(arg_id)
                print(c"\n")
                fall()
            }
            if param_ty == ty_id_unit() {
                print(c"\n[type error] unit parameters have no runtime representation\n       --> ")
                db.print_loc(arg_id)
                print(c"\n")
                fall()
            }

            arg_ident := (tbl).lhs(arg_id)
            if param_ty == ty_id_type() {
                t_slot := (unify_ptr).get_slot(arg_ident)
                if t_slot == slot_none() {
                    t_slot = (unify_ptr).new_slot(arg_ident)
                }
                t_infer := (&(*types_ptr)).alloc_infer(t_slot)
                if arg_ident != hir_none() {
                    db.set_const_type(arg_ident, t_infer)
                }
                db.set_const_type(arg_id, t_infer)
            } else {
                if arg_ident != hir_none() {
                    ident_slot := (unify_ptr).get_slot(arg_ident)
                    if ident_slot == slot_none() {
                        ident_slot = (unify_ptr).new_slot(arg_ident)
                    }
                    (&(*db).unify).bind_type(&(*db).types, ident_slot, param_ty)
                    db.set_const_type(arg_ident, param_ty)
                }
                db.set_const_type(arg_id, param_ty)
            }

            if (param_ty == ty_id_type()) and (params_vec.len > 0) {
                previous := params_vec.get(params_vec.len - 1)
                if previous != ty_id_type() {
                    print(c"\n[type error] generic type parameters must precede runtime parameters\n       --> ")
                    db.print_loc(arg_id)
                    print(c"\n")
                    fall()
                }
            }
            params_vec.push(param_ty)
            i = i + 1
        }
    }

    ret_ty := ty_id_unit()
    if ret_hir_id != hir_none() {
        val := synth_type_node(eng, ret_hir_id)
        if val == ty_id_none() {
            print(c"\n[type error] unresolved return type\n       --> ")
            db.print_loc(ret_hir_id)
            print(c"\n")
            fall()
        }
        ret_ty = val
    }

    slice: SliceU32 = .{ ptr: 0 as &u32, len: 0 }
    if params_vec.len > 0 {
        slice.ptr = params_vec.ptr_at(0)
        slice.len = params_vec.len
    }

    func_ty := (&(*types_ptr)).alloc_func(slice, ret_ty, is_extern)
    params_vec.destroy()

    if (body_id == hir_none()) and (not is_extern) {
        (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
    } else {
        (&(*db).unify).bind_type(&(*db).types, slot, func_ty)
    }
    db.set_const_type(id, func_ty)

    sym_id := db.get_hir_symbol(id)
    if sym_id != id_none() {
        sym_hir := db.get_sym_hir(sym_id)
        if sym_hir != id_none() {
            sym_slot := (&(*db).unify).get_slot(sym_hir)
            if sym_slot == slot_none() {
                sym_slot = (&(*db).unify).new_slot(sym_hir)
            }
            (&(*db).unify).union(&(*db).types, sym_slot, slot)
            db.set_const_type(sym_hir, func_ty)
        }
    }
}

find_enclosing_method :: (db &Nexus, node_id u32) u32 {
    owner := db.get_method_owner(node_id)
    if owner == hir_none() { ret hir_none() }
    methods_id := (&(*db).hir).extra(owner)
    if (&(*db).hir).kind(owner) == hir_kind().enum_ {
        if methods_id != hir_none() {
            meta := db.get_list(methods_id)
            methods_id = *(meta.ptr + 1)
        }
    }
    if methods_id == hir_none() { ret hir_none() }
    methods := db.get_list(methods_id)
    i: u64 = 0
    while i < methods.len {
        m := *(methods.ptr + i)
        start := (&(*db).hir).lhs(m)
        if (node_id >= start) and (node_id <= m) {
            ret m
        }
        i = i + 1
    }
    hir_none()
}

method_returns_ref_self :: (db &Nexus, node_id u32) bool {
    owner := db.get_method_owner(node_id)
    if owner == hir_none() { ret false }
    owner_ty := db.get_const_type(owner)
    if owner_ty == ty_id_none() { ret false }

    method := find_enclosing_method(db, node_id)
    if method == hir_none() { ret false }

    if not method_has_receiver(db, method) { ret false }

    func_id := (&(*db).hir).extra(method)
    if (func_id == hir_none()) or ((&(*db).hir).kind(func_id) != hir_kind().function) {
        ret false
    }

    ret_hir := (&(*db).hir).rhs(func_id)
    if ret_hir == hir_none() { ret false }

    ret_ty := db.get_const_type(ret_hir)
    if ret_ty == ty_id_none() { ret false }

    types := &(*db).types
    if (&(*types)).kind(ret_ty) != ty_kind().ptr { ret false }
    (&(*types)).payload(ret_ty) == owner_ty
}

synth_return :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)
    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_never())

    fn_id := (tbl).rhs(id)
    if fn_id == hir_none() { ret }

    func_ty := db.get_const_type(fn_id)
    ret_ty := ty_id_unit()
    if func_ty != ty_id_none() {
        ret_ty = (&(*types_ptr)).func_return(func_ty)
    }

    val_id := (tbl).lhs(id)
    if val_id != hir_none() {
        check_value(db, val_id, ret_ty)
        val_slot := (unify_ptr).get_slot(val_id)
        if val_slot != slot_none() {
            (&(*db).unify).bind_type(&(*db).types, val_slot, ret_ty)
        }
    } else {
        if method_returns_ref_self(db, id) {
            ret
        }
        if ret_ty != ty_id_unit() {
            print(c"\n\033[1;31m[type error]\033[0m return with no value in function returning non-unit\n       --> ")
            db.print_loc(id)
            print(c"\n")
            fall()
        }
    }
}

specialize_nominal_from_creator :: (eng &Engine, callee_sym u32, concrete_args &VecU32) u32 {
    db := &(*eng).nexus
    tbl := &(*db).hir
    types_ptr := &(*db).types

    cached := db.find_mono_nominal(callee_sym, concrete_args.as_slice())
    if cached != ty_id_none() { ret cached }

    func_node := id_none()
    if (callee_sym & 2147483648) != 0 {
        binding_id := callee_sym & 2147483647
        if (tbl).kind(binding_id) == hir_kind().binding {
            func_node = (tbl).extra(binding_id)
        } else if (tbl).kind(binding_id) == hir_kind().function {
            func_node = binding_id
        }
    } else {
        func_node = db.get_sym_hir(callee_sym)
        if (func_node != id_none()) and ((tbl).kind(func_node) != hir_kind().function) {
            hir_end := db.sym_hir_end.get(callee_sym)
            if (hir_end != 0) and (hir_end != id_none()) {
                b_id := hir_end - 1
                if (tbl).kind(b_id) == hir_kind().binding {
                    func_node = (tbl).extra(b_id)
                }
            }
            if (func_node != id_none()) and ((tbl).kind(func_node) != hir_kind().function) {
                scan_i := func_node + 1
                tbl_len := (tbl).len()
                while scan_i < tbl_len {
                    sk := (tbl).kind(scan_i)
                    if (sk == hir_kind().var) or (sk == hir_kind().binding) {
                        if (tbl).lhs(scan_i) == func_node {
                            cand := (tbl).extra(scan_i)
                            if (cand != hir_none()) and ((tbl).kind(cand) == hir_kind().function) {
                                func_node = cand
                                break
                            }
                        }
                    }
                    if scan_i > (func_node + 50) { break }
                    scan_i = scan_i + 1
                }
            }
        }
    }
    if func_node == id_none() { ret ty_id_none() }
    if (*db).type_specialization_depth >= 128 {
        print(c"\n[type error] generic type specialization exceeded recursion limit\n       --> ")
        db.print_loc(func_node)
        print(c"\n")
        fall()
    }
    (*db).type_specialization_depth = (*db).type_specialization_depth + 1

    fn_params_list := (tbl).lhs(func_node)
    fn_params_vec := VecU32.new()
    if fn_params_list != hir_none() {
        fn_params := db.get_list(fn_params_list)
        fn_params_vec.extend(fn_params.ptr, fn_params.len)
    }
    fn_params_slice := fn_params_vec.as_slice()

    body_id := (tbl).extra(func_node)
    struct_node := hir_none()
    if body_id != hir_none() {
        b_kind := (tbl).kind(body_id)
        if b_kind == hir_kind().struct_ {
            struct_node = body_id
        } else if b_kind == hir_kind().block {
            items_list := (tbl).lhs(body_id)
            if items_list != hir_none() {
                items := db.get_list(items_list)
                if items.len > 0 {
                    last_item := *(items.ptr + items.len - 1)
                    if (tbl).kind(last_item) == hir_kind().k_ret {
                        struct_node = (tbl).lhs(last_item)
                    } else {
                        struct_node = last_item
                    }
                }
            }
        }
    }

    if (struct_node != hir_none()) and ((tbl).kind(struct_node) == hir_kind().struct_) {
        nom_origin := (&(*types_ptr)).len() | 2147483648
        nom_name := Str.of("struct")
        if (callee_sym & 2147483648) != 0 {
            binding_id := callee_sym & 2147483647
            if (tbl).kind(binding_id) == hir_kind().binding {
                name_hir := (tbl).lhs(binding_id)
                nom_name = db.interner.get((tbl).lhs(name_hir))
            }
        } else {
            nom_name = db.interner.get(db.sym_names.get(callee_sym))
        }

        nom_ty := (&(*types_ptr)).alloc_nominal(ty_id_none(), nom_name, nom_origin)
        db.set_const_type(struct_node, nom_ty)
        (&(*types_ptr)).record_nominal_struct_node(nom_origin, struct_node)
        db.add_mono_nominal(callee_sym, concrete_args.as_slice(), nom_ty)
        (&(*types_ptr)).record_nominal_creator(nom_origin, callee_sym, concrete_args.as_slice())


        names_list := (tbl).lhs(struct_node)
        types_list := (tbl).rhs(struct_node)
        names := db.get_list(names_list)
        types_nodes := db.get_list(types_list)

        fields_vec := VecU32.new()
        f_i: u64 = 0
        while (f_i < names.len) and (f_i < types_nodes.len) {
            names = db.get_list(names_list)
            types_nodes = db.get_list(types_list)
            f_name_node := *(names.ptr + f_i)
            f_name_id := (tbl).lhs(f_name_node)
            f_ty_node := *(types_nodes.ptr + f_i)
            f_ty := specialize_type_node(eng, f_ty_node, fn_params_slice, concrete_args)
            if (f_ty == ty_id_none()) or (f_ty == ty_id_unit()) or (f_ty == ty_id_type()) {
                print(c"\n[type error] generic struct field requires a runtime value type\n       --> ")
                db.print_loc(f_ty_node)
                print(c"\n")
                fall()
            }
            fields_vec.push(f_name_id)
            fields_vec.push(f_ty)
            f_i = f_i + 1
        }

        f_ptr := 0 as &u32
        if fields_vec.len > 0 { f_ptr = fields_vec.ptr_at(0) }
        f_slice: SliceU32 = .{ ptr: f_ptr, len: fields_vec.len }
        structural_ty := (&(*types_ptr)).alloc_struct(f_slice)
        fields_vec.destroy()

        base_idx := (&(*types_ptr)).payload(nom_ty)
        (*types_ptr).store.extra.set(base_idx as u64, structural_ty)

        p_i: u64 = 0
        while p_i < fn_params_slice.len {
            if p_i < concrete_args.len {
                p_arg := *(fn_params_slice.ptr + p_i)
                p_ident := (tbl).lhs(p_arg)
                arg_val := concrete_args.get(p_i)
                if p_ident != hir_none() {
                    type_slot := (&(*db).unify).new_slot(p_ident)
                    (&(*db).unify).bind_type(&(*db).types, type_slot, ty_id_type())
                    db.set_const_type(p_ident, arg_val)
                }
                db.set_const_type(p_arg, arg_val)
            }
            p_i = p_i + 1
        }
        fn_params_vec.destroy()
        (*db).type_specialization_depth = (*db).type_specialization_depth - 1
        ret nom_ty
    }

    if struct_node != hir_none() {
        res_ty := specialize_type_node(eng, struct_node, fn_params_slice, concrete_args)
        db.add_mono_nominal(callee_sym, concrete_args.as_slice(), res_ty)
        fn_params_vec.destroy()
        (*db).type_specialization_depth = (*db).type_specialization_depth - 1
        ret res_ty
    }

    fn_params_vec.destroy()
    (*db).type_specialization_depth = (*db).type_specialization_depth - 1
    ty_id_none()
}

specialize_type_node :: (eng &Engine, ty_node u32, fn_params SliceU32, concrete_args &VecU32) u32 {
    params_vec := VecU32.new()
    params_vec.extend(fn_params.ptr, fn_params.len)
    result := specialize_type_node_inner(eng, ty_node, params_vec.as_slice(), concrete_args)
    params_vec.destroy()
    result
}

specialize_type_node_inner :: (eng &Engine, ty_node u32, fn_params SliceU32, concrete_args &VecU32) u32 {
    if ty_node == hir_none() { ret ty_id_none() }
    db := &(*eng).nexus
    tbl := &(*db).hir
    k := hir_kind()
    curr := (tbl).kind(ty_node)

    if curr == k.ident {
        ty_name_id := (tbl).lhs(ty_node)
        ty_name := db.interner.get(ty_name_id)
        if ty_name.eq(Str.of("Self")) {
            owner := db.get_method_owner(ty_node)
            if owner != hir_none() {
                ret db.get_const_type(owner)
            }
        }
        p_i: u64 = 0
        while p_i < fn_params.len {
            param_arg := *(fn_params.ptr + p_i)
            param_ident := (tbl).lhs(param_arg)
            if param_ident != hir_none() {
                if (db.get_hir_symbol(param_ident) != id_none()) and
                   (db.get_hir_symbol(param_ident) == db.get_hir_symbol(ty_node)) {
                    if p_i < concrete_args.len {
                        ret concrete_args.get(p_i)
                    }
                }
            }
            p_i = p_i + 1
        }
        ret synth_type_node(eng, ty_node)
    }

    if curr == k.binary_bit_or {
        lhs_ty := specialize_type_node(eng, (tbl).lhs(ty_node), fn_params, concrete_args)
        rhs_ty := specialize_type_node(eng, (tbl).rhs(ty_node), fn_params, concrete_args)
        if (lhs_ty != ty_id_none()) and (rhs_ty != ty_id_none()) {
            ret (&(*db).types).make_union_2(lhs_ty, rhs_ty)
        }
    }

    if curr == k.function {
        params_vec := VecU32.new()
        params_list := (tbl).lhs(ty_node)
        if params_list != hir_none() {
            count := db.get_list(params_list).len
            i: u64 = 0
            while i < count {
                args := db.get_list(params_list)
                arg := *(args.ptr + i)
                param_ty := specialize_type_node(eng, (tbl).rhs(arg), fn_params, concrete_args)
                params_vec.push(param_ty)
                i = i + 1
            }
        }
        ret_ty := ty_id_unit()
        ret_node := (tbl).rhs(ty_node)
        if ret_node != hir_none() {
            ret_ty = specialize_type_node(eng, ret_node, fn_params, concrete_args)
        }
        result := (&(*db).types).alloc_func(params_vec.as_slice(), ret_ty, false)
        params_vec.destroy()
        ret result
    }

    if curr == k.unary_addr_of {
        child := (tbl).lhs(ty_node)
        child_ty := specialize_type_node(eng, child, fn_params, concrete_args)
        if child_ty != ty_id_none() {
            ret (&(*db).types).alloc_ptr(child_ty)
        }
    }

    if curr == k.call {
        callee := (tbl).lhs(ty_node)
        args_list_id := (tbl).rhs(ty_node)
        sub_concrete := VecU32.new()
        if args_list_id != hir_none() {
            args := db.get_list(args_list_id)
            i: u64 = 0
            while i < args.len {
                sub_arg := *(args.ptr + i)
                sub_ty := specialize_type_node(eng, sub_arg, fn_params, concrete_args)
                sub_concrete.push(sub_ty)
                i = i + 1
            }
        }
        callee_sym := id_none()
        if (tbl).kind(callee) == k.ident {
            sym := db.get_hir_symbol(callee)
            if sym != id_none() {
                real_s := sym
                while true {
                    tgt := db.sym_target.get(real_s)
                    if (tgt == id_none()) or (tgt == real_s) { break }
                    real_s = tgt
                }
                callee_sym = real_s
            }
        }
        if callee_sym != id_none() {
            cached := db.find_mono_nominal(callee_sym, sub_concrete.as_slice())
            if cached != ty_id_none() {
                sub_concrete.destroy()
                ret cached
            }
            spec := specialize_nominal_from_creator(eng, callee_sym, &sub_concrete)
            sub_concrete.destroy()
            if spec != ty_id_none() {
                ret spec
            }
        } else {
            sub_concrete.destroy()
        }
        ret synth_type_node(eng, ty_node)
    }

    synth_type_node(eng, ty_node)
}

instantiate_type :: (eng &Engine, ty u32, tmpl_slots &VecU32, fresh_slots &VecU32) u32 {
    if ty == ty_id_none() { ret ty_id_none() }
    db := &(*eng).nexus
    types := &(*db).types
    k := ty_kind()
    kind := (&(*types)).kind(ty)

    if kind == k.infer {
        slot := (&(*types)).infer_slot(ty)
        i: u64 = 0
        while i < tmpl_slots.len {
            if tmpl_slots.get(i) == slot {
                fresh := fresh_slots.get(i)
                resolved := (&(*db).unify).resolve_type_deep(types, fresh)
                if resolved != ty_id_none() { ret resolved }
                ret (&(*types)).alloc_infer(fresh)
            }
            i = i + 1
        }
        ret ty
    }

    if kind == k.ptr {
        inner := (&(*types)).payload(ty)
        inst_inner := instantiate_type(eng, inner, tmpl_slots, fresh_slots)
        ret (&(*types)).alloc_ptr(inst_inner)
    }

    if kind == k.array {
        inner := (&(*types)).get_array_type(ty)
        len := (&(*types)).get_array_len(ty)
        inst_inner := instantiate_type(eng, inner, tmpl_slots, fresh_slots)
        ret (&(*types)).alloc_array(inst_inner, len)
    }

    if kind == k.func {
        params := (&(*types)).func_params(ty)
        ret_ty := (&(*types)).func_return(ty)
        is_ext := (&(*types)).func_is_extern(ty)

        source_params := VecU32.new()
        source_params.extend(params.ptr, params.len)
        params = source_params.as_slice()
        inst_ret := instantiate_type(eng, ret_ty, tmpl_slots, fresh_slots)
        p_vec := VecU32.new()
        p_i: u64 = 0
        while p_i < params.len {
            p_vec.push(instantiate_type(eng, *(params.ptr + p_i), tmpl_slots, fresh_slots))
            p_i = p_i + 1
        }
        ptr_p := 0 as &u32
        if p_vec.len > 0 { ptr_p = p_vec.ptr_at(0) }
        slice: SliceU32 = .{ ptr: ptr_p, len: p_vec.len }
        new_fn := (&(*types)).alloc_func(slice, inst_ret, is_ext)
        p_vec.destroy()
        source_params.destroy()
        ret new_fn
    }

    if kind == k.union_ {
        count := (&(*types)).union_members(ty).len
        result := ty_id_none()
        i: u64 = 0
        while i < count {
            members := (&(*types)).union_members(ty)
            member := instantiate_type(eng, *(members.ptr + i), tmpl_slots, fresh_slots)
            if result == ty_id_none() {
                result = member
            } else {
                result = (&(*types)).make_union_2(result, member)
            }
            i = i + 1
        }
        ret result
    }

    if kind == k.nominal {
        orig := (&(*types)).nominal_origin(ty)
        creator_sym := (&(*types)).get_nominal_creator_sym(orig)
        if creator_sym != ty_id_none() {
            creator_args := (&(*types)).get_nominal_creator_args(orig)
            new_args := VecU32.new()
            changed := false
            c_i: u64 = 0
            while c_i < creator_args.len {
                creator_args = (&(*types)).get_nominal_creator_args(orig)
                c_arg := *(creator_args.ptr + c_i)
                new_arg := instantiate_type(eng, c_arg, tmpl_slots, fresh_slots)
                if new_arg != c_arg { changed = true }
                new_args.push(new_arg)
                c_i = c_i + 1
            }
            if changed {
                cached := db.find_mono_nominal(creator_sym, new_args.as_slice())
                if cached != ty_id_none() {
                    new_args.destroy()
                    ret cached
                }
                spec_ty := specialize_nominal_from_creator(eng, creator_sym, &new_args)
                new_args.destroy()
                ret spec_ty
            }
            new_args.destroy()
        }
        ret ty
    }

    ty
}

resolve_ty_id :: (eng &Engine, unify_ptr &UnifyStorage, types &TypeStorage, ty u32) u32 {
    db := &(*eng).nexus
    k := ty_kind()
    kind := (&(*types)).kind(ty)
    if kind == k.infer {
        s := (&(*types)).infer_slot(ty)
        resolved := (unify_ptr).resolve_type_deep(types, s)
        if resolved == ty_id_none() { ret ty }
        if resolved == ty_id_untyped_int() {
            resolved = (&(*types)).alloc_int(32)
            unify_ptr.bind_type(types, s, resolved)
        } else if resolved == ty_id_untyped_float() {
            resolved = (&(*types)).alloc_float(64)
            unify_ptr.bind_type(types, s, resolved)
        }
        ret resolve_ty_id(eng, unify_ptr, types, resolved)
    }
    if kind == k.ptr {
        inner := (&(*types)).payload(ty)
        res_inner := resolve_ty_id(eng, unify_ptr, types, inner)
        ret (&(*types)).alloc_ptr(res_inner)
    }
    if kind == k.array {
        inner := (&(*types)).get_array_type(ty)
        len := (&(*types)).get_array_len(ty)
        res_inner := resolve_ty_id(eng, unify_ptr, types, inner)
        ret (&(*types)).alloc_array(res_inner, len)
    }
    if kind == k.union_ {
        count := (&(*types)).union_members(ty).len
        result := ty_id_none()
        i: u64 = 0
        while i < count {
            members := (&(*types)).union_members(ty)
            member := resolve_ty_id(eng, unify_ptr, types, *(members.ptr + i))
            if result == ty_id_none() {
                result = member
            } else {
                result = (&(*types)).make_union_2(result, member)
            }
            i = i + 1
        }
        ret result
    }
    if kind == k.func {
        count := (&(*types)).func_params(ty).len
        ret_ty := resolve_ty_id(eng, unify_ptr, types, (&(*types)).func_return(ty))
        params_vec := VecU32.new()
        i: u64 = 0
        while i < count {
            params := (&(*types)).func_params(ty)
            params_vec.push(resolve_ty_id(eng, unify_ptr, types, *(params.ptr + i)))
            i = i + 1
        }
        result := (&(*types)).alloc_func(params_vec.as_slice(), ret_ty, (&(*types)).func_is_extern(ty))
        params_vec.destroy()
        ret result
    }
    if kind == k.nominal {
        orig := (&(*types)).nominal_origin(ty)
        creator_sym := (&(*types)).get_nominal_creator_sym(orig)
        if creator_sym != ty_id_none() {
            creator_args := (&(*types)).get_nominal_creator_args(orig)
            res_args := VecU32.new()
            changed := false
            c_i: u64 = 0
            while c_i < creator_args.len {
                creator_args = (&(*types)).get_nominal_creator_args(orig)
                c_arg := *(creator_args.ptr + c_i)
                new_arg := resolve_ty_id(eng, unify_ptr, types, c_arg)
                if new_arg != c_arg { changed = true }
                res_args.push(new_arg)
                c_i = c_i + 1
            }
            if changed {
                cached := db.find_mono_nominal(creator_sym, res_args.as_slice())
                if cached != ty_id_none() {
                    res_args.destroy()
                    ret cached
                }
                spec_ty := specialize_nominal_from_creator(eng, creator_sym, &res_args)
                res_args.destroy()
                ret spec_ty
            }
            res_args.destroy()
        }
        ret ty
    }
    ty
}

synth_call :: (eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }
    callee := (tbl).lhs(id)
    callee_kind := (tbl).kind(callee)



    callee_slot := (unify_ptr).get_slot(callee)

    if callee_slot == slot_none() {
        print(c"\n[type error] cannot resolve call target\n       --> ")
        db.print_loc(callee)
        print(c"\n")
        fall()
    }
    if callee_slot != slot_none() {
        callee_ty := (unify_ptr).resolve_type_deep(types_ptr, callee_slot)

        if (&(*types_ptr)).kind(callee_ty) != ty_kind().func {
            print(c"\n\033[1;31m[type error]\033[0m cannot call non-function type '")
            (&(*types_ptr)).print_type(callee_ty)
            print(c"'\n       --> ")
            db.print_loc(callee)
            print(c"\n\n")
            fall()
        }

        if (&(*types_ptr)).kind(callee_ty) == ty_kind().func {
            args_list_id := (tbl).rhs(id)
            params := (&(*types_ptr)).func_params(callee_ty)
            params_vec := VecU32.new()
            params_vec.extend(params.ptr, params.len)
            params = params_vec.as_slice()
            args_vec := VecU32.new()
            if args_list_id != hir_none() {
                source_args := db.get_list(args_list_id)
                args_vec.extend(source_args.ptr, source_args.len)
            }
            args_len: u64 = 0
            if args_list_id != hir_none() {
                args := args_vec.as_slice()
                args_len = args.len
            }

            ret_ty_check := (&(*types_ptr)).func_return(callee_ty)
            if ret_ty_check == ty_id_type() {
                leading_types := (&(*types_ptr)).func_leading_type_params(callee_ty)
                omitted_types := (leading_types > 0) and
                    (args_len == params.len - (leading_types as u64))
                if (args_len != params.len) and (not omitted_types) {
                    print(c"\n[type error] type function expected ")
                    print_u32(params.len as u32)
                    print(c" arguments, but got ")
                    print_u32(args_len as u32)
                    print(c"\n       --> ")
                    db.print_loc(id)
                    print(c"\n")
                    fall()
                }
                concrete_args := VecU32.new()
                if omitted_types {
                    type_i: u32 = 0
                    while type_i < leading_types {
                        infer_slot := unify_ptr.tmp_slot()
                        concrete_args.push((&(*types_ptr)).alloc_infer(infer_slot))
                        type_i = type_i + 1
                    }
                }
                if args_list_id != hir_none() {
                    args := args_vec.as_slice()
                    i: u64 = 0
                    while i < args.len {
                        arg_node := *(args.ptr + i)
                        arg_ty := synth_type_node(eng, arg_node)
                        arg_slot := unify_ptr.get_slot(arg_node)
                        if (arg_ty == ty_id_none()) or (arg_slot == slot_none()) {
                            print(c"\n[type error] type function argument must be a type\n       --> ")
                            db.print_loc(arg_node)
                            print(c"\n")
                            fall()
                        }
                        if (unify_ptr.resolve_type(arg_slot) != ty_id_type()) and
                           ((&(*types_ptr)).kind(arg_ty) != ty_kind().infer) {
                            print(c"\n[type error] type function argument must be a type\n       --> ")
                            db.print_loc(arg_node)
                            print(c"\n")
                            fall()
                        }
                        concrete_args.push(arg_ty)
                        i = i + 1
                    }
                }
                callee_sym := id_none()
                if callee_kind == hir_kind().ident {
                    sym := db.get_hir_symbol(callee)
                    if sym != id_none() {
                        real_s := sym
                        while true {
                            tgt := db.sym_target.get(real_s)
                            if (tgt == id_none()) or (tgt == real_s) { break }
                            real_s = tgt
                        }
                        callee_sym = real_s
                    }
                }
                if callee_sym == id_none() {
                    callee_sym = callee | 2147483648
                }
                cached := db.find_mono_nominal(callee_sym, concrete_args.as_slice())
                if cached != ty_id_none() {
                    concrete_args.destroy()
                    db.set_const_type(id, cached)
                    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
                    args_vec.destroy()
                    params_vec.destroy()
                    ret
                }
                spec_ty := specialize_nominal_from_creator(eng, callee_sym, &concrete_args)
                concrete_args.destroy()
                if spec_ty == ty_id_none() {
                    print(c"\n[type error] type function did not produce a type\n       --> ")
                    db.print_loc(id)
                    print(c"\n")
                    fall()
                }
                db.set_const_type(id, spec_ty)
                (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
                args_vec.destroy()
                params_vec.destroy()
                ret
            }

            is_generic := (&(*types_ptr)).func_has_type_param(callee_ty)
            leading_tp := (&(*types_ptr)).func_leading_type_params(callee_ty)

            is_explicit := args_len == params.len
            is_omitted := is_generic and (leading_tp > 0) and (args_len == (params.len - (leading_tp as u64)))

            if is_generic {
                if (not is_explicit) and (not is_omitted) {
                    print(c"\n\033[1;31m[type error]\033[0m function expected ")
                    print_u32(params.len as u32)
                    print(c" (or ")
                    print_u32((params.len - (leading_tp as u64)) as u32)
                    print(c") arguments, but got ")
                    print_u32(args_len as u32)
                    print(c"\n       --> ")
                    db.print_loc(id)
                    print(c"\n\n")
                    fall()
                }

                func_node := id_none()
                if callee_kind == hir_kind().ident {
                    sym := db.get_hir_symbol(callee)
                    if sym != id_none() {
                        real_s := sym
                        while true {
                            tgt := db.sym_target.get(real_s)
                            if (tgt == id_none()) or (tgt == real_s) { break }
                            real_s = tgt
                        }
                        func_node = db.get_sym_hir(real_s)
                        if (func_node != id_none()) and ((tbl).kind(func_node) != hir_kind().function) {
                            hir_end := db.sym_hir_end.get(real_s)
                            if (hir_end != 0) and (hir_end != id_none()) {
                                b_id := hir_end - 1
                                if (tbl).kind(b_id) == hir_kind().binding {
                                    func_node = (tbl).extra(b_id)
                                }
                            }
                            if (func_node != id_none()) and ((tbl).kind(func_node) != hir_kind().function) {
                                scan_i := func_node + 1
                                tbl_len := (tbl).len()
                                while scan_i < tbl_len {
                                    sk := (tbl).kind(scan_i)
                                    if (sk == hir_kind().var) or (sk == hir_kind().binding) {
                                        if (tbl).lhs(scan_i) == func_node {
                                            cand := (tbl).extra(scan_i)
                                            if (cand != hir_none()) and ((tbl).kind(cand) == hir_kind().function) {
                                                func_node = cand
                                                break
                                            }
                                        }
                                    }
                                    if scan_i > (func_node + 50) { break }
                                    scan_i = scan_i + 1
                                }
                            }
                        }
                    }
                } else if callee_kind == hir_kind().function {
                    func_node = callee
                } else if callee_kind == hir_kind().member {
                    m := db.get_method_target(callee)
                    if m != id_none() {
                        func_node = (tbl).extra(m)
                    }
                }

                tmpl_slots := VecU32.new()
                fresh_slots := VecU32.new()

                fn_args_vec := VecU32.new()
                fn_args_slice: SliceU32 = .{ ptr: 0 as &u32, len: 0 }
                if func_node != id_none() {
                    fn_params_list := (tbl).lhs(func_node)
                    if fn_params_list != hir_none() {
                        fn_args := db.get_list(fn_params_list)
                        fn_args_vec.extend(fn_args.ptr, fn_args.len)
                        fn_args_slice = fn_args_vec.as_slice()
                    }
                }

                tp_i: u64 = 0
                while tp_i < (leading_tp as u64) {
                    t_slot := slot_none()
                    if tp_i < fn_args_slice.len {
                        p_arg := *(fn_args_slice.ptr + tp_i)
                        t_inf := db.get_const_type(p_arg)
                        if t_inf != ty_id_none() {
                            t_slot = (&(*types_ptr)).infer_slot(t_inf)
                        }
                    }
                    if t_slot == slot_none() {
                        p_i: u64 = tp_i
                        while p_i < params.len {
                            p_t := *(params.ptr + p_i)
                            if (&(*types_ptr)).kind(p_t) == ty_kind().infer {
                                cand := (&(*types_ptr)).infer_slot(p_t)
                                found := false
                                chk_i: u64 = 0
                                while chk_i < tmpl_slots.len {
                                    if tmpl_slots.get(chk_i) == cand { found = true break }
                                    chk_i = chk_i + 1
                                }
                                if not found {
                                    t_slot = cand
                                    break
                                }
                            }
                            p_i = p_i + 1
                        }
                    }
                    f_slot := unify_ptr.tmp_slot()
                    tmpl_slots.push(t_slot)
                    fresh_slots.push(f_slot)
                    tp_i = tp_i + 1
                }

                ret_ty := (&(*types_ptr)).func_return(callee_ty)
                inst_ret := instantiate_type(eng, ret_ty, &tmpl_slots, &fresh_slots)
                (&(*db).unify).bind_type(&(*db).types, slot, inst_ret)

                args := args_vec.as_slice()
                if is_explicit {
                    i: u64 = 0
                    while i < args.len {
                        arg_node := *(args.ptr + i)
                        if i < (leading_tp as u64) {
                            arg_val := db.get_const_type(arg_node)
                            type_slot := unify_ptr.get_slot(arg_node)
                            if (arg_val == ty_id_none()) or (type_slot == slot_none()) {
                                print(c"\n[type error] generic type argument must be a type\n       --> ")
                                db.print_loc(arg_node)
                                print(c"\n")
                                fall()
                            }
                            if unify_ptr.resolve_type(type_slot) != ty_id_type() {
                                print(c"\n[type error] generic type argument must be a type\n       --> ")
                                db.print_loc(arg_node)
                                print(c"\n")
                                fall()
                            }
                            if arg_val != ty_id_none() {
                                t_target := fresh_slots.get(i)
                                (&(*db).unify).bind_type(&(*db).types, t_target, arg_val)
                            }
                        } else {
                            inst_param := instantiate_type(eng, *(params.ptr + i), &tmpl_slots, &fresh_slots)
                            arg_slot := (unify_ptr).get_slot(arg_node)
                            if arg_slot != slot_none() {
                                check_value(db, arg_node, inst_param)
                                arg_slot = (unify_ptr).get_slot(arg_node)
                                p_tmp := unify_ptr.tmp_slot()
                                (&(*db).unify).bind_type(&(*db).types, p_tmp, inst_param)
                                (&(*db).unify).union(&(*db).types, arg_slot, p_tmp)
                            }
                        }
                        i = i + 1
                    }
                } else {
                    i: u64 = 0
                    while i < args.len {
                        arg_node := *(args.ptr + i)
                        p_idx := (leading_tp as u64) + i
                        inst_param := instantiate_type(eng, *(params.ptr + p_idx), &tmpl_slots, &fresh_slots)
                        arg_slot := (unify_ptr).get_slot(arg_node)
                        if arg_slot != slot_none() {
                            check_value(db, arg_node, inst_param)
                            arg_slot = (unify_ptr).get_slot(arg_node)
                            p_tmp := unify_ptr.tmp_slot()
                            (&(*db).unify).bind_type(&(*db).types, p_tmp, inst_param)
                            (&(*db).unify).union(&(*db).types, arg_slot, p_tmp)
                        }
                        i = i + 1
                    }
                }

                tp_i = 0
                while tp_i < fresh_slots.len {
                    f_s := fresh_slots.get(tp_i)
                    r_ty := (unify_ptr).resolve_type_deep(types_ptr, f_s)
                    if r_ty == ty_id_untyped_int() {
                        r_ty = (&(*types_ptr)).alloc_int(32)
                        (&(*db).unify).bind_type(&(*db).types, f_s, r_ty)
                    } else if r_ty == ty_id_untyped_float() {
                        r_ty = (&(*types_ptr)).alloc_float(64)
                        (&(*db).unify).bind_type(&(*db).types, f_s, r_ty)
                    }
                    tp_i = tp_i + 1
                }

                mono_p_vec := VecU32.new()
                p_i: u64 = 0
                while p_i < params.len {
                    if p_i < (leading_tp as u64) {
                        param_slot := fresh_slots.get(p_i)
                        param_ty := (unify_ptr).resolve_type_deep(types_ptr, param_slot)
                        if param_ty == ty_id_none() { param_ty = (&(*types_ptr)).alloc_infer(param_slot) }
                        mono_p_vec.push(param_ty)
                    } else {
                        p_inst := instantiate_type(eng, *(params.ptr + p_i), &tmpl_slots, &fresh_slots)
                        mono_p_vec.push(resolve_ty_id(eng, unify_ptr, types_ptr, p_inst))
                    }
                    p_i = p_i + 1
                }
                final_ret := resolve_ty_id(eng, unify_ptr, types_ptr, inst_ret)
                ptr_m := 0 as &u32
                if mono_p_vec.len > 0 { ptr_m = mono_p_vec.ptr_at(0) }
                m_slice: SliceU32 = .{ ptr: ptr_m, len: mono_p_vec.len }
                mono_func_ty := (&(*types_ptr)).alloc_func(m_slice, final_ret, false)
                i: u64 = 0
                while i < args.len {
                    arg_node := *(args.ptr + i)
                    if db.has_union_coerce(arg_node) {
                        source_union := db.get_union_coerce_ty(arg_node)
                        source_idx := db.get_union_coerce_idx(arg_node)
                        source_members := (&(*types_ptr)).union_members(source_union)
                        source_ty := resolve_ty_id(eng, unify_ptr, types_ptr, *(source_members.ptr + (source_idx as u64)))
                        param_idx := i
                        if is_omitted { param_idx = param_idx + (leading_tp as u64) }
                        final_params := (&(*types_ptr)).func_params(mono_func_ty)
                        target_ty := *(final_params.ptr + param_idx)
                        if (&(*types_ptr)).kind(target_ty) == ty_kind().union_ {
                            target_idx := (&(*types_ptr)).union_member_index(target_ty, source_ty)
                            db.set_union_coerce(arg_node, target_ty, target_idx)
                        } else {
                            db.set_union_coerce(arg_node, ty_id_none(), 0)
                        }
                        arg_slot := unify_ptr.get_slot(arg_node)
                        arg_root := unify_ptr.find(arg_slot)
                        (*unify_ptr).types.set(arg_root as u64, target_ty)
                    }
                    i = i + 1
                }
                mono_p_vec.destroy()
                fn_args_vec.destroy()
                tmpl_slots.destroy()
                fresh_slots.destroy()
                root := (unify_ptr).find(slot)
                (*unify_ptr).types.set(root as u64, final_ret)

                db.set_const_type(id, mono_func_ty)
            } else {
                ret_ty := (&(*types_ptr)).func_return(callee_ty)
                (&(*db).unify).bind_type(&(*db).types, slot, ret_ty)

                method := db.get_method_target(callee)
                has_expl_self := false
                if method != id_none() {
                    has_expl_self = method_has_explicit_self(db, method)
                }

                callee_lhs := hir_none()
                if (tbl).kind(callee) == hir_kind().member {
                    callee_lhs = (tbl).lhs(callee)
                }

                lhs_is_instance := false
                if (callee_lhs != hir_none()) and has_expl_self {
                    lhs_slot := (unify_ptr).get_slot(callee_lhs)
                    if lhs_slot != slot_none() {
                        lhs_ty := (unify_ptr).resolve_type_deep(types_ptr, lhs_slot)
                        if lhs_ty != ty_id_type() {
                            lhs_is_instance = true
                        }
                    }
                }

                expected_len := params.len
                param_offset: u64 = 0
                if lhs_is_instance {
                    expected_len = params.len - 1
                    param_offset = 1
                    check_value(db, callee_lhs, *(params.ptr + 0))
                }

                if args_len != expected_len {
                    print(c"\n\033[1;31m[type error]\033[0m ")
                    if method != id_none() {
                        print(c"method '")
                        name_node := (tbl).lhs(method)
                        name_id := (tbl).lhs(name_node)
                        db.interner.get(name_id).print()
                        print(c"' expected ")
                    } else {
                        print(c"function expected ")
                    }
                    print_u32(expected_len as u32)
                    print(c" arguments, but got ")
                    print_u32(args_len as u32)
                    print(c"\n       --> ")
                    db.print_loc(id)
                    print(c"\n\n")
                    fall()
                }

                if args_list_id != hir_none() {
                    args := args_vec.as_slice()
                    i: u64 = 0
                    while i < args.len {
                        arg_node := *(args.ptr + i)
                        arg_slot := (unify_ptr).get_slot(arg_node)
                        param_ty := *(params.ptr + param_offset + i)

                        if arg_slot != slot_none() {
                            check_value(db, arg_node, param_ty)
                            arg_slot = (unify_ptr).get_slot(arg_node)
                            param_slot := unify_ptr.tmp_slot()
                            (&(*db).unify).bind_type(&(*db).types, param_slot, param_ty)
                            (&(*db).unify).union(&(*db).types, arg_slot, param_slot)
                        }
                        if arg_slot == slot_none() {
                            print(c"\n[type error] cannot resolve argument\n       --> ")
                            db.print_loc(arg_node)
                            print(c"\n")
                            fall()
                        }
                        i = i + 1
                    }
                }
            }
            args_vec.destroy()
            params_vec.destroy()
        }
    }
}

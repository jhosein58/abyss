import Nexus from "../../nexus/nexus.a"
import HirTable from "../../hir.a"
import ty_id_untyped_int, ty_id_untyped_float, ty_id_bool, ty_id_none from "../../types.a"
import Engine from "../../engine.a"

synth_lit_int :: (db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)
    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_untyped_int())
}

synth_lit_float :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_untyped_float())
}

synth_lit_bool :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_bool())
}

synth_lit_str :: (eng &Engine, id u32) {
    db := &(*eng).nexus
    slot := (&(*db).unify).new_slot(id)
    str_ty := eng.get_str_type()
    if str_ty != ty_id_none() {
        (&(*db).unify).bind_type(&(*db).types, slot, str_ty)
        db.set_const_type(id, str_ty)
    }
}

synth_lit_char :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    u8_ty := (&(*db).types).alloc_uint(8 as u16)
    (&(*db).unify).bind_type(&(*db).types, slot, u8_ty)
    db.set_const_type(id, u8_ty)
}

synth_lit_cstr :: (db &Nexus, tbl &HirTable, id u32) {
    slot := (&(*db).unify).new_slot(id)
    u8_ty := (&(*db).types).alloc_uint(8 as u16)
    ptr_ty := (&(*db).types).alloc_ptr(u8_ty)
    (&(*db).unify).bind_type(&(*db).types, slot, ptr_ty)
    db.set_const_type(id, ptr_ty)
}

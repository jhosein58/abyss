import Nexus from "../../nexus/nexus.a"
import HirTable, hir_kind, hir_none from "../../hir.a"
import SliceU32 from "../../../std/slice/u32.a"
import VecU32 from "../../../std/vec/u32.a"
import ty_kind, ty_id_none, ty_id_type, ty_id_unit from "../../types.a"
import slot_none from "../../unify.a"
import id_none from "../../nexus/pool.a"
import Engine from "../../engine.a"
import fall from "../../../std/sys.a"
import synth_type_node from "var.a"
import synth_func, method_has_receiver, specialize_type_node from "fn.a"

print :: fn(s &u8) unit

synth_struct :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)

    names_list := (tbl).lhs(id)
    types_list := (tbl).rhs(id)

    names := db.get_list(names_list)
    types := db.get_list(types_list)

    fields_vec := VecU32.new()

    i: u64 = 0
    while (i < names.len) and (i < types.len) {
        name_node := *(names.ptr + i)
        type_node := *(types.ptr + i)

        name_id := (tbl).lhs(name_node)

        j: u64 = 0
        while j < fields_vec.len {
            if fields_vec.get(j) == name_id {
                print(c"\n\033[1;31m[type error]\033[0m duplicate field name\n       --> ")
                db.print_loc(name_node)
                print(c"\n")
                fall()
            }
            j = j + 2
        }

        ty_val := db.get_const_type(type_node)
        if ty_val == ty_id_none() {
            ty_val = synth_type_node(eng, type_node)
        }
        if ty_val == ty_id_none() {
            print(c"\n\033[1;31m[type error]\033[0m struct field requires a resolved type\n       --> ")
            db.print_loc(type_node)
            print(c"\n")
            fall()
        }

        fields_vec.push(name_id)
        fields_vec.push(ty_val)
        i = i + 1
    }

    ptr := 0 as &u32
    if fields_vec.len > 0 { ptr = fields_vec.ptr_at(0) }
    slice: SliceU32 = .{ ptr: ptr, len: fields_vec.len }

    tyid := (&(*types_ptr)).alloc_struct(slice)
    fields_vec.destroy()

    sym_id := db.get_hir_symbol(id)
    if sym_id != id_none() {
        name_id := db.sym_names.get(sym_id)
        name := db.interner.get(name_id)
        named := (&(*types_ptr)).alloc_nominal(tyid, name, id)
        db.set_const_type(id, named)
        sym_hir := db.get_sym_hir(sym_id)
        if sym_hir != id_none() {
            db.set_const_type(sym_hir, named)
            sym_slot := (&(*db).unify).get_slot(sym_hir)
            if sym_slot == slot_none() {
                sym_slot = (&(*db).unify).new_slot(sym_hir)
            }
            (&(*db).unify).bind_type(&(*db).types, sym_slot, ty_id_type())
        }
    } else {
        db.set_const_type(id, tyid)
    }

    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())

    methods_id := (tbl).extra(id)
    if methods_id != hir_none() {
        if sym_id == id_none() {
            print(c"\n\033[1;31m[type error]\033[0m methods require a named struct binding\n       --> ")
            db.print_loc(id)
            print(c"\n")
            fall()
        }
        methods := db.get_list(methods_id)
        m_i: u64 = 0
        while m_i < methods.len {
            method := *(methods.ptr + m_i)
            func_node := (tbl).extra(method)
            synth_func(eng, func_node)
            method_slot := (unify_ptr).new_slot(method)
            func_slot := (unify_ptr).get_slot(func_node)
            func_ty := (unify_ptr).resolve_type(func_slot)
            (&(*db).unify).bind_type(&(*db).types, method_slot, func_ty)
            m_i = m_i + 1
        }
    }
}

synth_struct_init :: fn(db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)

    fields_list := (tbl).lhs(id)
    vals_list   := (tbl).rhs(id)

    fields := db.get_list(fields_list)
    vals   := db.get_list(vals_list)

    fields_vec := VecU32.new()

    i: u64 = 0
    while (i < fields.len) and (i < vals.len) {
        f_node := *(fields.ptr + i)
        v_node := *(vals.ptr + i)

        name_id := (tbl).lhs(f_node)

        j: u64 = 0
        while j < fields_vec.len {
            if fields_vec.get(j) == name_id {
                print(c"\n\033[1;31m[type error]\033[0m duplicate field name\n       --> ")
                db.print_loc(f_node)
                print(c"\n")
                fall()
            }
            j = j + 2
        }

        v_slot := (unify_ptr).get_slot(v_node)
        if v_slot == slot_none() {
            v_slot = (unify_ptr).new_slot(v_node)
        }
        infer_ty := (&(*types_ptr)).alloc_infer(v_slot)

        fields_vec.push(name_id)
        fields_vec.push(infer_ty)
        i = i + 1
    }

    ptr := 0 as &u32
    if fields_vec.len > 0 { ptr = fields_vec.ptr_at(0) }
    slice: SliceU32 = .{ ptr: ptr, len: fields_vec.len }

    tyid := (&(*types_ptr)).alloc_struct(slice)
    fields_vec.destroy()

    (&(*db).unify).bind_type(&(*db).types, slot, tyid)
}

synth_member :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types
    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }
    lhs_id := (tbl).lhs(id)

    is_type := false
    lhs_ty := ty_id_none()
    if lhs_id == hir_none() {
        owner := db.get_method_owner(id)
        if owner == hir_none() {
            print(c"\n\033[1;31m[type error]\033[0m implicit field access outside a method\n       --> ")
            db.print_loc(id)
            print(c"\n")
            fall()
        }
        lhs_ty = db.get_const_type(owner)
    } else {
        lhs_slot := (unify_ptr).get_slot(lhs_id)
        if lhs_slot == slot_none() {
            print(c"\n\033[1;31m[type error]\033[0m cannot resolve member receiver\n       --> ")
            db.print_loc(lhs_id)
            print(c"\n")
            fall()
        }
        lhs_ty = (unify_ptr).resolve_type_deep(types_ptr, lhs_slot)
        if lhs_ty == ty_id_type() {
            lhs_ty = db.get_const_type(lhs_id)
            is_type = true
        } else {
            while (&(*types_ptr)).kind(lhs_ty) == ty_kind().ptr {
                lhs_ty = (&(*types_ptr)).payload(lhs_ty)
            }
        }
    }

    kind := (&(*types_ptr)).kind(lhs_ty)
    if (kind != ty_kind().struct_) and (kind != ty_kind().nominal) and (kind != ty_kind().enum_) {
        print(c"\n\033[1;31m[type error]\033[0m member receiver must be a struct or enum, got '")
        (&(*types_ptr)).print_type(lhs_ty)
        print(c"'\n       --> ")
        db.print_loc(id)
        print(c"\n")
        fall()
    }

    rhs_id := (tbl).rhs(id)
    name_id := (tbl).lhs(rhs_id)

    if kind == ty_kind().enum_ {
        if is_type {
            if (&(*types_ptr)).enum_has_variant(lhs_ty, name_id) {
                (&(*db).unify).bind_type(&(*db).types, slot, lhs_ty)
                ret
            }
        }
    }

    if (not is_type) and (kind != ty_kind().enum_) {
        fields := (&(*types_ptr)).get_struct_fields(lhs_ty)
        i: u64 = 0
        while i < fields.len / 2 {
            if *(fields.ptr + i * 2) == name_id {
                field_ty := *(fields.ptr + i * 2 + 1)
                if (&(*types_ptr)).kind(field_ty) == ty_kind().infer {
                    (&(*db).unify).union(&(*db).types, slot, (&(*types_ptr)).payload(field_ty))
                } else {
                    (&(*db).unify).bind_type(&(*db).types, slot, field_ty)
                }
                ret
            }
            i = i + 1
        }
    }

    if (kind == ty_kind().nominal) or (kind == ty_kind().enum_) {
        origin := (&(*types_ptr)).nominal_origin(lhs_ty)
        if kind == ty_kind().enum_ {
            origin = (&(*types_ptr)).enum_origin(lhs_ty)
        }
        struct_id := origin
        if ((origin & 2147483648) == 0) and ((tbl).kind(origin) == hir_kind.binding) {
            struct_id = (tbl).extra(origin)
        }
        spec_node := (&(*types_ptr)).get_nominal_struct_node(origin)
        if spec_node != ty_id_none() {
            struct_id = spec_node
        }
        methods_id := (tbl).extra(struct_id)
        if kind == ty_kind().enum_ {
            meta := db.get_list(methods_id)
            methods_id = *(meta.ptr + 1)
        }
        if methods_id != hir_none() {
            methods := db.get_list(methods_id)
            i: u64 = 0
            while i < methods.len {
                method := *(methods.ptr + i)
                method_name := (tbl).lhs((tbl).lhs(method))
                if method_name == name_id {
                    receiver := method_has_receiver(db, method)
                    if is_type and receiver {
                        print(c"\n\033[1;31m[type error]\033[0m instance method requires a value; call it on an instance\n       --> ")
                        db.print_loc(id)
                        print(c"\n")
                        fall()
                    }
                    if (lhs_id != hir_none()) and (not is_type) and (not receiver) {
                        print(c"\n\033[1;31m[type error]\033[0m static method requires the type\n       --> ")
                        db.print_loc(id)
                        print(c"\n")
                        fall()
                    }
                    creator_sym := (&(*types_ptr)).get_nominal_creator_sym(origin)
                    if creator_sym != ty_id_none() {
                        creator_args := (&(*types_ptr)).get_nominal_creator_args(origin)
                        creator_fn := id_none()
                        if (creator_sym & 2147483648) != 0 {
                            b_id := creator_sym & 2147483647
                            if (tbl).kind(b_id) == hir_kind.binding {
                                creator_fn = (tbl).extra(b_id)
                            } else if (tbl).kind(b_id) == hir_kind.function {
                                creator_fn = b_id
                            }
                        } else {
                            creator_fn = db.get_sym_hir(creator_sym)
                            if (creator_fn != id_none()) and ((tbl).kind(creator_fn) != hir_kind.function) {
                                h_end := db.sym_hir_end.get(creator_sym)
                                if (h_end != 0) and (h_end != id_none()) {
                                    b_id := h_end - 1
                                    if (tbl).kind(b_id) == hir_kind.binding {
                                        creator_fn = (tbl).extra(b_id)
                                    }
                                }
                                if (creator_fn != id_none()) and ((tbl).kind(creator_fn) != hir_kind.function) {
                                    scan_i := creator_fn + 1
                                    tbl_len := (tbl).len()
                                    while scan_i < tbl_len {
                                        sk := (tbl).kind(scan_i)
                                        if (sk == hir_kind.var) or (sk == hir_kind.binding) {
                                            if (tbl).lhs(scan_i) == creator_fn {
                                                cand := (tbl).extra(scan_i)
                                                if (cand != hir_none()) and ((tbl).kind(cand) == hir_kind.function) {
                                                    creator_fn = cand
                                                    break
                                                }
                                            }
                                        }
                                        if scan_i > (creator_fn + 50) { break }
                                        scan_i = scan_i + 1
                                    }
                                }
                            }
                        }

                        fn_params_slice: SliceU32 = .{ ptr: 0 as &u32, len: 0 }
                        if creator_fn != id_none() {
                            cp_list := (tbl).lhs(creator_fn)
                            if cp_list != hir_none() {
                                fn_params_slice = db.get_list(cp_list)
                            }
                        }

                        db.set_const_type(struct_id, lhs_ty)
                        p_i: u64 = 0
                        while p_i < fn_params_slice.len {
                            if p_i < creator_args.len {
                                p_arg := *(fn_params_slice.ptr + p_i)
                                p_ident := (tbl).lhs(p_arg)
                                arg_val := *(creator_args.ptr + p_i)
                                if p_ident != hir_none() {
                                    type_slot := (&(*db).unify).new_slot(p_ident)
                                    (&(*db).unify).bind_type(&(*db).types, type_slot, ty_id_type())
                                    db.set_const_type(p_ident, arg_val)
                                }
                                db.set_const_type(p_arg, arg_val)
                            }
                            p_i = p_i + 1
                        }

                        func_node := (tbl).extra(method)
                        m_params_list := (tbl).lhs(func_node)
                        c_args_vec := VecU32.new()
                        ca_i: u64 = 0
                        while ca_i < creator_args.len {
                            c_args_vec.push(*(creator_args.ptr + ca_i))
                            ca_i = ca_i + 1
                        }
                        method_type_params := VecU32.new()
                        method_type_params.extend(fn_params_slice.ptr, fn_params_slice.len)
                        if m_params_list != hir_none() {
                            count := db.get_list(m_params_list).len
                            mp_i: u64 = 0
                            runtime_seen := false
                            while mp_i < count {
                                m_params := db.get_list(m_params_list)
                                m_arg := *(m_params.ptr + mp_i)
                                m_ty_node := (tbl).rhs(m_arg)
                                if synth_type_node(eng, m_ty_node) == ty_id_type() {
                                    if runtime_seen {
                                        print(c"\n[type error] generic type parameters must precede runtime parameters\n       --> ")
                                        db.print_loc(m_arg)
                                        print(c"\n")
                                        fall()
                                    }
                                    m_ident := (tbl).lhs(m_arg)
                                    m_slot := (unify_ptr).new_slot(m_ident)
                                    m_infer := (&(*types_ptr)).alloc_infer(m_slot)
                                    db.set_const_type(m_ident, m_infer)
                                    db.set_const_type(m_arg, m_infer)
                                    method_type_params.push(m_arg)
                                    c_args_vec.push(m_infer)
                                } else {
                                    runtime_seen = true
                                }
                                mp_i = mp_i + 1
                            }
                        }
                        concrete_params_vec := VecU32.new()
                        if m_params_list != hir_none() {
                            count := db.get_list(m_params_list).len
                            mp_i: u64 = 0
                            while mp_i < count {
                                m_params := db.get_list(m_params_list)
                                m_arg := *(m_params.ptr + mp_i)
                                m_ty_node := (tbl).rhs(m_arg)
                                concrete_p_ty := specialize_type_node(eng, m_ty_node, method_type_params.as_slice(), &c_args_vec)
                                concrete_params_vec.push(concrete_p_ty)
                                mp_i = mp_i + 1
                            }
                        }
                        m_ret_node := (tbl).rhs(func_node)
                        concrete_ret := ty_id_unit()
                        if m_ret_node != hir_none() {
                            concrete_ret = specialize_type_node(eng, m_ret_node, method_type_params.as_slice(), &c_args_vec)
                        }
                        c_p_slice: SliceU32 = .{ ptr: 0 as &u32, len: 0 }
                        if concrete_params_vec.len > 0 {
                            c_p_slice.ptr = concrete_params_vec.ptr_at(0)
                            c_p_slice.len = concrete_params_vec.len
                        }
                        concrete_method_ty := (&(*types_ptr)).alloc_func(c_p_slice, concrete_ret, false)
                        concrete_params_vec.destroy()
                        c_args_vec.destroy()
                        method_type_params.destroy()

                        db.set_const_type(func_node, concrete_method_ty)
                        db.set_method_target(id, method)
                        db.set_const_type(id, concrete_method_ty)
                        (&(*db).unify).bind_type(&(*db).types, slot, concrete_method_ty)
                        ret
                    }

                    method_slot := (unify_ptr).get_slot(method)
                    if method_slot == slot_none() {
                        func_node := (tbl).extra(method)
                        synth_func(eng, func_node)
                        method_slot = (unify_ptr).new_slot(method)
                        func_slot := (unify_ptr).get_slot(func_node)
                        func_ty := (unify_ptr).resolve_type(func_slot)
                        (&(*db).unify).bind_type(&(*db).types, method_slot, func_ty)
                    }
                    db.set_method_target(id, method)
                    (&(*db).unify).union(&(*db).types, slot, method_slot)
                    ret
                }
                i = i + 1
            }
        }
    }

    print(c"\n\033[1;31m[type error]\033[0m type '")
    (&(*types_ptr)).print_type(lhs_ty)
    print(c"' has no field or method named '")
    db.interner.get(name_id).print()
    print(c"'\n       --> ")
    db.print_loc(id)
    print(c"\n")
    fall()
}

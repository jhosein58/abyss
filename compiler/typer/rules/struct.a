import Str from "std/string"
import Nexus from "../../nexus/nexus"
import HirTable, hir_kind, hir_none from "../../hir"
import TyKind, ty_id_none, ty_id_type, ty_id_unit from "../../types"
import slot_none from "../../unify"
import id_none from "../../nexus/pool"
import Engine from "../../engine"
import fall from "std/sys"
import synth_type_node from "./var"
import synth_func, func_has_self from "./fn"
import specialize_nominal_method from "../specialize"
import Token, TokenStream from "../../token"
import lex from "../../lexer"
import Parser_new, is_eof, peek from "../../parser/core"
import parse_ident from "../../parser/handlers/ident"
import parse_method, check_separator from "../../parser/handlers/common"
import reflection_read from "../reflection"
import eval_const from "../../lower"
import synth_node, type_check from "../tyck"
import unescape_splice_str from "./common"

synth_struct :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)

    names_list := (tbl).lhs(id)
    types_list := (tbl).rhs(id)

    names := db.get_list(names_list)
    types := db.get_list(types_list)

    fields_vec := Vec(u32).new()

    i: u64 = 0
    while (i < names.len) and (i < types.len) {
        names = db.get_list(names_list)
        types = db.get_list(types_list)
        name_node := *(names.ptr + i)
        type_node := *(types.ptr + i)

        name_id := (tbl).lhs(name_node)

        j: u64 = 0
        while j < fields_vec.len {
            if fields_vec.get(j) == name_id {
                printf("\n\033[1;31m[type error]\033[0m duplicate field name\n       --> ", .{})
                db.print_loc(name_node)
                print("")
                fall()
            }
            j = j + 2
        }

        ty_val := db.get_const_type(type_node)
        if ty_val == ty_id_none() {
            ty_val = synth_type_node(eng, type_node)
        }
        if ty_val == ty_id_none() {
            printf("\n\033[1;31m[type error]\033[0m struct field requires a resolved type\n       --> ", .{})
            db.print_loc(type_node)
            print("")
            fall()
        }

        fields_vec.push(name_id)
        fields_vec.push(ty_val)
        i = i + 1
    }

    ptr := 0 as &u32
    if fields_vec.len > 0 { ptr = fields_vec.ptr_at(0) }
    slice: Slice(u32) = .{ ptr: ptr, len: fields_vec.len }

    tyid := (&(*types_ptr)).alloc_struct(slice)
    fields_vec.destroy()

    is_tuple := false
    if names.len > 0 {
        first_ident := *(names.ptr)
        if (tbl).kind(first_ident) == hir_kind.ident {
            first_name_id := (tbl).lhs(first_ident)
            if db.is_tuple_name(first_name_id) {
                is_tuple = true
            }
        }
    }

    sym_id := db.get_hir_symbol(id)
    if (sym_id != id_none()) and (not is_tuple) {
        name_id := db.sym_names.get(sym_id)
        name := db.interner.get(name_id)
        named := (&(*types_ptr)).alloc_nominal(tyid, name, id)
        db.set_const_type(id, named)
        sym_hir := db.get_sym_hir(sym_id)
        if sym_hir != id_none() {
            db.set_const_type(sym_hir, named)
            sym_slot := (&(*db).unify).get_slot(sym_hir)
            if sym_slot == slot_none() {
                sym_slot = (&(*db).unify).new_slot(sym_hir)
            }
            (&(*db).unify).bind_type(&(*db).types, sym_slot, ty_id_type())
        }
    } else {
        db.set_const_type(id, tyid)
        if sym_id != id_none() {
            sym_hir := db.get_sym_hir(sym_id)
            if sym_hir != id_none() {
                db.set_const_type(sym_hir, tyid)
                sym_slot := (&(*db).unify).get_slot(sym_hir)
                if sym_slot == slot_none() {
                    sym_slot = (&(*db).unify).new_slot(sym_hir)
                }
                (&(*db).unify).bind_type(&(*db).types, sym_slot, ty_id_type())
            }
        }
    }

    (&(*db).unify).bind_type(&(*db).types, slot, ty_id_type())
    db.set_is_const(id, true)

    methods_id := (tbl).extra(id)
    if methods_id != hir_none() {
        if sym_id == id_none() {
            printf("\n\033[1;31m[type error]\033[0m methods require a named struct binding\n       --> ", .{})
            db.print_loc(id)
            print("")
            fall()
        }
        final_methods := Vec(u32).new()
        m_count := db.get_list(methods_id).len
        m_i: u64 = 0
        while m_i < m_count {
            methods := db.get_list(methods_id)
            method := *(methods.ptr + m_i)
            if (tbl).kind(method) == hir_kind.splice {
                child := (tbl).lhs(method)
                macro_src := Str.empty()
                if (tbl).kind(child) == hir_kind.lit_str {
                    raw := db.interner.get((tbl).lhs(child))
                    content := raw.trim_quotes()
                    if (raw.len > 0) and (*(raw.ptr) != 96) {
                        macro_src = unescape_splice_str(content)
                    } else {
                        macro_src = content
                    }
                } else {
                    synth_node(eng, child)
                    val := eval_const(db, child)
                    if val != 0 {
                        str_ty := eng.get_str_type()
                        buf_ptr := reflection_read(db, val, str_ty, "ptr") as &u8
                        buf_len := reflection_read(db, val, str_ty, "len")
                        if buf_len > 0 {
                            macro_src = Str.new(buf_ptr, buf_len)
                        }
                    }
                }
                if macro_src.len > 0 {
                    tokens := TokenStream.new()
                    lex(&tokens, macro_src, Str.of("<splice>"))
                    tok_count := tokens.count() as u32
                    if tok_count > 1 {
                        tok_count = tok_count - 1
                    }
                    fid := db.get_hir_file(id)
                    sub_p := Parser_new(db, &tokens, tbl, fid, sym_id, 0, tok_count)
                    expanded_methods := Vec(u32).new()
                    t := Token
                    while (not is_eof(&sub_p)) and (peek(&sub_p) != t.eof) {
                        m_name := parse_ident(&sub_p)
                        if peek(&sub_p) == t.colon_colon {
                            parse_method(&sub_p, m_name, &expanded_methods)
                        }
                        check_separator(&sub_p, t.eof, c"expected separator")
                    }
                    sub_p.env.destroy()
                    tokens.destroy()
                    e_i: u64 = 0
                    while e_i < expanded_methods.len {
                        new_m := expanded_methods.get(e_i)
                        s_start := (tbl).lhs(new_m)
                        s := s_start
                        while s <= new_m {
                            db.set_method_owner(s, id)
                            s = s + 1
                        }
                        type_check(eng, s_start, new_m + 1)
                        func_node := (tbl).extra(new_m)
                        method_slot := (unify_ptr).get_slot(new_m)
                        if method_slot == slot_none() {
                            method_slot = (unify_ptr).new_slot(new_m)
                        }
                        func_slot := (unify_ptr).get_slot(func_node)
                        func_ty := (unify_ptr).resolve_type(func_slot)
                        (&(*db).unify).bind_type(&(*db).types, method_slot, func_ty)
                        final_methods.push(new_m)
                        e_i = e_i + 1
                    }
                    expanded_methods.destroy()
                }
            } else {
                func_node := (tbl).extra(method)
                db.set_method_owner(func_node, id)
                db.set_method_owner(method, id)
                synth_func(eng, func_node)
                method_slot := (unify_ptr).new_slot(method)
                func_slot := (unify_ptr).get_slot(func_node)
                func_ty := (unify_ptr).resolve_type(func_slot)
                (&(*db).unify).bind_type(&(*db).types, method_slot, func_ty)
                final_methods.push(method)
            }
            m_i = m_i + 1
        }
        slice: Slice(u32) = if final_methods.len > 0 {
            .{ ptr: final_methods.ptr_at(0), len: final_methods.len }
        } else {
            Slice(u32).empty()
        }
        new_methods_id := db.add_list(slice)
        final_methods.destroy()
        (tbl).set_extra(id, new_methods_id)
    }
}

synth_struct_init :: fn(db &Nexus, tbl &HirTable, id u32) {
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types

    slot := (unify_ptr).new_slot(id)

    fields_list := (tbl).lhs(id)
    vals_list   := (tbl).rhs(id)

    fields := db.get_list(fields_list)
    vals   := db.get_list(vals_list)

    fields_vec := Vec(u32).new()

    i: u64 = 0
    while (i < fields.len) and (i < vals.len) {
        f_node := *(fields.ptr + i)
        v_node := *(vals.ptr + i)

        name_id := (tbl).lhs(f_node)

        j: u64 = 0
        while j < fields_vec.len {
            if fields_vec.get(j) == name_id {
                printf("\n\033[1;31m[type error]\033[0m duplicate field name\n       --> ", .{})
                db.print_loc(f_node)
                print("")
                fall()
            }
            j = j + 2
        }

        v_slot := (unify_ptr).get_slot(v_node)
        if v_slot == slot_none() {
            v_slot = (unify_ptr).new_slot(v_node)
        }
        infer_ty := (&(*types_ptr)).alloc_infer(v_slot)

        fields_vec.push(name_id)
        fields_vec.push(infer_ty)
        i = i + 1
    }

    ptr := 0 as &u32
    if fields_vec.len > 0 { ptr = fields_vec.ptr_at(0) }
    slice: Slice(u32) = .{ ptr: ptr, len: fields_vec.len }

    tyid := (&(*types_ptr)).alloc_struct(slice)
    fields_vec.destroy()

    (&(*db).unify).bind_type(&(*db).types, slot, tyid)
}

synth_member :: fn(eng &Engine, id u32) {
    db := &(*eng).nexus
    tbl := &(*db).hir
    unify_ptr := &(*db).unify
    types_ptr := &(*db).types
    slot := (unify_ptr).get_slot(id)
    if slot == slot_none() {
        slot = (unify_ptr).new_slot(id)
    }
    lhs_id := (tbl).lhs(id)

    is_type := false
    lhs_ty := ty_id_none()
    deref_depth: u32 = 0
    lhs_slot := (unify_ptr).get_slot(lhs_id)
    if lhs_slot == slot_none() {
        printf("\n\033[1;31m[type error]\033[0m cannot resolve member receiver\n       --> ", .{})
        db.print_loc(lhs_id)
        print("")
        fall()
    }
    lhs_ty = (unify_ptr).resolve_type_deep(types_ptr, lhs_slot)
    if lhs_ty == ty_id_type() {
        lhs_ty = db.get_const_type(lhs_id)
        is_type = true
    } else {
        while types_ptr.kind(lhs_ty) == TyKind.ptr {
            lhs_ty = types_ptr.payload(lhs_ty)
            deref_depth = deref_depth + 1
        }
    }
    db.set_auto_deref_depth(id, deref_depth)

    kind := types_ptr.kind(lhs_ty)
    if (kind != TyKind.struct_) and (kind != TyKind.nominal) and (kind != TyKind.enum_) {
        printf("\n\033[1;31m[type error]\033[0m member receiver must be a struct or enum, got '", .{})
        types_ptr.print_type(lhs_ty)
        printf("'\n       --> ", .{})
        db.print_loc(id)
        print("")
        fall()
    }

    rhs_id := tbl.rhs(id)
    name_id := tbl.lhs(rhs_id)

    if kind == TyKind.enum_ {
        if is_type {
            if types_ptr.enum_has_variant(lhs_ty, name_id) {
                db.unify.bind_type(&db.types, slot, lhs_ty)
                ret
            }
        }
    }

    if (not is_type) and (kind != TyKind.enum_) {
        fields := types_ptr.get_struct_fields(lhs_ty)
        i: u64 = 0
        while i < fields.len / 2 {
            if *(fields.ptr + i * 2) == name_id {
                field_ty := *(fields.ptr + i * 2 + 1)
                if types_ptr.kind(field_ty) == TyKind.infer {
                    db.unify.union(&db.types, slot, types_ptr.payload(field_ty))
                } else {
                    db.unify.bind_type(&db.types, slot, field_ty)
                }
                ret
            }
            i = i + 1
        }
    }

    if (kind == TyKind.nominal) or (kind == TyKind.enum_) {
        origin := types_ptr.nominal_origin(lhs_ty)
        if kind == TyKind.enum_ {
            origin = types_ptr.enum_origin(lhs_ty)
        }
        struct_id := origin
        if ((origin & 2147483648) == 0) and (tbl.kind(origin) == hir_kind.binding) {
            struct_id = tbl.extra(origin)
        }
        spec_node := types_ptr.get_nominal_struct_node(origin)
        if spec_node != ty_id_none() {
            struct_id = spec_node
        }
        methods_id := tbl.extra(struct_id)
        if kind == TyKind.enum_ {
            meta := db.get_list(methods_id)
            methods_id = *(meta.ptr + 1)
        }
        if methods_id != hir_none() {
            methods := db.get_list(methods_id)
            i: u64 = 0
            while i < methods.len {
                method := *(methods.ptr + i)
                method_name := (tbl).lhs((tbl).lhs(method))
                if method_name == name_id {
                    func_node := (tbl).extra(method)
                    receiver := func_has_self(db, func_node)
                    if is_type and receiver {
                        printf("\n\033[1;31m[type error]\033[0m instance method requires a value; call it on an instance\n       --> ", .{})
                        db.print_loc(id)
                        print("")
                        fall()
                    }
                    if (not is_type) and (not receiver) {
                        printf("\n\033[1;31m[type error]\033[0m static method requires the type\n       --> ", .{})
                        db.print_loc(id)
                        print("")
                        fall()
                    }
                    creator_sym := (&(*types_ptr)).get_nominal_creator_sym(origin)
                    if creator_sym != ty_id_none() {
                        func_node := (tbl).extra(method)
                        concrete_method_ty := specialize_nominal_method(eng, origin, struct_id, func_node, lhs_ty)
                        method_sym := db.get_hir_symbol(method)
                        db.set_hir_symbol(id, method_sym)
                        db.set_const_type(id, concrete_method_ty)
                        (&(*db).unify).bind_type(&(*db).types, slot, concrete_method_ty)
                        ret
                    }

                    method_slot := (unify_ptr).get_slot(method)
                    if method_slot == slot_none() {
                        func_node := (tbl).extra(method)
                        synth_func(eng, func_node)
                        method_slot = (unify_ptr).new_slot(method)
                        func_slot := (unify_ptr).get_slot(func_node)
                        func_ty := (unify_ptr).resolve_type(func_slot)
                        (&(*db).unify).bind_type(&(*db).types, method_slot, func_ty)
                    }
                    method_sym := db.get_hir_symbol(method)
                    db.set_hir_symbol(id, method_sym)
                    (&(*db).unify).union(&(*db).types, slot, method_slot)
                    ret
                }
                i = i + 1
            }
        }
    }

    printf("\n\033[1;31m[type error]\033[0m type '", .{})
    (&(*types_ptr)).print_type(lhs_ty)
    printf("' has no field or method named '{}'\n       --> ", .{db.interner.get(name_id)})
    db.print_loc(id)
    print("")
    fall()
}

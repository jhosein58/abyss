import Nexus from "../../nexus/nexus"
import HirTable, hir_kind, hir_none from "../../hir"
import Str from "std/string"
import TypeStorage, TyKind, ty_id_none, ty_id_type from "../../types"
import UnifyStorage, slot_none from "../../unify"
import fall from "std/sys"

print :: fn(s &u8) unit

parse_builtin_type :: fn(types &TypeStorage, name Str) u32 {
    if name.eq(Str.of("bool")) { ret TypeStorage.alloc_bool() }
    if name.eq(Str.of("unit")) { ret TypeStorage.alloc_unit() }
    if name.eq(Str.of("type")) { ret TypeStorage.alloc_type() }

    if name.len < 2 { ret ty_id_none() }

    first := *(name.ptr)
    if (first != 105) and (first != 117) and (first != 102) {
        ret ty_id_none()
    }

    bits := 0
    i := 1

    while i < name.len {
        c := *(name.ptr + i)

        if (c < 48) or (c > 57) { ret ty_id_none() }

        bits = (bits * 10) + ((c - 48) as u32)
        i = i + 1
    }

    if (bits != 8) and (bits != 16) and (bits != 32) and (bits != 64) and (bits != 128) {
        ret ty_id_none()
    }

    if (first == 102) and (bits != 32) and (bits != 64) {
        ret ty_id_none()
    }

    if first == 105 { ret types.alloc_int(bits as u16) }
    if first == 117 { ret types.alloc_uint(bits as u16) }
    if first == 102 { ret types.alloc_float(bits as u16) }

    ty_id_none()
}

check_value :: fn(db &Nexus, expr u32, expected u32) {
    db.set_type_error_origin(expr)
    tbl := &db.hir
    unify_ptr := &db.unify
    types := &db.types

    slot := unify_ptr.get_slot(expr)
    if slot == slot_none() { ret }

    if tbl.kind(expr) == hir_kind.k_cmpt {
        check_value(db, tbl.lhs(expr), expected)
        result_slot := unify_ptr.new_slot(expr)
        unify_ptr.bind_type(types, result_slot, expected)
        ret
    }

    if tbl.kind(expr) == hir_kind.k_if {
        check_value(db, tbl.rhs(expr), expected)
        elseb := tbl.extra(expr)
        if elseb != hir_none() {
            check_value(db, elseb, expected)
        }
        result_slot := unify_ptr.new_slot(expr)
        unify_ptr.bind_type(types, result_slot, expected)
        ret
    }

    if tbl.kind(expr) == hir_kind.block {
        items := db.get_list(tbl.lhs(expr))
        if items.len > 0 {
            check_value(db, *(items.ptr + items.len - 1), expected)
            result_slot := unify_ptr.new_slot(expr)
            unify_ptr.bind_type(types, result_slot, expected)
            ret
        }
    }

    kind := types.kind(expected)
    if kind == TyKind.union_ {
        val_ty := unify_ptr.resolve_type_deep(types, slot)
        if val_ty == expected { ret }

        members := types.union_members(expected)
        match_count: u32 = 0
        match_idx: u32 = 0
        match_member_ty := ty_id_none()
        val_k := types.kind(val_ty)
        infer_count: u32 = 0
        infer_idx: u32 = 0
        infer_member := ty_id_none()

        m_i: u64 = 0
        while m_i < members.len {
            members = types.union_members(expected)
            m_ty := *(members.ptr + m_i)
            m_k := types.kind(m_ty)
            if m_k == TyKind.infer {
                resolved := unify_ptr.resolve_type_deep(types, types.infer_slot(m_ty))
                if resolved == ty_id_none() {
                    infer_count = infer_count + 1
                    infer_idx = m_i as u32
                    infer_member = m_ty
                } else {
                    m_ty = resolved
                    m_k = types.kind(m_ty)
                }
            }
            matches := false
            if val_ty == m_ty {
                matches = true
            } else if val_k == TyKind.untyped_int {
                if (m_k == TyKind.int) or (m_k == TyKind.uint) {
                    matches = true
                }
            } else if val_k == TyKind.untyped_float {
                if m_k == TyKind.float {
                    matches = true
                }
            }
            if matches {
                match_count = match_count + 1
                match_idx = m_i as u32
                match_member_ty = m_ty
            }
            m_i = m_i + 1
        }

        if (match_count == 0) and (infer_count == 1) {
            unify_ptr.bind_type(types, types.infer_slot(infer_member), val_ty)
            match_count = 1
            match_idx = infer_idx
            match_member_ty = val_ty
        } else if (match_count == 0) and (infer_count > 1) {
            match_count = infer_count
        }

        if match_count == 1 {
            if (val_k == TyKind.untyped_int) or (val_k == TyKind.untyped_float) {
                db.unify.bind_type(&db.types, slot, match_member_ty)
            }
            result_slot := unify_ptr.new_slot(expr)
            unify_ptr.bind_type(types, result_slot, expected)
            db.set_union_coerce(expr, expected, match_idx)
            ret
        }

        if match_count > 1 {
            print(c"\n\033[1;31m[type error]\033[0m ambiguous coercion into union '")
            types.print_type(expected)
            print(c"'\n       --> ")
            db.print_loc(expr)
            print(c"\n")
            fall()
        }

        print(c"\n\033[1;31m[type error]\033[0m type '")
        types.print_type(val_ty)
        print(c"' is not a member of union '")
        types.print_type(expected)
        print(c"'\n       --> ")
        db.print_loc(expr)
        print(c"\n")
        fall()
    }

    if (tbl.kind(expr) == hir_kind.struct_init) and
       ((kind == TyKind.nominal) or (kind == TyKind.struct_)) {
        target := types.get_struct_fields(expected)
        names := db.get_list(tbl.lhs(expr))
        values := db.get_list(tbl.rhs(expr))
        if (names.len != target.len / 2) or (values.len != names.len) {
            print(c"\n\033[1;31m[type error]\033[0m struct literal has wrong number of fields for '")
            types.print_type(expected)
            print(c"'\n       --> ")
            db.print_loc(expr)
            print(c"\n")
            fall()
        }

        i: u64 = 0
        while i < names.len {
            target = types.get_struct_fields(expected)
            name_id := tbl.lhs(*(names.ptr + i))
            field_ty := ty_id_none()
            j: u64 = 0
            while j < target.len / 2 {
                if *(target.ptr + j * 2) == name_id {
                    field_ty = *(target.ptr + j * 2 + 1)
                    break
                }
                j = j + 1
            }
            if field_ty == ty_id_none() {
                print(c"\n\033[1;31m[type error]\033[0m unexpected field '")
                db.interner.get(name_id).print()
                print(c"' in struct literal for '")
                types.print_type(expected)
                print(c"'\n       --> ")
                db.print_loc(*(names.ptr + i))
                print(c"\n")
                fall()
            }
            check_value(db, *(values.ptr + i), field_ty)
            i = i + 1
        }
        root := unify_ptr.find(slot)
        existing := unify_ptr.resolve_type(slot)
        if types.kind(existing) == TyKind.nominal {
            db.unify.bind_type(&db.types, slot, expected)
            ret
        }
        unify_ptr.types.set(root as u64, expected)
        ret
    }
    db.unify.bind_type(&db.types, slot, expected)
}

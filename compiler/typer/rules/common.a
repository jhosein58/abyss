import Nexus from "../../nexus/nexus.a"
import HirTable, hir_kind, hir_none from "../../hir.a"
import Str from "../../../std/string.a"
import TypeStorage, ty_kind, ty_id_none, ty_id_type from "../../types.a"
import UnifyStorage, slot_none from "../../unify.a"
import fall from "../../../std/sys.a"

print :: (s &u8) unit

parse_builtin_type :: (types &TypeStorage, name Str) u32 {
    if name.eq(Str.of("bool")) { ret TypeStorage.alloc_bool() }
    if name.eq(Str.of("unit")) { ret TypeStorage.alloc_unit() }
    if name.eq(Str.of("type")) { ret TypeStorage.alloc_type() }

    if name.len < 2 { ret ty_id_none() }

    first := *(name.ptr)
    if (first != 105) and (first != 117) and (first != 102) {
        ret ty_id_none()
    }

    bits := 0
    i := 1

    while i < name.len {
        c := *(name.ptr + i)

        if (c < 48) or (c > 57) { ret ty_id_none() }

        bits = (bits * 10) + ((c - 48) as u32)
        i = i + 1
    }

    if (bits != 8) and (bits != 16) and (bits != 32) and (bits != 64) and (bits != 128) {
        ret ty_id_none()
    }

    if (first == 102) and (bits != 32) and (bits != 64) {
        ret ty_id_none()
    }

    if first == 105 { ret types.alloc_int(bits as u16) }
    if first == 117 { ret types.alloc_uint(bits as u16) }
    if first == 102 { ret types.alloc_float(bits as u16) }

    ty_id_none()
}

check_value :: (db &Nexus, expr u32, expected u32) {
    tbl := &db.hir
    unify_ptr := &db.unify
    types := &db.types

    slot := unify_ptr.get_slot(expr)
    if slot == slot_none() { ret }

    if tbl.kind(expr) == hir_kind().k_if {
        check_value(db, tbl.rhs(expr), expected)
        elseb := tbl.extra(expr)
        if elseb != hir_none() {
            check_value(db, elseb, expected)
        }
        root := unify_ptr.find(slot)
        (*unify_ptr).types.set(root as u64, expected)
        ret
    }

    if tbl.kind(expr) == hir_kind().block {
        items := db.get_list(tbl.lhs(expr))
        if items.len > 0 {
            check_value(db, *(items.ptr + items.len - 1), expected)
            root := unify_ptr.find(slot)
            (*unify_ptr).types.set(root as u64, expected)
            ret
        }
    }

    kind := (&(*types)).kind(expected)
    if kind == ty_kind().union_ {
        val_ty := (unify_ptr).resolve_type_deep(types, slot)
        if val_ty == expected { ret }

        members := (&(*types)).union_members(expected)
        match_count: u32 = 0
        match_idx: u32 = 0
        match_member_ty := ty_id_none()
        val_k := (&(*types)).kind(val_ty)
        k := ty_kind()

        m_i: u64 = 0
        while m_i < members.len {
            m_ty := *(members.ptr + m_i)
            m_k := (&(*types)).kind(m_ty)
            matches := false
            if val_ty == m_ty {
                matches = true
            } else if val_k == k.untyped_int {
                if (m_k == k.int) or (m_k == k.uint) {
                    matches = true
                }
            } else if val_k == k.untyped_float {
                if m_k == k.float {
                    matches = true
                }
            }
            if matches {
                match_count = match_count + 1
                match_idx = m_i as u32
                match_member_ty = m_ty
            }
            m_i = m_i + 1
        }

        if match_count == 1 {
            if (val_k == k.untyped_int) or (val_k == k.untyped_float) {
                (&(*db).unify).bind_type(&(*db).types, slot, match_member_ty)
            }
            root := unify_ptr.find(slot)
            (*unify_ptr).types.set(root as u64, expected)
            db.set_union_coerce(expr, expected, match_idx)
            ret
        }

        if match_count > 1 {
            print("\n\033[1;31m[type error]\033[0m ambiguous coercion into union '")
            (&(*types)).print_type(expected)
            print("'\n       --> ")
            db.print_loc(expr)
            print("\n")
            fall()
        }

        print("\n\033[1;31m[type error]\033[0m type '")
        (&(*types)).print_type(val_ty)
        print("' is not a member of union '")
        (&(*types)).print_type(expected)
        print("'\n       --> ")
        db.print_loc(expr)
        print("\n")
        fall()
    }

    if ((tbl).kind(expr) == hir_kind().struct_init) and
       ((kind == ty_kind().nominal) or (kind == ty_kind().struct_)) {
        target := (&(*types)).get_struct_fields(expected)
        names := db.get_list((tbl).lhs(expr))
        values := db.get_list((tbl).rhs(expr))
        if (names.len != target.len / 2) or (values.len != names.len) {
            print("\n\033[1;31m[type error]\033[0m struct literal has wrong number of fields for '")
            (&(*types)).print_type(expected)
            print("'\n       --> ")
            db.print_loc(expr)
            print("\n")
            fall()
        }

        i: u64 = 0
        while i < names.len {
            target = (&(*types)).get_struct_fields(expected)
            name_id := (tbl).lhs(*(names.ptr + i))
            field_ty := ty_id_none()
            j: u64 = 0
            while j < target.len / 2 {
                if *(target.ptr + j * 2) == name_id {
                    field_ty = *(target.ptr + j * 2 + 1)
                    break
                }
                j = j + 1
            }
            if field_ty == ty_id_none() {
                print("\n\033[1;31m[type error]\033[0m unexpected field '")
                db.interner.get(name_id).print()
                print("' in struct literal for '")
                (&(*types)).print_type(expected)
                print("'\n       --> ")
                db.print_loc(*(names.ptr + i))
                print("\n")
                fall()
            }
            check_value(db, *(values.ptr + i), field_ty)
            i = i + 1
        }
        root := unify_ptr.find(slot)
        existing := (unify_ptr).resolve_type(slot)
        if (&(*types)).kind(existing) == ty_kind().nominal {
            (&(*db).unify).bind_type(&(*db).types, slot, expected)
            ret
        }
        (*unify_ptr).types.set(root as u64, expected)
        ret
    }
    (&(*db).unify).bind_type(&(*db).types, slot, expected)
}

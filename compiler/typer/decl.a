fall :: @import("std/sys").fall

Engine :: @import("compiler/engine").Engine
hir :: @import("compiler/hir")
lex :: @import("compiler/lexer").lex
eval_const :: @import("compiler/lower").eval_const
Nexus :: @import("compiler/nexus/nexus").Nexus
id_none :: @import("compiler/nexus/pool").id_none
parse_common :: @import("compiler/parser/common")
parse :: @import("compiler/parser/core")
parse_ident :: @import("compiler/parser/expr").parse_ident
token :: @import("compiler/token")
reflection_read :: @import("compiler/typer/reflection").reflection_read
specialize :: @import("compiler/typer/specialize")
tyck :: @import("compiler/typer/tyck")
type_defs :: @import("compiler/types")
slot_none :: @import("compiler/unify").slot_none
unescape_splice_str :: @import("./common").unescape_splice_str
functions :: @import("./fn")
synth_type_node :: @import("./var").synth_type_node

process_methods :: fn(eng &Engine, id u32, methods_id u32, sym_id u32) u32 {
    db := &eng.nexus
    tbl := &db.hir
    unify_ptr := &db.unify
    final_methods := Vec(u32).new()
    m_count := db.get_list(methods_id).len
    m_i: u64 = 0
    while m_i < m_count {
        methods := db.get_list(methods_id)
        method := *(methods.ptr + m_i)
        if tbl.kind(method) == hir.hir_kind.splice {
            child := tbl.lhs(method)
            macro_src := Str.empty()
            if tbl.kind(child) == hir.hir_kind.lit_str {
                raw := db.interner.get(tbl.lhs(child))
                content := raw.trim_quotes()
                if (raw.len > 0) and (*(raw.ptr) != 96) {
                    macro_src = unescape_splice_str(content)
                } else {
                    macro_src = content
                }
            } else {
                tyck.synth_node(eng, child)
                tyck.process_mono_funcs(eng)
                val := eval_const(db, child)
                if val != 0 {
                    str_ty := eng.get_str_type()
                    buf_ptr := reflection_read(db, val, str_ty, "ptr") as &u8
                    buf_len := reflection_read(db, val, str_ty, "len")
                    if buf_len > 0 {
                        macro_src = Str.new(buf_ptr, buf_len)
                    }
                }
            }
            if macro_src.len > 0 {
                tokens := token.TokenStream.new()
                lex(&tokens, macro_src, Str.of("<splice>"))
                tok_count := tokens.count() as u32
                if tok_count > 1 {
                    tok_count = tok_count - 1
                }
                fid := db.get_hir_file(id)
                sub_p := parse.Parser_new(db, &tokens, tbl, fid, sym_id, 0, tok_count)
                parse.restore_splice_scope(&sub_p, method)
                expanded_methods := Vec(u32).new()
                t := token.Token
                node_start := tbl.len()
                while (not parse.is_eof(&sub_p)) and (parse.peek(&sub_p) != t.eof) {
                    m_name := parse_ident(&sub_p)
                    if parse.peek(&sub_p) == t.colon_colon {
                        parse_common.parse_method(&sub_p, m_name, &expanded_methods)
                    }
                    parse_common.check_separator(&sub_p, t.eof, c"expected separator")
                }
                db.set_expansion_loc(node_start, tbl.len(), method)
                sub_p.env.destroy()
                tokens.destroy()
                e_i: u64 = 0
                while e_i < expanded_methods.len {
                    new_m := expanded_methods.get(e_i)
                    s_start := tbl.lhs(new_m)
                    s := s_start
                    while s <= new_m {
                        db.set_method_owner(s, id)
                        s = s + 1
                    }
                    tyck.type_check(eng, s_start, new_m + 1)
                    func_node := tbl.extra(new_m)
                    method_slot := db.ensure_slot(new_m)
                    func_slot := unify_ptr.get_slot(func_node)
                    func_ty := unify_ptr.resolve_type(func_slot)
                    db.bind_type(method_slot, func_ty)
                    final_methods.push(new_m)
                    e_i = e_i + 1
                }
                expanded_methods.destroy()
            }
        } else {
            func_node := tbl.extra(method)
            db.set_method_owner(func_node, id)
            db.set_method_owner(method, id)
            if tbl.kind(func_node) == hir.hir_kind.function {
                functions.synth_func(eng, func_node)
                method_slot := unify_ptr.new_slot(method)
                func_slot := unify_ptr.get_slot(func_node)
                func_ty := unify_ptr.resolve_type(func_slot)
                db.bind_type(method_slot, func_ty)
            } else {
                tyck.synth_node(eng, func_node)
                c_ty := db.get_const_type(func_node)
                if c_ty == type_defs.ty_id_none() {
                    c_ty = db.get_node_type(func_node)
                }
                if c_ty != type_defs.ty_id_none() {
                    db.set_const_type(method, c_ty)
                }
                if db.has_const_val(func_node) {
                    db.set_const_val(method, db.get_const_val(func_node))
                    db.set_is_const(method, true)
                } else if tbl.kind(func_node) == hir.hir_kind.lit_int {
                    db.set_const_val(method, tbl.lhs(func_node) as u64)
                    db.set_is_const(method, true)
                }
                method_slot := unify_ptr.new_slot(method)
                func_slot := unify_ptr.get_slot(func_node)
                if func_slot != slot_none() {
                    func_ty := unify_ptr.resolve_type(func_slot)
                    if func_ty != type_defs.ty_id_none() {
                        db.bind_type(method_slot, func_ty)
                    }
                }
            }
            final_methods.push(method)
        }
        m_i = m_i + 1
    }
    slice: Slice(u32) = if final_methods.len > 0 {
        .{ ptr: final_methods.ptr_at(0), len: final_methods.len }
    } else {
        Slice(u32).empty()
    }
    new_methods_id := db.add_list(slice)
    final_methods.destroy()
    ret new_methods_id
}

is_core_source :: fn(path Str) bool {
    if path.starts_with("core/") or path.starts_with("pods/core/") {
        ret true
    }
    offset: u64 = 0
    while offset + 11 <= path.len {
        if path.sub(offset, 11).eq("/pods/core/") { ret true }
        offset = offset + 1
    }
    false
}

synth_struct :: fn(eng &Engine, id u32) {
    db := &eng.nexus
    tbl := &db.hir
    types_ptr := &db.types

    slot := db.unify.new_slot(id)
    names_list := tbl.lhs(id)
    types_list := tbl.rhs(id)

    names := db.get_list(names_list)
    types := db.get_list(types_list)

    is_tuple := false
    if names.len > 0 {
        first_ident := *(names.ptr)
        if tbl.kind(first_ident) == hir.hir_kind.ident {
            first_name_id := tbl.lhs(first_ident)
            if db.is_tuple_name(first_name_id) {
                is_tuple = true
            }
        }
    }
    sym_id := db.get_hir_symbol(id)
    named := db.get_const_type(id)
    if (sym_id != id_none()) and (not is_tuple) {
        if named == type_defs.ty_id_none() {
            name_id := db.sym_name(sym_id)
            name := db.interner.get(name_id)
            named = types_ptr.alloc_nominal(type_defs.ty_id_none(), name, id)
            db.set_const_type(id, named)
            sym_hir := db.get_sym_hir(sym_id)
            if sym_hir != id_none() {
                db.set_const_type(sym_hir, named)
                sym_slot := db.ensure_slot(sym_hir)
                db.bind_type(sym_slot, type_defs.ty_id_type())
            }
        }
    }
    fields_vec := Vec(u32).new()

    i: u64 = 0
    while (i < names.len) and (i < types.len) {
        names = db.get_list(names_list)
        types = db.get_list(types_list)
        name_node := *(names.ptr + i)
        type_node := *(types.ptr + i)

        name_id := tbl.lhs(name_node)

        j: u64 = 0
        while j < fields_vec.len {
            if fields_vec.get(j) == name_id {
                db.type_error(name_node, Str.of("duplicate field name"))
            }
            j = j + 2
        }

        ty_val := db.get_const_type(type_node)
        if ty_val == type_defs.ty_id_none() {
            ty_val = synth_type_node(eng, type_node)
        }
        if ty_val == type_defs.ty_id_none() {
            db.type_error(type_node, Str.of("struct field requires a resolved type"))
        }
        fields_vec.push(name_id)
        fields_vec.push(ty_val)
        i = i + 1
    }

    ptr := 0 as &u32
    if fields_vec.len > 0 {
        ptr = fields_vec.ptr_at(0)
    }
    slice: Slice(u32) = .{ ptr: ptr, len: fields_vec.len }

    tyid := if db.is_extern_struct(id) {
        types_ptr.alloc_extern_struct(slice)
    } else {
        types_ptr.alloc_struct(slice)
    }
    fields_vec.destroy()

    if (sym_id != id_none()) and (not is_tuple) {
        types_ptr.set_nominal_base(named, tyid)
    } else {
        db.set_const_type(id, tyid)
        if sym_id != id_none() {
            sym_hir := db.get_sym_hir(sym_id)
            if sym_hir != id_none() {
                db.set_const_type(sym_hir, tyid)
                sym_slot := db.ensure_slot(sym_hir)
                db.bind_type(sym_slot, type_defs.ty_id_type())
            }
        }
    }

    db.bind_type(slot, type_defs.ty_id_type())
    db.set_is_const(id, true)

    methods_id := tbl.extra(id)
    if methods_id != hir.hir_none() {
        if sym_id == id_none() {
            db.type_error(id, Str.of("methods require a named struct binding"))
        }
        new_methods_id := process_methods(eng, id, methods_id, sym_id)
        tbl.set_extra(id, new_methods_id)
    }
}

synth_enum :: fn(eng &Engine, id u32) {
    db := &eng.nexus
    tbl := &db.hir
    types_ptr := &db.types

    slot := db.ensure_slot(id)
    names_list_id := tbl.lhs(id)
    vals_list_id := tbl.rhs(id)
    meta_list_id := tbl.extra(id)

    meta := db.get_list(meta_list_id)
    backing_node := *(meta.ptr + 0)
    methods_list_id := *(meta.ptr + 1)

    backing_ty := type_defs.ty_id_none()
    if backing_node != hir.hir_none() {
        backing_ty = synth_type_node(eng, backing_node)
        if backing_ty == type_defs.ty_id_none() {
            db.type_error(backing_node, Str.of("enum backing type is invalid"))
        }
    } else {
        backing_ty = types_ptr.alloc_uint(32)
    }

    names := db.get_list(names_list_id)
    vals := db.get_list(vals_list_id)

    variants := Vec(u32).new()
    curr_val: u32 = 0

    i: u64 = 0
    while i < names.len {
        name_node := *(names.ptr + i)
        name_id := tbl.lhs(name_node)
        val_node := *(vals.ptr + i)

        if val_node != hir.hir_none() {
            if tbl.kind(val_node) == hir.hir_kind.lit_int {
                curr_val = tbl.lhs(val_node)
            }
        }
        variants.push(name_id)
        variants.push(curr_val)
        curr_val = curr_val + 1
        i = i + 1
    }

    name := Str.of("enum")
    sym_id := db.get_hir_symbol(id)
    if sym_id != id_none() {
        sym_name_id := db.sym_name(sym_id)
        name = db.interner.get(sym_name_id)
    }
    enum_ty := types_ptr.alloc_enum(backing_ty, name, id, variants.as_slice())
    variants.destroy()

    db.set_const_type(id, enum_ty)
    db.bind_type(slot, type_defs.ty_id_type())
    db.set_is_const(id, true)

    if methods_list_id != hir.hir_none() {
        new_methods_id := process_methods(eng, id, methods_list_id, sym_id)
        meta_items := Vec(u32).new()
        meta_items.push(backing_node)
        meta_items.push(new_methods_id)
        new_meta_slice: Slice(u32) = .{ ptr: meta_items.ptr_at(0), len: meta_items.len }
        new_meta_id := db.add_list(new_meta_slice)
        meta_items.destroy()
        tbl.set_extra(id, new_meta_id)
    }
}

synth_struct_init :: fn(db &Nexus, tbl &hir.HirTable, id u32) {
    types_ptr := &db.types

    slot := db.unify.new_slot(id)
    fields_list := tbl.lhs(id)
    vals_list := tbl.rhs(id)

    fields := db.get_list(fields_list)
    vals := db.get_list(vals_list)

    fields_vec := Vec(u32).new()

    i: u64 = 0
    while (i < fields.len) and (i < vals.len) {
        f_node := *(fields.ptr + i)
        v_node := *(vals.ptr + i)

        name_id := tbl.lhs(f_node)

        j: u64 = 0
        while j < fields_vec.len {
            if fields_vec.get(j) == name_id {
                db.type_error(f_node, Str.of("duplicate field name"))
            }
            j = j + 2
        }

        v_slot := db.ensure_slot(v_node)
        infer_ty := types_ptr.alloc_infer(v_slot)

        fields_vec.push(name_id)
        fields_vec.push(infer_ty)
        i = i + 1
    }

    ptr := 0 as &u32
    if fields_vec.len > 0 {
        ptr = fields_vec.ptr_at(0)
    }
    slice: Slice(u32) = .{ ptr: ptr, len: fields_vec.len }

    tyid := types_ptr.alloc_struct(slice)
    fields_vec.destroy()

    db.bind_type(slot, tyid)
}

synth_member :: fn(eng &Engine, id u32) {
    db := &eng.nexus
    tbl := &db.hir
    unify_ptr := &db.unify
    types_ptr := &db.types
    slot := db.ensure_slot(id)
    lhs_id := tbl.lhs(id)

    is_type := false
    lhs_ty := type_defs.ty_id_none()
    deref_depth: u32 = 0
    lhs_slot := db.unify.get_slot(lhs_id)
    if lhs_slot == slot_none() {
        db.type_error(lhs_id, Str.of("cannot resolve member receiver"))
    }
    lhs_ty = db.unify.resolve_type_deep(types_ptr, lhs_slot)
    if lhs_ty == type_defs.ty_id_type() {
        lhs_ty = db.get_const_type(lhs_id)
        is_type = true
    } else {
        lhs_ty = types_ptr.unwrap_ptr_depth(lhs_ty, &deref_depth)
    }
    db.set_auto_deref_depth(id, deref_depth)

    target_fid := db.module_file(lhs_ty)
    if target_fid != id_none() {
        name := tbl.lhs(tbl.rhs(id))
        target := db.find_local_symbol(target_fid, name)
        if target == id_none() {
            printf(
                "\n[type error] module has no member '{}'\n       --> "
                .{ db.interner.get(name) }
            )
            db.print_loc(id)
            print("")
            #fall
        }
        if db.global_var(target) != hir.hir_none() and db.is_sym_resolving(target) {
            db.type_error(id, "circular reference in mutable global declaration")
        }
        if db.is_const(lhs_id) {
            db.forward_binding(tbl.extra(id), target)
        }
        target_slot := eng.slot_of(target)
        target = db.resolve_sym(target)
        db.set_hir_symbol(id, target)
        if target_slot == slot_none() or
            (
                db.is_sym_resolving(target) and
                    db.unify.resolve_type(target_slot) == type_defs.ty_id_none()
            ) {
            db.type_error(id, "circular reference in module binding")
        }
        db.union(slot, target_slot)
        if db.is_sym_const(target) {
            origin := db.get_sym_hir(target)
            db.set_const_type(id, db.get_const_type(origin))
            if is_type or db.is_const(lhs_id) {
                db.set_is_const(id, true)
                if db.has_const_val(origin) {
                    db.set_const_val(id, db.get_const_val(origin))
                }
            }
        }
        ret
    }
    kind := types_ptr.kind(lhs_ty)
    if (kind != type_defs.TyKind.struct_) and (kind != type_defs.TyKind.nominal) and
        (kind != type_defs.TyKind.enum_) and
        (kind != type_defs.TyKind.array) {
        printf(
            "\n\033[1;31m[type error]\033[0m member receiver must be a struct or enum, got '"
            .{}
        )
        types_ptr.print_type(lhs_ty)
        printf("'\n       --> ", .{})
        db.print_loc(id)
        print("")
        #fall
    }
    rhs_id := tbl.rhs(id)
    name_id := tbl.lhs(rhs_id)

    if kind == type_defs.TyKind.array {
        arr_len := types_ptr.get_array_len(lhs_ty)
        len_id := db.interner.intern(Str.of("len"))
        iter_id := db.interner.intern(Str.of("iter"))
        iter_ref_id := db.interner.intern(Str.of("iter_ref"))
        if name_id == len_id {
            u64_ty := types_ptr.alloc_uint(64)
            db.bind_type(slot, u64_ty)
            db.set_const_type(id, u64_ty)
            db.set_const_val(id, arr_len as u64)
            db.set_is_const(id, true)
            ret
        }
        if (name_id == iter_id) or (name_id == iter_ref_id) {
            source_ty := types_ptr.unwrap_ptr(unify_ptr.resolve_type(lhs_slot))
            if types_ptr.kind(source_ty) != type_defs.TyKind.array {
                source_ty = lhs_ty
            }
            array_ty := specialize.resolve_ty_id(eng, unify_ptr, types_ptr, source_ty)
            elem_ty := types_ptr.get_array_type(array_ty)
            is_ref := name_id == iter_ref_id
            creator_name := if is_ref {
                Str.of("RefIterator")
            } else {
                Str.of("Iterator")
            }
            creator_sym := db.resolve_sym(
                db.find_symbol(db.core_prelude, db.interner.intern(creator_name))
            )
            eng.ensure_resolved(creator_sym)
            c_args := Vec(u32).new()
            c_args.push(elem_ty)
            iter_ty := specialize.specialize_nominal_from_creator(eng, creator_sym, &c_args)
            c_args.destroy()

            p_slice := Vec(u32).new()
            p_slice.push(types_ptr.alloc_ptr(array_ty))
            fn_ty := types_ptr.alloc_func(p_slice.as_slice(), iter_ty, false)
            p_slice.destroy()

            db.bind_type(slot, fn_ty)
            db.set_const_type(id, fn_ty)
            ret
        }
        printf(
            "\n\033[1;31m[type error]\033[0m array type has no field or method named '{}'\n       --> "
            .{ db.interner.get(name_id) }
        )
        db.print_loc(id)
        print("")
        #fall
    }
    if kind == type_defs.TyKind.enum_ {
        if is_type {
            if types_ptr.enum_has_variant(lhs_ty, name_id) {
                db.bind_type(slot, lhs_ty)
                ret
            }
        }
    }
    if (not is_type) and (kind != type_defs.TyKind.enum_) {
        fields := types_ptr.get_struct_fields(lhs_ty)
        i: u64 = 0
        while i < fields.len / 2 {
            if *(fields.ptr + i * 2) == name_id {
                field_ty := *(fields.ptr + i * 2 + 1)
                if types_ptr.kind(field_ty) == type_defs.TyKind.infer {
                    db.union(slot, types_ptr.payload(field_ty))
                } else {
                    db.bind_type(slot, field_ty)
                }
                ret
            }
            i = i + 1
        }
    }
    if (kind == type_defs.TyKind.nominal) or (kind == type_defs.TyKind.enum_) {
        origin := types_ptr.nominal_origin(lhs_ty)
        if kind == type_defs.TyKind.enum_ {
            origin = types_ptr.enum_origin(lhs_ty)
        }
        struct_id := origin
        if ((origin & 2147483648) == 0) and (tbl.kind(origin) == hir.hir_kind.binding) {
            struct_id = tbl.extra(origin)
        }
        spec_node := types_ptr.get_nominal_struct_node(origin)
        if spec_node != type_defs.ty_id_none() {
            struct_id = spec_node
        }
        methods_id := tbl.extra(struct_id)
        if kind == type_defs.TyKind.enum_ {
            meta := db.get_list(methods_id)
            methods_id = *(meta.ptr + 1)
        }
        if methods_id != hir.hir_none() {
            methods := db.get_list(methods_id)
            i: u64 = 0
            while i < methods.len {
                method := *(methods.ptr + i)
                method_name := tbl.lhs(tbl.lhs(method))
                if method_name == name_id {
                    func_node := tbl.extra(method)
                    if tbl.kind(func_node) != hir.hir_kind.function {
                        c_ty := db.get_const_type(func_node)
                        if c_ty == type_defs.ty_id_none() {
                            c_ty = db.get_const_type(method)
                        }
                        if c_ty == type_defs.ty_id_none() {
                            c_ty = db.get_node_type(func_node)
                        }
                        if db.has_const_val(func_node) {
                            db.set_const_val(id, db.get_const_val(func_node))
                            db.set_is_const(id, true)
                        } else if db.has_const_val(method) {
                            db.set_const_val(id, db.get_const_val(method))
                            db.set_is_const(id, true)
                        }
                        node_ty := db.get_node_type(func_node)
                        if node_ty == type_defs.ty_id_none() {
                            node_ty = db.get_node_type(method)
                        }
                        if node_ty == type_defs.ty_id_type() {
                            db.set_const_type(id, c_ty)
                            db.bind_type(slot, type_defs.ty_id_type())
                        } else if c_ty != type_defs.ty_id_none() {
                            db.set_const_type(id, c_ty)
                            db.bind_type(slot, c_ty)
                        }
                        method_sym := db.get_hir_symbol(method)
                        if method_sym != id_none() {
                            db.set_hir_symbol(id, method_sym)
                        }
                        ret
                    }
                    receiver := functions.func_has_self(db, func_node)
                    if is_type and receiver {
                        db.type_error(
                            id
                            Str.of("instance method requires a value; call it on an instance")
                        )
                    }
                    if (not is_type) and (not receiver) {
                        db.type_error(id, Str.of("static method requires the type"))
                    }
                    creator_sym := types_ptr.get_nominal_creator_sym(origin)
                    if creator_sym != type_defs.ty_id_none() {
                        func_node := tbl.extra(method)
                        concrete_method_ty := specialize.specialize_nominal_method(
                            eng
                            origin
                            struct_id
                            func_node
                            lhs_ty
                        )
                        method_sym := db.get_hir_symbol(method)
                        db.set_hir_symbol(id, method_sym)
                        db.set_const_type(id, concrete_method_ty)
                        db.bind_type(slot, concrete_method_ty)
                        ret
                    }
                    method_slot := unify_ptr.get_slot(method)
                    if method_slot == slot_none() {
                        func_node := tbl.extra(method)
                        functions.synth_func(eng, func_node)
                        method_slot = unify_ptr.new_slot(method)
                        func_slot := unify_ptr.get_slot(func_node)
                        func_ty := unify_ptr.resolve_type(func_slot)
                        db.bind_type(method_slot, func_ty)
                    }
                    method_sym := db.get_hir_symbol(method)
                    db.set_hir_symbol(id, method_sym)
                    db.union(slot, method_slot)
                    ret
                }
                i = i + 1
            }
        }
    }
    printf("\n\033[1;31m[type error]\033[0m type '", .{})
    types_ptr.print_type(lhs_ty)
    printf("' has no field or method named '{}'\n       --> ", .{ db.interner.get(name_id) })
    db.print_loc(id)
    print("")
    #fall
}

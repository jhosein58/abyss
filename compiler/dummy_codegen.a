import Str, String from "std/string"
import Arena from "std/allocator"
import TypeStorage from "./types"
import HirExprKind, hir_none from "./hir"
import Vec from "std/collections/vec"

DummyLoopScope :: struct {
    outer_id u32
    outer_break bool
    outer_cont bool
}

DummyCodeBuilder :: struct {
    new :: fn() Self { .{} }

    new_list :: fn(self &Self, arena &Arena) Vec(u32) { Vec(u32).new() }

    append_list_item :: fn(self &Self, list &Vec(u32), value u32, first bool) {
        list.push(value)
    }

    finish_list :: fn(self &Self, list &Vec(u32)) u32 {
        size := list.len as u32
        list.destroy()
        size + 1
    }
}

DummyCodeGen :: struct {
    arena      : &Arena
    output     : String
    main_sym   : u32
    has_main   : bool
    loop_id_v  : u32
    loop_break : bool
    loop_cont  : bool
    values     : u32

    new :: fn(arena &Arena) Self {
        .{
            arena      : arena,
            output     : String.new(arena),
            main_sym   : 0,
            has_main   : false,
            loop_id_v  : hir_none(),
            loop_break : false,
            loop_cont  : false,
            values     : 0
        }
    }

    value :: fn(self &Self, operation Str) u32 {
        self.values = self.values + 1
        self.record(operation)
        self.values
    }

    empty_value :: fn(self &Self) u32 { 0 }
    has_value :: fn(self &Self, value u32) bool { value != 0 }
    extern_name :: fn(self &Self, name Str) u32 { self.value(Str.of("dummy_extern")) }
    expr_float :: fn(self &Self, raw Str) u32 { self.value(Str.of("dummy_float")) }
    empty_parameters :: fn(self &Self) u32 { self.value(Str.of("dummy_empty_parameters")) }
    parameter_name :: fn(self &Self, arena &Arena, index u32) u32 { self.value(Str.of("dummy_parameter_name")) }
    parameter :: fn(self &Self, arena &Arena, ty u32, name u32) u32 { self.value(Str.of("dummy_parameter")) }

    destroy :: fn(self &Self) {
    }

    record :: fn(self &Self, name Str) {
        self.output.push_str(name)
        self.output.push_char('\n')
    }

    indent_line :: fn(self &Self) {
    }

    abyss_main :: fn(self &Self, sym_id u32) {
        self.main_sym = sym_id
        self.has_main = true
        self.record(Str.of("dummy_main"))
    }

    declare_function :: fn(self &Self, fn_name u32, ret_type u32, params u32) {
        self.record(Str.of("dummy_declare_function"))
    }

    start_function :: fn(self &Self, fn_name u32, ret_type u32, params u32) {
        self.record(Str.of("dummy_start_function"))
    }

    end_function :: fn(self &Self) {
        self.record(Str.of("dummy_end_function"))
    }

    create_variable :: fn(self &Self, name u32, ty u32, init_val u32, has_init bool) {
        self.record(Str.of("dummy_variable"))
    }

    expr :: fn(self &Self, e u32) {
        self.record(Str.of("dummy_expr"))
    }

    gen_return :: fn(self &Self, val u32, has_val bool) {
        self.record(Str.of("dummy_return"))
    }

    start_if :: fn(self &Self, cond u32) {
        self.record(Str.of("dummy_if"))
    }

    else_ :: fn(self &Self) {
        self.record(Str.of("dummy_else"))
    }

    start_while :: fn(self &Self, cond u32) {
        self.record(Str.of("dummy_while"))
    }

    end_block :: fn(self &Self) {
        self.record(Str.of("dummy_end_block"))
    }

    loop_label :: fn(self &Self, arena &Arena, id u32, suffix Str) u32 {
        self.value(Str.of("dummy_label"))
    }

    loop_begin_label :: fn(self &Self, arena &Arena, id u32) u32 {
        self.value(Str.of("dummy_begin"))
    }

    loop_end_label :: fn(self &Self, arena &Arena, id u32) u32 {
        self.value(Str.of("dummy_end"))
    }

    iterator_name :: fn(self &Self, arena &Arena, id u32, index u32) u32 {
        self.value(Str.of("dummy_iterator"))
    }

    iterator_next_name :: fn(self &Self, arena &Arena, id u32, index u32) u32 {
        self.value(Str.of("dummy_next_iterator"))
    }

    emit_label :: fn(self &Self, arena &Arena, label u32) {
        self.record(Str.of("dummy_label"))
    }

    emit_goto :: fn(self &Self, arena &Arena, label u32) {
        self.record(Str.of("dummy_goto"))
    }

    emit_break :: fn(self &Self, arena &Arena) {
        self.loop_break = true
        self.record(Str.of("dummy_break"))
    }

    emit_cont :: fn(self &Self, arena &Arena) {
        self.loop_cont = true
        self.record(Str.of("dummy_continue"))
    }

    break_statement :: fn(self &Self) {
        self.record(Str.of("dummy_break_statement"))
    }

    begin_loop :: fn(self &Self, id u32) DummyLoopScope {
        scope: DummyLoopScope = .{ outer_id: self.loop_id_v, outer_break: self.loop_break, outer_cont: self.loop_cont }
        self.set_loop(id, false, false)
        scope
    }

    start_loop :: fn(self &Self, arena &Arena, scope &DummyLoopScope, condition u32) {
        self.set_loop(hir_none(), false, false)
        self.record(Str.of("dummy_while"))
    }

    start_iterator_loop :: fn(self &Self, arena &Arena, scope &DummyLoopScope) {
        self.record(Str.of("dummy_iterator_loop"))
    }

    end_loop :: fn(self &Self, arena &Arena, scope &DummyLoopScope) {
        self.record(Str.of("dummy_end_loop"))
        self.set_loop(scope.outer_id, scope.outer_break, scope.outer_cont)
    }

    begin_expr :: fn(self &Self) u64 {
        self.output.mark()
    }

    code_len :: fn(self &Self) u64 {
        self.output.len()
    }

    loop_id :: fn(self &Self) u32 {
        self.loop_id_v
    }

    loop_breaks :: fn(self &Self) bool {
        self.loop_break
    }

    loop_continues :: fn(self &Self) bool {
        self.loop_cont
    }

    set_loop :: fn(self &Self, id u32, breaks bool, continues bool) {
        self.loop_id_v = id
        self.loop_break = breaks
        self.loop_cont = continues
    }

    end_expr :: fn(self &Self, arena &Arena, mark u64, value u32) u32 {
        if self.output.len() == mark { ret value }
        self.output.reset(mark)
        self.value(Str.of("dummy_block"))
    }

    decl_struct :: fn(self &Self, name u32) {
        self.record(Str.of("dummy_decl_struct"))
    }

    def_struct :: fn(self &Self, ty_id u32, name u32, body u32) {
        self.record(Str.of("dummy_def_struct"))
    }

    define_struct :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        self.record(Str.of("dummy_struct"))
    }

    define_func_type :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        self.record(Str.of("dummy_function_type"))
    }

    define_enum :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        self.record(Str.of("dummy_enum"))
    }

    define_union :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        self.record(Str.of("dummy_union"))
    }

    finish :: fn(self &Self, pre Str) Str {
        self.output.as_str()
    }

    type_str :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) u32 {
        self.value(Str.of("dummy_type"))
    }

    sym_name :: fn(self &Self, arena &Arena, sym_id u32) u32 {
        self.value(Str.of("dummy_symbol"))
    }

    field_name :: fn(self &Self, arena &Arena, field_id u32) u32 {
        self.value(Str.of("dummy_field"))
    }

    expr_int :: fn(self &Self, arena &Arena, val u32) u32 { self.value(Str.of("dummy_int")) }
    expr_one :: fn(self &Self, arena &Arena) u32 { self.value(Str.of("dummy_one")) }
    expr_str_lit :: fn(self &Self, arena &Arena, struct_name u32, ptr_id u32, len_id u32, raw Str) u32 { self.value(Str.of("dummy_string")) }
    expr_char_lit :: fn(self &Self, arena &Arena, raw Str) u32 { self.value(Str.of("dummy_char")) }
    expr_cstr_lit :: fn(self &Self, arena &Arena, raw Str) u32 { self.value(Str.of("dummy_cstr")) }
    expr_bool :: fn(self &Self, val bool) u32 { self.value(Str.of("dummy_bool")) }
    expr_assign :: fn(self &Self, arena &Arena, lhs u32, rhs u32) u32 { self.value(Str.of("dummy_assign")) }
    expr_binary :: fn(self &Self, arena &Arena, op Str, lhs u32, rhs u32) u32 { self.value(Str.of("dummy_binary")) }
    expr_conditional :: fn(self &Self, arena &Arena, cond u32, then_val u32, else_val u32) u32 { self.value(Str.of("dummy_conditional")) }
    expr_zero :: fn(self &Self, arena &Arena, ty u32) u32 { self.value(Str.of("dummy_zero")) }
    expr_unary :: fn(self &Self, arena &Arena, op Str, inner u32) u32 { self.value(Str.of("dummy_unary")) }
    expr_neg :: fn(self &Self, arena &Arena, inner u32) u32 { self.value(Str.of("dummy_neg")) }
    expr_not :: fn(self &Self, arena &Arena, inner u32) u32 { self.value(Str.of("dummy_not")) }
    expr_bit_not :: fn(self &Self, arena &Arena, inner u32) u32 { self.value(Str.of("dummy_bit_not")) }
    expr_address :: fn(self &Self, arena &Arena, inner u32) u32 { self.value(Str.of("dummy_address")) }
    expr_deref :: fn(self &Self, arena &Arena, inner u32) u32 { self.value(Str.of("dummy_deref_value")) }
    expr_str_deref :: fn(self &Self, arena &Arena, inner u32, ptr_id u32) u32 { self.value(Str.of("dummy_deref")) }
    expr_cast :: fn(self &Self, arena &Arena, ty_str u32, inner u32) u32 { self.value(Str.of("dummy_cast")) }
    expr_call :: fn(self &Self, arena &Arena, callee u32, args u32) u32 { self.value(Str.of("dummy_call")) }
    expr_member :: fn(self &Self, arena &Arena, lhs u32, depth u32, field_id u32) u32 { self.value(Str.of("dummy_member")) }
    expr_struct_init_field :: fn(self &Self, arena &Arena, field_id u32, val_str u32) u32 { self.value(Str.of("dummy_field_init")) }
    expr_struct_init :: fn(self &Self, arena &Arena, struct_name u32, fields_body u32) u32 { self.value(Str.of("dummy_struct_init")) }
    expr_sizeof :: fn(self &Self, arena &Arena, ty u32) u32 { self.value(Str.of("dummy_sizeof")) }
    expr_union :: fn(self &Self, arena &Arena, union_name u32, tag u32, value u32) u32 { self.value(Str.of("dummy_union")) }
    expr_union_member :: fn(self &Self, arena &Arena, value u32, tag u32) u32 { self.value(Str.of("dummy_union_member")) }
    expr_union_tag :: fn(self &Self, arena &Arena, value u32) u32 { self.value(Str.of("dummy_union_tag")) }
    expr_union_is :: fn(self &Self, arena &Arena, value u32, tag u32) u32 { self.value(Str.of("dummy_union_is")) }
    expr_enum_value :: fn(self &Self, arena &Arena, enum_name u32, value u32) u32 { self.value(Str.of("dummy_enum_value")) }
    expr_address_of_value :: fn(self &Self, arena &Arena, ty u32, value u32) u32 { self.value(Str.of("dummy_address")) }
    expr_field_value :: fn(self &Self, arena &Arena, value u32, field_id u32) u32 { self.value(Str.of("dummy_field")) }
    expr_index :: fn(self &Self, arena &Arena, value u32, index u32) u32 { self.value(Str.of("dummy_index")) }

    append_list_item :: fn(self &Self, list &Vec(u32), value u32, first bool) {
        list.push(value)
    }

    binary_op :: fn(self &Self, kind HirExprKind) Str {
        Str.of(" dummy_op ")
    }

    expr_binary_kind :: fn(self &Self, arena &Arena, kind HirExprKind, lhs u32, rhs u32) u32 { self.value(Str.of("dummy_binary_kind")) }
    expr_equal :: fn(self &Self, arena &Arena, lhs u32, rhs u32) u32 { self.value(Str.of("dummy_equal")) }
    expr_or :: fn(self &Self, arena &Arena, lhs u32, rhs u32) u32 { self.value(Str.of("dummy_or")) }
    expr_less_equal :: fn(self &Self, arena &Arena, lhs u32, rhs u32) u32 { self.value(Str.of("dummy_less_equal")) }
    expr_add :: fn(self &Self, arena &Arena, lhs u32, rhs u32) u32 { self.value(Str.of("dummy_add")) }
}

DummyCodeGen_new :: fn(arena &Arena) DummyCodeGen {
    DummyCodeGen.new(arena)
}

DummyCodeGen_destroy :: fn(self &DummyCodeGen) {
    self.destroy()
}

DummyCodeGen_abyss_main :: fn(self &DummyCodeGen, sym_id u32) {
    self.abyss_main(sym_id)
}

DummyCodeGen_finish :: fn(self &DummyCodeGen, pre Str) Str {
    self.finish(pre)
}

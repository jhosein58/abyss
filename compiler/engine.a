import Nexus from "nexus/nexus.a"

import token, TokenStream from "token.a"
import lex from "lexer.a"
import index_file from "indexer.a"
import Parser_new, peek, curr_span, parse_error_at from "parser/core.a"
import parse_expr from "parser/parser.a"
import ScopeEnv_destroy from "parser/env.a"
import type_check, type_check_calls from "typer/tyck.a"
import id_none from "nexus/pool.a"
import slot_none from "unify.a"
   import ty_id_none, ty_kind from "types.a"
import Str from "../std/string.a"
import VecU32 from "../std/vec/u32.a"
import Arena from "../std/allocator.a"
import fall from "../std/sys.a"

import CCodeGen, CCodeGen_new, CCodeGen_destroy, CCodeGen_abyss_main, CCodeGen_finish from "codegen.a"
import lower_function from "lower.a"

print :: (s &u8) unit
print_u32 :: (v u32) unit 

Engine :: struct {
    nexus         : Nexus,
    file_count    : u32,
    ccg           : CCodeGen,
    pending_calls : VecU32,
    check_depth   : u32

    new :: () Self {
        .{
            nexus         : Nexus.new(),
            file_count    : 0,
            ccg           : CCodeGen_new(),
            pending_calls : VecU32.new(),
            check_depth   : 0
        }
    }

    destroy :: () {
        CCodeGen_destroy(&.ccg)
        .pending_calls.destroy()
    }

    self :: () &Self {
        .nexus
        ret
    }

    add_file :: (arena &Arena, path Str, source Str) u32 {
        file_id := .nexus.add_file(path, source)
        .file_count = file_id + 1

        tok_start := .nexus.tokens.count()
        lex(&.nexus.tokens, source, path)
        tok_end := .nexus.tokens.count()

        index_file(&.nexus, arena, file_id, path, tok_start as u32, tok_end as u32)
        file_id
    }

    get_symbol_id :: (file_id u32, sym_name Str) u32 {
        name_id := .nexus.interner.intern(sym_name)
        .nexus.find_symbol(file_id, name_id)
    }

    parse :: (sym_id u32) {
        if sym_id == id_none() {
            print("\n[syntax error] symbol not found\n")
            fall()
        }

        file_id   := .nexus.sym_files.get(sym_id)
        tok_start := .nexus.sym_tok_start.get(sym_id)
        tok_end   := .nexus.sym_tok_end.get(sym_id)
        count     := tok_end - tok_start

        hir_start := .nexus.hir.len()

        parser := Parser_new(
            &.nexus,
            &.nexus.tokens,
            &.nexus.hir,
            file_id,
            sym_id,
            tok_start,
            count
        )

        parse_expr(&parser, 0)
        if peek(&parser) != token().eof {
            parse_error_at(&parser, "unexpected token after declaration", curr_span(&parser))
        }
        ScopeEnv_destroy(&parser.env)

        hir_end := .nexus.hir.len()

        .nexus.sym_hir_start.set(sym_id, hir_start)
        .nexus.sym_hir_end.set(sym_id, hir_end)
    }

    type_check :: (sym_id u32) {
        hir_start := .nexus.sym_hir_start.get(sym_id)
        hir_end   := .nexus.sym_hir_end.get(sym_id)

        .check_depth = .check_depth + 1
        type_check(.self(), hir_start, hir_end)
        .check_depth = .check_depth - 1
        if .check_depth == 0 {
            type_check_calls(.self())
        }
    }

    ensure_resolved :: (sym_id u32) {
        if sym_id == id_none() { ret }
        db := &.nexus

        real_sym := sym_id
        while true {
            tgt := db.sym_target.get(real_sym)
            if (tgt == id_none()) or (tgt == real_sym) {
                break
            }
            real_sym = tgt
        }

        tok_start := db.sym_tok_start.get(real_sym)
        if tok_start == id_none() {
            ret
        }

        decl_hir := db.get_sym_hir(real_sym)
        if decl_hir != id_none() {
            s := (&db.unify).get_slot(decl_hir)
            if s != slot_none() {
                ty := (&db.unify).resolve_type(s)
                if ty != ty_id_none() {
                    ret
                }
            }
        }

        if db.is_sym_resolving(real_sym) {
            ret
        }

        hir_start := db.sym_hir_start.get(real_sym)
        if hir_start == id_none() {
            db.set_sym_resolving(real_sym, true)
            .parse(real_sym)
            db.set_sym_resolving(real_sym, false)
        }

        decl_hir = db.get_sym_hir(real_sym)
        if decl_hir != id_none() {
            s := (&db.unify).get_slot(decl_hir)
            if s == slot_none() {
                (&db.unify).new_slot(decl_hir)
            }
        }

        db.set_sym_resolving(real_sym, true)
        .type_check(real_sym)
        db.set_sym_resolving(real_sym, false)
    }

    slot_of :: (sym_id u32) u32 {
        if sym_id == id_none() { ret slot_none() }
        db := &.nexus

        real_sym := sym_id
        while true {
            tgt := db.sym_target.get(real_sym)
            if (tgt == id_none()) or (tgt == real_sym) {
                break
            }
            real_sym = tgt
        }

        tok_start := db.sym_tok_start.get(real_sym)
        if tok_start == id_none() {
            decl_hir := db.get_sym_hir(real_sym)
            if decl_hir == id_none() { ret slot_none() }
            ret (&db.unify).get_slot(decl_hir)
        }

        .ensure_resolved(real_sym)
        decl_hir := db.get_sym_hir(real_sym)
        if decl_hir == id_none() { ret slot_none() }
        (&db.unify).get_slot(decl_hir)
    }

    type_of :: (sym_id u32) u32 {
        slot := .slot_of(sym_id)
        if slot == slot_none() { ret ty_id_none() }
        (&.nexus.unify).resolve_type(slot)
    }

    abyss_main :: (sym_id u32) {
        ty := .type_of(sym_id)
        types := &.nexus.types
          if (&(*types)).kind( ty) != ty_kind().func {
            print("\n[type error] main must be a function\n")
            fall()
        }
          if ((&(*types)).func_params_len( ty) != 0) or (&(*types)).func_is_extern( ty) {
            print("\n[type error] main must be a defined function with no arguments\n")
            fall()
        }
        CCodeGen_abyss_main(&.ccg, sym_id)
    }

    compile :: (arena &Arena, sym_id u32) {
        visited := VecU32.new()
        lower_function(&.nexus, &.ccg, arena, sym_id, &visited)
        visited.destroy()
    }

}

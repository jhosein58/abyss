import Nexus from "./nexus/nexus"

import token, TokenStream from "./token"
import lex from "./lexer"
import index_file from "./indexer"
import Parser_new, peek, curr_span, parse_error_at from "./parser/core"
import parse_expr from "./parser/parser"
import type_check from "./typer/tyck"
import id_none from "./nexus/pool"
import slot_none from "./unify"
import ty_id_none, TyKind from "./types"
import Str from "std/string"
import Path from "std/path"
import Arena from "std/allocator"
import fall from "std/sys"
import lower_function from "./lower"


print :: fn(s &u8)
print_u32 :: fn(v u32) 

Engine :: struct {
    nexus         Nexus
    file_count    u32

    new :: fn(arena &Arena) Self {
        .{
            nexus         : Nexus.new(),
            file_count    : 0
        }
    }

    destroy :: fn(self &Self) {
    }

    add_file :: fn(self &Self, arena &Arena, path Str, source Str) u32 {
        norm_path := Path.normalize(arena, path)
        file_id := self.nexus.add_file(norm_path, source)
        self.file_count = file_id + 1

        tok_start := self.nexus.tokens.count()
        lex(&self.nexus.tokens, source, norm_path)
        tok_end := self.nexus.tokens.count()

        index_file(&self.nexus, arena, file_id, norm_path, tok_start as u32, tok_end as u32)
        file_id
    }

    get_symbol_id :: fn(self &Self, file_id u32, sym_name Str) u32 {
        name_id := self.nexus.interner.intern(sym_name)
        self.nexus.find_symbol(file_id, name_id)
    }

    parse :: fn(self &Self, sym_id u32) {
        if sym_id == id_none() {
            print(c"\n[syntax error] symbol not found\n")
            fall()
        }

        file_id   := self.nexus.sym_files.get(sym_id)
        tok_start := self.nexus.sym_tok_start.get(sym_id)
        tok_end   := self.nexus.sym_tok_end.get(sym_id)
        count     := tok_end - tok_start

        hir_start := self.nexus.hir.len()

        parser := Parser_new(
            &self.nexus,
            &self.nexus.tokens,
            &self.nexus.hir,
            file_id,
            sym_id,
            tok_start,
            count
        )

        parse_expr(&parser, 0)
        if peek(&parser) != token.eof {
            parse_error_at(&parser, c"unexpected token after declaration", curr_span(&parser))
        }
        parser.env.destroy()

        hir_end := self.nexus.hir.len()

        self.nexus.sym_hir_start.set(sym_id, hir_start)
        self.nexus.sym_hir_end.set(sym_id, hir_end)
    }

    type_check :: fn(self &Self, sym_id u32) {
        hir_start := self.nexus.sym_hir_start.get(sym_id)
        hir_end   := self.nexus.sym_hir_end.get(sym_id)

        type_check(self, hir_start, hir_end)
    }

    ensure_resolved :: fn(self &Self, sym_id u32) {
        if sym_id == id_none() { ret }
        db := &self.nexus

        real_sym := db.resolve_sym(sym_id)

        tok_start := db.sym_tok_start.get(real_sym)
        if tok_start == id_none() {
            ret
        }

        decl_hir := db.get_sym_hir(real_sym)
        if decl_hir != id_none() {
            s := (&db.unify).get_slot(decl_hir)
            if s != slot_none() {
                ty := (&db.unify).resolve_type(s)
                if ty != ty_id_none() {
                    ret
                }
            }
        }

        if db.is_sym_resolving(real_sym) {
            ret
        }

        hir_start := db.sym_hir_start.get(real_sym)
        if hir_start == id_none() {
            db.set_sym_resolving(real_sym, true)
            self.parse(real_sym)
            db.set_sym_resolving(real_sym, false)
        }

        decl_hir = db.get_sym_hir(real_sym)
        if decl_hir != id_none() {
            s := (&db.unify).get_slot(decl_hir)
            if s == slot_none() {
                (&db.unify).new_slot(decl_hir)
            }
        }

        db.set_sym_resolving(real_sym, true)
        self.type_check(real_sym)
        db.set_sym_resolving(real_sym, false)
    }

    slot_of :: fn(self &Self, sym_id u32) u32 {
        if sym_id == id_none() { ret slot_none() }
        db := &self.nexus

        real_sym := db.resolve_sym(sym_id)

        tok_start := db.sym_tok_start.get(real_sym)
        if tok_start == id_none() {
            decl_hir := db.get_sym_hir(real_sym)
            if decl_hir == id_none() { ret slot_none() }
            ret (&db.unify).get_slot(decl_hir)
        }

        self.ensure_resolved(real_sym)
        decl_hir := db.get_sym_hir(real_sym)
        if decl_hir == id_none() { ret slot_none() }
        (&db.unify).get_slot(decl_hir)
    }

    type_of :: fn(self &Self, sym_id u32) u32 {
        slot := self.slot_of(sym_id)
        if slot == slot_none() { ret ty_id_none() }
        (&self.nexus.unify).resolve_type(slot)
    }

    get_str_type :: fn(self &Self) u32 {
        db := &self.nexus
        if (*db).str_type != ty_id_none() {
            ret (*db).str_type
        }
        if (*db).core_prelude == id_none() {
            ret ty_id_none()
        }
        name_id := (*db).interner.intern(Str.of("Str"))
        sym_str := (*db).find_symbol((*db).core_prelude, name_id)
        if sym_str == id_none() {
            ret ty_id_none()
        }
        self.ensure_resolved(sym_str)
        real_sym := (*db).resolve_sym(sym_str)
        decl_hir := (*db).get_sym_hir(real_sym)
        if decl_hir != id_none() {
            str_ty := (*db).get_const_type(decl_hir)
            (*db).str_type = str_ty
            ret str_ty
        }
        ty_id_none()
    }

    validate_main :: fn(self &Self, sym_id u32) {
        ty := self.type_of(sym_id)
        types := &self.nexus.types
        if types.kind(ty) != TyKind.func {
            print(c"\n[type error] main must be a function\n")
            fall()
        }
          if ((&(*types)).func_params_len( ty) != 0) or (&(*types)).func_is_extern( ty) {
            print(c"\n[type error] main must be a defined function with no arguments\n")
            fall()
        }
    }

    build_main :: fn(self &Self, fid u32) u32 {
        sym_id := self.get_symbol_id(fid, Str.of("main"))
        self.parse(sym_id)
        self.type_check(sym_id)
        self.validate_main(sym_id)
        sym_id
    }


    compile :: fn(self &Self, B type, L type, backend &B, builder &L, arena &Arena, sym_id u32) {
        visited := HashSet(u32).new()
        lower_function(self, backend, builder, backend.empty_value(), arena, sym_id, &visited)
        visited.destroy()
    }

}

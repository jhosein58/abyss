import std.allocator: Arena
import std.path:      Path
import std.string:    Str
import std.sys:       fall

import .hir:           hir_kind, hir_none
import .indexer:       index_file
import .lexer:         lex
import .lower:         lower_function
import .nexus.nexus:   Nexus
import .nexus.pool:    id_none
import .parser.core:   Parser_new, curr_span, parse_error_at, peek
import .parser.parser: parse_expr
import .token:         Token, TokenStream
import .typer.global:  check_global_var
import .typer.tyck:    finalize_inferred_types, process_mono_funcs, type_check
import .types:         TyKind, ty_id_none, ty_id_type
import .unify:         slot_none

Engine :: struct {
    nexus      Nexus
    file_count u32
    new :: fn(arena &Arena) Self {
        res: Self = .{ nexus: Nexus.new(), file_count: 0 }
        res.nexus.init_tuple_names()
        res
    }

    destroy :: fn(self &Self) {
        self.nexus.destroy()
    }

    add_file :: fn(self &Self, arena &Arena, path Str, source Str) u32 {
        norm_path := Path.normalize(arena, path)
        file_id := self.nexus.add_file(norm_path, source)
        self.file_count = file_id + 1

        tok_start := self.nexus.tokens.count()
        lex(&self.nexus.tokens, source, norm_path)
        tok_end := self.nexus.tokens.count()

        index_file(&self.nexus, arena, file_id, norm_path, tok_start as u32, tok_end as u32)
        file_id
    }

    get_symbol_id :: fn(self &Self, file_id u32, sym_name Str) u32 {
        name_id := self.nexus.interner.intern(sym_name)
        self.nexus.find_symbol(file_id, name_id)
    }

    parse :: fn(self &Self, sym_id u32) {
        if sym_id == id_none() {
            print("\n[syntax error] symbol not found")
            #fall
        }
        file_id := self.nexus.sym_file(sym_id)
        tok_start := self.nexus.sym_tok_start(sym_id)
        tok_end := self.nexus.sym_tok_end(sym_id)
        count := tok_end - tok_start

        hir_start := self.nexus.hir.len()

        parser := Parser_new(
            &self.nexus
            &self.nexus.tokens
            &self.nexus.hir
            file_id
            sym_id
            tok_start
            count
        )

        parse_expr(&parser, 0)
        if peek(&parser) != Token.eof {
            parse_error_at(&parser, c"unexpected token after declaration", curr_span(&parser))
        }
        parser.env.destroy()

        hir_end := self.nexus.hir.len()

        self.nexus.set_sym_hir_range(sym_id, hir_start, hir_end)
    }

    type_check :: fn(self &Self, sym_id u32) {
        hir_start := self.nexus.sym_hir_start(sym_id)
        hir_end := self.nexus.sym_hir_end(sym_id)

        type_check(self, hir_start, hir_end)
        global := self.nexus.global_var(sym_id)
        if global != hir_none() {
            check_global_var(self, global)
        }
        fn_node := self.nexus.get_fn_node(sym_id)
        if fn_node != id_none() {
            finalize_inferred_types(self, fn_node)
        }
    }

    predeclare_nominal :: fn(self &Self, sym_id u32) {
        db := &self.nexus
        decl_hir := db.get_sym_hir(sym_id)
        if decl_hir == id_none() {
            ret
        }
        hir_end := db.sym_hir_end(sym_id)
        if (hir_end == id_none()) or (hir_end == 0) {
            ret
        }
        root := hir_end - 1
        if db.hir.kind(root) != hir_kind.binding {
            ret
        }
        value_node := db.hir.extra(root)
        if (value_node == id_none()) or (db.hir.kind(value_node) != hir_kind.struct_) {
            ret
        }
        names_list := db.hir.lhs(value_node)
        if names_list != id_none() {
            names := db.get_list(names_list)
            if names.len > 0 {
                first_ident := *(names.ptr)
                if (first_ident != id_none()) and (db.hir.kind(first_ident) == hir_kind.ident) {
                    first_name_id := db.hir.lhs(first_ident)
                    if db.is_tuple_name(first_name_id) {
                        ret
                    }
                }
            }
        }
        existing := db.get_const_type(decl_hir)
        if existing != ty_id_none() {
            ret
        }
        name_id := db.sym_name(sym_id)
        name := db.interner.get(name_id)
        named := db.types.alloc_nominal(ty_id_none(), name, value_node)

        db.set_const_type(value_node, named)
        db.set_const_type(decl_hir, named)
        db.set_is_const(decl_hir, true)

        slot := (&db.unify).get_slot(decl_hir)
        if slot == slot_none() {
            slot = (&db.unify).new_slot(decl_hir)
        }
        (&db.unify).bind_type(&db.types, slot, ty_id_type())
    }

    ensure_resolved :: fn(self &Self, sym_id u32) {
        if sym_id == id_none() {
            ret
        }
        db := &self.nexus

        real_sym := db.resolve_sym(sym_id)

        tok_start := db.sym_tok_start(real_sym)
        if tok_start == id_none() {
            ret
        }
        decl_hir := db.get_sym_hir(real_sym)
        if decl_hir != id_none() {
            s := (&db.unify).get_slot(decl_hir)
            if s != slot_none() {
                ty := (&db.unify).resolve_type(s)
                if ty != ty_id_none() {
                    ret
                }
            }
        }
        if db.is_sym_resolving(real_sym) {
            ret
        }
        hir_start := db.sym_hir_start(real_sym)
        if hir_start == id_none() {
            db.set_sym_resolving(real_sym, true)
            self.parse(real_sym)
            db.set_sym_resolving(real_sym, false)
        }
        decl_hir = db.get_sym_hir(real_sym)
        if decl_hir != id_none() {
            s := (&db.unify).get_slot(decl_hir)
            if s == slot_none() {
                (&db.unify).new_slot(decl_hir)
            }
        }
        self.predeclare_nominal(real_sym)

        db.set_sym_resolving(real_sym, true)
        self.type_check(real_sym)
        db.set_sym_resolving(real_sym, false)
    }

    slot_of :: fn(self &Self, sym_id u32) u32 {
        if sym_id == id_none() {
            ret slot_none()
        }
        db := &self.nexus

        real_sym := db.resolve_sym(sym_id)

        tok_start := db.sym_tok_start(real_sym)
        if tok_start == id_none() {
            decl_hir := db.get_sym_hir(real_sym)
            if decl_hir == id_none() {
                ret slot_none()
            }
            ret (&db.unify).get_slot(decl_hir)
        }
        self.ensure_resolved(real_sym)
        decl_hir := db.get_sym_hir(real_sym)
        if decl_hir == id_none() {
            ret slot_none()
        }
        (&db.unify).get_slot(decl_hir)
    }

    type_of :: fn(self &Self, sym_id u32) u32 {
        slot := self.slot_of(sym_id)
        if slot == slot_none() {
            ret ty_id_none()
        }
        (&self.nexus.unify).resolve_type(slot)
    }

    get_str_type :: fn(self &Self) u32 {
        db := &self.nexus
        if (*db).str_type != ty_id_none() {
            ret (*db).str_type
        }
        if (*db).core_prelude == id_none() {
            ret ty_id_none()
        }
        name_id := (*db).interner.intern(Str.of("Str"))
        sym_str := (*db).find_symbol((*db).core_prelude, name_id)
        if sym_str == id_none() {
            ret ty_id_none()
        }
        self.ensure_resolved(sym_str)
        real_sym := (*db).resolve_sym(sym_str)
        decl_hir := (*db).get_sym_hir(real_sym)
        if decl_hir != id_none() {
            str_ty := (*db).get_const_type(decl_hir)
            (*db).str_type = str_ty
            ret str_ty
        }
        ty_id_none()
    }

    validate_main :: fn(self &Self, sym_id u32) {
        ty := self.type_of(sym_id)
        types := &self.nexus.types
        if types.kind(ty) != TyKind.func {
            print("\n[type error] main must be a function")
            #fall
        }
        if ((&(*types)).func_params_len(ty) != 0) or (&(*types)).func_is_extern(ty) {
            print("\n[type error] main must be a defined function with no arguments")
            #fall
        }
        result := types.func_return(ty)
        if types.kind(result) != TyKind.unit and result != types.alloc_int(32) {
            print("\n[type error] main must return i32 or no value")
            #fall
        }
    }

    build_main :: fn(self &Self, fid u32) u32 {
        self.build_entry(fid, true)
    }

    build_entry :: fn(self &Self, fid u32, executable bool) u32 {
        sym_id := id_none()
        if executable {
            sym_id = self.get_symbol_id(fid, Str.of("main"))
            self.parse(sym_id)
            global := self.nexus.global_var(sym_id)
            if global != hir_none() {
                self.nexus.type_error(global, "main must be a function declaration")
            }
            self.type_check(sym_id)
            self.validate_main(sym_id)
        }

        total := self.nexus.sym_count()
        exports := HashMap(u32, u32).new()
        for index in Range.new(0, total as i32) {
            i := index as u32
            start := self.nexus.sym_tok_start(i)
            if start == id_none() {
                cont
            }
            if self.nexus.sym_file(i) != fid and
                self.nexus.tokens.kind(start + 1) != Token.colon and
                self.nexus.tokens.kind(start + 2) != Token.kw_extern {
                cont
            }
            self.ensure_resolved(i)
            node := self.nexus.get_fn_node(i)
            if node == id_none() or not self.nexus.is_extern_fn(node) or
                self.nexus.hir.extra(node) == hir_none() {
                cont
            }
            name := self.nexus.extern_link_name(i, node)
            if executable and self.nexus.interner.get(name).eq("main") {
                self.nexus.type_error(
                    node
                    "the C symbol 'main' is reserved for the program entry point"
                )
            }
            if exports.get(name) != (0 as &u32) {
                self.nexus.type_error(node, "duplicate exported C symbol")
            }
            exports.insert(name, i)
        }
        exports.destroy()
        process_mono_funcs(self)

        sym_id
    }

    compile :: fn(self &Self, B type, L type, backend &B, builder &L, arena &Arena, sym_id u32) {
        visited := HashSet(u32).new()
        lower_function(
            &self.nexus
            backend
            builder
            backend.empty_value()
            arena
            sym_id
            &visited
            true
        )
        if not backend.is_vm() {
            for index in Range.new(0, self.nexus.sym_count() as i32) {
                i := index as u32
                if self.nexus.sym_tok_start(i) == id_none() {
                    cont
                }
                node := self.nexus.get_fn_node(i)
                if node != id_none() and self.nexus.is_extern_fn(node) and
                    self.nexus.hir.extra(node) != hir_none() {
                    lower_function(
                        &self.nexus
                        backend
                        builder
                        backend.empty_value()
                        arena
                        i
                        &visited
                        false
                    )
                }
            }
        }
        visited.destroy()
    }
}

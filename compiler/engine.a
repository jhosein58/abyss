import Nexus, Nexus_new, Nexus_find_symbol, Nexus_get_sym_hir,
       Nexus_is_sym_resolving, Nexus_set_sym_resolving, Nexus_add_file from "nexus/nexus.a"

import token, TokenStream from "token.a"
import lex from "lexer.a"
import index_file from "indexer.a"
import Parser_new, peek, curr_span, parse_error_at from "parser/core.a"
import parse_expr from "parser/parser.a"
import ScopeEnv_destroy from "parser/env.a"
import type_check, type_check_calls from "typer/tyck.a"
import PoolU32_get, PoolU32_set, id_none from "nexus/pool.a"
import UnifyStorage_get_slot, UnifyStorage_resolve_type,UnifyStorage_new_slot, slot_none from "unify.a"
import ty_id_none, ty_kind, TypeStorage_kind, TypeStorage_func_params_len, TypeStorage_func_is_extern from "types.a"
import Interner_intern, Interner_get from "../std/interner.a"
import Str from "../std/string.a"
import VecU32 from "../std/vec/u32.a"
import Arena from "../std/allocator.a"
import fall from "../std/sys.a"

import CCodeGen, CCodeGen_new, CCodeGen_destroy, CCodeGen_abyss_main, CCodeGen_finish from "codegen.a"
import lower_function from "lower.a"

print :: (s &u8) unit
print_u32 :: (v u32) unit 

Engine :: struct {
    nexus         : Nexus,
    file_count    : u32,
    ccg           : CCodeGen,
    pending_calls : VecU32,
    check_depth   : u32

    new :: () Self {
        .{
            nexus         : Nexus_new(),
            file_count    : 0,
            ccg           : CCodeGen_new(),
            pending_calls : VecU32.new(),
            check_depth   : 0
        }
    }

    destroy :: () {
        CCodeGen_destroy(&.ccg)
        .pending_calls.destroy()
    }

    self :: () &Self {
        .nexus
        ret
    }

    add_file :: (arena &Arena, path Str, source Str) u32 {
        file_id := Nexus_add_file(&.nexus, path, source)
        .file_count = file_id + 1

        tok_start := .nexus.tokens.count()
        lex(&.nexus.tokens, source, path)
        tok_end := .nexus.tokens.count()

        index_file(&.nexus, arena, file_id, path, tok_start as u32, tok_end as u32)
        file_id
    }

    get_symbol_id :: (file_id u32, sym_name Str) u32 {
        name_id := Interner_intern(&.nexus.interner, sym_name)
        Nexus_find_symbol(&.nexus, file_id, name_id)
    }

    parse :: (sym_id u32) {
        if sym_id == id_none() {
            print("\n[syntax error] symbol not found\n")
            fall()
        }

        file_id   := PoolU32_get(&.nexus.sym_files, sym_id)
        tok_start := PoolU32_get(&.nexus.sym_tok_start, sym_id)
        tok_end   := PoolU32_get(&.nexus.sym_tok_end, sym_id)
        count     := tok_end - tok_start

        hir_start := .nexus.hir.len()

        parser := Parser_new(
            &.nexus,
            &.nexus.tokens,
            &.nexus.hir,
            file_id,
            sym_id,
            tok_start,
            count
        )

        parse_expr(&parser, 0)
        if peek(&parser) != token().eof {
            parse_error_at(&parser, "unexpected token after declaration", curr_span(&parser))
        }
        ScopeEnv_destroy(&parser.env)

        hir_end := .nexus.hir.len()

        PoolU32_set(&.nexus.sym_hir_start, sym_id, hir_start)
        PoolU32_set(&.nexus.sym_hir_end, sym_id, hir_end)
    }

    type_check :: (sym_id u32) {
        hir_start := PoolU32_get(&.nexus.sym_hir_start, sym_id)
        hir_end   := PoolU32_get(&.nexus.sym_hir_end, sym_id)

        .check_depth = .check_depth + 1
        type_check(.self(), hir_start, hir_end)
        .check_depth = .check_depth - 1
        if .check_depth == 0 {
            type_check_calls(.self())
        }
    }

    ensure_resolved :: (sym_id u32) {
        if sym_id == id_none() { ret }
        db := &.nexus

        real_sym := sym_id
        while true {
            tgt := PoolU32_get(&db.sym_target, real_sym)
            if (tgt == id_none()) or (tgt == real_sym) {
                break
            }
            real_sym = tgt
        }

        tok_start := PoolU32_get(&db.sym_tok_start, real_sym)
        if tok_start == id_none() {
            ret
        }

        decl_hir := Nexus_get_sym_hir(db, real_sym)
        if decl_hir != id_none() {
            s := UnifyStorage_get_slot(&db.unify, decl_hir)
            if s != slot_none() {
                ty := UnifyStorage_resolve_type(&db.unify, s)
                if ty != ty_id_none() {
                    ret
                }
            }
        }

        if Nexus_is_sym_resolving(db, real_sym) {
            ret
        }

        hir_start := PoolU32_get(&db.sym_hir_start, real_sym)
        if hir_start == id_none() {
            Nexus_set_sym_resolving(db, real_sym, true)
            .parse(real_sym)
            Nexus_set_sym_resolving(db, real_sym, false)
        }

        decl_hir = Nexus_get_sym_hir(db, real_sym)
        if decl_hir != id_none() {
            s := UnifyStorage_get_slot(&db.unify, decl_hir)
            if s == slot_none() {
                UnifyStorage_new_slot(&db.unify, decl_hir)
            }
        }

        Nexus_set_sym_resolving(db, real_sym, true)
        .type_check(real_sym)
        Nexus_set_sym_resolving(db, real_sym, false)
    }

    slot_of :: (sym_id u32) u32 {
        if sym_id == id_none() { ret slot_none() }
        db := &.nexus

        real_sym := sym_id
        while true {
            tgt := PoolU32_get(&db.sym_target, real_sym)
            if (tgt == id_none()) or (tgt == real_sym) {
                break
            }
            real_sym = tgt
        }

        tok_start := PoolU32_get(&db.sym_tok_start, real_sym)
        if tok_start == id_none() {
            decl_hir := Nexus_get_sym_hir(db, real_sym)
            if decl_hir == id_none() { ret slot_none() }
            ret UnifyStorage_get_slot(&db.unify, decl_hir)
        }

        .ensure_resolved(real_sym)
        decl_hir := Nexus_get_sym_hir(db, real_sym)
        if decl_hir == id_none() { ret slot_none() }
        UnifyStorage_get_slot(&db.unify, decl_hir)
    }

    type_of :: (sym_id u32) u32 {
        slot := .slot_of(sym_id)
        if slot == slot_none() { ret ty_id_none() }
        UnifyStorage_resolve_type(&.nexus.unify, slot)
    }

    abyss_main :: (sym_id u32) {
        ty := .type_of(sym_id)
        types := &.nexus.types
        if TypeStorage_kind(types, ty) != ty_kind().func {
            print("\n[type error] main must be a function\n")
            fall()
        }
        if (TypeStorage_func_params_len(types, ty) != 0) or TypeStorage_func_is_extern(types, ty) {
            print("\n[type error] main must be a defined function with no arguments\n")
            fall()
        }
        CCodeGen_abyss_main(&.ccg, sym_id)
    }

    compile :: (arena &Arena, sym_id u32) {
        visited := VecU32.new()
        lower_function(&.nexus, &.ccg, arena, sym_id, &visited)
        visited.destroy()
    }

}

import core.target:        Arch, Os
import core.target_values: target_arch as core_target_arch, target_os as core_target_os

host_os :: fn() Os { core_target_os }
host_arch :: fn() Arch { core_target_arch }

os_name :: fn(os Os) Str {
    match os {
        linux { "linux" }
        darwin { "darwin" }
        windows { "windows" }
        wasi { "wasi" }
        freestanding { "freestanding" }
    }
}

arch_name :: fn(arch Arch) Str {
    match arch {
        x86_64 { "x86_64" }
        aarch64 { "aarch64" }
        wasm32 { "wasm32" }
    }
}

parse_os :: fn(name Str) Maybe(Os) {
    for code in Range.new(0, 5) {
        os := code as Os
        if os_name(os).eq(name) { ret Maybe(Os).some(os) }
    }
    Maybe(Os).none()
}

parse_arch :: fn(name Str) Maybe(Arch) {
    for code in Range.new(0, 3) {
        arch := code as Arch
        if arch_name(arch).eq(name) { ret Maybe(Arch).some(arch) }
    }
    Maybe(Arch).none()
}

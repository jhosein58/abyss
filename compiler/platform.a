target :: @import("core/target")
target_values :: @import("core/target_values")

host_os :: fn() target.Os { target_values.target_os }
host_arch :: fn() target.Arch { target_values.target_arch }

os_name :: fn(os target.Os) Str {
    match os {
        linux { "linux" }
        darwin { "darwin" }
        windows { "windows" }
        wasi { "wasi" }
        freestanding { "freestanding" }
    }
}

arch_name :: fn(arch target.Arch) Str {
    match arch {
        x86_64 { "x86_64" }
        aarch64 { "aarch64" }
        wasm32 { "wasm32" }
    }
}

parse_os :: fn(name Str) Maybe(target.Os) {
    for code in Range.new(0, 5) {
        os := code as target.Os
        if os_name(os).eq(name) { ret Maybe(target.Os).some(os) }
    }
    Maybe(target.Os).none()
}

parse_arch :: fn(name Str) Maybe(target.Arch) {
    for code in Range.new(0, 3) {
        arch := code as target.Arch
        if arch_name(arch).eq(name) { ret Maybe(target.Arch).some(arch) }
    }
    Maybe(target.Arch).none()
}

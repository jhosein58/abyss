import Str from "../std/string.a"

embedded_source :: fn(path Str) Str {
    if path.eq(Str.of("core/choice.a")) { ret Str.of("Choice :: fn(T type, E type) type {\n    struct {\n        is_ok bool\n        val T | E\n\n        ok :: fn(v T) Self {\n            .{\n                is_ok: true,\n                val: v\n            }\n        }\n\n        err :: fn(e E) Self {\n            .{\n                is_ok: false,\n                val: e\n            }\n        }\n\n        is_success :: fn() bool { .is_ok }\n        is_error :: fn() bool { not .is_ok }\n\n        unwrap_or :: fn(fallback T) T {\n            if .is_ok { .val as T } else { fallback }\n        }\n    }\n}\n") }
    if path.eq(Str.of("core/maybe.a")) { ret Str.of("Maybe :: fn(T type) type {\n    struct {\n        present bool\n        value T\n\n        some :: fn(value T) Self { .{ present: true, value: value } }\n        none :: fn() Self {\n            result: Self\n            result.present = false\n            result\n        }\n        is_some :: fn() bool { .present }\n        is_none :: fn() bool { not .present }\n        unwrap :: fn() T { .value }\n        unwrap_or :: fn(fallback T) T {\n            if .present { .value } else { fallback }\n        }\n    }\n}\n") }
    if path.eq(Str.of("core/prelude.a")) { ret Str.of("import Str from \"string.a\"\nimport Maybe from \"maybe.a\"\nimport Choice from \"choice.a\"\nimport Slice from \"slice.a\"\n") }
    if path.eq(Str.of("core/slice.a")) { ret Str.of("Slice :: fn(T type) type {\n    struct {\n        ptr &T\n        len u64\n\n        new :: fn(ptr &T, len u64) Self {\n            .{\n                ptr: ptr,\n                len: len\n            }\n        }\n\n        empty :: fn() Self {\n            .{\n                ptr: 0 as &T,\n                len: 0\n            }\n        }\n\n        get :: fn(idx u64) T {\n            *(.ptr + idx)\n        }\n\n        sub :: fn(start u64, len u64) Self {\n            .{\n                ptr: (.ptr + start),\n                len: len\n            }\n        }\n    }\n}\n") }
    if path.eq(Str.of("core/string.a")) { ret Str.of("str_len :: fn(s &u8) u64\nprint_char :: fn(c u8) unit\n\nStr :: struct {\n    ptr &u8\n    len u64 \n\n\n    size :: fn() u64 {\n        16\n    }\n\n    new :: fn(ptr &u8, len u64) Str {\n        .{\n            ptr: ptr,\n            len: len,\n        }\n    }\n\n    empty :: fn() Str {\n        .{\n            ptr: 0 as &u8,\n            len: 0,\n        }\n    }\n\n    of :: fn(s &u8 | Str) Self {\n        if @is(s, Str) {\n            ret s as Str\n        }\n        raw := s as &u8\n        .{\n            ptr: raw,\n            len: str_len(raw)\n        }\n    }\n\n    print :: fn() {\n        i := 0\n\n        while i < .len {\n            print_char(*(.ptr + i))\n            i = i + 1\n        }\n    }\n\n    println :: fn(s Str) {\n        s.print()\n        print_char('\\n')\n    }\n\n    sub :: fn(start u64, len u64) Str {\n        .{\n            ptr: (.ptr + start),\n            len: len\n        }\n    }\n\n    eq :: fn(b Str) bool {\n        if .len != b.len {\n            ret false\n        }\n\n        i: u64 = 0\n        while i < .len {\n            if *(.ptr + i) != *(b.ptr + i) {\n                ret false\n            }\n            i = i + 1\n        }\n\n        true\n    }\n\n    starts_with :: fn(prefix Str) bool {\n        if .len < prefix.len { ret false }\n        .sub(0, prefix.len).eq(prefix)\n    }\n\n    ends_with :: fn(suffix Str) bool {\n        if .len < suffix.len { ret false }\n        .sub(.len - suffix.len, suffix.len).eq(suffix)\n    }\n\n    trim_quotes :: fn() Str {\n        if .len >= 2 {\n            if (*(.ptr) == '\"') and (*(.ptr + .len - 1) == '\"') {\n                ret .sub(1, .len - 2)\n            }\n        }\n        .{\n            ptr: .ptr,\n            len: .len\n        }\n    }\n}\n") }
    if path.eq(Str.of("std/allocator.a")) { ret Str.of("import malloc, free, mem_copy from \"mem.a\"\n\n\nalign_up :: fn(n u64) u64 {\n    (n + 7) & ~7\n}\n\n\nArenaChunk :: struct {\n    next_chunk &u8\n    memory &u8\n    offset u64\n    cap u64\n\n    size :: fn() u64 { 32 }\n\n    new :: fn(cap u64, next_chunk &u8) &Self {\n        chunk := malloc(ArenaChunk.size()) as &Self\n        mem   := malloc(cap)\n\n        (*chunk).next_chunk = next_chunk\n        (*chunk).memory = mem\n        (*chunk).offset = 0\n        (*chunk).cap = cap\n\n        chunk\n    }\n\n}\n\nArena :: struct {\n    current &ArenaChunk\n    default_chunk_size u64\n\n\n\n    new :: fn(default_chunk_size u64) Arena {\n        first_chunk := ArenaChunk.new(default_chunk_size, 0 as &u8)\n\n        .{\n            current: first_chunk,\n            default_chunk_size: default_chunk_size\n        }\n    }\n\n    alloc :: fn(s u64) &u8 {\n        aligned_size := align_up(s)\n        curr := .current\n\n        if curr.offset + aligned_size > curr.cap {\n            new_cap := .default_chunk_size\n\n            if aligned_size > new_cap {\n                new_cap = aligned_size\n            }\n\n            new_chunk := ArenaChunk.new(new_cap, curr as &u8)\n            .current = new_chunk\n            curr = new_chunk\n        }\n\n        ptr := curr.memory + curr.offset\n        curr.offset = curr.offset + aligned_size\n\n        ptr\n    }\n\n    reset :: fn() {\n        curr := .current\n        while (curr as &u8) != (0 as &u8) {\n            curr.offset = 0\n            curr = curr.next_chunk as &ArenaChunk\n        }\n    }\n\n\n    realloc :: fn(old_ptr &u8, old_size u64, new_size u64) &u8 {\n        if new_size <= old_size {\n            ret old_ptr\n        }\n\n        aligned_old := align_up(old_size)\n        aligned_new := align_up(new_size)\n        curr := .current\n\n        if (curr != (0 as &ArenaChunk)) and ((*curr).offset >= aligned_old) {\n            last_alloc_ptr := (*curr).memory + ((*curr).offset - aligned_old)\n            if old_ptr == last_alloc_ptr {\n                diff := aligned_new - aligned_old\n                if (*curr).offset + diff <= (*curr).cap {\n                    (*curr).offset = (*curr).offset + diff\n                    ret old_ptr\n                }\n            }\n        }\n\n        new_ptr := .alloc(new_size)\n        if (old_ptr != (0 as &u8)) and (old_size > 0) {\n            mem_copy(new_ptr, old_ptr, old_size)\n        }\n        new_ptr\n    }\n\n    destroy :: fn() {\n        curr := .current\n\n        while (curr as &u8) != 0 as &u8 {\n            next_chunk := (*curr).next_chunk as &ArenaChunk\n            free((*curr).memory)\n            free(curr as &u8)\n            curr = next_chunk\n        }\n\n        .current = 0 as &ArenaChunk\n    }\n}\n\n\n\n\n\n") }
    if path.eq(Str.of("std/ascii.a")) { ret Str.of("is_digit :: fn(c u8) bool {\n    (c >= '0') and (c <= '9')\n}\n\nis_hex_digit :: fn(c u8) bool {\n    (c >= '0' and c <= '9') or (c >= 'A' and c <= 'F') or (c >= 'a' and c <= 'f')\n}\n\nis_alpha :: fn(c u8) bool {\n    (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or (c == '_')\n}\n\nis_alphanumeric :: fn(c u8) bool {\n    is_alpha(c) or is_digit(c)\n}\n\nis_whitespace :: fn(c u8) bool {\n    (c == ' ') or (c == '\\t')\n}\n\nis_newline :: fn(c u8) bool {\n    (c == '\\n') or (c == '\\r')\n}\n\nto_lower :: fn(c u8) u8 {\n    if (c >= 'A') and (c <= 'Z') { ret (c + 32) as u8 }\n    c\n}\n\nto_upper :: fn(c u8) u8 {\n    if (c >= 'a') and (c <= 'z') { ret (c - 32) as u8 }\n    c\n}\n") }
    if path.eq(Str.of("std/avec/u8.a")) { ret Str.of("import Arena         from \"../allocator.a\"\nimport U8_size       from \"../primitive/u8.a\"\n\nArenaVecType :: u8\n\n\nAVecU8 :: struct {\n    arena &Arena\n    ptr &ArenaVecType\n    len u64\n    cap u64\n\n    new :: fn(arena &Arena) Self {\n        Self.with_cap(arena, 4)\n    }\n\n    with_cap :: fn(arena &Arena, initial_cap u64) Self {\n        bytes := initial_cap * U8_size()\n        p := arena.alloc(bytes) as &ArenaVecType\n\n        .{\n            arena: arena,\n            ptr: p,\n            len: 0,\n            cap: initial_cap\n        }\n    }\n\n    grow :: fn() {\n        if .len == .cap {\n            new_cap := .cap * 2\n            old_bytes := .cap * U8_size()\n            new_bytes := new_cap * U8_size()\n\n            new_ptr := .arena.realloc(.ptr as &u8, old_bytes, new_bytes) as &ArenaVecType\n\n            .ptr = new_ptr\n            .cap = new_cap\n        }\n    }\n\n    push :: fn(val ArenaVecType) {\n        .grow()\n\n        *(.ptr + .len) = val\n        .len = .len + 1\n    }\n\n    get :: fn(idx u64) ArenaVecType {\n        *(.ptr + idx)\n    }\n\n    set :: fn(idx u64, val ArenaVecType) {\n        *(.ptr + idx) = val\n    }\n\n    pop :: fn() ArenaVecType {\n        .len = .len - 1\n        *(.ptr + .len)\n    }\n\n    clear :: fn() {\n        .len = 0\n    }\n}") }
    if path.eq(Str.of("std/collections/vec.a")) { ret Str.of("import malloc, realloc, free, mem_copy from \"../mem.a\"\n\n\nVec :: fn(T type) type {\n    struct {\n        ptr &T\n        len u64\n        cap u64\n\n        new :: fn() Self {\n            Self.with_cap(4)\n        }\n\n        with_cap :: fn(initial_cap u64) Self {\n            cap := initial_cap\n            if cap < 4 {\n                cap = 4\n            }\n\n            p := malloc(cap * @sizeof(T)) as &T\n\n            .{\n                ptr: p,\n                len: 0,\n                cap: cap\n            }\n        }\n\n        destroy :: fn() {\n            free(.ptr as &u8)\n            .ptr = 0 as &T\n            .len = 0\n            .cap = 0\n        }\n\n        reserve :: fn(additional u64) {\n            needed := .len + additional\n            if needed > .cap {\n                new_cap := .cap * 2\n                if new_cap < 4 { new_cap = 4 }\n                while new_cap < needed {\n                    new_cap = new_cap * 2\n                }\n\n                new_ptr := realloc(.ptr as &u8, new_cap * @sizeof(T)) as &T\n                .ptr = new_ptr\n                .cap = new_cap\n            }\n        }\n\n        grow :: fn() {\n            if .len == .cap {\n                .reserve(1)\n            }\n        }\n\n\n        push :: fn(val T) {\n            .grow()\n\n            *(.ptr + .len) = val\n            .len = .len + 1\n        }\n\n\n        get :: fn(idx u64) T {\n            *(.ptr + idx)\n        }\n\n        pop :: fn() T {\n            .len = .len - 1\n            .get(.len)\n        }\n\n        set :: fn(idx u64, val T) {\n            *(.ptr + idx) = val\n        }\n\n\n        last :: fn() T {\n            *(.ptr + (.len - 1))\n        }\n\n        is_empty :: fn() bool {\n            .len == 0\n        }\n\n        extend :: fn(src &T, count u64) {\n            if count == 0 { ret }\n\n            .reserve(count)\n            dst := (.ptr + .len) as &u8\n\n            mem_copy(dst, src as &u8, count * @sizeof(T))\n            .len = .len + count\n        }\n\n        mark :: fn() u64 {\n            .len\n        }\n\n        reset :: fn(mark u64) {\n            if mark <= .len {\n                .len = mark\n            }\n        }\n\n        clear :: fn() {\n            .len = 0\n        }\n\n        ptr_at :: fn(offset u64) &T {\n            .ptr + offset\n        }\n\n        swap_remove :: fn(idx u64) T {\n            last_idx := .len - 1\n            removed := *(.ptr + idx)\n        \n            if idx != last_idx {\n                *(.ptr + idx) = *(.ptr + last_idx)\n            }\n        \n            .len = last_idx\n            removed\n        }\n    }\n}") }
    if path.eq(Str.of("std/fast_map/u32.a")) { ret Str.of("import U32_size, U32_MAX from \"../primitive/u32.a\"\nimport malloc, free, mem_set from \"../mem.a\"\nimport hash_u32 from \"../hash/u32.a\"\n\n-- Generic\n--------------------------------------------------------------------------------\n\nKeyTy :: u32\nValTy :: u32\nSelf  :: FastMapU32\n\nkey_size  :: fn() u64   { U32_size() }\nval_size  :: fn() u64   { U32_size() }\nkey_none  :: fn() KeyTy { U32_MAX() }\nval_none  :: fn() ValTy { U32_MAX() }\nkey_hash  :: fn(k KeyTy) u32 { hash_u32(k) }\n\n--------------------------------------------------------------------------------\n\nFastMapU32 :: struct {\n    keys &KeyTy\n    vals &ValTy\n    cap  u64\n    len  u64\n}\n\nFastMapU32_new :: fn() Self {\n    FastMapU32_with_cap(16)\n}\n\nFastMapU32_with_cap :: fn(initial_cap u64) Self {\n    cap := initial_cap\n    if cap < 16 {\n        cap = 16\n    }\n\n    k_bytes := cap * key_size()\n    v_bytes := cap * val_size()\n\n    keys_ptr := malloc(k_bytes) as &KeyTy\n    vals_ptr := malloc(v_bytes) as &ValTy\n\n    mem_set(keys_ptr as &u8, 255 as u8, k_bytes)\n\n    .{\n        keys : keys_ptr,\n        vals : vals_ptr,\n        cap  : cap,\n        len  : 0\n    }\n}\n\nFastMapU32_destroy :: fn(m &Self) {\n    free((*m).keys as &u8)\n    free((*m).vals as &u8)\n    (*m).keys = 0 as &KeyTy\n    (*m).vals = 0 as &ValTy\n    (*m).len = 0\n    (*m).cap = 0\n}\n\nFastMapU32_clear :: fn(m &Self) {\n    k_bytes := (*m).cap * key_size()\n    mem_set((*m).keys as &u8, 255 as u8, k_bytes)\n    (*m).len = 0\n}\n\nFastMapU32_count :: fn(m &Self) u64 {\n    (*m).len\n}\n\nFastMapU32_grow :: fn(m &Self) {\n    old_cap := (*m).cap\n    old_keys := (*m).keys\n    old_vals := (*m).vals\n\n    new_cap := old_cap * 2\n    new_k_bytes := new_cap * key_size()\n    new_v_bytes := new_cap * val_size()\n\n    new_keys := malloc(new_k_bytes) as &KeyTy\n    new_vals := malloc(new_v_bytes) as &ValTy\n\n    mem_set(new_keys as &u8, 255 as u8, new_k_bytes)\n\n    mask := new_cap - 1\n    empty := key_none()\n\n    i: u64 = 0\n    while i < old_cap {\n        k := *(old_keys + i)\n        if k != empty {\n            v := *(old_vals + i)\n            idx := (key_hash(k) as u64) & mask\n\n            while *(new_keys + idx) != empty {\n                idx = (idx + 1) & mask\n            }\n\n            *(new_keys + idx) = k\n            *(new_vals + idx) = v\n        }\n        i = i + 1\n    }\n\n    free(old_keys as &u8)\n    free(old_vals as &u8)\n\n    (*m).keys = new_keys\n    (*m).vals = new_vals\n    (*m).cap = new_cap\n}\n\nFastMapU32_insert :: fn(m &Self, key KeyTy, val ValTy) bool {\n    if ((*m).len + 1) * 10 >= (*m).cap * 7 {\n        FastMapU32_grow(m)\n    }\n\n    mask := (*m).cap - 1\n    idx := (key_hash(key) as u64) & mask\n    empty := key_none()\n\n    while true {\n        k := *((*m).keys + idx)\n\n        if k == empty {\n            *((*m).keys + idx) = key\n            *((*m).vals + idx) = val\n            (*m).len = (*m).len + 1\n            ret true\n        }\n\n        if k == key {\n            *((*m).vals + idx) = val\n            ret false\n        }\n\n        idx = (idx + 1) & mask\n    }\n\n    false\n}\n\nFastMapU32_get :: fn(m &Self, key KeyTy) ValTy {\n    mask := (*m).cap - 1\n    idx := (key_hash(key) as u64) & mask\n    empty := key_none()\n\n    while true {\n        k := *((*m).keys + idx)\n\n        if k == empty {\n            ret val_none()\n        }\n\n        if k == key {\n            ret *((*m).vals + idx)\n        }\n\n        idx = (idx + 1) & mask\n    }\n\n    val_none()\n}\n\nFastMapU32_contains :: fn(m &Self, key KeyTy) bool {\n    FastMapU32_get(m, key) != val_none()\n}") }
    if path.eq(Str.of("std/fmt.a")) { ret Str.of("import Arena  from \"allocator.a\"\nimport Str, String from \"string.a\"\n\nEscape :: struct {\n    reset     &u8\n    bold      &u8\n    dim       &u8\n    italic    &u8\n    underline &u8\n    blink     &u8\n    reverse   &u8\n    hidden    &u8\n    strike    &u8\n\n    fg_black   &u8\n    fg_red     &u8\n    fg_green   &u8\n    fg_yellow  &u8\n    fg_blue    &u8\n    fg_magenta &u8\n    fg_cyan    &u8\n    fg_white   &u8\n\n    fg_bright_black   &u8\n    fg_bright_red     &u8\n    fg_bright_green   &u8\n    fg_bright_yellow  &u8\n    fg_bright_blue    &u8\n    fg_bright_magenta &u8\n    fg_bright_cyan    &u8\n    fg_bright_white   &u8\n\n    bg_black   &u8\n    bg_red     &u8\n    bg_green   &u8\n    bg_yellow  &u8\n    bg_blue    &u8\n    bg_magenta &u8\n    bg_cyan    &u8\n    bg_white   &u8\n\n    bg_bright_black   &u8\n    bg_bright_red     &u8\n    bg_bright_green   &u8\n    bg_bright_yellow  &u8\n    bg_bright_blue    &u8\n    bg_bright_magenta &u8\n    bg_bright_cyan    &u8\n    bg_bright_white   &u8\n}\n\nescape :: fn() Escape {\n    .{\n        reset     : c\"\\x1b[0m\",\n        bold      : c\"\\x1b[1m\",\n        dim       : c\"\\x1b[2m\",\n        italic    : c\"\\x1b[3m\",\n        underline : c\"\\x1b[4m\",\n        blink     : c\"\\x1b[5m\",\n        reverse   : c\"\\x1b[7m\",\n        hidden    : c\"\\x1b[8m\",\n        strike    : c\"\\x1b[9m\",\n\n        fg_black   : c\"\\x1b[30m\",\n        fg_red     : c\"\\x1b[31m\",\n        fg_green   : c\"\\x1b[32m\",\n        fg_yellow  : c\"\\x1b[33m\",\n        fg_blue    : c\"\\x1b[34m\",\n        fg_magenta : c\"\\x1b[35m\",\n        fg_cyan    : c\"\\x1b[36m\",\n        fg_white   : c\"\\x1b[37m\",\n\n        fg_bright_black   : c\"\\x1b[90m\",\n        fg_bright_red     : c\"\\x1b[91m\",\n        fg_bright_green   : c\"\\x1b[92m\",\n        fg_bright_yellow  : c\"\\x1b[93m\",\n        fg_bright_blue    : c\"\\x1b[94m\",\n        fg_bright_magenta : c\"\\x1b[95m\",\n        fg_bright_cyan    : c\"\\x1b[96m\",\n        fg_bright_white   : c\"\\x1b[97m\",\n\n        bg_black   : c\"\\x1b[40m\",\n        bg_red     : c\"\\x1b[41m\",\n        bg_green   : c\"\\x1b[42m\",\n        bg_yellow  : c\"\\x1b[43m\",\n        bg_blue    : c\"\\x1b[44m\",\n        bg_magenta : c\"\\x1b[45m\",\n        bg_cyan    : c\"\\x1b[46m\",\n        bg_white   : c\"\\x1b[47m\",\n\n        bg_bright_black   : c\"\\x1b[100m\",\n        bg_bright_red     : c\"\\x1b[101m\",\n        bg_bright_green   : c\"\\x1b[102m\",\n        bg_bright_yellow  : c\"\\x1b[103m\",\n        bg_bright_blue    : c\"\\x1b[104m\",\n        bg_bright_magenta : c\"\\x1b[105m\",\n        bg_bright_cyan    : c\"\\x1b[106m\",\n        bg_bright_white   : c\"\\x1b[107m\"\n    }\n}\n\nFmt :: struct {\n    buf String\n\n    new :: fn(arena &Arena) Self {\n        .{ buf: String.new(arena) }\n    }\n\n    str :: fn(s Str) &Self {\n        .buf.push_str(s)\n    }\n\n    cstr :: fn(s &u8) &Self {\n        .str(Str.of(s))\n    }\n\n    char :: fn(c u8) &Self {\n        .buf.push_char(c)\n    }\n\n    uint32 :: fn(v u32) &Self {\n        .buf.push_u32(v)\n    }\n\n    uint64 :: fn(v u64) &Self {\n        if v == 0 {\n            .buf.push_char(48 as u8)\n            ret\n        }\n        divisor: u64 = 1\n        temp := v\n        while temp >= 10 {\n            divisor = divisor * 10\n            temp = temp / 10\n        }\n        rem := v\n        while divisor > 0 {\n            d := (rem / divisor) as u8\n            .buf.push_char(48 as u8 + d)\n            rem = rem - ((d as u64) * divisor)\n            divisor = divisor / 10\n        }\n    }\n\n    int32 :: fn(v i32) &Self {\n        if v < 0 {\n            .buf.push_char(45 as u8)\n            .uint32((0 - v) as u32)\n        } else {\n            .uint32(v as u32)\n        }\n    }\n\n    boolean :: fn(v bool) &Self {\n        if v {\n            ret .str(Str.of(\"true\"))\n        }\n        .str(Str.of(\"false\"))\n    }\n\n    space :: fn() &Self {\n        .buf.push_char(32 as u8)\n    }\n\n    newline :: fn() &Self {\n        .buf.push_char(10 as u8)\n    }\n\n    semi :: fn() &Self {\n        .str(Str.of(\";\\n\"))\n    }\n\n    comma :: fn() &Self {\n        .str(Str.of(\", \"))\n    }\n\n    paren :: fn(inner Str) &Self {\n        .buf.push_char(40 as u8)\n        .str(inner)\n        .buf.push_char(41 as u8)\n    }\n\n    wrap :: fn(left Str, inner Str, right Str) &Self {\n        .str(left)\n        .str(inner)\n        .str(right)\n    }\n\n    sym :: fn(prefix Str, id u32) &Self {\n        .str(prefix)\n        .uint32(id)\n    }\n\n    binary :: fn(op Str, lhs Str, rhs Str) &Self {\n        .buf.push_char(40 as u8)\n        .str(lhs)\n        .str(op)\n        .str(rhs)\n        .buf.push_char(41 as u8)\n    }\n\n    indent :: fn(level u32) &Self {\n        i: u32 = 0\n        while i < level {\n            .str(Str.of(\"    \"))\n            i = i + 1\n        }\n    }\n\n    as_str :: fn() Str {\n        .buf.as_str()\n    }\n\n    print :: fn() {\n        .as_str().print()\n    }\n}") }
    if path.eq(Str.of("std/fs.a")) { ret Str.of("import Arena from \"allocator.a\"\nimport Str from \"string.a\"\nimport fall               from \"sys.a\"\n\n\nprint :: fn(s &u8) unit\n\nfile_open  :: fn(path, mode &u8) &u8\nfile_seek  :: fn(handle &u8, offset i64, w i32) i32\nfile_tell  :: fn(handle &u8) i64\nfile_read  :: fn(handle, ptr &u8, s, count u64) u64\nfile_write :: fn(handle, ptr &u8, s, count u64) u64\nfile_close :: fn(handle &u8) i32\n\nSEEK_SET :: fn() i32 { 0 }\nSEEK_END :: fn() i32 { 2 }\n\nread_file :: fn(a &Arena, path &u8) Str {\n    file_handle := file_open(path, c\"rb\")\n\n    if file_handle == (0 as &u8) {\n        print(c\"\\n\\033[1;31merror:\\033[0m cannot open file '\")\n        print(path)\n        print(c\"': file not found or permission denied\\n\")\n        fall()\n    }\n\n    file_seek(file_handle, 0, SEEK_END())\n    raw_size := file_tell(file_handle)\n\n    if raw_size < 0 {\n        print(c\"\\n\\033[1;31merror:\\033[0m failed to determine size of file '\")\n        print(path)\n        print(c\"'\\n\")\n        file_close(file_handle)\n        fall()\n    }\n\n    file_size := raw_size as u64\n    file_seek(file_handle, 0, SEEK_SET())\n\n    buf := a.alloc(file_size + 1)\n    if buf == (0 as &u8) {\n        print(c\"\\n\\033[1;31merror:\\033[0m out of memory allocating buffer for '\")\n        print(path)\n        print(c\"'\\n\")\n        file_close(file_handle)\n        fall()\n    }\n\n    read_bytes := file_read(file_handle, buf, 1, file_size)\n    file_close(file_handle)\n\n    *(buf + read_bytes) = 0 as u8\n\n    .{\n        ptr: buf,\n        len: read_bytes\n    }\n}\n\nwrite_file :: fn(path &u8, content Str) bool {\n    file_handle := file_open(path, c\"wb\")\n\n    if file_handle == (0 as &u8) {\n        print(c\"\\n\\033[1;31merror:\\033[0m failed to open file for writing: '\")\n        print(path)\n        print(c\"'\\n\")\n        fall()\n    }\n\n    written := file_write(file_handle, content.ptr, 1, content.len)\n    file_close(file_handle)\n\n    if written != content.len {\n        print(c\"\\n\\033[1;31merror:\\033[0m incomplete write to file '\")\n        print(path)\n        print(c\"'\\n\")\n        fall()\n    }\n\n    true\n}\n\nappend_file :: fn(path &u8, content Str) bool {\n    file_handle := file_open(path, c\"ab\")\n\n    if file_handle == (0 as &u8) {\n        print(c\"\\n\\033[1;31merror:\\033[0m failed to open file for appending: '\")\n        print(path)\n        print(c\"'\\n\")\n        fall()\n    }\n\n    written := file_write(file_handle, content.ptr, 1, content.len)\n    file_close(file_handle)\n\n    if written != content.len {\n        print(c\"\\n\\033[1;31merror:\\033[0m incomplete append to file '\")\n        print(path)\n        print(c\"'\\n\")\n        fall()\n    }\n\n    true\n}") }
    if path.eq(Str.of("std/hash/str.a")) { ret Str.of("import Str from \"../string.a\"\n\n-- FNV-1a \nhash_str :: fn(s Str) u32 {\n    h: u32 = 2166136261 as u32\n    i: u64 = 0\n    while i < s.len {\n        c := *(s.ptr + i) as u32\n        h = (h ^ c) * 16777619 as u32\n        i = i + 1\n    }\n    h\n}") }
    if path.eq(Str.of("std/hash/u32.a")) { ret Str.of("\n\nhash_u32 :: fn(x u32) u32 {\n    -- Knuth Multiplicative Hash (2654435761) + XOR Shift\n    h := x * 2654435761 as u32\n    h ^ (h >> 16)\n}\n\n\n") }
    if path.eq(Str.of("std/interner.a")) { ret Str.of("import Str from \"string.a\"\nimport hash_str from \"hash/str.a\"\nimport VecStr from \"vec/str.a\"\nimport U32_size, U32_MAX from \"primitive/u32.a\"\nimport malloc, free, mem_set from \"mem.a\"\n\nintern_none :: fn() u32 {\n    U32_MAX()\n}\n\n\nInterner :: struct {\n    strings VecStr\n    table   &u32\n    cap     u64\n    count   u64\n\n    new :: fn() Self {\n        Self.with_cap(64)\n    }\n\n    with_cap :: fn(initial_cap u64) Self {\n        cap := initial_cap\n        if cap < 64 {\n            cap = 64\n        }\n\n        bytes := cap * U32_size()\n        ptr := malloc(bytes) as &u32\n\n        mem_set(ptr as &u8, 255 as u8, bytes)\n\n        .{\n            strings : VecStr.new(),\n            table   : ptr,\n            cap     : cap,\n            count   : 0\n        }\n    }\n\n    destroy :: fn() {\n        .strings.destroy()\n        free(.table as &u8)\n\n        .table = 0 as &u32\n        .cap = 0\n        .count = 0\n    }\n\n    grow :: fn() {\n        old_cap := .cap\n        old_table := .table\n\n        new_cap := old_cap * 2\n        new_bytes := new_cap * U32_size()\n        new_table := malloc(new_bytes) as &u32\n\n        mem_set(new_table as &u8, 255 as u8, new_bytes)\n\n        mask := new_cap - 1\n        empty := intern_none()\n\n        i: u64 = 0\n        while i < old_cap {\n            id := *(old_table + i)\n            if id != empty {\n                s := .strings.get(id as u64)\n                idx := (hash_str(s) as u64) & mask\n\n                while *(new_table + idx) != empty {\n                    idx = (idx + 1) & mask\n                }\n\n                *(new_table + idx) = id\n            }\n            i = i + 1\n        }\n\n        free(old_table as &u8)\n        .table = new_table\n        .cap = new_cap\n    }\n\n    intern :: fn(s Str) u32 {\n        if (.count + 1) * 10 >= .cap * 7 {\n            .grow()\n        }\n\n        mask := .cap - 1\n        h := hash_str(s) as u64\n        idx := h & mask\n        empty := intern_none()\n\n        while true {\n            id := *(.table + idx)\n\n            if id == empty {\n                new_id := .strings.len as u32\n                .strings.push(s)\n\n                *(.table + idx) = new_id\n                .count = .count + 1\n                ret new_id\n            }\n\n            existing_str := .strings.get(id as u64)\n            if s.eq(existing_str) {\n                ret id\n            }\n\n            idx = (idx + 1) & mask\n        }\n\n        empty\n    }\n\n    get :: fn(id u32) Str {\n        .strings.get(id as u64)\n    }\n\n    len :: fn() u64 {\n        .strings.len\n    }\n}\n\n\n") }
    if path.eq(Str.of("std/io.a")) { ret Str.of("import print as print_cstr from \"prelude.a\"\n\nPrintable :: fn() type {\n    i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | f32 | f64 | bool | &u8 | Str\n}\n\nprint :: fn(T type, v T) {\n    value: Printable() = v\n    if @is(value, i8) {\n        print_i8(value as i8)\n        ret\n    }\n    if @is(value, i16) {\n        print_i16(value as i16)\n        ret\n    }\n    if @is(value, i32) {\n        print_i32(value as i32)\n        ret\n    }\n    if @is(value, i64) {\n        print_i64(value as i64)\n        ret\n    }\n    if @is(value, u8) {\n        print_u8(value as u8)\n        ret\n    }\n    if @is(value, u16) {\n        print_u16(value as u16)\n        ret\n    }\n    if @is(value, u32) {\n        print_u32(value as u32)\n        ret\n    }\n    if @is(value, u64) {\n        print_u64(value as u64)\n        ret\n    }\n    if @is(value, f32) {\n        print_f32(value as f32)\n        ret\n    }\n    if @is(value, f64) {\n        print_f64(value as f64)\n        ret\n    }\n    if @is(value, bool) {\n        print_bool(value as bool)\n        ret\n    }\n    if @is(value, &u8) {\n        print_cstr(value as &u8)\n        ret\n    }\n    (value as Str).print()\n}\n") }
    if path.eq(Str.of("std/mem.a")) { ret Str.of("malloc   :: fn(size u64                ) &u8\nfree     :: fn(ptr  &u8                ) unit\nrealloc  :: fn(ptr  &u8, size u64      ) &u8\nmem_copy :: fn(dest &u8, src &u8, n u64) unit\nmem_set  :: fn(dest &u8, val u8,  n u64) unit\n\n") }
    if path.eq(Str.of("std/path.a")) { ret Str.of("import Str, String from \"string.a\"\nimport Arena from \"allocator.a\"\nimport Vec from \"collections/vec.a\"\n\nPath :: struct {\n    dir :: fn(path Str) Str {\n        if path.len == 0 { ret Str.empty() }\n        i := path.len\n        while i > 0 {\n            i = i - 1\n            if *(path.ptr + i) == '/' {\n                ret path.sub(0, i)\n            }\n        }\n        Str.empty()\n    }\n\n    base :: fn(path Str) Str {\n        if path.len == 0 { ret Str.empty() }\n        i := path.len\n        while i > 0 {\n            i = i - 1\n            if *(path.ptr + i) == '/' {\n                ret path.sub(i + 1, path.len - (i + 1))\n            }\n        }\n        path\n    }\n\n    join :: fn(arena &Arena, base Str, rel Str) Str {\n        if base.len == 0 { ret rel }\n        if rel.len == 0 { ret base }\n        out := String.new(arena)\n        out.push_str(base)\n        if *(base.ptr + base.len - 1) != '/' {\n            out.push_char('/')\n        }\n        out.push_str(rel)\n        out.as_str()\n    }\n\n    normalize :: fn(arena &Arena, path Str) Str {\n        if path.len == 0 { ret Str.empty() }\n        is_abs := *(path.ptr) == '/'\n        segs := Vec(Str).new()\n        i: u64 = 0\n        start: u64 = 0\n\n        while i <= path.len {\n            is_sep := (i == path.len) or (*(path.ptr + i) == '/')\n            if is_sep {\n                if i > start {\n                    seg := path.sub(start, i - start)\n                    if seg.eq(Str.of(\".\")) {\n                    } else if seg.eq(Str.of(\"..\")) {\n                        if (segs.len > 0) and (not segs.last().eq(Str.of(\"..\"))) {\n                            segs.pop()\n                        } else if not is_abs {\n                            segs.push(seg)\n                        }\n                    } else {\n                        segs.push(seg)\n                    }\n                }\n                start = i + 1\n            }\n            i = i + 1\n        }\n\n        out := String.new(arena)\n        if is_abs {\n            out.push_char('/')\n        }\n        idx: u64 = 0\n        while idx < segs.len {\n            if idx > 0 {\n                out.push_char('/')\n            }\n            out.push_str(segs.get(idx))\n            idx = idx + 1\n        }\n        segs.destroy()\n        out.as_str()\n    }\n\n    resolve :: fn(arena &Arena, base Str, rel Str) Str {\n        if base.len == 0 {\n            ret Path.normalize(arena, rel)\n        }\n        d := Path.dir(base)\n        if d.len == 0 {\n            ret Path.normalize(arena, rel)\n        }\n        Path.normalize(arena, Path.join(arena, d, rel))\n    }\n}\n") }

elem_size())\n        .len = .len + count\n    }\n\n    mark :: fn() u64 {\n        .len\n    }\n\n    reset :: fn(mark u64) {\n        if mark <= .len {\n            .len = mark\n        }\n    }\n\n    clear :: fn() {\n        len = 0\n    }\n\n    ptr_at :: fn(offset u64) &VecType {\n        .ptr + offset\n    }\n\n    swap_remove :: fn(idx u64) VecType {\n        last_idx := .len - 1\n        removed := *(.ptr + idx)\n    \n        if idx != last_idx {\n            *(.ptr + idx) = *(.ptr + last_idx)\n        }\n    \n        .len = last_idx\n        removed\n    }\n\n    as_slice :: fn() SliceType {\n        .{\n            ptr: .ptr,\n            len: .len\n        }\n    }\n}") }
    if path.eq(Str.of("std/vec/u32.a")) { ret Str.of("import malloc, realloc, free, mem_copy from \"../mem.a\"\nimport U32_size from \"../primitive/u32.a\"\nimport SliceU32 from \"../slice/u32.a\"\n\nVecType            :: u32\nSliceType          :: SliceU32 \n\nelem_size          :: fn() u64 { U32_size() }\n\n\nVecU32 :: struct {\n    ptr &VecType\n    len u64\n    cap u64\n\n    new :: fn() Self {\n        Self.with_cap(4)\n    }\n\n    with_cap :: fn(initial_cap u64) Self {\n        cap := initial_cap\n        if cap < 4 {\n            cap = 4\n        }\n\n        p := malloc(cap * elem_size()) as &VecType\n\n        .{\n            ptr: p,\n            len: 0,\n            cap: cap\n        }\n    }\n\n    destroy :: fn() {\n        free(.ptr as &u8)\n        .ptr = 0 as &VecType\n        .len = 0\n        .cap = 0\n    }\n\n    reserve :: fn(additional u64) {\n        needed := .len + additional\n        if needed > .cap {\n            new_cap := .cap * 2\n            if new_cap < 4 { new_cap = 4 }\n            while new_cap < needed {\n                new_cap = new_cap * 2\n            }\n\n            new_ptr := realloc(.ptr as &u8, new_cap * elem_size()) as &VecType\n            .ptr = new_ptr\n            .cap = new_cap\n        }\n    }\n\n    grow :: fn() {\n        if .len == .cap {\n            .reserve(1)\n        }\n    }\n\n\n    push :: fn(val VecType) {\n        .grow()\n\n        *(.ptr + .len) = val\n        .len = .len + 1\n    }\n\n\n    get :: fn(idx u64) VecType {\n        *(.ptr + idx)\n    }\n\n    pop :: fn() VecType {\n        .len = .len - 1\n        .get(.len)\n    }\n\n    set :: fn(idx u64, val VecType) {\n        *(.ptr + idx) = val\n    }\n\n\n    last :: fn() VecType {\n        *(.ptr + (.len - 1))\n    }\n\n    is_empty :: fn() bool {\n        .len == 0\n    }\n\n    extend :: fn(src &VecType, count u64) {\n        if count == 0 { ret }\n\n        .reserve(count)\n        dst := (.ptr + .len) as &u8\n\n        mem_copy(dst, src as
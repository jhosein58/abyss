import Str from "std/string"
import Arena from "std/allocator"
import Embed from "std/fs"

embedded_source_body :: fn() Str {
    arena := Arena.new(2 * 1024 * 1024)
    Embed.sources(&arena)
}

embedded_runtime_body :: fn() Str {
    arena := Arena.new(1024 * 1024)
    Embed.file(&arena, Str.of("runtime/prelude.c"))
}

embedded_source :: fn(path Str) Str {
    #embedded_source_body()
}

embedded_runtime :: fn() Str {
    #embedded_runtime_body()
}

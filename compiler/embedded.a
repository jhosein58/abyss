    if path.eq(Str.of("std/slice/u32.a")) { ret Str.of("\n--- Generics -------------------------------------------------------------------------------\nSliceTy :: u32\nSliceU32 :: Self\n\nSliceU32_new :: fn(p &SliceTy, len u64) Self { Self_new() }\n--------------------------------------------------------------------------------------------\n\nSelf :: struct {\n    ptr &SliceTy\n    len u64\n}\n\n\nSelf_new :: fn(p &SliceTy, len u64) Self {\n    .{\n        ptr: p,\n        len: len\n    }\n}") }

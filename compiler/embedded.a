    if path.eq(Str.of("std/string.a")) { ret Str.of("import Str from \"../core/string.a\"\nimport Arena  from \"allocator.a\"\nimport AVecU8 from \"avec/u8.a\"\n\nstr_len    :: fn(s &u8) u64\nprint_char :: fn(c u8)  unit\n\n\nString :: struct {\n    buf AVecU8\n\n    new :: fn(a &Arena) String {\n        .{\n            buf: AVecU8.new(a)\n        }\n    }\n\n    push_str :: fn(s Str) {\n        i := 0\n\n        while i < s.len {\n            .buf.push(*(s.ptr + i))\n            i = i + 1\n        }\n    }\n\n    as_str :: fn() Str {\n        Str.new(.buf.ptr, .buf.len)\n    }\n\n    push_char :: fn(c u8) {\n        .buf.push(c)\n    }\n\n    push_u32 :: fn(val u32) {\n        if val == 0 {\n            .push_char('0') \n            ret\n        }\n\n        v := val\n        divisor: u32 = 1\n\n        while ((v / divisor) >= 10) and (divisor <= 100000000) {\n            divisor = divisor * 10\n        }\n\n        while divisor > 0 {\n            digit := v / divisor\n            .push_char((digit + 48) as u8)\n        \n            v = v - (digit * divisor)\n            divisor = divisor / 10\n        }\n    }\n}\n\nu32_to_str :: fn(arena &Arena, val u32) Str {\n    s := String.new(arena)\n    s.push_u32(val)\n    s.as_str()\n}\n\nparse_u32 :: fn(s Str) Maybe(u32) {\n    if s.len == 0 { ret Maybe(u32).none() }\n    res: u32 = 0\n    i: u64 = 0\n    base: u32 = 10\n    if s.len >= 2 {\n        if (*(s.ptr) == 48) and ((*(s.ptr + 1) == 120) or (*(s.ptr + 1) == 88)) {\n            base = 16\n            i = 2\n        }\n    }\n    if i == s.len { ret Maybe(u32).none() }\n    while i < s.len {\n        c := *(s.ptr + i)\n        if c == 95 {\n            i = i + 1\n            cont\n        }\n        digit: u32 = 16\n        if (c >= 48) and (c <= 57) { digit = (c - 48) as u32 }\n        if (c >= 65) and (c <= 70) { digit = (c - 65) as u32 + 10 }\n        if (c >= 97) and (c <= 102) { digit = (c - 97) as u32 + 10 }\n        if digit >= base { ret Maybe(u32).none() }\n        res = (res * base) + digit\n        i = i + 1\n    }\n    Maybe(u32).some(res)\n}") }

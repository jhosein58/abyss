    if mod_path.eq(Str.of("std/collections/hash_set.a")) {
        ret Str.of("import std.mem: free, malloc, mem_set\n\nHashSet :: fn(T type) type {\n    struct {\n        keys     &T\n        occupied &bool\n        len      u64\n        cap      u64\n        new :: fn() Self {\n            Self.with_cap(16)\n        }\n\n        with_cap :: fn(initial_cap u64) Self {\n            cap := initial_cap\n            if cap < 16 {\n                cap = 16\n            }\n            k_mem := malloc(cap * @sizeof(T)) as &T\n            o_mem := malloc(cap * @sizeof(bool)) as &bool\n            mem_set(o_mem as &u8, 0 as u8, cap * @sizeof(bool))\n            .{ keys: k_mem, occupied: o_mem, len: 0, cap: cap }\n        }\n\n        destroy :: fn(self &Self) {\n            free(self.keys as &u8)\n            free(self.occupied as &u8)\n            self.keys = 0 as &T\n            self.occupied = 0 as &bool\n            self.len = 0\n            self.cap = 0\n        }\n\n        hash_key :: fn(val &T) u64 {\n            bytes := val as &u8\n            h: u64 = 14695981039346656037\n            i: u64 = 0\n            while i < @sizeof(T) {\n                byte := *(bytes + i) as u64\n                h = (h ^ byte) * 1099511628211\n                i = i + 1\n            }\n            h\n        }\n\n        keys_equal :: fn(a &T, b &T) bool {\n            pa := a as &u8\n            pb := b as &u8\n            i: u64 = 0\n            while i < @sizeof(T) {\n                if *(pa + i) != *(pb + i) {\n                    ret false\n                }\n                i = i + 1\n            }\n            true\n        }\n\n        contains :: fn(self &Self, val T) bool {\n            if self.cap == 0 {\n                ret false\n            }\n            mask := self.cap - 1\n            idx := Self.hash_key(&val) & mask\n            while *(self.occupied + idx) {\n                if Self.keys_equal(self.keys + idx, &val) {\n                    ret true\n                }\n                idx = (idx + 1) & mask\n            }\n            false\n        }\n\n        insert :: fn(self &Self, val T) bool {\n            if (self.len + 1) * 2 >= self.cap {\n                self.grow()\n            }\n            mask := self.cap - 1\n            idx := Self.hash_key(&val) & mask\n            while *(self.occupied + idx) {\n                if Self.keys_equal(self.keys + idx, &val) {\n                    ret false\n                }\n                idx = (idx + 1) & mask\n            }\n            *(self.keys + idx) = val\n            *(self.occupied + idx) = true\n            self.len = self.len + 1\n            true\n        }\n\n        remove :: fn(self &Self, val T) bool {\n            if self.cap == 0 {\n                ret false\n            }\n            mask := self.cap - 1\n            idx := Self.hash_key(&val) & mask\n            while *(self.occupied + idx) {\n                if Self.keys_equal(self.keys + idx, &val) {\n                    *(self.occupied + idx) = false\n                    self.len = self.len - 1\n                    ret true\n                }\n                idx = (idx + 1) & mask\n            }\n            false\n        }\n\n        is_empty :: fn(self &Self) bool {\n            self.len == 0\n        }\n\n        clear :: fn(self &Self) {\n            if self.cap > 0 {\n                mem_set(self.occupied as &u8, 0 as u8, self.cap * @sizeof(bool))\n                self.len = 0\n            }\n        }\n\n        grow :: fn(self &Self) {\n            old_keys := self.keys\n            old_occ := self.occupied\n            old_cap := self.cap\n\n            new_cap := old_cap * 2\n            self.keys = malloc(new_cap * @sizeof(T)) as &T\n            self.occupied = malloc(new_cap * @sizeof(bool)) as &bool\n            mem_set(self.occupied as &u8, 0 as u8, new_cap * @sizeof(bool))\n            self.cap = new_cap\n            self.len = 0\n\n            mask := new_cap - 1\n            i: u64 = 0\n            while i < old_cap {\n                if *(old_occ + i) {\n                    val := *(old_keys + i)\n                    idx := Self.hash_key(&val) & mask\n                    while *(self.occupied + idx) {\n                        idx = (idx + 1) & mask\n                    }\n                    *(self.keys + idx) = val\n                    *(self.occupied + idx) = true\n                    self.len = self.len + 1\n                }\n                i = i + 1\n            }\n\n            free(old_keys as &u8)\n            free(old_occ as &u8)\n        }\n    }\n}\n")

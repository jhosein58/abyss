    if mod_path.eq(Str.of("std/convert.a")) {
        ret Str.of("import std.allocator: Arena\nimport std.string:    String\nimport std.sys:       fall, format_float, write_console\n\nConvert :: struct {\n    unsigned64 :: fn(out &String, value u64) {\n        digits: [20]u8\n        pos: u64 = 20\n        remaining := value\n        while true {\n            pos = pos - 1\n            digits[pos] = ((remaining % 10) + 48) as u8\n            remaining = remaining / 10\n            if remaining == 0 {\n                break\n            }\n        }\n        out.push_str(Str.new(&digits[pos], 20 - pos))\n    }\n\n    signed64 :: fn(out &String, value i64) {\n        magnitude := value as u64\n        if value < 0 {\n            out.push_char('-')\n            magnitude = (0 as u64) - magnitude\n        }\n        Convert.unsigned64(out, magnitude)\n    }\n\n    unsigned128 :: fn(out &String, value u128) {\n        digits: [40]u8\n        pos: u64 = 40\n        remaining := value\n        while true {\n            pos = pos - 1\n            digits[pos] = ((remaining % 10) + 48) as u8\n            remaining = remaining / 10\n            if remaining == 0 {\n                break\n            }\n        }\n        out.push_str(Str.new(&digits[pos], 40 - pos))\n    }\n\n    signed128 :: fn(out &String, value i128) {\n        magnitude := value as u128\n        if value < 0 {\n            out.push_char('-')\n            magnitude = (0 as u128) - magnitude\n        }\n        Convert.unsigned128(out, magnitude)\n    }\n\n    float64 :: fn(out &String, value f64) {\n        out.reserve(out.len + 384)\n        count := format_float(out.ptr + out.len, 384, value)\n        out.len = out.len + count\n    }\n\n    boolean :: fn(out &String, value bool) {\n        if value {\n            out.push_str(\"true\")\n        } else {\n            out.push_str(\"false\")\n        }\n    }\n\n    quoted :: fn(out &String, value Str) {\n        out.push_char('\"')\n        i: u64 = 0\n        while i < value.len {\n            c := *(value.ptr + i)\n            if c == '\"' {\n                out.push_str(`\\\"`)\n            } else if c == '\\\\' {\n                out.push_char(92 as u8)\n                ,\n                out.push_char(92 as u8)\n            } else if c == '\\n' {\n                out.push_str(`\\n`)\n            } else if c == '\\r' {\n                out.push_str(`\\r`)\n            } else if c == '\\t' {\n                out.push_str(`\\t`)\n            } else {\n                out.push_char(c)\n            }\n            i = i + 1\n        }\n        out.push_char('\"')\n    }\n\n    quote_source :: fn(out &String, value Str) {\n        out.push_char('\"')\n        i: u64 = 0\n        while i < value.len {\n            c := *(value.ptr + i)\n            if c == '\"' {\n                out.push_str(`\\\"`)\n            } else if c == '\\\\' {\n                out.push_char(92 as u8)\n                ,\n                out.push_char(92 as u8)\n            } else if c == '\\n' {\n                out.push_str(`\\n`)\n            } else if c == '\\r' {\n                out.push_str(`\\r`)\n            } else if c == '\\t' {\n                out.push_str(`\\t`)\n            } else if c == 0 {\n                out.push_str(`\\000`)\n            } else {\n                out.push_char(c)\n            }\n            i = i + 1\n        }\n        out.push_char('\"')\n    }\n\n    literal :: fn(out &String, text Str) {\n        if text.len == 0 {\n            ret\n        }\n        source := out.as_str()\n        if source.ends_with(\"\\\")\\n\") {\n            out.len = out.len - 3\n        } else {\n            out.push_str(\"out.push_str(\\\"\")\n        }\n        quoted := String.new(out.arena)\n        Convert.quote_source(&quoted, text)\n        out.push_str(quoted.as_str().sub(1, quoted.len - 2))\n        out.push_str(\"\\\")\\n\")\n    }\n\n    indent :: fn(out &String, depth u32) {\n        i: u32 = 0\n        while i < depth {\n            Convert.literal(out, \"    \")\n            i = i + 1\n        }\n    }\n\n    call :: fn(out &String, function Str, value Str) {\n        out.push_str(\"Convert.\")\n        out.push_str(function)\n        out.push_str(\"(&out, \")\n        out.push_str(value)\n        out.push_str(\")\\n\")\n    }\n\n    value :: fn(out &String, info &TypeInfo(), value Str, depth u32) {\n        kind := info.kind\n        if (kind == TypeKind.int) or (kind == TypeKind.uint) or (kind == TypeKind.untyped_int) {\n            function := \"signed64\"\n            target := \"i64\"\n            if kind == TypeKind.uint {\n                function = \"unsigned64\"\n                ,\n                target = \"u64\"\n            }\n            if info.bits == 128 {\n                function = \"signed128\"\n                target = \"i128\"\n                if kind == TypeKind.uint {\n                    function = \"unsigned128\"\n                    ,\n                    target = \"u128\"\n                }\n            }\n            expr := String.new(out.arena)\n            expr.push_str(\"(\")\n            expr.push_str(value)\n            expr.push_str(\" as \")\n            expr.push_str(target)\n            expr.push_str(\")\")\n            Convert.call(out, function, expr.as_str())\n            ret\n        }\n        if (kind == TypeKind.float) or (kind == TypeKind.untyped_float) {\n            out.push_str(\"Convert.float64(&out, \")\n            out.push_str(value)\n            out.push_str(\" as f64)\\n\")\n            ret\n        }\n        if kind == TypeKind.bool {\n            Convert.call(out, \"boolean\", value)\n            ,\n            ret\n        }\n        if (kind == TypeKind.string) or (info.id == @type_info(String).id) {\n            expr := String.new(out.arena)\n            expr.push_str(value)\n            if kind != TypeKind.string {\n                expr.push_str(\".as_str()\")\n            }\n            if depth == 0 {\n                out.push_str(\"out.push_str(\")\n                out.push_str(expr.as_str())\n                out.push_str(\")\\n\")\n            } else {\n                Convert.call(out, \"quoted\", expr.as_str())\n            }\n            ret\n        }\n        if kind == TypeKind.ptr {\n            if (info.element.kind == TypeKind.uint) and (info.element.bits == 8) {\n                out.push_str(\"if \")\n                out.push_str(value)\n                out.push_str(\" == (0 as &u8) {\\n\")\n                Convert.literal(out, \"null\")\n                out.push_str(\"} else {\\nout.push_str(Str.of(\")\n                out.push_str(value)\n                out.push_str(\"))\\n}\\n\")\n            } else {\n                Convert.literal(out, info.name)\n                Convert.literal(out, \"(\")\n                out.push_str(\"Convert.unsigned64(&out, \")\n                out.push_str(value)\n                out.push_str(\" as u64)\\n\")\n                Convert.literal(out, \")\")\n            }\n            ret\n        }\n        if kind == TypeKind.enum_ {\n            i: u64 = 0\n            while i < info.field_count {\n                field := *(info.fields + i)\n                if i > 0 {\n                    out.push_str(\"else \")\n                }\n                out.push_str(\"if \")\n                out.push_str(value)\n                out.push_str(\" == @type_from_id(\")\n                Convert.unsigned64(out, info.id as u64)\n                out.push_str(\").\")\n                out.push_str(field.name)\n                out.push_str(\" {\\n\")\n                Convert.literal(out, info.name)\n                Convert.literal(out, \".\")\n                Convert.literal(out, field.name)\n                out.push_str(\"}\\n\")\n                i = i + 1\n            }\n            if info.field_count > 0 {\n                out.push_str(\"else {\\n\")\n            }\n            Convert.literal(out, info.name)\n            Convert.literal(out, \"(\")\n            out.push_str(\"Convert.unsigned64(&out, \")\n            out.push_str(value)\n            out.push_str(\" as u64)\\n\")\n            Convert.literal(out, \")\")\n            if info.field_count > 0 {\n                out.push_str(\"}\\n\")\n            }\n            ret\n        }\n        if kind == TypeKind.union_ {\n            i: u64 = 0\n            while i < info.member_count {\n                member := *(info.members + i)\n                if i > 0 {\n                    out.push_str(\"else \")\n                }\n                out.push_str(\"if @tag(\")\n                out.push_str(value)\n                out.push_str(\") == \")\n                Convert.unsigned64(out, i)\n                out.push_str(\" {\\n\")\n                expr := String.new(out.arena)\n                expr.push_str(\"(\")\n                expr.push_str(value)\n                expr.push_str(\" as @type_from_id(\")\n                Convert.unsigned64(&expr, member.id as u64)\n                expr.push_str(\"))\")\n                Convert.value(out, member, expr.as_str(), depth)\n                out.push_str(\"}\\n\")\n                i = i + 1\n            }\n            ret\n        }\n        if (kind == TypeKind.struct_) or (kind == TypeKind.tuple) or (kind == TypeKind.array) {\n            open := \"{\"\n            close := \"}\"\n            count := info.field_count\n            if kind == TypeKind.tuple {\n                open = \"(\"\n                ,\n                close = \")\"\n            } else if kind == TypeKind.array {\n                open = \"[\"\n                ,\n                close = \"]\"\n                ,\n                count = info.length\n            } else if not info.name.starts_with(\"struct {\") {\n                Convert.literal(out, info.name)\n                Convert.literal(out, \" \")\n            }\n            Convert.literal(out, open)\n            if count > 0 {\n                Convert.literal(out, \"\\n\")\n            }\n            i: u64 = 0\n            while i < count {\n                Convert.indent(out, depth + 1)\n                expr := String.new(out.arena)\n                expr.push_str(\"(\")\n                expr.push_str(value)\n                expr.push_str(\")\")\n                child := info.element\n                if kind == TypeKind.array {\n                    expr.push_str(\"[\")\n                    Convert.unsigned64(&expr, i)\n                    expr.push_str(\"]\")\n                } else {\n                    field := *(info.fields + i)\n                    child = field.type_info\n                    if kind != TypeKind.tuple {\n                        Convert.literal(out, field.name)\n                        Convert.literal(out, \": \")\n                    }\n                    expr.push_str(\".\")\n                    expr.push_str(field.name)\n                }\n                Convert.value(out, child, expr.as_str(), depth + 1)\n                Convert.literal(out, \",\\n\")\n                i = i + 1\n            }\n            if count > 0 {\n                Convert.indent(out, depth)\n            }\n            Convert.literal(out, close)\n            ret\n        }\n        if kind == TypeKind.func {\n            Convert.literal(out, \"<\")\n            Convert.literal(out, info.name)\n            Convert.literal(out, \">\")\n            ret\n        }\n        if kind == TypeKind.unit {\n            Convert.literal(out, \"()\")\n            ,\n            ret\n        }\n        Convert.literal(out, info.name)\n    }\n}\n\nvalue_code :: fn(info &TypeInfo(), value Str) Str {\n    arena := Arena.new(4096)\n    out := String.new(&arena)\n    Convert.value(&out, info, value, 0)\n    out.as_str()\n}\n\nconversion_error :: fn(message Str) {\n    write_console(message)\n    fall()\n}\n")

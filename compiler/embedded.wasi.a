h.ptr)\n            c1 := *(path.ptr + 1)\n            is_letter := (c0 >= 'a' and c0 <= 'z') or (c0 >= 'A' and c0 <= 'Z')\n            if is_letter and (c1 == ':') {\n                is_drive = true\n                if path.len >= 3 {\n                    c2 := *(path.ptr + 2)\n                    if c2 == '/' or c2 == '\\\\' {\n                        is_abs = true\n                        start_idx = 3\n                    } else {\n                        start_idx = 2\n                    }\n                } else {\n                    start_idx = 2\n                }\n            }\n        }\n        if not is_drive {\n            c0 := *(path.ptr)\n            if c0 == '/' or c0 == '\\\\' {\n                is_abs = true\n                start_idx = 1\n            }\n        }\n        segs := Vec(Str).new()\n        i: u64 = start_idx\n        start: u64 = start_idx\n\n        while i <= path.len {\n            is_sep := (i == path.len) or (*(path.ptr + i) == '/') or (*(path.ptr + i) == '\\\\')\n            if is_sep {\n                if i > start {\n                    seg := path.sub(start, i - start)\n                    if seg.eq(Str.of(\".\")) {} else if seg.eq(Str.of(\"..\")) {\n                        if (segs.len > 0) and (not segs.last().eq(Str.of(\"..\"))) {\n                            segs.pop()\n                        } else if not is_abs {\n                            segs.push(seg)\n                        }\n                    } else {\n                        segs.push(seg)\n                    }\n                }\n                start = i + 1\n            }\n            i = i + 1\n        }\n\n        out := String.new(arena)\n        if is_drive {\n            out.push_str(path.sub(0, 2))\n            if is_abs {\n                out.push_char('/')\n            }\n        } else if is_abs {\n            out.push_char('/')\n        }\n        idx: u64 = 0\n        while idx < segs.len {\n            if idx > 0 {\n                out.push_char('/')\n            }\n            out.push_str(segs.get(idx))\n            idx = idx + 1\n        }\n        segs.destroy()\n        out.as_str()\n    }\n\n    resolve :: fn(arena &Arena, base Str, rel Str) Str {\n        if base.len == 0 {\n            ret Path.normalize(arena, rel)\n        }\n        d := Path.dir(base)\n        if d.len == 0 {\n            ret Path.normalize(arena, rel)\n        }\n        Path.normalize(arena, Path.join(arena, d, rel))\n    }\n}\n")

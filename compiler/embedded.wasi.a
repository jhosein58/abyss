    if mod_path.eq(Str.of("std/collections/vec.a")) {
        ret Str.of("import core.prelude: Iterator as Iter, RefIterator as RefIter\nimport std.mem:      free, malloc, mem_copy, realloc\n\nVec :: fn(T type) type {\n    struct {\n        ptr &T\n        len u64\n        cap u64\n        new :: fn() Self {\n            Self.with_cap(4)\n        }\n\n        with_cap :: fn(initial_cap u64) Self {\n            cap := initial_cap\n            if cap < 4 {\n                cap = 4\n            }\n            p := malloc(cap * @sizeof(T)) as &T\n\n            .{ ptr: p, len: 0, cap: cap }\n        }\n\n        destroy :: fn(self &Self) {\n            free(self.ptr as &u8)\n            self.ptr = 0 as &T\n            self.len = 0\n            self.cap = 0\n        }\n\n        reserve :: fn(self &Self, additional u64) {\n            needed := self.len + additional\n            if needed > self.cap {\n                new_cap := self.cap * 2\n                if new_cap < 4 {\n                    new_cap = 4\n                }\n                while new_cap < needed {\n                    new_cap = new_cap * 2\n                }\n\n                new_ptr := realloc(self.ptr as &u8, new_cap * @sizeof(T)) as &T\n                self.ptr = new_ptr\n                self.cap = new_cap\n            }\n        }\n\n        grow :: fn(self &Self) {\n            if self.len == self.cap {\n                self.reserve(1)\n            }\n        }\n\n        push :: fn(self &Self, val T) {\n            self.grow()\n\n            *(self.ptr + self.len) = val\n            self.len = self.len + 1\n        }\n\n        get :: fn(self &Self, idx u64) T {\n            *(self.ptr + idx)\n        }\n\n        pop :: fn(self &Self) T {\n            self.len = self.len - 1\n            self.get(self.len)\n        }\n\n        set :: fn(self &Self, idx u64, val T) {\n            *(self.ptr + idx) = val\n        }\n\n        last :: fn(self &Self) T {\n            *(self.ptr + (self.len - 1))\n        }\n\n        is_empty :: fn(self &Self) bool {\n            self.len == 0\n        }\n\n        contains :: fn(self &Self, val T) bool {\n            self.as_slice().contains(val)\n        }\n\n        dedup :: fn(self &Self) {\n            self.len = self.as_slice().dedup().len\n        }\n\n        extend :: fn(self &Self, src &T, count u64) {\n            if count == 0 {\n                ret\n            }\n            self.reserve(count)\n            dst := (self.ptr + self.len) as &u8\n\n            mem_copy(dst, src as &u8, count * @sizeof(T))\n            self.len = self.len + count\n        }\n\n        mark :: fn(self &Self) u64 {\n            self.len\n        }\n\n        reset :: fn(self &Self, mark u64) {\n            if mark <= self.len {\n                self.len = mark\n            }\n        }\n\n        clear :: fn(self &Self) {\n            self.len = 0\n        }\n\n        ptr_at :: fn(self &Self, offset u64) &T {\n            self.ptr + offset\n        }\n\n        swap_remove :: fn(self &Self, idx u64) T {\n            last_idx := self.len - 1\n            removed := *(self.ptr + idx)\n\n            if idx != last_idx {\n                *(self.ptr + idx) = *(self.ptr + last_idx)\n            }\n            self.len = last_idx\n            removed\n        }\n\n        as_slice :: fn(self &Self) Slice(T) {\n            .{ ptr: self.ptr, len: self.len }\n        }\n\n        iter :: fn(self &Self) Iter(T) {\n            .{ ptr: self.ptr, len: self.len, index: 0 }\n        }\n\n        iter_ref :: fn(self &Self) RefIter(T) {\n            .{ ptr: self.ptr, len: self.len, index: 0 }\n        }\n\n        collect :: fn(iter Iter(T)) Self {\n            result := Self.new()\n            while true {\n                item := iter.next()\n                if item.is_none() {\n                    break\n                }\n                result.push(item.unwrap())\n            }\n            result\n        }\n    }\n}\n")

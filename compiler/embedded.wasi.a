        ret Str.of("Worklist :: fn(T type) type {\n    struct {\n        vec   &Vec(T)\n        index u64\n        new :: fn(vec &Vec(T)) Self {\n            .{ vec: vec, index: 0 }\n        }\n\n        next :: fn(self &Self) Maybe(T) {\n            if self.index >= self.vec.len {\n                ret Maybe(T).none()\n            }\n            val := self.vec.get(self.index)\n            self.index = self.index + 1\n            Maybe(T).some(val)\n        }\n\n        has_next :: fn(self &Self) bool {\n            self.index < self.vec.len\n        }\n\n        remaining :: fn(self &Self) u64 {\n            if self.index >= self.vec.len {\n                ret 0\n            }\n            self.vec.len - self.index\n        }\n    }\n}\n")

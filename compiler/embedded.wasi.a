import std.string: Str

lookup_embedded :: fn(mod_path Str) Str {
    if mod_path.eq(Str.of("core/choice.a")) {
        ret Str.of("Choice :: fn(T type, E type) type {\n    struct {\n        is_ok bool\n        val   T | E\n        ok :: fn(v T) Self {\n            .{ is_ok: true, val: v }\n        }\n\n        err :: fn(e E) Self {\n            .{ is_ok: false, val: e }\n        }\n\n        is_success :: fn(self &Self) bool {\n            self.is_ok\n        }\n        is_error :: fn(self &Self) bool {\n            not self.is_ok\n        }\n\n        unwrap_or :: fn(self &Self, fallback T) T {\n            if self.is_ok {\n                self.val as T\n            } else {\n                fallback\n            }\n        }\n    }\n}\n")
    }
    if mod_path.eq(Str.of("core/chunks.a")) {
        ret Str.of("import core.maybe: Maybe\nimport core.slice: Slice\n\nChunks :: fn(T type) type {\n    struct {\n        ptr               &T\n        len, width, index u64\n        next :: fn(self &Self) Maybe(Slice(T)) {\n            if (self.width == 0) or (self.width > self.len - self.index) {\n                ret Maybe(Slice(T)).none()\n            }\n            chunk := Slice(T).new(self.ptr + self.index, self.width)\n            self.index = self.index + self.width\n            Maybe(Slice(T)).some(chunk)\n        }\n    }\n}\n")
    }
    if mod_path.eq(Str.of("core/iterator.a")) {
        ret Str.of("import core.maybe: Maybe\n\nIterator :: fn(T type) type {\n    struct {\n        ptr   &T\n        len   u64\n        index u64\n        new :: fn(ptr &T, len u64) Self {\n            .{ ptr: ptr, len: len, index: 0 }\n        }\n\n        next :: fn(self &Self) Maybe(T) {\n            if self.index >= self.len {\n                ret Maybe(T).none()\n            }\n            value := *(self.ptr + self.index)\n            self.index = self.index + 1\n            Maybe(T).some(value)\n        }\n\n        has_next :: fn(self &Self) bool {\n            self.index < self.len\n        }\n\n        is_done :: fn(self &Self) bool {\n            self.index >= self.len\n        }\n\n        peek :: fn(self &Self) Maybe(T) {\n            if self.index >= self.len {\n                ret Maybe(T).none()\n            }\n            Maybe(T).some(*(self.ptr + self.index))\n        }\n\n        skip :: fn(self &Self, n u64) {\n            self.index = self.index + n\n            if self.index > self.len {\n                self.index = self.len\n            }\n        }\n\n        reset :: fn(self &Self) {\n            self.index = 0\n        }\n\n        remaining :: fn(self &Self) u64 {\n            if self.index >= self.len {\n                ret 0\n            }\n            self.len - self.index\n        }\n    }\n}\n")
    }
    if mod_path.eq(Str.of("core/maybe.a")) {
        ret Str.of("Maybe :: fn(T type) type {\n    struct {\n        present bool\n        value   T\n        some :: fn(value T) Self {\n            .{ present: true, value: value }\n        }\n        none :: fn() Self {\n            result: Self\n            result.present = false\n            result\n        }\n        is_some :: fn(self &Self) bool {\n            self.present\n        }\n        is_none :: fn(self &Self) bool {\n            not self.present\n        }\n        unwrap :: fn(self &Self) T {\n            self.value\n        }\n        unwrap_or :: fn(self &Self, fallback T) T {\n            if self.present {\n                self.value\n            } else {\n                fallback\n            }\n        }\n    }\n}\n")
    }
    if mod_path.eq(Str.of("core/prelude.a")) {
        ret Str.of("import core.choice:       Choice\nimport core.iterator:     Iterator\nimport core.maybe:        Maybe\nimport core.range:        Range\nimport core.ref_iterator: RefIterator\nimport core.reflection:   FieldInfo, TypeInfo, TypeKind\nimport core.slice:        Slice\nimport core.string:       CharIter, Str\n")
    }
    if mod_path.eq(Str.of("core/range.a")) {
        ret Str.of("import core.maybe: Maybe\n\nRange :: struct {\n    current i32\n    end     i32\n    new :: fn(start i32, end i32) Self {\n        .{ current: start, end: end }\n    }\n\n    next :: fn(self &Self) Maybe(i32) {\n        if self.current >= self.end {\n            ret Maybe(i32).none()\n        }\n        value := self.current\n        self.current = self.current + 1\n        Maybe(i32).some(value)\n    }\n}\n")
    }
    if mod_path.eq(Str.of("core/ref_iterator.a")) {
        ret Str.of("import core.maybe: Maybe\n\nRefIterator :: fn(T type) type {\n    struct {\n        ptr   &T\n        len   u64\n        index u64\n        new :: fn(ptr &T, len u64) Self {\n            .{ ptr: ptr, len: len, index: 0 }\n        }\n\n        next :: fn(self &Self) Maybe(&T) {\n            if self.index >= self.len {\n                ret Maybe(&T).none()\n            }\n            value := self.ptr + self.index\n            self.index = self.index + 1\n            Maybe(&T).some(value)\n        }\n\n        has_next :: fn(self &Self) bool {\n            self.index < self.len\n        }\n\n        is_done :: fn(self &Self) bool {\n            self.index >= self.len\n        }\n\n        peek :: fn(self &Self) Maybe(&T) {\n            if self.index >= self.len {\n                ret Maybe(&T).none()\n            }\n            Maybe(&T).some(self.ptr + self.index)\n        }\n\n        skip :: fn(self &Self, n u64) {\n            self.index = self.index + n\n            if self.index > self.len {\n                self.index = self.len\n            }\n        }\n\n        reset :: fn(self &Self) {\n            self.index = 0\n        }\n\n        remaining :: fn(self &Self) u64 {\n            if self.index >= self.len {\n                ret 0\n            }\n            self.len - self.index\n        }\n    }\n}\n")
    }
    if mod_path.eq(Str.of("core/reflection.a")) {
        ret Str.of("TypeKind :: enum u8 {\n    unknown\n    infer\n    untyped_int\n    untyped_float\n    int\n    uint\n    float\n    bool\n    ptr\n    type_\n    unit\n    func\n    never\n    struct_\n    array\n    error\n    nominal\n    enum_\n    union_\n    tuple\n    string\n}\n\nTypeInfo :: fn() type {\n    struct {\n        id           u32\n        name         Str\n        kind         TypeKind\n        bits         u32\n        length       u64\n        fields       &&FieldInfo()\n        field_count  u64\n        element      &TypeInfo()\n        members      &&TypeInfo()\n        member_count u64\n        params       &&TypeInfo()\n        param_count  u64\n        result       &TypeInfo()\n        is_extern    bool\n    }\n}\n\nFieldInfo :: fn() type {\n    struct {\n        name      Str\n        type_info &TypeInfo()\n        value     u64\n    }\n}\n")
    }
    if mod_path.eq(Str.of("core/slice.a")) {
        ret Str.of("import core.chunks:       Chunks\nimport core.iterator:     Iterator as Iter\nimport core.ref_iterator: RefIterator as RefIter\n\nSlice :: fn(T type) type {\n    struct {\n        ptr &T\n        len u64\n        new :: fn(ptr &T, len u64) Self {\n            .{ ptr: ptr, len: len }\n        }\n\n        empty :: fn() Self {\n            .{ ptr: 0 as &T, len: 0 }\n        }\n\n        get :: fn(self &Self, idx u64) T {\n            *(self.ptr + idx)\n        }\n\n        sub :: fn(self &Self, start u64, len u64) Self {\n            .{ ptr: (self.ptr + start), len: len }\n        }\n\n        chunks :: fn(self &Self, width u64) Chunks(T) {\n            .{ ptr: self.ptr, len: self.len, width: width, index: 0 }\n        }\n\n        equals :: fn(self &Self, other Self) bool {\n            if self.len != other.len {\n                ret false\n            }\n            i: u64 = 0\n            for value in self {\n                if value != other.get(i) {\n                    ret false\n                }\n                i = i + 1\n            }\n            true\n        }\n\n        position :: fn(self &Self, value T) Maybe(u64) {\n            i: u64 = 0\n            for item in self {\n                if item == value {\n                    ret Maybe(u64).some(i)\n                }\n                i = i + 1\n            }\n            Maybe(u64).none()\n        }\n\n        contains :: fn(self &Self, value T) bool {\n            self.position(value).is_some()\n        }\n\n        dedup :: fn(self &Self) Self {\n            count: u64 = 0\n            for value in self {\n                if (count == 0) or (value != self.get(count - 1)) {\n                    *(self.ptr + count) = value\n                    count = count + 1\n                }\n            }\n            self.sub(0, count)\n        }\n\n        iter :: fn(self &Self) Iter(T) {\n            .{ ptr: self.ptr, len: self.len, index: 0 }\n        }\n\n        iter_ref :: fn(self &Self) RefIter(T) {\n            .{ ptr: self.ptr, len: self.len, index: 0 }\n        }\n    }\n}\n")
    }
    if mod_path.eq(Str.of("core/string.a")) {
        ret Str.of("import core.maybe: Maybe\n\nCharIter :: struct {\n    ptr   &u8\n    len   u64\n    index u64\n    new :: fn(ptr &u8, len u64) Self {\n        .{ ptr: ptr, len: len, index: 0 }\n    }\n\n    next :: fn(self &Self) Maybe(u32) {\n        if self.index >= self.len {\n            ret Maybe(u32).none()\n        }\n        b0 := *(self.ptr + self.index)\n        cp: u32 = 0\n        step: u64 = 1\n\n        if (b0 & 0x80) == 0 {\n            cp = b0 as u32\n            step = 1\n        } else if (b0 & 0xE0) == 0xC0 {\n            if self.index + 1 < self.len {\n                b1 := *(self.ptr + self.index + 1)\n                cp = (((b0 & 0x1F) as u32) << 6) | ((b1 & 0x3F) as u32)\n                step = 2\n            } else {\n                cp = b0 as u32\n                step = 1\n            }\n        } else if (b0 & 0xF0) == 0xE0 {\n            if self.index + 2 < self.len {\n                b1 := *(self.ptr + self.index + 1)\n                b2 := *(self.ptr + self.index + 2)\n                cp = (((b0 & 0x0F) as u32) << 12) | (((b1 & 0x3F) as u32) << 6) | ((b2 & 0x3F) as u32)\n                step = 3\n            } else {\n                cp = b0 as u32\n                step = 1\n            }\n        } else if (b0 & 0xF8) == 0xF0 {\n            if self.index + 3 < self.len {\n                b1 := *(self.ptr + self.index + 1)\n                b2 := *(self.ptr + self.index + 2)\n                b3 := *(self.ptr + self.index + 3)\n                cp = (((b0 & 0x07) as u32) << 18) | (((b1 & 0x3F) as u32) << 12) | (((b2 & 0x3F) as u32) << 6) | ((b3 & 0x3F) as u32)\n                step = 4\n            } else {\n                cp = b0 as u32\n                step = 1\n            }\n        } else {\n            cp = b0 as u32\n            step = 1\n        }\n\n        self.index = self.index + step\n        Maybe(u32).some(cp)\n    }\n\n    has_next :: fn(self &Self) bool {\n        self.index < self.len\n    }\n}\n\nStr :: struct {\n    ptr &u8\n    len u64\n    size :: fn() u64 {\n        16\n    }\n\n    new :: fn(ptr &u8, len u64) Str {\n        .{ ptr: ptr, len: len }\n    }\n\n    empty :: fn() Str {\n        .{ ptr: 0 as &u8, len: 0 }\n    }\n\n    of :: fn(s &u8 | Str) Self {\n        if @is(s, Str) {\n            ret s as Str\n        }\n        raw := s as &u8\n        length: u64 = 0\n        if raw != (0 as &u8) {\n            while *(raw + length) != 0 as u8 {\n                length = length + 1\n            }\n        }\n        .{ ptr: raw, len: length }\n    }\n\n    sub :: fn(self &Self, start u64, len u64) Str {\n        .{ ptr: (self.ptr + start), len: len }\n    }\n\n    eq :: fn(self &Self, b Str) bool {\n        if self.len != b.len {\n            ret false\n        }\n        i: u64 = 0\n        while i < self.len {\n            if *(self.ptr + i) != *(b.ptr + i) {\n                ret false\n            }\n            i = i + 1\n        }\n\n        true\n    }\n\n    starts_with :: fn(self &Self, prefix Str) bool {\n        if self.len < prefix.len {\n            ret false\n        }\n        self.sub(0, prefix.len).eq(prefix)\n    }\n\n    ends_with :: fn(self &Self, suffix Str) bool {\n        if self.len < suffix.len {\n            ret false\n        }\n        self.sub(self.len - suffix.len, suffix.len).eq(suffix)\n    }\n\n    trim_quotes :: fn(self &Self) Str {\n        if self.len >= 2 {\n            first := *(self.ptr)\n            last := *(self.ptr + self.len - 1)\n            if ((first == '\"') and (last == '\"')) or ((first == '`') and (last == '`')) {\n                ret self.sub(1, self.len - 2)\n            }\n        }\n        .{ ptr: self.ptr, len: self.len }\n    }\n\n    iter :: fn(self &Self) CharIter {\n        CharIter.new(self.ptr, self.len)\n    }\n\n    chars :: fn(self &Self) CharIter {\n        CharIter.new(self.ptr, self.len)\n    }\n\n    char_count :: fn(self &Self) u64 {\n        count: u64 = 0\n        it := self.chars()\n        while it.next().is_some() {\n            count = count + 1\n        }\n        count\n    }\n\n    char_at :: fn(self &Self, n u64) Maybe(u32) {\n        it := self.chars()\n        idx: u64 = 0\n        while it.has_next() {\n            m := it.next()\n            if m.is_none() {\n                break\n            }\n            if idx == n {\n                ret m\n            }\n            idx = idx + 1\n        }\n        Maybe(u32).none()\n    }\n\n}\n")
    }
    if mod_path.eq(Str.of("core/target.a")) {
        ret Str.of("import core.target_values: target_os, target_arch, target_ptr_bits\n\nOs :: enum u8 {\n    linux\n    darwin\n    windows\n    wasi\n    freestanding\n}\n\nArch :: enum u8 {\n    x86_64\n    aarch64\n    wasm32\n}\n\nTarget :: struct {\n    os Os\n    arch Arch\n    ptr_bits u8\n}\n\ntarget :: cmpt {\n    profile: Target = .{ os: target_os, arch: target_arch, ptr_bits: target_ptr_bits }\n    profile\n}\n")
    }
    if mod_path.eq(Str.of("core/target_values.a")) {
        ret Str.of("import core.target: Arch, Os\n\ntarget_os :: Os.linux\ntarget_arch :: Arch.x86_64\ntarget_ptr_bits :: 64 as u8\n")
    }
    if mod_path.eq(Str.of("std/allocator.a")) {
        ret Str.of("import std.mem: free, malloc, mem_copy\n\nalign_up :: fn(n u64) u64 {\n    (n + 7) & ~7\n}\n\nArenaChunk :: struct {\n    next_chunk &u8\n    memory     &u8\n    offset     u64\n    cap        u64\n    size :: fn() u64 {\n        32\n    }\n\n    new :: fn(cap u64, next_chunk &u8) &Self {\n        chunk := malloc(ArenaChunk.size()) as &Self\n        mem := malloc(cap)\n\n        (*chunk).next_chunk = next_chunk\n        (*chunk).memory = mem\n        (*chunk).offset = 0\n        (*chunk).cap = cap\n\n        chunk\n    }\n\n}\n\nArena :: struct {\n    current            &ArenaChunk\n    default_chunk_size u64\n    new :: fn(default_chunk_size u64) Arena {\n        first_chunk := ArenaChunk.new(default_chunk_size, 0 as &u8)\n\n        .{ current: first_chunk, default_chunk_size: default_chunk_size }\n    }\n\n    alloc :: fn(self &Self, s u64) &u8 {\n        aligned_size := align_up(s)\n        curr := self.current\n\n        if curr.offset + aligned_size > curr.cap {\n            new_cap := self.default_chunk_size\n\n            if aligned_size > new_cap {\n                new_cap = aligned_size\n            }\n            new_chunk := ArenaChunk.new(new_cap, curr as &u8)\n            self.current = new_chunk\n            curr = new_chunk\n        }\n        ptr := curr.memory + curr.offset\n        curr.offset = curr.offset + aligned_size\n\n        ptr\n    }\n\n    reset :: fn(self &Self) {\n        curr := self.current\n        while (curr as &u8) != (0 as &u8) {\n            curr.offset = 0\n            curr = curr.next_chunk as &ArenaChunk\n        }\n    }\n\n    realloc :: fn(self &Self, old_ptr &u8, old_size u64, new_size u64) &u8 {\n        if new_size <= old_size {\n            ret old_ptr\n        }\n        aligned_old := align_up(old_size)\n        aligned_new := align_up(new_size)\n        curr := self.current\n\n        if (curr != (0 as &ArenaChunk)) and ((*curr).offset >= aligned_old) {\n            last_alloc_ptr := (*curr).memory + ((*curr).offset - aligned_old)\n            if old_ptr == last_alloc_ptr {\n                diff := aligned_new - aligned_old\n                if (*curr).offset + diff <= (*curr).cap {\n                    (*curr).offset = (*curr).offset + diff\n                    ret old_ptr\n                }\n            }\n        }\n        new_ptr := self.alloc(new_size)\n        if (old_ptr != (0 as &u8)) and (old_size > 0) {\n            mem_copy(new_ptr, old_ptr, old_size)\n        }\n        new_ptr\n    }\n\n    destroy :: fn(self &Self) {\n        curr := self.current\n\n        while (curr as &u8) != 0 as &u8 {\n            next_chunk := (*curr).next_chunk as &ArenaChunk\n            free((*curr).memory)\n            free(curr as &u8)\n            curr = next_chunk\n        }\n\n        self.current = 0 as &ArenaChunk\n    }\n}\n\n")
    }
    if mod_path.eq(Str.of("std/ascii.a")) {
        ret Str.of("Ascii :: struct {\n    is_digit :: fn(c u8) bool {\n        (c >= '0') and (c <= '9')\n    }\n\n    is_hex_digit :: fn(c u8) bool {\n        (c >= '0' and c <= '9') or (c >= 'A' and c <= 'F') or (c >= 'a' and c <= 'f')\n    }\n\n    is_bin_digit :: fn(c u8) bool {\n        (c == '0') or (c == '1')\n    }\n\n    is_oct_digit :: fn(c u8) bool {\n        (c >= '0') and (c <= '7')\n    }\n\n    hex_digit_value :: fn(c u8) u32 {\n        if (c >= '0') and (c <= '9') {\n            ret (c - '0') as u32\n        }\n        if (c >= 'a') and (c <= 'f') {\n            ret (c - 'a' + 10) as u32\n        }\n        if (c >= 'A') and (c <= 'F') {\n            ret (c - 'A' + 10) as u32\n        }\n        0\n    }\n\n    is_alpha :: fn(c u8) bool {\n        (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or (c == '_')\n    }\n\n    is_alphanumeric :: fn(c u8) bool {\n        Self.is_alpha(c) or Self.is_digit(c)\n    }\n\n    is_whitespace :: fn(c u8) bool {\n        (c == ' ') or (c == '\\t')\n    }\n\n    is_newline :: fn(c u8) bool {\n        (c == '\\n') or (c == '\\r')\n    }\n\n    to_lower :: fn(c u8) u8 {\n        if (c >= 'A') and (c <= 'Z') {\n            ret (c + 32) as u8\n        }\n        c\n    }\n\n    to_upper :: fn(c u8) u8 {\n        if (c >= 'a') and (c <= 'z') {\n            ret (c - 32) as u8\n        }\n        c\n    }\n}\n\nis_digit :: fn(c u8) bool {\n    Ascii.is_digit(c)\n}\nis_hex_digit :: fn(c u8) bool {\n    Ascii.is_hex_digit(c)\n}\nis_bin_digit :: fn(c u8) bool {\n    Ascii.is_bin_digit(c)\n}\nis_oct_digit :: fn(c u8) bool {\n    Ascii.is_oct_digit(c)\n}\nhex_digit_value :: fn(c u8) u32 {\n    Ascii.hex_digit_value(c)\n}\nis_alpha :: fn(c u8) bool {\n    Ascii.is_alpha(c)\n}\nis_alphanumeric :: fn(c u8) bool {\n    Ascii.is_alphanumeric(c)\n}\nis_whitespace :: fn(c u8) bool {\n    Ascii.is_whitespace(c)\n}\nis_newline :: fn(c u8) bool {\n    Ascii.is_newline(c)\n}\nto_lower :: fn(c u8) u8 {\n    Ascii.to_lower(c)\n}\nto_upper :: fn(c u8) u8 {\n    Ascii.to_upper(c)\n}\n")
    }
    if mod_path.eq(Str.of("std/collections/hash_map.a")) {
        ret Str.of("import std.mem: free, malloc, mem_set\n\nHashMap :: fn(K type, V type) type {\n    struct {\n        keys     &K\n        values   &V\n        occupied &bool\n        len      u64\n        cap      u64\n        new :: fn() Self {\n            Self.with_cap(16)\n        }\n\n        with_cap :: fn(initial_cap u64) Self {\n            cap := initial_cap\n            if cap < 16 {\n                cap = 16\n            }\n            k_mem := malloc(cap * @sizeof(K)) as &K\n            v_mem := malloc(cap * @sizeof(V)) as &V\n            o_mem := malloc(cap * @sizeof(bool)) as &bool\n            mem_set(o_mem as &u8, 0 as u8, cap * @sizeof(bool))\n            .{ keys: k_mem, values: v_mem, occupied: o_mem, len: 0, cap: cap }\n        }\n\n        destroy :: fn(self &Self) {\n            free(self.keys as &u8)\n            free(self.values as &u8)\n            free(self.occupied as &u8)\n            self.keys = 0 as &K\n            self.values = 0 as &V\n            self.occupied = 0 as &bool\n            self.len = 0\n            self.cap = 0\n        }\n\n        hash_key :: fn(val &K) u64 {\n            bytes := val as &u8\n            h: u64 = 14695981039346656037\n            i: u64 = 0\n            while i < @sizeof(K) {\n                byte := *(bytes + i) as u64\n                h = (h ^ byte) * 1099511628211\n                i = i + 1\n            }\n            h\n        }\n\n        keys_equal :: fn(a &K, b &K) bool {\n            pa := a as &u8\n            pb := b as &u8\n            i: u64 = 0\n            while i < @sizeof(K) {\n                if *(pa + i) != *(pb + i) {\n                    ret false\n                }\n                i = i + 1\n            }\n            true\n        }\n\n        contains_key :: fn(self &Self, key K) bool {\n            if self.cap == 0 {\n                ret false\n            }\n            mask := self.cap - 1\n            idx := Self.hash_key(&key) & mask\n            while *(self.occupied + idx) {\n                if Self.keys_equal(self.keys + idx, &key) {\n                    ret true\n                }\n                idx = (idx + 1) & mask\n            }\n            false\n        }\n\n        get :: fn(self &Self, key K) &V {\n            if self.cap == 0 {\n                ret 0 as &V\n            }\n            mask := self.cap - 1\n            idx := Self.hash_key(&key) & mask\n            while *(self.occupied + idx) {\n                if Self.keys_equal(self.keys + idx, &key) {\n                    ret self.values + idx\n                }\n                idx = (idx + 1) & mask\n            }\n            0 as &V\n        }\n\n        insert :: fn(self &Self, key K, val V) bool {\n            if (self.len + 1) * 2 >= self.cap {\n                self.grow()\n            }\n            mask := self.cap - 1\n            idx := Self.hash_key(&key) & mask\n            while *(self.occupied + idx) {\n                if Self.keys_equal(self.keys + idx, &key) {\n                    *(self.values + idx) = val\n                    ret false\n                }\n                idx = (idx + 1) & mask\n            }\n            *(self.keys + idx) = key\n            *(self.values + idx) = val\n            *(self.occupied + idx) = true\n            self.len = self.len + 1\n            true\n        }\n\n        remove :: fn(self &Self, key K) bool {\n            if self.cap == 0 {\n                ret false\n            }\n            mask := self.cap - 1\n            idx := Self.hash_key(&key) & mask\n            while *(self.occupied + idx) {\n                if Self.keys_equal(self.keys + idx, &key) {\n                    *(self.occupied + idx) = false\n                    self.len = self.len - 1\n                    ret true\n                }\n                idx = (idx + 1) & mask\n            }\n            false\n        }\n\n        is_empty :: fn(self &Self) bool {\n            self.len == 0\n        }\n\n        clear :: fn(self &Self) {\n            if self.cap > 0 {\n                mem_set(self.occupied as &u8, 0 as u8, self.cap * @sizeof(bool))\n                self.len = 0\n            }\n        }\n\n        grow :: fn(self &Self) {\n            old_keys := self.keys\n            old_values := self.values\n            old_occ := self.occupied\n            old_cap := self.cap\n\n            new_cap := old_cap * 2\n            self.keys = malloc(new_cap * @sizeof(K)) as &K\n            self.values = malloc(new_cap * @sizeof(V)) as &V\n            self.occupied = malloc(new_cap * @sizeof(bool)) as &bool\n            mem_set(self.occupied as &u8, 0 as u8, new_cap * @sizeof(bool))\n            self.cap = new_cap\n            self.len = 0\n\n            mask := new_cap - 1\n            i: u64 = 0\n            while i < old_cap {\n                if *(old_occ + i) {\n                    k := *(old_keys + i)\n                    v := *(old_values + i)\n                    idx := Self.hash_key(&k) & mask\n                    while *(self.occupied + idx) {\n                        idx = (idx + 1) & mask\n                    }\n                    *(self.keys + idx) = k\n                    *(self.values + idx) = v\n                    *(self.occupied + idx) = true\n                    self.len = self.len + 1\n                }\n                i = i + 1\n            }\n\n            free(old_keys as &u8)\n            free(old_values as &u8)\n            free(old_occ as &u8)\n        }\n    }\n}\n")

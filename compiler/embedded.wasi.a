    if mod_path.eq(Str.of("std/env.a")) {
        ret Str.of("import std.allocator: Arena\nimport std.path:      Path\nimport std.string:    Str, String\n\nimport std.sys:       environment\n\nabyss_process_arg_count :: extern fn() i32\nabyss_process_arg :: extern fn(idx i32) &u8\nabyss_process_args :: extern fn() &&u8\nabyss_process_set_args :: extern fn(argc i32, argv &&u8)\n\nEnv :: struct {\n    args_len :: fn() i32 {\n        abyss_process_arg_count()\n    }\n\n    arg :: fn(idx i32) &u8 {\n        abyss_process_arg(idx)\n    }\n\n    get :: fn(name &u8) &u8 {\n        environment(name)\n    }\n\n    get_or :: fn(name &u8, default_val &u8) &u8 {\n        val := environment(name)\n        if val != (0 as &u8) {\n            ret val\n        }\n        default_val\n    }\n\n    has :: fn(name &u8) bool {\n        environment(name) != (0 as &u8)\n    }\n\n    shift_args :: fn(index i32) {\n        count := Env.args_len()\n        if index > 0 and index < count {\n            abyss_process_set_args(count - index, abyss_process_args() + index)\n        }\n    }\n\n    home_dir :: fn(arena &Arena) Str {\n        h := environment(c\"HOME\")\n        if h != (0 as &u8) {\n            ret Str.of(h)\n        }\n        up := environment(c\"USERPROFILE\")\n        if up != (0 as &u8) {\n            ret Str.of(up)\n        }\n        hd := environment(c\"HOMEDRIVE\")\n        hp := environment(c\"HOMEPATH\")\n        if (hd != (0 as &u8)) and (hp != (0 as &u8)) {\n            out := String.new(arena)\n            out.push_str(Str.of(hd))\n            out.push_str(Str.of(hp))\n            ret out.as_str()\n        }\n        Str.empty()\n    }\n\n    abyss_home :: fn(arena &Arena) Str {\n        inst := environment(c\"ABYSS_INSTALL_DIR\")\n        if inst != (0 as &u8) {\n            ret Str.of(inst)\n        }\n        p := environment(c\"ABYSS_PATH\")\n        if p != (0 as &u8) {\n            ret Str.of(p)\n        }\n        home := Env.home_dir(arena)\n        if home.len > 0 {\n            ret Path.join(arena, home, Str.of(\".abyss\"))\n        }\n        lad := environment(c\"LOCALAPPDATA\")\n        if lad != (0 as &u8) {\n            ret Path.join(arena, Str.of(lad), Str.of(\"abyss\"))\n        }\n        ad := environment(c\"APPDATA\")\n        if ad != (0 as &u8) {\n            ret Path.join(arena, Str.of(ad), Str.of(\"abyss\"))\n        }\n        Str.empty()\n    }\n}\n")
    }
    if mod_path.eq(Str.of("std/fmt.a")) {
        ret Str.of("import std.allocator: Arena\nimport std.convert:   Convert, conversion_error\nimport std.string:    Str, String\nimport std.sys:       write_console\n\nEscape :: struct {\n    reset             &u8\n    bold              &u8\n    dim               &u8\n    italic            &u8\n    underline         &u8\n    blink             &u8\n    reverse           &u8\n    hidden            &u8\n    strike            &u8\n    fg_black          &u8\n    fg_red            &u8\n    fg_green          &u8\n    fg_yellow         &u8\n    fg_blue           &u8\n    fg_magenta        &u8\n    fg_cyan           &u8\n    fg_white          &u8\n    fg_bright_black   &u8\n    fg_bright_red     &u8\n    fg_bright_green   &u8\n    fg_bright_yellow  &u8\n    fg_bright_blue    &u8\n    fg_bright_magenta &u8\n    fg_bright_cyan    &u8\n    fg_bright_white   &u8\n    bg_black          &u8\n    bg_red            &u8\n    bg_green          &u8\n    bg_yellow         &u8\n    bg_blue           &u8\n    bg_magenta        &u8\n    bg_cyan           &u8\n    bg_white          &u8\n    bg_bright_black   &u8\n    bg_bright_red     &u8\n    bg_bright_green   &u8\n    bg_bright_yellow  &u8\n    bg_bright_blue    &u8\n    bg_bright_magenta &u8\n    bg_bright_cyan    &u8\n    bg_bright_white   &u8\n}\n\nescape :: fn() Escape {\n    .{ reset: c\"\\x1b[0m\", bold: c\"\\x1b[1m\", dim: c\"\\x1b[2m\", italic: c\"\\x1b[3m\", underline: c\"\\x1b[4m\", blink: c\"\\x1b[5m\", reverse: c\"\\x1b[7m\", hidden: c\"\\x1b[8m\", strike: c\"\\x1b[9m\", fg_black: c\"\\x1b[30m\", fg_red: c\"\\x1b[31m\", fg_green: c\"\\x1b[32m\", fg_yellow: c\"\\x1b[33m\", fg_blue: c\"\\x1b[34m\", fg_magenta: c\"\\x1b[35m\", fg_cyan: c\"\\x1b[36m\", fg_white: c\"\\x1b[37m\", fg_bright_black: c\"\\x1b[90m\", fg_bright_red: c\"\\x1b[91m\", fg_bright_green: c\"\\x1b[92m\", fg_bright_yellow: c\"\\x1b[93m\", fg_bright_blue: c\"\\x1b[94m\", fg_bright_magenta: c\"\\x1b[95m\", fg_bright_cyan: c\"\\x1b[96m\", fg_bright_white: c\"\\x1b[97m\", bg_black: c\"\\x1b[40m\", bg_red: c\"\\x1b[41m\", bg_green: c\"\\x1b[42m\", bg_yellow: c\"\\x1b[43m\", bg_blue: c\"\\x1b[44m\", bg_magenta: c\"\\x1b[45m\", bg_cyan: c\"\\x1b[46m\", bg_white: c\"\\x1b[47m\", bg_bright_black: c\"\\x1b[100m\", bg_bright_red: c\"\\x1b[101m\", bg_bright_green: c\"\\x1b[102m\", bg_bright_yellow: c\"\\x1b[103m\", bg_bright_blue: c\"\\x1b[104m\", bg_bright_magenta: c\"\\x1b[105m\", bg_bright_cyan: c\"\\x1b[106m\", bg_bright_white: c\"\\x1b[107m\" }\n}\n\nFmt :: struct {\n    buf String\n    new :: fn(arena &Arena) Self {\n        .{ buf: String.new(arena) }\n    }\n\n    str :: fn(self &Self, s Str) &Self {\n        self.buf.push_str(s)\n        ret self\n    }\n\n    cstr :: fn(self &Self, s &u8) &Self {\n        self.str(Str.of(s))\n        ret self\n    }\n\n    char :: fn(self &Self, c u8) &Self {\n        self.buf.push_char(c)\n        ret self\n    }\n\n    uint32 :: fn(self &Self, v u32) &Self {\n        self.buf.push_u32(v)\n        ret self\n    }\n\n    uint64 :: fn(self &Self, v u64) &Self {\n        Convert.unsigned64(&self.buf, v)\n        ret self\n    }\n\n    int32 :: fn(self &Self, v i32) &Self {\n        Convert.signed64(&self.buf, v as i64)\n        ret self\n    }\n\n    boolean :: fn(self &Self, v bool) &Self {\n        Convert.boolean(&self.buf, v)\n        ret self\n    }\n\n    space :: fn(self &Self) &Self {\n        self.buf.push_char(32 as u8)\n        ret self\n    }\n\n    newline :: fn(self &Self) &Self {\n        self.buf.push_char(10 as u8)\n        ret self\n    }\n\n    semi :: fn(self &Self) &Self {\n        self.str(Str.of(\";\\n\"))\n        ret self\n    }\n\n    comma :: fn(self &Self) &Self {\n        self.str(Str.of(\", \"))\n        ret self\n    }\n\n    paren :: fn(self &Self, inner Str) &Self {\n        self.buf.push_char(40 as u8)\n        self.str(inner)\n        self.buf.push_char(41 as u8)\n        ret self\n    }\n\n    wrap :: fn(self &Self, left Str, inner Str, right Str) &Self {\n        self.str(left)\n        self.str(inner)\n        self.str(right)\n        ret self\n    }\n\n    sym :: fn(self &Self, prefix Str, id u32) &Self {\n        self.str(prefix)\n        self.uint32(id)\n        ret self\n    }\n\n    binary :: fn(self &Self, op Str, lhs Str, rhs Str) &Self {\n        self.buf.push_char(40 as u8)\n        self.str(lhs)\n        self.str(op)\n        self.str(rhs)\n        self.buf.push_char(41 as u8)\n        ret self\n    }\n\n    indent :: fn(self &Self, level u32) &Self {\n        i: u32 = 0\n        while i < level {\n            self.str(Str.of(\"    \"))\n            i = i + 1\n        }\n        ret self\n    }\n\n    as_str :: fn(self &Self) Str {\n        self.buf.as_str()\n    }\n\n    print :: fn(self &Self) {\n        write_console(self.buf.as_str())\n    }\n}\n\nformat_code :: fn(pattern Str, info &TypeInfo()) Str {\n    if (info.kind != TypeKind.tuple) and ((info.kind != TypeKind.struct_) or (info.field_count != 0)) {\n        conversion_error(\"[format error] format arguments must be a tuple\\n\")\n    }\n    arena := Arena.new(4096)\n    out := String.new(&arena)\n    text := String.new(&arena)\n    argument: u64 = 0\n    i: u64 = 0\n    while i < pattern.len {\n        c := *(pattern.ptr + i)\n        if (c == '{') or (c == '}') {\n            if (i + 1 < pattern.len) and (*(pattern.ptr + i + 1) == c) {\n                text.push_char(c)\n                i = i + 2\n                cont\n            }\n            if c == '}' {\n                conversion_error(\"[format error] unmatched '}' in format string\\n\")\n            }\n            if (i + 1 >= pattern.len) or (*(pattern.ptr + i + 1) != '}') {\n                conversion_error(\"[format error] expected '{}' placeholder or '{{' escape\\n\")\n            }\n            if argument >= info.field_count {\n                conversion_error(\"[format error] not enough arguments for format string\\n\")\n            }\n            Convert.literal(&out, text.as_str())\n            text.reset(0)\n            field := *(info.fields + argument)\n            expr := String.new(&arena)\n            expr.push_str(\"args.\")\n            expr.push_str(field.name)\n            Convert.value(&out, field.type_info, expr.as_str(), 0)\n            argument = argument + 1\n            i = i + 2\n        } else {\n            text.push_char(c)\n            i = i + 1\n        }\n    }\n    if argument != info.field_count {\n        conversion_error(\"[format error] too many arguments for format string\\n\")\n    }\n    Convert.literal(&out, text.as_str())\n    out.as_str()\n}\n\nfmt :: fn(T type, arena &Arena, cmpt pattern Str, args T) String {\n    out := String.new(arena)\n    #format_code(pattern, @type_info(T))\n    out\n}\n")
    }
    if mod_path.eq(Str.of("std/fs.a")) {
        ret Str.of("import core.maybe:          Maybe\nimport std.allocator:       Arena\nimport std.collections.vec: Vec\nimport std.convert:         Convert\nimport std.mem:             free, malloc\nimport std.path:            Path\nimport std.string:          Str, String\nimport std.sys:             Directory, OpenMode, close_handle, environment, fall, make_directory, open_handle, read_handle, seek_handle, write_all, write_console\n\nSEEK_SET :: fn() i32 {\n    0\n}\nSEEK_CUR :: fn() i32 {\n    1\n}\nSEEK_END :: fn() i32 {\n    2\n}\n\nto_cstr :: fn(a &Arena, s Str) &u8 {\n    buf := a.alloc(s.len + 1)\n    i: u64 = 0\n    while i < s.len {\n        *(buf + i) = *(s.ptr + i)\n        i = i + 1\n    }\n    *(buf + s.len) = 0 as u8\n    buf\n}\n\nstr_to_cstr :: fn(s Str) &u8 {\n    buf := malloc(s.len + 1)\n    i: u64 = 0\n    while i < s.len {\n        *(buf + i) = *(s.ptr + i)\n        i = i + 1\n    }\n    *(buf + s.len) = 0 as u8\n    buf\n}\n\nFileStream :: struct {\n    handle i64\n    opened bool\n    open :: fn(path &u8, mode &u8) Maybe(Self) {\n        parsed := OpenMode.parse(mode)\n        if parsed.is_none() { ret Maybe(Self).none() }\n        handle := open_handle(path, parsed.unwrap())\n        if handle < 0 { ret Maybe(Self).none() }\n        Maybe(Self).some(.{ handle: handle, opened: true })\n    }\n\n    open_read :: fn(path &u8) Maybe(Self) {\n        Self.open(path, c\"rb\")\n    }\n\n    create :: fn(path &u8) Maybe(Self) {\n        Self.open(path, c\"wb\")\n    }\n\n    open_append :: fn(path &u8) Maybe(Self) {\n        Self.open(path, c\"ab\")\n    }\n\n    is_open :: fn(self &Self) bool {\n        self.opened\n    }\n\n    close :: fn(self &Self) bool {\n        if not self.opened { ret false }\n        ok := close_handle(self.handle)\n        self.opened = false\n        ok\n    }\n\n    read :: fn(self &Self, buf &u8, count u64) u64 {\n        if not self.opened { ret 0 }\n        received := read_handle(self.handle, buf, count)\n        if received < 0 { ret 0 }\n        received as u64\n    }\n\n    read_all :: fn(self &Self, a &Arena) Str {\n        if not self.opened { ret Str.empty() }\n        raw_size := seek_handle(self.handle, 0, SEEK_END())\n        if raw_size < 0 or not self.seek_to_start() { ret Str.empty() }\n        file_size := raw_size as u64\n        buf := a.alloc(file_size + 1)\n        if buf == (0 as &u8) { ret Str.empty() }\n        received: u64 = 0\n        while received < file_size {\n            count := read_handle(self.handle, buf + received, file_size - received)\n            if count < 0 { ret Str.empty() }\n            if count == 0 { break }\n            received = received + (count as u64)\n        }\n        buf[received] = 0\n        Str.new(buf, received)\n    }\n\n    write :: fn(self &Self, buf &u8, count u64) u64 {\n        if not self.opened { ret 0 }\n        write_all(self.handle, buf, count)\n    }\n\n    write_str :: fn(self &Self, s Str) bool {\n        if not self.opened {\n            ret false\n        }\n        written := self.write(s.ptr, s.len)\n        written == s.len\n    }\n\n    seek :: fn(self &Self, offset i64, whence i32) bool {\n        if not self.opened {\n            ret false\n        }\n        seek_handle(self.handle, offset, whence) >= 0\n    }\n\n    seek_to_start :: fn(self &Self) bool {\n        self.seek(0, SEEK_SET())\n    }\n\n    seek_to_end :: fn(self &Self) bool {\n        self.seek(0, SEEK_END())\n    }\n\n    tell :: fn(self &Self) i64 {\n        if not self.opened {\n            ret -1\n        }\n        seek_handle(self.handle, 0, SEEK_CUR())\n    }\n\n    size :: fn(self &Self) u64 {\n        if not self.opened { ret 0 }\n        cur := self.tell()\n        if cur < 0 { ret 0 }\n        end := seek_handle(self.handle, 0, SEEK_END())\n        self.seek(cur, SEEK_SET())\n        if end < 0 {\n            ret 0\n        }\n        end as u64\n    }\n}\n\nFile :: struct {\n    open :: fn(path Str, mode &u8) Maybe(FileStream) {\n        c_path := str_to_cstr(path)\n        stream_opt := FileStream.open(c_path, mode)\n        free(c_path)\n        stream_opt\n    }\n\n    open_read :: fn(path Str) Maybe(FileStream) {\n        c_path := str_to_cstr(path)\n        stream_opt := FileStream.open_read(c_path)\n        free(c_path)\n        stream_opt\n    }\n\n    create :: fn(path Str) Maybe(FileStream) {\n        c_path := str_to_cstr(path)\n        stream_opt := FileStream.create(c_path)\n        free(c_path)\n        stream_opt\n    }\n\n    open_append :: fn(path Str) Maybe(FileStream) {\n        c_path := str_to_cstr(path)\n        stream_opt := FileStream.open_append(c_path)\n        free(c_path)\n        stream_opt\n    }\n\n    read_to_string :: fn(a &Arena, path Str) Maybe(Str) {\n        c_path := to_cstr(a, path)\n        stream_opt := FileStream.open_read(c_path)\n        if stream_opt.is_none() {\n            ret Maybe(Str).none()\n        }\n        stream := stream_opt.unwrap()\n        res := stream.read_all(a)\n        stream.close()\n        if res.ptr == (0 as &u8) { ret Maybe(Str).none() }\n        Maybe(Str).some(res)\n    }\n\n    write_string :: fn(path Str, content Str) bool {\n        stream_opt := File.create(path)\n        if stream_opt.is_none() {\n            ret false\n        }\n        stream := stream_opt.unwrap()\n        ok := stream.write_str(content)\n        stream.close() and ok\n    }\n\n    append_string :: fn(path Str, content Str) bool {\n        stream_opt := File.open_append(path)\n        if stream_opt.is_none() {\n            ret false\n        }\n        stream := stream_opt.unwrap()\n        ok := stream.write_str(content)\n        stream.close() and ok\n    }\n\n    exists :: fn(path Str) bool {\n        stream_opt := File.open_read(path)\n        if stream_opt.is_some() {\n            stream := stream_opt.unwrap()\n            stream.close()\n            ret true\n        }\n        false\n    }\n\n    size :: fn(path Str) u64 {\n        stream_opt := File.open_read(path)\n        if stream_opt.is_some() {\n            stream := stream_opt.unwrap()\n            s := stream.size()\n            stream.close()\n            ret s\n        }\n        0\n    }\n}\n\nread_file :: fn(a &Arena, path &u8) Str {\n    source := try_read_file(a, path)\n    if source.ptr == (0 as &u8) {\n        write_console(Str.of(\"\\n\\x1b[1;31merror:\\x1b[0m cannot open file '\"))\n        write_console(Str.of(path))\n        write_console(\"': file not found or permission denied\\n\")\n        fall()\n    }\n    source\n}\n\ntry_read_file :: fn(a &Arena, path &u8) Str {\n    opt := File.read_to_string(a, Str.of(path))\n    if opt.is_some() {\n        ret opt.unwrap()\n    }\n    Str.empty()\n}\n\nwrite_file :: fn(path &u8, content Str) bool {\n    ok := File.write_string(Str.of(path), content)\n    if not ok {\n        write_console(Str.of(\"\\n\\x1b[1;31merror:\\x1b[0m failed to write file '\"))\n        write_console(Str.of(path))\n        write_console(\"'\\n\")\n        fall()\n    }\n    true\n}\n\nappend_file :: fn(path &u8, content Str) bool {\n    ok := File.append_string(Str.of(path), content)\n    if not ok {\n        write_console(Str.of(\"\\n\\x1b[1;31merror:\\x1b[0m failed to append to file '\"))\n        write_console(Str.of(path))\n        write_console(\"'\\n\")\n        fall()\n    }\n    true\n}\n\nfile_exists :: fn(path &u8) bool {\n    File.exists(Str.of(path))\n}\n\nDirEntryKind :: enum u8 {\n    unknown\n    file\n    directory\n}\n\nDirEntry :: struct {\n    name Str\n    kind DirEntryKind\n    is_file :: fn(self &Self) bool {\n        self.kind == DirEntryKind.file\n    }\n    is_dir :: fn(self &Self) bool {\n        self.kind == DirEntryKind.directory\n    }\n}\n\nDirStream :: struct {\n    directory Directory\n\n    open :: fn(path &u8) Maybe(Self) {\n        result := Directory.open(path)\n        if result.is_none() { ret Maybe(Self).none() }\n        Maybe(Self).some(.{ directory: result.unwrap() })\n    }\n\n    close :: fn(self &Self) bool { self.directory.close() }\n\n    next :: fn(self &Self) Maybe(DirEntry) {\n        while true {\n            result := self.directory.next()\n            if result.is_none() { ret Maybe(DirEntry).none() }\n            entry := result.unwrap()\n            if entry.name.eq(\".\") or entry.name.eq(\"..\") { cont }\n            ret Maybe(DirEntry).some(.{ name: entry.name, kind: entry.kind as DirEntryKind })\n        }\n        Maybe(DirEntry).none()\n    }\n}\n\nDir :: struct {\n    create :: fn(path &u8) bool {\n        make_directory(path)\n    }\n\n    open :: fn(path &u8) Maybe(DirStream) {\n        DirStream.open(path)\n    }\n\n    exists :: fn(path &u8) bool {\n        stream_opt := DirStream.open(path)\n        if stream_opt.is_some() {\n            stream := stream_opt.unwrap()\n            stream.close()\n            ret true\n        }\n        false\n    }\n\n    is_directory :: fn(path &u8) bool {\n        Dir.exists(path)\n    }\n\n    walk :: fn(a &Arena, root Str, ext Str) Vec(Str) {\n        out := Vec(Str).new()\n        Dir.collect_entries(a, &out, Str.empty(), root, ext)\n        out\n    }\n\n    collect_entries :: fn(a &Arena, out &Vec(Str), base_prefix Str, rel_dir Str, ext Str) {\n        full_dir := if base_prefix.len > 0 {\n            Path.join(a, base_prefix, rel_dir)\n        } else {\n            rel_dir\n        }\n        c_dir := to_cstr(a, full_dir)\n        d_opt := DirStream.open(c_dir)\n        if d_opt.is_none() {\n            ret\n        }\n        d := d_opt.unwrap()\n        for entry in d {\n            full_child := Path.join(a, full_dir, entry.name)\n            rel_child := Path.join(a, rel_dir, entry.name)\n            c_child := to_cstr(a, full_child)\n            if Dir.exists(c_child) {\n                Dir.collect_entries(a, out, base_prefix, rel_child, ext)\n            } else if (ext.len == 0) or entry.name.ends_with(ext) {\n                out.push(rel_child)\n            }\n        }\n        d.close()\n    }\n}\n\nstr_less :: fn(a Str, b Str) bool {\n    min_len := if a.len < b.len {\n        a.len\n    } else {\n        b.len\n    }\n    i: u64 = 0\n    while i < min_len {\n        ca := *(a.ptr + i)\n        cb := *(b.ptr + i)\n        if ca < cb {\n            ret true\n        }\n        if ca > cb {\n            ret false\n        }\n        i = i + 1\n    }\n    a.len < b.len\n}\n\nsort_strings :: fn(v &Vec(Str)) {\n    i: u64 = 0\n    while i < v.len {\n        j := i + 1\n        while j < v.len {\n            if str_less(v.get(j), v.get(i)) {\n                tmp := v.get(i)\n                v.set(i, v.get(j))\n                v.set(j, tmp)\n            }\n            j = j + 1\n        }\n        i = i + 1\n    }\n}\n\nEmbed :: struct {\n    tree :: fn(a &Arena, root Str, ext Str) Str {\n        files := Dir.walk(a, root, ext)\n        sort_strings(&files)\n        out := String.new(a)\n        out.push_str(\"{\\n\")\n        i: u64 = 0\n        while i < files.len {\n            p := files.get(i)\n            c_p := to_cstr(a, p)\n            content := read_file(a, c_p)\n            out.push_str(\"    if path.eq(Str.of(\")\n            Convert.quote_source(&out, p)\n            out.push_str(\")) { ret Str.of(\")\n            Convert.quote_source(&out, content)\n            out.push_str(\") }\\n\")\n            i = i + 1\n        }\n        out.push_str(\"    Str.empty()\\n}\")\n        out.as_str()\n    }\n\n    file :: fn(a &Arena, path Str) Str {\n        c_p := to_cstr(a, path)\n        content := read_file(a, c_p)\n        out := String.new(a)\n        out.push_str(\"Str.of(\")\n        Convert.quote_source(&out, content)\n        out.push_str(\")\")\n        out.as_str()\n    }\n\n    sources :: fn(a &Arena) Str {\n        pods_prefix := if Dir.exists(c\"pods\") {\n            Str.of(\"pods\")\n        } else {\n            root_prefix := Str.empty()\n            env_dev := environment(c\"ABYSS_DEV\")\n            if env_dev != (0 as &u8) {\n                dev_str := Str.of(env_dev)\n                if (not dev_str.eq(Str.of(\"1\"))) and (not dev_str.eq(Str.of(\"true\"))) {\n                    root_prefix = dev_str\n                }\n            }\n            if root_prefix.len > 0 {\n                Path.join(a, root_prefix, Str.of(\"pods\"))\n            } else {\n                Str.of(\"pods\")\n            }\n        }\n        files := Vec(Str).new()\n        Dir.collect_entries(a, &files, pods_prefix, Str.of(\"core\"), Str.of(\".a\"))\n        Dir.collect_entries(a, &files, pods_prefix, Str.of(\"std\"), Str.of(\".a\"))\n        sort_strings(&files)\n\n        out := String.new(a)\n        out.push_str(\"fn(mod_path Str) Str {\\n\")\n        i: u64 = 0\n        while i < files.len {\n            rel_p := files.get(i)\n            is_test_or_vendor := rel_p.starts_with(\".vendor/\") or rel_p.starts_with(\"std/.vendor/\") or rel_p.starts_with(\"core/tests/\") or rel_p.starts_with(\"std/tests/\")\n            if not is_test_or_vendor {\n                full_p := Path.join(a, pods_prefix, rel_p)\n                c_full := to_cstr(a, full_p)\n                content := read_file(a, c_full)\n                out.push_str(\"    if mod_path.eq(Str.of(\")\n                Convert.quote_source(&out, rel_p)\n                out.push_str(\")) {\\n        ret Str.of(\")\n                Convert.quote_source(&out, content)\n                out.push_str(\")\\n    }\\n\")\n            }\n            i = i + 1\n        }\n        out.push_str(\"    Str.empty()\\n}\")\n        out.as_str()\n    }\n}\n")

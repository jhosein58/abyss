(128 | (cp & 63)) as u8\n            self.len = self.len + 4\n        }\n    }\n\n    push_str :: fn(self &Self, s Str) {\n        if s.len == 0 {\n            ret\n        }\n        self.reserve(self.len + s.len)\n        mem_copy(self.ptr + self.len, s.ptr, s.len)\n        self.len = self.len + s.len\n    }\n\n    as_str :: fn(self &Self) Str {\n        Str.new(self.ptr, self.len)\n    }\n\n    len :: fn(self &Self) u64 {\n        self.len\n    }\n\n    mark :: fn(self &Self) u64 {\n        self.len\n    }\n\n    reset :: fn(self &Self, mark u64) {\n        self.len = mark\n    }\n\n    ptr_at :: fn(self &Self, offset u64) &u8 {\n        self.ptr + offset\n    }\n\n    push_u32 :: fn(self &Self, val u32) {\n        Convert.unsigned64(self, val as u64)\n    }\n\n    append :: fn(self &Self, value Str) &Self {\n        self.push_str(value)\n        self\n    }\n\n    append_u32 :: fn(self &Self, value u32) &Self {\n        self.push_u32(value)\n        self\n    }\n}\n\nparse_u32 :: fn(s Str) Maybe(u32) {\n    if s.len == 0 {\n        ret Maybe(u32).none()\n    }\n    res: u32 = 0\n    i: u64 = 0\n    base: u32 = 10\n    if s.len >= 2 {\n        if *(s.ptr) == '0' {\n            pref := *(s.ptr + 1)\n            if (pref == 'x') or (pref == 'X') {\n                base = 16\n                i = 2\n            } else if (pref == 'b') or (pref == 'B') {\n                base = 2\n                i = 2\n            } else if (pref == 'o') or (pref == 'O') {\n                base = 8\n                i = 2\n            }\n        }\n    }\n    if i == s.len {\n        ret Maybe(u32).none()\n    }\n    while i < s.len {\n        c := *(s.ptr + i)\n        if c == 95 {\n            i = i + 1\n            cont\n        }\n        digit: u32 = 16\n        if (c >= 48) and (c <= 57) {\n            digit = (c - 48) as u32\n        }\n        if (c >= 65) and (c <= 70) {\n            digit = (c - 65) as u32 + 10\n        }\n        if (c >= 97) and (c <= 102) {\n            d
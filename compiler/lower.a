import Nexus from "./nexus/nexus"
import HirTable, hir_kind, hir_none, HirExprKind from "./hir"
import id_none from "./nexus/pool"
import Str from "std/string"
import Arena from "std/allocator"
import TypeStorage, TyKind, ty_id_none, ty_id_type, ty_id_unit, ty_id_bool from "./types"
import topo_sort from "./topo_sort"
import fall from "std/sys"
import type_has_infer, tyck_mono_function, finalize_inferred_types from "./typer/tyck"
import func_has_self from "./typer/rules/fn"
import Engine from "./engine"

print :: fn(s &u8) unit

get_node_type :: fn(db &Nexus, id u32) u32 {
    db.get_node_type(id)
}

iterator_is_ref :: fn(db &Nexus, ty_id u32) bool {
    types := &db.types
    if (ty_id == ty_id_none()) or (types.kind(ty_id) != TyKind.nominal) { ret false }
    name_id := db.interner.intern(Str.of("RefIterator"))
    ref_sym := db.find_symbol(db.core_prelude, name_id)
    origin := types.nominal_origin(ty_id)
    creator := types.get_nominal_creator_sym(origin)
    if ref_sym == id_none() { ret false }
    db.resolve_sym(creator) == db.resolve_sym(ref_sym)
}

is_lvalue :: fn(db &Nexus, id u32) bool {
    kind := db.hir.kind(id)
    if kind == hir_kind.ident { ret db.get_node_type(id) != ty_id_type() }
    if kind == hir_kind.unary_deref { ret true }
    if kind == hir_kind.struct_init { ret true }
    if kind == hir_kind.member {
        lhs := db.hir.lhs(id)
        if lhs == hir_none() { ret true }
        if db.types.kind(db.get_node_type(lhs)) == TyKind.ptr { ret true }
        ret is_lvalue(db, lhs)
    }
    false
}

add_type_to_queue :: fn(db &Nexus, ty_id u32, queue &Vec(u32)) {
    if ty_id == ty_id_none() { ret }
    if type_has_infer(&db.types, ty_id) { ret }
    kind := db.types.kind(ty_id)

    if (kind == TyKind.struct_) or (kind == TyKind.nominal) {
        if not queue.contains(ty_id) {
            queue.push(ty_id)
            fields := db.types.get_struct_fields(ty_id)
            count := fields.len / 2
            i: u64 = 0
            while i < count {
                f_ty := *(fields.ptr + (i * 2) + 1)
                add_type_to_queue(db, f_ty, queue)
                i = i + 1
            }
        }
    } else if kind == TyKind.ptr {
        inner := db.types.payload(ty_id)
        add_type_to_queue(db, inner, queue)
    } else if kind == TyKind.func {
        if not queue.contains(ty_id) {
            queue.push(ty_id)
            ret_ty := db.types.func_return(ty_id)
            add_type_to_queue(db, ret_ty, queue)
            params := db.types.func_params(ty_id)
            i: u64 = 0
            while i < params.len {
                add_type_to_queue(db, *(params.ptr + i), queue)
                i = i + 1
            }
        }
    } else if kind == TyKind.union_ {
        if not queue.contains(ty_id) {
            queue.push(ty_id)
            members := db.types.union_members(ty_id)
            i: u64 = 0
            while i < members.len {
                add_type_to_queue(db, *(members.ptr + i), queue)
                i = i + 1
            }
        }
    } else if kind == TyKind.enum_ {
        if not queue.contains(ty_id) {
            queue.push(ty_id)
            backing := db.types.enum_backing(ty_id)
            add_type_to_queue(db, backing, queue)
        }
    }
}

resolve_call_symbol :: fn(db &Nexus, id u32, callee_id u32, queue &Vec(u32)) u32 {
    target_sym := db.get_hir_symbol(callee_id)
    if (target_sym == id_none()) and (db.hir.kind(callee_id) == hir_kind.function) {
        target_sym = db.get_hir_symbol(callee_id)
    }
    if target_sym != id_none() {
        target_sym = db.resolve_sym(target_sym)
    }
    if target_sym == id_none() {
        ret id_none()
    }
    mono_func_ty := db.get_const_type(id)
    if mono_func_ty != ty_id_none() {
        mono_sym := db.find_mono_sym(target_sym, mono_func_ty)
        if mono_sym == id_none() {
            mono_sym = db.alloc_mono_sym(target_sym, mono_func_ty)
        }
        if not queue.contains(mono_sym) {
            queue.push(mono_sym)
        }
        ret mono_sym
    }
    if not queue.contains(target_sym) {
        queue.push(target_sym)
    }
    target_sym
}

emit_method_receiver :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, id u32, callee_id u32, call_sym u32, visited &HashSet(u32), queue &Vec(u32), type_queue &Vec(u32)) V {
    if db.hir.kind(callee_id) != hir_kind.member { ret empty }
    callee_lhs := db.hir.lhs(callee_id)
    lhs_ty := db.get_node_type(callee_lhs)
    if (lhs_ty == ty_id_none()) or (lhs_ty == ty_id_type()) { ret empty }
    target_sym := call_sym
    if target_sym == id_none() { target_sym = db.get_hir_symbol(callee_id) }
    if target_sym == id_none() { ret empty }
    real_sym := db.resolve_sym(target_sym)
    func_node := db.get_fn_node(real_sym)
    if not func_has_self(db, func_node) { ret empty }

    func_ty := ty_id_none()
    if (call_sym != id_none()) and db.is_mono_sym(call_sym) {
        func_ty = db.get_mono_type(call_sym)
    }
    if func_ty == ty_id_none() { func_ty = db.get_const_type(id) }
    if func_ty == ty_id_none() { func_ty = db.get_node_type(callee_id) }
    if func_ty == ty_id_none() { func_ty = db.get_node_type(func_node) }
    if (func_ty == ty_id_none()) or (db.types.kind(func_ty) != TyKind.func) { ret empty }
    params := db.types.func_params(func_ty)
    if params.len == 0 { ret empty }
    p0_ty := *(params.ptr + 0)

    p_depth: u32 = 0
    t_p := p0_ty
    while db.types.kind(t_p) == TyKind.ptr {
        t_p = db.types.payload(t_p)
        p_depth = p_depth + 1
    }

    r_depth: u32 = 0
    t_r := lhs_ty
    while db.types.kind(t_r) == TyKind.ptr {
        t_r = db.types.payload(t_r)
        r_depth = r_depth + 1
    }

    lhs_val := lower_expr(db, ccg, builder, empty, arena, callee_lhs, visited, queue, type_queue)
    curr_ty := lhs_ty
    is_lv := is_lvalue(db, callee_lhs)
    while r_depth < p_depth {
        if not is_lv {
            add_type_to_queue(db, curr_ty, type_queue)
            ty_str := ccg.type_str(&db.types, arena, curr_ty)
            lhs_val = ccg.expr_address_of_value(arena, ty_str, lhs_val)
        } else {
            lhs_val = ccg.expr_address(arena, lhs_val)
        }
        curr_ty = db.types.alloc_ptr(curr_ty)
        is_lv = false
        r_depth = r_depth + 1
    }
    while r_depth > p_depth {
        lhs_val = ccg.expr_deref(arena, lhs_val)
        curr_ty = db.types.payload(curr_ty)
        is_lv = true
        r_depth = r_depth - 1
    }
    lhs_val
}

lower_builtin_call :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, id u32, visited &HashSet(u32), queue &Vec(u32), type_queue &Vec(u32)) V {
    name_id := db.hir.lhs(id)
    name := db.interner.get(name_id)
    args := db.get_list(db.hir.rhs(id))

    if name.eq(Str.of("sizeof")) {
        target_ty := db.get_const_type(id)
        add_type_to_queue(db, target_ty, type_queue)
        t_str := ccg.type_str(&db.types, arena, target_ty)
        ret ccg.expr_sizeof(arena, t_str)
    }

    if name.eq(Str.of("typeof")) {
        ret empty
    }

    if name.eq(Str.of("is")) {
        val_node := *(args.ptr + 0)
        target_ty := db.get_const_type(id)
        val_ty := db.get_node_type(val_node)
        if db.types.kind(val_ty) == TyKind.union_ {
            if not db.types.union_contains(val_ty, target_ty) {
                ret ccg.expr_bool(false)
            }
            tag_idx := db.types.union_member_index(val_ty, target_ty)
            val_str := lower_expr(db, ccg, builder, empty, arena, val_node, visited, queue, type_queue)
            ret ccg.expr_union_is(arena, val_str, tag_idx)
        }
        if val_ty == target_ty {
            ret ccg.expr_bool(true)
        }
        ret ccg.expr_bool(false)
    }

    if name.eq(Str.of("tag")) {
        val_node := *(args.ptr + 0)
        val_str := lower_expr(db, ccg, builder, empty, arena, val_node, visited, queue, type_queue)
        ret ccg.expr_union_tag(arena, val_str)
    }

    empty
}

lower_expr_node :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, id u32, visited &HashSet(u32), queue &Vec(u32), type_queue &Vec(u32)) V {
    match db.hir.kind(id) {
        builtin_call { ret lower_builtin_call(db, ccg, builder, empty, arena, id, visited, queue, type_queue) }
        lit_int { ret ccg.expr_int(arena, db.hir.lhs(id)) }
        lit_float { ret ccg.expr_float(db.interner.get(db.hir.lhs(id))) }
        lit_bool_true { ret ccg.expr_bool(true) }
        lit_bool_false { ret ccg.expr_bool(false) }
        lit_char { ret ccg.expr_char_lit(arena, db.interner.get(db.hir.lhs(id))) }
        lit_cstr { ret ccg.expr_cstr_lit(arena, db.interner.get(db.hir.lhs(id))) }
        lit_str {
            raw := db.interner.get(db.hir.lhs(id))
            str_ty := db.str_type
            if str_ty == ty_id_none() { str_ty = db.get_node_type(id) }
            struct_name := empty
            ptr_id: u32 = 0
            len_id: u32 = 0
            if str_ty != ty_id_none() {
                add_type_to_queue(db, str_ty, type_queue)
                struct_name = ccg.type_str(&db.types, arena, str_ty)
                ptr_id = db.interner.intern(Str.of("ptr"))
                len_id = db.interner.intern(Str.of("len"))
            }
            ret ccg.expr_str_lit(arena, struct_name, ptr_id, len_id, raw)
        }
        function {
            body_id := db.hir.extra(id)
            if body_id == hir_none() { ret empty }
            func_ty := db.get_node_type(id)
            add_type_to_queue(db, func_ty, type_queue)
            sym_id := db.get_hir_symbol(id)
            if sym_id != id_none() {
                if not db.types.func_has_type_param(func_ty) {
                    if not queue.contains(sym_id) { queue.push(sym_id) }
                }
                ret ccg.sym_name(arena, sym_id)
            }
            ret empty
        }
        ident {
            ty := db.get_node_type(id)
            if ty == ty_id_type() { ret empty }
            sym_id := db.get_hir_symbol(id)
            if db.types.kind(ty) == TyKind.func {
                if sym_id != id_none() {
                    real_sym := db.resolve_sym(sym_id)
                    if not db.types.func_has_type_param(ty) {
                        if not queue.contains(real_sym) { queue.push(real_sym) }
                    }
                    if db.types.func_is_extern(ty) and (db.sym_tok_start.get(real_sym) != id_none()) {
                        ret ccg.extern_name(db.interner.get(db.sym_names.get(real_sym)))
                    }
                    ret ccg.sym_name(arena, real_sym)
                }
            }
            if sym_id != id_none() {
                real_sym := db.resolve_sym(sym_id)
                if db.sym_tok_start.get(real_sym) != id_none() {
                    print(c"\n[codegen error] unsupported global value\n       --> ")
                    db.print_loc(id)
                    print(c"\n")
                    fall()
                }
                ret ccg.sym_name(arena, sym_id)
            }
            print(c"\n[codegen error] undefined identifier\n       --> ")
            db.print_loc(id)
            print(c"\n")
            fall()
            ret empty
        }
        var {
            ident_id := db.hir.lhs(id)
            val_id := db.hir.extra(id)
            sym_id := db.get_hir_symbol(ident_id)
            var_ty := db.get_node_type(ident_id)
            if (var_ty == ty_id_type()) or db.types.func_has_type_param(var_ty) { ret empty }
            if db.types.kind(var_ty) == TyKind.unit {
                print(c"\n[type error] variable cannot have unit type\n       --> ")
                db.print_loc(id)
                print(c"\n")
                fall()
            }
            ty_str := ccg.type_str(&db.types, arena, var_ty)
            var_name := ccg.sym_name(arena, sym_id)
            if val_id != hir_none() {
                val_str := lower_expr(db, ccg, builder, empty, arena, val_id, visited, queue, type_queue)
                if not ccg.has_value(val_str) {
                    print(c"\n[codegen error] initializer does not produce a value\n       --> ")
                    db.print_loc(id)
                    print(c"\n")
                    fall()
                }
                ccg.create_variable(var_name, ty_str, val_str, true)
            } else {
                ccg.create_variable(var_name, ty_str, empty, false)
            }
            add_type_to_queue(db, var_ty, type_queue)
            ret empty
        }
        binary_assign {
            lhs_str := lower_expr(db, ccg, builder, empty, arena, db.hir.lhs(id), visited, queue, type_queue)
            rhs_str := lower_expr(db, ccg, builder, empty, arena, db.hir.rhs(id), visited, queue, type_queue)
            ret ccg.expr_assign(arena, lhs_str, rhs_str)
        }
        binary_add, binary_sub, binary_mul, binary_div, binary_mod,
        binary_eq_eq, binary_neq, binary_lt, binary_gt, binary_lt_eq, binary_gt_eq,
        binary_bit_and, binary_bit_or, binary_bit_xor, binary_shl, binary_shr {
            lhs_val := lower_expr(db, ccg, builder, empty, arena, db.hir.lhs(id), visited, queue, type_queue)
            rhs_val := lower_expr(db, ccg, builder, empty, arena, db.hir.rhs(id), visited, queue, type_queue)
            ret ccg.expr_binary_kind(arena, db.hir.kind(id), lhs_val, rhs_val)
        }
        binary_and {
            ty_str := ccg.type_str(&db.types, arena, ty_id_bool())
            temp_var := ccg.new_temp(arena, ty_str)
            lhs_val := lower_expr(db, ccg, builder, empty, arena, db.hir.lhs(id), visited, queue, type_queue)
            ccg.start_if(lhs_val)
            rhs_val := lower_expr(db, ccg, builder, empty, arena, db.hir.rhs(id), visited, queue, type_queue)
            if ccg.has_value(rhs_val) {
                ccg.expr(ccg.expr_assign(arena, temp_var, rhs_val))
            }
            ccg.end_block()
            ret temp_var
        }
        binary_or {
            ty_str := ccg.type_str(&db.types, arena, ty_id_bool())
            temp_var := ccg.new_temp(arena, ty_str)
            lhs_val := lower_expr(db, ccg, builder, empty, arena, db.hir.lhs(id), visited, queue, type_queue)
            ccg.start_if(lhs_val)
            ccg.expr(ccg.expr_assign(arena, temp_var, ccg.expr_bool(true)))
            ccg.else_()
            rhs_val := lower_expr(db, ccg, builder, empty, arena, db.hir.rhs(id), visited, queue, type_queue)
            if ccg.has_value(rhs_val) {
                ccg.expr(ccg.expr_assign(arena, temp_var, rhs_val))
            }
            ccg.end_block()
            ret temp_var
        }
        call {
            callee_id := db.hir.lhs(id)
            if db.get_node_type(id) == ty_id_type() { ret empty }
            call_sym := resolve_call_symbol(db, id, callee_id, queue)
            callee_str := ccg.sym_name(arena, call_sym)
            if call_sym == id_none() {
                callee_str = lower_expr(db, ccg, builder, empty, arena, callee_id, visited, queue, type_queue)
            } else if db.types.func_is_extern(db.get_node_type(callee_id)) and (db.sym_tok_start.get(call_sym) != id_none()) {
                callee_str = ccg.extern_name(db.interner.get(db.sym_names.get(call_sym)))
            }
            args_fmt := builder.new_list(arena)
            first_arg := true
            rec_str := emit_method_receiver(db, ccg, builder, empty, arena, id, callee_id, call_sym, visited, queue, type_queue)
            if ccg.has_value(rec_str) {
                builder.append_list_item(&args_fmt, rec_str, first_arg)
                first_arg = false
            }
            if db.hir.rhs(id) != hir_none() {
                args := db.get_list(db.hir.rhs(id))
                i: u64 = 0
                while i < args.len {
                    arg_node := *(args.ptr + i)
                    i = i + 1
                    if db.get_node_type(arg_node) == ty_id_type() { cont }
                    builder.append_list_item(&args_fmt, lower_expr(db, ccg, builder, empty, arena, arg_node, visited, queue, type_queue), first_arg)
                    first_arg = false
                }
            }
            ret ccg.expr_call(arena, callee_str, builder.finish_list(&args_fmt))
        }
        block {
            ret lower_scoped_expr(db, ccg, builder, empty, arena, id, db.get_node_type(id), visited, queue, type_queue)
        }
        unary_neg {
            child_v := lower_expr(db, ccg, builder, empty, arena, db.hir.lhs(id), visited, queue, type_queue)
            ret ccg.expr_neg(arena, child_v)
        }
        unary_not {
            child_v := lower_expr(db, ccg, builder, empty, arena, db.hir.lhs(id), visited, queue, type_queue)
            ret ccg.expr_not(arena, child_v)
        }
        unary_bit_not {
            child_v := lower_expr(db, ccg, builder, empty, arena, db.hir.lhs(id), visited, queue, type_queue)
            ret ccg.expr_bit_not(arena, child_v)
        }
        unary_addr_of {
            lhs_node := db.hir.lhs(id)
            child_v := lower_expr(db, ccg, builder, empty, arena, lhs_node, visited, queue, type_queue)
            if not is_lvalue(db, lhs_node) {
                ty := db.get_node_type(lhs_node)
                add_type_to_queue(db, ty, type_queue)
                ty_str := ccg.type_str(&db.types, arena, ty)
                ret ccg.expr_address_of_value(arena, ty_str, child_v)
            }
            ret ccg.expr_address(arena, child_v)
        }
        unary_deref {
            lhs_node := db.hir.lhs(id)
            child_v := lower_expr(db, ccg, builder, empty, arena, lhs_node, visited, queue, type_queue)
            child_ty := db.get_node_type(lhs_node)
            if (child_ty != ty_id_none()) and (child_ty == db.str_type) {
                ptr_id := db.interner.intern(Str.of("ptr"))
                ret ccg.expr_str_deref(arena, child_v, ptr_id)
            }
            ret ccg.expr_deref(arena, child_v)
        }
        k_break {
            ccg.emit_break(arena)
            ret empty
        }
        k_cont {
            ccg.emit_cont(arena)
            ret empty
        }
        cast {
            lhs_node := db.hir.lhs(id)
            lhs_ty := db.get_node_type(lhs_node)
            if db.types.kind(lhs_ty) == TyKind.union_ {
                target_ty := db.get_const_type(db.hir.rhs(id))
                member_idx := db.types.union_member_index(lhs_ty, target_ty)
                lhs_v := lower_expr(db, ccg, builder, empty, arena, lhs_node, visited, queue, type_queue)
                ret ccg.expr_union_member(arena, lhs_v, member_idx)
            }
            lhs_v := lower_expr(db, ccg, builder, empty, arena, lhs_node, visited, queue, type_queue)
            ty_str := ccg.type_str(&db.types, arena, db.get_const_type(db.hir.rhs(id)))
            ret ccg.expr_cast(arena, ty_str, lhs_v)
        }
        k_if {
            if_ty := db.get_node_type(id)
            elseb_id := db.hir.extra(id)
            is_expr := (elseb_id != hir_none()) and (if_ty != ty_id_none()) and
                       (db.types.kind(if_ty) != TyKind.unit) and
                       (db.types.kind(if_ty) != TyKind.never)
            if is_expr {
                add_type_to_queue(db, if_ty, type_queue)
                ty_str := ccg.type_str(&db.types, arena, if_ty)
                temp_var := ccg.new_temp(arena, ty_str)
                cond_str := lower_expr(db, ccg, builder, empty, arena, db.hir.lhs(id), visited, queue, type_queue)
                ccg.start_if(cond_str)
                then_val := lower_body(db, ccg, builder, empty, arena, db.hir.rhs(id), visited, queue, type_queue)
                if ccg.has_value(then_val) {
                    ccg.expr(ccg.expr_assign(arena, temp_var, then_val))
                }
                ccg.else_()
                else_val := lower_body(db, ccg, builder, empty, arena, elseb_id, visited, queue, type_queue)
                if ccg.has_value(else_val) {
                    ccg.expr(ccg.expr_assign(arena, temp_var, else_val))
                }
                ccg.end_block()
                ret temp_var
            }
            cond_str := lower_expr(db, ccg, builder, empty, arena, db.hir.lhs(id), visited, queue, type_queue)
            ccg.start_if(cond_str)
            then_val := lower_body(db, ccg, builder, empty, arena, db.hir.rhs(id), visited, queue, type_queue)
            if ccg.has_value(then_val) { ccg.expr(then_val) }
            if elseb_id != hir_none() {
                ccg.else_()
                else_val := lower_body(db, ccg, builder, empty, arena, elseb_id, visited, queue, type_queue)
                if ccg.has_value(else_val) { ccg.expr(else_val) }
            }
            ccg.end_block()
            ret empty
        }
        k_match { ret lower_match(db, ccg, builder, empty, arena, id, visited, queue, type_queue) }
        k_for { ret lower_for(db, ccg, builder, empty, arena, id, visited, queue, type_queue) }
        k_while {
            scope := ccg.begin_loop(id)
            ccg.start_loop(arena, &scope)
            condition := lower_expr(db, ccg, builder, empty, arena, db.hir.lhs(id), visited, queue, type_queue)
            ccg.start_if(ccg.expr_not(arena, condition))
            ccg.break_statement()
            ccg.end_block()
            body := lower_body(db, ccg, builder, empty, arena, db.hir.rhs(id), visited, queue, type_queue)
            if ccg.has_value(body) { ccg.expr(body) }
            ccg.end_loop(arena, &scope)
            ret empty
        }
        k_ret {
            val_id := db.hir.lhs(id)
            if val_id != hir_none() {
                val_str := lower_expr(db, ccg, builder, empty, arena, val_id, visited, queue, type_queue)
                ccg.gen_return(val_str, true)
            } else {
                ccg.gen_return(empty, false)
            }
            ret empty
        }
        struct_init {
            ty_id := db.get_node_type(id)
            if db.has_union_coerce(id) {
                members := db.types.union_members(db.get_union_coerce_ty(id))
                ty_id = *(members.ptr + (db.get_union_coerce_idx(id) as u64))
            }
            add_type_to_queue(db, ty_id, type_queue)
            struct_name := ccg.type_str(&db.types, arena, ty_id)
            fields := db.get_list(db.hir.lhs(id))
            vals := db.get_list(db.hir.rhs(id))
            fields_fmt := builder.new_list(arena)
            i: u64 = 0
            while (i < fields.len) and (i < vals.len) {
                f_node := *(fields.ptr + i)
                v_node := *(vals.ptr + i)
                f_name_id := db.hir.lhs(f_node)
                v_str := lower_expr(db, ccg, builder, empty, arena, v_node, visited, queue, type_queue)
                builder.append_list_item(&fields_fmt, ccg.expr_struct_init_field(arena, f_name_id, v_str), i == 0)
                i = i + 1
            }
            ret ccg.expr_struct_init(arena, struct_name, builder.finish_list(&fields_fmt))
        }
        member {
            lhs_id := db.hir.lhs(id)
            rhs_id := db.hir.rhs(id)
            if db.get_hir_symbol(id) != id_none() {
                print(c"\n[type error] methods must be called directly; method values are not supported\n       --> ")
                db.print_loc(id)
                print(c"\n")
                fall()
            }
            lhs_ty := db.get_node_type(lhs_id)
            if db.types.kind(lhs_ty) == TyKind.type_ {
                actual_ty := db.get_const_type(lhs_id)
                if db.types.kind(actual_ty) == TyKind.enum_ {
                    field_name_id := db.hir.lhs(rhs_id)
                    if db.types.enum_has_variant(actual_ty, field_name_id) {
                        var_val := db.types.enum_variant_val(actual_ty, field_name_id)
                        add_type_to_queue(db, actual_ty, type_queue)
                        enum_name := ccg.type_str(&db.types, arena, actual_ty)
                        ret ccg.expr_enum_value(arena, enum_name, var_val)
                    }
                }
            }
            lhs_str := lower_expr(db, ccg, builder, empty, arena, lhs_id, visited, queue, type_queue)
            field_name_id := db.hir.lhs(rhs_id)
            depth := db.get_auto_deref_depth(id)
            ret ccg.expr_member(arena, lhs_str, depth, field_name_id)
        }
        else {
            print(c"\n[codegen error] unsupported expression\n       --> ")
            db.print_loc(id)
            print(c"\n")
            fall()
            ret empty
        }
    }
}

lower_body :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, id u32, visited &HashSet(u32), queue &Vec(u32), type_queue &Vec(u32)) V {
    if db.hir.kind(id) != hir_kind.block {
        ret lower_expr(db, ccg, builder, empty, arena, id, visited, queue, type_queue)
    }
    items := db.get_list(db.hir.lhs(id))
    count := items.len
    last_val := empty

    i: u64 = 0
    while i < count {
        node_id := *(items.ptr + i)
        is_last := (i + 1) == count
        val := lower_expr(db, ccg, builder, empty, arena, node_id, visited, queue, type_queue)

        if not is_last {
            ccg.expr(val)
        } else {
            last_val = val
        }
        i = i + 1
    }

    last_val
}

lower_scoped_expr :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, id u32, expected u32, visited &HashSet(u32), queue &Vec(u32), type_queue &Vec(u32)) V {
    kind := db.types.kind(expected)
    if (expected == ty_id_none()) or (kind == TyKind.unit) or (kind == TyKind.never) {
        val := lower_body(db, ccg, builder, empty, arena, id, visited, queue, type_queue)
        if ccg.has_value(val) { ccg.expr(val) }
        ret empty
    }
    add_type_to_queue(db, expected, type_queue)
    ty_str := ccg.type_str(&db.types, arena, expected)
    temp_var := ccg.new_temp(arena, ty_str)
    val := lower_body(db, ccg, builder, empty, arena, id, visited, queue, type_queue)
    if ccg.has_value(val) {
        ccg.expr(ccg.expr_assign(arena, temp_var, val))
    }
    temp_var
}

lower_match_condition :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, value_str V, value_ty u32, arm u32, visited &HashSet(u32), queue &Vec(u32), type_queue &Vec(u32)) V {
    patterns := db.get_list(db.hir.lhs(arm))
    if patterns.len == 0 { ret ccg.expr_one(arena) }
    result := empty
    i: u64 = 0
    while i < patterns.len {
        pat := *(patterns.ptr + i)
        condition := empty
        if db.types.kind(value_ty) == TyKind.enum_ {
            name_id := db.hir.lhs(pat)
            if db.hir.kind(pat) == hir_kind.member {
                name_id = db.hir.lhs(db.hir.rhs(pat))
            }
            val := db.types.enum_variant_val(value_ty, name_id)
            enum_name := ccg.type_str(&db.types, arena, value_ty)
            condition = ccg.expr_equal(arena, value_str, ccg.expr_enum_value(arena, enum_name, val))
        } else {
            pat_ty := db.get_const_type(pat)
            idx := db.types.union_member_index(value_ty, pat_ty)
            condition = ccg.expr_union_is(arena, value_str, idx)
        }
        if i == 0 { result = condition }
        else { result = ccg.expr_or(arena, result, condition) }
        i = i + 1
    }
    result
}

lower_match_binding :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, value_str V, value_ty u32, arm u32, visited &HashSet(u32), queue &Vec(u32), type_queue &Vec(u32)) {
    binder := db.hir.extra(arm)
    if binder == hir_none() { ret }
    sym := db.get_hir_symbol(binder)
    if sym == id_none() { ret }
    bind_ty := db.get_node_type(binder)
    if bind_ty == ty_id_none() { ret }
    add_type_to_queue(db, bind_ty, type_queue)
    bound_val := value_str
    patterns := db.get_list(db.hir.lhs(arm))
    if (db.types.kind(value_ty) == TyKind.union_) and (patterns.len == 1) {
        pat := *(patterns.ptr + 0)
        pat_ty := db.get_const_type(pat)
        idx := db.types.union_member_index(value_ty, pat_ty)
        bound_val = ccg.expr_cast(arena, ccg.type_str(&db.types, arena, bind_ty), ccg.expr_union_member(arena, bound_val, idx))
    }
    name := ccg.sym_name(arena, sym)
    ty_str := ccg.type_str(&db.types, arena, bind_ty)
    ccg.create_variable(name, ty_str, bound_val, true)
}

lower_match :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, id u32, visited &HashSet(u32), queue &Vec(u32), type_queue &Vec(u32)) V {
    value_id := db.hir.lhs(id)
    value_ty := db.get_node_type(value_id)
    arms := db.get_list(db.hir.rhs(id))
    match_ty := db.get_node_type(id)
    is_expr := (match_ty != ty_id_none()) and
               (db.types.kind(match_ty) != TyKind.unit) and
               (db.types.kind(match_ty) != TyKind.never)

    temp_var := empty
    if is_expr {
        add_type_to_queue(db, match_ty, type_queue)
        ty_str := ccg.type_str(&db.types, arena, match_ty)
        temp_var = ccg.new_temp(arena, ty_str)
    }

    value_val := lower_expr(db, ccg, builder, empty, arena, value_id, visited, queue, type_queue)
    value_str := value_val
    if (db.hir.kind(value_id) != hir_kind.ident) and ccg.has_value(value_val) {
        val_ty_str := ccg.type_str(&db.types, arena, value_ty)
        match_val_var := ccg.new_temp(arena, val_ty_str)
        ccg.expr(ccg.expr_assign(arena, match_val_var, value_val))
        value_str = match_val_var
    }

    i: u64 = 0
    open_blocks: u32 = 0
    while i < arms.len {
        arm := *(arms.ptr + i)
        cond := lower_match_condition(db, ccg, builder, empty, arena, value_str, value_ty, arm, visited, queue, type_queue)
        if i == 0 {
            ccg.start_if(cond)
            open_blocks = open_blocks + 1
        } else {
            ccg.else_()
            if db.get_list(db.hir.lhs(arm)).len > 0 {
                ccg.start_if(cond)
                open_blocks = open_blocks + 1
            }
        }
        lower_match_binding(db, ccg, builder, empty, arena, value_str, value_ty, arm, visited, queue, type_queue)
        branch := lower_body(db, ccg, builder, empty, arena, db.hir.rhs(arm), visited, queue, type_queue)
        if is_expr {
            if ccg.has_value(branch) {
                ccg.expr(ccg.expr_assign(arena, temp_var, branch))
            }
        } else {
            if ccg.has_value(branch) { ccg.expr(branch) }
        }
        i = i + 1
    }
    while open_blocks > 0 {
        ccg.end_block()
        open_blocks = open_blocks - 1
    }
    temp_var
}

for_method_receiver :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, call_id u32, source_name V, source_ty u32) V {
    callee := db.hir.lhs(call_id)
    func_ty := db.get_node_type(callee)
    if db.types.kind(func_ty) != TyKind.func { ret source_name }
    params := db.types.func_params(func_ty)
    if params.len == 0 { ret source_name }
    expected := *(params.ptr + 0)
    expected_depth: u32 = 0
    while db.types.kind(expected) == TyKind.ptr {
        expected = db.types.payload(expected)
        expected_depth = expected_depth + 1
    }
    source_depth: u32 = 0
    source := source_ty
    while db.types.kind(source) == TyKind.ptr {
        source = db.types.payload(source)
        source_depth = source_depth + 1
    }
    receiver := source_name
    while source_depth < expected_depth {
        receiver = ccg.expr_address(arena, receiver)
        source_depth = source_depth + 1
    }
    while source_depth > expected_depth {
        receiver = ccg.expr_deref(arena, receiver)
        source_depth = source_depth - 1
    }
    receiver
}

lower_for :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, id u32, visited &HashSet(u32), queue &Vec(u32), type_queue &Vec(u32)) V {
    vars := db.get_list(db.hir.lhs(id))
    iters := db.get_list(db.hir.rhs(id))
    ptr_id := db.interner.intern(Str.of("ptr"))
    len_id := db.interner.intern(Str.of("len"))
    index_id := db.interner.intern(Str.of("index"))
    present_id := db.interner.intern(Str.of("present"))
    value_id := db.interner.intern(Str.of("value"))

    iter_names := Vec(V).new()
    value_names := Vec(V).new()
    structural_flags := Vec(u8).new()
    i: u64 = 0
    while i < iters.len {
        iter := *(iters.ptr + i)
        source := iter
        if db.hir.kind(iter) == hir_kind.for_iter { source = db.hir.lhs(iter) }
        iter_ty := db.get_node_type(source)
        add_type_to_queue(db, iter_ty, type_queue)
        value := lower_expr(db, ccg, builder, empty, arena, source, visited, queue, type_queue)
        iter_name := ccg.iterator_name(arena, id, i as u32)
        iter_names.push(iter_name)
        ccg.create_variable(iter_name, ccg.type_str(&db.types, arena, iter_ty), value, true)
        if db.hir.kind(iter) == hir_kind.for_iter { structural_flags.push(1 as u8) } else { structural_flags.push(0 as u8) }
        i = i + 1
    }

    scope := ccg.begin_loop(id)
    ccg.start_iterator_loop(arena, &scope)

    i = 0
    while i < iter_names.len {
        name := iter_names.get(i)
        if structural_flags.get(i) != 0 {
            iter := *(iters.ptr + i)
            next_call := db.hir.rhs(iter)
            next_ty := db.get_node_type(next_call)
            add_type_to_queue(db, next_ty, type_queue)
            call_sym := resolve_call_symbol(db, next_call, db.hir.lhs(next_call), queue)
            callee_name := ccg.sym_name(arena, call_sym)
            receiver := for_method_receiver(db, ccg, builder, empty, arena, next_call, name, db.get_node_type(db.hir.lhs(iter)))
            next_expr := ccg.expr_call(arena, callee_name, receiver)
            next_name := ccg.iterator_next_name(arena, id, i as u32)
            ccg.create_variable(next_name, ccg.type_str(&db.types, arena, next_ty), next_expr, true)
            value_names.push(next_name)
            present := ccg.expr_field_value(arena, next_name, present_id)
            ccg.start_if(ccg.expr_not(arena, present))
            ccg.break_statement()
            ccg.end_block()
        } else {
            value_names.push(name)
            length := ccg.expr_field_value(arena, name, len_id)
            index := ccg.expr_field_value(arena, name, index_id)
            ccg.start_if(ccg.expr_less_equal(arena, length, index))
            ccg.break_statement()
            ccg.end_block()
        }
        i = i + 1
    }

    i = 0
    while i < vars.len {
        var_node := *(vars.ptr + i)
        var_sym := db.get_hir_symbol(var_node)
        var_name := ccg.sym_name(arena, var_sym)
        var_ty := db.get_node_type(var_node)
        iter_ty := db.get_node_type(*(iters.ptr + i))
        var_ty_str := ccg.type_str(&db.types, arena, var_ty)
        iter_name := iter_names.get(i)
        value := empty
        if structural_flags.get(i) != 0 {
            next_name := value_names.get(i)
            value = ccg.expr_field_value(arena, next_name, value_id)
        } else if iterator_is_ref(db, iter_ty) {
            ptr := ccg.expr_field_value(arena, iter_name, ptr_id)
            index := ccg.expr_field_value(arena, iter_name, index_id)
            value = ccg.expr_add(arena, ptr, index)
        } else {
            ptr := ccg.expr_field_value(arena, iter_name, ptr_id)
            index := ccg.expr_field_value(arena, iter_name, index_id)
            value = ccg.expr_deref(arena, ccg.expr_add(arena, ptr, index))
        }
        ccg.create_variable(var_name, var_ty_str, value, true)
        if structural_flags.get(i) == 0 {
            index := ccg.expr_field_value(arena, iter_name, index_id)
            ccg.expr(ccg.expr_assign(arena, index, ccg.expr_add(arena, index, ccg.expr_one(arena))))
        }
        i = i + 1
    }

    body := lower_body(db, ccg, builder, empty, arena, db.hir.extra(id), visited, queue, type_queue)
    if ccg.has_value(body) { ccg.expr(body) }
    ccg.end_loop(arena, &scope)
    iter_names.destroy()
    value_names.destroy()
    structural_flags.destroy()
    empty
}

lower_expr :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, id u32, visited &HashSet(u32), queue &Vec(u32), type_queue &Vec(u32)) V {
    val_str := lower_expr_node(db, ccg, builder, empty, arena, id, visited, queue, type_queue)
    if not ccg.has_value(val_str) { ret val_str }
    if db.has_union_coerce(id) {
        target_union := db.get_union_coerce_ty(id)
        k_idx := db.get_union_coerce_idx(id)
        add_type_to_queue(db, target_union, type_queue)
        union_name := ccg.type_str(&db.types, arena, target_union)
        ret ccg.expr_union(arena, union_name, k_idx, val_str)
    }
    val_str
}

FuncSignature :: fn(V type) type {
    struct {
        fn_name V
        params_str V
    }
}

format_func_signature :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, sym_id u32, real_sym u32, func_id u32, binding_id u32, is_mono bool, is_extern bool, orig_func_ty u32, func_ty u32) FuncSignature(V) {
    fn_name := empty
    if is_mono {
        fn_name = ccg.sym_name(arena, sym_id)
    } else if is_extern {
        if binding_id != id_none() {
            name_hir := db.hir.lhs(binding_id)
            name_id := db.hir.lhs(name_hir)
            fn_name = ccg.extern_name(db.interner.get(name_id))
        } else {
            fn_name = ccg.sym_name(arena, real_sym)
        }
    } else {
        fn_name = ccg.sym_name(arena, real_sym)
    }

    params_slice := db.types.func_params(func_ty)
    params := builder.new_list(arena)
    first := true
    orig_params: Slice(u32) = .{ ptr: 0 as &u32, len: 0 }
    if orig_func_ty != ty_id_none() {
        orig_params = db.types.func_params(orig_func_ty)
    }
    i: u64 = 0
    while i < params_slice.len {
        if is_mono and (i < orig_params.len) and (*(orig_params.ptr + i) == ty_id_type()) {
            i = i + 1
            cont
        }
        p_ty := ccg.type_str(&db.types, arena, *(params_slice.ptr + i))
        name := ccg.parameter_name(arena, i as u32)
        if not is_extern {
            args_list_id := db.hir.lhs(func_id)
            if args_list_id != hir_none() {
                args := db.get_list(args_list_id)
                arg_ident := db.hir.lhs(*(args.ptr + i))
                arg_sym := db.get_hir_symbol(arg_ident)
                if arg_sym != id_none() { name = ccg.sym_name(arena, arg_sym) }
            }
        }
        builder.append_list_item(&params, ccg.parameter(arena, p_ty, name), first)
        first = false
        i = i + 1
    }
    params_str := builder.finish_list(&params)
    if first { params_str = ccg.empty_parameters() }

    .{ fn_name: fn_name, params_str: params_str }
}

queue_func_types :: fn(db &Nexus, func_ty u32, type_queue &Vec(u32)) {
    add_type_to_queue(db, db.types.func_return(func_ty), type_queue)
    params := db.types.func_params(func_ty)
    i: u64 = 0
    while i < params.len {
        add_type_to_queue(db, *(params.ptr + i), type_queue)
        i = i + 1
    }
}

emit_func_body_return :: fn(B type, L type, V type, ccg &B, builder &L, empty V, db &Nexus, ret_ty u32, body_val V) {
    if db.types.kind(ret_ty) == TyKind.unit {
        if ccg.has_value(body_val) { ccg.expr(body_val) }
        ccg.gen_return(empty, false)
    } else if ccg.has_value(body_val) {
        ccg.gen_return(body_val, true)
    }
}

lower_one_function :: fn(B type, L type, V type, eng &Engine, ccg &B, builder &L, empty V, arena &Arena, sym_id u32, visited &HashSet(u32), queue &Vec(u32), type_queue &Vec(u32)) {
    if sym_id == id_none() { ret }

    db := &eng.nexus
    is_mono := db.is_mono_sym(sym_id)
    orig_sym := sym_id
    mono_func_ty := ty_id_none()
    if is_mono {
        orig_sym = db.get_mono_orig_sym(sym_id)
        mono_func_ty = db.get_mono_type(sym_id)
    }
    real_sym := db.resolve_sym(orig_sym)
    func_id := db.get_fn_node(real_sym)
    if (func_id == id_none()) or (db.hir.kind(func_id) != hir_kind.function) { ret }
    binding_id := id_none()
    hir_end := db.sym_hir_end.get(real_sym)
    if (hir_end != 0) and (hir_end != id_none()) and (db.hir.kind(hir_end - 1) == hir_kind.binding) {
        binding_id = hir_end - 1
    }
    saved_orig_ty := db.get_const_type(func_id)
    orig_func_ty := saved_orig_ty
    if (orig_func_ty == ty_id_none()) and is_mono { orig_func_ty = mono_func_ty }
    if (not is_mono) and (orig_func_ty != ty_id_none()) and db.types.func_has_type_param(orig_func_ty) { ret }
    if (orig_func_ty != ty_id_none()) and (db.types.func_return(orig_func_ty) == ty_id_type()) { ret }
    if is_mono {
        tyck_mono_function(eng, sym_id)
        if (db.get_const_type(func_id) != ty_id_none()) and db.types.func_has_type_param(db.get_const_type(func_id)) {
            orig_func_ty = db.get_const_type(func_id)
        }
    }
    finalize_inferred_types(eng, func_id)
    func_ty := db.get_node_type(func_id)
    if is_mono { func_ty = mono_func_ty }
    if func_ty == ty_id_none() { ret }
    body_id := db.hir.extra(func_id)
    is_extern := (body_id == hir_none()) or db.types.func_is_extern(func_ty)
    sig := format_func_signature(db, ccg, builder, empty, arena, sym_id, real_sym, func_id, binding_id, is_mono, is_extern, orig_func_ty, func_ty)
    if is_extern { ret }
    queue_func_types(db, func_ty, type_queue)
    ret_ty := db.types.func_return(func_ty)
    ret_str := ccg.type_str(&db.types, arena, ret_ty)
    ccg.start_function(sig.fn_name, ret_str, sig.params_str)
    body_val := lower_body(db, ccg, builder, empty, arena, body_id, visited, queue, type_queue)
    emit_func_body_return(ccg, builder, empty, db, ret_ty, body_val)
    ccg.end_function()
    if is_mono { db.set_const_type(func_id, saved_orig_ty) }
}

lower_function :: fn(B type, L type, V type, eng &Engine, ccg &B, builder &L, empty V, arena &Arena, sym_id u32, visited &HashSet(u32)) {
    if sym_id == id_none() {
        ret
    }

    db := &eng.nexus
    queue := Vec().new()
    type_queue := Vec().new()

    queue.push(sym_id)

    for q_sym in Worklist(u32).new(&queue) {
        if visited.insert(q_sym) {
            lower_one_function(eng, ccg, builder, empty, arena, q_sym, visited, &queue, &type_queue)
        }
    }

    sorted := topo_sort(db, &type_queue)

    for t in sorted {

        match db.types.kind(t) {
            
            struct_, nominal {
                ccg.define_struct(&db.types, arena, t)
            }

            func {
                ccg.define_func_type(&db.types, arena, t)
            }

            union_ {
                ccg.define_union(&db.types, arena, t)
            }

            enum_ {
                ccg.define_enum(&db.types, arena, t)
            }

            else {}
        }

    }

    sorted.destroy()
    type_queue.destroy()
    queue.destroy()
}

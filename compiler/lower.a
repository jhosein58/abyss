import Nexus from "nexus/nexus.a"
import HirTable, hir_kind, hir_none, HirExprKind from "hir.a"
import id_none from "nexus/pool.a"
import CCodeGen from "codegen.a"
import Str from "../std/string.a"
import Fmt from "../std/fmt.a"
import Arena from "../std/allocator.a"
import VecU32 from "../std/vec/u32.a"
import TypeStorage, ty_kind, ty_id_none, ty_id_type from "types.a"
import slot_none from "unify.a"
import topo_sort from "topo_sort.a"
import fall from "../std/sys.a"
import method_returns_ref_self, method_has_explicit_self, synth_node from "typer/tyck.a"
import Engine from "engine.a"

print :: (s &u8) unit

get_node_type :: (db &Nexus, id u32) u32 {
    if id == hir_none() { ret ty_id_none() }
    slot := (&(*db).unify).get_slot(id)
    if slot == slot_none() { ret ty_id_none() }
    (&(*db).unify).resolve_type_deep(&(*db).types, slot)
}

vec_contains :: (v &VecU32, val u32) bool {
    i: u64 = 0
    while i < (*v).len {
        if v.get(i) == val { ret true }
        i = i + 1
    }
    false
}

method_tag :: () u32 { 2147483648 }

is_lvalue :: (db &Nexus, id u32) bool {
    tbl := &(*db).hir
    kind := (tbl).kind(id)
    if kind == hir_kind().ident { ret get_node_type(db, id) != ty_id_type() }
    if kind == hir_kind().unary_deref { ret true }
    if kind == hir_kind().struct_init { ret true }
    if kind == hir_kind().member {
        lhs := (tbl).lhs(id)
        if lhs == hir_none() { ret true }
        if (&(*db).types).kind(get_node_type(db, lhs)) == ty_kind().ptr { ret true }
        ret is_lvalue(db, lhs)
    }
    false
}

type_has_infer :: (types &TypeStorage, ty_id u32) bool {
    if ty_id == ty_id_none() { ret false }
    k := ty_kind()
    kind := (&(*types)).kind(ty_id)
    if (kind == k.infer) or (kind == k.unknown) or (kind == k.error) { ret true }
    if (kind == k.struct_) or (kind == k.nominal) {
        fields := (&(*types)).get_struct_fields(ty_id)
        count := fields.len / 2
        i: u64 = 0
        while i < count {
            f_ty := *(fields.ptr + (i * 2) + 1)
            if type_has_infer(types, f_ty) { ret true }
            i = i + 1
        }
    } else if kind == k.ptr {
        ret type_has_infer(types, (&(*types)).payload(ty_id))
    }
    false
}

add_type_to_queue :: (db &Nexus, ty_id u32, queue &VecU32) {
    if ty_id == ty_id_none() { ret }
    if type_has_infer(&(*db).types, ty_id) { ret }
    k := ty_kind()
    kind := (&(*db).types).kind(ty_id)

    if (kind == k.struct_) or (kind == k.nominal) {
        if not vec_contains(queue, ty_id) {
            queue.push(ty_id)
            fields := (&(*db).types).get_struct_fields(ty_id)
            count := fields.len / 2
            i: u64 = 0
            while i < count {
                f_ty := *(fields.ptr + (i * 2) + 1)
                add_type_to_queue(db, f_ty, queue)
                i = i + 1
            }
        }
    } else if kind == k.ptr {
        inner := (&(*db).types).payload(ty_id)
        add_type_to_queue(db, inner, queue)
    } else if kind == k.func {
        if not vec_contains(queue, ty_id) {
            queue.push(ty_id)
            ret_ty := (&(*db).types).func_return(ty_id)
            add_type_to_queue(db, ret_ty, queue)
            params := (&(*db).types).func_params(ty_id)
            i: u64 = 0
            while i < params.len {
                add_type_to_queue(db, *(params.ptr + i), queue)
                i = i + 1
            }
        }
    } else if kind == k.union_ {
        if not vec_contains(queue, ty_id) {
            queue.push(ty_id)
            members := (&(*db).types).union_members(ty_id)
            i: u64 = 0
            while i < members.len {
                add_type_to_queue(db, *(members.ptr + i), queue)
                i = i + 1
            }
        }
    } else if kind == k.enum_ {
        if not vec_contains(queue, ty_id) {
            queue.push(ty_id)
            backing := (&(*db).types).enum_backing(ty_id)
            add_type_to_queue(db, backing, queue)
        }
    }
}

lower_expr_raw :: (db &Nexus, ccg &CCodeGen, arena &Arena, id u32, visited &VecU32, queue &VecU32, type_queue &VecU32) Str {
    k := hir_kind()
    kind := (&(*db).hir).kind(id)

    if kind == k.builtin_call {
        name_id := (&(*db).hir).lhs(id)
        name := db.interner.get(name_id)
        args_list_id := (&(*db).hir).rhs(id)
        args := db.get_list(args_list_id)

        if name.eq(Str.of("sizeof")) {
            target_ty := db.get_const_type(id)
            add_type_to_queue(db, target_ty, type_queue)
            t_str := ccg.type_str(&(*db).types, arena, target_ty)
            fmt := Fmt.new(arena)
            fmt.cstr("((uint64_t)sizeof(").str(t_str).cstr("))")
            ret fmt.as_str()
        }

        if name.eq(Str.of("typeof")) {
            ret Str.empty()
        }

        if name.eq(Str.of("is")) {
            val_node := *(args.ptr + 0)
            target_ty := db.get_const_type(id)
            val_ty := get_node_type(db, val_node)
            if (&(*db).types).kind(val_ty) == ty_kind().union_ {
                if not (&(*db).types).union_contains(val_ty, target_ty) {
                    ret ccg.expr_bool(false)
                }
                tag_idx := (&(*db).types).union_member_index(val_ty, target_ty)
                val_str := lower_expr(db, ccg, arena, val_node, visited, queue, type_queue)
                fmt := Fmt.new(arena)
                fmt.cstr("(((").str(val_str).cstr(").tag == ").uint32(tag_idx).cstr("))")
                ret fmt.as_str()
            }
            if val_ty == target_ty {
                ret ccg.expr_bool(true)
            }
            ret ccg.expr_bool(false)
        }

        if name.eq(Str.of("tag")) {
            val_node := *(args.ptr + 0)
            val_str := lower_expr(db, ccg, arena, val_node, visited, queue, type_queue)
            fmt := Fmt.new(arena)
            fmt.cstr("(((").str(val_str).cstr(").tag))")
            ret fmt.as_str()
        }

        ret Str.empty()
    }

    if kind == k.lit_int {
        val := (&(*db).hir).lhs(id)
        ret ccg.expr_int(arena, val)
    }

    if kind == k.function {
        body_id := (&(*db).hir).extra(id)
        if body_id == hir_none() {
            ret Str.empty()
        }

        func_ty := get_node_type(db, id)
        add_type_to_queue(db, func_ty, type_queue)

        sym_id := db.get_hir_symbol(id)
        if sym_id != id_none() {
            if not (&(*db).types).func_has_type_param(func_ty) {
                if not vec_contains(queue, sym_id) {
                    queue.push(sym_id)
                }
            }
            ret ccg.sym_name(arena, sym_id)
        }

        ret Str.empty()
    }

    if kind == k.ident {
        ty := get_node_type(db, id)
        sym_id := db.get_hir_symbol(id)

        if (&(*db).types).kind(ty) == ty_kind().func {
            if sym_id != id_none() {
                real_sym := sym_id
                while true {
                    tgt := db.sym_target.get(real_sym)
                    if (tgt == id_none()) or (tgt == real_sym) { break }
                    real_sym = tgt
                }
                if not (&(*db).types).func_has_type_param(ty) {
                    if not vec_contains(queue, real_sym) {
                        queue.push(real_sym)
                    }
                }
                if (&(*db).types).func_is_extern(ty) {
                    name_id := (&(*db).hir).lhs(id)
                    ret db.interner.get(name_id)
                }
                ret ccg.sym_name(arena, real_sym)
            }
        }

        if sym_id != id_none() {
            real_sym := sym_id
            while true {
                target := db.sym_target.get(real_sym)
                if (target == id_none()) or (target == real_sym) { break }
                real_sym = target
            }
            if db.sym_tok_start.get(real_sym) != id_none() {
                print("\n[codegen error] unsupported global value\n       --> ")
                db.print_loc(id)
                print("\n")
                fall()
            }
            ret ccg.sym_name(arena, sym_id)
        }

        print("\n[codegen error] undefined identifier\n       --> ")
        db.print_loc(id)
        print("\n")
        fall()
        ret Str.empty()
    }

    if kind == k.var {
        ident_id := (&(*db).hir).lhs(id)
        val_id   := (&(*db).hir).extra(id)

        sym_id := db.get_hir_symbol(ident_id)
        var_ty := get_node_type(db, ident_id)
        if (var_ty == ty_id_type()) or (&(*db).types).func_has_type_param(var_ty) {
            ret Str.empty()
        }
        if (&(*db).types).kind(var_ty) == ty_kind().unit {
            print("\n[type error] variable cannot have unit type\n       --> ")
            db.print_loc(id)
            print("\n")
            fall()
        }
        ty_str := ccg.type_str(&(*db).types, arena, var_ty)
        var_name := ccg.sym_name(arena, sym_id)

        if val_id != hir_none() {
            val_str := lower_expr(db, ccg, arena, val_id, visited, queue, type_queue)
            if val_str.len == 0 {
                print("\n[codegen error] initializer does not produce a value\n       --> ")
                db.print_loc(id)
                print("\n")
                fall()
            }
            ccg.create_variable(var_name, ty_str, val_str, true)
        } else {
            ccg.create_variable(var_name, ty_str, Str.empty(), false)
        }

        add_type_to_queue(db, var_ty, type_queue)
        ret Str.empty()
    }

    if kind == k.binary_assign {
        lhs_id := (&(*db).hir).lhs(id)
        rhs_id := (&(*db).hir).rhs(id)

        lhs_str := lower_expr(db, ccg, arena, lhs_id, visited, queue, type_queue)
        rhs_str := lower_expr(db, ccg, arena, rhs_id, visited, queue, type_queue)

        ret ccg.expr_assign(arena, lhs_str, rhs_str)
    }

    if (kind == k.binary_add) or (kind == k.binary_sub) or (kind == k.binary_mul) or
       (kind == k.binary_div) or (kind == k.binary_mod) or (kind == k.binary_eq_eq) or
       (kind == k.binary_neq) or (kind == k.binary_lt) or (kind == k.binary_gt) or
       (kind == k.binary_lt_eq) or (kind == k.binary_gt_eq) or (kind == k.binary_bit_and) or
       (kind == k.binary_bit_or) or (kind == k.binary_bit_xor) or (kind == k.binary_shl) or
       (kind == k.binary_shr) {

        lhs_id := (&(*db).hir).lhs(id)
        rhs_id := (&(*db).hir).rhs(id)

        lhs_val := lower_expr(db, ccg, arena, lhs_id, visited, queue, type_queue)
        rhs_val := lower_expr(db, ccg, arena, rhs_id, visited, queue, type_queue)
        op_str  := ccg.binary_op(k, kind)

        ret ccg.expr_binary(arena, op_str, lhs_val, rhs_val)
    }

    if kind == k.binary_and {
        lhs_id := (&(*db).hir).lhs(id)
        rhs_id := (&(*db).hir).rhs(id)

        lhs_val := lower_expr(db, ccg, arena, lhs_id, visited, queue, type_queue)
        tmp_name := ccg.new_tmp_var(arena)
        ccg.create_variable(tmp_name, Str.of("bool"), Str.of("false"), true)

        ccg.start_if(lhs_val)
        rhs_val := lower_expr(db, ccg, arena, rhs_id, visited, queue, type_queue)
        assign_str := ccg.expr_assign(arena, tmp_name, rhs_val)
        ccg.expr(assign_str)
        ccg.end_block()

        ret tmp_name
    }

    if kind == k.binary_or {
        lhs_id := (&(*db).hir).lhs(id)
        rhs_id := (&(*db).hir).rhs(id)

        lhs_val := lower_expr(db, ccg, arena, lhs_id, visited, queue, type_queue)
        tmp_name := ccg.new_tmp_var(arena)
        ccg.create_variable(tmp_name, Str.of("bool"), Str.of("true"), true)

        not_lhs := ccg.expr_unary(arena, Str.of("!"), lhs_val)
        ccg.start_if(not_lhs)
        rhs_val := lower_expr(db, ccg, arena, rhs_id, visited, queue, type_queue)
        assign_str := ccg.expr_assign(arena, tmp_name, rhs_val)
        ccg.expr(assign_str)
        ccg.end_block()

        ret tmp_name
    }

    if kind == k.call {
        callee_id := (&(*db).hir).lhs(id)
        if get_node_type(db, id) == ty_id_type() {
            ret Str.empty()
        }

        args_list := (&(*db).hir).rhs(id)
        method := db.get_method_target(callee_id)

        callee_sym := db.get_hir_symbol(callee_id)
        callee_ty := get_node_type(db, callee_id)
        is_generic := (&(*db).types).func_has_type_param(callee_ty)

        callee_str := Str.empty()
        if is_generic {
            target_sym := callee_sym
            if (target_sym == id_none()) and ((&(*db).hir).kind(callee_id) == k.function) {
                target_sym = db.get_hir_symbol(callee_id)
            }
            if method != id_none() {
                target_sym = method | method_tag()
            } else if target_sym != id_none() {
                real_s := target_sym
                while true {
                    tgt := db.sym_target.get(real_s)
                    if (tgt == id_none()) or (tgt == real_s) { break }
                    real_s = tgt
                }
                target_sym = real_s
            }
            mono_func_ty := db.get_const_type(id)
            mono_sym := db.find_mono_sym(target_sym, mono_func_ty)
            if mono_sym == id_none() {
                mono_sym = db.alloc_mono_sym(target_sym, mono_func_ty)
            }
            if not vec_contains(queue, mono_sym) {
                queue.push(mono_sym)
            }
            callee_str = ccg.sym_name(arena, mono_sym)
        } else {
            if callee_sym != id_none() {
                if not vec_contains(queue, callee_sym) {
                    queue.push(callee_sym)
                }
            }
            if method != id_none() {
                tagged := method | method_tag()
                if not vec_contains(queue, tagged) { queue.push(tagged) }
                callee_str = ccg.method_name(arena, method)
            } else {
                callee_str = lower_expr(db, ccg, arena, callee_id, visited, queue, type_queue)
            }
        }

        has_receiver := false
        has_expl_self := false
        if method != id_none() {
            has_expl_self = method_has_explicit_self(db, method)
            if not has_expl_self {
                method_name := (&(*db).hir).lhs(method)
                node := method_name
                while node < method {
                    if ((&(*db).hir).kind(node) == k.member) and
                       ((&(*db).hir).lhs(node) == hir_none()) {
                        has_receiver = true
                        break
                    }
                    node = node + 1
                }
            }
        }

        callee_lhs := hir_none()
        if ((&(*db).hir).kind(callee_id) == k.member) {
            callee_lhs = (&(*db).hir).lhs(callee_id)
        }

        lhs_is_instance := false
        if (callee_lhs != hir_none()) and has_expl_self {
            lhs_ty := get_node_type(db, callee_lhs)
            if lhs_ty != ty_id_type() {
                lhs_is_instance = true
            }
        }

        args_fmt := Fmt.new(arena)
        first_arg := true
        if has_receiver {
            first_arg = false
            lhs := callee_lhs

            if lhs == hir_none() {
                args_fmt.str(Str.of("_self"))
            } else {
                receiver_ty := get_node_type(db, lhs)
                receiver_str := lower_expr(db, ccg, arena, lhs, visited, queue, type_queue)
                depth: u32 = 0
                while (&(*db).types).kind(receiver_ty) == ty_kind().ptr {
                    receiver_ty = (&(*db).types).payload(receiver_ty)
                    depth = depth + 1
                }
                add_type_to_queue(db, receiver_ty, type_queue)
                receiver_ty_str := ccg.type_str(&(*db).types, arena, receiver_ty)
                args_fmt.str(ccg.expr_receiver(arena, receiver_str, depth, is_lvalue(db, lhs), receiver_ty_str))
            }
        } else if lhs_is_instance {
            first_arg = false
            receiver_ty := get_node_type(db, callee_lhs)
            receiver_str := lower_expr(db, ccg, arena, callee_lhs, visited, queue, type_queue)

            func_node := (&(*db).hir).extra(method)
            func_ty := db.get_const_type(func_node)
            first_param_ty := ty_id_none()
            if func_ty != ty_id_none() {
                m_params := (&(*db).types).func_params(func_ty)
                if m_params.len > 0 {
                    first_param_ty = *(m_params.ptr + 0)
                }
            }

            if (&(*db).types).kind(first_param_ty) == ty_kind().ptr {
                if (&(*db).types).kind(receiver_ty) == ty_kind().ptr {
                    args_fmt.str(receiver_str)
                } else {
                    args_fmt.cstr("&(").str(receiver_str).char(41 as u8)
                }
            } else {
                if (&(*db).types).kind(receiver_ty) == ty_kind().ptr {
                    args_fmt.cstr("(*").str(receiver_str).char(41 as u8)
                } else {
                    args_fmt.str(receiver_str)
                }
            }
        }

        if args_list != hir_none() {
            args := db.get_list(args_list)
            i: u64 = 0
            while i < args.len {
                arg_node := *(args.ptr + i)
                if is_generic and (get_node_type(db, arg_node) == ty_id_type()) {
                    i = i + 1
                    cont
                }
                arg_val := lower_expr(db, ccg, arena, arg_node, visited, queue, type_queue)
                if not first_arg { args_fmt.cstr(", ") }
                args_fmt.str(arg_val)
                first_arg = false
                i = i + 1
            }
        }

        ret ccg.expr_call(arena, callee_str, args_fmt.as_str())
    }

    if kind == k.block {
        list_id := (&(*db).hir).lhs(id)
        items := db.get_list(list_id)
        count := items.len
        last_val := Str.empty()

        i: u64 = 0
        while i < count {
            node_id := *(items.ptr + i)
            is_last := (i + 1) == count
            val := lower_expr(db, ccg, arena, node_id, visited, queue, type_queue)

            if not is_last {
                ccg.expr(val)
            } else {
                last_val = val
            }
            i = i + 1
        }

        ret last_val
    }

    if kind == k.lit_float {
        name_id := (&(*db).hir).lhs(id)
        ret db.interner.get(name_id)
    }
    if kind == k.lit_bool_true  { ret ccg.expr_bool(true) }
    if kind == k.lit_bool_false { ret ccg.expr_bool(false) }
    if kind == k.lit_str {
        name_id := (&(*db).hir).lhs(id)
        raw := db.interner.get(name_id)
        ret ccg.expr_str_lit(arena, raw)
    }

    if kind == k.unary_neg {
        child_v := lower_expr(db, ccg, arena, (&(*db).hir).lhs(id), visited, queue, type_queue)
        ret ccg.expr_unary(arena, Str.of("-"), child_v)
    }
    if kind == k.unary_not {
        child_v := lower_expr(db, ccg, arena, (&(*db).hir).lhs(id), visited, queue, type_queue)
        ret ccg.expr_unary(arena, Str.of("!"), child_v)
    }
    if kind == k.unary_bit_not {
        child_v := lower_expr(db, ccg, arena, (&(*db).hir).lhs(id), visited, queue, type_queue)
        ret ccg.expr_unary(arena, Str.of("~"), child_v)
    }
    if kind == k.unary_addr_of {
        child_v := lower_expr(db, ccg, arena, (&(*db).hir).lhs(id), visited, queue, type_queue)
        ret ccg.expr_unary(arena, Str.of("&"), child_v)
    }
    if kind == k.unary_deref {
        child_v := lower_expr(db, ccg, arena, (&(*db).hir).lhs(id), visited, queue, type_queue)
        ret ccg.expr_unary(arena, Str.of("*"), child_v)
    }
    if kind == k.k_break {
        ccg.emit_break()
        ret Str.empty()
    }
    if kind == k.k_cont {
        ccg.emit_cont()
        ret Str.empty()
    }

    if kind == k.cast {
        lhs_node := (&(*db).hir).lhs(id)
        lhs_ty := get_node_type(db, lhs_node)
        if (&(*db).types).kind(lhs_ty) == ty_kind().union_ {
            target_ty := get_node_type(db, id)
            member_idx := (&(*db).types).union_member_index(lhs_ty, target_ty)
            lhs_v := lower_expr(db, ccg, arena, lhs_node, visited, queue, type_queue)
            fmt := Fmt.new(arena)
            fmt.cstr("(((").str(lhs_v).cstr(").val._v").uint32(member_idx).cstr("))")
            ret fmt.as_str()
        }
        lhs_v := lower_expr(db, ccg, arena, lhs_node, visited, queue, type_queue)
        ty_str := ccg.type_str(&(*db).types, arena, get_node_type(db, id))
        ret ccg.expr_cast(arena, ty_str, lhs_v)
    }

    if kind == k.k_if {
        if_ty := get_node_type(db, id)
        elseb_id := (&(*db).hir).extra(id)
        is_expr := (elseb_id != hir_none()) and (if_ty != ty_id_none()) and
                   ((&(*db).types).kind(if_ty) != ty_kind().unit)

        if is_expr {
            cond_str := lower_expr(db, ccg, arena, (&(*db).hir).lhs(id), visited, queue, type_queue)
            tmp_name := ccg.new_tmp_var(arena)
            ty_str := ccg.type_str(&(*db).types, arena, if_ty)
            add_type_to_queue(db, if_ty, type_queue)
            ccg.create_variable(tmp_name, ty_str, Str.empty(), false)

            ccg.start_if(cond_str)
            then_val := lower_expr(db, ccg, arena, (&(*db).hir).rhs(id), visited, queue, type_queue)
            if then_val.len > 0 {
                ccg.expr(ccg.expr_assign(arena, tmp_name, then_val))
            }

            ccg.else_()
            else_val := lower_expr(db, ccg, arena, elseb_id, visited, queue, type_queue)
            if else_val.len > 0 {
                ccg.expr(ccg.expr_assign(arena, tmp_name, else_val))
            }
            ccg.end_block()

            ret tmp_name
        }

        cond_str := lower_expr(db, ccg, arena, (&(*db).hir).lhs(id), visited, queue, type_queue)
        ccg.start_if(cond_str)

        then_val := lower_expr(db, ccg, arena, (&(*db).hir).rhs(id), visited, queue, type_queue)
        if then_val.len > 0 { ccg.expr(then_val) }

        if elseb_id != hir_none() {
            ccg.else_()
            else_val := lower_expr(db, ccg, arena, elseb_id, visited, queue, type_queue)
            if else_val.len > 0 { ccg.expr(else_val) }
        }
        ccg.end_block()
        ret Str.empty()
    }

    if kind == k.k_while {
        ccg.start_while(Str.of("1"))

        cond_str := lower_expr(db, ccg, arena, (&(*db).hir).lhs(id), visited, queue, type_queue)
        not_cond := ccg.expr_unary(arena, Str.of("!"), cond_str)
        ccg.start_if(not_cond)
        ccg.emit_break()
        ccg.end_block()

        body_val := lower_expr(db, ccg, arena, (&(*db).hir).rhs(id), visited, queue, type_queue)
        if body_val.len > 0 { ccg.expr(body_val) }

        ccg.end_block()
        ret Str.empty()
    }

    if kind == k.k_ret {
        val_id := (&(*db).hir).lhs(id)
        if val_id != hir_none() {
            val_str := lower_expr(db, ccg, arena, val_id, visited, queue, type_queue)
            ccg.gen_return(val_str, true)
        } else if method_returns_ref_self(db, id) {
            ccg.gen_return(Str.of("_self"), true)
        } else {
            ccg.gen_return(Str.empty(), false)
        }
        ret Str.empty()
    }

    if kind == k.struct_init {
        ty_id := get_node_type(db, id)
        add_type_to_queue(db, ty_id, type_queue)
        struct_name := ccg.type_str(&(*db).types, arena, ty_id)

        fields_list := (&(*db).hir).lhs(id)
        vals_list   := (&(*db).hir).rhs(id)

        fields := db.get_list(fields_list)
        vals   := db.get_list(vals_list)

        fields_fmt := Fmt.new(arena)
        i: u64 = 0
        while (i < fields.len) and (i < vals.len) {
            f_node := *(fields.ptr + i)
            v_node := *(vals.ptr + i)

            f_name_id := (&(*db).hir).lhs(f_node)
            v_str := lower_expr(db, ccg, arena, v_node, visited, queue, type_queue)

            fields_fmt.str(ccg.expr_struct_init_field(arena, f_name_id, v_str))
            if (i + 1) < fields.len {
                fields_fmt.cstr(", ")
            }
            i = i + 1
        }

        ret ccg.expr_struct_init(arena, struct_name, fields_fmt.as_str())
    }

    if kind == k.member {
        lhs_id := (&(*db).hir).lhs(id)
        rhs_id := (&(*db).hir).rhs(id)

        method := db.get_method_target(id)
        if method != id_none() {
            print("\n[type error] methods must be called directly; method values are not supported\n       --> ")
            db.print_loc(id)
            print("\n")
            fall()
        }

        if lhs_id == hir_none() {
            field_id := (&(*db).hir).lhs(rhs_id)
            ret ccg.expr_self_member(arena, field_id)
        }

        if (lhs_id == hir_none()) or (rhs_id == hir_none()) {
            ret Str.empty()
        }

        lhs_ty := get_node_type(db, lhs_id)
        if (&(*db).types).kind(lhs_ty) == ty_kind().type_ {
            actual_ty := db.get_const_type(lhs_id)
            if (&(*db).types).kind(actual_ty) == ty_kind().enum_ {
                field_name_id := (&(*db).hir).lhs(rhs_id)
                if (&(*db).types).enum_has_variant(actual_ty, field_name_id) {
                    var_val := (&(*db).types).enum_variant_val(actual_ty, field_name_id)
                    add_type_to_queue(db, actual_ty, type_queue)
                    enum_name := ccg.type_str(&(*db).types, arena, actual_ty)
                    fmt := Fmt.new(arena)
                    fmt.cstr("((").str(enum_name).cstr(")").uint32(var_val).cstr(")")
                    ret fmt.as_str()
                }
            }
        }

        lhs_str := lower_expr(db, ccg, arena, lhs_id, visited, queue, type_queue)
        field_name_id := (&(*db).hir).lhs(rhs_id)
        depth: u32 = 0
        while (&(*db).types).kind(lhs_ty) == ty_kind().ptr {
            lhs_ty = (&(*db).types).payload(lhs_ty)
            depth = depth + 1
        }

        ret ccg.expr_member(arena, lhs_str, depth, field_name_id)
    }

    print("\n[codegen error] unsupported expression\n       --> ")
    db.print_loc(id)
    print("\n")
    fall()
    Str.empty()
}

lower_expr :: (db &Nexus, ccg &CCodeGen, arena &Arena, id u32, visited &VecU32, queue &VecU32, type_queue &VecU32) Str {
    val_str := lower_expr_raw(db, ccg, arena, id, visited, queue, type_queue)
    if val_str.len == 0 { ret val_str }
    if db.has_union_coerce(id) {
        target_union := db.get_union_coerce_ty(id)
        k_idx := db.get_union_coerce_idx(id)
        add_type_to_queue(db, target_union, type_queue)
        union_name := ccg.type_str(&(*db).types, arena, target_union)
        fmt := Fmt.new(arena)
        fmt.cstr("((").str(union_name).cstr("){ .tag = ").uint32(k_idx).cstr(", .val = { ._v").uint32(k_idx).cstr(" = ").str(val_str).cstr(" } })")
        ret fmt.as_str()
    }
    val_str
}

lower_function :: (eng &Engine, arena &Arena, sym_id u32, visited &VecU32) {
    if sym_id == id_none() {
        ret
    }

    if vec_contains(visited, sym_id) {
        ret
    }
    visited.push(sym_id)

    db := &(*eng).nexus
    ccg := &(*eng).ccg

    is_mono := db.is_mono_sym(sym_id)
    orig_sym := sym_id
    mono_func_ty := ty_id_none()
    if is_mono {
        orig_sym = db.get_mono_orig_sym(sym_id)
        mono_func_ty = db.get_mono_type(sym_id)
    }

    is_method := (orig_sym & method_tag()) != 0
    real_sym := orig_sym

    if not is_method {
        while true {
            tgt := db.sym_target.get(real_sym)
            if (tgt == id_none()) or (tgt == real_sym) {
                break
            }
            real_sym = tgt
        }
    }

    k := hir_kind()
    func_id := id_none()
    binding_id := id_none()

    sym_node := db.get_sym_hir(real_sym)
    if (sym_node != id_none()) and (((&(*db).hir).kind(sym_node) == k.function)) {
        func_id = sym_node
    } else if is_method {
        binding_id = real_sym & 2147483647
        if (&(*db).hir).kind(binding_id) == k.binding {
            func_id = (&(*db).hir).extra(binding_id)
        }
    } else {
        hir_end := db.sym_hir_end.get(real_sym)
        if (hir_end != 0) and (hir_end != id_none()) {
            binding_id = hir_end - 1
            if (&(*db).hir).kind(binding_id) == k.binding {
                func_id = (&(*db).hir).extra(binding_id)
            }
        }
    }

    if (func_id == id_none()) and (sym_node != id_none()) {
        scan_i := sym_node + 1
        tbl_len := (&(*db).hir).len()
        while scan_i < tbl_len {
            sk := (&(*db).hir).kind(scan_i)
            if (sk == k.var) or (sk == k.binding) {
                if (&(*db).hir).lhs(scan_i) == sym_node {
                    cand := (&(*db).hir).extra(scan_i)
                    if (cand != hir_none()) and (((&(*db).hir).kind(cand) == k.function)) {
                        func_id = cand
                        break
                    }
                }
            }
            if scan_i > (sym_node + 50) { break }
            scan_i = scan_i + 1
        }
    }

    if func_id == id_none() {
        ret
    }
    if (&(*db).hir).kind(func_id) != k.function {
        ret
    }

    orig_func_ty := db.get_const_type(func_id)
    if (not is_mono) and (&(*db).types).func_has_type_param(orig_func_ty) {
        ret
    }
    if (&(*db).types).func_return(orig_func_ty) == ty_id_type() {
        ret
    }

    if is_mono {
        orig_params := (&(*db).types).func_params(orig_func_ty)
        mono_params := (&(*db).types).func_params(mono_func_ty)
        args_list_id := (&(*db).hir).lhs(func_id)
        fn_args := db.get_list(args_list_id)

        p_idx: u64 = 0
        while p_idx < orig_params.len {
            arg_node := *(fn_args.ptr + p_idx)
            arg_ident := (&(*db).hir).lhs(arg_node)
            concrete_p_ty := *(mono_params.ptr + p_idx)
            if *(orig_params.ptr + p_idx) == ty_id_type() {
                db.set_const_type(arg_ident, concrete_p_ty)
                arg_sym := db.get_hir_symbol(arg_ident)
                if arg_sym != id_none() { db.set_const_type(arg_sym, concrete_p_ty) }
            } else {
                p_slot := (&(*db).unify).new_slot(arg_ident)
                (&(*db).unify).bind_type(&(*db).types, p_slot, concrete_p_ty)
                db.set_const_type(arg_ident, concrete_p_ty)
                arg_sym := db.get_hir_symbol(arg_ident)
                if arg_sym != id_none() { db.set_const_type(arg_sym, concrete_p_ty) }
            }
            p_idx = p_idx + 1
        }

        db.set_const_type(func_id, mono_func_ty)

        body_id := (&(*db).hir).extra(func_id)
        if body_id != hir_none() {
            n := func_id + 1
            while n <= body_id {
                (&(*db).unify).new_slot(n)
                synth_node(eng, n)
                n = n + 1
            }
        }
    }

    func_ty := get_node_type(db, func_id)
    if is_mono {
        func_ty = mono_func_ty
    }
    ret_ty  := (&(*db).types).func_return(func_ty)
    ret_str := ccg.type_str(&(*db).types, arena, ret_ty)

    body_id   := (&(*db).hir).extra(func_id)
    is_extern := (body_id == hir_none()) or (&(*db).types).func_is_extern(func_ty)

    fn_name := Str.empty()
    if is_mono {
        fn_name = ccg.sym_name(arena, sym_id)
    } else if is_extern and (not is_method) {
        if binding_id != id_none() {
            name_hir := (&(*db).hir).lhs(binding_id)
            name_id  := (&(*db).hir).lhs(name_hir)
            fn_name   = db.interner.get(name_id)
        } else {
            fn_name = ccg.sym_name(arena, real_sym)
        }
    } else if is_method {
        fn_name = ccg.method_name(arena, binding_id)
    } else {
        fn_name = ccg.sym_name(arena, real_sym)
    }

    params_slice := (&(*db).types).func_params(func_ty)
    params_str   := Str.of("void")

    receiver := false
    method_owner := id_none()
    is_ref_self := false
    if is_method {
        method_owner = db.get_method_owner(binding_id)
        method_node := (&(*db).hir).lhs(binding_id)
        while method_node < binding_id {
            if ((&(*db).hir).kind(method_node) == k.member) and
               ((&(*db).hir).lhs(method_node) == hir_none()) {
                receiver = true
                break
            }
            method_node = method_node + 1
        }

        if receiver and (method_owner != id_none()) {
            owner_ty := db.get_const_type(method_owner)
            if (owner_ty != ty_id_none()) and
                ((&(*db).types).kind(ret_ty) == ty_kind().ptr) and
                ((&(*db).types).payload(ret_ty) == owner_ty) {
                is_ref_self = true
            }
        }
    }

    if (params_slice.len > 0) or receiver {
        p_fmt := Fmt.new(arena)
        first_p := true
        if receiver {
            owner_ty := db.get_const_type(method_owner)
            p_fmt.str(ccg.type_str(&(*db).types, arena, owner_ty))
            p_fmt.cstr("* _self")
            first_p = false
        }
        orig_params := (&(*db).types).func_params(orig_func_ty)
        i: u64 = 0
        while i < params_slice.len {
            if is_mono and (*(orig_params.ptr + i) == ty_id_type()) {
                i = i + 1
                cont
            }
            p_ty     := *(params_slice.ptr + i)
            p_ty_str := ccg.type_str(&(*db).types, arena, p_ty)
            if not first_p { p_fmt.cstr(", ") }
            p_fmt.str(p_ty_str).cstr(" ")

            if is_extern {
                p_fmt.cstr("_a").uint32(i as u32)
            } else {
                args_list_id := (&(*db).hir).lhs(func_id)
                if args_list_id != hir_none() {
                    args := db.get_list(args_list_id)
                    arg_node := *(args.ptr + i)
                    arg_ident := (&(*db).hir).lhs(arg_node)
                    arg_sym := db.get_hir_symbol(arg_ident)
                    if arg_sym != id_none() {
                        p_fmt.str(ccg.sym_name(arena, arg_sym))
                    } else {
                        p_fmt.cstr("_a").uint32(i as u32)
                    }
                } else {
                    p_fmt.cstr("_a").uint32(i as u32)
                }
            }
            first_p = false
            i = i + 1
        }
        params_str = p_fmt.as_str()
        if params_str.len == 0 { params_str = Str.of("void") }
    }

    if is_extern {
        ret
    }

    queue := VecU32.new()
    type_queue := VecU32.new()

    add_type_to_queue(db, ret_ty, &type_queue)
    param_index: u64 = 0
    while param_index < params_slice.len {
        add_type_to_queue(db, *(params_slice.ptr + param_index), &type_queue)
        param_index = param_index + 1
    }

    if receiver {
        add_type_to_queue(db, db.get_const_type(method_owner), &type_queue)
    }

    ccg.start_function(fn_name, ret_str, params_str)

    body_val := lower_expr(db, ccg, arena, body_id, visited, &queue, &type_queue)

    if is_ref_self {
        if body_val.len > 0 {
            ccg.expr(body_val)
        }
        ccg.gen_return(Str.of("_self"), true)
    } else if (&(*db).types).kind(ret_ty) == ty_kind().unit {
        if body_val.len > 0 {
            ccg.expr(body_val)
        }
        ccg.gen_return(Str.empty(), false)
    } else if body_val.len > 0 {
        ccg.gen_return(body_val, true)
    }

    ccg.end_function()

    if is_mono {
        db.set_const_type(func_id, orig_func_ty)
    }

    q_i: u64 = 0
    while q_i < queue.len {
        q_sym := queue.get(q_i)
        lower_function(eng, arena, q_sym, visited)
        q_i = q_i + 1
    }

    sorted := topo_sort(&(*db).types, &type_queue)

    s_i: u64 = 0
    while s_i < sorted.len {
        t := sorted.get(s_i)
        if ((&(*db).types).kind(t) == ty_kind().struct_) or
           ((&(*db).types).kind(t) == ty_kind().nominal) {
            ccg.define_struct(&(*db).types, arena, t)
        } else if (&(*db).types).kind(t) == ty_kind().func {
            ccg.define_func_type(&(*db).types, arena, t)
        } else if (&(*db).types).kind(t) == ty_kind().union_ {
            ccg.define_union(&(*db).types, arena, t)
        } else if (&(*db).types).kind(t) == ty_kind().enum_ {
            ccg.define_enum(&(*db).types, arena, t)
        }
        s_i = s_i + 1
    }
    sorted.destroy()
    type_queue.destroy()
    queue.destroy()
}

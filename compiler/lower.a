import Nexus, Nexus_get_list, Nexus_get_hir_symbol, Nexus_get_sym_hir, Nexus_print_loc,
       Nexus_get_method_owner, Nexus_get_method_target, Nexus_get_const_type from "nexus/nexus.a"
import HirTable, HirTable_kind, HirTable_lhs, HirTable_rhs, HirTable_extra, hir_kind, hir_none, HirExprKind from "hir.a"
import PoolU32_get, id_none from "nexus/pool.a"
import CCodeGen, CCodeGen_declare_function, CCodeGen_start_function, CCodeGen_end_function, CCodeGen_start_if, CCodeGen_end_block,
       CCodeGen_create_variable, CCodeGen_expr, CCodeGen_gen_return, CCodeGen_else, CCodeGen_start_while, CCodeGen_def_struct from "codegen.a"
import Str, Str_from, Str_empty, String, String_new, String_push_str, String_push_u32, String_as_str from "../std/string.a"
import Arena from "../std/allocator.a"
import VecU32, VecU32_push, VecU32_get,VecU32_new, VecU32_destroy from "../std/vec/u32.a"

import TypeStorage, ty_kind, ty_id_none, ty_id_type, TypeStorage_kind, TypeStorage_payload, TypeStorage_name, TypeStorage_get_struct_fields,
       TypeStorage_func_return, TypeStorage_func_params, TypeStorage_func_is_extern from "types.a"
import UnifyStorage_get_slot, UnifyStorage_resolve_type_deep, slot_none from "unify.a"
import Interner_get from "../std/interner.a"
import topo_sort from "topo_sort.a"
import fall from "../std/sys.a"

print :: (s &u8) unit


c_type_str :: (types &TypeStorage, arena &Arena, ty_id u32) Str {
    if ty_id == ty_id_none() {
        print("\n[codegen error] missing type\n")
        fall()
    }
    k := ty_kind()
    kind := TypeStorage_kind(types, ty_id)
    payload := TypeStorage_payload(types, ty_id)

    if kind == k.unit { ret Str_from("void") }
    if kind == k.bool { ret Str_from("bool") }

    if kind == k.int {
        if payload == 8   { ret Str_from("int8_t") }
        if payload == 16  { ret Str_from("int16_t") }
        if payload == 32  { ret Str_from("int32_t") }
        if payload == 64  { ret Str_from("int64_t") }
        if payload == 128 { ret Str_from("__int128") }
        print("\n[codegen error] unsupported integer width\n")
        fall()
        ret Str_empty()
    }

    if kind == k.uint {
        if payload == 8   { ret Str_from("uint8_t") }
        if payload == 16  { ret Str_from("uint16_t") }
        if payload == 32  { ret Str_from("uint32_t") }
        if payload == 64  { ret Str_from("uint64_t") }
        if payload == 128 { ret Str_from("unsigned __int128") }
        print("\n[codegen error] unsupported integer width\n")
        fall()
        ret Str_empty()
    }

    if kind == k.float {
        if payload == 32 { ret Str_from("float") }
        if payload == 64 { ret Str_from("double") }
        print("\n[codegen error] unsupported float width\n")
        fall()
        ret Str_empty()
    }

    if kind == k.untyped_int   { ret Str_from("int32_t") }
    if kind == k.untyped_float { ret Str_from("double") }

    if kind == k.ptr {
        inner_ty := TypeStorage_payload(types, ty_id)
        inner_str := c_type_str(types, arena, inner_ty)
        s := String_new(arena)
        String_push_str(&s, inner_str)
        String_push_str(&s, Str_from("*"))
        ret String_as_str(&s)
    }

    if (kind == k.struct_) or (kind == k.nominal) {
        ret TypeStorage_name(types, arena, ty_id)
    }

    if (kind == k.infer) or (kind == k.unknown) or (kind == k.error) {
        print("\n[codegen error] unresolved type\n")
        fall()
    }

    print("\n[codegen error] unsupported type\n")
    fall()
    Str_empty()
}

get_node_type :: (db &Nexus, id u32) u32 {
    if id == hir_none() { ret ty_id_none() }
    slot := UnifyStorage_get_slot(&(*db).unify, id)
    if slot == slot_none() { ret ty_id_none() }
    UnifyStorage_resolve_type_deep(&(*db).unify, &(*db).types, slot)
}

vec_contains :: (v &VecU32, val u32) bool {
    i: u64 = 0
    while i < (*v).len {
        if VecU32_get(v, i) == val { ret true }
        i = i + 1
    }
    false
}

method_tag :: () u32 { 2147483648 }

is_lvalue :: (db &Nexus, id u32) bool {
    tbl := &(*db).hir
    kind := HirTable_kind(tbl, id)
    if kind == hir_kind().ident { ret get_node_type(db, id) != ty_id_type() }
    if kind == hir_kind().unary_deref { ret true }
    if kind == hir_kind().struct_init { ret true }
    if kind == hir_kind().member {
        lhs := HirTable_lhs(tbl, id)
        if lhs == hir_none() { ret true }
        if TypeStorage_kind(&(*db).types, get_node_type(db, lhs)) == ty_kind().ptr { ret true }
        ret is_lvalue(db, lhs)
    }
    false
}

binary_op_symbol :: (k HirExprKind, kind u8) Str {
    if kind == k.binary_add     { ret Str_from(" + ") }
    if kind == k.binary_sub     { ret Str_from(" - ") }
    if kind == k.binary_mul     { ret Str_from(" * ") }
    if kind == k.binary_div     { ret Str_from(" / ") }
    if kind == k.binary_mod     { ret Str_from(" % ") }
    if kind == k.binary_eq_eq   { ret Str_from(" == ") }
    if kind == k.binary_neq     { ret Str_from(" != ") }
    if kind == k.binary_lt      { ret Str_from(" < ") }
    if kind == k.binary_gt      { ret Str_from(" > ") }
    if kind == k.binary_lt_eq   { ret Str_from(" <= ") }
    if kind == k.binary_gt_eq   { ret Str_from(" >= ") }
    if kind == k.binary_bit_and { ret Str_from(" & ") }
    if kind == k.binary_bit_or  { ret Str_from(" | ") }
    if kind == k.binary_bit_xor { ret Str_from(" ^ ") }
    if kind == k.binary_shl     { ret Str_from(" << ") }
    if kind == k.binary_shr     { ret Str_from(" >> ") }
    if kind == k.binary_eq_eq   { ret Str_from(" == ") }
    if kind == k.binary_neq     { ret Str_from(" != ") }
    if kind == k.binary_lt      { ret Str_from(" < ") }
    if kind == k.binary_gt      { ret Str_from(" > ") }
    if kind == k.binary_lt_eq   { ret Str_from(" <= ") }
    if kind == k.binary_gt_eq   { ret Str_from(" >= ") }
    if kind == k.binary_bit_and { ret Str_from(" & ") }
    if kind == k.binary_bit_or  { ret Str_from(" | ") }
    if kind == k.binary_bit_xor { ret Str_from(" ^ ") }
    if kind == k.binary_shl     { ret Str_from(" << ") }
    if kind == k.binary_shr     { ret Str_from(" >> ") }
    if kind == k.binary_and     { ret Str_from(" && ") }
    if kind == k.binary_or      { ret Str_from(" || ") }
    Str_from(" ")
}


add_type_to_queue :: (db &Nexus, ty_id u32, queue &VecU32) {
    if ty_id == ty_id_none() { ret }
    k := ty_kind()
    kind := TypeStorage_kind(&(*db).types, ty_id)

    if (kind == k.struct_) or (kind == k.nominal) {
        if not vec_contains(queue, ty_id) {
            VecU32_push(queue, ty_id)
            fields := TypeStorage_get_struct_fields(&(*db).types, ty_id)
            count := fields.len / 2
            i: u64 = 0
            while i < count {
                f_ty := *(fields.ptr + (i * 2) + 1)
                add_type_to_queue(db, f_ty, queue)
                i = i + 1
            }
        }
    } else if kind == k.ptr {
        inner := TypeStorage_payload(&(*db).types, ty_id)
        add_type_to_queue(db, inner, queue)
    }
}

lower_expr :: (db &Nexus, ccg &CCodeGen, arena &Arena, id u32, visited &VecU32, queue &VecU32, type_queue &VecU32) Str {
    k := hir_kind()
    kind := HirTable_kind(&(*db).hir, id)

    if kind == k.lit_int {
        val := HirTable_lhs(&(*db).hir, id)
        s := String_new(arena)
        String_push_u32(&s, val)
        ret String_as_str(&s)
    }

    if kind == k.ident {
        ty := get_node_type(db, id)
        sym_id := Nexus_get_hir_symbol(db, id)

        if TypeStorage_kind(&(*db).types, ty) == ty_kind().func {
            if sym_id != id_none() {
                real_sym := sym_id
                while true {
                    tgt := PoolU32_get(&(*db).sym_target, real_sym)
                    if (tgt == id_none()) or (tgt == real_sym) { break }
                    real_sym = tgt
                }
                if not vec_contains(queue, real_sym) {
                    VecU32_push(queue, real_sym)
                }
                if TypeStorage_func_is_extern(&(*db).types, ty) {
                    name_id := HirTable_lhs(&(*db).hir, id)
                    ret Interner_get(&(*db).interner, name_id)
                }
                s := String_new(arena)
                String_push_str(&s, Str_from("sym_"))
                String_push_u32(&s, real_sym)
                ret String_as_str(&s)
            }
        }

        if sym_id != id_none() {
            real_sym := sym_id
            while true {
                target := PoolU32_get(&(*db).sym_target, real_sym)
                if (target == id_none()) or (target == real_sym) { break }
                real_sym = target
            }
            if PoolU32_get(&(*db).sym_tok_start, real_sym) != id_none() {
                print("\n[codegen error] unsupported global value\n       --> ")
                Nexus_print_loc(db, id)
                print("\n")
                fall()
            }
            s := String_new(arena)
            String_push_str(&s, Str_from("sym_"))
            String_push_u32(&s, sym_id)
            ret String_as_str(&s)
        }

        print("\n[codegen error] undefined identifier\n       --> ")
        Nexus_print_loc(db, id)
        print("\n")
        fall()
        ret Str_empty()
    }
    if kind == k.var {
        ident_id := HirTable_lhs(&(*db).hir, id)
        val_id   := HirTable_extra(&(*db).hir, id)

        sym_id := Nexus_get_hir_symbol(db, ident_id)
        var_ty := get_node_type(db, ident_id)
        if TypeStorage_kind(&(*db).types, var_ty) == ty_kind().unit {
            print("\n[type error] variable cannot have unit type\n       --> ")
            Nexus_print_loc(db, id)
            print("\n")
            fall()
        }
        ty_str := c_type_str(&(*db).types, arena, var_ty)



        var_name_s := String_new(arena)
        String_push_str(&var_name_s, Str_from("sym_"))
        String_push_u32(&var_name_s, sym_id)
        var_name := String_as_str(&var_name_s)


        if val_id != hir_none() {
            val_str := lower_expr(db, ccg, arena, val_id, visited, queue, type_queue)
            if val_str.len == 0 {
                print("\n[codegen error] initializer does not produce a value\n       --> ")
                Nexus_print_loc(db, id)
                print("\n")
                fall()
            }
            CCodeGen_create_variable(ccg, var_name, ty_str, val_str, true)
        } else {
            CCodeGen_create_variable(ccg, var_name, ty_str, Str_empty(), false)
        }

        add_type_to_queue(db, var_ty, type_queue)

        ret Str_empty()
    }

    if kind == k.binary_assign {
        lhs_id := HirTable_lhs(&(*db).hir, id)
        rhs_id := HirTable_rhs(&(*db).hir, id)

        lhs_str := lower_expr(db, ccg, arena, lhs_id, visited, queue, type_queue)
        rhs_str := lower_expr(db, ccg, arena, rhs_id, visited, queue, type_queue)

        s := String_new(arena)
        String_push_str(&s, lhs_str)
        String_push_str(&s, Str_from(" = "))
        String_push_str(&s, rhs_str)
        ret String_as_str(&s)
    }

    if (kind == k.binary_add) or (kind == k.binary_sub) or (kind == k.binary_mul) or
       (kind == k.binary_div) or (kind == k.binary_mod) or (kind == k.binary_eq_eq) or
       (kind == k.binary_neq) or (kind == k.binary_lt) or (kind == k.binary_gt) or
       (kind == k.binary_lt_eq) or (kind == k.binary_gt_eq) or (kind == k.binary_bit_and) or
       (kind == k.binary_bit_or) or (kind == k.binary_bit_xor) or (kind == k.binary_shl) or
       (kind == k.binary_shr) or (kind == k.binary_and) or (kind == k.binary_or) {

        lhs_id := HirTable_lhs(&(*db).hir, id)
        rhs_id := HirTable_rhs(&(*db).hir, id)

        lhs_val := lower_expr(db, ccg, arena, lhs_id, visited, queue, type_queue)
        rhs_val := lower_expr(db, ccg, arena, rhs_id, visited, queue, type_queue)
        op_str  := binary_op_symbol(k, kind)

        s := String_new(arena)
        String_push_str(&s, Str_from("("))
        String_push_str(&s, lhs_val)
        String_push_str(&s, op_str)
        String_push_str(&s, rhs_val)
        String_push_str(&s, Str_from(")"))
        ret String_as_str(&s)
    }

    if kind == k.call {
        callee_id := HirTable_lhs(&(*db).hir, id)
        args_list := HirTable_rhs(&(*db).hir, id)
        method := Nexus_get_method_target(db, callee_id)

        callee_sym := Nexus_get_hir_symbol(db, callee_id)
        if callee_sym != id_none() {
            if not vec_contains(queue, callee_sym) {
                VecU32_push(queue, callee_sym)
            }
        }
        callee_str := Str_empty()
        if method != id_none() {
            tagged := method | method_tag()
            if not vec_contains(queue, tagged) { VecU32_push(queue, tagged) }
            fn_buf := String_new(arena)
            String_push_str(&fn_buf, Str_from("method_"))
            String_push_u32(&fn_buf, method)
            callee_str = String_as_str(&fn_buf)
        } else {
            callee_str = lower_expr(db, ccg, arena, callee_id, visited, queue, type_queue)
        }

        s := String_new(arena)
        String_push_str(&s, callee_str)
        String_push_str(&s, Str_from("("))

        has_receiver := false
        if method != id_none() {
            method_name := HirTable_lhs(&(*db).hir, method)
            node := method_name
            while node < method {
                if (HirTable_kind(&(*db).hir, node) == k.member) and
                   (HirTable_lhs(&(*db).hir, node) == hir_none()) {
                    has_receiver = true
                    break
                }
                node = node + 1
            }
        }

        if has_receiver {
            lhs := HirTable_lhs(&(*db).hir, callee_id)
            receiver_ty := get_node_type(db, lhs)
            receiver_str := lower_expr(db, ccg, arena, lhs, visited, queue, type_queue)
            depth: u32 = 0
            while TypeStorage_kind(&(*db).types, receiver_ty) == ty_kind().ptr {
                receiver_ty = TypeStorage_payload(&(*db).types, receiver_ty)
                depth = depth + 1
            }
            add_type_to_queue(db, receiver_ty, type_queue)

            if depth > 0 {
                while depth > 1 {
                    String_push_str(&s, Str_from("*"))
                    depth = depth - 1
                }
                String_push_str(&s, Str_from("("))
                String_push_str(&s, receiver_str)
                String_push_str(&s, Str_from(")"))
            } else if is_lvalue(db, lhs) {
                String_push_str(&s, Str_from("&("))
                String_push_str(&s, receiver_str)
                String_push_str(&s, Str_from(")"))
            } else {
                String_push_str(&s, Str_from("&(("))
                String_push_str(&s, c_type_str(&(*db).types, arena, receiver_ty))
                String_push_str(&s, Str_from("[]){"))
                String_push_str(&s, receiver_str)
                String_push_str(&s, Str_from("})[0]"))
            }
        }

        if args_list != hir_none() {
            args := Nexus_get_list(db, args_list)
            i: u64 = 0
            while i < args.len {
                arg_node := *(args.ptr + i)
                arg_val := lower_expr(db, ccg, arena, arg_node, visited, queue, type_queue)
                if has_receiver or (i > 0) { String_push_str(&s, Str_from(", ")) }
                String_push_str(&s, arg_val)
                i = i + 1
            }
        }

        String_push_str(&s, Str_from(")"))
        ret String_as_str(&s)
    }

   if kind == k.block {
        list_id := HirTable_lhs(&(*db).hir, id)
        items := Nexus_get_list(db, list_id)
        count := items.len
        last_val := Str_empty()

        i: u64 = 0
        while i < count {
            node_id := *(items.ptr + i)
            is_last := (i + 1) == count
            val := lower_expr(db, ccg, arena, node_id, visited, queue, type_queue)

            if not is_last {
                CCodeGen_expr(ccg, val)
            } else {
                last_val = val
            }
            i = i + 1
        }

        ret last_val
    }

    if kind == k.lit_float {
        name_id := HirTable_lhs(&(*db).hir, id)
        ret Interner_get(&(*db).interner, name_id)
    }
    if kind == k.lit_bool_true  { ret Str_from("true") }
    if kind == k.lit_bool_false { ret Str_from("false") }
    if kind == k.lit_str {
        name_id := HirTable_lhs(&(*db).hir, id)
        raw := Interner_get(&(*db).interner, name_id)
        s := String_new(arena)
        String_push_str(&s, Str_from("((uint8_t*)"))
        String_push_str(&s, raw)
        String_push_str(&s, Str_from(")"))
        ret String_as_str(&s)
    }


    if kind == k.unary_neg {
        child_v := lower_expr(db, ccg, arena, HirTable_lhs(&(*db).hir, id), visited, queue, type_queue)
        s := String_new(arena)
        String_push_str(&s, Str_from("(-("))
        String_push_str(&s, child_v)
        String_push_str(&s, Str_from("))"))
        ret String_as_str(&s)
    }
    if kind == k.unary_not {
        child_v := lower_expr(db, ccg, arena, HirTable_lhs(&(*db).hir, id), visited, queue, type_queue)
        s := String_new(arena)
        String_push_str(&s, Str_from("(!("))
        String_push_str(&s, child_v)
        String_push_str(&s, Str_from("))"))
        ret String_as_str(&s)
    }
    if kind == k.unary_bit_not {
        child_v := lower_expr(db, ccg, arena, HirTable_lhs(&(*db).hir, id), visited, queue, type_queue)
        s := String_new(arena)
        String_push_str(&s, Str_from("(~("))
        String_push_str(&s, child_v)
        String_push_str(&s, Str_from("))"))
        ret String_as_str(&s)
    }
    if kind == k.unary_addr_of {
        child_v := lower_expr(db, ccg, arena, HirTable_lhs(&(*db).hir, id), visited, queue, type_queue)
        s := String_new(arena)
        String_push_str(&s, Str_from("(&("))
        String_push_str(&s, child_v)
        String_push_str(&s, Str_from("))"))
        ret String_as_str(&s)
    }
    if kind == k.unary_deref {
        child_v := lower_expr(db, ccg, arena, HirTable_lhs(&(*db).hir, id), visited, queue, type_queue)
        s := String_new(arena)
        String_push_str(&s, Str_from("(*("))
        String_push_str(&s, child_v)
        String_push_str(&s, Str_from("))"))
        ret String_as_str(&s)
    }
    if kind == k.k_break {
        CCodeGen_expr(ccg, Str_from("break"))
        ret Str_empty()
    }
    if kind == k.k_cont {
        CCodeGen_expr(ccg, Str_from("continue"))
        ret Str_empty()
    }

    if kind == k.cast {
        lhs_v := lower_expr(db, ccg, arena, HirTable_lhs(&(*db).hir, id), visited, queue, type_queue)
        ty_str := c_type_str(&(*db).types, arena, get_node_type(db, id))
        s := String_new(arena)
        String_push_str(&s, Str_from("(("))
        String_push_str(&s, ty_str)
        String_push_str(&s, Str_from(")"))
        String_push_str(&s, lhs_v)
        String_push_str(&s, Str_from(")"))
        ret String_as_str(&s)
    }

    if kind == k.k_if {
        cond_str := lower_expr(db, ccg, arena, HirTable_lhs(&(*db).hir, id), visited, queue, type_queue)
        CCodeGen_start_if(ccg, cond_str)

        then_val := lower_expr(db, ccg, arena, HirTable_rhs(&(*db).hir, id), visited, queue, type_queue)
        if then_val.len > 0 { CCodeGen_expr(ccg, then_val) }

        elseb_id := HirTable_extra(&(*db).hir, id)
        if elseb_id != hir_none() {
            CCodeGen_else(ccg)
            else_val := lower_expr(db, ccg, arena, elseb_id, visited, queue, type_queue)
            if else_val.len > 0 { CCodeGen_expr(ccg, else_val) }
        }
        CCodeGen_end_block(ccg)
        ret Str_empty()
    }

    if kind == k.k_while {
        cond_str: Str = lower_expr(db, ccg, arena, HirTable_lhs(&(*db).hir, id), visited, queue, type_queue)
        CCodeGen_start_while(ccg, cond_str)

        body_val := lower_expr(db, ccg, arena, HirTable_rhs(&(*db).hir, id), visited, queue, type_queue)
        if body_val.len > 0 { CCodeGen_expr(ccg, body_val) }

        CCodeGen_end_block(ccg)
        ret Str_empty()
    }

    if kind == k.k_ret {
        val_id := HirTable_lhs(&(*db).hir, id)
        if val_id != hir_none() {
            val_str := lower_expr(db, ccg, arena, val_id, visited, queue, type_queue)
            CCodeGen_gen_return(ccg, val_str, true)
        } else {
            CCodeGen_gen_return(ccg, Str_empty(), false)
        }
        ret Str_empty()
    }


    if kind == k.struct_init {
        ty_id := get_node_type(db, id)
        add_type_to_queue(db, ty_id, type_queue)
        struct_name := c_type_str(&(*db).types, arena, ty_id)

        fields_list := HirTable_lhs(&(*db).hir, id)
        vals_list   := HirTable_rhs(&(*db).hir, id)

        fields := Nexus_get_list(db, fields_list)
        vals   := Nexus_get_list(db, vals_list)

        s := String_new(arena)
        String_push_str(&s, Str_from("(("))
        String_push_str(&s, struct_name)
        String_push_str(&s, Str_from("){"))

        i: u64 = 0
        while (i < fields.len) and (i < vals.len) {
            f_node := *(fields.ptr + i)
            v_node := *(vals.ptr + i)

            f_name_id := HirTable_lhs(&(*db).hir, f_node)
            v_str := lower_expr(db, ccg, arena, v_node, visited, queue, type_queue)

            String_push_str(&s, Str_from("._f"))
            String_push_u32(&s, f_name_id)
            String_push_str(&s, Str_from(" = "))
            String_push_str(&s, v_str)

            if (i + 1) < fields.len {
                String_push_str(&s, Str_from(", "))
            }
            i = i + 1
        }

        String_push_str(&s, Str_from("})"))
        ret String_as_str(&s)
    }

    if kind == k.member {
        lhs_id := HirTable_lhs(&(*db).hir, id)
        rhs_id := HirTable_rhs(&(*db).hir, id)

        method := Nexus_get_method_target(db, id)
        if method != id_none() {
            print("\n[type error] methods must be called directly; method values are not supported\n       --> ")
            Nexus_print_loc(db, id)
            print("\n")
            fall()
        }

        if lhs_id == hir_none() {
            field_id := HirTable_lhs(&(*db).hir, rhs_id)
            self_field := String_new(arena)
            String_push_str(&self_field, Str_from("(_self->_f"))
            String_push_u32(&self_field, field_id)
            String_push_str(&self_field, Str_from(")"))
            ret String_as_str(&self_field)
        }

        if (lhs_id == hir_none()) or (rhs_id == hir_none()) {
            ret Str_empty()
        }

        lhs_str := lower_expr(db, ccg, arena, lhs_id, visited, queue, type_queue)
        field_name_id := HirTable_lhs(&(*db).hir, rhs_id)

        lhs_ty := get_node_type(db, lhs_id)
        depth: u32 = 0
        while TypeStorage_kind(&(*db).types, lhs_ty) == ty_kind().ptr {
            lhs_ty = TypeStorage_payload(&(*db).types, lhs_ty)
            depth = depth + 1
        }

        s := String_new(arena)
        String_push_str(&s, Str_from("("))
        while depth > 0 {
            String_push_str(&s, Str_from("*("))
            depth = depth - 1
        }
        String_push_str(&s, lhs_str)
        depth = 0
        lhs_ty = get_node_type(db, lhs_id)
        while TypeStorage_kind(&(*db).types, lhs_ty) == ty_kind().ptr {
            lhs_ty = TypeStorage_payload(&(*db).types, lhs_ty)
            String_push_str(&s, Str_from(")"))
        }
        String_push_str(&s, Str_from(")._f"))
        String_push_u32(&s, field_name_id)
        ret String_as_str(&s)
    }

    print("\n[codegen error] unsupported expression\n       --> ")
    Nexus_print_loc(db, id)
    print("\n")
    fall()
    Str_empty()
}

lower_function :: (db &Nexus, ccg &CCodeGen, arena &Arena, sym_id u32, visited &VecU32) {
    if sym_id == id_none() {
        ret
    }

    is_method := (sym_id & method_tag()) != 0
    real_sym := sym_id
    if not is_method {
        while true {
            tgt := PoolU32_get(&(*db).sym_target, real_sym)
            if (tgt == id_none()) or (tgt == real_sym) {
                break
            }
            real_sym = tgt
        }
    }

    if vec_contains(visited, real_sym) {
        ret
    }
    VecU32_push(visited, real_sym)

    binding_id := id_none()
    if is_method {
        binding_id = real_sym & 2147483647
    } else {
        hir_end := PoolU32_get(&(*db).sym_hir_end, real_sym)
        if (hir_end == 0) or (hir_end == id_none()) { ret }
        binding_id = hir_end - 1
    }
    k := hir_kind()

    if HirTable_kind(&(*db).hir, binding_id) != k.binding {
        ret
    }

    func_id := HirTable_extra(&(*db).hir, binding_id)
    if HirTable_kind(&(*db).hir, func_id) != k.function {
        ret
    }

    func_ty := get_node_type(db, func_id)
    ret_ty  := TypeStorage_func_return(&(*db).types, func_ty)
    ret_str := c_type_str(&(*db).types, arena, ret_ty)

    body_id   := HirTable_extra(&(*db).hir, func_id)
    is_extern := (body_id == hir_none()) or TypeStorage_func_is_extern(&(*db).types, func_ty)

    fn_name := Str_empty()
    if is_extern and (not is_method) {
        name_hir := HirTable_lhs(&(*db).hir, binding_id)
        name_id  := HirTable_lhs(&(*db).hir, name_hir)
        fn_name   = Interner_get(&(*db).interner, name_id)
    } else {
        fn_name_s := String_new(arena)
        if is_method {
            String_push_str(&fn_name_s, Str_from("method_"))
            String_push_u32(&fn_name_s, binding_id)
        } else {
            String_push_str(&fn_name_s, Str_from("sym_"))
            String_push_u32(&fn_name_s, real_sym)
        }
        fn_name = String_as_str(&fn_name_s)
    }

    params_slice := TypeStorage_func_params(&(*db).types, func_ty)
    params_str   := Str_from("void")

    receiver := false
    method_owner := id_none()
    if is_method {
        method_owner = Nexus_get_method_owner(db, binding_id)
        method_node := HirTable_lhs(&(*db).hir, binding_id)
        while method_node < binding_id {
            if (HirTable_kind(&(*db).hir, method_node) == k.member) and
               (HirTable_lhs(&(*db).hir, method_node) == hir_none()) {
                receiver = true
                break
            }
            method_node = method_node + 1
        }
    }

    if (params_slice.len > 0) or receiver {
        p_buf := String_new(arena)
        if receiver {
            owner_ty := Nexus_get_const_type(db, method_owner)
            String_push_str(&p_buf, c_type_str(&(*db).types, arena, owner_ty))
            String_push_str(&p_buf, Str_from("* _self"))
            if params_slice.len > 0 { String_push_str(&p_buf, Str_from(", ")) }
        }
        i: u64 = 0
        while i < params_slice.len {
            p_ty     := *(params_slice.ptr + i)
            p_ty_str := c_type_str(&(*db).types, arena, p_ty)
            String_push_str(&p_buf, p_ty_str)
            String_push_str(&p_buf, Str_from(" "))

            if is_extern {
                String_push_str(&p_buf, Str_from("_a"))
                String_push_u32(&p_buf, i as u32)
            } else {
                args_list_id := HirTable_lhs(&(*db).hir, func_id)
                if args_list_id != hir_none() {
                    args := Nexus_get_list(db, args_list_id)
                    arg_node := *(args.ptr + i)
                    arg_ident := HirTable_lhs(&(*db).hir, arg_node)
                    arg_sym := Nexus_get_hir_symbol(db, arg_ident)

                    String_push_str(&p_buf, Str_from("sym_"))
                    String_push_u32(&p_buf, arg_sym)
                }
            }

            if (i + 1) < params_slice.len {
                String_push_str(&p_buf, Str_from(", "))
            }
            i = i + 1
        }
        params_str = String_as_str(&p_buf)
    }

    if is_extern {
        ret
    }

    queue := VecU32_new()
    type_queue := VecU32_new()

    add_type_to_queue(db, ret_ty, &type_queue)
    param_index: u64 = 0
    while param_index < params_slice.len {
        add_type_to_queue(db, *(params_slice.ptr + param_index), &type_queue)
        param_index = param_index + 1
    }

    if receiver {
        add_type_to_queue(db, Nexus_get_const_type(db, method_owner), &type_queue)
    }

    CCodeGen_start_function(ccg, fn_name, ret_str, params_str)
    body_val := lower_expr(db, ccg, arena, body_id, visited, &queue, &type_queue)

    if TypeStorage_kind(&(*db).types, ret_ty) == ty_kind().unit {
        if body_val.len > 0 {
            CCodeGen_expr(ccg, body_val)
        }
        CCodeGen_gen_return(ccg, Str_empty(), false)
    } else if body_val.len > 0 {
        CCodeGen_gen_return(ccg, body_val, true)
    }

    CCodeGen_end_function(ccg)

    q_i: u64 = 0
    while q_i < queue.len {
        q_sym := VecU32_get(&queue, q_i)
        lower_function(db, ccg, arena, q_sym, visited)
        q_i = q_i + 1
    }

    sorted := topo_sort(&(*db).types, &type_queue)
    s_i: u64 = 0
    while s_i < sorted.len {
        t := VecU32_get(&sorted, s_i)
        if (TypeStorage_kind(&(*db).types, t) == ty_kind().struct_) or
           (TypeStorage_kind(&(*db).types, t) == ty_kind().nominal) {
            s_name := TypeStorage_name(&(*db).types, arena, t)
            body_buf := String_new(arena)
            s_fields := TypeStorage_get_struct_fields(&(*db).types, t)
            f_count := s_fields.len / 2

            f_i: u64 = 0
            while f_i < f_count {
                fn_name := *(s_fields.ptr + (f_i * 2))
                fn_ty   := *(s_fields.ptr + (f_i * 2) + 1)
                fn_ty_str := c_type_str(&(*db).types, arena, fn_ty)

                String_push_str(&body_buf, Str_from("    "))
                String_push_str(&body_buf, fn_ty_str)
                String_push_str(&body_buf, Str_from(" _f"))
                String_push_u32(&body_buf, fn_name)
                String_push_str(&body_buf, Str_from(";\n"))
                f_i = f_i + 1
            }

            CCodeGen_def_struct(ccg, t, s_name, String_as_str(&body_buf))
        }
        s_i = s_i + 1
    }
    VecU32_destroy(&sorted)
    VecU32_destroy(&type_queue)
    VecU32_destroy(&queue)
}

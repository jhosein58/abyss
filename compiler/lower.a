import std.allocator: Arena
import std.string:    Str
import std.sys:       fall

import .hir: HirExprKind, HirTable, hir_kind, hir_none
import .lexer: decode_char_lit
import .nexus.nexus: Nexus
import .nexus.pool: id_none
import .topo_sort: topo_sort
import .typer.fn: func_has_self
import .typer.reflection: macro_template, reflection_error, reflection_quote, reflection_read, reflection_value
import .types: TyKind, TypeStorage, ty_id_bool, ty_id_none, ty_id_type, ty_id_unit, ty_id_untyped_int
import .vm.codegen: VmCodeBuilder, VmCodeGen, VmVal, VmValKind, vm_element_size
import .vm.op: OpCode

LowerCtx :: fn(B type, L type, V type) type {
    struct {
        db         &Nexus
        ccg        &B
        builder    &L
        empty      V
        arena      &Arena
        visited    &HashSet(u32)
        queue      &Vec(u32)
        type_queue &Vec(u32)
    global_init bool
    }
}

iterator_is_ref :: fn(db &Nexus, ty_id u32) bool {
    types := &db.types
    if (ty_id == ty_id_none()) or (types.kind(ty_id) != TyKind.nominal) {
        ret false
    }
    name_id := db.interner.intern(Str.of("RefIterator"))
    ref_sym := db.find_symbol(db.core_prelude, name_id)
    origin := types.nominal_origin(ty_id)
    creator := types.get_nominal_creator_sym(origin)
    if ref_sym == id_none() {
        ret false
    }
    db.resolve_sym(creator) == db.resolve_sym(ref_sym)
}

is_lvalue :: fn(db &Nexus, id u32) bool {
    kind := db.hir.kind(id)
    if kind == hir_kind.ident {
        ret db.get_node_type(id) != ty_id_type()
    }
    if kind == hir_kind.unary_deref {
        ret true
    }
    if kind == hir_kind.struct_init {
        ret true
    }
    if kind == hir_kind.member {
        lhs := db.hir.lhs(id)
        if lhs == hir_none() {
            ret true
        }
        if db.types.kind(db.get_node_type(lhs)) == TyKind.ptr {
            ret true
        }
        ret is_lvalue(db, lhs)
    }
    if kind == hir_kind.index {
        ret true
    }
    false
}

add_type_to_queue :: fn(db &Nexus, ty_id u32, queue &Vec(u32)) {
    if ty_id == ty_id_none() {
        ret
    }
    if db.types.has_infer(ty_id) {
        ret
    }
    kind := db.types.kind(ty_id)

    if (kind == TyKind.struct_) or (kind == TyKind.nominal) {
        if not queue.contains(ty_id) {
            queue.push(ty_id)
            fields := db.types.get_struct_fields(ty_id)
            count := fields.len / 2
            i: u64 = 0
            while i < count {
                f_ty := *(fields.ptr + (i * 2) + 1)
                add_type_to_queue(db, f_ty, queue)
                i = i + 1
            }
        }
    } else if kind == TyKind.array {
        if not queue.contains(ty_id) {
            queue.push(ty_id)
            inner := db.types.get_array_type(ty_id)
            add_type_to_queue(db, inner, queue)
        }
    } else if kind == TyKind.ptr {
        inner := db.types.payload(ty_id)
        add_type_to_queue(db, inner, queue)
    } else if kind == TyKind.func {
        if not queue.contains(ty_id) {
            queue.push(ty_id)
            ret_ty := db.types.func_return(ty_id)
            add_type_to_queue(db, ret_ty, queue)
            params := db.types.func_params(ty_id)
            i: u64 = 0
            while i < params.len {
                add_type_to_queue(db, *(params.ptr + i), queue)
                i = i + 1
            }
        }
    } else if kind == TyKind.union_ {
        if not queue.contains(ty_id) {
            queue.push(ty_id)
            members := db.types.union_members(ty_id)
            i: u64 = 0
            while i < members.len {
                add_type_to_queue(db, *(members.ptr + i), queue)
                i = i + 1
            }
        }
    } else if kind == TyKind.enum_ {
        if not queue.contains(ty_id) {
            queue.push(ty_id)
            backing := db.types.enum_backing(ty_id)
            add_type_to_queue(db, backing, queue)
        }
    }
}

resolve_call_symbol :: fn(db &Nexus, id u32, callee_id u32, queue &Vec(u32)) u32 {
    target_sym := db.get_hir_symbol(callee_id)
    if (target_sym == id_none()) and (db.hir.kind(callee_id) == hir_kind.function) {
        target_sym = db.get_hir_symbol(callee_id)
    }
    if target_sym != id_none() {
        target_sym = db.resolve_sym(target_sym)
    }
    if target_sym == id_none() or db.global_var(target_sym) != hir_none() {
        ret id_none()
    }
    mono_func_ty := db.get_const_type(id)
    if mono_func_ty != ty_id_none() {
        mono_sym := db.find_mono_sym(target_sym, mono_func_ty)
        if mono_sym == id_none() {
            mono_sym = db.alloc_mono_sym(target_sym, mono_func_ty)
        }
        if not queue.contains(mono_sym) {
            queue.push(mono_sym)
        }
        ret mono_sym
    }
    if not queue.contains(target_sym) {
        queue.push(target_sym)
    }
    target_sym
}

emit_method_receiver :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32, callee_id u32, call_sym u32) V {
    db := ctx.db
    ccg := ctx.ccg
    arena := ctx.arena
    empty := ctx.empty
    if db.hir.kind(callee_id) != hir_kind.member {
        ret empty
    }
    callee_lhs := db.hir.lhs(callee_id)
    lhs_ty := db.get_node_type(callee_lhs)
    if (lhs_ty == ty_id_none()) or (lhs_ty == ty_id_type()) {
        ret empty
    }
    target_sym := call_sym
    if target_sym == id_none() {
        target_sym = db.get_hir_symbol(callee_id)
    }
    if target_sym == id_none() {
        ret empty
    }
    real_sym := db.resolve_sym(target_sym)
    func_node := db.get_fn_node(real_sym)
    if not func_has_self(db, func_node) {
        ret empty
    }
    func_ty := ty_id_none()
    if (call_sym != id_none()) and db.is_mono_sym(call_sym) {
        func_ty = db.get_mono_type(call_sym)
    }
    if func_ty == ty_id_none() {
        func_ty = db.get_const_type(id)
    }
    if func_ty == ty_id_none() {
        func_ty = db.get_node_type(callee_id)
    }
    if func_ty == ty_id_none() {
        func_ty = db.get_node_type(func_node)
    }
    if (func_ty == ty_id_none()) or (db.types.kind(func_ty) != TyKind.func) {
        ret empty
    }
    params := db.types.func_params(func_ty)
    if params.len == 0 {
        ret empty
    }
    p0_ty := *(params.ptr + 0)

    p_depth: u32 = 0
    t_p := db.types.unwrap_ptr_depth(p0_ty, &p_depth)

    r_depth: u32 = 0
    t_r := db.types.unwrap_ptr_depth(lhs_ty, &r_depth)

    lhs_val := lower_expr(ctx, callee_lhs)
    curr_ty := lhs_ty
    is_lv := is_lvalue(db, callee_lhs)
    while r_depth < p_depth {
        if not is_lv {
            add_type_to_queue(db, curr_ty, ctx.type_queue)
            ty_str := ccg.type_str(&db.types, arena, curr_ty)
            lhs_val = ccg.expr_address_of_value(arena, ty_str, lhs_val)
        } else {
            lhs_val = ccg.expr_typed_address(arena, lhs_val, curr_ty)
        }
        curr_ty = db.types.alloc_ptr(curr_ty)
        is_lv = false
        r_depth = r_depth + 1
    }
    while r_depth > p_depth {
        lhs_val = ccg.expr_deref(arena, lhs_val)
        curr_ty = db.types.payload(curr_ty)
        is_lv = true
        r_depth = r_depth - 1
    }
    lhs_val
}

lower_array_iter_call :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32, c_lhs u32, arr_ty u32, is_ref bool) V {
    db := ctx.db
    ccg := ctx.ccg
    arena := ctx.arena
    builder := ctx.builder
    type_queue := ctx.type_queue

    elem_ty := db.types.get_array_type(arr_ty)
    arr_len := db.types.get_array_len(arr_ty)
    iter_ty := db.get_node_type(id)
    add_type_to_queue(db, iter_ty, type_queue)
    add_type_to_queue(db, elem_ty, type_queue)

    ptr_id := db.interner.intern(Str.of("ptr"))
    len_id := db.interner.intern(Str.of("len"))
    index_id := db.interner.intern(Str.of("index"))

    lhs_val := lower_expr(ctx, c_lhs)
    curr_ty := db.get_node_type(c_lhs)
    while (db.types.kind(curr_ty) == TyKind.ptr) and (db.types.kind(db.types.payload(curr_ty)) == TyKind.ptr) {
        lhs_val = ccg.expr_deref(arena, lhs_val)
        curr_ty = db.types.payload(curr_ty)
    }
    if db.types.kind(curr_ty) != TyKind.ptr {
        if not is_lvalue(db, c_lhs) {
            add_type_to_queue(db, curr_ty, type_queue)
            ty_str := ccg.type_str(&db.types, arena, curr_ty)
            lhs_val = ccg.expr_address_of_value(arena, ty_str, lhs_val)
        } else {
            lhs_val = ccg.expr_typed_address(arena, lhs_val, curr_ty)
        }
    }
    ptr_elem_ty := db.types.alloc_ptr(elem_ty)
    ptr_ty_str := ccg.type_str(&db.types, arena, ptr_elem_ty)
    ptr_val := ccg.expr_cast(arena, ptr_ty_str, lhs_val)
    len_val := ccg.expr_u64(arena, arr_len as u64)
    index_val := ccg.expr_u64(arena, 0)

    struct_name := ccg.type_str(&db.types, arena, iter_ty)
    fields_fmt := builder.new_list(arena)
    builder.append_list_item(&fields_fmt, ccg.expr_struct_init_field(arena, ptr_id, ptr_val), true)
    builder.append_list_item(&fields_fmt, ccg.expr_struct_init_field(arena, len_id, len_val), false)
    builder.append_list_item(&fields_fmt, ccg.expr_struct_init_field(arena, index_id, index_val), false)
    ccg.expr_struct_init(arena, struct_name, builder.finish_list(&fields_fmt))
}

lower_builtin_call :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32) V {
    db := ctx.db
    ccg := ctx.ccg
    arena := ctx.arena
    empty := ctx.empty
    name_id := db.hir.lhs(id)
    name := db.interner.get(name_id)
    args := db.get_list(db.hir.rhs(id))

    if name.eq("trap") {
        ret ccg.intrinsic_trap()
    }
    if name.eq("memcpy") {
        values := ctx.builder.new_list(arena)
        for index in Range.new(0, 3) {
            ctx.builder.append_list_item(&values, lower_expr(ctx, args.ptr[index]), index == 0)
        }
        ret ccg.intrinsic_memcpy(arena, ctx.builder.finish_list(&values))
    }
    if name.eq("type_info") {
        if db.comptime_depth == 0 {
            reflection_error(db, id, c"@type_info is compile-time only; use cmpt or a macro")
        }
        ret ccg.expr_comptime_pointer(arena, reflection_value(db, id))
    }
    if name.eq("type_name") or name.eq("source_location") {
        ret lower_expr(ctx, db.hir.extra(id))
    }
    if name.eq("field_type") or name.eq("element_type") or name.eq("type_from_id") {
        if ccg.is_vm() {
            ret ccg.expr_int(arena, db.get_const_type(id))
        }
        ret empty
    }
    if name.eq(Str.of("sizeof")) {
        target_ty := db.get_const_type(id)
        add_type_to_queue(db, target_ty, ctx.type_queue)
        t_str := ccg.type_str(&db.types, arena, target_ty)
        ret ccg.expr_sizeof(arena, t_str)
    }
    if name.eq(Str.of("typeof")) {
        ret empty
    }
    if name.eq(Str.of("is")) {
        val_node := *(args.ptr + 0)
        target_ty := db.get_const_type(id)
        val_ty := db.get_node_type(val_node)
        if db.types.kind(val_ty) == TyKind.union_ {
            if not db.types.union_contains(val_ty, target_ty) {
                ret ccg.expr_bool(false)
            }
            tag_idx := db.types.union_member_index(val_ty, target_ty)
            val_str := lower_expr(ctx, val_node)
            ret ccg.expr_union_is(arena, val_str, tag_idx)
        }
        if val_ty == target_ty {
            ret ccg.expr_bool(true)
        }
        ret ccg.expr_bool(false)
    }
    if name.eq(Str.of("tag")) {
        val_node := *(args.ptr + 0)
        val_str := lower_expr(ctx, val_node)
        ret ccg.expr_union_tag(arena, val_str)
    }
    empty
}

lower_expr_node :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32) V {
    db := ctx.db
    ccg := ctx.ccg
    builder := ctx.builder
    arena := ctx.arena
    empty := ctx.empty
    queue := ctx.queue
    type_queue := ctx.type_queue
    match db.hir.kind(id) {
        builtin_call {
            ret lower_builtin_call(ctx, id)
        }
        lit_int {
            ty_id := db.get_node_type(id)
            if (ty_id != ty_id_none()) and (db.types.kind(ty_id) == TyKind.float) {
                ret ccg.expr_float_from_int(arena, db.hir.lhs(id), ty_id)
            }
            ret ccg.expr_int(arena, db.hir.lhs(id))
        }
        lit_float {
            ty := expression_value_type(db, id)
            ret ccg.expr_typed_float(db.interner.get(db.hir.lhs(id)), db.types.payload(ty) == 32)
        }
        lit_bool_true {
            ret ccg.expr_bool(true)
        }
        lit_bool_false {
            ret ccg.expr_bool(false)
        }
        lit_char {
            ret ccg.expr_char_lit(arena, db.interner.get(db.hir.lhs(id)))
        }
        lit_cstr {
            ret ccg.expr_cstr_lit(arena, db.interner.get(db.hir.lhs(id)))
        }
        lit_str {
            raw := db.interner.get(db.hir.lhs(id))
            str_ty := db.str_type
            if str_ty == ty_id_none() {
                str_ty = db.get_node_type(id)
            }
            struct_name := empty
            ptr_id: u32 = 0
            len_id: u32 = 0
            if str_ty != ty_id_none() {
                add_type_to_queue(db, str_ty, type_queue)
                struct_name = ccg.type_str(&db.types, arena, str_ty)
                ptr_id = db.interner.intern(Str.of("ptr"))
                len_id = db.interner.intern(Str.of("len"))
            }
            ret ccg.expr_str_lit(arena, struct_name, ptr_id, len_id, raw)
        }
        function {
            func_ty := db.get_node_type(id)
            sym := db.get_hir_symbol(id)
            if sym == id_none() or db.types.func_has_type_param(func_ty) {
                ret empty
            }
            if db.hir.extra(id) == hir_none() and not db.is_extern_fn(id) {
                ret empty
            }
            add_type_to_queue(db, func_ty, type_queue)
            if not queue.contains(sym) {
                queue.push(sym)
            }
            ret lower_function_name(ctx, sym, id, func_ty)
        }
        ident {
            ty := db.get_node_type(id)
            if ty == ty_id_type() {
                if ccg.is_vm() {
                    c_ty := db.get_const_type(id)
                    if c_ty != ty_id_none() {
                        ret ccg.expr_int(arena, c_ty)
                    }
                }
                ret empty
            }
            sym_id := db.get_hir_symbol(id)
            if db.types.kind(ty) == TyKind.func {
                if sym_id != id_none() {
                    real_sym := db.resolve_sym(sym_id)
                    if not db.types.func_has_type_param(ty) {
                        if not queue.contains(real_sym) {
                            queue.push(real_sym)
                        }
                    }
                    ret lower_function_name(ctx, real_sym, db.get_fn_node(real_sym), ty)
                }
            }
            if sym_id != id_none() {
                real_sym := db.resolve_sym(sym_id)
                if db.is_sym_const(real_sym) {
                    val: u64 = 0
                    if db.has_const_val(id) {
                        val = db.get_const_val(id)
                    } else {
                        hir_node := db.get_sym_hir(real_sym)
                        if (hir_node != id_none()) and (hir_node != id) and db.has_const_val(hir_node) {
                            val = db.get_const_val(hir_node)
                        } else {
                            val = eval_const(db, id)
                        }
                    }
                    k := db.types.kind(ty)
                    if ty == db.str_type {
                        ptr := reflection_read(db, val, ty, "ptr") as &u8
                        len := reflection_read(db, val, ty, "len")
                        raw := reflection_quote(db, Str.new(ptr, len))
                        add_type_to_queue(db, ty, type_queue)
                        ret ccg.expr_str_lit(arena, ccg.type_str(&db.types, arena, ty), db.interner.intern("ptr"), db.interner.intern("len"), raw)
                    }
                    if k == TyKind.bool {
                        if val != 0 {
                            ret ccg.expr_bool(true)
                        }
                        ret ccg.expr_bool(false)
                    }
                    if (k == TyKind.struct_ or k == TyKind.nominal) and not db.types.struct_is_extern(ty) {
                        ret lower_const_record(ctx, id, ty, val)
                    }
                    ret ccg.expr_cast(arena, ccg.type_str(&db.types, arena, ty), ccg.expr_u64(arena, val))
                }
                ret ccg.sym_name(arena, sym_id)
            }
            printf("\n[codegen error] undefined identifier\n       --> ", .{})
            db.print_loc(id)
            print("")
            fall()
            ret empty
        }
        var {
            ident_id := db.hir.lhs(id)
            val_id := db.hir.extra(id)
            sym_id := db.get_hir_symbol(ident_id)
            var_ty := db.get_node_type(ident_id)
            if (var_ty == ty_id_type()) or db.types.func_has_type_param(var_ty) {
                ret empty
            }
            if db.types.kind(var_ty) == TyKind.unit {
                printf("\n[type error] variable cannot have void type\n       --> ", .{})
                db.print_loc(id)
                print("")
                fall()
            }
            ty_str := ccg.type_str(&db.types, arena, var_ty)
            var_name := ccg.sym_name(arena, sym_id)
            if val_id != hir_none() {
                val_str := lower_expr(ctx, val_id)
                if not ccg.has_value(val_str) {
                    printf("\n[codegen error] initializer does not produce a value\n       --> ", .{})
                    db.print_loc(id)
                    print("")
                    fall()
                }
                ccg.create_variable(var_name, ty_str, val_str, true)
            } else {
                ccg.create_variable(var_name, ty_str, empty, false)
            }
            add_type_to_queue(db, var_ty, type_queue)
            ret empty
        }
        destructure {
            rhs_node := db.hir.extra(id)
            rhs_val := lower_expr(ctx, rhs_node)
            if not ccg.has_value(rhs_val) {
                printf("\n[codegen error] initializer does not produce a value\n       --> ", .{})
                db.print_loc(id)
                print("")
                fall()
            }
            rhs_ty := db.get_node_type(rhs_node)
            add_type_to_queue(db, rhs_ty, type_queue)
            rhs_ty_str := ccg.type_str(&db.types, arena, rhs_ty)

            temp_tup := ccg.new_temp(arena, rhs_ty_str)
            ccg.expr(ccg.expr_assign(arena, temp_tup, rhs_val))

            idents_list := db.hir.lhs(id)
            idents := db.get_list(idents_list)
            i: u64 = 0
            while i < idents.len {
                ident_node := *(idents.ptr + i)
                sym_id := db.get_hir_symbol(ident_node)
                var_ty := db.get_node_type(ident_node)
                if (var_ty == ty_id_type()) or db.types.func_has_type_param(var_ty) {
                    i = i + 1
                    cont
                }
                if db.types.kind(var_ty) == TyKind.unit {
                    printf("\n[type error] variable cannot have void type\n       --> ", .{})
                    db.print_loc(id)
                    print("")
                    fall()
                }
                add_type_to_queue(db, var_ty, type_queue)
                ty_str := ccg.type_str(&db.types, arena, var_ty)
                var_name := ccg.sym_name(arena, sym_id)

                f_name_id := db.tuple_field_name(i as u32)
                f_val := ccg.expr_member(arena, temp_tup, 0, f_name_id)
                ccg.create_variable(var_name, ty_str, f_val, true)
                i = i + 1
            }
            ret empty
        }
        binary_assign {
            lhs_str := lower_expr(ctx, db.hir.lhs(id))
            rhs_str := lower_expr(ctx, db.hir.rhs(id))
            ret ccg.expr_assign(arena, lhs_str, rhs_str)
        }
        binary_add, binary_sub, binary_mul, binary_div, binary_mod, binary_eq_eq, binary_neq, binary_lt, binary_gt, binary_lt_eq, binary_gt_eq, binary_bit_and, binary_bit_or, binary_bit_xor, binary_shl, binary_shr {
            lhs_val := lower_expr(ctx, db.hir.lhs(id))
            rhs_val := lower_expr(ctx, db.hir.rhs(id))
            ret ccg.expr_typed_binary_kind(arena, db.hir.kind(id), lhs_val, rhs_val, db.get_node_type(db.hir.lhs(id)))
        }
        binary_and {
            if ctx.global_init and not ccg.is_vm() {
                lhs := lower_expr(ctx, db.hir.lhs(id))
                rhs := lower_expr(ctx, db.hir.rhs(id))
                ret ccg.expr_binary_kind(arena, hir_kind.binary_and, lhs, rhs)
            }
            ty_str := ccg.type_str(&db.types, arena, ty_id_bool())
            temp_var := ccg.new_temp(arena, ty_str)
            lhs_val := lower_expr(ctx, db.hir.lhs(id))
            ccg.start_if(lhs_val)
            rhs_val := lower_expr(ctx, db.hir.rhs(id))
            if ccg.has_value(rhs_val) {
                ccg.expr(ccg.expr_assign(arena, temp_var, rhs_val))
            }
            ccg.end_block()
            ret temp_var
        }
        binary_or {
            if ctx.global_init and not ccg.is_vm() {
                lhs := lower_expr(ctx, db.hir.lhs(id))
                rhs := lower_expr(ctx, db.hir.rhs(id))
                ret ccg.expr_binary_kind(arena, hir_kind.binary_or, lhs, rhs)
            }
            ty_str := ccg.type_str(&db.types, arena, ty_id_bool())
            temp_var := ccg.new_temp(arena, ty_str)
            lhs_val := lower_expr(ctx, db.hir.lhs(id))
            ccg.start_if(lhs_val)
            ccg.expr(ccg.expr_assign(arena, temp_var, ccg.expr_bool(true)))
            ccg.else_()
            rhs_val := lower_expr(ctx, db.hir.rhs(id))
            if ccg.has_value(rhs_val) {
                ccg.expr(ccg.expr_assign(arena, temp_var, rhs_val))
            }
            ccg.end_block()
            ret temp_var
        }
        call {
            callee_id := db.hir.lhs(id)
            if db.hir.kind(callee_id) == hir_kind.member {
                c_lhs := db.hir.lhs(callee_id)
                c_lhs_ty := db.get_node_type(c_lhs)
                c_lhs_ty = db.types.unwrap_ptr(c_lhs_ty)
                if db.types.kind(c_lhs_ty) == TyKind.array {
                    m_name_id := db.hir.lhs(db.hir.rhs(callee_id))
                    iter_id := db.interner.intern(Str.of("iter"))
                    iter_ref_id := db.interner.intern(Str.of("iter_ref"))
                    if (m_name_id == iter_id) or (m_name_id == iter_ref_id) {
                        ret lower_array_iter_call(ctx, id, c_lhs, c_lhs_ty, m_name_id == iter_ref_id)
                    }
                }
            }
            callee_ty := db.get_node_type(callee_id)
            if (db.get_node_type(id) == ty_id_type()) and db.types.func_has_type_param(callee_ty) {
                ret empty
            }
            call_sym := resolve_call_symbol(db, id, callee_id, queue)
            callee_str := if call_sym == id_none() {
                lower_expr(ctx, callee_id)
            } else {
                lower_function_name(ctx, call_sym, db.get_fn_node(call_sym), callee_ty)
            }
            args_fmt := builder.new_list(arena)
            first_arg := true
            rec_str := emit_method_receiver(ctx, id, callee_id, call_sym)
            if ccg.has_value(rec_str) {
                builder.append_list_item(&args_fmt, rec_str, first_arg)
                first_arg = false
            }
            if db.hir.rhs(id) != hir_none() {
                args := db.get_list(db.hir.rhs(id))
                i: u64 = 0
                while i < args.len {
                    args = db.get_list(db.hir.rhs(id))
                    arg_node := *(args.ptr + i)
                    is_comptime := db.is_const_call_arg(id, i as u32)
                    i = i + 1
                    if is_comptime {
                        cont
                    }
                    if db.get_node_type(arg_node) == ty_id_type() {
                        cont
                    }
                    builder.append_list_item(&args_fmt, lower_expr(ctx, arg_node), first_arg)
                    first_arg = false
                }
            }
            ret ccg.expr_call(arena, callee_str, builder.finish_list(&args_fmt), callee_ty)
        }
        block {
            ret lower_scoped_expr(ctx, id, db.get_node_type(id))
        }
        unary_neg {
            child_v := lower_expr(ctx, db.hir.lhs(id))
            ret ccg.expr_neg(arena, child_v, db.get_node_type(db.hir.lhs(id)))
        }
        unary_not {
            child_v := lower_expr(ctx, db.hir.lhs(id))
            ret ccg.expr_not(arena, child_v)
        }
        unary_bit_not {
            child_v := lower_expr(ctx, db.hir.lhs(id))
            ret ccg.expr_bit_not(arena, child_v)
        }
        unary_addr_of {
            lhs_node := db.hir.lhs(id)
            child_v := lower_expr(ctx, lhs_node)
            if not is_lvalue(db, lhs_node) {
                ty := db.get_node_type(lhs_node)
                add_type_to_queue(db, ty, type_queue)
                ty_str := ccg.type_str(&db.types, arena, ty)
                ret ccg.expr_address_of_value(arena, ty_str, child_v)
            }
            ret ccg.expr_typed_address(arena, child_v, db.get_node_type(lhs_node))
        }
        unary_deref {
            lhs_node := db.hir.lhs(id)
            child_v := lower_expr(ctx, lhs_node)
            child_ty := db.get_node_type(lhs_node)
            if (child_ty != ty_id_none()) and (child_ty == db.str_type) {
                ptr_id := db.interner.intern(Str.of("ptr"))
                ret ccg.expr_str_deref(arena, child_v, ptr_id)
            }
            ret ccg.expr_typed_deref(arena, child_v, db.get_node_type(id))
        }
        k_break {
            ccg.emit_break(arena)
            ret empty
        }
        k_cont {
            ccg.emit_cont(arena)
            ret empty
        }
        cast {
            lhs_node := db.hir.lhs(id)
            lhs_ty := db.get_node_type(lhs_node)
            if db.types.kind(lhs_ty) == TyKind.union_ {
                target_ty := db.get_const_type(db.hir.rhs(id))
                member_idx := db.types.union_member_index(lhs_ty, target_ty)
                lhs_v := lower_expr(ctx, lhs_node)
                ret ccg.expr_union_member(arena, lhs_v, member_idx)
            }
            lhs_v := lower_expr(ctx, lhs_node)
            ty_str := ccg.type_str(&db.types, arena, db.get_const_type(db.hir.rhs(id)))
            if (db.hir.kind(lhs_node) == hir_kind.lit_int) or (db.hir.kind(lhs_node) == hir_kind.lit_char) {
                lhs_ty = ty_id_untyped_int()
            }
            if (db.hir.kind(lhs_node) == hir_kind.unary_neg) and (db.hir.kind(db.hir.lhs(lhs_node)) == hir_kind.lit_int) {
                lhs_ty = ty_id_untyped_int()
            }
            ret ccg.expr_typed_cast(arena, ty_str, lhs_v, lhs_ty)
        }
        k_cmpt {
            ty := expression_value_type(db, id)
            if ctx.global_init {
                source := db.hir.rhs(id)
                child := db.hir.lhs(id)
                bits := eval_const(db, id)
                if db.types.kind(ty) == TyKind.union_ and db.types.kind(source) != TyKind.union_ and db.has_union_coerce(child) {
                    tag := db.get_union_coerce_idx(child)
                    member := db.types.union_members(ty).ptr[tag]
                    value := lower_global_constant(ctx, id, source, member, bits)
                    add_type_to_queue(db, ty, type_queue)
                    ret ccg.expr_union(arena, ccg.type_str(&db.types, arena, ty), tag, value)
                }
                ret lower_global_constant(ctx, id, source, ty, bits)
            }
            if (ty == ty_id_type()) or (db.types.kind(ty) == TyKind.type_) {
                if ccg.is_vm() {
                    c_ty := db.get_const_type(id)
                    if c_ty != ty_id_none() {
                        ret ccg.expr_int(arena, c_ty)
                    }
                }
                ret empty
            }
            if ty == db.str_type {
                child := db.hir.lhs(id)
                if db.hir.kind(child) == hir_kind.lit_str {
                    ret lower_expr(ctx, child)
                }
                value := eval_const(db, id)
                ptr := reflection_read(db, value, ty, "ptr") as &u8
                len := reflection_read(db, value, ty, "len")
                raw := reflection_quote(db, Str.new(ptr, len))
                add_type_to_queue(db, ty, type_queue)
                ty_str := ccg.type_str(&db.types, arena, ty)
                ptr_id := db.interner.intern("ptr")
                len_id := db.interner.intern("len")
                ret ccg.expr_str_lit(arena, ty_str, ptr_id, len_id, raw)
            }
            if db.types.kind(ty) == TyKind.ptr {
                reflection_error(db, id, c"compile-time pointers cannot escape into runtime code")
            }
            val := eval_const(db, id)
            k := db.types.kind(ty)
            if (k == TyKind.struct_ or k == TyKind.nominal) and not db.types.struct_is_extern(ty) {
                ret lower_const_record(ctx, id, ty, val)
            }
            if k == TyKind.bool {
                if val != 0 {
                    ret ccg.expr_bool(true)
                }
                ret ccg.expr_bool(false)
            }
            if k == TyKind.float {
                ret ccg.expr_float_from_int(arena, val as u32, ty)
            }
            ret ccg.expr_int(arena, val as u32)
        }
        splice {
            if db.hir.rhs(id) == 1 {
                ret lower_macro_template(ctx, db.hir.extra(id))
            }
            gen_id := db.hir.extra(id)
            if gen_id != hir_none() {
                ret lower_body(ctx, gen_id)
            }
            ret empty
        }
        k_if {
            if_ty := db.get_node_type(id)
            elseb_id := db.hir.extra(id)
            is_expr := (elseb_id != hir_none()) and (if_ty != ty_id_none()) and (db.types.kind(if_ty) != TyKind.unit) and (db.types.kind(if_ty) != TyKind.never) and (ccg.is_vm() or (db.types.kind(if_ty) != TyKind.type_))
            if is_expr {
                add_type_to_queue(db, if_ty, type_queue)
                ty_str := ccg.type_str(&db.types, arena, if_ty)
                temp_var := ccg.new_temp(arena, ty_str)
                cond_str := lower_expr(ctx, db.hir.lhs(id))
                ccg.start_if(cond_str)
                then_val := lower_body(ctx, db.hir.rhs(id))
                if ccg.has_value(then_val) {
                    ccg.expr(ccg.expr_assign(arena, temp_var, then_val))
                }
                ccg.else_()
                else_val := lower_body(ctx, elseb_id)
                if ccg.has_value(else_val) {
                    ccg.expr(ccg.expr_assign(arena, temp_var, else_val))
                }
                ccg.end_block()
                ret temp_var
            }
            cond_str := lower_expr(ctx, db.hir.lhs(id))
            ccg.start_if(cond_str)
            then_val := lower_body(ctx, db.hir.rhs(id))
            if ccg.has_value(then_val) {
                ccg.expr(then_val)
            }
            if elseb_id != hir_none() {
                ccg.else_()
                else_val := lower_body(ctx, elseb_id)
                if ccg.has_value(else_val) {
                    ccg.expr(else_val)
                }
            }
            ccg.end_block()
            ret empty
        }
        k_match {
            ret lower_match(ctx, id)
        }
        k_for {
            ret lower_for(ctx, id)
        }
        k_while {
            scope := ccg.begin_loop(id)
            ccg.start_loop(arena, &scope)
            condition := lower_expr(ctx, db.hir.lhs(id))
            ccg.start_if(ccg.expr_not(arena, condition))
            ccg.break_statement()
            ccg.end_block()
            body := lower_body(ctx, db.hir.rhs(id))
            if ccg.has_value(body) {
                ccg.expr(body)
            }
            ccg.end_loop(arena, &scope)
            ret empty
        }
        k_ret {
            val_id := db.hir.lhs(id)
            if val_id != hir_none() {
                val_str := lower_expr(ctx, val_id)
                ccg.gen_return(val_str, true)
            } else {
                ccg.gen_return(ctx.empty, false)
            }
            ret empty
        }
        struct_init {
            ty_id := db.get_node_type(id)
            if db.has_union_coerce(id) {
                members := db.types.union_members(db.get_union_coerce_ty(id))
                ty_id = *(members.ptr + (db.get_union_coerce_idx(id) as u64))
            }
            add_type_to_queue(db, ty_id, type_queue)
            struct_name := ccg.type_str(&db.types, arena, ty_id)
            fields := db.get_list(db.hir.lhs(id))
            vals := db.get_list(db.hir.rhs(id))
            fields_fmt := builder.new_list(arena)
            i: u64 = 0
            while (i < fields.len) and (i < vals.len) {
                fields = db.get_list(db.hir.lhs(id))
                vals = db.get_list(db.hir.rhs(id))
                f_node := *(fields.ptr + i)
                v_node := *(vals.ptr + i)
                f_name_id := db.hir.lhs(f_node)
                v_str := lower_expr(ctx, v_node)
                builder.append_list_item(&fields_fmt, ccg.expr_struct_init_field(arena, f_name_id, v_str), i == 0)
                i = i + 1
            }
            ret ccg.expr_struct_init(arena, struct_name, builder.finish_list(&fields_fmt))
        }
        member {
            lhs_id := db.hir.lhs(id)
            rhs_id := db.hir.rhs(id)
            if db.get_node_type(id) == ty_id_type() {
                if ccg.is_vm() {
                    c_ty := db.get_const_type(id)
                    if c_ty != ty_id_none() {
                        ret ccg.expr_int(arena, c_ty)
                    }
                }
                ret empty
            }
            if db.get_hir_symbol(id) != id_none() {
                method_sym := db.get_hir_symbol(id)
                real_sym := db.resolve_sym(method_sym)
                method_hir := db.get_sym_hir(real_sym)
                if (method_hir != id_none()) and (db.hir.kind(method_hir) != hir_kind.function) {
                    if db.is_const(id) and db.has_const_val(id) {
                        ty := db.get_node_type(id)
                        val := db.get_const_val(id)
                        k := db.types.kind(ty)
                        if ty == db.str_type {
                            ptr := reflection_read(db, val, ty, "ptr") as &u8
                            len := reflection_read(db, val, ty, "len")
                            raw := reflection_quote(db, Str.new(ptr, len))
                            add_type_to_queue(db, ty, type_queue)
                            ret ccg.expr_str_lit(arena, ccg.type_str(&db.types, arena, ty), db.interner.intern("ptr"), db.interner.intern("len"), raw)
                        }
                        if k == TyKind.bool {
                            if val != 0 {
                                ret ccg.expr_bool(true)
                            }
                            ret ccg.expr_bool(false)
                        }
                        if (k == TyKind.int) or (k == TyKind.uint) or (k == TyKind.untyped_int) {
                            ret ccg.expr_cast(arena, ccg.type_str(&db.types, arena, ty), ccg.expr_u64(arena, val))
                        }
                    }
                    ret lower_expr(ctx, method_hir)
                }
                printf("\n[type error] methods must be called directly; method values are not supported\n       --> ", .{})
                db.print_loc(id)
                print("")
                fall()
            }
            lhs_ty := db.get_node_type(lhs_id)
            if db.types.kind(lhs_ty) == TyKind.type_ {
                actual_ty := db.get_const_type(lhs_id)
                if db.types.kind(actual_ty) == TyKind.enum_ {
                    field_name_id := db.hir.lhs(rhs_id)
                    if db.types.enum_has_variant(actual_ty, field_name_id) {
                        var_val := db.types.enum_variant_val(actual_ty, field_name_id)
                        add_type_to_queue(db, actual_ty, type_queue)
                        enum_name := ccg.type_str(&db.types, arena, actual_ty)
                        ret ccg.expr_enum_value(arena, enum_name, var_val)
                    }
                }
            }
            depth := db.get_auto_deref_depth(id)
            if (depth == 0) and (db.types.kind(lhs_ty) == TyKind.ptr) {
                p_depth: u32 = 0
                db.types.unwrap_ptr_depth(lhs_ty, &p_depth)
                depth = p_depth
            }
            target_lhs := lhs_id
            while db.hir.kind(target_lhs) == hir_kind.unary_deref {
                target_lhs = db.hir.lhs(target_lhs)
                depth = depth + 1
            }
            lhs_str := lower_expr(ctx, target_lhs)
            field_name_id := db.hir.lhs(rhs_id)
            len_id := db.interner.intern(Str.of("len"))
            base_lhs_ty := db.types.unwrap_ptr(lhs_ty)
            if (db.types.kind(base_lhs_ty) == TyKind.array) and (field_name_id == len_id) {
                arr_len := db.types.get_array_len(base_lhs_ty)
                ret ccg.expr_u64(arena, arr_len as u64)
            }
            ret ccg.expr_typed_member(arena, lhs_str, depth, field_name_id, lhs_ty)
        }
        array_init {
            ty_id := db.get_node_type(id)
            add_type_to_queue(db, ty_id, type_queue)
            arr_name := ccg.type_str(&db.types, arena, ty_id)
            elem_ty := db.types.get_array_type(ty_id)
            elems_fmt := builder.new_list(arena)
            count: u32 = 0
            list_id := db.hir.lhs(id)
            if list_id != hir_none() {
                elements := db.get_list(list_id)
                count = elements.len as u32
                i: u64 = 0
                while i < elements.len {
                    elements = db.get_list(list_id)
                    elem_node := *(elements.ptr + i)
                    elem_val := lower_expr(ctx, elem_node)
                    builder.append_list_item(&elems_fmt, ccg.expr_array_init_elem(arena, elem_val), i == 0)
                    i = i + 1
                }
            }
            ret ccg.expr_array_init(arena, arr_name, builder.finish_list(&elems_fmt), elem_ty, count)
        }
        index {
            lhs_node := db.hir.lhs(id)
            rhs_node := db.hir.rhs(id)
            lhs_val := lower_expr(ctx, lhs_node)
            rhs_val := lower_expr(ctx, rhs_node)
            lhs_ty := db.get_node_type(lhs_node)
            is_ptr := false
            if db.types.kind(lhs_ty) == TyKind.ptr {
                inner := db.types.payload(lhs_ty)
                if db.types.kind(inner) == TyKind.array {
                    lhs_ty = inner
                    is_ptr = true
                }
            }
            if db.types.kind(lhs_ty) == TyKind.array {
                elem_ty := db.types.get_array_type(lhs_ty)
                ret ccg.expr_array_index(arena, lhs_val, rhs_val, elem_ty, is_ptr)
            }
            t := lhs_ty
            while db.types.kind(t) == TyKind.nominal {
                t = db.types.nominal_base(t)
            }
            if db.types.kind(t) == TyKind.struct_ {
                ptr_name := db.interner.intern(Str.of("ptr"))
                fields := db.types.get_struct_fields(t)
                count := fields.len / 2
                found_elem_ty := ty_id_none()
                f_i: u64 = 0
                while f_i < count {
                    f_name := *(fields.ptr + (f_i * 2))
                    if f_name == ptr_name {
                        f_ty := *(fields.ptr + (f_i * 2) + 1)
                        if db.types.kind(f_ty) == TyKind.ptr {
                            found_elem_ty = db.types.payload(f_ty)
                            break
                        }
                    }
                    f_i = f_i + 1
                }
                if found_elem_ty != ty_id_none() {
                    ret ccg.expr_slice_index(arena, lhs_val, rhs_val, found_elem_ty, ptr_name)
                }
            }
            elem_ty := db.get_node_type(id)
            ret ccg.expr_ptr_index(arena, lhs_val, rhs_val, elem_ty)
        }
        else {
            printf("\n[codegen error] unsupported expression\n       --> ", .{})
            db.print_loc(id)
            print("")
            fall()
            ret empty
        }
    }
}

lower_body :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32) V {
    db := ctx.db
    ccg := ctx.ccg
    if db.hir.kind(id) != hir_kind.block {
        ret lower_expr(ctx, id)
    }
    source_items := db.get_list(db.hir.lhs(id))
    items := Vec(u32).new()
    items.extend(source_items.ptr, source_items.len)
    count := items.len
    last_val := ctx.empty

    i: u64 = 0
    while i < count {
        node_id := items.get(i)
        is_last := (i + 1) == count
        val := lower_expr(ctx, node_id)

        if not is_last {
            ccg.expr(val)
        } else {
            last_val = val
        }
        i = i + 1
    }

    items.destroy()
    last_val
}

eval_const :: fn(db &Nexus, id u32) u64 {
    if id == hir_none() {
        ret 0
    }
    if db.has_const_val(id) {
        ret db.get_const_val(id)
    }
    k := db.hir.kind(id)
    if k == hir_kind.lit_int {
        val := db.hir.lhs(id) as u64
        db.set_const_val(id, val)
        ret val
    }
    if k == hir_kind.lit_bool_true {
        db.set_const_val(id, 1)
        ret 1
    }
    if k == hir_kind.lit_bool_false {
        db.set_const_val(id, 0)
        ret 0
    }
    if k == hir_kind.lit_char {
        raw := db.interner.get(db.hir.lhs(id))
        val: u64 = decode_char_lit(raw) as u64
        db.set_const_val(id, val)
        ret val
    }
    if db.get_node_type(id) == ty_id_type() {
        c_ty := db.get_const_type(id)
        if c_ty != ty_id_none() {
            val := c_ty as u64
            db.set_const_val(id, val)
            ret val
        }
    }
    if k == hir_kind.k_cmpt {
        child := db.hir.lhs(id)
        val := eval_const(db, child)
        db.set_const_val(id, val)
        ret val
    }
    if k == hir_kind.splice {
        gen_id := db.hir.extra(id)
        if gen_id != hir_none() {
            val := eval_const(db, gen_id)
            db.set_const_val(id, val)
            ret val
        }
    }
    if k == hir_kind.index {
        lhs := db.hir.lhs(id)
        idx := db.hir.rhs(id)
        idx_val := eval_const(db, idx)
        if db.hir.kind(lhs) == hir_kind.array_init {
            list_id := db.hir.lhs(lhs)
            if list_id != hir_none() {
                elems := db.get_list(list_id)
                if idx_val < (elems.len as u64) {
                    elem_node := *(elems.ptr + idx_val)
                    val := eval_const(db, elem_node)
                    db.set_const_val(id, val)
                    ret val
                }
            }
        }
        if db.hir.kind(lhs) == hir_kind.ident {
            sym_id := db.get_hir_symbol(lhs)
            if sym_id != id_none() {
                real_s := db.resolve_sym(sym_id)
                hir_node := db.get_sym_hir(real_s)
                if (hir_node != id_none()) and (db.hir.kind(hir_node) == hir_kind.binding) {
                    rhs := db.hir.extra(hir_node)
                    if (rhs != hir_none()) and (db.hir.kind(rhs) == hir_kind.array_init) {
                        list_id := db.hir.lhs(rhs)
                        if list_id != hir_none() {
                            elems := db.get_list(list_id)
                            if idx_val < (elems.len as u64) {
                                elem_node := *(elems.ptr + idx_val)
                                val := eval_const(db, elem_node)
                                db.set_const_val(id, val)
                                ret val
                            }
                        }
                    }
                }
            }
        }
    }
    if k == hir_kind.ident {
        sym_id := db.get_hir_symbol(id)
        if sym_id != id_none() {
            real_s := db.resolve_sym(sym_id)
            hir_node := db.get_sym_hir(real_s)
            if (hir_node != id_none()) and (hir_node != id) {
                if db.has_const_val(hir_node) {
                    val := db.get_const_val(hir_node)
                    db.set_const_val(id, val)
                    ret val
                }
                if db.hir.kind(hir_node) == hir_kind.binding {
                    rhs := db.hir.extra(hir_node)
                    if rhs != hir_none() {
                        val := eval_const(db, rhs)
                        db.set_const_val(id, val)
                        ret val
                    }
                }
            }
            if db.get_node_type(id) == ty_id_type() {
                c_type := db.get_const_type(id)
                if c_type != ty_id_none() {
                    val := c_type as u64
                    db.set_const_val(id, val)
                    ret val
                }
                if (hir_node != id_none()) and (hir_node != id) {
                    c_ty := db.get_const_type(hir_node)
                    if c_ty != ty_id_none() {
                        val := c_ty as u64
                        db.set_const_val(id, val)
                        ret val
                    }
                }
            }
            hir_end := db.sym_hir_end(real_s)
            if (hir_end != 0) and (hir_end != id_none()) {
                b_id := hir_end - 1
                if db.hir.kind(b_id) == hir_kind.binding {
                    rhs := db.hir.extra(b_id)
                    if rhs != hir_none() {
                        val := eval_const(db, rhs)
                        db.set_const_val(id, val)
                        ret val
                    }
                }
            }
            if (real_s & 2147483648) != 0 {
                b_id := real_s & 2147483647
                if db.hir.kind(b_id) == hir_kind.binding {
                    rhs := db.hir.extra(b_id)
                    if rhs != hir_none() {
                        val := eval_const(db, rhs)
                        db.set_const_val(id, val)
                        ret val
                    }
                }
            }
        }
    }
    saved_cg := db.comptime_cg
    saved_vm := db.comptime_vm
    nested := db.comptime_depth > 0
    if nested {
        db.comptime_cg = 0 as &VmCodeGen
    }
    db.init_comptime()
    db.comptime_depth = db.comptime_depth + 1
    db.comptime_cg.reset_locals()
    builder := VmCodeBuilder.new(db.comptime_cg)
    start_ip := db.comptime_cg.chunk.buf.len as u32
    visited := HashSet(u32).new()
    queue := Vec(u32).new()
    type_queue := Vec(u32).new()
    ctx: LowerCtx(VmCodeGen, VmCodeBuilder, VmVal) = .{ db: db, ccg: db.comptime_cg, builder: &builder, empty: VmVal.empty(), arena: &db.comptime_arena, visited: &visited, queue: &queue, type_queue: &type_queue, global_init: false }
    res_val := lower_body(&ctx, id)
    if res_val.kind != VmValKind.none {
        db.comptime_cg.ensure_on_stack(res_val)
    } else {
        db.comptime_cg.chunk.inst(OpCode.push_0)
    }
    db.comptime_cg.chunk.inst(OpCode.ret_val)

    for q_sym in Worklist(u32).new(&queue) {
        if visited.insert(q_sym) {
            lower_one_function(&ctx, q_sym)
        }
    }
    visited.destroy()
    queue.destroy()
    type_queue.destroy()

    db.comptime_cg.finish_linking()
    res := db.comptime_vm.run(&db.comptime_cg.chunk, start_ip)
    db.comptime_depth = db.comptime_depth - 1
    if nested {
        db.comptime_cg = saved_cg
        db.comptime_vm = saved_vm
    }
    db.set_const_val(id, res)
    res
}

lower_scoped_expr :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32, expected u32) V {
    db := ctx.db
    ccg := ctx.ccg
    arena := ctx.arena
    empty := ctx.empty
    kind := db.types.kind(expected)
    if (expected == ty_id_none()) or (kind == TyKind.unit) or (kind == TyKind.never) {
        val := lower_body(ctx, id)
        if ccg.has_value(val) {
            ccg.expr(val)
        }
        ret empty
    }
    add_type_to_queue(db, expected, ctx.type_queue)
    ty_str := ccg.type_str(&db.types, arena, expected)
    temp_var := ccg.new_temp(arena, ty_str)
    val := lower_body(ctx, id)
    if ccg.has_value(val) {
        ccg.expr(ccg.expr_assign(arena, temp_var, val))
    }
    temp_var
}

lower_match_condition :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), value_str V, value_ty u32, arm u32) V {
    db := ctx.db
    ccg := ctx.ccg
    arena := ctx.arena
    empty := ctx.empty
    patterns := db.get_list(db.hir.lhs(arm))
    if patterns.len == 0 {
        ret ccg.expr_one(arena)
    }
    result := empty
    i: u64 = 0
    while i < patterns.len {
        pat := *(patterns.ptr + i)
        condition := empty
        if db.types.kind(value_ty) == TyKind.enum_ {
            name_id := db.hir.lhs(pat)
            if db.hir.kind(pat) == hir_kind.member {
                name_id = db.hir.lhs(db.hir.rhs(pat))
            }
            val := db.types.enum_variant_val(value_ty, name_id)
            enum_name := ccg.type_str(&db.types, arena, value_ty)
            condition = ccg.expr_equal(arena, value_str, ccg.expr_enum_value(arena, enum_name, val))
        } else {
            pat_ty := db.get_const_type(pat)
            idx := db.types.union_member_index(value_ty, pat_ty)
            condition = ccg.expr_union_is(arena, value_str, idx)
        }
        if i == 0 {
            result = condition
        } else {
            result = ccg.expr_or(arena, result, condition)
        }
        i = i + 1
    }
    result
}

lower_match_binding :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), value_str V, value_ty u32, arm u32) {
    db := ctx.db
    ccg := ctx.ccg
    arena := ctx.arena
    binder := db.hir.extra(arm)
    if binder == hir_none() {
        ret
    }
    sym := db.get_hir_symbol(binder)
    if sym == id_none() {
        ret
    }
    bind_ty := db.get_node_type(binder)
    if bind_ty == ty_id_none() {
        ret
    }
    add_type_to_queue(db, bind_ty, ctx.type_queue)
    bound_val := value_str
    patterns := db.get_list(db.hir.lhs(arm))
    if (db.types.kind(value_ty) == TyKind.union_) and (patterns.len == 1) {
        pat := *(patterns.ptr + 0)
        pat_ty := db.get_const_type(pat)
        idx := db.types.union_member_index(value_ty, pat_ty)
        bound_val = ccg.expr_cast(arena, ccg.type_str(&db.types, arena, bind_ty), ccg.expr_union_member(arena, bound_val, idx))
    }
    name := ccg.sym_name(arena, sym)
    ty_str := ccg.type_str(&db.types, arena, bind_ty)
    ccg.create_variable(name, ty_str, bound_val, true)
}

lower_match :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32) V {
    db := ctx.db
    ccg := ctx.ccg
    arena := ctx.arena
    empty := ctx.empty
    type_queue := ctx.type_queue
    value_id := db.hir.lhs(id)
    value_ty := db.get_node_type(value_id)
    arms := db.get_list(db.hir.rhs(id))
    match_ty := db.get_node_type(id)
    is_expr := (match_ty != ty_id_none()) and (db.types.kind(match_ty) != TyKind.unit) and (db.types.kind(match_ty) != TyKind.never)

    temp_var := empty
    if is_expr {
        add_type_to_queue(db, match_ty, type_queue)
        ty_str := ccg.type_str(&db.types, arena, match_ty)
        temp_var = ccg.new_temp(arena, ty_str)
    }
    value_val := lower_expr(ctx, value_id)
    value_str := value_val
    if (db.hir.kind(value_id) != hir_kind.ident) and ccg.has_value(value_val) {
        val_ty_str := ccg.type_str(&db.types, arena, value_ty)
        match_val_var := ccg.new_temp(arena, val_ty_str)
        ccg.expr(ccg.expr_assign(arena, match_val_var, value_val))
        value_str = match_val_var
    }
    i: u64 = 0
    open_blocks: u32 = 0
    while i < arms.len {
        arms = db.get_list(db.hir.rhs(id))
        arm := *(arms.ptr + i)
        if i > 0 {
            ccg.else_()
        }
        has_patterns := db.get_list(db.hir.lhs(arm)).len > 0
        if (i == 0) or has_patterns {
            cond := lower_match_condition(ctx, value_str, value_ty, arm)
            ccg.start_if(cond)
            open_blocks = open_blocks + 1
        }
        lower_match_binding(ctx, value_str, value_ty, arm)
        branch := lower_body(ctx, db.hir.rhs(arm))
        if is_expr {
            if ccg.has_value(branch) {
                ccg.expr(ccg.expr_assign(arena, temp_var, branch))
            }
        } else {
            if ccg.has_value(branch) {
                ccg.expr(branch)
            }
        }
        i = i + 1
    }
    while open_blocks > 0 {
        ccg.end_block()
        open_blocks = open_blocks - 1
    }
    temp_var
}

for_method_receiver :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), call_id u32, source_name V, source_ty u32) V {
    db := ctx.db
    ccg := ctx.ccg
    arena := ctx.arena
    callee := db.hir.lhs(call_id)
    func_ty := db.get_node_type(callee)
    if db.types.kind(func_ty) != TyKind.func {
        ret source_name
    }
    params := db.types.func_params(func_ty)
    if params.len == 0 {
        ret source_name
    }
    expected := *(params.ptr + 0)
    expected_depth: u32 = 0
    expected = db.types.unwrap_ptr_depth(expected, &expected_depth)
    source_depth: u32 = 0
    source := db.types.unwrap_ptr_depth(source_ty, &source_depth)
    receiver := source_name
    while source_depth < expected_depth {
        receiver = ccg.expr_address(arena, receiver)
        source_depth = source_depth + 1
    }
    while source_depth > expected_depth {
        receiver = ccg.expr_deref(arena, receiver)
        source_depth = source_depth - 1
    }
    receiver
}

lower_for :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32) V {
    db := ctx.db
    ccg := ctx.ccg
    builder := ctx.builder
    arena := ctx.arena
    empty := ctx.empty
    queue := ctx.queue
    type_queue := ctx.type_queue
    vars := db.get_list(db.hir.lhs(id))
    iters := db.get_list(db.hir.rhs(id))
    ptr_id := db.interner.intern(Str.of("ptr"))
    len_id := db.interner.intern(Str.of("len"))
    index_id := db.interner.intern(Str.of("index"))
    present_id := db.interner.intern(Str.of("present"))
    value_id := db.interner.intern(Str.of("value"))

    iter_names := Vec(V).new()
    value_names := Vec(V).new()
    structural_flags := Vec(u8).new()
    i: u64 = 0
    while i < iters.len {
        iters = db.get_list(db.hir.rhs(id))
        iter := *(iters.ptr + i)
        source := iter
        if db.hir.kind(iter) == hir_kind.for_iter {
            source = db.hir.lhs(iter)
        }
        iter_ty := db.get_node_type(source)
        add_type_to_queue(db, iter_ty, type_queue)
        value := lower_expr(ctx, source)
        iter_name := ccg.iterator_name(arena, id, i as u32)
        iter_names.push(iter_name)
        ccg.create_variable(iter_name, ccg.type_str(&db.types, arena, iter_ty), value, true)
        if db.hir.kind(iter) == hir_kind.for_iter {
            structural_flags.push(1 as u8)
        } else {
            structural_flags.push(0 as u8)
        }
        i = i + 1
    }

    vars = db.get_list(db.hir.lhs(id))
    iters = db.get_list(db.hir.rhs(id))
    scope := ccg.begin_loop(id)
    ccg.start_iterator_loop(arena, &scope)

    i = 0
    while i < iter_names.len {
        name := iter_names.get(i)
        if structural_flags.get(i) != 0 {
            iter := *(iters.ptr + i)
            next_call := db.hir.rhs(iter)
            next_ty := db.get_node_type(next_call)
            add_type_to_queue(db, next_ty, type_queue)
            call_sym := resolve_call_symbol(db, next_call, db.hir.lhs(next_call), queue)
            callee_name := ccg.sym_name(arena, call_sym)
            receiver := for_method_receiver(ctx, next_call, name, db.get_node_type(db.hir.lhs(iter)))
            args_list := builder.new_list(arena)
            builder.append_list_item(&args_list, receiver, true)
            next_args := builder.finish_list(&args_list)
            next_expr := ccg.expr_call(arena, callee_name, next_args, ty_id_none())
            next_name := ccg.iterator_next_name(arena, id, i as u32)
            ccg.create_variable(next_name, ccg.type_str(&db.types, arena, next_ty), next_expr, true)
            value_names.push(next_name)
            present := ccg.expr_field_value(arena, next_name, present_id)
            ccg.start_if(ccg.expr_not(arena, present))
            ccg.break_statement()
            ccg.end_block()
        } else {
            value_names.push(name)
            length := ccg.expr_field_value(arena, name, len_id)
            index := ccg.expr_field_value(arena, name, index_id)
            ccg.start_if(ccg.expr_less_equal(arena, length, index))
            ccg.break_statement()
            ccg.end_block()
        }
        i = i + 1
    }

    i = 0
    while i < vars.len {
        var_node := *(vars.ptr + i)
        var_sym := db.get_hir_symbol(var_node)
        var_name := ccg.sym_name(arena, var_sym)
        var_ty := db.get_node_type(var_node)
        iter_ty := db.get_node_type(*(iters.ptr + i))
        var_ty_str := ccg.type_str(&db.types, arena, var_ty)
        iter_name := iter_names.get(i)
        value := empty
        if structural_flags.get(i) != 0 {
            next_name := value_names.get(i)
            value = ccg.expr_field_value(arena, next_name, value_id)
        } else if iterator_is_ref(db, iter_ty) {
            ptr := ccg.expr_field_value(arena, iter_name, ptr_id)
            index := ccg.expr_field_value(arena, iter_name, index_id)
            value = ccg.expr_add(arena, ptr, index)
        } else {
            ptr := ccg.expr_field_value(arena, iter_name, ptr_id)
            index := ccg.expr_field_value(arena, iter_name, index_id)
            value = ccg.expr_deref(arena, ccg.expr_add(arena, ptr, index))
        }
        ccg.create_variable(var_name, var_ty_str, value, true)
        if structural_flags.get(i) == 0 {
            index := ccg.expr_field_value(arena, iter_name, index_id)
            ccg.expr(ccg.expr_assign(arena, index, ccg.expr_add(arena, index, ccg.expr_one(arena))))
        }
        i = i + 1
    }

    body := lower_body(ctx, db.hir.extra(id))
    if ccg.has_value(body) {
        ccg.expr(body)
    }
    ccg.end_loop(arena, &scope)
    iter_names.destroy()
    value_names.destroy()
    structural_flags.destroy()
    empty
}

lower_const_record :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32, ty u32, value u64) V {
    db := ctx.db
    ccg := ctx.ccg
    arena := ctx.arena
    fields := db.types.get_struct_fields(ty)
    items := ctx.builder.new_list(arena)
    index: u64 = 0
    while index < fields.len / 2 {
        field := fields.ptr[index * 2]
        field_type := fields.ptr[index * 2 + 1]
        kind := db.types.kind(field_type)
        bits := *((value + index * 8) as &u64)
        item := ctx.empty
        if field_type == db.str_type {
            item = lower_global_constant(ctx, id, field_type, field_type, bits)
        } else if kind == TyKind.bool {
            item = ccg.expr_bool(bits != 0)
        } else if kind == TyKind.int or kind == TyKind.uint or kind == TyKind.enum_ {
            add_type_to_queue(db, field_type, ctx.type_queue)
            item = ccg.expr_cast(arena, ccg.type_str(&db.types, arena, field_type), ccg.expr_u64(arena, bits))
        } else {
            reflection_error(db, id, c"compile-time records require string, integer, enum or boolean fields")
        }
        ctx.builder.append_list_item(&items, ccg.expr_struct_init_field(arena, field, item), index == 0)
        index = index + 1
    }
    add_type_to_queue(db, ty, ctx.type_queue)
    ccg.expr_struct_init(arena, ccg.type_str(&db.types, arena, ty), ctx.builder.finish_list(&items))
}

expression_value_type :: fn(db &Nexus, id u32) u32 {
    if db.has_union_coerce(id) {
        members := db.types.union_members(db.get_union_coerce_ty(id))
        ret members.ptr[db.get_union_coerce_idx(id)]
    }
    db.get_node_type(id)
}

read_vm_constant :: fn(ptr &u8, size u64) u64 {
    if size == 1 { ret *ptr as u64 }
    if size == 2 { ret *(ptr as &u16) as u64 }
    if size == 4 { ret *(ptr as &u32) as u64 }
    *(ptr as &u64)
}

lower_global_constant :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32, source u32, ty u32, bits u64) V {
    db := ctx.db
    types := &db.types
    cg := ctx.ccg
    arena := ctx.arena
    add_type_to_queue(db, ty, ctx.type_queue)
    type_name := cg.type_str(types, arena, ty)
    kind := types.kind(ty)
    if ty == db.str_type {
        ptr := reflection_read(db, bits, ty, "ptr") as &u8
        len := reflection_read(db, bits, ty, "len")
        raw := reflection_quote(db, Str.new(ptr, len))
        ret cg.expr_str_lit(arena, type_name, db.interner.intern("ptr"), db.interner.intern("len"), raw)
    }
    if kind == TyKind.bool {
        ret cg.expr_bool(bits != 0)
    }
    if kind == TyKind.float or kind == TyKind.untyped_float {
        value := if types.payload(source) == 32 {
            (*(&bits as &f32)) as f64
        } else {
            *(&bits as &f64)
        }
        ret cg.expr_folded_float(arena, value, types.payload(ty) == 32)
    }
    if kind == TyKind.ptr or kind == TyKind.func {
        if bits != 0 {
            db.type_error(id, "compile-time pointers cannot escape into runtime storage")
        }
    } else if kind == TyKind.struct_ or kind == TyKind.nominal {
        if types.struct_is_extern(ty) {
            db.type_error(id, "compile-time extern records cannot initialize mutable globals")
        }
        fields := types.get_struct_fields(ty)
        source_fields := types.get_struct_fields(source)
        items := ctx.builder.new_list(arena)
        i: u64 = 0
        while i < fields.len / 2 {
            field_bits := (bits as &u64)[i]
            value := lower_global_constant(ctx, id, source_fields.ptr[i * 2 + 1], fields.ptr[i * 2 + 1], field_bits)
            ctx.builder.append_list_item(&items, cg.expr_struct_init_field(arena, fields.ptr[i * 2], value), i == 0)
            i = i + 1
        }
        ret cg.expr_struct_init(arena, type_name, ctx.builder.finish_list(&items))
    } else if kind == TyKind.array {
        elem := types.get_array_type(ty)
        source_elem := types.get_array_type(source)
        count := types.get_array_len(ty)
        size := vm_element_size(types, source_elem)
        items := ctx.builder.new_list(arena)
        for index in Range.new(0, count as i32) {
            ptr := (bits + (index as u64) * size) as &u8
            raw := read_vm_constant(ptr, size)
            value := lower_global_constant(ctx, id, source_elem, elem, raw)
            ctx.builder.append_list_item(&items, cg.expr_array_init_elem(arena, value), index == 0)
        }
        ret cg.expr_array_init(arena, type_name, ctx.builder.finish_list(&items), elem, count)
    } else if kind == TyKind.union_ {
        tag := *(bits as &u64) as u32
        members := types.union_members(ty)
        source_members := types.union_members(source)
        value := lower_global_constant(ctx, id, source_members.ptr[tag], members.ptr[tag], (bits as &u64)[1])
        ret cg.expr_union(arena, type_name, tag, value)
    }
    cg.expr_cast(arena, type_name, cg.expr_u64(arena, bits))
}

global_init_source :: fn(db &Nexus, id u32) u32 {
    if id == hir_none() {
        ret id
    }
    tbl := &db.hir
    match tbl.kind(id) {
        ident, member {
            value := db.binding_value(db.get_hir_symbol(id))
            if value != hir_none() {
                ret global_init_source(db, value)
            }
            if tbl.kind(id) == hir_kind.member and tbl.lhs(id) != hir_none() {
                source := global_init_source(db, tbl.lhs(id))
                if tbl.kind(source) == hir_kind.struct_init {
                    field := tbl.lhs(tbl.rhs(id))
                    names := db.get_list(tbl.lhs(source))
                    values := db.get_list(tbl.rhs(source))
                    i: u64 = 0
                    while i < names.len {
                        if tbl.lhs(names.ptr[i]) == field {
                            ret global_init_source(db, values.ptr[i])
                        }
                        i = i + 1
                    }
                }
            }
            ret id
        }
        block {
            items := db.get_list(tbl.lhs(id))
            if items.len > 0 {
                ret global_init_source(db, items.ptr[items.len - 1])
            }
            ret id
        }
        k_if {
            branch := if eval_const(db, tbl.lhs(id)) != 0 { tbl.rhs(id) } else { tbl.extra(id) }
            ret global_init_source(db, branch)
        }
        index {
            source := global_init_source(db, tbl.lhs(id))
            if tbl.kind(source) == hir_kind.array_init {
                index := eval_const(db, tbl.rhs(id))
                items := db.get_list(tbl.lhs(source))
                if index >= items.len {
                    db.type_error(id, "array index out of bounds")
                }
                ret global_init_source(db, items.ptr[index])
            }
            ret id
        }
        splice {
            ret global_init_source(db, tbl.extra(id))
        }
        builtin_call {
            if db.interner.get(tbl.lhs(id)).eq("source_location") {
                ret tbl.extra(id)
            }
            ret id
        }
        else { ret id }
    }
}

lower_global_projection :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32) V {
    db := ctx.db
    tbl := &db.hir
    types := &db.types
    receiver := global_init_source(db, tbl.lhs(id))
    if receiver == hir_none() {
        ret ctx.empty
    }
    kind := tbl.kind(receiver)
    if kind != hir_kind.k_cmpt and kind != hir_kind.lit_str {
        ret ctx.empty
    }
    source_ty := if kind == hir_kind.k_cmpt { tbl.rhs(receiver) } else { db.str_type }
    ty := expression_value_type(db, id)
    if tbl.kind(id) == hir_kind.index and types.kind(source_ty) == TyKind.array {
        index := eval_const(db, tbl.rhs(id))
        if index >= types.get_array_len(source_ty) as u64 {
            db.type_error(id, "array index out of bounds")
        }
        elem := types.get_array_type(source_ty)
        size := vm_element_size(types, elem)
        ptr := (eval_const(db, receiver) + index * size) as &u8
        ret lower_global_constant(ctx, id, elem, ty, read_vm_constant(ptr, size))
    }
    if tbl.kind(id) == hir_kind.member and not types.struct_is_extern(source_ty) {
        field := tbl.lhs(tbl.rhs(id))
        fields := types.get_struct_fields(source_ty)
        i: u64 = 0
        while i < fields.len / 2 {
            if fields.ptr[i * 2] == field {
                bits := (eval_const(db, receiver) as &u64)[i]
                ret lower_global_constant(ctx, id, fields.ptr[i * 2 + 1], ty, bits)
            }
            i = i + 1
        }
    }
    ctx.empty
}

lower_expr :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), id u32) V {
    db := ctx.db
    kind := db.hir.kind(id)
    val_str := ctx.empty
    if kind == hir_kind.ident or kind == hir_kind.member {
        sym := db.resolve_sym(db.get_hir_symbol(id))
        if db.global_var(sym) != hir_none() {
            if db.comptime_depth > 0 {
                db.type_error(id, "mutable global cannot be accessed at compile time")
            }
            val_str = ctx.ccg.global_ref(ctx.arena, sym, db.get_node_type(id))
        }
    }
    if not ctx.ccg.has_value(val_str) {
        source := if ctx.global_init { global_init_source(db, id) } else { id }
        if source == id {
            if ctx.global_init and (kind == hir_kind.member or kind == hir_kind.index) {
                val_str = lower_global_projection(ctx, id)
            }
            if not ctx.ccg.has_value(val_str) {
                val_str = lower_expr_node(ctx, id)
            }
        } else {
            val_str = lower_expr(ctx, source)
        }
    }
    if not ctx.ccg.has_value(val_str) {
        ret val_str
    }
    if ctx.db.has_union_coerce(id) {
        target_union := ctx.db.get_union_coerce_ty(id)
        k_idx := ctx.db.get_union_coerce_idx(id)
        add_type_to_queue(ctx.db, target_union, ctx.type_queue)
        union_name := ctx.ccg.type_str(&ctx.db.types, ctx.arena, target_union)
        ret ctx.ccg.expr_union(ctx.arena, union_name, k_idx, val_str)
    }
    val_str
}

FuncSignature :: fn(V type) type {
    struct {
        fn_name    V
        params_str V
    }
}

lower_function_name :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), sym u32, node u32, ty u32) V {
    db := ctx.db
    ccg := ctx.ccg
    if node != id_none() and db.is_extern_fn(node) and (not ccg.is_vm() or db.hir.extra(node) == hir_none()) {
        if not ccg.is_vm() and db.extern_module(node).len > 0 {
            ret ccg.sym_name(ctx.arena, sym)
        }
        ret ccg.extern_name(db.interner.get(db.extern_link_name(sym, node)), ty)
    }
    ccg.sym_name(ctx.arena, sym)
}

format_func_signature :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), sym_id u32, real_sym u32, func_id u32, is_mono bool, is_extern bool, orig_func_ty u32, func_ty u32) FuncSignature(V) {
    db := ctx.db
    ccg := ctx.ccg
    builder := ctx.builder
    arena := ctx.arena
    fn_name := if is_mono {
        ccg.sym_name(arena, sym_id)
    } else {
        lower_function_name(ctx, real_sym, func_id, func_ty)
    }

    params_slice := db.types.func_params(func_ty)
    params := builder.new_list(arena)
    first := true
    orig_params: Slice(u32) = .{ ptr: 0 as &u32, len: 0 }
    if orig_func_ty != ty_id_none() {
        orig_params = db.types.func_params(orig_func_ty)
    }
    i: u64 = 0
    while i < params_slice.len {
        fn_params := db.get_list(db.hir.lhs(func_id))
        if (i < fn_params.len) and (db.hir.extra(*(fn_params.ptr + i)) == 1) {
            i = i + 1
            cont
        }
        if is_mono and (i < orig_params.len) and (*(orig_params.ptr + i) == ty_id_type()) {
            i = i + 1
            cont
        }
        p_ty := ccg.type_str(&db.types, arena, *(params_slice.ptr + i))
        name := ccg.parameter_name(arena, i as u32)
        body_id := db.hir.extra(func_id)
        if (not is_extern) or (body_id != hir_none()) {
            args_list_id := db.hir.lhs(func_id)
            if args_list_id != hir_none() {
                args := db.get_list(args_list_id)
                if i < args.len {
                    arg_ident := db.hir.lhs(*(args.ptr + i))
                    if arg_ident != hir_none() {
                        arg_sym := db.get_hir_symbol(arg_ident)
                        if arg_sym != id_none() {
                            name = ccg.sym_name(arena, arg_sym)
                        }
                    }
                }
            }
        }
        builder.append_list_item(&params, ccg.parameter(arena, p_ty, name), first)
        first = false
        i = i + 1
    }
    params_str := builder.finish_list(&params)
    if first {
        params_str = ccg.empty_parameters()
    }
    .{ fn_name: fn_name, params_str: params_str }
}

is_libc_fn :: fn(name Str) bool {
    if name.eq(Str.of("puts")) or name.eq(Str.of("printf")) or name.eq(Str.of("malloc")) or name.eq(Str.of("free")) or name.eq(Str.of("realloc")) {
        ret true
    }
    if name.eq(Str.of("memcpy")) or name.eq(Str.of("memset")) or name.eq(Str.of("memmove")) or name.eq(Str.of("exit")) or name.eq(Str.of("abort")) {
        ret true
    }
    if name.eq(Str.of("remove")) or name.eq(Str.of("strlen")) or name.eq(Str.of("strcmp")) or name.eq(Str.of("strncmp")) or name.eq(Str.of("getenv")) {
        ret true
    }
    if name.eq(Str.of("fopen")) or name.eq(Str.of("fclose")) or name.eq(Str.of("fread")) or name.eq(Str.of("fwrite")) or name.eq(Str.of("fseek")) or name.eq(Str.of("ftell")) {
        ret true
    }
    if name.eq(Str.of("system")) {
        ret true
    }
    false
}

lower_one_function :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), sym_id u32) {
    if sym_id == id_none() {
        ret
    }
    db := ctx.db
    ccg := ctx.ccg
    arena := ctx.arena
    is_mono := db.is_mono_sym(sym_id)
    orig_sym := sym_id
    mono_func_ty := ty_id_none()
    if is_mono {
        orig_sym = db.get_mono_orig_sym(sym_id)
        mono_func_ty = db.get_mono_type(sym_id)
    }
    real_sym := db.resolve_sym(orig_sym)
    func_id := db.get_fn_node(real_sym)
    if (func_id == id_none()) or (db.hir.kind(func_id) != hir_kind.function) {
        ret
    }
    saved_orig_ty := db.get_const_type(func_id)
    orig_func_ty := saved_orig_ty
    if (orig_func_ty == ty_id_none()) and is_mono {
        orig_func_ty = mono_func_ty
    }
    if (not is_mono) and (orig_func_ty != ty_id_none()) and db.types.func_has_type_param(orig_func_ty) {
        ret
    }
    if (not ccg.is_vm()) and (orig_func_ty != ty_id_none()) and (db.types.func_return(orig_func_ty) == ty_id_type()) {
        ret
    }
    if is_mono {
        db.restore_mono_func(sym_id)
        if (db.get_const_type(func_id) != ty_id_none()) and db.types.func_has_type_param(db.get_const_type(func_id)) {
            orig_func_ty = db.get_const_type(func_id)
        }
    }
    func_ty := db.get_node_type(func_id)
    if is_mono {
        func_ty = mono_func_ty
    }
    if func_ty == ty_id_none() {
        ret
    }
    body_id := db.hir.extra(func_id)
    is_extern := db.is_extern_fn(func_id)
    if body_id == hir_none() {
        if not is_extern or ccg.is_vm() or is_libc_fn(db.interner.get(db.extern_link_name(real_sym, func_id))) {
            ret
        }
    }
    ccg.reset_locals()
    sig := format_func_signature(ctx, sym_id, real_sym, func_id, is_mono, is_extern, orig_func_ty, func_ty)
    ret_ty := db.types.func_return(func_ty)
    add_type_to_queue(db, ret_ty, ctx.type_queue)
    for param in db.types.func_params(func_ty) {
        add_type_to_queue(db, param, ctx.type_queue)
    }
    ret_str := ccg.type_str(&db.types, arena, ret_ty)
    if body_id == hir_none() {
        ccg.declare_foreign(sig.fn_name, ret_str, sig.params_str, db.extern_module(func_id), db.interner.get(db.extern_link_name(real_sym, func_id)))
        ret
    }
    ccg.start_function(sig.fn_name, ret_str, sig.params_str, is_extern)
    body_val := lower_body(ctx, body_id)
    if db.types.kind(ret_ty) == TyKind.unit {
        if ccg.has_value(body_val) {
            ccg.expr(body_val)
        }
        ccg.gen_return(ctx.empty, false)
    } else if ccg.has_value(body_val) {
        ccg.gen_return(body_val, true)
    }
    ccg.end_function()
    if is_mono {
        db.set_const_type(func_id, saved_orig_ty)
    }
}

lower_globals :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V)) {
    db := ctx.db
    cg := ctx.ccg
    arena := ctx.arena
    globals := Vec(u32).new()
    for index in Range.new(0, db.sym_count() as i32) {
        sym := index as u32
        if db.resolve_sym(sym) != sym {
            cont
        }
        node := db.global_var(sym)
        if node != hir_none() {
            ty := db.get_node_type(db.hir.lhs(node))
            add_type_to_queue(db, ty, ctx.type_queue)
            cg.declare_global(sym, ty, cg.sym_name(arena, sym), cg.type_str(&db.types, arena, ty))
            if db.hir.extra(node) != hir_none() {
                globals.push(sym)
            }
        }
    }
    if globals.len == 0 {
        globals.destroy()
        ret
    }
    cg.begin_globals()
    ctx.global_init = true
    for sym in globals {
        node := db.global_var(sym)
        init := db.hir.extra(node)
        ty := db.get_node_type(db.hir.lhs(node))
        value := lower_expr(ctx, init)
        if not cg.has_value(value) {
            db.type_error(init, "mutable global initializer does not produce a runtime value")
        }
        cg.initialize_global(cg.global_ref(arena, sym, ty), cg.type_str(&db.types, arena, ty), value)
    }
    ctx.global_init = false
    cg.end_globals()
    globals.destroy()
}

lower_function :: fn(B type, L type, V type, db &Nexus, ccg &B, builder &L, empty V, arena &Arena, sym_id u32, visited &HashSet(u32), emit_globals bool) {
    if sym_id == id_none() and not emit_globals {
        ret
    }
    queue := Vec(u32).new()
    type_queue := Vec(u32).new()

    if sym_id != id_none() {
        queue.push(sym_id)
    }

    ctx: LowerCtx(B, L, V) = .{ db: db, ccg: ccg, builder: builder, empty: empty, arena: arena, visited: visited, queue: &queue, type_queue: &type_queue, global_init: false }

    if emit_globals {
        lower_globals(&ctx)
    }

    for q_sym in Worklist(u32).new(&queue) {
        if visited.insert(q_sym) {
            lower_one_function(&ctx, q_sym)
        }
    }

    sorted := topo_sort(db, &type_queue)

    for t in sorted {
        match db.types.kind(t) {
            struct_, nominal {
                ccg.define_struct(&db.types, arena, t)
            }
            array {
                ccg.define_array(&db.types, arena, t)
            }
            func {
                ccg.define_func_type(&db.types, arena, t)
            }
            union_ {
                ccg.define_union(&db.types, arena, t)
            }
            enum_ {
                ccg.define_enum(&db.types, arena, t)
            }
            else {}
        }
    }

    sorted.destroy()
    type_queue.destroy()
    queue.destroy()
}

lower_macro_template :: fn(B type, L type, V type, ctx &LowerCtx(B, L, V), call u32) V {
    db := ctx.db
    ccg := ctx.ccg
    arena := ctx.arena
    empty := ctx.empty
    callee := db.hir.lhs(call)
    scratch := Vec(u32).new()
    target := resolve_call_symbol(db, call, callee, &scratch)
    scratch.destroy()
    original := db.resolve_sym(db.get_hir_symbol(callee))
    func := db.get_fn_node(original)
    values := Vec(V).new()
    arg_types := Vec(u32).new()
    args := Vec(u32).new()
    source_args := db.get_list(db.hir.rhs(call))
    args.extend(source_args.ptr, source_args.len)
    i: u64 = 0
    while i < args.len {
        arg := args.get(i)
        ty := db.get_node_type(arg)
        if (ty != ty_id_type()) and (not db.is_const_call_arg(call, i as u32)) {
            value := lower_expr(ctx, arg)
            add_type_to_queue(db, ty, ctx.type_queue)
            temp := ccg.new_temp(arena, ccg.type_str(&db.types, arena, ty))
            ccg.expr(ccg.expr_assign(arena, temp, value))
            values.push(temp)
            arg_types.push(ty)
        }
        i = i + 1
    }
    args.destroy()
    if db.is_mono_sym(target) {
        db.restore_mono_func(target)
    }
    ccg.begin_inline_scope()
    params := db.get_list(db.hir.lhs(func))
    p: u64 = 0
    i = 0
    while p < params.len {
        param := *(params.ptr + p)
        type_node := db.hir.rhs(param)
        if (db.get_const_type(type_node) != ty_id_type()) and (db.hir.extra(param) != 1) {
            if i >= values.len {
                reflection_error(db, call, c"macro template argument mismatch")
            }
            ident := db.hir.lhs(param)
            sym := db.get_hir_symbol(ident)
            name := ccg.sym_name(arena, sym)
            ty := arg_types.get(i)
            ccg.create_variable(name, ccg.type_str(&db.types, arena, ty), values.get(i), true)
            i = i + 1
        }
        p = p + 1
    }
    template := macro_template(db, original)
    result := lower_body(ctx, template)
    if ccg.has_value(result) {
        ccg.expr(result)
    }
    ccg.end_inline_scope()
    values.destroy()
    arg_types.destroy()
    empty
}

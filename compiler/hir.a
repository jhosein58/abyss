import VecU8 from "../std/vec/u8.a"
import VecU32 from "../std/vec/u32.a"
import U32_MAX from "../std/primitive/u32.a"
import Str from "../std/string.a"

hir_none :: () u32 {
    U32_MAX()
}

HirExprKind :: struct {
    empty                 : u8,

    -- Literals
    lit_int               : u8,
    lit_float             : u8,
    lit_bool_true         : u8,
    lit_bool_false        : u8,
    lit_str               : u8,
    lit_char              : u8,
    ident                 : u8,

    -- Binary Operations
    binary_assign         : u8,
    binary_assign_add     : u8,
    binary_assign_sub     : u8,
    binary_assign_mul     : u8,
    binary_assign_div     : u8,
    binary_assign_mod     : u8,
    binary_assign_bit_and : u8,
    binary_assign_bit_or  : u8,
    binary_assign_bit_xor : u8,
    binary_assign_shl     : u8,
    binary_assign_shr     : u8,
    binary_add            : u8,
    binary_sub            : u8,
    binary_mul            : u8,
    binary_div            : u8,
    binary_mod            : u8,
    binary_eq_eq          : u8,
    binary_neq            : u8,
    binary_lt             : u8,
    binary_gt             : u8,
    binary_lt_eq          : u8,
    binary_gt_eq          : u8,
    binary_and            : u8,
    binary_or             : u8,
    binary_bit_and        : u8,
    binary_bit_or         : u8,
    binary_bit_xor        : u8,
    binary_shl            : u8,
    binary_shr            : u8,
    binary_colon          : u8,

    -- Unary Operations
    unary_neg             : u8,
    unary_not             : u8,
    unary_bit_not         : u8,
    unary_deref           : u8,
    unary_addr_of         : u8,

    -- Declarations & Control Flow
    arg                   : u8,
    function              : u8,
    call                  : u8,
    binding               : u8,
    var                   : u8,
    k_ret                 : u8,
    block                 : u8,
    k_if                  : u8,
    k_while               : u8,
    k_break               : u8,
    k_cont                : u8,

    -- Types & Access
    cast                  : u8,
    struct_              : u8,
    struct_init           : u8,
    array                 : u8,
    array_init            : u8,
    index                 : u8,
    member                : u8,
    wildcard              : u8,

    error                 : u8,
    marker_fn_start       : u8
}

hir_kind :: () HirExprKind {
    .{
        empty                 : 0,

        lit_int               : 1,
        lit_float             : 2,
        lit_bool_true         : 3,
        lit_bool_false        : 4,
        lit_str               : 5,
        lit_char              : 6,
        ident                 : 7,

        binary_assign         : 8,
        binary_assign_add     : 9,
        binary_assign_sub     : 10,
        binary_assign_mul     : 11,
        binary_assign_div     : 12,
        binary_assign_mod     : 13,
        binary_assign_bit_and : 14,
        binary_assign_bit_or  : 15,
        binary_assign_bit_xor : 16,
        binary_assign_shl     : 17,
        binary_assign_shr     : 18,
        binary_add            : 19,
        binary_sub            : 20,
        binary_mul            : 21,
        binary_div            : 22,
        binary_mod            : 23,
        binary_eq_eq          : 24,
        binary_neq            : 25,
        binary_lt             : 26,
        binary_gt             : 27,
        binary_lt_eq          : 28,
        binary_gt_eq          : 29,
        binary_and            : 30,
        binary_or             : 31,
        binary_bit_and        : 32,
        binary_bit_or         : 33,
        binary_bit_xor        : 34,
        binary_shl            : 35,
        binary_shr            : 36,
        binary_colon          : 37,

        unary_neg             : 38,
        unary_not             : 39,
        unary_bit_not         : 40,
        unary_deref           : 41,
        unary_addr_of         : 42,

        arg                   : 43,
        function              : 44,
        call                  : 45,
        binding               : 46,
        var                   : 47,
        k_ret                 : 48,
        block                 : 49,
        k_if                  : 50,
        k_while               : 51,
        k_break               : 52,
        k_cont                : 53,

        cast                  : 54,
        struct_              : 55,
        struct_init           : 56,
        array                 : 57,
        array_init            : 58,
        index                 : 59,
        member                : 60,
        wildcard              : 61,

        error                 : 62,
        marker_fn_start       : 63
    }
}

hir_kind_name :: (kind u8) Str {
    k := hir_kind()

    if kind == k.empty                 { ret Str.of("Empty")         }
    if kind == k.lit_int               { ret Str.of("LitInt")        }
    if kind == k.lit_float             { ret Str.of("LitFloat")      }
    if kind == k.lit_bool_true         { ret Str.of("LitBoolTrue")   }
    if kind == k.lit_bool_false        { ret Str.of("LitBoolFalse")  }
    if kind == k.lit_str               { ret Str.of("LitStr")        }
    if kind == k.lit_char              { ret Str.of("LitChar")       }
    if kind == k.ident                 { ret Str.of("Ident")         }

    if kind == k.binary_assign         { ret Str.of("=")             }
    if kind == k.binary_assign_add     { ret Str.of("+=")            }
    if kind == k.binary_assign_sub     { ret Str.of("-=")            }
    if kind == k.binary_assign_mul     { ret Str.of("*=")            }
    if kind == k.binary_assign_div     { ret Str.of("/=")            }
    if kind == k.binary_assign_mod     { ret Str.of("%=")            }
    if kind == k.binary_assign_bit_and { ret Str.of("&=")            }
    if kind == k.binary_assign_bit_or  { ret Str.of("|=")            }
    if kind == k.binary_assign_bit_xor { ret Str.of("^=")            }
    if kind == k.binary_assign_shl     { ret Str.of("<<=")           }
    if kind == k.binary_assign_shr     { ret Str.of(">>=")           }
    if kind == k.binary_add            { ret Str.of("+")             }
    if kind == k.binary_sub            { ret Str.of("-")             }
    if kind == k.binary_mul            { ret Str.of("*")             }
    if kind == k.binary_div            { ret Str.of("/")             }
    if kind == k.binary_mod            { ret Str.of("%")             }
    if kind == k.binary_eq_eq          { ret Str.of("==")            }
    if kind == k.binary_neq            { ret Str.of("!=")            }
    if kind == k.binary_lt             { ret Str.of("<")             }
    if kind == k.binary_gt             { ret Str.of(">")             }
    if kind == k.binary_lt_eq          { ret Str.of("<=")            }
    if kind == k.binary_gt_eq          { ret Str.of(">=")            }
    if kind == k.binary_and            { ret Str.of("and")           }
    if kind == k.binary_or             { ret Str.of("or")            }
    if kind == k.binary_bit_and        { ret Str.of("&")             }
    if kind == k.binary_bit_or         { ret Str.of("|")             }
    if kind == k.binary_bit_xor        { ret Str.of("^")             }
    if kind == k.binary_shl            { ret Str.of("<<")            }
    if kind == k.binary_shr            { ret Str.of(">>")            }
    if kind == k.binary_colon          { ret Str.of(":")             }

    if kind == k.unary_neg             { ret Str.of("UnaryNeg")      }
    if kind == k.unary_not             { ret Str.of("UnaryNot")      }
    if kind == k.unary_bit_not         { ret Str.of("UnaryBitNot")   }
    if kind == k.unary_deref           { ret Str.of("UnaryDeref")    }
    if kind == k.unary_addr_of         { ret Str.of("UnaryAddrOf")   }

    if kind == k.arg                   { ret Str.of("Arg")           }
    if kind == k.function              { ret Str.of("Function")      }
    if kind == k.call                  { ret Str.of("Call")          }
    if kind == k.binding               { ret Str.of("Binding")       }
    if kind == k.var                   { ret Str.of("Var")           }
    if kind == k.k_ret                 { ret Str.of("Ret")           }
    if kind == k.block                 { ret Str.of("Block")         }
    if kind == k.k_if                  { ret Str.of("If")            }
    if kind == k.k_while               { ret Str.of("While")         }
    if kind == k.k_break               { ret Str.of("Break")         }
    if kind == k.k_cont                { ret Str.of("Cont")          }

    if kind == k.cast                  { ret Str.of("Cast")          }
    if kind == k.struct_              { ret Str.of("Struct")        }
    if kind == k.struct_init           { ret Str.of("StructInit")    }
    if kind == k.array                 { ret Str.of("Array")         }
    if kind == k.array_init            { ret Str.of("ArrayInit")     }
    if kind == k.index                 { ret Str.of("Index")         }
    if kind == k.member                { ret Str.of("Member")        }
    if kind == k.wildcard              { ret Str.of("Wildcard")      }

    if kind == k.error                 { ret Str.of("Error")         }
    if kind == k.marker_fn_start       { ret Str.of("MarkerFnStart") }

    Str.of("Unknown")
}


HirTable :: struct {
    kinds      : VecU8,
    lhs_list   : VecU32,
    rhs_list   : VecU32,
    extra_list : VecU32,

    new :: () HirTable {
        .{
            kinds : VecU8.new(),
            lhs_list   : VecU32.new(),
            rhs_list   : VecU32.new(),
            extra_list : VecU32.new()
        }
    }

    destroy :: () {
        .kinds.destroy()
        .lhs_list.destroy()
        .rhs_list.destroy()
        .extra_list.destroy()
    }

    len :: () u32 {
        .kinds.len as u32
    }

    push :: (kind u8, lhs, rhs, extra u32) u32 {
        id := .len()

        .kinds.push(kind)
        .lhs_list.push(lhs)
        .rhs_list.push(rhs)
        .extra_list.push(extra)

        id
    }

    kind :: (id u32) u8 {
        .kinds.get(id as u64)
    }

    lhs :: (id u32) u32 {
        .lhs_list.get(id as u64)
    }

    rhs :: (id u32) u32 {
        .rhs_list.get(id as u64)
    }

    extra :: (id u32) u32 {
        .extra_list.get(id as u64)
    }

    set_lhs :: (id u32, val u32) {
        .lhs_list.set(id as u64, val)
    }

    set_rhs :: (id u32, val u32) {
        .rhs_list.set(id as u64, val)
    }

    set_extra :: (id u32, val u32) {
        .extra_list.set(id as u64, val)
    }
}

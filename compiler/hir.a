import VecU8 from "std/vec/u8"
import VecU32 from "std/vec/u32"
import U32_MAX from "std/primitive/u32"
import Str from "std/string"

hir_none :: fn() u32 {
    U32_MAX()
}

HirExprKind :: enum u8 {
    empty,

    lit_int,
    lit_float,
    lit_bool_true,
    lit_bool_false,
    lit_str,
    lit_char,
    ident,

    binary_assign,
    binary_assign_add,
    binary_assign_sub,
    binary_assign_mul,
    binary_assign_div,
    binary_assign_mod,
    binary_assign_bit_and,
    binary_assign_bit_or,
    binary_assign_bit_xor,
    binary_assign_shl,
    binary_assign_shr,
    binary_add,
    binary_sub,
    binary_mul,
    binary_div,
    binary_mod,
    binary_eq_eq,
    binary_neq,
    binary_lt,
    binary_gt,
    binary_lt_eq,
    binary_gt_eq,
    binary_and,
    binary_or,
    binary_bit_and,
    binary_bit_or,
    binary_bit_xor,
    binary_shl,
    binary_shr,
    binary_colon,

    unary_neg,
    unary_not,
    unary_bit_not,
    unary_deref,
    unary_addr_of,

    arg,
    function,
    call,
    binding,
    var,
    k_ret,
    block,
    k_if,
    k_while,
    k_break,
    k_cont,

    cast,
    struct_,
    struct_init,
    array,
    array_init,
    index,
    member,
    wildcard,

    error,
    marker_fn_start,
    builtin_call,
    enum_,
    lit_cstr
}

hir_kind :: HirExprKind

hir_kind_name :: fn(kind HirExprKind) Str {
    k := hir_kind

    if kind == k.empty                 { ret Str.of("Empty")         }
    if kind == k.lit_int               { ret Str.of("LitInt")        }
    if kind == k.lit_float             { ret Str.of("LitFloat")      }
    if kind == k.lit_bool_true         { ret Str.of("LitBoolTrue")   }
    if kind == k.lit_bool_false        { ret Str.of("LitBoolFalse")  }
    if kind == k.lit_str               { ret Str.of("LitStr")        }
    if kind == k.lit_char              { ret Str.of("LitChar")       }
    if kind == k.lit_cstr              { ret Str.of("LitCStr")       }
    if kind == k.ident                 { ret Str.of("Ident")         }

    if kind == k.binary_assign         { ret Str.of("=")             }
    if kind == k.binary_assign_add     { ret Str.of("+=")            }
    if kind == k.binary_assign_sub     { ret Str.of("-=")            }
    if kind == k.binary_assign_mul     { ret Str.of("*=")            }
    if kind == k.binary_assign_div     { ret Str.of("/=")            }
    if kind == k.binary_assign_mod     { ret Str.of("%=")            }
    if kind == k.binary_assign_bit_and { ret Str.of("&=")            }
    if kind == k.binary_assign_bit_or  { ret Str.of("|=")            }
    if kind == k.binary_assign_bit_xor { ret Str.of("^=")            }
    if kind == k.binary_assign_shl     { ret Str.of("<<=")           }
    if kind == k.binary_assign_shr     { ret Str.of(">>=")           }
    if kind == k.binary_add            { ret Str.of("+")             }
    if kind == k.binary_sub            { ret Str.of("-")             }
    if kind == k.binary_mul            { ret Str.of("*")             }
    if kind == k.binary_div            { ret Str.of("/")             }
    if kind == k.binary_mod            { ret Str.of("%")             }
    if kind == k.binary_eq_eq          { ret Str.of("==")            }
    if kind == k.binary_neq            { ret Str.of("!=")            }
    if kind == k.binary_lt             { ret Str.of("<")             }
    if kind == k.binary_gt             { ret Str.of(">")             }
    if kind == k.binary_lt_eq          { ret Str.of("<=")            }
    if kind == k.binary_gt_eq          { ret Str.of(">=")            }
    if kind == k.binary_and            { ret Str.of("and")           }
    if kind == k.binary_or             { ret Str.of("or")            }
    if kind == k.binary_bit_and        { ret Str.of("&")             }
    if kind == k.binary_bit_or         { ret Str.of("|")             }
    if kind == k.binary_bit_xor        { ret Str.of("^")             }
    if kind == k.binary_shl            { ret Str.of("<<")            }
    if kind == k.binary_shr            { ret Str.of(">>")            }
    if kind == k.binary_colon          { ret Str.of(":")             }

    if kind == k.unary_neg             { ret Str.of("UnaryNeg")      }
    if kind == k.unary_not             { ret Str.of("UnaryNot")      }
    if kind == k.unary_bit_not         { ret Str.of("UnaryBitNot")   }
    if kind == k.unary_deref           { ret Str.of("UnaryDeref")    }
    if kind == k.unary_addr_of         { ret Str.of("UnaryAddrOf")   }

    if kind == k.arg                   { ret Str.of("Arg")           }
    if kind == k.function              { ret Str.of("Function")      }
    if kind == k.call                  { ret Str.of("Call")          }
    if kind == k.binding               { ret Str.of("Binding")       }
    if kind == k.var                   { ret Str.of("Var")           }
    if kind == k.k_ret                 { ret Str.of("Ret")           }
    if kind == k.block                 { ret Str.of("Block")         }
    if kind == k.k_if                  { ret Str.of("If")            }
    if kind == k.k_while               { ret Str.of("While")         }
    if kind == k.k_break               { ret Str.of("Break")         }
    if kind == k.k_cont                { ret Str.of("Cont")          }

    if kind == k.cast                  { ret Str.of("Cast")          }
    if kind == k.struct_              { ret Str.of("Struct")        }
    if kind == k.struct_init           { ret Str.of("StructInit")    }
    if kind == k.array                 { ret Str.of("Array")         }
    if kind == k.array_init            { ret Str.of("ArrayInit")     }
    if kind == k.index                 { ret Str.of("Index")         }
    if kind == k.member                { ret Str.of("Member")        }
    if kind == k.wildcard              { ret Str.of("Wildcard")      }

    if kind == k.error                 { ret Str.of("Error")         }
    if kind == k.marker_fn_start       { ret Str.of("MarkerFnStart") }
    if kind == k.builtin_call          { ret Str.of("BuiltinCall")   }
    if kind == k.enum_                 { ret Str.of("Enum")          }

    Str.of("Unknown")
}


HirTable :: struct {
    kinds      VecU8
    lhs_list   VecU32
    rhs_list   VecU32
    extra_list VecU32

    new :: fn() HirTable {
        .{
            kinds : VecU8.new(),
            lhs_list   : VecU32.new(),
            rhs_list   : VecU32.new(),
            extra_list : VecU32.new()
        }
    }

    destroy :: fn(self &Self) {
        self.kinds.destroy()
        self.lhs_list.destroy()
        self.rhs_list.destroy()
        self.extra_list.destroy()
    }

    len :: fn(self &Self) u32 {
        self.kinds.len as u32
    }

    push :: fn(self &Self, kind HirExprKind, lhs, rhs, extra u32) u32 {
        id := self.len()

        self.kinds.push(kind as u8)
        self.lhs_list.push(lhs)
        self.rhs_list.push(rhs)
        self.extra_list.push(extra)

        id
    }

    kind :: fn(self &Self, id u32) HirExprKind {
        self.kinds.get(id as u64) as HirExprKind
    }

    lhs :: fn(self &Self, id u32) u32 {
        self.lhs_list.get(id as u64)
    }

    rhs :: fn(self &Self, id u32) u32 {
        self.rhs_list.get(id as u64)
    }

    extra :: fn(self &Self, id u32) u32 {
        self.extra_list.get(id as u64)
    }

    set_lhs :: fn(self &Self, id u32, val u32) {
        self.lhs_list.set(id as u64, val)
    }

    set_rhs :: fn(self &Self, id u32, val u32) {
        self.rhs_list.set(id as u64, val)
    }

    set_extra :: fn(self &Self, id u32, val u32) {
        self.extra_list.set(id as u64, val)
    }

    set_kind :: fn(self &Self, id u32, k HirExprKind) {
        self.kinds.set(id as u64, k as u8)
    }
}

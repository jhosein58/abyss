Choice :: fn(T type, E type) type {
    struct {
        is_ok bool
        val T | E

        ok :: fn(v T) Self {
            .{
                is_ok: true,
                val: v
            }
        }

        err :: fn(e E) Self {
            .{
                is_ok: false,
                val: e
            }
        }

        is_success :: fn() bool { .is_ok }
        is_error :: fn() bool { not .is_ok }

        unwrap_or :: fn(fallback T) T {
            if .is_ok { .val as T } else { fallback }
        }
    }
}

str_len    :: fn(s &u8) u64
print_char :: fn(c u8)
malloc     :: fn(size u64) &u8

Str :: struct {
    ptr &u8
    len u64 


    size :: fn() u64 {
        16
    }

    new :: fn(ptr &u8, len u64) Str {
        .{
            ptr: ptr,
            len: len,
        }
    }

    empty :: fn() Str {
        .{
            ptr: 0 as &u8,
            len: 0,
        }
    }

    of :: fn(s &u8 | Str) Self {
        if @is(s, Str) {
            ret s as Str
        }
        raw := s as &u8
        .{
            ptr: raw,
            len: str_len(raw)
        }
    }

    print :: fn(self &Self) {
        i := 0

        while i < self.len {
            print_char(*(self.ptr + i))
            i = i + 1
        }
    }

    println :: fn(s Str) {
        s.print()
        print_char('\n')
    }

    sub :: fn(self &Self, start u64, len u64) Str {
        .{
            ptr: (self.ptr + start),
            len: len
        }
    }

    eq :: fn(self &Self, b Str) bool {
        if self.len != b.len {
            ret false
        }

        i: u64 = 0
        while i < self.len {
            if *(self.ptr + i) != *(b.ptr + i) {
                ret false
            }
            i = i + 1
        }

        true
    }

    starts_with :: fn(self &Self, prefix Str) bool {
        if self.len < prefix.len { ret false }
        self.sub(0, prefix.len).eq(prefix)
    }

    ends_with :: fn(self &Self, suffix Str) bool {
        if self.len < suffix.len { ret false }
        self.sub(self.len - suffix.len, suffix.len).eq(suffix)
    }

    trim_quotes :: fn(self &Self) Str {
        if self.len >= 2 {
            first := *(self.ptr)
            last := *(self.ptr + self.len - 1)
            if ((first == '"') and (last == '"')) or ((first == '`') and (last == '`')) {
                ret self.sub(1, self.len - 2)
            }
        }
        .{
            ptr: self.ptr,
            len: self.len
        }
    }

    concat :: fn(self &Self, other Str) Str {
        total := self.len + other.len
        buf := malloc(total + 1)
        i: u64 = 0
        while i < self.len {
            *(buf + i) = *(self.ptr + i)
            i = i + 1
        }
        j: u64 = 0
        while j < other.len {
            *(buf + self.len + j) = *(other.ptr + j)
            j = j + 1
        }
        *(buf + total) = 0 as u8
        Str.new(buf, total)
    }
}

int_to_str :: fn(v i64) Str {
    buf := malloc(32)
    if v == 0 {
        *buf = 48 as u8
        *(buf + 1) = 0 as u8
        ret Str.new(buf, 1)
    }
    neg := v < 0
    val: u64 = 0
    if neg { val = (0 - v) as u64 } else { val = v as u64 }
    temp := val
    len: u64 = 0
    while temp > 0 {
        len = len + 1
        temp = temp / 10
    }
    if neg { len = len + 1 }
    *(buf + len) = 0 as u8
    pos := len
    while val > 0 {
        pos = pos - 1
        *(buf + pos) = ((val % 10) + 48) as u8
        val = val / 10
    }
    if neg {
        *(buf) = 45 as u8
    }
    Str.new(buf, len)
}

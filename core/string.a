str_len :: fn(s &u8) u64
print_char :: fn(c u8) unit

Str :: struct {
    ptr &u8
    len u64 


    size :: fn() u64 {
        16
    }

    new :: fn(ptr &u8, len u64) Str {
        .{
            ptr: ptr,
            len: len,
        }
    }

    empty :: fn() Str {
        .{
            ptr: 0 as &u8,
            len: 0,
        }
    }

    of :: fn(s &u8 | Str) Self {
        if @is(s, Str) {
            ret s as Str
        }
        raw := s as &u8
        .{
            ptr: raw,
            len: str_len(raw)
        }
    }

    print :: fn(self &Self) {
        i := 0

        while i < self.len {
            print_char(*(self.ptr + i))
            i = i + 1
        }
    }

    println :: fn(s Str) {
        s.print()
        print_char('\n')
    }

    sub :: fn(self &Self, start u64, len u64) Str {
        .{
            ptr: (self.ptr + start),
            len: len
        }
    }

    eq :: fn(self &Self, b Str) bool {
        if self.len != b.len {
            ret false
        }

        i: u64 = 0
        while i < self.len {
            if *(self.ptr + i) != *(b.ptr + i) {
                ret false
            }
            i = i + 1
        }

        true
    }

    starts_with :: fn(self &Self, prefix Str) bool {
        if self.len < prefix.len { ret false }
        self.sub(0, prefix.len).eq(prefix)
    }

    ends_with :: fn(self &Self, suffix Str) bool {
        if self.len < suffix.len { ret false }
        self.sub(self.len - suffix.len, suffix.len).eq(suffix)
    }

    trim_quotes :: fn(self &Self) Str {
        if self.len >= 2 {
            if (*(self.ptr) == '"') and (*(self.ptr + self.len - 1) == '"') {
                ret self.sub(1, self.len - 2)
            }
        }
        .{
            ptr: self.ptr,
            len: self.len
        }
    }
}

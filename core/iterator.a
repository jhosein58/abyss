import Maybe from "maybe.a"

Iterator :: fn(T type) type {
    struct {
        ptr &T
        len u64
        index u64

        new :: fn(ptr &T, len u64) Self {
            .{ ptr: ptr, len: len, index: 0 }
        }

        next :: fn(self &Self) Maybe(T) {
            if self.index >= self.len {
                ret Maybe(T).none()
            }
            value := *(self.ptr + self.index)
            self.index = self.index + 1
            Maybe(T).some(value)
        }

        has_next :: fn(self &Self) bool {
            self.index < self.len
        }

        is_done :: fn(self &Self) bool {
            self.index >= self.len
        }

        peek :: fn(self &Self) Maybe(T) {
            if self.index >= self.len {
                ret Maybe(T).none()
            }
            Maybe(T).some(*(self.ptr + self.index))
        }

        skip :: fn(self &Self, n u64) {
            self.index = self.index + n
            if self.index > self.len {
                self.index = self.len
            }
        }

        reset :: fn(self &Self) {
            self.index = 0
        }

        remaining :: fn(self &Self) u64 {
            if self.index >= self.len { ret 0 }
            self.len - self.index
        }
    }
}

Slice :: fn(T type) type {
    struct {
        ptr: &T,
        len: u64,

        new :: fn(ptr &T, len u64) Self {
            .{
                ptr: ptr,
                len: len
            }
        }

        empty :: fn() Self {
            .{
                ptr: 0 as &T,
                len: 0
            }
        }

        get :: fn(idx u64) T {
            *(.ptr + idx)
        }

        sub :: fn(start u64, len u64) Self {
            .{
                ptr: (.ptr + start),
                len: len
            }
        }
    }
}

Maybe :: fn(T type) type {
    struct {
        present bool
        value T

        some :: fn(value T) Self { .{ present: true, value: value } }
        none :: fn() Self {
            result: Self
            result.present = false
            result
        }
        is_some :: fn() bool { .present }
        is_none :: fn() bool { not .present }
        unwrap :: fn() T { .value }
        unwrap_or :: fn(fallback T) T {
            if .present { .value } else { fallback }
        }
    }
}
